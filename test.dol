import json

def parse data @ Str -> Record[name: Str, age: Int, city: Str, state: Str]
  if bind json.decode $data
    Dict $
      "name": Str(name)
      "age": Int(age)
      ?"location":
        "city": Str(city = "Unknown")
        "state": Str(state = "Unknown")
  do
    (:name, :age, :city, :state)
  else
    throw std.ValueError "invalid data"

let :name :age :city :state = parse r|
  {
    "name": "Rocky",
    "age": 42,
    "location": {
      "city": "Beaverton",
      "state": "Cascadia"
    }
  }

echo $name $city $state
echo "Age next year: $(age + 1)"
