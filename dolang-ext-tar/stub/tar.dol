# Streams TAR archives with optional gzip or zstd compression.

# Metadata and streaming content for the current TAR entry.
#
# The handle remains valid only until its parent [`Reader`](tar.Reader)
# advances or leaves scope. Iterating an entry yields arbitrary-sized
# [`Bin`](std.Bin) chunks until the content is exhausted.
#
# ## Example
#
# ```
# for chunk = entry
#   output.put $chunk
# ```
pub class Entry: Iter
  # Device major number, or `nil` when absent.
  #[getter]
  pub def device_major self
    ...

  # Device minor number, or `nil` when absent.
  #[getter]
  pub def device_minor self
    ...

  # Numeric group ID.
  #[getter]
  pub def gid self
    ...

  # Group name, or `nil` when absent.
  #[getter]
  pub def group_name self
    ...

  # Link target as an [`fs.unix.Path`](fs.unix.Path), or `nil` when
  # absent.
  #[getter]
  pub def link_name self
    ...

  # Unix permission bits.
  #[getter]
  pub def mode self
    ...

  # Modification time as [`DateTime`](time.DateTime).
  #[getter]
  pub def mtime self
    ...

  # Owner name, or `nil` when absent.
  #[getter]
  pub def owner_name self
    ...

  # Entry path as an [`fs.unix.Path`](fs.unix.Path).
  #[getter]
  pub def path self
    ...

  # Declared content size in bytes.
  #[getter]
  pub def size self
    ...

  # Entry type as `:FILE:`, `:DIR:`, `:HARDLINK:`, `:SYMLINK:`, `:FIFO:`,
  # `:CHAR_DEVICE:`, `:BLOCK_DEVICE:`, `:CONTIGUOUS:`, or `:UNKNOWN:`.
  #[getter]
  pub def type self
    ...

  # Numeric owner ID.
  #[getter]
  pub def uid self
    ...

  # Reads up to `size` bytes from the current content position.
  #
  # ## Example
  #
  # ```
  # let prefix = entry.read 512
  # ```
  pub def read
    self
    # Maximum bytes to read.
    size @ Int
  do -> Bin
    ...

  # Yields the next content chunk, ending iteration once the entry is
  # exhausted.
  pub def (next) self
    ...

# Content sink for one scoped TAR entry.
#
# Subtype of [`Sink`](std.Sink). Putting a [`Str`](std.Str) or
# [`Bin`](std.Bin) value appends its bytes without adding separators.
#
# ## Example
#
# ```
# entry.put "first"
# entry.put b"second"
# ```
pub class EntryWriter: Sink
  # Writes raw string or binary bytes.
  #
  # ## Example
  #
  # ```
  # entry.write header
  # entry.write b"\x00\x01"
  # ```
  pub def write
    self
    # Bytes to write.
    data @ (Str | Bin)
  do
    ...

# Destructive iterator over the entries in an open TAR archive.
#
# Advancing the reader drains unread data from the current entry and
# invalidates its [`Entry`](tar.Entry) handle. Iteration yields entries in
# archive order.
#
# ## Example
#
# ```
# read "archive.tar" do |archive|
#   for entry = archive
#     echo $entry.path
# ```
pub class Reader: Iter
  # Detected compression as `:NONE:`, `:GZIP:`, or `:ZSTD:`.
  #[getter]
  pub def compression self
    ...

  # Yields the next [`Entry`](tar.Entry), ending iteration at the end of the
  # archive.
  pub def (next) self
    ...

# Sequential writer for a new TAR archive.
pub class Writer
  # Selected compression as `:NONE:`, `:GZIP:`, or `:ZSTD:`.
  #[getter]
  pub def compression self
    ...

  # Creates a directory entry.
  #
  # ## Example
  #
  # ```
  # archive.create_dir "subdir" mode: 0o755
  # ```
  pub def create_dir
    self
    # Entry
    # path.
    path @ (Str | Path)
    # Permission bits. Defaults to `0o755`.
    :mode @ Int = nil
    # Owner ID. Defaults to `0`.
    :uid @ Int = nil
    # Group ID. Defaults to `0`.
    :gid @ Int = nil
    # Modification time. Defaults to the
    # Unix epoch.
    :mtime @ DateTime = nil
    # Owner name.
    :owner_name @ Str = nil
    # Group name.
    :group_name @ Str = nil
  do
    ...

  # Adds one regular-file entry and calls `func` with a scoped
  # [`EntryWriter`](tar.EntryWriter).
  #
  # For directory, symlink, or hard-link entries, use
  # [`create_dir`](tar.Writer.create_dir), [`symlink`](tar.Writer.symlink), or
  # [`hard_link`](tar.Writer.hard_link) instead -- none of them carry content, so none of
  # them have any use for a write handle.
  #
  # ## Returns
  #
  # The result of `func`.
  #
  # ## Errors
  #
  # | Exception          | Condition                                                    |
  # | ------------------ | ------------------------------------------------------------ |
  # | `ConcurrencyError` | Another entry is created while an entry scope is active      |
  # | `ValueError`       | The number of bytes written differs from the declared `size` |
  #
  # ## Example
  #
  # ```
  # archive.entry data.bin size: 4 mode: 0o600 do |entry|
  #   entry.write b"\x00\x01\x02\x03"
  # ```
  pub def entry
    self
    # Entry
    # path.
    path @ (Str | Path)
    # Exact content size. Required.
    :size @ Int = nil
    # Permission bits. Defaults to `0o644`.
    :mode @ Int = nil
    # Owner ID. Defaults to `0`.
    :uid @ Int = nil
    # Group ID. Defaults to `0`.
    :gid @ Int = nil
    # Modification time. Defaults to the
    # Unix epoch.
    :mtime @ DateTime = nil
    # Owner name.
    :owner_name @ Str = nil
    # Group name.
    :group_name @ Str = nil
    # Entry writer scope, called with an
    # [`EntryWriter`](tar.EntryWriter).
    func @ Func
  do -> Value
    ...

  # Creates a hard-link entry pointing to `target`.
  #
  # Argument order matches [`fs.hard_link`](fs.hard_link).
  #
  # ## Example
  #
  # ```
  # archive.hard_link "file.txt" "link.txt"
  # ```
  pub def hard_link
    self
    # Path the
    # hard link points to.
    target @ (Str | Path)
    # Entry
    # path.
    path @ (Str | Path)
    # Permission bits. Defaults to `0o644`.
    :mode @ Int = nil
    # Owner ID. Defaults to `0`.
    :uid @ Int = nil
    # Group ID. Defaults to `0`.
    :gid @ Int = nil
    # Modification time. Defaults to the
    # Unix epoch.
    :mtime @ DateTime = nil
    # Owner name.
    :owner_name @ Str = nil
    # Group name.
    :group_name @ Str = nil
  do
    ...

  # Creates a symbolic link entry pointing to `target`.
  #
  # Argument order matches
  # [`fs.symlink_file`](fs.symlink_file).
  #
  # ## Example
  #
  # ```
  # archive.symlink "target.txt" "link.txt"
  # ```
  pub def symlink
    self
    # Path the
    # symlink points to.
    target @ (Str | Path)
    # Entry
    # path.
    path @ (Str | Path)
    # Permission bits. Defaults to `0o777`.
    :mode @ Int = nil
    # Owner ID. Defaults to `0`.
    :uid @ Int = nil
    # Group ID. Defaults to `0`.
    :gid @ Int = nil
    # Modification time. Defaults to the
    # Unix epoch.
    :mtime @ DateTime = nil
    # Owner name.
    :owner_name @ Str = nil
    # Group name.
    :group_name @ Str = nil
  do
    ...

# Opens an archive and calls `func` with a [`Reader`](tar.Reader).
#
# Compression is detected from gzip or zstd magic bytes.
#
# ## Returns
#
# The result of `func`.
#
# ## Example
#
# ```
# read "archive.tar.gz" do |archive|
#   for entry = archive
#     echo "$entry.path: $entry.size bytes"
# ```
pub def read
  # Archive path.
  path @ (Str | Path)
  # Reader scope, called with a [`Reader`](tar.Reader).
  func @ Func
do -> Value
  ...

# Creates an archive and calls `func` with a [`Writer`](tar.Writer).
#
# ## Returns
#
# The result of `func`.
#
# ## Example
#
# ```
# write "archive.tar.zst" do |archive|
#   archive.entry greeting.txt size: 5 do |entry|
#     entry.write hello
# ```
pub def write
  # Archive path.
  path @ (Str | Path)
  # `:NONE:`, `:GZIP:`, or `:ZSTD:`.
  #
  # When omitted, `.gz` and `.tgz` select gzip, `.zst` and `.tzst` select
  # zstd, and other extensions select no compression. Extension matching is
  # case-insensitive. An explicit `compression` overrides the path.
  :compression @ Sym = nil
  # Writer scope, called with a [`Writer`](tar.Writer).
  func @ Func
do -> Value
  ...
