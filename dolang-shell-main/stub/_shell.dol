# Internal shell services used by bundled modules and entrypoints.
@import fs term
@import compile: compiler
import strand:
  - @Backtrace

pub def render_error error :backtrace @ Backtrace = nil -> term.Text
  ...

# Compiles source, or reads and compiles a file when source is omitted.
pub def compile
  path @ (Str | fs.Path)
  source @ Str = nil
  :mode @ (:SCRIPT: | :REPL: | Str) = :SCRIPT:
  :prelude @ compiler.Prelude = nil
  :strict @ Bool = nil
do -> Bin
  ...

# Edits Do input with syntax highlighting and multiline validation.
pub class Editor
  pub def (init) self history_path @ (Str | fs.Path | nil) :prelude @ compiler.Prelude = nil
    ...

  # Returns input, EOF, or an interrupted prompt.
  pub def readline self prompt@Str names@BaseArray[Str | Sym] -> (Str | :EOF: | :INTERRUPTED:)
    ...

  pub def save_history self -> nil
    ...

# Looks up a linked resource, returning nil when absent.
# Text resources retain their Str representation; byte resources return Bin.
pub def resource namespace@Str name@Str -> (Str | Bin | nil)
  ...
