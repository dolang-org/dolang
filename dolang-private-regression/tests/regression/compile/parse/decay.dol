echo if else while for let field = + - / %
let rec = record true: true false: true nil: true while: true let: true field: true
rec[:do:] = true
let field = 1
assert_eq $field 1
for field = [2]
  assert_eq $field 2
assert $rec.true
assert $rec.false
assert $rec.nil
assert $rec.while
assert $rec.let
assert $rec.field
assert $rec.do

# A declaration names what it defines, so a keyword may be taken as a name.
def import name
  "imported $name"
assert_eq (import "x") "imported x"

class Keywords
  pub def import self name
    "method $name"
  pub def while self
    "while"

let kw = Keywords()
assert_eq $kw.import("y") "method y"
assert_eq $kw.while() "while"
# output: END
# if else while for let field = + - / %
# END
