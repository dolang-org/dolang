def f x
  x
def g x
  x
def h :a
  a

let x = 1
let rest = [2, 3]
echo () (x,) (x) (x, 2, 3) (x, 2, 3,) (x, ...rest) (...rest)
echo (f(1), g 2, h(a: 3)) ((1 + 1), (2,))
echo (a: 1) (1, a: 2) (:x) (:x,) (...(record a: 1), b: 2)
(echo (1, 2) 3)
(echo () 3)
(echo (x,) 3)
(echo (a: 1) 3)
(echo (...rest) 3)
(echo(1, 2) 3)
# warning: juxtaposed argument is misleading
#   --> tuple_literal.dol:LL:LL
#    |
# LL | (echo(1, 2) 3)
#    |  ----       ^
#    |  |
#    |  expression is actually an argument to this function
#    |
# help: insert a space
#    |
# LL | (echo (1, 2) 3)
#    |      +
# output: END
# () (1,) 1 (1, 2, 3) (1, 2, 3) (1, 2, 3) (2, 3)
# (1, 2, 3) (2, (2,))
# (a: 1) (1, a: 2) (x: 1) (x: 1) (a: 1, b: 2)
# (1, 2) 3
# () 3
# (1,) 3
# (a: 1) 3
# (2, 3) 3
# (1, 2) 3
# END
