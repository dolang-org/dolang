# document
let _missing @Missing = nil
# warning: unbound type name
#   --> warnings.dol:LL:LL
#    |
# LL | let _missing @Missing = nil
#    |               ^^^^^^^

class _Holder[T]
# warning: unused binder
#   --> warnings.dol:LL:LL
#    |
# LL | class _Holder[T]
#    |               ^

let @_Spread[..._Ts] = Int

let @_Opaque[T, ...Ts] = ...

let _value = 1
let _dotted @_value.Field = nil
# warning: a dotted type name must begin with an import
#   --> warnings.dol:LL:LL
#    |
# LL | let _dotted @_value.Field = nil
#    |              ^^^^^^

def _unused[T, _Ignored] x @Int
  # warning: unused binder
  #   --> warnings.dol:LL:LL
  #    |
  # LL | def _unused[T, _Ignored] x @Int
  #    |             ^
  x

def _dotted_binder[T] x @T.Field
  # warning: a dotted type name must begin with an import
  #   --> warnings.dol:LL:LL
  #    |
  # LL | def _dotted_binder[T] x @T.Field
  #    |                          ^
  x

let _before @_After = nil
# warning: unbound type name
#   --> warnings.dol:LL:LL
#    |
# LL | let _before @_After = nil
#    |              ^^^^^^
let _After = nil

def _param_hidden x @_Hidden
  # warning: unbound type name
  #   --> warnings.dol:LL:LL
  #    |
  # LL | def _param_hidden x @_Hidden
  #    |                      ^^^^^^^
  class _Hidden
  x

import import_fixture:
  - @Unused
  # warning: unused type import
  #   --> warnings.dol:LL:LL
  #    |
  # LL |   - @Unused
  #    |      ^^^^^^
  - @_Ignored

def _import_hidden x @Local
  # warning: unbound type name
  #   --> warnings.dol:LL:LL
  #    |
  # LL | def _import_hidden x @Local
  #    |                       ^^^^^
  import import_fixture:
    - @Local
  # warning: unused type import
  #   --> warnings.dol:LL:LL
  #    |
  # LL |     - @Local
  #    |        ^^^^^
  x

# A use before or within an alias that shadows an outer type means the alias. A
# parameter is outside the body the alias is declared in.
let @_Shadowed = Int
def _shadow_early x @_Shadowed
  let _early @_Shadowed = x
  # warning: type name refers to its block's alias, not the outer type it shadows
  #   --> warnings.dol:LL:LL
  #    |
  # LL |   let _early @_Shadowed = x
  #    |               ^^^^^^^^^
  let @_Shadowed = Array[_Shadowed]
  # warning: type name refers to its block's alias, not the outer type it shadows
  #   --> warnings.dol:LL:LL
  #    |
  # LL |   let @_Shadowed = Array[_Shadowed]
  #    |                          ^^^^^^^^^
  _early
let _shadow_late = do
  let @_Shadowed = Str
  let _late @_Shadowed = nil
