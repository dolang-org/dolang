import std:
  - Fmt
  - FmtValue
  - FmtParam

# A parameter names a hole whose meaning is up to the consumer. The name is an
# Int or a Sym, and nothing else: those are the two kinds of key an argument
# pack and a dict literal can supply.
let positional = FmtParam 0
let named = FmtParam :user:
assert_eq (type positional) $FmtParam
assert_eq $positional.name 0
assert_eq $named.name :user:
assert_throws $std.TypeError do FmtParam "user"
assert_throws $std.TypeError do FmtParam 1.5
assert_throws $std.TypeError do FmtParam nil

# It carries a specification like any other interpolation, and exposes it
# through the same fields as FmtSpec.
let padded = FmtParam :user: width: 8 align: :RIGHT:
assert_eq $padded.width 8
assert_eq $padded.align :RIGHT:
assert_eq $padded.kind nil

# Calling it re-merges options over the same name. The result is synthetic, so
# it carries no source.
let widened = padded width: 12
assert_eq $widened.name :user:
assert_eq $widened.width 12
assert_eq $widened.source nil

# A parameter shows itself as the text it was written as. Unlike a sequence it
# does not refuse conversion: there is no bound value to leak by showing it,
# only a name.
assert_eq (str positional) r"${#0}"
assert_eq (str named) r"${#user}"
assert_eq (dbg named) r"${#user}"
assert_eq (std.verbatim named) r"${#user}"
let sourced = FmtParam 2 source: r"${#2:>3}"
assert_eq $sourced.source r"${#2:>3}"
assert_eq (str sourced) r"${#2:>3}"

# A parameter is a segment, alongside literal text and bound values.
let stmt = Fmt ["a=", positional, ";"]
assert_eq $stmt.len 3
assert_eq (type stmt[1]) $FmtParam
assert_eq (dbg stmt) r#"t"a=${#0};""#

# An unfilled hole has no rendering: the sequence is unfinished, so there is
# nothing to emit that would not be a guess at what belongs there. It is a
# parameter nobody supplied, and is reported as one.
assert_throws $std.MissingPosError do stmt.format()

# The refusal is about the hole, not about conversion in general -- a sequence
# with no holes still expands.
assert_eq $(Fmt ["a=", (FmtValue 42)]).format() "a=42"

# Two parameters are equal when they name the same parameter under the same
# specification and were written the same way.
assert_eq (FmtParam 0) (FmtParam 0)
assert_eq (FmtParam :user: width: 8) $ FmtParam :user: width: 8
assert $ ((FmtParam 0) != (FmtParam 1))
assert $ ((FmtParam :user:) != (FmtParam :host:))
assert $ ((FmtParam 0) != (FmtParam 0 width: 3))
assert $ ((FmtParam 0) != (FmtParam 0 source: r"${#0}"))
assert $ ((FmtParam 0) != (FmtValue 0))

let keyed = dict()
keyed[(FmtParam 0)] = 1
keyed[(FmtParam 1)] = 2
assert_eq $keyed[(FmtParam 0)] 1
assert_eq $keyed.len 2

# `${#0}` and `${#foo}` write a hole into a sequence. The `#` is unambiguous:
# it introduces a name, never a value to evaluate.
let query = t"select * from t where a = ${#0} and c = ${#name}"
assert_eq $query.len 4
assert_eq (type query[1]) $FmtParam
assert_eq $query[1].name 0
assert_eq $query[1].source r"${#0}"
assert_eq (type query[3]) $FmtParam
assert_eq $query[3].name :name:
assert_throws $std.MissingPosError do query.format()

# A hole states a specification like any other interpolation, and the whole
# thing round-trips through `dbg`.
let laid_out = t"[${#0:>6}]"
assert_eq $laid_out[1].width 6
assert_eq $laid_out[1].align :RIGHT:
assert_eq (dbg laid_out) r##"t"[${#0:>6}]""##

# A dynamic count is an expression, and it is evaluated where it stands even
# though the value it will lay out is not there yet.
let n = 3
let dynamic = t"${#x:$(n)d}"
assert_eq $dynamic[0].width 3
assert_eq $dynamic[0].kind :DEC:

# Here strings take holes too.
let doc = t|-
  a=${#k}
assert_eq $doc.len 2
assert_eq $doc[1].name :k:

# `#` keeps its own meaning inside a specification: this is `alt`, not a hole.
assert_eq $(t"${5:#x}").format() "0x5"

# `$#name` is the shorthand for a hole with no specification.
let short = t"a=$#0 b=$#name"
assert_eq $short.len 4
assert_eq $short[1].name 0
assert_eq $short[3].name :name:
assert_eq $short[1].source r"$#0"
assert_eq $short.format(1, name: "n") "a=1 b=n"
assert_eq $(t"x$#k").format(k: 1) "x1"

# The shorthand takes the name and nothing else, so a `:` after one is text.
let labeled = t"$#name: $#0"
assert_eq $labeled.len 3
assert_eq $labeled[0].name :name:
assert_eq $labeled[1] ": "
assert_eq $labeled.format(0, name: "n") "n: 0"

# Here strings take the shorthand too.
let short_doc = t|-
  a=$#k
assert_eq $short_doc[1].name :k:

# `format` is the reference implementation of holes: it fills them from its
# arguments before expanding. A positional argument fills the hole named by its
# position, and a keyword argument the hole named by its key.
let stmt = t"select * from t where a = ${#0} and c = ${#name}"
assert_eq $stmt.format(1, name: "n") "select * from t where a = 1 and c = n"

# A filled hole keeps the parameter's specification, which belongs to the
# template rather than to the value that arrived late.
let layout = t"[${#0:>4}]"
assert_eq $layout.format(7) "[   7]"

# Filling is exhaustive: a hole left unfilled and an argument no hole consumed
# are both errors. A misspelled key is reported as the key that was written.
assert_throws $std.MissingPosError do stmt.format(name: "n")
assert_throws $std.MissingKeyError do stmt.format(1)
assert_throws $std.UnexpectedPosError do stmt.format(1, 2, name: "n")
assert_throws $std.UnexpectedKeyError do stmt.format(1, name: "n", nope: 2)

# An argument to a template with nothing to fill is unused like any other.
let bare = t"plain"
assert_throws $std.UnexpectedPosError do bare.format(1)

# Repeating a name fills every hole that bears it.
let twice = t"${#k}/${#k}"
assert_eq $twice.format(k: 9) "9/9"

# Holes inside a bound sequence are filled too, depth first, and a name is
# never renumbered: a nested `${#0}` is filled by the same argument.
let inner = t"${#k}-x"
let outer = t"[${inner}]"
assert_eq $outer.format(k: 5) "[5-x]"
let nested = t"<${#0}>"
let wrapped = t"${#0}${nested}"
assert_eq $wrapped.format(1) "1<1>"
assert_throws $std.MissingKeyError do outer.format()
