let rest = [2, 3]

assert (type (1, 2, 3) Tuple)
assert (type () Tuple)
assert (type (1,) Tuple)
assert_eq (1) 1
assert_eq () (tuple())
assert_eq (1,) (tuple 1)
assert_eq (1, "two", true) (tuple 1 "two" true)
assert_eq (1, 2,) (tuple 1 2)
assert_eq (1, ...rest) (tuple 1 2 3)
assert_eq (...rest, 4) (tuple 2 3 4)
assert_eq (...(0..3)) (tuple 0 1 2)

let t = (1 + 1, [3], (4,))
assert_eq $t[0] 2
assert_eq $t[1] [3]
assert_eq $t[2] (4,)

let a b = (1, 2)
assert_eq $a 1
assert_eq $b 2

def pair()
  (:first:, :second:)
assert_eq (pair()) (tuple :first: :second:)

let caught = try
  t[0] = 5
  false
catch _
  true
assert $caught

assert_eq (str((1,))) "(1,)"
assert_eq (str((1, 2))) "(1, 2)"
