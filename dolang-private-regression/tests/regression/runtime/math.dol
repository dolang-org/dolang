import math
import std:
  - MissingKeyError
  - MissingPosError
  - OverflowError
  - TypeError

assert_eq $math.PI 3.141592653589793
assert_eq $math.TAU (2.0 * math.PI)
assert_eq $math.E 2.718281828459045

assert_eq (math.sqrt 9) 3.0
assert_eq (math.cbrt -8) -2.0
assert_eq (math.exp 0) 1.0
assert_eq (math.expm1 0) 0.0
assert_eq (math.exp2 3) 8.0
assert_eq (math.log base: 2 8) 3.0
assert_eq (math.ln 1) 0.0
assert_eq (math.ln1p 0) 0.0
assert_eq (math.log2 8) 3.0
assert_eq (math.log10 100) 2.0

assert_eq (math.sin 0) 0.0
assert_eq (math.cos 0) 1.0
assert_eq (math.tan 0) 0.0
assert_eq (math.asin 0) 0.0
assert_eq (math.acos 1) 0.0
assert_eq (math.atan 0) 0.0
assert_eq (math.atan2 0 1) 0.0
assert_eq (math.sinh 0) 0.0
assert_eq (math.cosh 0) 1.0
assert_eq (math.tanh 0) 0.0
assert_eq (math.asinh 0) 0.0
assert_eq (math.acosh 1) 0.0
assert_eq (math.atanh 0) 0.0

assert_eq (math.hypot 3 4) 5.0
assert_eq (math.hypot 3 4 12) 13.0
assert_eq (math.gcd 54 24 -18) 6
assert_eq (math.gcd 0) 0
assert_eq (math.lcm 4 6 10) 60
assert_eq (math.lcm 0 6) 0

assert_eq (math.pow 2 10) 1024
assert_eq (type $ math.pow 2 10) $Int
assert_eq (math.pow 2 -1) 0.5
assert_eq (math.pow 9 0.5) 3.0
assert_throws $OverflowError do math.pow 2 127

assert_eq (math.degrees math.PI) 180.0
assert_eq (math.radians 180) $math.PI
assert_eq (math.copysign 3 -1) -3.0
assert $(math.sqrt -1).is_nan()
assert $(math.exp 1000).is_infinite()

assert_throws $MissingKeyError do math.log 8
assert_throws $MissingPosError do math.hypot 1
assert_throws $TypeError do math.sqrt true
assert_throws $TypeError do math.gcd 1.0
assert_throws $OverflowError do math.gcd -170141183460469231731687303715884105728
assert_throws $OverflowError do math.lcm -170141183460469231731687303715884105728
