let name = "Alice"

assert (type (a: 1) Record)
assert_eq (a: 1) (record a: 1)
assert_eq (a: 1,) (record a: 1)
assert_eq ((a: 1).a) 1
assert_eq (name: "Alice", age: 30) (record name: "Alice" age: 30)
assert_eq (:name) (record name: "Alice")
assert_eq (:name, age: 30) (record name: "Alice" age: 30)

let mixed = (1, 2, a: 3)
assert (type mixed Record)
assert_eq $mixed[0] 1
assert_eq $mixed[1] 2
assert_eq $mixed.a 3
assert_eq $mixed (record 1 2 a: 3)

let r = (name: "Alice", age: 30)
assert_eq (...r, age: 31) (record name: "Alice" age: 30 age: 31)

# Without a static key, a spread makes a tuple of the record's pairs
let spread = (...(record a: 1))
assert (type spread Tuple)
assert_eq $spread (tuple((:a:, 1)))
