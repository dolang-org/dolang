import
  std:
    - Iter
    - IterStop
    - ImmutableError
    - MissingPosError

# Record.contains tests - Record.contains is a class method taking record as first arg
assert (!(bool (record())))
assert (bool (record(a: 1)))

let rec = record(1, 2, 3, a: "first", b: "second", a: "second")
# Key-only checks
assert (Record.contains rec 0)
assert (Record.contains rec 1)
assert (Record.contains rec 2)
assert (Record.contains rec :a:)
assert (Record.contains rec :b:)
assert (!Record.contains rec 3)
assert (!Record.contains rec :z:)
# Key+value checks
assert (Record.contains rec 0 1)
assert (Record.contains rec 1 2)
assert (Record.contains rec :a: "first")
assert (Record.contains rec :a: "second")
assert (Record.contains rec :b: "second")
assert (!Record.contains rec 0 999)
assert (!Record.contains rec :a: "wrong")
assert (!Record.contains rec :nonexistent: "value")
# Empty record
assert (!Record.contains(record(), 0))

# Record.get instance tests
let r = record x: "first" x: "second" x: "third"
assert_eq (Record.len r) 3
assert_eq (Record.get r :x: -1) "third"
assert_eq (Record.get r :x: -2) "second"
assert_eq (Record.get r :x: -4) nil

# Record.values iterators
let vals = Record.values (name: "Alice", age: 30, name: "Bob")
assert (type vals Iter)
assert_eq [...vals] ["Alice", 30, "Bob"]

let keys = Record.keys (name: "Alice", age: 30, name: "Bob", title: "Dr.", age: 31)
assert (type keys Iter)
assert_eq [...keys] [:name:, :age:, :title:]

let keyed = Record.values (name: "Alice", age: 30, name: "Bob") :name:
assert (type keyed Iter)
assert_eq [...keyed] ["Alice", "Bob"]

let counted = (name: "Alice", age: 30, name: "Bob", 1, 2, age: 31)
assert_eq (Record.len counted) 6
assert_eq (Record.count counted) 4
assert_eq (Record.count counted :name:) 2
assert_eq (Record.count counted :age:) 2
assert_eq (Record.count counted 0) 1
assert_eq (Record.count counted :missing:) 0

assert_eq [...Record.values (name: "Alice") :missing:] []

let unpacked = Record.values (name: "Alice", age: 30, name: "Bob")
let first second ...rest = unpacked
assert_eq $first "Alice"
assert_eq $second 30
assert_eq [...rest] ["Bob"]

bind Record.values (name: "Alice")
  - first
  :missing = "fallback"
assert_eq $first "Alice"
assert_eq $missing fallback

bind Record.keys (name: "Alice", age: 30, name: "Bob")
  - first
  - second
  :missing = "fallback"
assert_eq $first :name:
assert_eq $second :age:
assert_eq $missing fallback

let failed_unpack = Record.values (name: "Alice")
let failed = try
  let _x _y = failed_unpack
  false
catch _
  true
assert $failed
assert_eq (failed_unpack.next()) "Alice"
assert_throws $IterStop do failed_unpack.next()

let failed_key_unpack = Record.keys (name: "Alice")
failed = try
  let _x _y = failed_key_unpack
  false
catch _
  true
assert $failed
assert_eq (failed_key_unpack.next()) :name:
assert_throws $IterStop do failed_key_unpack.next()

let keyed_source = (name: "Alice", age: 30, name: "Bob")
let keyed_iter = Record.values $keyed_source :name:
assert_throws $MissingPosError do
  let _x _y _z = keyed_iter
assert_eq (keyed_iter.next()) "Alice"
assert_eq (keyed_iter.next()) "Bob"
assert_throws $IterStop do keyed_iter.next()

let immutable = record(a: 1)
assert_throws $ImmutableError do immutable.a = 2
assert_throws $ImmutableError do immutable[:a:] = 2
assert_throws $std.FieldError do Record.insert
assert_throws $std.FieldError do Record.pop

class MyRecord: Record
  def (init) self source
    Record.(init) $self $source

let custom = MyRecord {name: "Alice", age: 30}
assert_eq $custom.name "Alice"
assert_eq $custom.age 30
assert (type custom MyRecord)

# A field lookup with no instance resolves to the *last* value for the key, so
# a duplicate key overrides the ones before it: last wins, the same rule dict
# indexing follows.
let dup = record a: 1 b: 2 a: 3
assert_eq $dup.a 3
assert_eq $dup[:a:] 3
assert_eq $dup.b 2
assert_eq [...Record.values dup :a:] [1, 3]
