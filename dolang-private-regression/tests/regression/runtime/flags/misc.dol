import
  std:
    - hash

def assert_err msg block
  let res = try
    block()
    false
  catch e
    assert_eq (str e) $msg
    true
  assert $res

let empty = TestFlags()
assert_eq $empty (TestFlags())
assert (!(empty.contains(:READ:)))
assert_eq [...empty] []

let r = TestFlags(:READ:)
assert (r.contains(:READ:))
assert (!(r.contains(:WRITE:)))
assert_eq [...r] [:READ:]

let rw = TestFlags(:READ:, :WRITE:)
assert_eq [...rw] [:READ:, :WRITE:]

let rw_seq = TestFlags([:READ:, :WRITE:])
assert_eq $rw $rw_seq

let exec = TestFlags(:EXEC:)
let all = (rw | exec)
assert_eq [...all] [:READ:, :WRITE:, :EXEC:]

assert_eq (rw & r) $r
assert_eq (rw ^ r) (TestFlags(:WRITE:))
assert_eq (~all) $empty
assert_eq (~empty) $all

assert_eq (hash rw) (hash rw_seq)

assert_err "value error: unrecognized flag: BOGUS" do TestFlags(:BOGUS:)
assert_err "value error: unrecognized flag: BOGUS" do TestFlags([:READ:, :BOGUS:])

assert_eq (coerce_flags rw) $rw
assert_eq (coerce_flags :READ:) $r
assert_eq (coerce_flags [:READ:, :WRITE:]) $rw
assert_eq (coerce_flags []) $empty
assert_err "value error: unrecognized flag: BOGUS" do coerce_flags :BOGUS:
assert_err "value error: unrecognized flag: BOGUS" do coerce_flags [:BOGUS:]
assert_err "type error: iteration protocol not supported" do coerce_flags 42
