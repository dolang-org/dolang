import std:
  - MissingPosError
  - UnexpectedKeyError
  - UnexpectedPosError

let data = $
  - 1
  ...[2, 3]
  - 4
assert_eq $data [1, ...[2, 3], 4]
assert_eq $data [1, 2, 3, 4]

data = $
  - 1
  foo: bar
  ...{bar: 42}
  - 4
assert_eq $data {1, foo: "bar", ...{bar: 42}, 4}
assert_eq $data {1, foo: "bar", bar: 42, 4}

let mapped = ["foo=bar", "baz=qux"].iter().map do |e| e.split "="
let atomic = {...mapped}
assert_eq (Array atomic[0]) ["foo", "bar"]
assert_eq (Array atomic[1]) ["baz", "qux"]

let items = [1, 2, 3].iter()
assert_eq (Array items) [1, 2, 3]

# Sequences take only a dict's positional items; `.iter()` gives its pairs.
assert_eq [...{1, 2}] [1, 2]
assert_throws $std.UnexpectedKeyError do [...{1, foo: "bar", 2}]
assert_throws $std.UnexpectedKeyError do Array {1, foo: "bar", 2}
assert_throws $std.UnexpectedKeyError do Tuple({1, foo: "bar", 2})
assert_eq (Array({1, foo: "bar", 2}.iter())) [(0, 1), (:foo:, "bar"), (1, 2)]
assert_eq (Tuple({1, 2})) (1, 2)

# Lowercase collection factories accept literal-like variadic arguments.
assert_eq (array()) []
assert_eq (array 1 2 3) [1, 2, 3]
assert_eq (tuple()) (Tuple [])
assert_eq (tuple 1 2 3) (Tuple [1, 2, 3])
assert_eq (dict 1 2 foo: 3) {1, 2, foo: 3}
assert_eq (record 1 2 foo: 3) (Record {1, 2, foo: 3})

# Capitalized raw constructors consume one iterable or spreadable.
assert_eq (Array [1, 2, 3]) [1, 2, 3]
assert_eq (Tuple [1, 2, 3]) (tuple 1 2 3)
assert_eq (Dict {1, 2, foo: 3}) {1, 2, foo: 3}
assert_eq (Record {1, 2, foo: 3}) (record 1 2 foo: 3)

assert_throws $UnexpectedKeyError do array foo: 1
assert_throws $UnexpectedKeyError do tuple foo: 1
assert_throws $MissingPosError do Array()
assert_throws $UnexpectedPosError do Array [] []
assert_throws $MissingPosError do Dict()
assert_throws $UnexpectedPosError do Dict {} {}
assert_throws $MissingPosError do Tuple()
assert_throws $UnexpectedPosError do Tuple [] []
assert_throws $MissingPosError do Record()
assert_throws $UnexpectedPosError do Record {} {}
