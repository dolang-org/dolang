# `for` and `if` elements in comma-delimited lists build into the enclosing
# collection, as vertical comprehensions do
let xs = [1, -2, 3]
let ys = [:a:, :b:]

assert_eq [for x = xs => x * 2] [2, -4, 6]
assert_eq [for x = xs => if x > 0 => x] [1, 3]
assert_eq [for x = [1, "a", 2] => if let Int(n) = x => n] [1, 2]
assert_eq [for d = [{a: 1}, {b: 2}] => if bind d => :a => a] [1]

# Elements nest, and `=>` may be followed by a spread
assert_eq $[for x = xs => for y = ys => (x, y)].len 6
assert_eq [for x = [1, 2] => for y = [10] => x + y] [11, 12]
assert_eq [for d = [[1, 2], [3]] => ...d] [1, 2, 3]

# An element ends at `,`, so later items are outside it
assert_eq [for x = xs => x, 0] [1, -2, 3, 0]

# Mixed with ordinary items
let verbose = true
let rest = [:x:]
assert_eq ["build", if verbose => "-v", ...rest] ["build", "-v", :x:]
assert_eq ["build", if false => "-v", ...rest] ["build", :x:]

# Whitespace inside the brackets is insignificant
let wrapped = [
  for x = xs =>
    x * 10,
  0,
]
assert_eq $wrapped [10, -20, 30, 0]

# Without an iteratee, `for` reads the strand's input
def doubled()
  [for x => x * 2]
assert_eq (pipeline (do strand.from [1, 2]) doubled) [2, 4]

# A pattern can destructure
assert_eq [for a b = [(1, 2), (3, 4)] => a + b] [3, 7]

# C-style call arguments
def run src :verbose = false ..._opts
  (src, verbose)
assert_eq (run(1, if verbose => verbose: true)) (1, true)
assert_eq (run(1, if false => verbose: true)) (1, false)
def count ...args
  args.len
assert_eq (count(for x = xs => x, 0)) 4

# `f[...]` with an element is a call with an array, as with a spread
def first a
  a[0]
assert_eq (first[for x = xs => x * 3]) 3

# Braces: a computed key makes a dict, and a positional item a record
let src = {a: 1, b: 2}
let scaled = {for k v = src => (k): v * 10}
assert_eq (type scaled) $Dict
assert_eq $scaled {a: 10, b: 20}
let rec = {for x = xs => x}
assert_eq (type rec) $Record
assert_eq $rec[0] 1

# A key item is a literal symbol key, not the loop variable
let keyed = {for _k = [1] => k: 2}
assert_eq $keyed {k: 2}

# Parentheses: a tuple, or a pack once a static key appears under an element
let t = (for x = xs => x)
assert_eq (type t) $Tuple
assert_eq $t (1, -2, 3)
let p = (for x = xs => if x > 2 => name: x)
assert_eq (type p) $Pack
assert_eq $p[:name:] 3
