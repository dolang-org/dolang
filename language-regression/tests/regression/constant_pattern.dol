# Lone constants test the value, including falsy values.
let 200 = 200
let -200 = -200
let "$(200)" = "200"
let "foo" = "foo"
let :ok: = :ok:
let true = true
let false = false
let nil = nil
let b"bytes" = b"bytes"
let 1.5 = 1.5
if let false = false
  assert true
else
  assert false
if let nil = nil
  assert true
else
  assert false
if let 200 = 404
  assert false
if let "foo" = "bar"
  assert false
if let true = false
  assert false

# A parenthesized singleton unpacks rather than collapsing.
let (200) = [200]
if let (200) = []
  assert false

# Constants retain their slots through later nested unpacks and class tests.
let "GET" (200 path) Int(count) false = ["GET", [200, "/"], 3, false]
assert_eq [path, count] ["/", 3]
let (1 a) 2 (3 b) 4 c = [[1, 10], 2, [3, 20], 4, 30]
assert_eq [a, b, c] [10, 20, 30]
let status: 200 :body "code": :ok: = {status: 200, body: "ok", "code": :ok:}
assert_eq $body "ok"
let Array("GET" path) = ["GET", "/hello"]
assert_eq $path "/hello"
let Bool(false) = false

bind ["GET", [200, "body"], false]
  - "GET"
  - (200 content)
  - false
assert_eq $content "body"
bind {status: 200, body: nil}
  status: 200
  body:
    nil

# Each failure must discard originals and temporary unpack results.
for value = [[0, [3, 20], 4], [1, [0, 20], 4], [1, [3, 20], 0], [1, [], 4]]
  if let 1 (3 _b) 4 = value
    assert false
  assert_eq (2 + 3) 5
if let 1 (3 b) 4 = [1, [3, 20], 4]
  assert_eq $b 20
else
  assert false
if bind {status: 404, body: "wrong"}
  status: 200
  :body
do
  assert_eq $body "wrong"
  assert false
else
  assert true

# A plain mismatch raises, and preserves the result of a successful binding.
let raised = try
  let 200 = 404
  false
catch std.TypeError: _
  true
assert_eq $raised true
let failure = try
  let "GET" _path = ["POST", "/"]
  false
catch std.TypeError: err
  assert $str(err).contains(r#""GET""#)
  assert $str(err).contains(r#""POST""#)
  true
assert $failure

# Constants compose with iteration and captured bindings.
let total = 0
for 200 n = [[200, 2], [200, 3]]
  total = (total + n)
assert_eq $total 5
let "capture" captured = ["capture", 42]
let closure = do captured
assert_eq (closure()) 42
def successful()
  let "ok" _n = ["ok", 9]
assert_eq (successful()) ["ok", 9]

# Value assertions and conditional tests both use ordinary equality.
class Equal
  def (eq) _self _other
    true
let equal = Equal()
assert (equal == 200)
let 200 = equal
if let 200 = equal
  assert true
else
  assert false

# Lambda parameters take constants as ad-hoc assertions.
let constant_lambda = (do |200 value| value)
assert_eq (constant_lambda 200 42) 42
assert_throws $std.TypeError do constant_lambda 404 42
let constant_key = do |status: 200 :body| body
assert_eq (constant_key status: 200 body: "ok") "ok"
