# A parenthesized item matches its value against a sub-pattern
let a (b c) = [1, [2, 3]]
assert_eq [a, b, c] [1, 2, 3]

# Sub-patterns nest, and needn't come last
let (p (q r)) s = [[1, [2, 3]], 4]
assert_eq [p, q, r, s] [1, 2, 3, 4]

# A lone sub-pattern matches the whole value, so `(x)` unpacks a 1-item
# sequence, where `x` alone would bind the sequence itself
let (x) = [9]
assert_eq $x 9
let y = [9]
assert_eq $y [9]

# `()` matches an empty value
let () = []
let e () = [1, {}]
assert_eq $e 1

# Keyed items take sub-patterns too, with rests and keys inside
let (first ...more) :k = {[1, 2, 3], k: 4}
assert_eq [first, ...more, k] [1, 2, 3, 4]
let "s": (:z) = {"s": {z: 5}}
assert_eq $z 5

# Items within `()` may have defaults, which can read earlier bindings
let (d1 d2 = (d1 + 1) d3 = 0) = [5]
assert_eq [d1, d2, d3] [5, 6, 0]

# Within `()`, newlines are only whitespace
let w (
  w1
  w2
) = [1, [2, 3]]
assert_eq [w, w1, w2] [1, 2, 3]

# Vertical layout nests under keys and dashes
bind {1, k: [5, 6], "s": {z: 7}, extra: true}
  - v
  k: (k1 k2)
  "s":
    :z
  ...
assert_eq [v, k1, k2, z] [1, 5, 6, 7]
bind [1, [2, 3]]
  - a
  - (b c)
assert_eq [a, b, c] [1, 2, 3]

# A key block holding one item matches the key's value against that item
bind {k: [1, 2]}
  k:
    (k1 k2)
assert_eq [k1, k2] [1, 2]

# A failed sub-pattern raises, leaving nothing bound outside the `try`
let caught = try
  let _u (_t) = [1, [2, 3]]
  false
catch _
  true
assert $caught

# Function parameters
def f a (b c)
  (a + b + c)
assert_eq (f(1, [2, 3])) 6
let g = (do |(m n)| m * n)
assert_eq (g([3, 4])) 12
def vf
  k:
    :x
    :y
do
  (x * y)
assert_eq (vf k: {x: 3, y: 4}) 12

# Loops
let pairs = []
for key (lo hi) = [["a", [1, 2]], ["b", [3, 4]]]
  pairs.push "$key:$lo-$hi"
assert_eq $pairs ["a:1-2", "b:3-4"]

# A closure captures a nested binding
let (cap) = [42]
let get = do cap
assert_eq (get()) 42
