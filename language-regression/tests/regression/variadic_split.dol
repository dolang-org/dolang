# `*` and `**` rests in function parameters

import
  std: error

def pos first *rest
  [first, rest]

def keyed first **rest
  [first, rest]

def both first :k = 0 *xs **kw
  [first, k, xs, kw]

def discard_pos first *
  first

def discard_keyed first **
  first

def discard_both * **
  nil

# `*rest` is a tuple of the positional leftovers
let a r = pos 1 2 3
assert_eq $a 1
assert_eq (type r) $Tuple
assert_eq $r (2, 3)
assert_eq $(pos 1)[1] ()

# `**rest` is a record of the keyed leftovers
let b kw = keyed 1 x: 2 y: 3
assert_eq $b 1
assert_eq (type kw) $Record
assert_eq $kw (x: 2, y: 3)
assert_eq $kw.x 2
assert_eq $(keyed 1)[1] $record()

# Named keyword parameters take their keys first
assert_eq (both 1 2 k: 3 z: 4 5) [1, 3, (2, 5), (z: 4)]
assert_eq (both 1) [1, 0, (), record()]

# Spreading an argument pack sorts its items between the rests
assert_eq (both ...{1, k: 2, 3, w: 4}) [1, 2, (3,), (w: 4)]

# Bare rests accept leftovers without keeping them
assert_eq (discard_pos 1 2 3) 1
assert_eq (discard_keyed 1 x: 2) 1
discard_both 1 2 x: 3

# Lambdas take them too
let l = do |*xs **kw| [xs, kw]
assert_eq (l 1 a: 2 3) [(1, 3), (a: 2)]

# A leftover of a kind no rest takes is an error
assert_throws $error.UnexpectedKeyError str: "unexpected key item: k" do pos 1 k: 2
assert_throws $error.UnexpectedPosError str: "unexpected positional item: 1" do keyed 1 2
assert_throws $error.UnexpectedKeyError str: "unexpected key item: x" do discard_pos 1 x: 2
assert_throws $error.UnexpectedPosError str: "unexpected positional item: 1" do discard_keyed 1 2
