# `*` and `**` rests when destructuring keyed sources

import
  std: error

def pairs source
  $
    for k v = Dict(source)
      - (Tuple [k, v])

def args ...rest
  rest

# A dict has no positional items: a `*` rest is empty, and a `**` rest takes
# every leftover pair, integer keys included
let d = {0: "x", 1: "y", 5: "z", n: 1}
let *pr **kr = d
assert_eq $pr ()
assert_eq (pairs kr) [(Tuple [0, "x"]), (Tuple [1, "y"]), (Tuple [5, "z"]), (Tuple [:n:, 1])]

# An integer key pattern is an ordinary key lookup
let 0: q **kq = d
assert_eq $q x
assert_eq (pairs kq) [(Tuple [1, "y"]), (Tuple [5, "z"]), (Tuple [:n:, 1])]

# A positional pattern finds nothing
assert_throws $error.MissingPosError do
  let _p ... = d

# A `**` rest spreads as keys
let **ko = {0: "a", n: 1}
assert_eq [...{...ko}.iter()] [(Tuple [0, "a"]), (Tuple [:n:, 1])]
let **ka = {0: "a"}
assert_throws $error.UnexpectedKeyError do
  args ...ka

# `*` alone rejects keyed leftovers, integer keys included
assert_throws $error.UnexpectedKeyError str: "unexpected key item: 0" do
  let *_s = {0: 1}
assert_throws $error.UnexpectedKeyError str: "unexpected key item: n" do
  let *_s = {n: 2}

# Spreading both rests passes what spreading the dict would
let dd = {m: "x", n: 1}
let *ds **dk = dd
assert_eq (args ...ds ...dk) (args ...dd)

# A rest's own rests are keyed only too
let 0: _a ...pa = {0: "a", 1: "b", n: 1}
let 1: pb *pc **pk = pa
assert_eq $pb b
assert_eq $pc ()
assert_eq (pairs pk) [(Tuple [:n:, 1])]
let pm = {0: "a", 1: "b"}
let **pf = pm
pm.insert 2 c
assert_throws $std.ConcurrencyError do
  {...pf}

# `Args` behave the same
let t1 *t2 **t3 = (args 1 2 a: 3)
assert_eq [t1, t2] [1, (2,)]
assert_eq (pairs t3) [(Tuple [:a:, 3])]

# Key parameters take their keys first
let :n **rest = d
assert_eq $n 1
assert_eq (pairs rest) [(Tuple [0, "x"]), (Tuple [1, "y"]), (Tuple [5, "z"])]

# Rests of a `...` rest continue from where it stands
let 0: first ...more = d
let 1: second *mp **mk = more
assert_eq [first, second, mp] ["x", "y", ()]
assert_eq (pairs mk) [(Tuple [5, "z"]), (Tuple [:n:, 1])]

# A `**` rest has no positional items
let **kw = {a: 1}
assert_throws $error.MissingPosError do
  let _k1 *_ = kw

# Argument packs: `*` gets a tuple and `**` an `Args`, as in a call
let a *as **ak = (args 1 k: 2 3)
assert_eq $a 1
assert_eq $as (3,)
assert_eq $ak (k: 2)
assert_eq (type ak) $Args
assert_throws $error.UnexpectedKeyError do
  let _a *_as = (args 1 k: 2)
assert_throws $error.UnexpectedPosError do
  let _a **_ak = (args 1 2)

# Object fields are keyed items: `*` gets nothing
class Point
  pub field x = 1
  pub field y = 2

let :x *fp **fk = fields(Point())
assert_eq $x 1
assert_eq $fp ()
assert_eq (pairs fk) [(Tuple [:y:, 2])]
assert_throws $error.UnexpectedKeyError do
  let x: _x *_ = fields(Point())

# Key defaults and positional defaults fill separate slots
bind {k: 5}
  - b1 = 2
  :k
  :j = 3
assert_eq [b1, k, j] [2, 5, 3]

# A `...` rest keeps the other integer keys and later instances of a key
let 0: _x ...r1 = {0: "a", 5: "b", n: 1}
assert_eq (pairs r1) [(Tuple [5, "b"]), (Tuple [:n:, 1])]
let :dup ...r2 = (args dup: 1 dup: 2 b: 3)
assert_eq $dup 1
assert_eq (pairs r2) [(Tuple [:dup:, 2]), (Tuple [:b:, 3])]

# A missing key is an error even with a rest
assert_throws $error.MissingKeyError do
  let :_missing ... = (args 1)
