import std:
  - verbatim

# Lowercase coercions
assert_eq  (bool nil) false
assert_eq  (bool false) false
assert_eq  (bool true) true
assert_eq  (bool 0) false
assert_eq  (bool 1) true
assert_eq  (bool 0.0) false
assert_eq  (bool 1.0) true
assert_eq  (bool(0.0 / 0.0)) true
assert_eq  (bool(1.0 / 0.0)) true
assert_eq  (bool(-1.0 / 0.0)) true
assert_throws $std.RuntimeError str: "type error: int: `nil` can't be converted" do int nil
assert_eq  (int false) 0
assert_eq  (int true) 1
assert_eq  (int 5) 5
assert_eq  (int 5.0) 5
assert_eq  (int 2.5) 2
assert_eq  (int "5") 5
assert_throws $std.RuntimeError str: "type error: float: `nil` can't be converted" do float nil
assert_eq  (float false) 0.0
assert_eq  (float true) 1.0
assert_eq  (float 5) 5.0
assert_eq  (float 2.5) 2.5
assert_eq  (float "2.5") 2.5
assert_eq  (float ".5") 0.5
assert_eq  (float "1.1e0") 1.1
assert_eq  (float "1.1e-1") 0.11
assert_eq  (float "1.1e+1") 11.0
# Str conversions
assert_eq  (str nil) "nil"
assert_eq  (str false) "false"
assert_eq  (str true) "true"
assert_eq  (str 5) "5"
assert_eq  (str -5) "-5"
assert_eq  (str 2.5) "2.5"
assert_eq  (str(1.0 / 0.0)) "inf"
assert_eq  (str(-1.0 / 0.0)) "-inf"
assert_eq  (str(0.0 / 0.0)) "NaN"
assert_eq  (str "foo") "foo"

# Capitalized constructors reject lossy or interpretive conversions.
assert_eq (Bool true) true
assert_throws $std.RuntimeError str: "type error: Bool: expected Bool" do Bool 1

assert_eq (Int 5) 5
assert_eq (Int true) 1
assert_eq (Int 5.0) 5
assert_throws $std.RuntimeError str: "type error: Int: expected Int, Bool, or integral Float" do Int 2.5
assert_throws $std.RuntimeError str: "type error: Int: expected Int, Bool, or integral Float" do Int "5"

assert_eq (Float 2.5) 2.5
assert_eq (Float 9007199254740992) 9007199254740992.0
assert_throws $std.RuntimeError str: "type error: Float: Int cannot be represented exactly" do Float 9007199254740993
assert_throws $std.RuntimeError str: "type error: Float: expected Float or Int" do Float true

assert_eq (Str "foo") "foo"
assert_eq (Str b"foo") "foo"
assert_throws $std.RuntimeError str: "value error: Str: invalid UTF-8" do Str b"\xff"
assert_throws $std.RuntimeError str: "type error: Str: expected Str or Bin" do Str 5

assert_eq (Sym :foo:) :foo:
assert_throws $std.RuntimeError str: "type error: Sym: expected Sym" do Sym "foo"
assert_eq (sym "foo") :foo:

assert_eq (Bin "foo") b"foo"
assert_eq (Bin b"foo") b"foo"
assert_throws $std.RuntimeError str: "type error: Bin: expected Str or Bin" do Bin 5

# Streaming conversions through a native object's formatting implementation
let foo = makefoo()
assert_eq (str foo) "foo"
assert_eq (dbg foo) "foo"
assert_eq (verbatim foo) "foo"
assert_eq "before-$(foo)-after" "before-foo-after"
assert_eq (",".join [foo, 2, [3]]) "foo,2,[3]"
