class Base
  field value = 0

  def (init) obj value
    obj.#value = value

  def read obj
    (obj).#value

  pub def captured obj
    do obj.#read()

  pub def named obj
    def read()
      obj.#value
    read()

class Child: Base
  def (init) instance value
    if true
      (Base.(init)) (instance) $value

let obj = Child 42
let captured = obj.captured()
assert_eq $captured() 42
assert_eq $obj.named() 42

# Shadowing creates a new, ordinary binding, which remains assignable.
class Shadow
  pub def run self
    let _ = self
    let self = 1
    self = 2
    self
assert_eq $(Shadow().run()) 2

class Spread: Base
  def (init) obj value
    Base.(init)(obj, ...[value])
assert_eq $(Spread(7).named()) 7

class Counter
  #[class]
  field count = 0

  #[static]
  field total = 0

  #[class]
  def bump cls
    cls.#count = (cls.#count + 1)
    cls.#count

  #[class]
  pub def next cls
    let bound = cls.#bump
    bound()

  # A static member has no receiver, so it reaches its class's private members
  # through the class's own name.
  #[static]
  pub def add()
    Counter.#total = (Counter.#total + 1)
    Counter.#total

  #[static]
  pub def deferred()
    do Counter.#total

  #[static]
  #[getter]
  pub def current()
    Counter.#total

  #[static]
  #[setter]
  pub def current value
    Counter.#total = value

  # So does any other member
  pub def peek _self
    Counter.#total

class Derived: Counter
assert_eq $Counter.next() 1
assert_eq $Derived.next() 1
assert_eq $Counter.next() 2
assert_eq $Counter.add() 1
assert_eq $Counter().peek() 1
let deferred = Counter.deferred()
assert_eq $Counter.add() 2
assert_eq $deferred() 2
assert_eq $Counter.current 2
Counter.current = 10
assert_eq $Counter.add() 11
