for i = Range start: 0 end: 5
  echo $i
for i = Range start: 5 end: 0 step: -1
  echo $i
echo (Range start: 3.14159 end: 22 step: 0.33)

# contains tests - range is [start, end) inclusive start, exclusive end
let r1 = Range start: 0 end: 5
assert (r1.contains 0)
assert (r1.contains 1)
assert (r1.contains 4)
assert (!r1.contains 5)
assert (!r1.contains -1)
assert (!r1.contains 100)

# reversed range (decreasing)
let r2 = Range start: 5 end: 0 step: -1
assert (r2.contains 5)
assert (r2.contains 4)
assert (r2.contains 1)
assert (!r2.contains 0)
assert (!r2.contains 6)

# Float range
let r3 = Range start: 0.0 end: 5.0
assert (r3.contains 0.0)
assert (r3.contains 2.5)
assert (r3.contains 4.9)
assert (!r3.contains 5.0)
assert (!r3.contains -0.1)
# without an explicit step, membership is the interval alone
assert (r1.contains 2.5)

# step granularity
let evens = Range 0 10 2
assert (evens.contains 4)
assert (!evens.contains 3)
assert (!evens.contains 10)
let down = Range 9 0 -3
assert (down.contains 9)
assert (down.contains 3)
assert (!down.contains 4)
assert (!down.contains 0)
let halves = Range 0.0 2.0 0.5
assert (halves.contains 1.5)
assert (!halves.contains 1.25)

# open-ended ranges
let open = 3..
assert (open.contains 3)
assert (open.contains 1000)
assert (!open.contains 2)
assert ((Range 3 nil -1).contains -1000)
assert (!(Range 3 nil -1).contains 4)

# the step never defaults to -1: bounds against the step are empty
assert_eq [...(5..1)] []
assert_eq [...(Range 1 5 -1)] []
assert_eq [...(Range 5 1 1)] []
assert_eq [...(3..3)] []
assert_eq [...(Range 5 1 -1)] [5, 4, 3, 2]
assert_eq [...(Range 0 7 3)] [0, 3, 6]
assert (!(5..1).contains 3)
assert (!(Range 1 5 -1).contains 3)

assert_throws $std.ValueError str: "value error: range step must not be zero" do
  [...(Range 0 5 0)]
assert_throws $std.ValueError str: "value error: range step must not be zero" do
  (Range 0 5 0).contains 1
# a missing start counts from 0
assert_eq [...(Range 4)] [0, 1, 2, 3]
assert ((..5).contains 3)
assert (!(..5).contains -1)

# a reversed slice is empty, not an error
let arr = [0, 1, 2, 3]
assert_eq $arr[3..1] []
assert_eq $arr[Range 1 3 -1] []
assert_eq ("abcd"[3..1]) ""
assert_eq (b"abcd"[3..1]) b""
let grow = [0, 1, 2, 3]
grow[3..1] = [9]
assert_eq $grow [0, 1, 2, 9, 3]

# output: END
# 0
# 1
# 2
# 3
# 4
# 5
# 4
# 3
# 2
# 1
# <Range start: 3.14159, end: 22, step: 0.33>
# END
