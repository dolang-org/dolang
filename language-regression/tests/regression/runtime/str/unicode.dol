# Existing string operations remain byte-oriented.
assert_eq $"é".len 2
assert_throws $std.RuntimeError str: "invalid UTF-8 substring boundaries" do "é"[0..1]
assert_eq $"éx"[2..] "x"

# Unicode scalar and extended-grapheme views.
let text = "Aé👩‍💻界"
let scalars = text.scalars()
let graphemes = text.graphemes()
assert_eq $scalars.len 7
assert_eq $graphemes.len 4
assert_eq $scalars[0] "A"
assert_eq $scalars[-1] "界"
assert_eq $scalars[1..3] "é"
assert_eq $graphemes[1] "é"
assert_eq $graphemes[2] "👩‍💻"
assert_eq $graphemes[-1] "界"
assert_eq $graphemes[1..3] "é👩‍💻"
assert_eq $graphemes[2..2] ""
assert_throws $std.RuntimeError str: "index out of range or invalid" do scalars[99]
assert_throws $std.RuntimeError str: "index out of range or invalid" do
  graphemes[Range start: 0 end: 3 step: 2]

assert_eq [...scalars] ["A", "e", "́", "👩", "‍", "💻", "界"]
assert_eq [...graphemes] ["A", "é", "👩‍💻", "界"]
assert_eq ("A".scalar()) 65
assert_eq ("́".scalar()) 769
assert_eq ("😀".scalar()) 128512
assert_throws $std.RuntimeError str: "value error: str.scalar: expected exactly one Unicode scalar" do
  "".scalar()
assert_throws $std.RuntimeError str: "value error: str.scalar: expected exactly one Unicode scalar" do
  "é".scalar()
let a b ...rest = text.graphemes()
assert_eq $a "A"
assert_eq $b "é"
assert_eq [...rest] ["👩‍💻", "界"]

# Views and partially-consumed iterators root temporary source strings.
let temporary_view = ("root".repeat 1000).graphemes()
assert_eq $temporary_view[-1] "t"
let temporary_iter = ("👩‍💻x".repeat 1000).graphemes().iter()
assert_eq $temporary_iter.next() "👩‍💻"
let garbage = "z".repeat 100000
assert_eq $garbage.len 100000
assert_eq $temporary_iter.next() "x"
