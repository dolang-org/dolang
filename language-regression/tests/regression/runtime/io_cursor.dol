import io:
  - Buffered
  - Concat
  - Cursor
  - Io
import regression2:
  - byte_write

# io.Cursor: a seekable Io over in-memory data

# Reading a Bin
let c = Cursor b"hello world"
assert (type c Io)
assert_eq (c.readable, c.writable, c.seekable) (true, false, true)
assert_eq $c.read(5) b"hello"
assert_eq $c.read(100) b" world"
assert_eq $c.read(1) b""

# Reading a Str yields its bytes
let c = Cursor "café"
assert_eq $c.read(4) b"caf\xc3"
assert_eq $c.read(4) b"\xa9"
assert_eq $c.seek(start: 0) 0
assert_eq $c.read_all_str() "café"

# Windows
let c = Cursor b"0123456789" (2..5)
assert_eq $c.read(10) b"234"
assert_eq $c.read(10) b""
assert_eq $c.seek(end: 0) 3
assert_eq $c.seek(start: 1) 1
assert_eq $c.read(1) b"3"
assert_eq $c.seek(-2) 0

let c = Cursor b"0123456789" (7..)
assert_eq $c.read_all() b"789"
assert_eq $c.seek(end: -1) 2

let c = Cursor b"0123" (10..20)
assert_eq $c.read(5) b""
assert_eq $c.seek(end: 0) 10

let c = Cursor b"0123" nil
assert_eq $c.read_all() b"0123"

# Seeking past the end reads nothing; before the start raises
let c = Cursor b"abc"
assert_eq $c.seek(start: 10) 10
assert_eq $c.read(1) b""
assert_throws $std.ValueError do c.seek -11
assert_eq $c.seek(0) 10

# Bad targets and ranges
assert_throws $std.TypeError do Cursor 42
assert_throws $std.TypeError do Cursor b"abc" [1, 2]
assert_throws $std.ValueError do Cursor b"abc" (-1..2)
assert_throws $std.ValueError do Cursor b"abc" (2..1)
assert_throws $std.ValueError do Cursor b"abc" (Range 0 3 2)

# An immutable target doesn't write
assert_throws $std.StateError do Cursor("abc").write "x"

# Closing
let c = Cursor b"abc"
c.close()
assert_eq (c.readable, c.writable, c.seekable) (false, false, false)
assert_throws $std.StateError do c.read 1
assert_throws $std.StateError do c.seek 0
c.close()

# BinBuf: overwrite in the middle, extend at the end
let buf = BinBuf(b"0123456789")
let c = Cursor $buf
assert_eq (c.readable, c.writable, c.seekable) (true, true, true)
c.seek start: 2
assert_eq $c.write("ab", b"c") 3
assert_eq $buf[0..10] b"01abc56789"
c.seek end: -1
assert_eq $c.write("XYZ") 3
assert_eq $buf[0..12] b"01abc5678XYZ"
assert_eq $c.seek(0) 12

# Writing past the end zero-fills the gap
let buf = BinBuf(b"ab")
let c = Cursor $buf
c.seek start: 4
c.write "z"
assert_eq $buf.freeze() b"ab\x00\x00z"

# Reads follow the live buffer
let buf = BinBuf(b"abc")
let c = Cursor $buf
assert_eq $c.read(10) b"abc"
buf.push 100
assert_eq $c.read(10) b"d"
buf.clear()
c.seek start: 0
assert_eq $c.read(10) b""

# A bounded window cuts writes short
let buf = BinBuf(b"0123456789")
let c = Cursor $buf (2..5)
assert_eq $c.write("abcd") 3
assert_eq $c.write("e") 0
assert_eq $buf.freeze() b"01abc56789"

let buf = BinBuf(b"0123456789")
let c = Cursor $buf (8..)
c.write "abcd"
assert_eq $buf.freeze() b"01234567abcd"

# write takes only Str and Bin pieces, and writes nothing otherwise
let buf = BinBuf(b"0123")
let c = Cursor $buf
assert_throws $std.TypeError do c.write "a" 1
assert_eq $buf.freeze() b"0123"

# StrBuf: an unfinished character is held until complete
let text = StrBuf()
let c = Cursor $text
assert_eq (c.readable, c.writable, c.seekable) (true, true, true)
assert_eq $c.write(b"caf\xc3") 4
assert_eq $text[0..3] "caf"
assert_eq $c.seek(0) 3
c.flush()
assert_eq $text[0..3] "caf"
assert_eq $c.write(b"\xa9!") 2
assert_eq $text.freeze() "café!"
assert_eq $c.seek(0) 6

# Seeking or closing with bytes held raises; the close still closes
let text = StrBuf()
let c = Cursor $text
c.write b"\xe2\x82"
assert_throws $std.ValueError do c.seek start: 0
assert_throws $std.ValueError do c.close()
assert (!c.writable)
assert_eq $text.freeze() ""

# Invalid UTF-8 raises and changes nothing
let text = StrBuf()
text.append "ok"
let c = Cursor $text
c.seek end: 0
c.write b"\xc3"
assert_throws $std.ValueError do c.write b"\xff"
assert_eq $text[0..2] "ok"
c.write b"\xa9"
assert_eq $text.freeze() "oké"

# Overwrites must not split a character
let text = StrBuf()
text.append "aéb"
let c = Cursor $text
c.seek start: 2
assert_throws $std.ValueError do c.write "x"
c.seek start: 1
assert_throws $std.ValueError do c.write "x"
assert_eq $text[0..4] "aéb"
assert_eq $c.write("xy") 2
assert_eq $text[0..4] "axyb"

# ASCII overwrites always fit
let text = StrBuf()
text.append "hello world"
let c = Cursor $text (6..)
c.write "WORLD"
assert_eq $text.freeze() "hello WORLD"

# A StrBuf past its end isn't a boundary
let text = StrBuf()
let c = Cursor $text
c.seek start: 1
assert_throws $std.ValueError do c.write "x"

# Through the Io bridge
let buf = BinBuf()
let c = Cursor $buf
let b = Buffered $c
b.write "buffered"
b.flush()
assert_eq $buf[0..8] b"buffered"
b.seek start: 0
assert_eq $b.read(3) b"buf"

let text = StrBuf()
let c = Cursor $text
(Concat ["café", "olé"] end: "\n").copy_to $c
c.close()
assert_eq $text.freeze() "café\nolé\n"

let buf = BinBuf(b"xxxx")
let c = Cursor $buf (1..)
byte_write $c b"native"
assert_eq $buf.freeze() b"xnative"

# An Io target: a window of another stream
let inner = Cursor b"0123456789"
let c = Cursor $inner (2..6)
assert_eq (c.readable, c.writable, c.seekable) (true, false, true)
assert_eq $c.read(10) b"2345"
assert_eq $c.read(10) b""
assert_eq $c.seek(end: -1) 3
assert_eq $c.read(1) b"5"
assert_throws $std.ValueError do c.seek -10
assert_throws $std.StateError do c.write "x"
c.close()
assert_throws $std.StateError do c.read 1
assert $inner.readable

# The cursor seeks the target before each operation, wherever it was left
let inner = Cursor b"0123456789"
let c = Cursor $inner (5..)
inner.seek start: 1
assert_eq $c.read(2) b"56"
inner.seek start: 9
assert_eq $c.read(2) b"78"
assert_eq $c.seek(end: 0) 5

# Writes go through, cut short at the end of a bounded window
let buf = BinBuf(b"0123456789")
let c = Cursor (Cursor buf) (4..7)
assert $c.writable
assert_eq $c.write("ab", "cdef") 3
assert_eq $c.write("g") 0
c.seek start: 0
assert_eq $c.read(10) b"abc"
c.flush()
assert_eq $buf.freeze() b"0123abc789"

# A native consumer shares the cursor's position
let buf = BinBuf(b"xxxxxxxx")
let c = Cursor (Cursor buf) (2..)
byte_write $c b"abc"
assert_eq $c.seek(0) 3
assert_eq $buf.freeze() b"xxabcxxx"

# The target must read and seek
assert_throws $std.ValueError do Cursor $Concat(["a"])
