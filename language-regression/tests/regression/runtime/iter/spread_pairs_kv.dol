# Every iterator spreads pair elements positionally, which a dict refuses; kv
# switches to keys.
def capture ...args
  args
assert_eq (capture(...{a: 1, b: 2}.iter())) (pack (:a:, 1) (:b:, 2))
assert_throws $std.UnexpectedPosError do {...{a: 1, b: 2}.iter()}
assert_eq (capture(...[10, 20].pairs())) (pack (0, 10) (1, 20))
assert_eq (capture(...[(:a:, 1), (:b:, 2)].kv())) (pack a: 1 b: 2)
assert_eq {...[(:a:, 1), (:a:, 2)].kv()} {a: 1, a: 2}
assert_eq (Dict([(0, "zero"), (1, "one")].kv())) {0: "zero", 1: "one"}
assert_throws $std.UnexpectedKeyError do [...[(:a:, 1)].kv()]
assert_throws $std.UnexpectedKeyError do tuple(...[(:a:, 1)].kv())
let adapter = [(:a:, 1)].kv()
assert (!type(adapter, Iter))
assert (!type(adapter, Iterable))
assert_throws $std.TypeError do for pair = adapter
  pair
assert_throws $std.TypeError do adapter.next()
assert_throws $std.TypeError do adapter.map(do |x| x)

# Keyed containers reject sequences, while their iterators spread pairs
# positionally.
assert_throws $std.UnexpectedKeyError do [...{a: 1, b: 2}]
assert_throws $std.UnexpectedKeyError do Tuple(pack(a: 1, b: 2))
assert_eq [...{a: 1, b: 2}.iter()] [(:a:, 1), (:b:, 2)]
assert_eq (capture(...Iterable.iter(pack(a: 1, b: 2)))) (pack (:a:, 1) (:b:, 2))
assert_throws $std.UnexpectedPosError do {...Iterable.iter(pack(a: 1, b: 2))}
assert_throws $std.UnexpectedKeyError do capture ...[(0, "zero")].kv()

# A dict spreads every pair keyed: into a call, symbol keys become keywords
# and an integer key is no position.
assert_eq (capture ...{a: 1}) (pack a: 1)
assert_throws $std.UnexpectedKeyError do capture ...{0: "zero"}

# Pair validation stays lazy until the adapter is spread.
let short = [(1,)].kv()
assert_throws $std.MissingPosError do Dict $short
let long = [(1, 2, 3)].kv()
assert_throws $std.UnexpectedPosError do Dict $long
let scalar = [1].kv()
assert_throws $std.TypeError do Dict $scalar
