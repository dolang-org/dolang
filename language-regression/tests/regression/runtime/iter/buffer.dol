import std:
  - Iter
  - null

# `buffer` makes a stream unpackable, reading only as far as the pattern needs.
let calls = 0
let mapped = [1, 2, 3, 4].map do |x|
  calls = (calls + 1)
  (x * 10)
let buffered = mapped.buffer()
let first ...rest = buffered
assert_eq $first 10
assert_eq $calls 1
assert_eq [...rest] [20, 30, 40]
assert_eq $calls 4

# A failed arm leaves the items it read for the next arm.
let it = [1, 2, 3].filter(do |_x| true).buffer()
let label = match it
  (_a _b) => "two"
  (a _b c) => "three $a $c"
  _ => "other"
assert_eq $label "three 1 3"

# Unpacking doesn't advance the iterator, even after reading ahead.
assert_eq (it.next()) 1
let x y = it
assert_eq [x, y] [2, 3]
assert_eq [...it] [2, 3]
assert_eq (it.next(default: nil)) nil

# Captured rests are separate cursors into the same buffer.
let source = [1, 2, 3, 4].map(do |x| x).buffer()
let _ *tail = source
assert_eq (source.next()) 1
assert_eq (tail.next()) 2
assert_eq (source.next()) 2
assert_eq [...tail] [3, 4]
assert_eq [...source] [3, 4]

# A rest can be unpacked repeatedly.
let _ ...more = [1, 2, 3].map(do |x| x).buffer()
let a _ = more
let b _ = more
assert_eq [a, b] [2, 2]

# Spreading starts from the items already buffered.
let spread = [1, 2, 3].map(do |x| x).buffer()
let _ _ _ = spread
assert_eq [...spread] [1, 2, 3]

# An error while reading during a pattern propagates instead of failing the arm.
def check x
  if (x == 2) => throw std.ValueError "boom"
  x
let failing = [1, 2].map(check).buffer()
assert_throws $std.ValueError do
  if let _p _q = failing
    nil

# An iterator that can already unpack returns itself, as does a buffer.
let array_iter = [1, 2].iter()
assert ((array_iter.buffer()) == array_iter)
let split = "a,b".split ","
assert ((split.buffer()) == split)
assert ((null.buffer()) == null)
assert ((buffered.buffer()) == buffered)

# A class iterator with only `(next)` gets a buffer.
class Count: Iter
  field n = 0

  def (next) self
    if (self.#n >= 3)
      throw std.IterStop()
    self.#n = (self.#n + 1)
    self.#n

let count = Count()
let counted = count.buffer()
assert ((counted == count) == false)
let c1 c2 c3 = counted
assert_eq [c1, c2, c3] [1, 2, 3]

# A class that can unpack opts out by returning itself.
class Pair: Iter
  pub def (unpack) _self
    [1, 2]

  def (next) _self
    throw std.IterStop()

  pub def buffer self
    self

let pair = Pair()
assert ((pair.buffer()) == pair)
