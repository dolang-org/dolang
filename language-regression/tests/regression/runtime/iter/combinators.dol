import
  std:
    - TypeError
    - ValueError

# Counts the items read from a source, to show what's consumed lazily
class Counted: Iter
  pub field inner = nil
  pub field reads = 0

  def (init) self items
    Iter.(init) $self
    self.inner = items.iter()

  def (next) self
    let item = self.inner.next()
    self.reads = (self.reads + 1)
    item

  def (iter) self
    self

# flat_map and flatten
assert_eq [...["a b", "c"].flat_map(do |s| s.split " ")] ["a", "b", "c"]
assert_eq [...[1, 2, 3].flat_map(do |n| Range n)] [0, 0, 1, 0, 1, 2]
assert_eq [...[[1, 2], [], [3]].flatten()] [1, 2, 3]
assert_eq [...[[1, 2], [3]].iter().flatten()] [1, 2, 3]
assert_eq [...[].flatten()] []
assert_eq [...[[], []].flatten()] []
assert_eq [...[{a: 1}].flatten()] [(:a:, 1)]
let bad = [[1], 2].flatten()
assert_eq (bad.next()) 1
assert_throws $TypeError do bad.next()

let source = Counted [[1, 2], [3, 4], [5]]
let flat = source.flatten()
assert_eq [...flat.take 3] [1, 2, 3]
assert_eq $source.reads 2

# take_while and skip_while
assert_eq [...[1, 2, 5, 1].take_while(do |x| x < 3)] [1, 2]
assert_eq [...[1, 2, 5, 1].skip_while(do |x| x < 3)] [5, 1]
assert_eq [...[].take_while(do |_| true)] []
assert_eq [...[].skip_while(do |_| true)] []
assert_eq [...[1, 2].take_while(do |_| true)] [1, 2]
assert_eq [...[1, 2].skip_while(do |_| true)] []

let calls = 0
let taking = [1, 2, 5, 1, 0].iter().take_while do |x|
  calls = (calls + 1)
  (x < 3)
assert_eq [...taking] [1, 2]
assert_eq [...taking] []
assert_eq $calls 3

calls = 0
let skipping = [1, 5, 1, 0].skip_while do |x|
  calls = (calls + 1)
  (x < 3)
assert_eq [...skipping] [5, 1, 0]
assert_eq $calls 2

# The failing item is consumed
let it = [1, 2, 5, 6].iter()
assert_eq [...it.take_while(do |x| x < 3)] [1, 2]
assert_eq [...it] [6]

source = Counted [1, 2, 5, 6]
assert_eq [...source.take_while(do |x| x < 3).take 1] [1]
assert_eq $source.reads 1

# batches
assert_eq [...[1, 2, 3, 4, 5].batches 2] [[1, 2], [3, 4], [5]]
assert_eq [...[1, 2, 3, 4].batches 2] [[1, 2], [3, 4]]
assert_eq [...[1, 2].batches 5] [[1, 2]]
assert_eq [...[].batches 3] []
assert_eq [...(Range 5).map(do |x| x * 10).batches 3] [[0, 10, 20], [30, 40]]
let batched = [...[1, 2, 3].batches 1]
batched[0].push 9
assert_eq $batched [[1, 9], [2], [3]]

# tuples
assert_eq [...[1, 2, 3, 4].tuples 2] [(1, 2), (3, 4)]
assert_eq [...[1, 2, 3].tuples 3] [(1, 2, 3)]
assert_eq [...[1, 2, 3].tuples 1] [(1,), (2,), (3,)]
assert_eq [...[].tuples 2] []
let pairs = {}
for k v = ["a", 1, "b", 2].tuples 2
  pairs[k] = v
assert_eq $pairs {"a": 1, "b": 2}
let partial = [1, 2, 3].tuples 2
assert_eq (partial.next()) (1, 2)
assert_throws $ValueError do partial.next()
assert_eq [...partial] []

# windows
assert_eq [...[1, 2, 3, 4].windows 2] [(1, 2), (2, 3), (3, 4)]
assert_eq [...[1, 2, 3].windows 3] [(1, 2, 3)]
assert_eq [...[1, 2, 3].windows 1] [(1,), (2,), (3,)]
assert_eq [...[1, 2].windows 3] []
assert_eq [...[].windows 1] []
let steps = [1, 4, 9].windows(2).map(do |pair| pair[1] - pair[0])
assert_eq [...steps] [3, 5]
assert_eq [...(Range 4).iter().windows 3] [(0, 1, 2), (1, 2, 3)]

# Counts are checked when the method is called
assert_throws $ValueError do [1, 2].batches 0
assert_throws $ValueError do [1, 2].iter().batches (0 - 1)
assert_throws $TypeError do [1, 2].batches "bad"
assert_throws $ValueError do [1, 2].tuples 0
assert_throws $ValueError do [1, 2].iter().tuples (0 - 1)
assert_throws $TypeError do [1, 2].tuples "bad"
assert_throws $ValueError do [1, 2].windows 0
assert_throws $ValueError do [1, 2].iter().windows (0 - 1)
assert_throws $TypeError do [1, 2].windows "bad"

# min and max by key
assert_eq (["bb", "a", "cc"].max key: (do |s| s.len)) "bb"
assert_eq (["bb", "a", "cc", "d"].min key: (do |s| s.len)) "a"
assert_eq ([3, 1, 2].iter().min key: (do |x| 0 - x)) 3
assert_eq ([].max key: (do |s| s.len) default: "none") "none"
calls = 0
let longest = ["a", "bbb", "cc"].max key: do |s|
  calls = (calls + 1)
  s.len
assert_eq $longest "bbb"
assert_eq $calls 3

# group_by
let groups = ["a", "bb", "c", "ddd", "ee"].group_by(do |s| s.len)
assert_eq $groups {1: ["a", "c"], 2: ["bb", "ee"], 3: ["ddd"]}
assert_eq [for k _ = groups => k] [1, 2, 3]
assert_eq ([].group_by(do |x| x)) {}
assert_eq ((Range 6).iter().group_by(do |x| x % 2)) {0: [0, 2, 4], 1: [1, 3, 5]}

# The Iterable surface forwards them
assert_eq [...{a: 1, b: 2}.batches 2] [[(:a:, 1), (:b:, 2)]]
assert_eq [...(Range 3).windows 2] [(0, 1), (1, 2)]
