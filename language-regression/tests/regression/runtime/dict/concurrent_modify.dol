let map = {0: "foo", 1: "bar"}
assert_throws $std.ConcurrencyError str: "conflicting concurrent operation: collection was modified during iteration" do
  for _ = map
    map.clear()

let values = map.values()
map.insert 2 baz
assert_throws $std.ConcurrencyError str: "conflicting concurrent operation: collection was modified during iteration" do values.next()

let keys = map.keys()
map.insert 3 quux
assert_throws $std.ConcurrencyError str: "conflicting concurrent operation: collection was modified during iteration" do keys.next()

map.insert 0 first
map.insert 0 second
let keyed = map.values 0
map.insert 4 quux2
assert_throws $std.ConcurrencyError str: "conflicting concurrent operation: collection was modified during iteration" do keyed.next()
