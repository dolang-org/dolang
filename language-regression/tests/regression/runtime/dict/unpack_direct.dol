import
  std:
    - Iter

# Positional unpack against integer keys (dict-as-array style)
let x y = {0: "zero", 1: "one"}
assert_eq $x zero
assert_eq $y one
assert_throws $std.RuntimeError str: "unexpected positional item: 2" do
  let _a _b = {0: "zero", 1: "one", 2: "two"}
assert_throws $std.RuntimeError str: "missing positional item: 1" do
  let _a _b = {0: "only-zero"}

# str() of the values/keys iterator types themselves
assert_eq (str ({a: 1}.values())) "<values iterator>"
assert_eq (str ({a: 1}.keys())) "<keys iterator>"
assert_eq (str ({a: 1, b: 2, a: 3}.values :a:)) "<key values iterator>"

# ...rest captures remaining pairs as an Iter, continuing bucket order,
# skipping already-consumed keys
let :a ...rest = {a: 1, b: 2, c: 3}
assert_eq $a 1
assert (type rest Iter)
let pairs = $
  for k v = rest
    - (Tuple [k, v])
assert_eq $pairs [(Tuple [:b:, 2]), (Tuple [:c:, 3])]

# an out-of-order integer key interleaved with a named key: the rest
# iterator resolves the expected integer key by direct lookup, and once
# it can't find the next expected one, falls back to bucket order and
# drops stray integer keys rather than yielding them out of sequence
let x2 y2 ...rest2 = {0: "zero", 1: "one", 3: "three", name: "n"}
assert_eq $x2 zero
assert_eq $y2 one
let pairs2 = $
  for k v = rest2
    - (Tuple [k, v])
assert_eq $pairs2 [(Tuple [:name:, "n"])]

# integer keys out of storage order are still recovered in sequence
let ...rest3 = {2: "c", 0: "a", 1: "b"}
let pairs3 = $
  for k v = rest3
    - (Tuple [k, v])
assert_eq $pairs3 [(Tuple [0, "a"]), (Tuple [1, "b"]), (Tuple [2, "c"])]

# the rest iterator supports further keyed/positional unpacking
let a: _a ...rest4 = {a: 1, 0: "zero", 1: "one"}
let d e = rest4
assert_eq $d zero
assert_eq $e one

let a: _a ...rest5 = {a: 1, b: 2}
bind rest5
  :b
  :missing = "fallback"
assert_eq $b 2
assert_eq $missing fallback

# a key satisfied by a default does not excuse a pair nobody claimed
assert_throws $std.RuntimeError str: "unexpected key item: c" do
  let a: _a ...rest5b = {a: 1, b: 2, c: 3}
  bind rest5b
    b: _b
    missing: _missing = "fallback"

# the leftover key is named when unpacking a dict directly, too
assert_throws $std.RuntimeError str: "unexpected key item: c" do
  let b: _b = {b: 2, c: 3}
assert_throws $std.RuntimeError str: "unexpected key item: 5" do
  let b: _b = {5: "five", b: 2}

assert_throws $std.RuntimeError str: "missing key item: zzz" do
  let a: _a ...rest6 = {a: 1, b: 2, c: 3}
  let zzz: _zzz = rest6

assert_throws $std.RuntimeError str: "unexpected key item: c" do
  let a: _a ...rest7 = {a: 1, b: 2, c: 3}
  let b: _b = rest7

assert_throws $std.RuntimeError str: "unexpected positional item: 2" do
  let a: _a ...rest8 = {a: 1, 0: "zero", 1: "one", 2: "two"}
  let _d _e = rest8
