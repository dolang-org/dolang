# A dict has no positional items: integer keys are matched by key patterns
let 0: x 1: y = {0: "zero", 1: "one"}
assert_eq $x zero
assert_eq $y one
assert_throws $std.RuntimeError str: "missing positional item: 0" do
  let _a _b = {0: "zero", 1: "one"}
assert_throws $std.RuntimeError str: "unexpected key item: 2" do
  let 0: _a 1: _b = {0: "zero", 1: "one", 2: "two"}

# str() of the values/keys iterator types themselves
assert_eq (str ({a: 1}.values())) "<values iterator>"
assert_eq (str ({a: 1}.keys())) "<keys iterator>"
assert_eq (str ({a: 1, b: 2, a: 3}.values :a:)) "<key values iterator>"

# ...rest captures remaining pairs as a structural rest, continuing bucket order,
# skipping already-matched keys
let :a ...rest = {a: 1, b: 2, c: 3}
assert_eq $a 1
let pairs = $
  for k v = Dict(rest)
    - (Tuple [k, v])
assert_eq $pairs [(Tuple [:b:, 2]), (Tuple [:c:, 3])]

# a rest keeps the integer keys not matched, in insertion order
let 0: x2 ...rest2 = {0: "zero", 3: "three", name: "n", 1: "one"}
assert_eq $x2 zero
let pairs2 = $
  for k v = Dict(rest2)
    - (Tuple [k, v])
assert_eq $pairs2 [(Tuple [3, "three"]), (Tuple [:name:, "n"]), (Tuple [1, "one"])]

# the structural rest supports further keyed unpacking
let a: _a ...rest4 = {a: 1, 0: "zero", 1: "one"}
let 0: d 1: e = rest4
assert_eq $d zero
assert_eq $e one

let a: _a ...rest5 = {a: 1, b: 2}
bind rest5
  :b
  :missing = "fallback"
assert_eq $b 2
assert_eq $missing fallback

# a key satisfied by a default does not excuse a pair nobody claimed
assert_throws $std.RuntimeError str: "unexpected key item: c" do
  let a: _a ...rest5b = {a: 1, b: 2, c: 3}
  bind rest5b
    b: _b
    missing: _missing = "fallback"

# the leftover key is named when unpacking a dict directly, too
assert_throws $std.RuntimeError str: "unexpected key item: c" do
  let b: _b = {b: 2, c: 3}
assert_throws $std.RuntimeError str: "unexpected key item: 5" do
  let b: _b = {5: "five", b: 2}

assert_throws $std.RuntimeError str: "missing key item: zzz" do
  let a: _a ...rest6 = {a: 1, b: 2, c: 3}
  let zzz: _zzz = rest6

assert_throws $std.RuntimeError str: "unexpected key item: c" do
  let a: _a ...rest7 = {a: 1, b: 2, c: 3}
  let b: _b = rest7

assert_throws $std.RuntimeError str: "missing positional item: 0" do
  let a: _a ...rest8 = {a: 1, 0: "zero"}
  let _d _e = rest8
