import
  std:
    - Iter
    - IterStop
    - MissingPosError

let foo = {"foo": 42, 42: "bar"}
assert (!(bool {}))
assert (bool {a: 1})
foo["bar"] = true
assert_eq $foo["foo"] 42
assert_eq $foo[42] bar
assert_eq $foo["bar"] true
foo["foo"] = nil
assert_eq $foo["foo"] nil
assert_eq (foo.get 42) bar
assert_eq (foo.pop 42) bar
assert_eq (foo.get 42) nil
assert_eq (foo.get 42 default: "absent") absent
assert_eq (foo.get 42 else: do "absent") absent
assert_eq (foo.pop 42 default: "absent") absent
assert_eq (foo.pop 42 else: do "absent") absent
assert (foo.delete "foo")
assert (!(foo.delete 42))

# contains tests
let d = {"a": 1, "b": 2, 42: "answer", "multi": "first"}
d.insert multi second
# Key-only checks
assert (d.contains "a")
assert (d.contains "b")
assert (d.contains 42)
assert (d.contains "multi")
assert (!d.contains "z")
assert (!d.contains 100)
assert (!{}.contains "key")
# Key+value checks
assert (d.contains "a" 1)
assert (d.contains "b" 2)
assert (d.contains 42 "answer")
assert (d.contains "multi" "first")
assert (d.contains "multi" "second")
assert (!d.contains "a" 999)
assert (!d.contains "a" "wrong")
assert (!d.contains "nonexistent" "value")

# pop with instance tests
let d2 = {x: "first"}
d2.insert :x: second
d2.insert :x: third
assert_eq (d2.len) 3
assert_eq (d2.get :x: -1) "third"
assert_eq (d2.get :x: -2) "second"
assert_eq (d2.get :x: -4) nil
# Pop instance 1 (second)
assert_eq (d2.pop :x: 1) "second"
assert_eq (d2.len) 2
# Pop instance -1 (third) - remaining is ["first"]
assert_eq (d2.pop :x: -1) "third"
assert_eq (d2.len) 1
# Pop last one
assert_eq (d2.pop :x:) "first"
assert_eq (d2.len) 0

# A lookup with no instance resolves to the *last* value for the key, so a
# duplicate key overrides the ones before it: last wins.
let dup = {a: 1, b: 2, a: 3}
assert_eq $dup[:a:] 3
assert_eq (dup.get :a:) 3
assert_eq $dup[:b:] 2
# Assigning to the key replaces every value it had.
dup[:a:] = 9
assert_eq $dup[:a:] 9
assert_eq [...dup.values(:a:)] [9]

# Without an instance, `pop` takes the *first* value for the key, so repeated
# pops drain a multi-value key in insertion order.
let d3 = {x: "first"}
d3.insert :x: second
d3.insert :x: third
assert_eq (d3.pop :x:) "first"
assert_eq (d3.pop :x:) "second"
assert_eq (d3.pop :x:) "third"
assert_eq (d3.len) 0

# values iterators
let vals = {a: 1, b: 2, a: 3}.values()
assert (type vals Iter)
assert_eq [...vals] [1, 2, 3]

let keys = {a: 1, b: 2, a: 3, c: 4, b: 5}.keys()
assert (type keys Iter)
assert_eq [...keys] [:a:, :b:, :c:]

let keyed = {a: 1, b: 2, a: 3}.values :a:
assert (type keyed Iter)
assert_eq [...keyed] [1, 3]

let counted = {a: 1, b: 2, a: 3, c: 4, b: 5}
assert_eq $counted.len 5
assert_eq (counted.count()) 3
assert_eq (counted.count :a:) 2
assert_eq (counted.count :b:) 2
assert_eq (counted.count :missing:) 0

assert_eq [...({a: 1}.values :missing:)] []

let unpacked = {a: 1, b: 2, a: 3}.values()
let first second ...rest = unpacked
assert_eq $first 1
assert_eq $second 2
assert_eq [...rest] [3]

bind {a: 1}.values()
  - first
  :missing = "fallback"
assert_eq $first 1
assert_eq $missing fallback

bind {a: 1, b: 2, a: 3}.keys()
  - first
  - second
  :missing = "fallback"
assert_eq $first :a:
assert_eq $second :b:
assert_eq $missing fallback

let failed_unpack = {a: 1}.values()
let failed = try
  let _x _y = failed_unpack
  false
catch _
  true
assert $failed
assert_eq (failed_unpack.next()) 1
assert_throws $IterStop do failed_unpack.next()

let failed_key_unpack = {a: 1}.keys()
failed = try
  let _x _y = failed_key_unpack
  false
catch _
  true
assert $failed
assert_eq (failed_key_unpack.next()) :a:
assert_throws $IterStop do failed_key_unpack.next()

let failed_keyed_unpack = {a: 1, b: 2, a: 3}.values :a:
assert_throws $MissingPosError do
  let _x _y _z = failed_keyed_unpack
assert_eq (failed_keyed_unpack.next()) 1
assert_eq (failed_keyed_unpack.next()) 3
assert_throws $IterStop do failed_keyed_unpack.next()

let mapped = ({a: 1, b: 2, a: 3}.values()).map do |value| (value * 10)
assert_eq [...mapped] [10, 20, 30]

let original = {a: 1, b: 2, a: 3}
let copied = original.copy()
copied.insert :c: 4
assert_eq [...original] [(Tuple [:a:, 1]), (Tuple [:b:, 2]), (Tuple [:a:, 3])]
assert_eq [...copied] [(Tuple [:a:, 1]), (Tuple [:b:, 2]), (Tuple [:a:, 3]), (Tuple [:c:, 4])]

let shared_inner = [1]
let shallow = {items: shared_inner}.copy()
let items = shallow.get :items:
items.push 2
assert_eq $shared_inner [1, 2]
assert_eq $items [1, 2]

assert_throws $std.RuntimeError str: "unexpected positional item: 0" do {}.copy 1

assert_throws $std.RuntimeError str: "type error: Str.len is a field, not a method" do "foo".len()
