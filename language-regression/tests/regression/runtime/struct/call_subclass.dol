class D: Struct[{f: (() -> Int)}]

let d = D {f: (do 3)}
let g = d.f
assert_eq $g() 3
assert_eq $d.f() 3

class Child: D

let child = Child {f: (do 4)}
assert_eq $child.f() 4

class Calls: Struct
  pub def own _self
    5

let calls = Calls {f: (do |x :factor = 2| x * factor), own: (do 0), value: 1}
assert_eq (calls.f 21) 42
assert_eq (calls.f 7 factor: 3) 21
assert_eq $calls.own() 5
calls.f = (do |x| x + 1)
assert_eq (calls.f 41) 42
assert_throws $std.FieldError str: "no such field: missing" do calls.missing()
assert_throws $std.TypeError do calls.value()

# A Do `(get)` override takes precedence over the native fallback.
class Override: Calls
  def (get) _self _key
    (do 6)

assert_eq $Override({f: (do 0)}).f() 6
