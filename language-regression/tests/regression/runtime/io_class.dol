import std: error
import io:
  - Io
  - Buffered
import regression2:
  - ByteBuf

# A Do class can inherit `Io` and is an instance of it
class Empty: Io
  pub field name = "empty"

let empty = Empty()
assert (type empty Io)

# Capabilities it does not override are absent
assert_eq $empty.readable false
assert_eq $empty.writable false
assert_eq $empty.seekable false

# Stream methods it does not define are unsupported
let calls = $
  - do empty.read_some 1
  - do empty.write_some "x"
  - do empty.read 1
  - do empty.write "x"
  - do empty.seek 0
  - do empty.close()
for call = calls
  let unsupported = try
    call()
    false
  catch error.UnsupportedError: _
    true
  assert $unsupported

# Other undefined methods are missing fields
let missing = try
  empty.frobnicate()
  false
catch error.FieldError: _
  true
assert $missing

# Overridden capabilities and methods win
class Zeros: Io
  #[getter]
  pub def readable _self
    true

  pub def read_some _self _size
    b"\0"

let zeros = Zeros()
assert_eq $zeros.readable true
assert_eq $zeros.writable false
assert_eq (zeros.read_some 3) b"\0"

# `read` calls `read_some` until it has `size` bytes
assert_eq (zeros.read 3) b"\0\0\0"
assert_eq (zeros.read 0) b""

# A buffer is an `Io` reporting its source's capabilities
let reader = Buffered (ByteBuf b"abc" 0 "")
assert (type reader Io)
assert_eq $reader.readable true
assert_eq $reader.writable false
assert_eq $reader.seekable false

let seekable = Buffered (ByteBuf b"abc" 0 "ws")
assert_eq $seekable.readable true
assert_eq $seekable.writable true
assert_eq $seekable.seekable true

# A closed buffer reports no capabilities
seekable.close()
assert_eq $seekable.readable false
assert_eq $seekable.writable false
assert_eq $seekable.seekable false

# The helpers call the stream's own methods
class MemIo: Io
  pub field data pos out limit capacity calls

  def (init) self data limit = nil :capacity = nil
    self.data = data
    self.pos = 0
    self.out = BinBuf()
    self.limit = limit
    self.capacity = capacity
    self.calls = []

  #[getter]
  pub def readable _self
    true

  #[getter]
  pub def writable _self
    true

  pub def read_some self size
    let end = (self.pos + size)
    if (end > self.data.len)
      end = self.data.len
    let chunk = (self.data[self.pos..end])
    self.pos = end
    chunk

  # Writes at most `limit` bytes per call and `capacity` in all, recording
  # the size of the data each call got
  pub def write_some self data
    self.calls.push $data.len
    let bytes = (Bin data)
    if (self.limit != nil && bytes.len > self.limit)
      bytes = (bytes[..self.limit])
    if (self.capacity != nil && bytes.len > self.capacity - self.out.len)
      bytes = (bytes[..(self.capacity - self.out.len)])
    self.out.append $bytes
    bytes.len

assert_eq (MemIo(b"hello").read 5) b"hello"
assert_eq (MemIo(b"abc").read 5) b"abc"
assert_eq (MemIo(b"hello").read_all()) b"hello"
assert_eq (MemIo(b"").read_all()) b""
assert_eq (MemIo(Bin("héllo")).read_all_str()) "héllo"

let invalid = try
  MemIo(b"\xff").read_all_str()
  false
catch error.RuntimeError: _
  true
assert $invalid

assert_eq [...MemIo(b"abcde").chunks(2)] [b"ab", b"cd", b"e"]
assert_eq [...MemIo(b"").chunks()] []

let bad_size = try
  MemIo(b"").chunks 0
  false
catch error.TypeError: _
  true
assert $bad_size

# `write` calls `write_some` for each piece, and again for what a short call
# leaves of it
let pieces = MemIo b"" 3
assert_eq (pieces.write "hello" "\n" b"xy") 8
assert_eq (pieces.out.freeze()) b"hello\nxy"
assert_eq $pieces.calls [5, 2, 1, 2]

# Writing no pieces calls nothing
let nothing = MemIo b""
assert_eq (nothing.write()) 0
assert_eq $nothing.calls []

# A piece that is not a `Str` or `Bin` raises before anything is written
let bad_piece = MemIo b""
assert_throws $error.TypeError do bad_piece.write "a" 1
assert_eq $bad_piece.calls []

# A bounded output writes what fits and reports it, then raises once full
let bounded = MemIo b"" capacity: 4
assert_eq (bounded.write "abc" "def") 4
assert_eq (bounded.write_some "e") 0
assert_throws $error.RuntimeError do bounded.write "e"
assert_eq (bounded.out.freeze()) b"abcd"

# A buffer writes its pieces through to a Do stream in one call
let source = MemIo b""
let buffered = Buffered $source
assert_eq (buffered.write "a" b"b" "c") 3
buffered.flush()
assert_eq (source.out.freeze()) b"abc"
assert_eq $source.calls [3]

# A `write_some` that writes nothing, or more than it was given, raises
class Stuck: Io
  pub def write_some _self _data
    0

assert_throws $error.RuntimeError do Stuck().write "x"

class Overcount: Io
  pub def write_some _self data
    (data.len + 1)

assert_throws $error.RuntimeError do Overcount().write "x"

# A stream is its own sink, writing values as text
let sink = MemIo b""
assert_eq (sink.(sink)()) $sink
sink.(put) "a"
sink.(put) b"b"
sink.(put) 1
assert_eq (sink.out.freeze()) b"ab1"

# A stream is a `Sink`, with its methods
assert (type sink Sink)
assert (type sink Sinkable)
let more = MemIo b""
more.put "x"
more.premap(do |n| "<$n>").put 1
more.prechomp().put "y\n"
assert_eq (more.out.freeze()) b"x<1>y"
