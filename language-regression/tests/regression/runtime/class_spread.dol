class Options
  pub field verbose = true

  def (spread) self
    {verbose: self.verbose}

class Pair
  def (spread) _self
    [1, 2]

def show :verbose = false
  verbose

# The value `(spread)` returns is spread in place of the instance.
assert_eq (show(...Options())) true
assert_eq [...Pair()] [1, 2]

class Numbers
  def (iter) _self
    [3, 4].iter()

# `(iter)` alone does not enable spreading.
assert_throws $std.UnsupportedError do [...Numbers()]
assert_eq [...std.Iterable.iter(Numbers())] [3, 4]

class Countdown: std.Iter
  pub field n = 3
  pub field spreads = 0

  def (next) self
    if (self.n == 0) => throw std.IterStop()
    self.n = (self.n - 1)
    self.n

  def (spread) self
    self.spreads = (self.spreads + 1)
    std.Iter.(spread) $self

# An override defers to the inherited `(spread)` without re-entering itself.
let countdown = Countdown()
assert_eq [...countdown] [2, 1, 0]
assert_eq $countdown.spreads 1

# Native iterators return the same proxy.
assert_eq [...[1, 2].iter().(spread)()] [1, 2]
