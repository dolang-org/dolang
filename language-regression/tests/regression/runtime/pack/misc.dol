import
  std:
    - ImmutableError
    - TypeError

assert (!(bool (pack())))
assert (bool (pack(a: 1)))

# len counts every item, including repeated keys
let counted = (name: "Alice", age: 30, name: "Bob", 1, 2, age: 31)
assert_eq $counted.len 6
assert_eq $pack().len 0
assert_throws $TypeError do counted.len()

# get takes a position or a symbol
let rec = pack(1, 2, 3, a: "first", b: "second", a: "second")
assert_eq (rec.get 0) 1
assert_eq (rec.get 2) 3
assert_eq (rec.get 3) nil
assert_eq (rec.get -1) 3
assert_eq (rec.get -4) nil
assert_eq (rec.get :b:) "second"
assert_eq (rec.get :z: default: 42) 42
assert_eq (rec.get :z: else: do 43) 43
assert_eq (rec.get "a") nil
assert_eq (Pack.get rec :b:) "second"

# Indexing takes a position or a symbol
assert_eq $rec[1] 2
assert_eq $rec[:b:] "second"
assert_throws $std.IndexError do rec[3]
# Negative positions count from the end, past keyed items
assert_eq $rec[-1] 3
assert_eq $rec[-3] 1
assert_throws $std.IndexError do rec[-4]
assert_throws $TypeError do rec["a"]

# Keys are not fields
assert_throws $std.FieldError do rec.a
assert_throws $std.FieldError do rec.keys
assert_throws $std.FieldError do rec.pairs

# A `Pack` is Iterable over its key/value pairs
assert (type rec Iterable)
assert_eq [...rec.filter (do |kv| type kv[0] Sym)] [(:a:, "first"), (:b:, "second"), (:a:, "second")]

let immutable = pack(a: 1)
assert_throws $ImmutableError do immutable.a = 2
assert_throws $ImmutableError do immutable[:a:] = 2
assert_throws $std.FieldError do Pack.insert
assert_throws $std.FieldError do Pack.pop

class MyRecord: Pack
  def (init) self source
    Pack.(init) $self $source

let custom = MyRecord {name: "Alice", age: 30}
assert_eq $custom[:name:] "Alice"
assert_eq $custom[:age:] 30
assert (type custom MyRecord)

# A lookup resolves to the *last* value for the key, so a duplicate key
# overrides the ones before it: last wins, the same rule dict indexing follows.
let dup = pack a: 1 b: 2 a: 3
assert_eq $dup[:a:] 3
assert_eq (dup.get :a:) 3
assert_eq $dup[:b:] 2
assert_eq [...dup.iter()] [(:a:, 1), (:b:, 2), (:a:, 3)]

# A `Pack` holds positional items and symbol keys. A source's integer keys
# are keys, not positions.
assert_eq (Pack {x: 1, y: 2}) (pack x: 1 y: 2)
assert_throws $std.UnexpectedKeyError str: "unexpected key item: 0" do Pack {0: :a:}
# Pairs from an iterator
assert_eq (Pack([(:k:, 1)].kv())) (pack k: 1)
assert_eq (Pack (pack 1 k: 2 3)) (pack 1 k: 2 3)
assert_throws $std.UnexpectedKeyError str: "unexpected key item: \"s\"" do Pack {"s": 1}
assert_throws $std.UnexpectedKeyError str: "unexpected key item: 5" do Pack {5: :x:}
assert_throws $std.UnexpectedKeyError str: "unexpected key item: 1" do Pack $[(1, :x:)].kv()
