# Ordering is lexicographic: the first differing element decides
assert_not ([6, 2] < [0, 14])
assert     ([0, 14] < [6, 2])
assert     ([1, 2] < [1, 3])
assert_not ([1, 3] < [1, 2])
assert_not ([1, 2] < [1, 2])

# Unequal lengths: only a proper prefix is less
assert_not ([5] < [1, 2])
assert     ([1] < [1, 2])
assert_not ([1, 2] < [1])

# Nested sequences
assert_not ([(6, 2)] < [(0, 14)])
assert     ([(1, 2), 0] < [(1, 3), -1])

# Sorting by sequence keys
let pairs = [(6, 2), (0, 14), (2, 0), (0, 3)]
pairs.sort()
assert_eq $pairs [(0, 3), (0, 14), (2, 0), (6, 2)]

let rows = [[6, 2], [0, 14], [2, 0]]
rows.sort reverse: true
assert_eq $rows [[6, 2], [2, 0], [0, 14]]

let swapped = [(1, 5), (0, 9), (2, 5)]
swapped.sort key: (do |p| (p[1], p[0]))
assert_eq $swapped [(1, 5), (2, 5), (0, 9)]

# The first unequal pair decides, even when it can't be ordered
let nan = (0.0 / 0.0)
assert_not ([nan, 0] < [1, 1])
assert_not ([1, 1] < [nan, 0])

# Other operand types aren't ordered against arrays
assert_throws $std.TypeError do ([1] < 5)
assert_throws $std.TypeError do ([1] <= 5)
assert_throws $std.TypeError do ([1] < (2,))
assert_throws $std.TypeError do ((1,) < [2])
