# Test (get) and (set) special method fallbacks

class Dynamic
  pub field data

  def (init) self
    self.data = {}

  def (get) self key
    self.data[str(key)]

  def (set) self key value
    self.data[str(key)] = value

let d = Dynamic()
d.foo = 42
d.bar = "hello"
assert_eq $d.foo 42
assert_eq $d.bar "hello"
assert_eq (d.(get) :foo:) 42
d.(set) :baz: 99
assert_eq $d.baz 99

# Static pub fields are not routed through (get)/(set)
class WithPub
  pub field x = 0

  def (init) self v
    self.x = v

  def (get) _self _key
    "fallback"

let w = WithPub 10
assert_eq $w.x 10
assert_eq $w.missing "fallback"

# (get) also works as a fallback for method dispatch:
# obj.method(args) calls (get) to get the callable, then calls it directly with args
class Dispatcher
  pub field data

  def (init) self
    self.data = {}

  def (get) self key
    self.data[str(key)]

  def (set) self key value
    self.data[str(key)] = value

def greet name
  "hello $name"

let dp = Dispatcher()
dp.greet = greet
assert_eq $dp.greet("world") "hello world"

# Type-object (get)/(set) take an explicit receiver for superclass delegation
class Parent
  pub field value = 0

class Child: Parent
  pub def write_parent self value
    Parent.(set) $self :value: $value

  pub def read_parent self
    (Parent.(get) self :value:)

let c = Child()
c.write_parent 123
assert_eq $c.value 123
assert_eq (c.read_parent()) 123

# Type-object accessors always require an instance. The metaclass proxy names
# the class object's own scope explicitly.
class Settings
  pub field value = 1
  #[class]
  pub field version = 2

let settings = Settings()
assert_eq (Settings.(get) settings :value:) 1
Settings.(set) $settings :value: 3
assert_eq $settings.value 3
assert_eq (type(Settings).(get) Settings :version:) 2
type(Settings).(set) $Settings :version: 4
assert_eq $Settings.version 4
let class_get = type(Settings).(get)
let class_set = type(Settings).(set)
assert_eq (class_get Settings :version:) 4
class_set $Settings :version: 5
assert_eq $Settings.version 5

assert_throws $std.MissingPosError do Settings.(get) :version:
assert_throws $std.MissingPosError do Settings.(set) :version: 6
assert_throws $std.TypeError do Settings.(get) 1 :value:
assert_throws $std.TypeError do type(Settings).(get) 1 :version:

# Native type accessors follow the same convention.
let array = [1, 2]
assert_eq (Array.(get) array :len:) 2
let native_get = Array.(get)
assert_eq (native_get array :len:) 2
assert_throws $std.RuntimeError do Array.(get) :len:
assert_throws $std.RuntimeError do Array.(set) :len: 6
assert_throws $std.TypeError do Array.(get) 1 :len:

class DerivedSettings: Settings
assert_eq (type(Settings).(get) DerivedSettings :version:) 2
type(Settings).(set) $DerivedSettings :version: 8
assert_eq $DerivedSettings.version 8
assert_eq $Settings.version 5
