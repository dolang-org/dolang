import
  std:
    - hash

let empty = TestFlags()
assert_eq $empty (TestFlags())
assert (!(empty.contains(:READ:)))
assert_eq [...empty] []
assert_eq [...TestFlags(:NONE:)] []

let r = TestFlags(:READ:)
assert (r.contains(:READ:))
assert (!(r.contains(:WRITE:)))
assert_eq [...r] [:READ:]

let rw = TestFlags(:READ:, :WRITE:)
assert_eq [...rw] [:READ:, :WRITE:]
assert_eq [...TestFlags(:READ_WRITE:)] [:READ:, :WRITE:]
assert_eq (dbg rw) "<regression2.TestFlags: READ|WRITE>"

let rw_seq = TestFlags([:READ:, :WRITE:])
assert_eq $rw $rw_seq

let exec = TestFlags(:EXEC:)
assert_eq $exec.int 4
assert $exec.is_exec()
assert (!(r.is_exec()))
assert_eq (TestFlags.from_int 4) $exec

# Do subclasses inherit the native type-object namespace independently of the
# instance namespace. The forwarding remains transitive through Do classes.
class DerivedFlags: TestFlags
class FurtherDerivedFlags: DerivedFlags

assert_eq (DerivedFlags.from_int 4) $exec
assert_eq (FurtherDerivedFlags.from_int 4) $exec
assert_eq $DerivedFlags.type_property 42
assert_eq $FurtherDerivedFlags.type_property 42
assert_eq $FurtherDerivedFlags.type_readonly 43
DerivedFlags.type_property = 7
FurtherDerivedFlags.type_property = 8
DerivedFlags.type_writeonly = 9

# A native type member wins over an unbound instance method with the same name.
class ShadowFlags: TestFlags
  pub def from_int _self _value
    "instance method"

assert_eq (ShadowFlags.from_int 4) $exec
let all = (rw | exec)
assert_eq [...all] [:READ:, :WRITE:, :EXEC:]

assert_eq (rw & r) $r
assert_eq (rw ^ r) (TestFlags(:WRITE:))
assert_eq (~all) $empty
assert_eq (~empty) $all

assert_eq (hash rw) (hash rw_seq)

assert_throws $std.RuntimeError str: "value error: unrecognized flag: BOGUS" do TestFlags(:BOGUS:)
assert_throws $std.RuntimeError str: "value error: unrecognized flag: BOGUS" do TestFlags([:READ:, :BOGUS:])

assert_eq (coerce_flags rw) $rw
assert_eq (coerce_flags :READ:) $r
assert_eq (coerce_flags [:READ:, :WRITE:]) $rw
assert_eq (coerce_flags []) $empty
assert_throws $std.RuntimeError str: "value error: unrecognized flag: BOGUS" do coerce_flags :BOGUS:
assert_throws $std.RuntimeError str: "value error: unrecognized flag: BOGUS" do coerce_flags [:BOGUS:]
assert_throws $std.RuntimeError str: "type error: iteration protocol not supported" do coerce_flags 42
