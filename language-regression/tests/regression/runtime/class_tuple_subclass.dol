import std:
  - Tuple
# Basic subclassing of tuple
class MyTuple: Tuple
  def (init) self source
    Tuple.(init) $self $source

let t = MyTuple (Tuple [])

# Length
assert_eq $t.len 0

# Coercion
assert_eq (str t) "()"

let copied = t.copy()
assert (type copied MyTuple)
assert_eq (str copied) "()"
