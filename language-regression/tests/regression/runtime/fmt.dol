import std:
  - FmtSpec
  - FmtValue

let empty = FmtSpec()
assert $ type $empty $FmtSpec
assert_eq $empty.fill nil
assert_eq $empty.align nil
assert_eq $empty.sign nil
assert_eq $empty.width nil
assert_eq $empty.precision nil
assert_eq $empty.alt false
assert_eq $empty.kind nil

# A positional nil is still a bound value.
let nil_fmt = FmtValue nil
assert_eq (type nil_fmt) $FmtValue
# `FmtValue` shares the reflection surface with `FmtSpec` structurally,
# not by subtyping.
assert (!(type nil_fmt FmtSpec))
assert_eq $nil_fmt.value nil
assert_eq $nil_fmt.source nil
assert_eq (str nil_fmt) "nil"

# Specifications are immutable and calls merge only the supplied fields.
let base = FmtSpec fill: * align: :RIGHT: sign: :PLUS: width: 6 precision: 2 kind: :FIXED:
assert_eq $base.fill *
assert_eq $base.align :RIGHT:
assert_eq $base.sign :PLUS:
assert_eq $base.width 6
assert_eq $base.precision 2
assert_eq $base.alt false
assert_eq $base.kind :FIXED:

let changed = base width: 8 kind: nil alt: true
assert_eq $base.width 6
assert_eq $base.kind :FIXED:
assert_eq $base.alt false
assert_eq $changed.fill *
assert_eq $changed.width 8
assert_eq $changed.kind nil
assert_eq $changed.alt true

# An explicit nil resets an option to its default.
let reset = changed fill: nil alt: nil precision: nil
assert_eq $reset.fill nil
assert_eq $reset.alt false
assert_eq $reset.precision nil
assert_eq $reset.width 8

let applied = base 1.5
assert_eq (type applied) $FmtValue
assert_eq (str applied) "*+1.50"

let rebound = applied width: 8 fill: :ZERO:
assert_eq $rebound.value 1.5
assert_eq (str rebound) "+0001.50"
assert_throws $std.RuntimeError do applied 2

# The surrounding conversion supplies kind only when none was explicit.
let inherited = FmtValue "x" width: 5
assert_eq "[$inherited]" "[x    ]"
assert_eq (str inherited) "x    "
assert_eq (dbg inherited) "\"x\"  "
assert_eq (str $ FmtValue 42 kind: :HEX:) 2a

# pad applies the layout portion of a specification directly to strings.
let centered = FmtSpec fill: . align: :CENTER: width: 7 precision: 3
assert_eq $centered.pad("a界b") "..a界b.."

# Keyword validation is strict.
assert_throws $std.RuntimeError do FmtSpec fill: ""
assert_throws $std.RuntimeError do FmtSpec fill: ab
assert_throws $std.RuntimeError do FmtSpec align: :SIDEWAYS:
assert_throws $std.RuntimeError do FmtSpec sign: true
assert_throws $std.RuntimeError do FmtSpec width: -1
assert_throws $std.RuntimeError do FmtSpec precision: 1.5
assert_throws $std.RuntimeError do FmtSpec alt: 1
assert_throws $std.RuntimeError do FmtSpec kind: :UNKNOWN:

# Core formatting implementations are reachable from Do code.
assert_eq
  - (str $ FmtValue 42 fill: :ZERO: width: 6 alt: true kind: :HEX:)
  - "0x002a"
assert_eq
  - (str $ FmtValue 1.5 sign: :PLUS: width: 7 precision: 2 kind: :FIXED:)
  - "  +1.50"
assert_eq (str $ FmtValue "a界b" fill: "." width: 6 precision: 3) "a界b..."
assert_eq (str $ FmtValue b"\x0a\xff" alt: true kind: :HEX:) "0x0aff"
assert_eq (dbg $ FmtValue [1, 2] alt: true) |-
  [
    1,
    2,
  ]
assert_eq (dbg $ FmtValue {a: 1} alt: true) |-
  {
    a: 1,
  }

# Do classes get width and alignment through the default formatter.
class Point
  pub field x = 0
  pub field y = 0

  def (init) self x y
    self.x = x
    self.y = y

  pub def (str) self
    "($(self.x),$(self.y))"

let p = Point 1 2
assert_eq (str $ FmtValue p width: 9 align: :RIGHT:) "    (1,2)"
assert_eq (str $ FmtValue p fill: "-" width: 7) "(1,2)--"
assert_eq (str $ FmtValue p precision: 3) "(1,"

# A numeric kind is a type error rather than being silently ignored.
assert_throws $std.RuntimeError do str $ FmtValue p kind: :HEX:
assert_throws $std.RuntimeError do str $ FmtValue p sign: :PLUS:
assert_throws $std.RuntimeError do str $ FmtValue p fill: :ZERO: width: 9

# Symbols, bools and nil use the text kinds only.
assert_eq (str $ FmtValue :sym: width: 5) "sym  "
assert_eq (dbg $ FmtValue true width: 6 align: :RIGHT:) "  true"
assert_throws $std.RuntimeError do str $ FmtValue true kind: :DEC:

# A specification is reusable across values.
let money = FmtSpec precision: 2 kind: :FIXED:
assert_eq "$(money 1.5)/$(money 2.25)" "1.50/2.25"

# Binding a bound value sequences the two specifications rather than merging
# them: the inner one renders, and the outer one lays that rendering out.
let bound = money 1.5
assert_eq (str (FmtValue bound width: 8)) "1.50    "
assert_eq (str ((FmtSpec width: 8) bound)) "1.50    "
assert_eq (str "${bound:>8}") "    1.50"
assert_eq
  - (str (FmtValue bound.value width: 8 precision: 2 kind: :FIXED:))
  - "    1.50"

# `value` descends exactly one level, so the outer wrapper carries the inner
# one rather than the datum.
let outer = (FmtValue bound width: 8)
assert_eq (type outer.value) $FmtValue
assert_eq (str outer.value) "1.50"

# Width under width pads what the inner layout produced, and precision clips
# it — both operate on text, not on the original number.
assert_eq (str (FmtValue (FmtValue "x" width: 3) width: 6 fill: "-")) "x  ---"
assert_eq
  - (str (FmtValue (FmtValue 1.5 precision: 2 kind: :FIXED:) precision: 2))
  - "1."
assert_eq
  - (str (FmtValue (FmtValue (FmtValue "x" width: 3) width: 5 fill: "-")
      width: 9 fill: "="))
  - "x  --===="

# An outer specification the inner rendering cannot honor is rejected by
# domain rather than skipped down to the datum.
assert_throws $std.RuntimeError do str (FmtValue bound kind: :HEX:)

# Nesting is bounded by the ordinary call depth.
let deep = FmtValue "x"
let depth = 0
while (depth < 5000)
  deep = (FmtValue deep)
  depth = (depth + 1)
assert_throws $std.RuntimeError do str $deep

# The type objects construct directly: keywords alone make a specification,
# and a positional value binds one.
let ctor = (FmtSpec width: 4 fill: ".")
assert_eq (type ctor) $FmtSpec
assert_eq $ctor.pad("a") "a..."
assert_eq (type (FmtValue 1 width: 4)) $FmtValue
assert_eq (str (FmtValue 1 width: 4)) "   1"
# Binding is FmtValue's job; FmtSpec takes no positional.
assert_throws $std.RuntimeError do FmtSpec 1

# `source` records the text an interpolation was written as. Re-merging
# options produces a synthetic value, so it clears it.
let sourced = (FmtValue 42 width: 4 source: r"${x:>4}")
assert_eq $sourced.source r"${x:>4}"
assert_eq (str sourced) "  42"
assert_eq $(sourced width: 6).source nil
# There is nothing to attach a source to without a value.
assert_throws $std.RuntimeError do FmtSpec source: r"${x}"

# `source` is observable, so it is part of what a binding is: two bindings that
# differ only in it are distinguishable by `source` and `dbg` alike, and
# equality agrees.
assert_eq (FmtValue 42 width: 4) (FmtValue 42 width: 4)
assert $ (sourced != (FmtValue 42 width: 4))
assert $ (sourced != (FmtValue 42 width: 4 source: r"${x}"))
assert_eq $sourced (FmtValue 42 width: 4 source: r"${x:>4}")

let by_source = dict()
by_source[sourced] = 1
by_source[(FmtValue 42 width: 4)] = 2
assert_eq $by_source[sourced] 1
assert_eq $by_source.len 2
