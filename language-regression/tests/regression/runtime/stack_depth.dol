import
  strand:
    - fork
    - redirect
    - spawn
  std:
    - RuntimeError

let scoped_parent = if DEBUG
  120
else
  900

let scoped_child = if DEBUG
  40
else
  200

def recurse n
  if (n == 0)
    0
  else
    recurse (n - 1)

def is_even_deep n
  if (n == 0)
    true
  else
    is_odd_deep (n - 1)

def is_odd_deep n
  if (n == 0)
    false
  else
    is_even_deep (n - 1)

def redirect_recurse n
  if (n == 0)
    0
  else
    redirect do redirect_recurse (n - 1)

def scoped_overflow parent child
  if (parent == 0)
    fork do recurse $child
  else
    scoped_overflow (parent - 1) $child

def background_ok n
  if (n == 0)
    let handle = spawn do recurse 20
    handle.join()
  else
    background_ok (n - 1)

assert_throws $RuntimeError str: "maximum call depth exceeded" do recurse 2000
assert_throws $RuntimeError str: "maximum call depth exceeded" do is_even_deep 2000
assert_throws $RuntimeError str: "maximum call depth exceeded" do redirect_recurse 2000
assert_throws $RuntimeError str: "maximum call depth exceeded" do
  scoped_overflow $scoped_parent $scoped_child
assert_eq (background_ok 40) 0
