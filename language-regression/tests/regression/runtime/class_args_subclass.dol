# Basic subclassing of Args
class MyArgs: Args
def (init) self
  # error: special methods are only valid in a class body
  #   --> class_args_subclass.dol:LL:LL
  #    |
  # LL | def (init) self
  #    |      ^^^^
  Args.(init) $self {}

let r = MyArgs()
r.name = "Alice"
r.age = 30

assert_eq $r.name "Alice"
assert_eq $r.age 30
