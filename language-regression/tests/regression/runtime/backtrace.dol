import inspect
import
  std:
    - Iterable
    - SinkStop
    - StateError
  strand:
    - spawn
    - stream

def receivers bt
  let out = $
    for frame = bt
      - $frame.receiver
  out

def frame_info bt
  let out = $
    for frame = bt
      - [frame.module, frame.receiver, frame.method, type(frame, inspect.Frame), frame.location != nil]
  out

def live_inner()
  return strand.backtrace()

def live_middle()
  return live_inner()

def live_outer()
  return live_middle()

def boom_inner()
  throw "boom"

def boom_outer()
  return boom_inner()

def other_inner()
  throw "other"

def other_outer()
  return other_inner()

def plain_rethrow()
  try
    boom_outer()
  catch e
    throw e

def catch_snapshot()
  try
    boom_outer()
  catch _
    strand.error_backtrace()

# Live backtrace snapshots are iterable and expose structured frame fields.
let live = live_outer()
let live_receivers = receivers $live
let live_info = frame_info $live
assert (live.len >= 3)
assert_eq $live_receivers[0] "live_inner"
assert_eq $live_receivers[1] "live_middle"
assert_eq $live_receivers[2] "live_outer"
assert_eq $live_info[0][0] "<program>"
assert_eq $live_info[0][1] "live_inner"
assert_eq $live_info[0][2] nil
assert $live_info[0][3]
assert $live_info[0][4]

# error_backtrace() is only valid while handling an exception.
let outside = try
  strand.error_backtrace()
catch e
  e
assert_eq (type outside) $StateError
assert_eq (str outside) "state error: no active handled exception"

# Catch handlers can snapshot the handled exception backtrace.
let catch_bt = try
  boom_outer()
catch e
  assert_eq $e "boom"
  strand.error_backtrace()
let catch_receivers = receivers $catch_bt
assert_eq $catch_receivers[0] "boom_inner"
assert_eq $catch_receivers[1] "boom_outer"

# Errors raised by the interpreter itself include the raising frame.
def fallthrough_inner()
  let _x _y = 42
  else nil

def fallthrough_outer()
  return fallthrough_inner()

let fallthrough_bt = try
  fallthrough_outer()
catch std.RuntimeError: _
  strand.error_backtrace()
let fallthrough_receivers = receivers $fallthrough_bt
assert_eq $fallthrough_receivers[0] "fallthrough_inner"
assert_eq $fallthrough_receivers[1] "fallthrough_outer"

# Do-level error_backtrace snapshots extend the handled trace with the live handler stack.
let catch_snapshot_receivers = receivers $(catch_snapshot())
assert_eq $catch_snapshot_receivers[0] "boom_inner"
assert_eq $catch_snapshot_receivers[1] "boom_outer"
assert (catch_snapshot_receivers.len >= 3)

# Finally blocks also see the active handled exception backtrace.
let finally_bt = nil
let finally_err = try
  try
    boom_outer()
  finally
    finally_bt = strand.error_backtrace()
catch e
  e
assert_eq $finally_err "boom"
let finally_receivers = receivers $finally_bt
assert_eq $finally_receivers[0] "boom_inner"
assert_eq $finally_receivers[1] "boom_outer"

# After a handler succeeds, finally sees no handled exception.
let quiet_finally = nil
try
  boom_outer()
catch _
  nil
finally
  quiet_finally = try
    strand.error_backtrace()
  catch e
    e
assert (type quiet_finally StateError)

# Nested in a handler, that finally sees the enclosing handler's exception.
let nested_finally_bt = nil
try
  other_outer()
catch _
  try
    boom_outer()
  catch _
    nil
  finally
    nested_finally_bt = strand.error_backtrace()
let nested_finally_receivers = receivers $nested_finally_bt
assert_eq $nested_finally_receivers[0] "other_inner"

# When a handler throws, finally sees the new exception.
let failed_finally_bt = nil
let failed_err = try
  try
    boom_outer()
  catch _
    other_outer()
  finally
    failed_finally_bt = strand.error_backtrace()
catch e
  e
assert_eq $failed_err "other"
let failed_finally_receivers = receivers $failed_finally_bt
assert_eq $failed_finally_receivers[0] "other_inner"

# A nested try restores the outer handler's exception when it finishes.
let restored_bt = try
  boom_outer()
catch _
  try
    other_outer()
  catch _
    nil
  strand.error_backtrace()
let restored_receivers = receivers $restored_bt
assert_eq $restored_receivers[0] "boom_inner"

# Explicit rethrow with backtrace preserves the original trace.
let reraised_bt = try
  try
    boom_outer()
  catch e
    let bt = strand.error_backtrace()
    strand.throw $e backtrace: $bt
catch e
  assert_eq $e "boom"
  strand.error_backtrace()
let reraised_receivers = receivers $reraised_bt
assert_eq $reraised_receivers[0] "boom_inner"
assert_eq $reraised_receivers[1] "boom_outer"

# A plain rethrow of the caught error keeps the original trace instead of
# splicing the rethrow site onto the front of it.
let plain_bt = try
  plain_rethrow()
catch e
  assert_eq $e "boom"
  strand.error_backtrace()
let plain_receivers = receivers $plain_bt
assert_eq $plain_receivers[0] "boom_inner"
assert_eq $plain_receivers[1] "boom_outer"
assert (plain_receivers[2].starts_with "plain_rethrow")

# Strand join preserves the originating backtrace.
let joined_bt = try
  let handle = spawn do boom_outer()
  handle.join()
catch e
  assert_eq $e "boom"
  strand.error_backtrace()
let joined_receivers = receivers $joined_bt
assert_eq $joined_receivers[0] "boom_inner"
assert_eq $joined_receivers[1] "boom_outer"

# Stream next preserves the originating backtrace.
let next_stream = stream do boom_outer()
let next_iter = next_stream.iter()
let next_bt = try
  next_iter.next()
catch e
  assert_eq $e "boom"
  strand.error_backtrace()
next_stream.wait()
let next_receivers = receivers $next_bt
assert_eq $next_receivers[0] "boom_inner"
assert_eq $next_receivers[1] "boom_outer"

# Stream put yields SinkStop; join preserves the originating backtrace.
let put_stream = stream do boom_outer()
let put_sink = put_stream.sink()
let put_err = try
  put_sink.put 1
  put_sink.put 2
catch e
  e
assert (type put_err SinkStop)
let put_bt = try
  put_stream.join()
catch e
  assert_eq $e "boom"
  strand.error_backtrace()
let put_receivers = receivers $put_bt
assert_eq $put_receivers[0] "boom_inner"
assert_eq $put_receivers[1] "boom_outer"

# A backtrace claims Iterable, so it answers to the forwarded method surface
# rather than only to `(iter)`.
assert (type live inspect.Backtrace)
assert (type live Iterable)
let mapped = [...live.map (do |frame| frame.receiver)]
assert_eq $mapped[0] "live_inner"
assert (live.any (do |frame| frame.receiver == "live_outer"))
assert_eq ([...live.take 1].len) 1
