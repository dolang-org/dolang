import std
  std:
    - FieldError
    - ImportError
    - IndexError
    - Iter
    - Iterable
    - IterStop
    - MissingPosError
    - Nil
    - Null
    - Sink
    - Sinkable
    - SinkStop
    - TypeError
    - Value
    - ZeroDivError
    - null
  strand:
    - channel

assert_eq (type 5) $Int
assert_eq (type Int) $Type
assert_eq (type type) $Func
assert_eq (type int) $Func
assert_eq (type float) $Func
assert_eq (type bool) $Func
assert_eq (type str) $Func
assert_eq (type sym) $Func
assert_eq (type array) $Func
assert_eq (type dict) $Func
assert_eq (type tuple) $Func
assert_eq (type record) $Func
assert_throws $TypeError do Type()
assert_throws $TypeError do Value()

assert_eq (type 0.5) $Float

assert_eq (type "hello") $Str

assert_eq (type :sym:) $Sym

assert_eq (type nil) $Nil
assert (type nil Nil)
assert (!(type false Nil))
assert_throws $TypeError do Nil nil

assert_eq (type false) $Bool

assert_eq (type []) $Array

assert_eq (type $ [].iter()) $Iter

assert_eq (type $ [].sink()) $Sink

assert_eq (type {}) $Dict

assert_eq (type null) $Null
assert (type null Null)
assert (!(type false Null))
assert_throws $TypeError do Null()
assert (type null Iter)
assert (type null Sink)
assert (type null Iterable)
assert (type null Sinkable)

# Errors
assert_throws $TypeError do (5 + "hello")
assert_throws $ZeroDivError do (5 / 0)
assert_throws $FieldError do std.bad()
assert_throws $IndexError do [][0]
assert_throws $MissingPosError do type()
assert_throws $ImportError do import bad_module: _

let pair = channel()
pair[0].close()
assert_throws $IterStop do pair[1].next()

pair = channel()
pair[1].close()
assert_throws $SinkStop do pair[0].put 0
