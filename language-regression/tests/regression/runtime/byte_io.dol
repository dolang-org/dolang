import std: error
import io:
  - Buffered
import regression2:
  - ByteBuf
  - byte_overwrite
  - byte_read
  - byte_seek
  - byte_tell

# Read-ahead is served before the underlying I/O
assert_eq (byte_read (ByteBuf b"abcdef" 2 "")) b"abcdef"

# A richer handle narrows to a reader
assert_eq (byte_read (ByteBuf b"abcdef" 2 "ws")) b"abcdef"

# A seekable handle reports the logical position
assert_eq (byte_tell (ByteBuf b"abcdef" 2 "s")) 0

# Seeking drops the read-ahead
assert_eq (byte_seek (ByteBuf b"abcdef" 2 "s") 1) b"bcdef"
assert_eq (byte_seek (ByteBuf b"abcdef" 2 "s") 3) b"def"

# Writing realigns to the logical position first
assert_eq (byte_overwrite (ByteBuf b"abcdef" 2 "ws") b"XY") b"XYcdef"

# A consumer rejects a provider lacking a capability before getting its handle
def rejects f ...args
  try
    f ...args
    false
  catch error.ValueError: _
    true

let b = ByteBuf b"abcdef" 2 ""
assert (rejects byte_seek b 0)
assert_eq (byte_read b) b"abcdef"

# A provider's own error is raised as is; this one hands out its handle once
let closed = try
  byte_read $b
  false
catch error.StateError: _
  true
assert $closed

# Values without a provider are unsupported
let unsupported = try
  byte_read 1
  false
catch error.UnsupportedError: _
  true
assert $unsupported

# A buffer serves its source's read-ahead, and lends itself, so a consumer reads
# through it and the buffer stays open
let lines = Buffered (ByteBuf b"ab\ncd\nef" 2 "")
assert_eq (lines.read_line()) "ab\n"
assert_eq (byte_read lines) b"cd\nef"
assert_eq (lines.read_line()) ""

# A lent seekable buffer reports its logical position
let seekable = Buffered (ByteBuf b"ab\ncd\n" 0 "s")
seekable.read_line()
assert_eq (byte_tell seekable) 3

# Writing to a seekable buffer after reading writes at the logical position
let rw = Buffered (ByteBuf b"abcdef" 0 "ws")
assert_eq (rw.read 2) b"ab"
rw.write XY
assert_eq (rw.tell()) 4
rw.seek start: 0
assert_eq (rw.read()) b"abXYef"

# A duplex buffer keeps read-ahead across writes, and flushes before reading
# from its source
let duplex = ByteBuf b"a\nb\n" 0 "d"
let both = Buffered $duplex
assert_eq (both.read_line()) "a\n"
both.write x
assert_eq (duplex.written()) b""
assert_eq (both.read_line()) "b\n"
assert_eq (both.read_line()) ""
assert_eq (duplex.written()) b"x"

# Reading through a lent buffer flushes its pending writes first
let sink = ByteBuf b"" 0 "d"
let pending = Buffered $sink
pending.write pending
byte_read $pending
assert_eq (sink.written()) b"pending"

# A buffer needs a byte I/O source
let bad_source = try
  Buffered 1
  false
catch error.TypeError: _
  true
assert $bad_source
