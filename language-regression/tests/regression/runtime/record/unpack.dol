# unpacking and spreading follow the items exactly: positions positionally,
# keys as keywords
let r = record 1 a: 2 3
let x y :a = r
assert_eq [x, y, a] [1, 3, 2]
assert_throws $std.RuntimeError do
  let _x _y = r

let first *pos **keyed = r
assert_eq $first 1
assert_eq $pos (3,)
assert_eq $keyed (a: 2)

let :a ...rest = r
assert_eq $a 2
assert_eq (args ...rest) (args 1 3)

def collect *pos **keyed
  [pos, keyed]
assert_eq (collect ...r) [(1, 3), (a: 2)]
assert_eq [...(record 1 2)] [1, 2]
assert_throws $std.RuntimeError do [...r]
assert_eq (args ...r) (1, a: 2, 3)

# an unpack sees the record as it was
let s = record 1 2
let p q = s
s.push 3
assert_eq [p, q] [1, 2]
