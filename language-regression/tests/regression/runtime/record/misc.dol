import
  std:
    - ImmutableError
    - TypeError

assert (!(bool (record())))
assert (bool (record(a: 1)))

# Record.len counts every item, including repeated keys
let counted = (name: "Alice", age: 30, name: "Bob", 1, 2, age: 31)
assert_eq (Record.len counted) 6
assert_eq (Record.len (record())) 0

# Record.get takes a position or a symbol
let rec = record(1, 2, 3, a: "first", b: "second", a: "second")
assert_eq (Record.get rec 0) 1
assert_eq (Record.get rec 2) 3
assert_eq (Record.get rec 3) nil
assert_eq (Record.get rec :b:) "second"
assert_eq (Record.get rec :z: default: 42) 42
assert_eq (Record.get rec :z: else: do 43) 43
assert_eq (Record.get rec "a") nil

# Indexing takes a position or a symbol
assert_eq $rec[1] 2
assert_eq $rec[:b:] "second"
assert_throws $std.IndexError do rec[3]
assert_throws $TypeError do rec["a"]

# Dict-like methods are not part of a record's API
assert_throws $std.FieldError do Record.keys
assert_throws $std.FieldError do Record.values
assert_throws $std.FieldError do Record.contains
assert_throws $std.FieldError do Record.count
assert_throws $std.FieldError do Record.pairs

let immutable = record(a: 1)
assert_throws $ImmutableError do immutable.a = 2
assert_throws $ImmutableError do immutable[:a:] = 2
assert_throws $std.FieldError do Record.insert
assert_throws $std.FieldError do Record.pop

class MyRecord: Record
  def (init) self source
    Record.(init) $self $source

let custom = MyRecord {name: "Alice", age: 30}
assert_eq $custom.name "Alice"
assert_eq $custom.age 30
assert (type custom MyRecord)

# A lookup resolves to the *last* value for the key, so a duplicate key
# overrides the ones before it: last wins, the same rule dict indexing follows.
let dup = record a: 1 b: 2 a: 3
assert_eq $dup.a 3
assert_eq $dup[:a:] 3
assert_eq (Record.get dup :a:) 3
assert_eq $dup.b 2
assert_eq [...dup] [(:a:, 1), (:b:, 2), (:a:, 3)]

# A record holds positional items and symbol keys. Integer keys counting up
# from 0 are positional, as when spreading a dict.
assert_eq (Record {0: :a:, x: 1, 1: :b:}) (record :a: x: 1 :b:)
# Pairs from an iterator
assert_eq (Record([[0, :a:], [:k:, 1]].iter().kv())) (record :a: k: 1)
assert_eq (Record (record 1 k: 2 3)) (record 1 k: 2 3)
assert_throws $TypeError str: "type error: record keys must be symbols" do Record {"s": 1}
assert_throws $TypeError str: "type error: record keys must be symbols" do Record {5: :x:, 0: :y:}
assert_throws $TypeError str: "type error: record keys must be symbols" do Record $[[1, :x:]].iter().kv()
