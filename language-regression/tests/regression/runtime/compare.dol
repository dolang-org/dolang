let min = -170141183460469231731687303715884105728
let max = 170141183460469231731687303715884105727
# Arithmetic equality
assert     (1 == 1)
assert_not (1 == 0)
assert_not (0 == 1)
# Arithmetic inequality
assert_not (1 != 1)
assert     (1 != 0)
assert     (0 != 1)
# Arithmetic comparisons
assert_not (1 < 1)
assert     (1 < 2)
assert_not (2 < 1)
assert_not (1 > 1)
assert_not (1 > 2)
assert     (2 > 1)
assert     (1 <= 1)
assert     (1 <= 2)
assert_not (2 <= 1)
assert     (1 >= 1)
assert_not (1 >= 2)
assert     (2 >= 1)
# Boxed comparisons
assert_eq  $min $min
assert_eq  $max $max
assert     (min < max)
assert     (min <= max)
assert_not (min > max)
assert_not (min >= max)
assert_not (max < min)
assert_not (max <= min)
assert     (max > min)
assert     (max >= min)
# Boxed/unboxed comparisons
assert_ne  $min 0
assert_ne  $max 0
assert     (min < 0)
assert     (min <= 0)
assert_not (min > 0)
assert_not (min >= 0)
assert_not (0 < min)
assert_not (0 <= min)
assert     (0 > min)
assert     (0 >= min)
assert_not (max < 0)
assert_not (max <= 0)
assert     (max > 0)
assert     (max >= 0)
assert     (0 < max)
assert     (0 <= max)
assert_not (0 > max)
assert_not (0 >= max)
# Int/Float comparisons below magnitude 1
assert_ne  0.5 0
assert     (0.5 > 0)
assert     (-0.5 < 0)
assert     (0.5 < 1)
assert     (-0.5 > -1)
# Boolean equality
assert_not (true == false)
assert_not (false == true)
assert     (true == true)
# Boolean ordering: false < true, but no mixing with numbers
assert     (false < true)
assert_not (true < false)
assert     (true <= true)
assert     (true > false)
assert_throws $std.TypeError do (true < 2)
assert_throws $std.TypeError do (0 < true)
assert_throws $std.TypeError do (true < 1.5)
assert_throws $std.TypeError do (1.5 >= false)
# String equality
assert_eq  foo foo
assert_ne  foo bar
# Nil equality
assert_eq  nil nil
