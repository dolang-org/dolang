# Basic subclassing of Pack
class MyPack: Pack
def (init) self
  # error: special methods are only valid in a class body
  #   --> class_pack_subclass.dol:LL:LL
  #    |
  # LL | def (init) self
  #    |      ^^^^
  Pack.(init) $self {}

let r = MyPack()
r.name = "Alice"
r.age = 30

assert_eq $r.name "Alice"
assert_eq $r.age 30
