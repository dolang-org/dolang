# A `?` item may be absent, and then every binding under it takes its default
let ?k: (:a = 1 :b = 2) = {}
assert_eq [a, b] [1, 2]
let ?k: (:a = 1 :b = 2) = {k: {a: 3}}
assert_eq [a, b] [3, 2]
let ?"s": ("a": a = 1) ... = {"s": {"a": 4}, other: 5}
assert_eq $a 4
let ?"s": ("a": a = 1) ... = {other: 5}
assert_eq $a 1

# Positional `?` items come after the required ones
let x ?(y = 2 z = 3) = [1]
assert_eq [x, y, z] [1, 2, 3]
let x ?(y = 2 z = 3) = [1, [4]]
assert_eq [x, y, z] [1, 4, 3]
let ?(p = 1) ?(q = 2) = [[5]]
assert_eq [p, q] [5, 2]

# A lone `?` item unpacks the value rather than standing for it
let ?(m = 1) = []
assert_eq $m 1
let ?(m = 1) = [[6]]
assert_eq $m 6

# A present value must match: a mismatch raises from `let`, and fails `if let`
let caught = try
  let ?k: (_a = 1) = {k: [1, 2]}
  false
catch _
  true
assert $caught
if let ?k: (_a = 1) = {k: [1, 2]}
  assert false
if let _a ?(5 _c = 1) d: 3 = {1, [6], d: 3}
  assert false
if let _a ?(5 _c = 1) d: 4 = {1, [5], d: 3}
  assert false
if let _a ?(5 _c = 1) d: 4 = {1, d: 3}
  assert false
if let a ?(5 c = 1) d: 3 = {1, [5, 2], d: 3}
  assert_eq [a, c] [1, 2]
else
  assert false
if let ?k: (a = 1) = {k: [7]}
  assert_eq $a 7
else
  assert false
if let ?k: (a = 1) = {}
  assert_eq $a 1
else
  assert false

# A present `nil` is present, and cannot be unpacked even by `if let`
let caught = try
  if let ?k: (_a = 1) = {k: nil}
    false
  else
    false
catch _
  true
assert $caught

# Non-constant defaults evaluate when absent, and may read earlier bindings
let n = 10
let first ?(second = (first + n) third = 0) = [1]
assert_eq [first, second, third] [1, 11, 0]
let first ?(second = (first + n) third = 0) = [1, [2, 3]]
assert_eq [first, second, third] [1, 2, 3]
let ?k: (:a = (n * 2) :b = 3) = {}
assert_eq [a, b] [20, 3]

# `?` nests, and a required inner level needs its outer item present
let ?outer: (?inner: (:v = 1) :w = 2) = {}
assert_eq [v, w] [1, 2]
let ?outer: (?inner: (:v = 1) :w = 2) = {outer: {w: 3}}
assert_eq [v, w] [1, 3]
let ?outer: (?inner: (:v = 1) :w = 2) = {outer: {inner: {v: 4}}}
assert_eq [v, w] [4, 2]
let ?outer: (inner: (:v = 1)) = {}
assert_eq $v 1
if let ?outer: (inner: (:_v = 1)) = {outer: {}}
  assert false

# `?()` matches an absent item or an empty one
let ?k: () = {}
let ?k: () = {k: []}
if let ?k: () = {k: [1]}
  assert false

# Before a constant, `?` matches an absent item or an equal one
let ?k: 5 = {}
let ?k: 5 = {k: 5}
if let ?k: 5 = {k: 6}
  assert false

# Before a type test, `?` matches an absent item or one of the class. A lone
# item collapses to the whole value, keeping its default for an absent one.
let ?k: Int(i = 0) = {}
assert_eq $i 0
let ?k: Int(i = 0) = {k: 8}
assert_eq $i 8
if let ?k: Int(_i = 0) = {k: "eight"}
  assert false
let ?k: Int(i = (n + 1)) = {}
assert_eq $i 11
let ?k: Int(i = (n + 1)) = {k: 8}
assert_eq $i 8
let ?k: Array(i = 0) = {k: [8]}
assert_eq $i [8]

# Vertical `?` items: `? ` marks an optional positional item as `- ` does, and
# `?` directly before an item marks it
bind [1]
  - a
  ? (b = 2)
  ? - c = 3
    - d = 4
assert_eq [a, b, c, d] [1, 2, 3, 4]
bind [1, [5], [6]]
  - a
  ? (b = 2)
  ? - c = 3
    - d = 4
assert_eq [a, b, c, d] [1, 5, 6, 4]
bind [1]
  - a
  - ?(b = 2)
  ? k: c = 3
assert_eq [a, b, c] [1, 2, 3]
bind [1, [5], {k: 6}]
  - a
  - ?(b = 2)
  ? k: c = 3
assert_eq [a, b, c] [1, 5, 6]
bind {}
  ?k:
    :a = 1
    - b = 2
assert_eq [a, b] [1, 2]
bind {k: {a: 7}}
  ?k:
    :a = 1
    - b = 2
assert_eq [a, b] [7, 2]

# Vertical type tests under `?`
bind []
  ? Dict $
    :x = 1
    ...
assert_eq $x 1
bind [{x: 2, y: 3}]
  ? Dict $
    :x = 1
    ...
assert_eq $x 2
if bind [[2]]
  ? Dict $
    :_x = 1
do
  assert false
bind {}
  ?k: Dict $
    :x = 1
assert_eq $x 1
bind {k: {x: 4}}
  ?k: Dict $
    :x = 1
assert_eq $x 4
if bind {k: [4]}
  ?k: Dict $
    :_x = 1
do
  assert false
bind []
  - ?Dict $
    :x = 1
assert_eq $x 1
bind []
  ? Dict $
    d = {}
assert_eq $d {}
bind [{x: 3}]
  ? Dict $
    d = {}
assert_eq $d {x: 3}
bind [{x: 5}]
  - ?Dict $
    :x = 1
assert_eq $x 5
if bind [[5]]
  - ?Dict $
    :_x = 1
do
  assert false

# An absent alternation acts as if its first alternative matched, so only its
# bindings need defaults
let ?k: (Int(v = 0) | Str(v)) = {}
assert_eq $v 0
let ?k: (Int(v = 0) | Str(v)) = {k: "s"}
assert_eq $v "s"
let ?k: ((:a = 1 :b = 2) | (a = 3 b = 4)) = {}
assert_eq [a, b] [1, 2]
let ?k: ((:a = 1 :b = 2) | (a = 3 b = 4)) = {k: [5]}
assert_eq [a, b] [5, 4]
let ?k: ((:a = 1 :b = (a + 1)) | (a = (n + 3) b = 0)) = {}
assert_eq [a, b] [1, 2]
let ?k: ((a = (n + 3) b = 0) | (:a = 1 :b = (a + 1))) = {}
assert_eq [a, b] [13, 0]
let ?k: ((a = (n + 3) b = 0) | (:a = 1 :b = (a + 1))) = {k: {a: 5}}
assert_eq [a, b] [5, 6]

# Lambda parameters
let f = do |?k: (a = 1 b = 2)| (a + b)
assert_eq (f()) 3
assert_eq (f k: [10]) 12
let g = do |x ?(y = 2)| (x * y)
assert_eq (g 3) 6
assert_eq (g(3, [4])) 12

# `match` arms and loops
def describe value
  match value
    ?k: Int(n = 0) do n
  else
    :other:
assert_eq (describe ({})) 0
assert_eq (describe ({k: 3})) 3
assert_eq (describe ({k: "x"})) :other:
let sums = []
for ?k: (a = 1 b = 2) = [{}, {k: [3]}, {k: [3, 4]}]
  sums.push (a + b)
assert_eq $sums [3, 5, 7]

# A closure captures a binding under `?`
let ?k: (cap = 42) = {}
let get = do cap
assert_eq (get()) 42
