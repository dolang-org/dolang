let foo = 42
let thunk = do
  assert_eq $foo 42
  let bar = true
  let chunk = do
    assert_eq $foo 42
    assert_eq $bar true
    foo = false
    bar = 0
  chunk()
  assert_eq $bar 0
thunk()
assert_eq $foo false

# Full-expression lambdas use the same parameter grammar as statement-level lambdas.
let add_default = (do |a b = 0| a + b)
assert_eq (add_default 2) 2
assert_eq (add_default 2 3) 5

let endpoint = (do |host :port = 80| [host, port])
assert_eq (endpoint "localhost") ["localhost", 80]
assert_eq (endpoint "localhost" port: 443) ["localhost", 443]

let renamed = (do |value: received = 1| received)
assert_eq $renamed() 1
assert_eq (renamed value: 2) 2

# `r|` is a parameter followed by the closing bar, not a raw here string.
let raw_named = do |r|
  r
assert_eq (raw_named 7) 7

let last_raw_named = do |a r| (a + r)
assert_eq (last_raw_named 2 3) 5

let expr_raw_named = (do |r| r)
assert_eq (expr_raw_named 9) 9
