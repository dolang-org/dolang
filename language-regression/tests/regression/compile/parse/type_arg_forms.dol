# Type arguments take every schema item form, and `:Name` for `Name: Name`
let _star @ Tuple[*Str] = nil
let _star_star @ Pack[**Str] = nil
let _opt @ Pack[host: Str, ?port: Int] = nil
let _bare_pos @ Tuple[*] = nil
let _bare_key @ Pack[**] = nil
let _open @ Pack[name: Str, ...] = nil
let _key_type @ Pack[*(Sym): Int] = nil
let _ditto @ Pack[Int, :Str] = nil
let _include @ Pack[...{a: Int}] = nil
let _keyed @ Dict[...Str: Int] = nil
# error: a keyed item cannot be included
#   --> type_arg_forms.dol:LL:LL
#    |
# LL | let _keyed @ Dict[...Str: Int] = nil
#    |                   ^^^
let _compound @ Dict[...Tuple[Int]: Int] = nil
# error: a keyed item cannot be included
#   --> type_arg_forms.dol:LL:LL
#    |
# LL | let _compound @ Dict[...Tuple[Int]: Int] = nil
#    |                      ^^^
