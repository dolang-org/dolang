#[decorator]
let x = 1
# error: decorators are only valid before `def` or `class`
#   --> decorator_errors.dol:LL:LL
#    |
# LL | let x = 1
#    | ^^^

#[decorator]
echo bad
# error: decorators are only valid before `def` or `class`
#   --> decorator_errors.dol:LL:LL
#    |
# LL | echo bad
#    | ^^^^

pub #[decorator]
def bad_pub()
  nil
# error: `pub` must follow decorators
#   --> decorator_errors.dol:LL:LL
#    |
# LL | pub #[decorator]
#    |     ^^

# An overload describes its implementation, which alone is decorated
#[class]
@def overload x @ Int -> Int
# error: an `@def` can't be decorated
#   --> decorator_errors.dol:LL:LL
#    |
# LL | @def overload x @ Int -> Int
#    | ^

def overload x
  x

class Overloads
  #[class]
  @def (call) cls x @ Int -> Int
  # error: an `@def` can't be decorated
  #   --> decorator_errors.dol:LL:LL
  #    |
  # LL |   @def (call) cls x @ Int -> Int
  #    |   ^

  #[class]
  pub def (call) cls x
    x
