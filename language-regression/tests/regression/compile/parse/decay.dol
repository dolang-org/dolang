echo if else while for let field = + - / %
class Fields
  field values

  def (init) self **values
    self.#values = values

  def (get) self name
    self.#values[name]

let rec = Fields true: true false: true nil: true while: true let: true field: true do: true match: true
let field = 1
assert_eq $field 1
for field = [2]
  assert_eq $field 2
assert $rec.true
assert $rec.false
assert $rec.nil
assert $rec.while
assert $rec.let
assert $rec.field
assert $rec.do
assert $rec.match

# A declaration names what it defines, so a keyword may be taken as a name.
def import name
  "imported $name"
assert_eq (import "x") "imported x"

class Keywords
  field tag

  def (init) self
    self.#tag = "kw"

  pub def import self name
    "$(self.#tag) import $name"

  pub def while self
    "$(self.#tag) while"

  pub def match self text
    "$(self.#tag) match $text"

let kw = Keywords()
assert_eq $kw.import("y") "kw import y"
assert_eq $kw.while() "kw while"
assert_eq $kw.match("z") "kw match z"
# output: END
# if else while for let field = + - / %
# END
