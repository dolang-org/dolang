# Whitespace behavior
let doc = |
  this is a doc 
assert_eq $doc "this is a doc \n"
doc = |-
  this is a doc 
assert_eq $doc "this is a doc "
doc = |-
  this is a doc

  with blanks
assert_eq $doc "this is a doc\n\nwith blanks"
doc = |-
  this is a doc
   
  with blanks

assert_eq $doc "this is a doc\n \nwith blanks"

doc = |-
  this is a doc
  # with comments
assert_eq $doc "this is a doc\n# with comments"

doc = |-
  # this doc is a comment
assert_eq $doc "# this doc is a comment"

# Interpolation
let foo = 42

# A here doc has no comments, so a `#` is ordinary text wherever it falls and
# never ends the interpolating part of a line.
doc = |-
  # $foo
  x $foo #$foo
  #[not a decorator] $foo
assert_eq $doc "# 42\nx 42 #42\n#[not a decorator] 42"

# Raw here docs interpolate nothing at all, `#` included.
doc = r|-
  # $foo
  a#b
assert_eq $doc "# \$foo\na#b"

doc = |-
  $foo $(foo + 1) \\\$foo
# Neat
assert_eq $doc r"42 43 \$foo"

# Here docs in other syntactic contexts/positions
def id x
  x
def key_id :key
  key
def array_id ...args
  [...args.pos_only()]

doc = id |-
  a doc
assert_eq $doc "a doc"

doc = id
  |-
    a doc
assert_eq $doc "a doc"

doc = array_id
  - |-
      a doc
  - |-
      another doc
assert_eq $doc ["a doc", "another doc"]

doc = key_id key: |-
  a doc
assert_eq $doc "a doc"

doc = key_id
  key: |-
    a doc
assert_eq $doc "a doc"

# Escaping of `$` and `\`
doc = |
  foo\$bar-\\
  foo \$bar \\
assert_eq $doc "foo\$bar-\\\nfoo \$bar \\\n"

# Non-raw here-docs support the full escape repertoire of quoted strings
doc = |-
  a\tb\nc\"d\0e
assert_eq $doc "a\tb\nc\"d\0e"

# An escape as the very first character of a here-doc body is recognized
# correctly (regression test for a lexer mode-switch timing bug where the
# first byte of the body was classified under the ambient ~pre-switch mode)
doc = |-
  \tfoo
assert_eq $doc "\tfoo"

# Raw here docs: $ and \ are literal
doc = r|
  echo $name
  path: C:\Users
assert_eq $doc "echo \$name\npath: C:\\Users\n"

# Raw strip mode
doc = r|-
  hello $name
assert_eq $doc r"hello $name"

# Raw here doc in call position
doc = id r|
  $foo \t
assert_eq $doc "\$foo \\t\n"

# Raw here doc in vertical layout
doc = id
  r|
    line one
    line two
assert_eq $doc "line one\nline two\n"

# Raw here doc as key argument
doc = key_id key: r|
  $value
assert_eq $doc "\$value\n"

# Raw here doc as key argument in vertical layout
doc = key_id
  key: r|
    $value
assert_eq $doc "\$value\n"

# A symbol-shaped token at the very end of a here-doc line. `Sym` reports a
# span that excludes its closing `:`, and the next token used to resume from
# there — harmless anywhere the following token's start is reset, but a
# here-doc newline extends the pending token instead of emitting one, so the
# colon came back doubled.
doc = r|
  x :FOO:
  key: :BAR:
  y :BAZ: z
  bare:
assert_eq $doc "x :FOO:\nkey: :BAR:\ny :BAZ: z\nbare:\n"
