let ?k: (a b = 1) ... = {}
# error: binding `a` under `?` needs a default
#   --> optional_pattern_needs_default.dol:LL:LL
#    |
# LL | let ?k: (a b = 1) ... = {}
#    |          ^

let ?k: (a = 1 j: (b)) ... = {}
# error: binding `b` under `?` needs a default
#   --> optional_pattern_needs_default.dol:LL:LL
#    |
# LL | let ?k: (a = 1 j: (b)) ... = {}
#    |                    ^

# Only the first alternative's bindings need defaults
let ?k: ((a = 1) | (a)) ... = {}
let ?k: ((a) | (a = 1)) ... = {}
# error: binding `a` under `?` needs a default
#   --> optional_pattern_needs_default.dol:LL:LL
#    |
# LL | let ?k: ((a) | (a = 1)) ... = {}
#    |           ^

bind {}
  ?k:
    :x
    # error: binding `x` under `?` needs a default
    #   --> optional_pattern_needs_default.dol:LL:LL
    #    |
    # LL |     :x
    #    |      ^
    :y = 2
  ...

bind []
  ? - a
    # error: binding `a` under `?` needs a default
    #   --> optional_pattern_needs_default.dol:LL:LL
    #    |
    # LL |   ? - a
    #    |       ^
    - b = 1
