assert_eq 5.0 (5.0)
assert_eq 5. (5.0)
assert_eq .5 (.5)
assert_eq 1.2e-5 (1.2e-5)
assert_eq 1.2e+5 (1.2e+5)
assert_eq 1.2e5 (1.2e5)
assert_eq 1e5 (1e5)
assert_eq -5.0 (-5.0)
assert_eq -5. (-5.0)
assert_eq -5.e2 (-5.e2)
# Verify fallback to literal strings
assert_eq 5.0foo "5.0foo"
assert_eq 0.foo "0.foo"
assert_eq 5.0e+foo "5.0e+foo"
assert_eq 5e+foo "5e+foo"
assert_eq 5efoo "5efoo"
assert_eq .foo ".foo"

# Verify edge cases discerning floating point literal from field/method
# `5.no_field` is a field access on the int, not the float literal `5.`
let field_res = try
  5.no_method()
  false
catch std.FieldError: _
  true
assert $field_res

let negative_field_res = try
  -5.no_method()
  false
catch std.FieldError: _
  true
assert $negative_field_res

let res = try
  5.e_missing_field
catch std.FieldError: _
  true
assert $res

let negative_res = try
  -5.e_missing_field
catch std.FieldError: _
  true
assert $negative_res
# FIXME: this should actually work, but primitive types have limited protocol dispatch
res = try
  5.(dbg)
catch std.FieldError: _
  true
assert $res
