# A renamed import reaches the designated declaration by what it refers to.

import std:
  @Int: Integer
@import other

pub let count @ Integer = 0
#               ^~~~~~~: ref std.Int

# An omitted ambient channel is gradual: it is bounded by `Unknown`.
pub def relay()
  #     ^~~~~: decl [in -, out -] (<in, >out) -> Unknown
  nil

pub def drain <std.Iter[Integer]
  #     ^~~~~: decl [out -] (<std.Iter[std.Int], >out) -> Unknown
  nil

# A lookalike in another module is not designated: a literal isn't one
pub let lookalike @ other.Int = 0
# error: `0` does not fit the annotation `other.Int`
#   --> user.dol:LL:LL
#    |
# LL | pub let lookalike @ other.Int = 0
#    |                                 ^
