# dolang: strict
# A strict unit's omitted channels are unbounded implicit binders, as a
# non-strict unit's are, which any caller's channels fit. Its body sees them as
# `Value`, which can't be read or written.

import lax

# Writing or reading as something specific needs the channel annotated
pub def writes()
  #     ^~~~~~: sig (<#0, >#1) -> nil
  put 1
  # error: this call does not fit `@[T1] (T1, >std.Sink[T1]) -> nil`
  #   --> m.dol:LL:LL
  #    |
  # LL |   put 1
  #    |   ^^^^^
  nil

pub def writes_declared >Sink[Int]
  put 1
  nil

pub def reads()
  let _xs = strand.collect()
  # error: no overload of `strand.collect` accepts these arguments
  #   --> m.dol:LL:LL
  #    |
  # LL |   let _xs = strand.collect()
  #    |             ^^^^^^^^^^^^^^^^
  #    |
  #    = note: `@[I] (<std.Iter[I]) -> [I]`: this call does not fit `@[I] (<std.Iter[I]) -> [I]`
  #    = note: `@[I, S] (S, <std.Iter[I]) -> S`: this call does not fit `@[I, S] (S, <std.Iter[I]) -> S`; this call is missing an argument
  nil

pub def reads_declared <Iter[Int]
  let xs = strand.collect()
  let _ = xs
  #       ^~: flow [std.Int]
  nil

# A `for` without an iteratee takes its input's `(next)`
pub def loops()
  for _x
    # error: `m.loops.#0` has no member `(next)`
    #   --> m.dol:LL:LL
    #    |
    # LL |   for _x
    #    |   ^^^
    nil
  nil

pub def loops_declared <Iter[Int]
  for x
    let _ = x
    #       ^: flow std.Int
  nil

pub def loops_array <Array[Int]
  for _x
    # error: `[std.Int]` has no member `(next)`
    #   --> m.dol:LL:LL
    #    |
    # LL |   for _x
    #    |   ^^^
    nil
  nil

# A channel may be any type; only reading or writing it needs more
pub def opaque <Int >Str
  nil

# A function type without its own channels takes the def's
pub def each f @ ((Int) -> nil)
  #                     ^~: ambient <m.each#0 >m.each#1
  f 1

# A strict caller's own output is seen as `Value`, so a callee that writes
# needs it annotated; a non-strict callee's omitted channels fit anything
pub def calls()
  writes_declared()
  # error: this call does not fit `(>std.Sink[std.Int]) -> nil`
  #   --> m.dol:LL:LL
  #    |
  # LL |   writes_declared()
  #    |   ^^^^^^^^^^^^^^^^^
  lax.anything 1
  nil

pub def calls_strict()
  each do |_x| nil
  nil

# A block passed through a callee's generic channels runs with the caller's
def run[O] f @ ((>O) -> nil) >O -> nil
  f()

def feed[I] f @ ((<I) -> nil) <I -> nil
  f()

pub def passes_quiet()
  run do
    put "x"
    # error: this call does not fit `@[T1] (T1, >std.Sink[T1]) -> nil`
    #   --> m.dol:LL:LL
    #    |
    # LL |     put "x"
    #    |     ^^^^^^^
    nil
  nil

pub def passes_declared >Sink[Int]
  run do
    put 1
    put "x"
    # error: this call does not fit `@[T1] (T1, >std.Sink[T1]) -> nil`
    #   --> m.dol:LL:LL
    #    |
    # LL |     put "x"
    #    |     ^^^^^^^
    nil
  nil

pub def passes_input <Iter[Int]
  feed do
    let xs = strand.collect()
    let _ = xs
    #       ^~: flow [std.Int]
    nil
  nil

# Worker callbacks lose only the ambient channels their operation uses.
pub def maps_ambient <Iter[Int] >Sink[Int]
  strand.map 1 do |x| (x + 1)

pub def map_disconnected <Iter[Int] >Sink[Int]
  strand.map 1 do |x|
    let _ = strand.collect()
    # error: no overload of `strand.collect` accepts these arguments
    #   --> m.dol:LL:LL
    #    |
    # LL |     let _ = strand.collect()
    #    |             ^^^^^^^^^^^^^^^^
    #    |
    #    = note: `@[I] (<std.Iter[I]) -> [I]`: this call does not fit `@[I] (<std.Iter[I]) -> [I]`
    #    = note: `@[I, S] (S, <std.Iter[I]) -> S`: this call does not fit `@[I, S] (S, <std.Iter[I]) -> S`; this call is missing an argument
    strand.put 1
    # error: this call does not fit `@[T1] (T1, >std.Sink[T1]) -> nil`
    #   --> m.dol:LL:LL
    #    |
    # LL |     strand.put 1
    #    |     ^^^^^^^^^^^^
    (x + 1)

pub def maps_explicit_input <Iter[Str] >Sink[Int]
  strand.map 1 input: [1] do |x|
    let _ = strand.collect()
    (x + 1)

pub def maps_explicit_output <Iter[Int] >Sink[Str]
  let out @ Array[Int] = []
  strand.map 1 output: $out do |x|
    strand.put "side"
    (x + 1)

pub def maps_explicit_both <Str >Bool
  let out @ Array[Int] = []
  strand.map 1 input: [1] output: $out do |x| (x + 1)

pub def pools_ambient <Iter[Int] >Sink[Str]
  strand.pool 1 do |_x|
    strand.put "side"
    nil

pub def pools_explicit <Str >Sink[Int]
  strand.pool 1 [1] do |x|
    strand.put $x
    nil

pub def each_where_channels <Iter[Int] >Sink[Int]
  strand.each do |x| (x + 1)
  strand.where do |x|
    strand.put $x
    # error: this call does not fit `@[T1] (T1, >std.Sink[T1]) -> nil`
    #   --> m.dol:LL:LL
    #    |
    # LL |     strand.put $x
    #    |     ^^^^^^^^^^^^^
    true

def run_int f @ ((>Sink[Int]) -> nil) >Sink[Int] -> nil
  f()

pub def passes_fixed >Sink[Int]
  run_int do
    put "x"
    # error: this call does not fit `@[T1] (T1, >std.Sink[T1]) -> nil`
    #   --> m.dol:LL:LL
    #    |
    # LL |     put "x"
    #    |     ^^^^^^^
    nil
  nil

pub def spawns()
  let s = strand.spawn do
    put "x"
    # error: this call does not fit `@[T1] (T1, >std.Sink[T1]) -> nil`
    #   --> m.dol:LL:LL
    #    |
    # LL |     put "x"
    #    |     ^^^^^^^
    nil
  s.join()
  nil

# A block no call receives runs with a def's omitted channels
pub def named()
  let f = do
    put "x"
    # error: this call does not fit `@[T1] (T1, >std.Sink[T1]) -> nil`
    #   --> m.dol:LL:LL
    #    |
    # LL |     put "x"
    #    |     ^^^^^^^
    nil
  run $f
  nil

pub def named_declared >Sink[Str]
  let f = do |>Sink[Str]|
    put "x"
    nil
  run $f
  nil

# An expected function type gives a block its channels
pub def annotated >Sink[Int]
  let f @ ((>Sink[Int]) -> nil) = do
    put 1
    put "x"
    # error: this call does not fit `@[T1] (T1, >std.Sink[T1]) -> nil`
    #   --> m.dol:LL:LL
    #    |
    # LL |     put "x"
    #    |     ^^^^^^^
    nil
  f()
  nil

pub def cast >Sink[Int]
  let f = ((do put "x") @ ((>Sink[Int]) -> nil))
  # error: this call does not fit `@[T1] (T1, >std.Sink[T1]) -> nil`
  #   --> m.dol:LL:LL
  #    |
  # LL |   let f = ((do put "x") @ ((>Sink[Int]) -> nil))
  #    |                ^^^^^^^
  f()
  nil

# A callback run during the call runs with the caller's channels
pub def callback d @ Dict[Str, Int] >Sink[Str]
  let _ = d.get "k" else: do
    put "x"
    0
  nil

# One run later runs with none
pub def deferred xs @ Array[Int] >Sink[Str]
  let _ = xs.iter().map do |x|
    put "x"
    # error: this call does not fit `@[T1] (T1, >std.Sink[T1]) -> nil`
    #   --> m.dol:LL:LL
    #    |
    # LL |     put "x"
    #    |     ^^^^^^^
    x
  nil

# Redirection gives a block real channels, and passes on those it doesn't replace
pub def redirects()
  strand.redirect input: [1, 2] do
    for x
      let _ = x
      #       ^: flow std.Int
    nil
  nil

pub def redirects_output()
  let out @ Array[Int] = []
  strand.redirect output: $out do
    for _x
      # error: `m.redirects_output.#0` has no member `(next)`
      #   --> m.dol:LL:LL
      #    |
      # LL |     for _x
      #    |     ^^^
      nil
    put 1
    nil
  nil
