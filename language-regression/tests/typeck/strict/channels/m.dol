# dolang: strict
# A strict unit's omitted channels are `<Iter[Value]` and `>Sink[Never]`,
# which any caller's channels fit.

import lax

# Writing or reading as something specific needs the channel annotated
pub def writes()
  #     ^~~~~~: sig (<strict, >strict) -> nil
  put 1
  # error: this call does not fit `forall (#0.0, <std.Iter[Value], >std.Sink[#0.0]) -> nil`
  #   --> m.dol:LL:LL
  #    |
  # LL |   put 1
  #    |   ^^^^^
  nil

pub def writes_declared >Sink[Int]
  put 1
  nil

pub def reads()
  let xs = strand.collect()
  let _ = xs
  #       ^~: flow std.Array[Value]
  nil

pub def reads_int()
  let _xs @ Array[Int] = strand.collect()
  # error: `std.Array[Value]` does not fit the annotation `std.Array[std.Int]`
  #   --> m.dol:LL:LL
  #    |
  # LL |   let _xs @ Array[Int] = strand.collect()
  #    |                          ^^^^^^^^^^^^^^^^
  nil

# A function type without its own channels takes the def's
pub def each f @ ((Int) -> nil)
  #                     ^~: ambient <strict >strict
  f 1

# A strict caller's own output is `Sink[Never]`, so a callee that writes needs
# it annotated; a non-strict callee's `Unknown` channels pass for now
pub def calls()
  writes_declared()
  # error: this call does not fit `(<std.Iter[Value], >std.Sink[std.Int]) -> nil`
  #   --> m.dol:LL:LL
  #    |
  # LL |   writes_declared()
  #    |   ^^^^^^^^^^^^^^^^^
  lax.anything 1
  nil

pub def calls_strict()
  each do |_x| nil
  nil

# A block passed through a callee's generic channels runs with the caller's
def run[O] f @ ((>Sink[O]) -> nil) >Sink[O] -> nil
  f()

def feed[I] f @ ((<Iter[I]) -> nil) <Iter[I] -> nil
  f()

pub def passes_quiet()
  run do
    put "x"
    # error: this call does not fit `forall (#0.0, <std.Iter[Value], >std.Sink[#0.0]) -> nil`
    #   --> m.dol:LL:LL
    #    |
    # LL |     put "x"
    #    |     ^^^^^^^
    nil
  nil

pub def passes_declared >Sink[Int]
  run do
    put 1
    put "x"
    # error: this call does not fit `forall (#0.0, <std.Iter[Value], >std.Sink[#0.0]) -> nil`
    #   --> m.dol:LL:LL
    #    |
    # LL |     put "x"
    #    |     ^^^^^^^
    nil
  nil

pub def passes_input <Iter[Int]
  feed do
    let xs = strand.collect()
    let _ = xs
    #       ^~: flow std.Array[std.Int]
    nil
  nil

def run_int f @ ((>Sink[Int]) -> nil) >Sink[Int] -> nil
  f()

pub def passes_fixed >Sink[Int]
  run_int do
    put "x"
    # error: this call does not fit `forall (#0.0, <std.Iter[Value], >std.Sink[#0.0]) -> nil`
    #   --> m.dol:LL:LL
    #    |
    # LL |     put "x"
    #    |     ^^^^^^^
    nil
  nil

pub def spawns()
  let s = strand.spawn do
    put "x"
    # error: this call does not fit `forall (#0.0, <std.Iter[Value], >std.Sink[#0.0]) -> nil`
    #   --> m.dol:LL:LL
    #    |
    # LL |     put "x"
    #    |     ^^^^^^^
    nil
  s.join()
  nil

# A block no call receives runs with a def's omitted channels
pub def named()
  let f = do
    put "x"
    # error: this call does not fit `forall (#0.0, <std.Iter[Value], >std.Sink[#0.0]) -> nil`
    #   --> m.dol:LL:LL
    #    |
    # LL |     put "x"
    #    |     ^^^^^^^
    nil
  run $f
  nil

pub def named_declared >Sink[Str]
  let f = do |>Sink[Str]|
    put "x"
    nil
  run $f
  nil

# An expected function type gives a block its channels
pub def annotated >Sink[Int]
  let f @ ((>Sink[Int]) -> nil) = do
    put 1
    put "x"
    # error: this call does not fit `forall (#0.0, <std.Iter[Value], >std.Sink[#0.0]) -> nil`
    #   --> m.dol:LL:LL
    #    |
    # LL |     put "x"
    #    |     ^^^^^^^
    nil
  f()
  nil

pub def cast >Sink[Int]
  let f = ((do put "x") @ ((>Sink[Int]) -> nil))
  # error: this call does not fit `forall (#0.0, <std.Iter[Value], >std.Sink[#0.0]) -> nil`
  #   --> m.dol:LL:LL
  #    |
  # LL |   let f = ((do put "x") @ ((>Sink[Int]) -> nil))
  #    |                ^^^^^^^
  f()
  nil
