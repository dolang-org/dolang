# Calls into a strict unit from a non-strict one pass, but a function type in a
# strict signature takes its conservative channels, so a callback passed to
# one can't write.

import m

pub def anything _x
  m.writes()
  m.each do |y| put $y
# error: this call does not fit `forall (#0.0, <Value, >std.Sink[#0.0]) -> nil`
#   --> lax.dol:LL:LL
#    |
# LL |   m.each do |y| put $y
#    |                 ^^^^^^

pub def loops()
  for x
    let _ = x
    #       ^: flow Unknown
