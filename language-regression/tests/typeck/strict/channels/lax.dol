# Calls into a strict unit from a non-strict one pass, and a function type in a
# strict signature takes the def's channels, as it would in a non-strict one, so
# a callback passed to one runs with its caller's.

import m

pub def anything _x
  m.writes()
  m.each do |y| put $y

pub def loops()
  for x
    let _ = x
    #       ^: flow Unknown
