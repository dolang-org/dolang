# dolang: strict
# `Int`'s and `Float`'s arithmetic takes an `Int` or a `Float`, through one
# overload for each.

pub def ints a @ Int b @ Int -> Int
  (a + b * a - b % a)

pub def mixed a @ Int b @ Float -> Float
  (a + b)

pub def floats a @ Float b @ Int -> Float
  (a * b)

# A union receiver takes each member's operator
pub def by_int n @ (Int | Float) -> (Int | Float)
  (n + 1)

pub def by_float n @ (Int | Float) -> Float
  (n - 1.5)

# Overloads don't distribute over a union argument
pub def nums a @ (Int | Float) b @ (Int | Float) -> (Int | Float)
  (a + b)
# error: no overload of `(add)` accepts these arguments
#   --> m.dol:LL:LL
#    |
# LL |   (a + b)
#    |    ^^^^^
#    |
#    = note: `(std.Int, std.Int) -> std.Int`: expected `std.Int`, found `std.Float | std.Int`
#    = note: `(std.Int, std.Float) -> std.Float`: expected `std.Float`, found `std.Float | std.Int`
