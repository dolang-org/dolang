# dolang: strict
# A call whose arguments are partly `Unknown` may fit several overloads only for
# lack of what would tell them apart. It isn't an error, but a strict unit warns
# that it's undecided.

import std:
  - @Unknown

@def vague x @ Int -> Int
@def vague x @ (Int | Str) -> Str
pub def vague x @ (Int | Str) -> (Int | Str)
  ...

# Known arguments that fit several are an error
pub def known() -> nil
  let _ = vague 1
  # error: several overloads of `m.vague` accept these arguments
  #   --> m.dol:LL:LL
  #    |
  # LL |   let _ = vague 1
  #    |           ^^^^^^^
  #    |
  #    = note: `(std.Int) -> std.Int` accepts them
  #    = note: `(std.Int | std.Str) -> std.Str` accepts them
  nil

# Dynamic ones are only undecided
pub def dynamic x @ Unknown -> nil
  let _ = vague $x
  # warning: the checker can't verify this
  #   --> m.dol:LL:LL
  #    |
  # LL |   let _ = vague $x
  #    |           ^^^^^^^^
  #    |
  #    = note: several alternatives remain possible; an annotation may pick one
  nil

# An overloaded value is chosen among by the parameters of the function type
# it's related to, never by its result, so overloads that only results tell
# apart are an error wherever it's checked, even when each would fit
@def same x @ Int -> Int
@def same x @ Int -> Str
pub def same x @ Value -> Value
  ...

def apply f @ ((Int) -> Int) -> Int
  f 1

pub def annotated() -> nil
  let _int @ ((Int) -> Int) = same
  # error: several overloads of `m.same` take the parameters of `(std.Int) -> std.Int`
  #   --> m.dol:LL:LL
  #    |
  # LL |   let _int @ ((Int) -> Int) = same
  #    |                               ^^^^
  #    |
  #    = note: `(std.Int) -> std.Int` takes them
  #    = note: `(std.Int) -> std.Str` takes them
  #    = help: only its parameters choose an overload, never the result expected of it
  let _sym @ ((Int) -> Sym) = same
  # error: several overloads of `m.same` take the parameters of `(std.Int) -> std.Sym`
  #   --> m.dol:LL:LL
  #    |
  # LL |   let _sym @ ((Int) -> Sym) = same
  #    |                               ^^^^
  #    |
  #    = note: `(std.Int) -> std.Int` takes them
  #    = note: `(std.Int) -> std.Str` takes them
  #    = help: only its parameters choose an overload, never the result expected of it
  let _value @ ((Int) -> Value) = same
  # error: several overloads of `m.same` take the parameters of `(std.Int) -> Value`
  #   --> m.dol:LL:LL
  #    |
  # LL |   let _value @ ((Int) -> Value) = same
  #    |                                   ^^^^
  #    |
  #    = note: `(std.Int) -> std.Int` takes them
  #    = note: `(std.Int) -> std.Str` takes them
  #    = help: only its parameters choose an overload, never the result expected of it
  nil

pub def declared -> ((Int) -> Int)
  same
  # error: several overloads of `m.same` take the parameters of `(std.Int) -> std.Int`
  #   --> m.dol:LL:LL
  #    |
  # LL |   same
  #    |   ^^^^
  #    |
  #    = note: `(std.Int) -> std.Int` takes them
  #    = note: `(std.Int) -> std.Str` takes them
  #    = help: only its parameters choose an overload, never the result expected of it

pub def passed -> Int
  apply $same
  # error: several overloads of `m.same` take the parameters of `(std.Int) -> std.Int`
  #   --> m.dol:LL:LL
  #    |
  # LL |   apply $same
  #    |          ^^^^
  #    |
  #    = note: `(std.Int) -> std.Int` takes them
  #    = note: `(std.Int) -> std.Str` takes them
  #    = help: only its parameters choose an overload, never the result expected of it

# So is one that a literal's item holds, though it's chosen only once the
# literal's type settles
pub def held -> Tuple[(Int) -> Int]
  (same,)
  # error: several overloads of `m.same` take the parameters of `(std.Int) -> std.Int`
  #   --> m.dol:LL:LL
  #    |
  # LL |   (same,)
  #    |   ^^^^^^^
  #    |
  #    = note: `(std.Int) -> std.Int` takes them
  #    = note: `(std.Int) -> std.Str` takes them
  #    = help: only its parameters choose an overload, never the result expected of it

# Dynamic parameters are only undecided
pub def unknown() -> nil
  let _f @ ((Unknown) -> Int) = same
  # warning: the checker can't verify this
  #   --> m.dol:LL:LL
  #    |
  # LL |   let _f @ ((Unknown) -> Int) = same
  #    |                                 ^^^^
  #    |
  #    = note: several alternatives remain possible; an annotation may pick one
  nil
