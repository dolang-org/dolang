# dolang: strict
# A literal stays precise where nothing written later can widen it: as a `for`'s
# or comprehension's iteratee, and bound to an unannotated local, where no
# write through the value could widen it either.

@let Well = (:A: | :B:)
@let Item = BaseDict[{allow: (Str | Well)}]

def take :dacl @ Iterable[Item]
  ...

pub def array_comprehension()
  take
    dacl:
      for s = [:A:, :B:]
        - allow: $s

pub def tuple_comprehension()
  take
    dacl:
      for s = (:A:, :B:)
        - allow: $s

pub def statement_for()
  for s = [:A:, :B:]
    let _ = s
    #       ^: flow :A: | :B:

pub def once()
  let w = :A:
  let _ = w
  #       ^: flow :A:
  let p = (:A:, :B:)
  let _ = p
  #       ^: flow (:A:, :B:)

# A local assigned again takes each value's type, and an annotated one decays
pub def reassigned()
  let x = :a:
  x = :b:
  let _ = x
  #       ^: flow :b:

pub def annotated()
  let m @ Sym = :a:
  let _ = m
  #       ^: flow std.Sym
