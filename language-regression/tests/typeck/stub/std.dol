# A small stand-in for the standard library, declaring what the checker
# designates in `std`.

pub @let Union[...Ts] = ...

pub @let Phantom[...Ts] = ...

pub class Int
  pub def abs self -> Int
    ...

pub class Str
  pub def len self -> Int
    ...

pub def getter func
  ...

pub def setter func
  ...

pub def final cls
  ...

pub def mixable cls
  ...

pub @let Keys[S @ {...}] = ...

pub @let Values[S @ {...}] = ...

pub @let Entries[S @ {...}] = ...

pub @let IndexItem[S @ {...}, K] = ...

pub @let AssignItem[S @ {...}, K] = ...

pub @let InsertItem[S @ {...}, K] = ...

pub @let Deletable[S @ {...}, K] = ...

pub @let Clearable[S @ {...}] = ...
pub @let Fields[T] = ...
pub @let MutFields[T] = ...

pub class Value

#[mixable]
pub class Func

#[final]
pub class Nil

pub class Bool

pub class Sym

pub class Tuple[*Ts]
  field items @ Phantom[...Ts]

pub class Type[T]: Func
  field instance @ Phantom[T]

pub let class @ Value = ...

pub let static @ Value = ...

pub class Iter[T]
  field items @ Phantom[T]

pub class Array[T]
  field items @ Phantom[T]

  pub def (index) self index @ Int -> T
    ...

  pub def (assign) self index @ Int value @ T
    ...
