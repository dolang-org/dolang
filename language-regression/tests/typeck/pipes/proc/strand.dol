# Nominated pipe types stand in for the placeholders.

pub @let PipeSender[I] = ...
#        ^~~~~~~~~~: decl [I -] proc.PipeSender[I]
pub @let PipeReceiver[I] = ...
#        ^~~~~~~~~~~~: decl [I +] proc.PipeReceiver[I]

pub def stream[R, I, O]
  func @ ((<PipeReceiver[I], >PipeSender[O]) -> R)
do -> R
  ...

# A middle pipeline stage
pub @let Stage = ((<PipeReceiver[Value], >PipeSender[Value]) -> Value)
