#    |
# LL | pub @let PipeReceiver[I] = ...
#    |          ^^^^^^^^^^^^
# ...
# LL | pub class Pair[A, B]: Iter[A]
#    |           ---- declared here

pub class Plain: Sink[Value]
pub class Pair[A, B]: Iter[A]
  pub def second self -> B
    ...

pub def stream[R, I, O]
  func @ ((<PipeReceiver[I], >PipeSender[O]) -> R)
do -> R
