# By default, the pipe placeholders stand for `Sender` and `Receiver`, passing
# their type arguments through.

pub @let PipeSender[I] = ...
#        ^~~~~~~~~~: decl [I -] strand.Sender[I]
pub @let PipeReceiver[I] = ...
#        ^~~~~~~~~~~~: decl [I +] strand.Receiver[I]

pub class Sender[T]: Sink[T]
pub class Receiver[T]: Iter[T]

pub def stream[R, I, O]
  func @ ((<PipeReceiver[I], >PipeSender[O]) -> R)
do -> R
  ...

# A middle pipeline stage
pub @let Stage = ((<PipeReceiver[Value], >PipeSender[Value]) -> Value)
