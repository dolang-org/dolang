# An array type `[T]` is `Array[T]`.

pub let ints @ [Int] = ...
#              ^~~~~: type std.Array[std.Int]
pub let nested @ [[Str]] = ...
#                ^~~~~~~: type std.Array[std.Array[std.Str]]
pub let pairs @ [(Int, Str)] = ...
#               ^~~~~~~~~~~~: type std.Array[std.Tuple[{std.Int, std.Str}]]
pub let mixed @ [Int | Str] = ...
#               ^~~~~~~~~~~: type std.Array[std.Int | std.Str]
pub let optional @ ([Int] | nil) = ...
#                  ^~~~~~~~~~~~~: type nil | std.Array[std.Int]
pub let element @ Iter[[Int]] = ...
#                 ^~~~~~~~~~~: type std.Iter[std.Array[std.Int]]

pub def first[T] items @ [T] -> T
  #                      ^~~: type std.Array[T]
  ...

