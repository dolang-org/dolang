# A method takes all of its class's binders. A declaration nested elsewhere
# takes exactly the outer binders it names, or that what it names takes.

pub class Num

pub class Box[T, U]
  #       ^~~: decl [T, U] nominal
  pub field item @ T = ...

  pub def get self -> T
    #     ^~~: decl [^T +, ^U, in -, out -] (m.Box[T, U], <in, >out) -> T
    self.item

  pub def map[V] _self _f @ (T -> V) -> Box[V, U]
    #     ^~~: decl [^T +, ^U, V, in, out] (m.Box[T, U], (T, <in, >out) -> V, <in, >out) -> m.Box[V, U]
    #                       ^~~~~~~~: type (T, <in, >out) -> V
    #                                   ^~~~~~~~~: type m.Box[V, U]
    ...

pub def outer[A, B] _a @ A _b @ B
  @let OnlyA = (A | nil)
  #    ^~~~~: decl [^A +] A | nil
  @let Neither = Num
  #    ^~~~~~~: decl m.Num
  @let Local = (nil -> B)
  #    ^~~~~: decl [^B +] (nil, <Value, >Value) -> B
  @let Via = Array[Local]
  #    ^~~: decl [^B] [m.outer.Local[^B]]
  def uses_alias x @ OnlyA
    # ^~~~~~~~~~: decl [^A -, in -, out -] (m.outer.OnlyA[^A], <in, >out) -> Unknown
    #                ^~~~~: type m.outer.OnlyA[^A]
    x
  def body_only x
    # ^~~~~~~~~: decl [^B, in -, out -] (Unknown, <in, >out) -> Unknown
    let y @ B = x
    #       ^: type B
    y
  let f = do |x @ A| x
  #               ^: type A
  let _n @ Neither = ...
  (uses_alias, body_only, f)

pub class Bounded[T, U @ Box[T, Num]]
  pub field u @ U = ...
  pub def peek self -> U
    #     ^~~~: decl [^T, ^U + @ m.Box[T, m.Num], in -, out -] (m.Bounded[T, U], <in, >out) -> U
    self.u

pub def bounded[T, U @ Box[T, Num]] _u @ U
  @let Inner = U
  #    ^~~~~: decl [^T, ^U + @ m.Box[T, m.Num]] U
  def inner _u @ Inner -> U
    # ^~~~~: decl [^T, ^U @ m.Box[T, m.Num], in -, out -] (m.bounded.Inner[^T, ^U], <in, >out) -> U
    _u
  inner
