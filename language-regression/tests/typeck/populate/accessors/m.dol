# A getter and a setter of one name make one computed field, apart from a private
# member of the same spelling. A decorator the checker doesn't know leaves a value
# of unknown type.

pub class Num

def wrap f
  f

pub class Config
  field port @ Num = ...

  #[getter]
  pub def port obj -> Num
    #     ^~~~: decl [in -, out -] (m.Config, <in, >out) -> m.Num
    obj.#port

  #[setter]
  pub def port obj value @ Num
    #     ^~~~: decl [in -, out -] (m.Config, m.Num, <in, >out) -> Unknown
    obj.#port = value

  #[getter]
  pub def only obj -> Num
    obj.#port

  #[wrap]
  pub def wrapped _self
    nil

  #[getter]
  #[wrap]
  pub def both _self
    nil

  @def pick _self x @ Num -> Num
  #    ^~~~: decl [in -, out -] (m.Config, m.Num, <in, >out) -> m.Num
  pub def pick _self x
    #     ^~~~: decl [in -, out -] (m.Config, Unknown, <in, >out) -> Unknown
    x

pub def use c @ Config
  let port = c.port
  #   ^~~~: flow m.Num
  c.port = Num()
  let only = c.only
  #   ^~~~: flow m.Num
  c.only = Num()
  # error: `only` has no setter
  #   --> m.dol:LL:LL
  #    |
  # LL |   c.only = Num()
  #    |   ^^^^^^^^^^^^^^
  let wrapped = c.wrapped
  #   ^~~~~~~: flow Unknown
  let both = c.both
  #   ^~~~: flow Unknown
  let picked = c.pick(Num())
  #   ^~~~~~: flow m.Num
  [port, only, wrapped, both, picked]
