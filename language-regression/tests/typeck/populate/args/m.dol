# Type arguments are placed by the binders they fill, and an omitted one takes
# its binder's default, which sees the arguments before it. A trailing argument
# equal to its default isn't shown, and a keyword binder's argument is named.

pub class Num
pub class Text
pub class Pair[A, B = A]
  pub field items @ Phantom[A, B] = ...
pub class Keyed[T, :K = Num]
  pub field items @ Phantom[T, K] = ...
pub class Tuple[*Ts]
  pub field items @ Phantom[...Ts] = ...
pub class Record[**Ks]
  pub field items @ Phantom[...Ks] = ...
pub class Table[S @ {...}]
  pub field items @ Phantom[...S] = ...
pub class Early[A = B, B = Num]
  pub field items @ Phantom[A, B] = ...
pub @let Phantom[...Ts @ {...}] = ...

pub let defaulted @ Pair[Text] = ...
#                   ^~~~~~~~~~: type m.Pair[m.Text]
pub let both @ Pair[Text, Num] = ...
#              ^~~~~~~~~~~~~~~: type m.Pair[m.Text, m.Num]
pub let bare @ Pair[Num] = ...
pub let keyword @ Keyed[Text, K: Text] = ...
#                 ^~~~~~~~~~~~~~~~~~~~: type m.Keyed[m.Text, K: m.Text]
pub let keyword_default @ Keyed[Text] = ...
#                         ^~~~~~~~~~~: type m.Keyed[m.Text]
pub let items @ Tuple[Num, Text] = ...
#               ^~~~~~~~~~~~~~~~: type m.Tuple[m.Num, m.Text]
pub let empty @ Tuple[] = ...
#               ^~~~~~~: type m.Tuple[]
pub let expanded @ Tuple[Num, ...Text] = ...
#                  ^~~~~~~~~~~~~~~~~~~: type m.Tuple[m.Num, ...m.Text]
pub let keyed @ Record[a: Num] = ...
#               ^~~~~~~~~~~~~~: type m.Record[a: m.Num]
pub let short @ Table[Num] = ...
#               ^~~~~~~~~~: type m.Table[m.Num]
pub let short_keyed @ Table[Text, Num] = ...
#                     ^~~~~~~~~~~~~~~~: type m.Table[m.Text, m.Num]
pub let whole @ Table[{Num}] = ...
#               ^~~~~~~~~~~~: type m.Table[{m.Num}]
pub let later @ Early[] = ...
#               ^~~~~~~: type m.Early[Unknown]

# After an expansion, where later arguments go is unknown, so they stay as written
pub class Two[A, B]
  pub field items @ Phantom[A, B] = ...
pub def unplaced[*S] _x @ Two[...S, Num]
  #                       ^~~~~~~~~~~~~~: type m.Two[...S, m.Num]
  nil
