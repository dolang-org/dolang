# A class records its fields and methods by name, and each signature of an
# overloaded def or method is a declaration of its own.

pub class Num
pub class Text

pub class Counter[T]
  pub field count @ Num = ...
  field secret @ T = nil
  pub field loose = nil
  #[class]
  pub field made = nil

  def (init) self x @ T
    #  ^~~~: decl [^T -, in -, out -] (m.Counter[T], T, <in, >out) -> Unknown
    self.#secret = x

  pub def secret self
    let secret = self.#secret
    #   ^~~~~~: flow m.Counter.#0
    secret

  @def pick _self x @ Num -> Num
  #    ^~~~: decl [^T, in -, out -] (m.Counter[T], m.Num, <in, >out) -> m.Num
  @def pick _self x @ Text -> Text
  #    ^~~~: decl [^T, in -, out -] (m.Counter[T], m.Text, <in, >out) -> m.Text
  pub def pick _self x
    #     ^~~~: decl [^T, in -, out -] (m.Counter[T], Unknown, <in, >out) -> Unknown
    x

  #[static]
  pub def make x @ T -> Counter[T]
    #     ^~~~: decl [^T -, in -, out -] (T, <in, >out) -> m.Counter[T]
    Counter(x)

pub def use c @ Counter[Text]
  let count = c.count
  #   ^~~~~: flow m.Num
  let loose = c.loose
  #   ^~~~~: flow Unknown
  let made = Counter.made
  #   ^~~~: flow Unknown
  let made_counter = Counter.make(Text())
  #   ^~~~~~~~~~~~: flow m.Counter[m.Text]
  let secret = c.secret()
  #   ^~~~~~: flow Unknown
  [count, loose, made, made_counter, secret]

# A closure's function types don't share its def's channels
pub def run f @ (Num -> Num)
  let g = do |h @ (Num -> Num)| h
  #               ^~~~~~~~~~~~: type (m.Num, <Value, >Value) -> m.Num
  [f, g]

@def overload x @ Num -> Num
#    ^~~~~~~~: decl [in -, out -] (m.Num, <in, >out) -> m.Num
@def overload x @ Text -> Text
pub def overload x
  #     ^~~~~~~~: decl [in -, out -] (Unknown, <in, >out) -> Unknown
  x
