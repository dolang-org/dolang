# Bare `Func` in a type is the function of unknown parameters and result. It
# takes no arguments. As a supertype, it stays nominal.

pub class Num
pub class Text

pub let bare @ Func = ...
#              ^~~~: type (...Unknown{}) -> Unknown
pub let applied @ Func[{Num}, Text] = ...
# error: type takes no type arguments
#   --> m.dol:LL:LL
#    |
# LL | pub let applied @ Func[{Num}, Text] = ...
#    |                   ^^^^^^^^^^^^^^^^^
pub let nested @ ((Func) -> Text) = ...
#                ^~~~~~~~~~~~~~~~: type ((...Unknown{}) -> Unknown, <Value, >Value) -> m.Text

pub class Handler: Func
#         ^~~~~~~: decl nominal <: std.Func
