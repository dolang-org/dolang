# A parenthesized type that `->` doesn't follow is a tuple, or a record when an
# item is explicitly keyed. A lone item without a quantifier or a trailing comma
# only groups.

pub let pair @ (Int, Str) = ...
#              ^~~~~~~~~~: type std.Tuple[{std.Int, std.Str}]
pub let single @ (Int,) = ...
#                ^~~~~~: type std.Tuple[{std.Int}]
pub let empty @ () = ...
#               ^~: type std.Tuple[{}]
pub let optional @ (Int, ?Str) = ...
#                  ^~~~~~~~~~~: type std.Tuple[{std.Int, ?std.Str}]
pub let lone_optional @ (?Int) = ...
#                       ^~~~~~: type std.Tuple[{?std.Int}]
pub let repeated @ (*Int) = ...
#                  ^~~~~~: type std.Tuple[{*std.Int}]
pub let grouped @ Iter[(Int)] = ...
#                 ^~~~~~~~~~~: type std.Iter[std.Int]
pub let nested @ ((Int, Str), (a: Int)) = ...
#                ^~~~~~~~~~~~~~~~~~~~~~: type std.Tuple[{std.Tuple[{std.Int, std.Str}], std.Record[{a: std.Int}]}]

# Any keyed item makes a record, optional or repeated
pub let named @ (name: Str, Int) = ...
#               ^~~~~~~~~~~~~~~~: type std.Record[{name: std.Str, std.Int}]
pub let maybe_named @ (?name: Str) = ...
#                     ^~~~~~~~~~~~: type std.Record[{?name: std.Str}]
pub let flags @ (Int, **Bool) = ...
#               ^~~~~~~~~~~~~: type std.Record[{std.Int, *(std.Sym): std.Bool}]

# A function type's parameters are still a parameter list
pub let callback @ (((Int, Str)) -> nil) = ...
#                  ^~~~~~~~~~~~~~~~~~~~~: type (std.Tuple[{std.Int, std.Str}], <Value, >Value) -> nil

# An inclusion never makes a record, so one that may bring in keyed items is an
# error rather than a change of meaning
@let Positional = {Int, *Str}
@let Keyed = {Int, ?key: Str}
@let Indirect = {...Keyed}
pub let spread @ (Bool, ...Positional) = ...
#                ^~~~~~~~~~~~~~~~~~~~~: type std.Tuple[{std.Bool, ...m.Positional}]
pub let keyed_spread @ (Bool, ...Keyed) = ...
# error: included schema may have keyed items, which a tuple type can't hold
#   --> m.dol:LL:LL
#    |
# LL | pub let keyed_spread @ (Bool, ...Keyed) = ...
#    |                                  ^^^^^
#    |
#    = help: a keyed item makes a record; to include keyed items without one, write `Record[...{...}]`
pub let indirect_spread @ (...Indirect) = ...
# error: included schema may have keyed items, which a tuple type can't hold
#   --> m.dol:LL:LL
#    |
# LL | pub let indirect_spread @ (...Indirect) = ...
#    |                               ^^^^^^^^
#    |
#    = help: a keyed item makes a record; to include keyed items without one, write `Record[...{...}]`
pub let keyed_record @ (flag: Bool, ...Keyed) = ...
#                      ^~~~~~~~~~~~~~~~~~~~~~: type std.Record[{flag: std.Bool, ...m.Keyed}]
pub let open @ (...) = ...
# error: `...` admits keyed items, which a tuple type can't hold
#   --> m.dol:LL:LL
#    |
# LL | pub let open @ (...) = ...
#    |                 ^^^
#    |
#    = help: `(*)` is a tuple of any positional items

pub def packed[*Ts] items @ (...Ts)
  items
pub def mixed[...Ts] items @ (...Ts)
  # error: included schema may have keyed items, which a tuple type can't hold
  #   --> m.dol:LL:LL
  #    |
  # LL | pub def mixed[...Ts] items @ (...Ts)
  #    |                                  ^^
  #    |
  #    = help: a keyed item makes a record; to include keyed items without one, write `Record[...{...}]`
  items
pub def bounded[S @ {*Int}] items @ (...S)
  items
pub def unbounded[S @ {...}] items @ (...S)
  # error: included schema may have keyed items, which a tuple type can't hold
  #   --> m.dol:LL:LL
  #    |
  # LL | pub def unbounded[S @ {...}] items @ (...S)
  #    |                                          ^
  #    |
  #    = help: a keyed item makes a record; to include keyed items without one, write `Record[...{...}]`
  items

