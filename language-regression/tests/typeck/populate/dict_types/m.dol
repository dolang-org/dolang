# A schema is not a type: a class applied to it gives it meaning.

pub let spelled @ Dict[{a: Int}] = ...
#                 ^~~~~~~~~~~~~~: type std.Dict[{a: std.Int}]
pub let rows @ Array[Dict[{a: Int}]] = ...
#              ^~~~~~~~~~~~~~~~~~~~~: type std.Array[std.Dict[{a: std.Int}]]
pub let shorthand @ Dict[Int, Str] = ...
#                   ^~~~~~~~~~~~~~: type std.Dict[std.Int, std.Str]
# A dict holds only keyed items, so `Dict[Int]`, short for `Dict[{*Int}]`,
# doesn't satisfy its bound
pub let positional @ Dict[Int] = ...
# error: this does not satisfy `S @ {*(Value): Value}`
#   --> m.dol:LL:LL
#    |
# LL | pub let positional @ Dict[Int] = ...
#    |                           ^^^

# A vertical schema follows a class too, in a key's value as anywhere
pub @let Config = Dict $
  #      ^~~~~~: decl std.Dict[{name: std.Str, meta: std.Dict[{owner: std.Str}]}]
  name: Str
  meta: Dict $
    owner: Str
pub @let Spread = Tuple ...$
  #      ^~~~~~: decl (std.Int,)
  Int

# A dict guards a recursive alias, as any class does
pub @let Tree = (nil | Dict[{child: Tree}])
#        ^~~~: decl nil | std.Dict[{child: m.Tree}]

# A binder's bound and an alias's body stay schemas
pub def keys[S @ {*(Value): Value}] table @ Dict[S] -> nil
  ...
pub @let Shape = {a: Int}
pub let shaped @ Dict[Shape] = ...
#                ^~~~~~~~~~~: type std.Dict[m.Shape]

# Where a type is required, a schema is an error
pub let braced @ {a: Int} = ...
# error: expected a type, found a schema
#   --> m.dol:LL:LL
#    |
# LL | pub let braced @ {a: Int} = ...
#    |                  ^^^^^^^^
#    |
#    = help: for a dict with this schema, write `Dict[{a: Int}]`
pub let named @ Shape = ...
# error: expected a type, found a schema
#   --> m.dol:LL:LL
#    |
# LL | pub @let Shape = {a: Int}
#    |          ----- declared here
# ...
# LL | pub let named @ Shape = ...
#    |                 ^^^^^
#    |
#    = help: for a dict with this schema, write `Dict[Shape]`
pub @let Vertical = Array $
  - Int
# error: expected a type, found a schema
#   --> m.dol:LL:LL
#    |
# LL |   pub @let Vertical = Array $
#    |  ___________________________^
# LL | |   - Int
#    | |_______^
#    |
#    = help: apply a class to it, as in `Dict $` or `Tuple ...$`
pub let item @ Record[{a: Int}] = ...
# error: expected a type, found a schema
#   --> m.dol:LL:LL
#    |
# LL | pub let item @ Record[{a: Int}] = ...
#    |                       ^^^^^^^^
#    |
#    = help: to give the schema's items, expand it: `...{a: Int}`
pub let named_item @ Struct[Shape] = ...
# error: expected a type, found a schema
#   --> m.dol:LL:LL
#    |
# LL | pub @let Shape = {a: Int}
#    |          ----- declared here
# ...
# LL | pub let named_item @ Struct[Shape] = ...
#    |                             ^^^^^
#    |
#    = help: to give the schema's items, expand it: `...Shape`
pub @let VerticalItem = Tuple $
  Int
# error: expected a type, found a schema
#   --> m.dol:LL:LL
#    |
# LL |   pub @let VerticalItem = Tuple $
#    |  _______________________________^
# LL | |   Int
#    | |_____^
#    |
#    = help: to give the schema's items, expand it: `...$`
pub @let Nested = Dict $
  meta: $
    owner: Str
# error: expected a type, found a schema
#   --> m.dol:LL:LL
#    |
# LL |     meta: $
#    |  _________^
# LL | |     owner: Str
#    | |______________^
#    |
#    = help: apply a class to it, as in `Dict $` or `Tuple ...$`

pub def cast value
  let row = (value @ {a: Int})
  # error: expected a type, found a schema
  #   --> m.dol:LL:LL
  #    |
  # LL |   let row = (value @ {a: Int})
  #    |                      ^^^^^^^^
  #    |
  #    = help: for a dict with this schema, write `Dict[{a: Int}]`
  row
