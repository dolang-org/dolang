# Methods, including special ones whatever their visibility
pub class Methods
  def (init) _self _x @ A
    # error: private alias `A` in the public interface of method `Methods.(init)`
    #   --> m.dol:LL:LL
    #    |
    # LL |   def (init) _self _x @ A
    #    |                         ^
    #    |
    #    = help: declare `A` with `pub`
    nil

  pub def method _self -> O
    # error: private opaque alias `O` in the public interface of method `Methods.method`
    #   --> m.dol:LL:LL
    #    |
    # LL |   pub def method _self -> O
    #    |                           ^
    #    |
    #    = help: declare `O` with `pub`
    ...

# Private members and declarations are not part of the interface, even a
# `Phantom` field, which decides variance
pub class Marked[T]
  field marker @ Phantom[(T, C)]

pub class Members
  field hidden @ C = ...

  def helper _self _x @ P
    nil

def private_def _x @ C -> O
  # warning: unused variable
  #   --> m.dol:LL:LL
  #    |
  # LL | def private_def _x @ C -> O
  #    |     ^^^^^^^^^^^
  ...

@let Private = (A | O)

class PrivateClass: C
  # warning: unused variable
  #   --> m.dol:LL:LL
  #    |
  # LL | class PrivateClass: C
  #    |       ^^^^^^^^^^^^
  pub field x @ A = 0

# Nor are bodies or decorators
def decorate cls
  cls

#[decorate]
pub class Decorated

pub def body()
  let local @ C = ...
  local
