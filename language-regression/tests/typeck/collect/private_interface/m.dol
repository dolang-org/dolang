  #    |
  # LL | pub def ambient <C >P
  #    |                     ^
  #    |
  #    = help: declare `P` with `pub`
  ...

@def over x @ A -> Int
# error: private alias `A` in the public interface of function `over`
#   --> m.dol:LL:LL
#    |
# LL | @def over x @ A -> Int
#    |               ^
#    |
#    = help: declare `A` with `pub`
pub def over _x
  1

# Supertypes, including type-only ones and their arguments
pub class Sub: C
# error: private class `C` in the public interface of class `Sub`
#   --> m.dol:LL:LL
#    |
# LL | pub class Sub: C
#    |                ^
#    |
#    = help: declare `C` with `pub`

pub class Conforms: @P
# error: private protocol `P` in the public interface of class `Conforms`
#   --> m.dol:LL:LL
#    |
# LL | pub class Conforms: @P
#    |                      ^
#    |
#    = help: declare `P` with `pub`

pub class Applied: @Generic[O]
# error: `Applied` does not provide `get`, which `Generic` requires
#   --> m.dol:LL:LL
#    |
# LL | pub class Applied: @Generic[O]
#    |                     ^^^^^^^
# error: private opaque alias `O` in the public interface of class `Applied`
#   --> m.dol:LL:LL
#    |
# LL | pub class Applied: @Generic[O]
#    |                             ^
#    |
#    = help: declare `O` with `pub`

# Field types
pub class Fields
