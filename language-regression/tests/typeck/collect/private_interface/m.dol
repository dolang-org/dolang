import std:
  - @Phantom

class C

@class P

@let O = ...

@let A = Int

pub @class Generic[T]
  pub def get self -> T

# Signatures, of each kind of private declaration
pub def sig _x @ C :_key @ P *_rest @ O -> A
  # error: private class `C` in the public interface of function `sig`
  #   --> m.dol:LL:LL
  #    |
  # LL | pub def sig _x @ C :_key @ P *_rest @ O -> A
  #    |                  ^
  #    |
  #    = help: declare `C` with `pub`
  # error: private protocol `P` in the public interface of function `sig`
  #   --> m.dol:LL:LL
  #    |
  # LL | pub def sig _x @ C :_key @ P *_rest @ O -> A
  #    |                            ^
  #    |
  #    = help: declare `P` with `pub`
  # error: private opaque alias `O` in the public interface of function `sig`
  #   --> m.dol:LL:LL
  #    |
  # LL | pub def sig _x @ C :_key @ P *_rest @ O -> A
  #    |                                       ^
  #    |
  #    = help: declare `O` with `pub`
  # error: private alias `A` in the public interface of function `sig`
  #   --> m.dol:LL:LL
  #    |
  # LL | pub def sig _x @ C :_key @ P *_rest @ O -> A
  #    |                                            ^
  #    |
  #    = help: declare `A` with `pub`
  ...

pub def ambient <C >P
  # error: private class `C` in the public interface of function `ambient`
