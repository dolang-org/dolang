# An alias's head is found through aliases, across units, to what is not one.

import a:
  - @Base
  - @Prim

pub @let Chain = Base
#        ^~~~~: decl a.Base
pub @let Opaque = Prim
#        ^~~~~~: decl a.Prim
pub @let Generic[T] = Array[T]
#        ^~~~~~~: decl [T] [T]
pub @let Param[T] = T
#        ^~~~~: decl [T +] T
pub @let Union = (Int | Str)
#        ^~~~~: decl std.Int | std.Str
pub @let Loop = Loop2
#        ^~~~: decl Unknown
# error: alias refers to itself
#   --> user.dol:LL:LL
#    |
# LL | pub @let Loop = Loop2
#    |          ^^^^
pub @let Loop2 = Loop
#        ^~~~~: decl Unknown
pub @let Grouped = (Chain)
#        ^~~~~~~: decl user.Chain

# A type-only supertype requires the class its aliases lead to
pub class Sub: @Chain
#         ^~~: decl nominal <: user.Chain
# error: `Chain` requires `Point`, which `Sub` does not inherit
#   --> user.dol:LL:LL
#    |
# LL | pub class Sub: @Chain
#    |                 ^^^^^
