# A method's unannotated receiver is its class.

pub class Box[T]
  pub field item @ T = ...
  pub field loose = nil

  def (init) self item @ T
    self.item = item

  pub def get self -> T
    #     ^~~: decl [^T +, in -, out -] (m.Box[T], <in, >out) -> T
    self.item

  pub def map[U] self f @ ((T) -> U) -> Box[U]
    #                     ^~~~~~~~~~: type (T, <in, >out) -> U
    #     ^~~: decl [^T +, U, in, out] (m.Box[T], (T, <in, >out) -> U, <in, >out) -> m.Box[U]
    Box(f(self.item))

  pub def annotated self @ Box[T] -> T
    #     ^~~~~~~~~: decl [^T +, in -, out -] (m.Box[T], <in, >out) -> T
    self.item

  #[class]
  pub def make cls x
    #     ^~~~: decl [^T, in -, out -] (std.Type[m.Box[T]], Unknown, <in, >out) -> Unknown
    ...

pub @class Shape
  pub def area self -> Int
  #       ^~~~: decl [in -, out -] (m.Shape, <in, >out) -> std.Int
