# An omitted annotation on a def is dynamic, and an omitted ambient channel is
# an implicit binder of its signature, whatever the def's visibility.

pub def shown a @ Int b :k @ Str = "x" *rest **kw -> Int
  #     ^~~~~: decl [in -, out -] (std.Int, Unknown, ?k: std.Str, ...Unknown{}, ...Unknown{}, <in, >out) -> std.Int
  ...

def hidden a @ Int b :k @ Str = "x" *rest **kw -> Int
  # ^~~~~~: decl [in -, out -] (std.Int, Unknown, ?k: std.Str, ...Unknown{}, ...Unknown{}, <in, >out) -> std.Int
  ...

pub def mixed ...rest
  #     ^~~~~: decl [in -, out -] (...Unknown{}, <in, >out) -> Unknown
  rest

pub def generic[T] x @ T -> T
  #     ^~~~~~~: decl [T, in -, out -] (T, <in, >out) -> T
  x

pub def items *args @ Str **kw @ Int
  #     ^~~~~: decl [in -, out -] (*std.Str, **std.Int, <in, >out) -> Unknown
  [args, kw]

pub def packed[*Ps, **Ks] *args @ Ps **kw @ Ks
  #     ^~~~~~: decl [Ps -, Ks -, in -, out -] (...Ps, ...Ks, <in, >out) -> Unknown
  [args, kw]

pub def fork[*Rs] *thunks @ ...(() -> Rs) -> Tuple[...Rs]
  #                            ^~~~~~~~~~: type {...(<in, >out) -> Rs}
  #     ^~~~: decl [Rs, in, out] (...(<in, >out) -> Rs, <in, >out) -> std.Tuple[...Rs]
  ...

pub def reads <Iter[Int] x
  #     ^~~~~: decl [out -] (Unknown, <std.Iter[std.Int], >out) -> Unknown
  x

# A function type without its own channels in a def's signature shares the
# def's; one in its body takes `Value`
pub def each f @ ((Int) -> nil)
  #              ^~~~~~~~~~~~~~: type (std.Int, <in, >out) -> nil
  let cb @ ((Int) -> nil) = do |_x| nil
  #        ^~~~~~~~~~~~~~: type (std.Int, <Value, >Value) -> nil
  [f, cb]

pub def pipe <Iter[Int] f @ (() -> nil)
  #                         ^~~~~~~~~~~: type (<std.Iter[std.Int], >out) -> nil
  f

pub def half f @ ((<Iter[Str]) -> nil)
  #              ^~~~~~~~~~~~~~~~~~~~~: type (<std.Iter[std.Str], >out) -> nil
  f

# Outside any def, they are `Value`
pub let handler @ (() -> nil) = do nil
#                 ^~~~~~~~~~~: type (<Value, >Value) -> nil

@def pick x @ Int -> Int
#    ^~~~: decl [in -, out -] (std.Int, <in, >out) -> std.Int
@def pick x @ Str -> Str
#    ^~~~: decl [in -, out -] (std.Str, <in, >out) -> std.Str
pub def pick x
  #     ^~~~: decl [in -, out -] (Unknown, <in, >out) -> Unknown
  x

hidden 1 2
