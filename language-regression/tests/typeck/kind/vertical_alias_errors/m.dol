pub class Num
pub class Tuple[*_Ts]

# Schemas remain a different kind from types, including inside unions.
pub @let BadUnion = $
  | {Num}
# error: expected a type, found a schema
#   --> m.dol:LL:LL
#    |
# LL |   | {Num}
#    |     ^^^^^

# Ordinary application passes one schema argument; it does not expand it.
pub @let BadTuple = Tuple $
  Num
# error: expected a type, found a schema
#   --> m.dol:LL:LL
#    |
# LL |   pub @let BadTuple = Tuple $
#    |  ___________________________^
# LL | |   Num
#    | |_____^
