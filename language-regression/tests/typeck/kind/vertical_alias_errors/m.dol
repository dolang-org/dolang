pub class Num

# Schema aliases remain a different kind from types, including inside unions.
pub @let Items = $
  Num
pub @let BadUnion = $
  | Items
# error: expected a type, found a schema
#   --> m.dol:LL:LL
#    |
# LL | pub @let Items = $
#    |          ----- declared here
# ...
# LL |   | Items
#    |     ^^^^^
#    |
#    = help: for a dict with this schema, write `Dict[Items]`
