# Only declarations determine kinds. A variadic binder is a schema, a keyword
# binder a type, and any other binder has its bound's kind, or is a type.

import @ext
# error: module `ext` not found
#   --> m.dol:LL:LL
#    |
# LL | import @ext
#    |         ^^^

pub class Plain[T]
  pub field item @ T = ...
  pub field items @ std.Phantom[((...T) -> nil)] = ...
# error: expected a schema, found a type
#   --> m.dol:LL:LL
#    |
# LL | pub class Plain[T]
#    |                 - declared here
# LL |   pub field item @ T = ...
# LL |   pub field items @ std.Phantom[((...T) -> nil)] = ...
#    |                                      ^

pub class Bounded[S @ {...}]
  pub field items @ std.Phantom[((...S) -> nil)] = ...
  pub field item @ S = ...
# error: expected a type, found a schema
#   --> m.dol:LL:LL
#    |
# LL | pub class Bounded[S @ {...}]
#    |                   - declared here
# LL |   pub field items @ std.Phantom[((...S) -> nil)] = ...
# LL |   pub field item @ S = ...
#    |                    ^

pub class Chained[A @ {...}, B @ A]
  pub field items @ std.Phantom[((...A, ...B) -> nil)] = ...
  pub field a @ A = ...
  # error: expected a type, found a schema
  #   --> m.dol:LL:LL
  #    |
  # LL | pub class Chained[A @ {...}, B @ A]
  #    |                   - declared here
  # LL |   pub field items @ std.Phantom[((...A, ...B) -> nil)] = ...
  # LL |   pub field a @ A = ...
  #    |                 ^
  pub field b @ B = ...
# error: expected a type, found a schema
#   --> m.dol:LL:LL
#    |
# LL | pub class Chained[A @ {...}, B @ A]
#    |                              - declared here
# ...
# LL |   pub field b @ B = ...
#    |                 ^

pub def rests[*P, **K, ...M, :Key] x @ ((...P, ...K, ...M) -> Key)
  x

pub def misused[*P, **K, ...M, :Key] p @ P k @ K m @ M key @ ((...Key) -> nil)
  # error: expected a type, found a schema
  #   --> m.dol:LL:LL
  #    |
  # LL | pub def misused[*P, **K, ...M, :Key] p @ P k @ K m @ M key @ ((...Key) -> nil)
  #    |                  - declared here         ^
  # error: expected a type, found a schema
  #   --> m.dol:LL:LL
  #    |
  # LL | pub def misused[*P, **K, ...M, :Key] p @ P k @ K m @ M key @ ((...Key) -> nil)
  #    |                       - declared here          ^
  # error: expected a type, found a schema
  #   --> m.dol:LL:LL
  #    |
  # LL | pub def misused[*P, **K, ...M, :Key] p @ P k @ K m @ M key @ ((...Key) -> nil)
  #    |                             - declared here          ^
  # error: expected a schema, found a type
  #   --> m.dol:LL:LL
  #    |
  # LL | pub def misused[*P, **K, ...M, :Key] p @ P k @ K m @ M key @ ((...Key) -> nil)
  #    |                                 --- declared here                 ^^^
  [p, k, m, key]

# Bounds that only name each other determine nothing
pub def cycle[U @ V, V @ U] x @ U y @ V f @ ((...U, ...V) -> nil)
  # error: expected a schema, found a type
  #   --> m.dol:LL:LL
  #    |
  # LL | pub def cycle[U @ V, V @ U] x @ U y @ V f @ ((...U, ...V) -> nil)
  #    |               - declared here                    ^
  # error: expected a schema, found a type
  #   --> m.dol:LL:LL
  #    |
  # LL | pub def cycle[U @ V, V @ U] x @ U y @ V f @ ((...U, ...V) -> nil)
  #    |                      - declared here                   ^
  [x, y, f]

# An external bound might have been either kind
pub def outside[E @ ext.Thing] x @ E f @ ((...E) -> nil)
  [x, f]

pub @let Fields = {name: Str}
pub @let Same = Fields
pub @let Opaque[...Ts] = ...

pub let fields @ Fields = nil
