# Redirecting both streams leaves the caller's channels alone
pub def redirected path @ Path -> nil
  let out = ([] @ Array[Str])
  proc.run cat stdin: $path stdout: $out
  nil

# A program proxy takes the same overloads
pub def proxy <Iter[Value] >Sink[Str] -> nil
  let git = proc.run[:git:]
  let _ = git
  #       ^~~: flow proc.Program
  git status
  nil

# `sub` gives its block an output of its own
pub def captures <Iter[Value] -> Str
  proc.sub do proc.run echo x

# `console` gives its block the console and no input
pub def effect() -> nil
  proc.console do
    proc.run make
    proc.run cat
  nil

# `run` destructures by name with a trailing rest, and spreads as no items
pub def names() -> nil
  let :git "clang++": clang ...rest = proc.run
  let _ = git
  #       ^~~: flow proc.Program
  let _ = clang
  #       ^~~~~: flow proc.Program
  let _ = rest
  #       ^~~~: flow proc.Run
  let _ = {...proc.run}
  nil

pub def positional() -> nil
  let _a ... = proc.run
  # error: `proc.Run` can never unpack as this pattern
  #   --> m.dol:LL:LL
  #    |
  # LL |   let _a ... = proc.run
  #    |                ^^^^^^^^
  nil
