# Redirecting both streams leaves the caller's channels alone
pub def redirected path @ Path -> nil
  let out = ([] @ Array[Str])
  proc.run cat stdin: $path stdout: $out
  nil

# A program proxy takes the same overloads
pub def proxy <Iter[Value] >Sink[Str] -> nil
  let git = proc.run["git"]
  let _ = git
  #       ^~~: flow proc.Program
  git status
  nil

# `sub` gives its block an output of its own
pub def captures <Iter[Value] -> Str
  proc.sub do proc.run echo x

# `console` gives its block the console and no input
pub def effect() -> nil
  proc.console do
    proc.run make
    proc.run cat
  nil

# String and path selectors produce program proxies.
pub def names path @ Path -> nil
  let git = proc.run["git"]
  let clang = proc.Program "clang++"
  let program = proc.run[path]
  let _ = git
  #       ^~~: flow proc.Program
  let _ = clang
  #       ^~~~~: flow proc.Program
  let _ = program
  #       ^~~~~~~: flow proc.Program
  nil

pub def removed_operations() -> nil
  let git: _git ... = proc.run
  # error: `proc.Run` is not unpackable
  #   --> m.dol:LL:LL
  #    |
  # LL |   let git: _git ... = proc.run
  #    |                       ^^^^^^^^
  let _a ... = proc.run
  # error: `proc.Run` is not unpackable
  #   --> m.dol:LL:LL
  #    |
  # LL |   let _a ... = proc.run
  #    |                ^^^^^^^^
  let _ = {...proc.run}
  # warning: the checker can't verify this
  #   --> m.dol:LL:LL
  #    |
  # LL |   let _ = {...proc.run}
  #    |           ^^^^^^^^^^^^^
  #    |
  #    = note: it doesn't handle a type nothing determines
  # error: `proc.Run` is not spreadable
  #   --> m.dol:LL:LL
  #    |
  # LL |   let _ = {...proc.run}
  #    |               ^^^^^^^^
  let _ = [...proc.run]
  # warning: the checker can't verify this
  #   --> m.dol:LL:LL
  #    |
  # LL |   let _ = [...proc.run]
  #    |           ^^^^^^^^^^^^^
  #    |
  #    = note: it doesn't handle a type nothing determines
  # error: `proc.Run` is not spreadable
  #   --> m.dol:LL:LL
  #    |
  # LL |   let _ = [...proc.run]
  #    |               ^^^^^^^^
  let _ = proc.run[:git:]
  # error: expected `fs.Path | std.Str`, found `:git:`
  #   --> m.dol:LL:LL
  #    |
  # LL |   let _ = proc.run[:git:]
  #    |                    ^^^^^
  let _ = proc.Program :git:
  # error: expected `fs.Path | std.Str`, found `:git:`
  #   --> m.dol:LL:LL
  #    |
  # LL |   let _ = proc.Program :git:
  #    |                        ^^^^^
  proc.run :git: stdin: $std.null stdout: $std.null
  # error: no overload of `(call)` accepts these arguments
  #   --> m.dol:LL:LL
  #    |
  # LL |   proc.run :git: stdin: $std.null stdout: $std.null
  #    |   ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
  #    |
  #    = note: `(proc.Run, fs.Path | std.Str, ?stderr: :STDOUT: | fs.Path | std.Sinkable[std.Str] | std.Str, ?policy: std.BaseDict[{?signal: proc.Signal | std.Int, ?grace: std.Float | std.Int | time.Duration, ?force: std.Bool}], ?mode: :LINE:, *Value, <std.Iter[Value], >std.Sink[std.Str]) -> nil`: this call does not fit `(proc.Run, fs.Path | std.Str, ?stderr: :STDOUT: | fs.Path | std.Sinkable[std.Str] | std.Str, ?policy: std.BaseDict[{?signal: proc.Signal | std.Int, ?grace: std.Float | std.Int | time.Duration, ?force: std.Bool}], ?mode: :LINE:, *Value, <std.Iter[Value], >std.Sink[std.Str]) -> nil`; the callee takes no such argument; expected `fs.Path | std.Str`, found `:git:`
  #    = note: `(proc.Run, fs.Path | std.Str, ?stderr: :STDOUT: | fs.Path | std.Sinkable[std.Bin] | std.Str, ?policy: std.BaseDict[{?signal: proc.Signal | std.Int, ?grace: std.Float | std.Int | time.Duration, ?force: std.Bool}], mode: :CHUNK:, *Value, <std.Iter[Value], >std.Sink[std.Bin]) -> nil`: this call does not fit `(proc.Run, fs.Path | std.Str, ?stderr: :STDOUT: | fs.Path | std.Sinkable[std.Bin] | std.Str, ?policy: std.BaseDict[{?signal: proc.Signal | std.Int, ?grace: std.Float | std.Int | time.Duration, ?force: std.Bool}], mode: :CHUNK:, *Value, <std.Iter[Value], >std.Sink[std.Bin]) -> nil`; this call is missing an argument; expected `fs.Path | std.Str`, found `:git:`
  #    = note: `(proc.Run, fs.Path | std.Str, stdout: fs.Path | std.Sinkable[std.Str] | std.Str, ?stderr: :STDOUT: | fs.Path | std.Sinkable[std.Str] | std.Str, ?policy: std.BaseDict[{?signal: proc.Signal | std.Int, ?grace: std.Float | std.Int | time.Duration, ?force: std.Bool}], ?mode: :LINE:, *Value, <std.Iter[Value]) -> nil`: this call does not fit `(proc.Run, fs.Path | std.Str, stdout: fs.Path | std.Sinkable[std.Str] | std.Str, ?stderr: :STDOUT: | fs.Path | std.Sinkable[std.Str] | std.Str, ?policy: std.BaseDict[{?signal: proc.Signal | std.Int, ?grace: std.Float | std.Int | time.Duration, ?force: std.Bool}], ?mode: :LINE:, *Value, <std.Iter[Value]) -> nil`; the callee takes no such argument; expected `fs.Path | std.Str`, found `:git:`
