# dolang: strict
# `proc` overloads its calls on whether `stdin:` and `stdout:` are given and on
# `mode:`, so a program touches only the channels it isn't redirected from.

import proc fs:
  - @Path

# Unredirected output is written as lines, which a def without `>` lacks
pub def writes_silent <Iter[Value] -> nil
  proc.run echo x
  # error: no overload of `(call)` accepts these arguments
  #   --> m.dol:LL:LL
  #    |
  # LL |   proc.run echo x
  #    |   ^^^^^^^^^^^^^^^
  #    |
  #    = note: `(proc.Run, fs.Path | std.Str | std.Sym, ?stderr: :STDOUT: | fs.Path | std.Sinkable[std.Str] | std.Str, ?policy: std.BaseDict[{?signal: proc.Signal | std.Int, ?grace: std.Float | std.Int | time.Duration, ?force: std.Bool}], ?mode: :LINE:, *Value, *(std.Sym): Value, <std.Iter[Value], >std.Sink[std.Str]) -> nil`: this call does not fit `(proc.Run, fs.Path | std.Str | std.Sym, ?stderr: :STDOUT: | fs.Path | std.Sinkable[std.Str] | std.Str, ?policy: std.BaseDict[{?signal: proc.Signal | std.Int, ?grace: std.Float | std.Int | time.Duration, ?force: std.Bool}], ?mode: :LINE:, *Value, *(std.Sym): Value, <std.Iter[Value], >std.Sink[std.Str]) -> nil`
  #    = note: `(proc.Run, fs.Path | std.Str | std.Sym, ?stderr: :STDOUT: | fs.Path | std.Sinkable[std.Bin] | std.Str, ?policy: std.BaseDict[{?signal: proc.Signal | std.Int, ?grace: std.Float | std.Int | time.Duration, ?force: std.Bool}], mode: :CHUNK:, *Value, *(std.Sym): Value, <std.Iter[Value], >std.Sink[std.Bin]) -> nil`: this call does not fit `(proc.Run, fs.Path | std.Str | std.Sym, ?stderr: :STDOUT: | fs.Path | std.Sinkable[std.Bin] | std.Str, ?policy: std.BaseDict[{?signal: proc.Signal | std.Int, ?grace: std.Float | std.Int | time.Duration, ?force: std.Bool}], mode: :CHUNK:, *Value, *(std.Sym): Value, <std.Iter[Value], >std.Sink[std.Bin]) -> nil`; this call is missing an argument
  #    = note: `(proc.Run, fs.Path | std.Str | std.Sym, stdout: fs.Path | std.Sinkable[std.Str] | std.Str, ?stderr: :STDOUT: | fs.Path | std.Sinkable[std.Str] | std.Str, ?policy: std.BaseDict[{?signal: proc.Signal | std.Int, ?grace: std.Float | std.Int | time.Duration, ?force: std.Bool}], ?mode: :LINE:, *Value, *(std.Sym): Value, <std.Iter[Value]) -> nil`: this call is missing an argument
  #    = note: `(proc.Run, fs.Path | std.Str | std.Sym, stdout: fs.Path | std.Sinkable[std.Bin] | std.Str, ?stderr: :STDOUT: | fs.Path | std.Sinkable[std.Bin] | std.Str, ?policy: std.BaseDict[{?signal: proc.Signal | std.Int, ?grace: std.Float | std.Int | time.Duration, ?force: std.Bool}], mode: :CHUNK:, *Value, *(std.Sym): Value, <std.Iter[Value]) -> nil`: this call is missing an argument
  #    = note: `(proc.Run, fs.Path | std.Str | std.Sym, stdin: fs.Path | std.Iterable[Value] | std.Str, ?stderr: :STDOUT: | fs.Path | std.Sinkable[std.Str] | std.Str, ?policy: std.BaseDict[{?signal: proc.Signal | std.Int, ?grace: std.Float | std.Int | time.Duration, ?force: std.Bool}], ?mode: :LINE:, *Value, *(std.Sym): Value, >std.Sink[std.Str]) -> nil`: this call does not fit `(proc.Run, fs.Path | std.Str | std.Sym, stdin: fs.Path | std.Iterable[Value] | std.Str, ?stderr: :STDOUT: | fs.Path | std.Sinkable[std.Str] | std.Str, ?policy: std.BaseDict[{?signal: proc.Signal | std.Int, ?grace: std.Float | std.Int | time.Duration, ?force: std.Bool}], ?mode: :LINE:, *Value, *(std.Sym): Value, >std.Sink[std.Str]) -> nil`; this call is missing an argument
