pub def writes_chunks <Iter[Value] >Sink[Bin] -> nil
  proc.run cat mode: :CHUNK:
  nil

# Unredirected input is read from the strand, which a def without `<` lacks
pub def reads_silent() -> nil
  let out = ([] @ Array[Str])
  proc.run cat stdout: $out
  # error: no overload of `(call)` accepts these arguments
  #   --> m.dol:LL:LL
  #    |
  # LL |   proc.run cat stdout: $out
  #    |   ^^^^^^^^^^^^^^^^^^^^^^^^^
