# Recursive data aliases relate coinductively: each member of one is below a
# member of the other, assuming the pair being related.

import json toml yaml
  std:
    - @BaseArray

pub @let A = (nil | Int | Array[A])
pub @let B = (nil | Int | BaseArray[B])

pub def encode
  data @ json.DecodeValue
  dict @ Dict[Str, json.DecodeValue]
  config @ toml.DecodeValue
  document @ yaml.DecodeValue
do
  json.encode $data
  json.encode $dict
  yaml.encode $data
  toml.encode $config
  yaml.encode $document

pub def decoded()
  let Dict(data) = json.decode "{}"
  json.encode $data
  let _ @ json.EncodeValue = json.decode "[]"
  let _ @ toml.EncodeValue = toml.decode "[]"
  let _ @ yaml.EncodeValue = yaml.decode "[]"

pub def views a @ A
  let _ @ B = a
