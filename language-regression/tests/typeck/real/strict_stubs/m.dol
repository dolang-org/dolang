# dolang: strict
# Strict extension stubs, used from a strict unit.

import @regex @sys.linux security.unix uuid @url time @patch @xml load zip tar sqlite fs

# `Regex.replace` runs a callback with its caller's channels
pub def replaces re @ regex.Regex >Sink[Str] -> Str
  re.replace "a b" do |_caps|
    put "match"
    "x"

pub def replaces_text re @ regex.Regex -> Str
  re.replace "a b" "x"

# A platform's error number narrows its originating system
pub def os e @ sys.linux.Errno -> :LINUX:
  let os = e.os
  #   ^~: flow :LINUX:
  os

# A flag set is built from symbols or one iterable of them
pub def permission() -> security.unix.Permission
  let p = security.unix.Permission :READ: :WRITE:
  #   ^: flow security.unix.Permission
  let _ = security.unix.Permission [:EXECUTE:]
  p


# Value-type getters and class constants
pub def values u @ url.Url p @ patch.Patch -> nil
  let _id = uuid.Uuid.NIL
  #   ^~~: flow uuid.Uuid
  let _port = u.port
  #   ^~~~~: flow nil | std.Int
  let _month = time.Month.JANUARY
  #   ^~~~~~: flow time.Month
  let _kind = p.type
  #   ^~~~~: flow :COPY: | :CREATE: | :DELETE: | :MODIFY: | :MOVE:
  nil

# Scoped blocks run with their caller's channels
pub def scoped node @ xml.Node >Sink[Str] -> nil
  let n = time.timeout 1 do
    put "x"
    1
  let _n = n
  #   ^~: flow std.Int
  let _ = node.attr "id" else: do
    put "y"
    "d"
  nil

# Loaded programs may write anything
pub def loads code @ Bin <Iter[Value] >Sink[Value] -> Value
  load.run $code

# Archive and database scopes run with their caller's channels
pub def archive_scopes >Sink[Str] -> Int
  zip.open "a.zip" do |archive|
    put "zip"
    archive.open "f" do |_file| put "file"
  tar.write "a.tar" do |w|
    w.entry "f" size: 0 do |_entry| put "entry"
  sqlite.open ":memory:" do |conn|
    conn.transaction do |_tx| put "tx"
    let n = conn.execute t"SELECT 1"
    #   ^: flow std.Int
    n

# Without a block, `open` returns the handle
pub def handles() -> nil
  let archive = zip.open "a.zip"
  #   ^~~~~~~: flow zip.Archive
  let conn = sqlite.open ":memory:"
  #   ^~~~: flow sqlite.Connection
  archive.close()
  conn.close()
  nil

# Entry metadata getters
pub def entries z @ zip.Entry t @ tar.Entry r @ tar.Reader -> nil
  let _mode = z.mode
  #   ^~~~~: flow nil | std.Int
  let _modified = z.last_modified
  #   ^~~~~~~~~: flow nil | time.DateTime
  let _path = t.path
  #   ^~~~~: flow fs.unix.Path
  let _owner = t.owner_name
  #   ^~~~~~: flow nil | std.Str
  let _compression = r.compression
  #   ^~~~~~~~~~~~: flow :GZIP: | :NONE: | :ZSTD:
  nil

# File scopes run with their caller's channels and return the block's result
pub def file_scopes >Sink[Str] -> Int
  let n = fs.open "a.txt" do |file|
    put "open"
    file.lock (..) do |_lock|
      put "lock"
      1
  let _n = n
  #   ^~: flow std.Int
  let dir = fs.with_temp_dir do |dir|
    put "temp"
    dir
  let _dir = dir
  #   ^~~~: flow fs.Path
  let bin = fs.Path("a.bin").open "rb" do |file| file.read()
  let _bin = bin
  #   ^~~~: flow std.Bin
  n

# Ownership is a uid/gid or a SID, depending on the platform
pub def owners meta @ fs.Metadata -> nil
  let _owner = meta.owner
  #   ^~~~~~: flow security.windows.Sid | std.Int
  let _group = meta.group
  #   ^~~~~~: flow security.windows.Sid | std.Int
  nil
