# The standard library's stub checks alongside a module that uses it.

pub let name @ Str = ""
#              ^~~: ref std.Str
pub let table @ Dict[Str, Int] = {}
#               ^~~~: ref std.Dict
#                         ^~~: ref std.Int

# The standard library's collections vary as their members use their items.
import std:
  - @BaseArray
  - @Seq
  - @Union
  - @Index
  - @Assign
  - @Spread

pub @let IterableOf[T] = Iterable[T]
#        ^~~~~~~~~~: decl [T +] std.Iterable[T]
pub @let IterOf[T] = Iter[T]
#        ^~~~~~: decl [T +] std.Iter[T]
pub @let SinkOf[T] = Sink[T]
#        ^~~~~~: decl [T -] std.Sink[T]
pub @let SinkableOf[T] = Sinkable[T]
#        ^~~~~~~~~~: decl [T -] std.Sinkable[T]
pub @let SeqOf[T] = Seq[T]
#        ^~~~~: decl [T +] std.Seq[T]
pub @let BaseArrayOf[T] = BaseArray[T]
#        ^~~~~~~~~~~: decl [T +] std.BaseArray[T]
pub @let ArrayOf[T] = Array[T]
#        ^~~~~~~: decl [T] [T]
pub @let TupleOf[T] = Tuple[T]
#        ^~~~~~~: decl [T +] (T,)
pub @let TypeOf[T] = Type[T]
#        ^~~~~~: decl [T +] std.Type[T]
pub @let UnionOf[T] = Union[T]
#        ^~~~~~~: decl [T +] T
pub @let IndexOf[S @ {...}] = Index[S]
#        ^~~~~~~: decl [S + @ {*Value, *(Value): Value}] std.Index[S]
pub @let AssignOf[S @ {...}] = Assign[S]
#        ^~~~~~~~: decl [S @ {*Value, *(Value): Value}] std.Assign[S]
pub @let SpreadOf[S @ {...}] = Spread[S]
#        ^~~~~~~~: decl [S + @ {*Value, *(Value): Value}] std.Spread[S]
pub @let DictOf[S @ {...}] = Dict[S]
#        ^~~~~~: decl [S @ {*Value, *(Value): Value}] std.Dict[S]

# An omitted ambient channel is bounded by the standard library's channels.
pub def relay()
  #     ^~~~~: decl [in -, out -] (<in, >out) -> Unknown
  nil
