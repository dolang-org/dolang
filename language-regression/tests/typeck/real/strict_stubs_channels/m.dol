# dolang: strict
# Strict extension stubs reject ambient I/O their caller's channels don't allow.

import time load @sqlite @term

# A scoped block writes to its caller's output, which a def without `>` lacks
pub def scoped_silent() -> nil
  time.timeout 1 do
    put "x"
  # error: this call does not fit `forall (#0.0, >std.Sink[#0.0]) -> nil`
  #   --> m.dol:LL:LL
  #    |
  # LL |     put "x"
  #    |     ^^^^^^^
  nil

# A loaded program may write anything, so its caller needs an output for `Value`
pub def loads_silent code @ Bin -> Value
  load.run $code
# error: this call does not fit `(std.Bin, ?importer: (std.Str, <Value, >Value) -> Value, <std.Iter[Value], >std.Sink[Value]) -> Value`
#   --> m.dol:LL:LL
#    |
# LL |   load.run $code
#    |   ^^^^^^^^^^^^^^

# A transaction runs its block with the caller's channels
pub def transaction_silent conn @ sqlite.Connection -> nil
  conn.transaction do |_tx|
    put "x"
  # error: this call does not fit `forall (#0.0, >std.Sink[#0.0]) -> nil`
  #   --> m.dol:LL:LL
  #    |
  # LL |     put "x"
  #    |     ^^^^^^^
  nil

# Joining without an iterable reads the strand's input, which a def without `<`
# lacks
pub def join_silent sep @ term.Text -> term.Text
  sep.join()
# error: no overload of `join` accepts these arguments
#   --> m.dol:LL:LL
#    |
# LL |   sep.join()
#    |   ^^^^^^^^^^
#    |
#    = note: `(term.Text, std.Iterable[Value]) -> term.Text`: this call is missing an argument
#    = note: `(term.Text, <std.Iter[Value]) -> term.Text`: this call does not fit `(term.Text, <std.Iter[Value]) -> term.Text`
