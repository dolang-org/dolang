# An omitted ambient channel is an implicit binder, used contravariantly. A function
# type without channels in the signature takes the def's, using them in reverse.

pub def plain _x
  #     ^~~~~: decl [in -, out -] (Unknown, <in, >out) -> Unknown
  nil

pub def takes _f @ (() -> nil)
  #     ^~~~~: decl [in, out] ((<in, >out) -> nil, <in, >out) -> Unknown
  nil

pub @class Reader[T]
  #        ^~~~~~: decl [T -] nominal
  pub def read self <T

pub @class Chan[T]
  #        ^~~~: decl [T] nominal
  pub def run self <T f @ (() -> nil)
