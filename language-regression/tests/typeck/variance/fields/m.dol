# A public field is invariant, since it is mutable. Private members are reached only
# through `self`, and `(init)` only while constructing, so neither counts. A
# `Phantom` field always uses its arguments covariantly.

import std:
  - @Phantom

pub class Cell[T]
  #       ^~~~: decl [T] nominal
  pub field item @ T = ...

pub class Getter[T]
  #       ^~~~~~: decl [T +] nominal
  field item @ T

  pub def (init) self item @ T
    self.#item = item

  pub def get self -> T
    self.#item

pub class Setter[T]
  #       ^~~~~~: decl [T -] nominal
  field item @ T

  pub def (init) self item @ T
    self.#item = item

  pub def set self item @ T
    self.#item = item

pub class Hidden[T]
  #       ^~~~~~: decl [T] nominal
  field item @ T

  pub def (init) self item @ T
    self.#item = item

  def take self item @ T
    self.#item = item

pub class Hook[T]
  #       ^~~~: decl [T -] nominal
  def (put) _self _value @ T
    nil

pub class Out[T]
  #       ^~~: decl [T +] nominal
  field marker @ Phantom[T]

pub class In[T]
  #       ^~: decl [T -] nominal
  field marker @ Phantom[(T -> nil)]

pub class Grouped[T]
  #       ^~~~~~~: decl [T +] nominal
  field marker @ (Phantom[T])

pub class Nested[T]
  #       ^~~~~~: decl [T] nominal
  pub field marker @ Wrap[Phantom[T]] = ...

pub @class Wrap[W]
  #        ^~~~: decl [W +] nominal
  pub def get self -> W
