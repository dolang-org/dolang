# Uses through a declaration's own binders, and through each other's, reach the
# least solution. A generic method's uses of its class's binders are its class's.

pub @class List[T]
  #        ^~~~: decl [T +] nominal
  pub def head self -> T
  pub def tail self -> List[T]

pub @class Ping[T]
  #        ^~~~: decl [T -] nominal
  pub def pong self -> Pong[T]

pub @class Pong[U]
  #        ^~~~: decl [U -] nominal
  pub def ping self -> Ping[U]
  pub def put self x @ U

pub @class Box[T]
  #        ^~~: decl [T +] nominal
  pub def get self -> T
  pub def map[U] self f @ (T -> U) -> Box[U]
  #       ^~~: decl [^T +, U, in, out] (m.Box[T], (T, <in, >out) -> U, <in, >out) -> m.Box[U]

pub @class Bounded[T]
  #        ^~~~~~~: decl [T -] nominal
  pub def put[U @ T] self x @ U
  #       ^~~: decl [^T -, U - @ T, in -, out -] (m.Bounded[T], U, <in, >out) -> Unknown

# A bound of a binder's own group is a covariant position for it
pub @class Pair[A, B @ Source[A]]
  #        ^~~~: decl [A +, B + @ m.Source[A]] nominal
  pub def first self -> A
  pub def second self -> B

pub @class Feed[A, B @ Bounded[A]]
  #        ^~~~: decl [A, B + @ m.Bounded[A]] nominal
  pub def first self -> A
  pub def second self -> B

pub @class Source[S]
  #        ^~~~~~: decl [S +] nominal
  pub def get self -> S
