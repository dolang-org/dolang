# A binder with no use is invariant, as is one used only through itself or through
# a binder with no use. A default is not a use.

pub class Unused[T]
  #       ^~~~~~: decl [T] nominal
  pub field loose = nil
# warning: unused binder
#   --> m.dol:LL:LL
#    |
# LL | pub class Unused[T]
#    |                  ^

pub @class Itself[T]
  #        ^~~~~~: decl [T] nominal
  pub def me self -> Itself[T]

pub @class Through[T]
  #        ^~~~~~~: decl [T] nominal
  pub def get self -> Unused[T]

pub @class Defaulted[T]
  #        ^~~~~~~~~: decl [T +] nominal
  pub def get self -> T
  pub def find[D = T] self -> D
  #       ^~~~: decl [^T, D + = T, in -, out -] (m.Defaulted[T], <in, >out) -> D
