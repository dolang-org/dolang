# An instance method's receiver does not count, annotated or not, nor does a class
# method's unannotated one. A class method's annotated first parameter does.

pub class Box[T]
  #           ^: variance covariant
  field item = nil

  pub def get self -> T
    self.#item

  @def narrow _self @ Box[Int] -> Int
  pub def narrow _self -> Int
    0

  #[class]
  pub def empty _cls -> Int
    0

pub class Made[T]
  #            ^: variance contravariant
  #[class]
  pub def make _cls @ T
    nil
