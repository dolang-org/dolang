# A type declared within a generic def takes the outer binders it uses as
# implicit arguments, and varies with them. A declaration that uses none of them
# takes none.

pub def outer[T] _x @ T
  @let Inner = (T -> nil)
  #    ^~~~~: decl [^T -] (T, <Value, >Value) -> nil
  @let Plain = Int
  @let Local = (() -> T)
  #    ^~~~~: decl [^T +] (<Value, >Value) -> T
  def reads _f @ Inner -> Local
    # ^~~~~: decl [^T +, in -, out -] (m.outer.Inner[^T], <in, >out) -> m.outer.Local[^T]
    ...
  def plain _p @ Plain
    # ^~~~~: decl [in -, out -] (m.outer.Plain, <in, >out) -> Unknown
    nil
  (reads, plain)
