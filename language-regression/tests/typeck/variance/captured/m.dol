# A type declared within a generic def takes the outer binders it uses as
# implicit arguments, and varies with them. A declaration that uses none of them
# takes none.

pub def outer[T] _x @ T
  @let Inner = (T -> nil)
  #    ^~~~~: captured T contravariant
  @let Plain = Int
  @let Local = (() -> T)
  #    ^~~~~: captured T covariant
  def reads _f @ Inner -> Local
    # ^~~~~: captured T covariant
    nil
  def plain _p @ Plain
    # ^~~~~: quantifier in contravariant, out contravariant
    nil
  (reads, plain)
