# A dict type is used as `Dict` uses its schema.

pub @let Spelled[T] = Dict[{a: T}]
#        ^~~~~~~: decl [T] {a: T}
pub @let Within[T] = Iter[{a: T}]
#        ^~~~~~: decl [T] std.Iter[{a: T}]

pub class Box[T]
  #       ^~~: decl [T] nominal
  pub def items self -> {a: T}
    ...

# An alias's body is a schema, as its items use the binder
pub @let Braced[T] = {a: T}
#        ^~~~~~: decl [T +] {a: T}
pub @let Items[T] = Tuple[...{T}]
#        ^~~~~: decl [T +] (T,)
