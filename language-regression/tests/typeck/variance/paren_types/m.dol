# A tuple or record type varies as the `Tuple` or `Record` it stands for does.

pub @let Pair[T] = (T, T)
#        ^~~~: decl [T +] (T, T)
pub @let Named[T] = (name: T, Int)
#        ^~~~~: decl [T +] (name: T, std.Int)
pub @let Callback[T] = ((T -> nil), Int)
#        ^~~~~~~~: decl [T -] ((T, <Value, >Value) -> nil, std.Int)

pub class Box[T]
  #       ^~~: decl [T +] nominal
  pub def pair self -> (T, T)
    ...
