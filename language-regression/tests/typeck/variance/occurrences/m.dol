# A def uses its parameters contravariantly and its result covariantly, and a
# function type reverses what its parameters use.

pub @class Source[T]
  #        ^~~~~~: decl [T +] nominal
  pub def get self -> T

pub @class Target[T]
  #        ^~~~~~: decl [T -] nominal
  pub def put self x @ T

pub @class Both[T]
  #        ^~~~: decl [T] nominal
  pub def get self -> T
  pub def put self x @ T

pub @class Each[T]
  #        ^~~~: decl [T +] nominal
  pub def each self f @ (T -> nil)

pub @class Rests[P, K, S @ {*, **Value}]
  #        ^~~~~: decl [P -, K -, S - @ {*Value, **Value}] nominal
  pub def take self *items @ P **named @ K ...pack @ S

pub @class Keyed[K @ Sym, V]
  #        ^~~~~: decl [K - @ std.Sym, V -] nominal
  pub def take self ...pack @ {?(K): V}

pub @class Shapes[A, B, C]
  #        ^~~~~~: decl [A +, B -, C] nominal
  pub def get self -> (A | ((B) -> C) | ((C) -> nil))

pub def pick[T, U] x @ T -> (T | U)
  #     ^~~~: decl [T, U +, in -, out -] (T, <in, >out) -> T | U
  x
