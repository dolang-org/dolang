# A function's parameters have symbol keys, except within `Phantom`. Its
# written channels may be any type.

import std:
  - @Iter
  - @Sink
  - @Phantom
  - @Sym

pub class Int

pub def named[S @ {*(Sym): Int}] f @ ((...S) -> nil)
  f

pub def numbered[S @ {*(Int): Int}] f @ ((...S) -> nil)
  # error: function parameters must have symbol keys
  #   --> m.dol:LL:LL
  #    |
  # LL | pub def numbered[S @ {*(Int): Int}] f @ ((...S) -> nil)
  #    |                                          ^^^^^^^^^^^^^
  f

# A schema's `**V` admits any key, so it doesn't fit parameters
pub def any_keys[S @ {**Int}] f @ ((...S) -> nil)
  # error: function parameters must have symbol keys
  #   --> m.dol:LL:LL
  #    |
  # LL | pub def any_keys[S @ {**Int}] f @ ((...S) -> nil)
  #    |                                    ^^^^^^^^^^^^^
  f

# An alias keeps the meaning of where it was written
pub @let AnyKeys = {**Int}
pub def aliased f @ ((...AnyKeys) -> nil)
  # error: function parameters must have symbol keys
  #   --> m.dol:LL:LL
  #    |
  # LL | pub def aliased f @ ((...AnyKeys) -> nil)
  #    |                      ^^^^^^^^^^^^^^^^^^^
  f

# In parentheses, `**V` is symbol-keyed
pub def parenthesized f @ ((**Int) -> nil)
  f

# `Phantom` only marks variance, so it takes any schema, and a function type
# within it may have any keys.
pub class Marker[S @ {*(Int): Int}]
  pub field keys @ Phantom[...S] = nil
  pub field marks @ Phantom[((...S) -> nil)] = nil

pub def reads f @ ((<Int) -> nil)
  f

pub def writes f @ ((>Int) -> nil)
  f

pub def source <Int
  nil

pub def drain >Int
  nil

pub def pipe <Iter[Int] >Sink[Int]
  nil

pub def bounded[N @ Iter[Int]] <N
  nil
