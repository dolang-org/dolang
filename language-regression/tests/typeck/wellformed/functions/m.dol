# A function's parameters have symbol keys, except within `Phantom`, and a `*`
# or `**` rest takes only the items of its lane. Its written channels may be
# any type.

import std:
  - @Iter
  - @Sink
  - @Phantom
  - @Sym

pub class Int

pub def named[S @ {*(Sym): Int}] f @ ((...S) -> nil)
  f

pub def numbered[S @ {*(Int): Int}] f @ ((...S) -> nil)
  # error: function parameters must have symbol keys
  #   --> m.dol:LL:LL
  #    |
  # LL | pub def numbered[S @ {*(Int): Int}] f @ ((...S) -> nil)
  #    |                                          ^^^^^^^^^^^^^
  f

# A schema's `**V` admits any key, so it doesn't fit parameters
pub def any_keys[S @ {**Int}] f @ ((...S) -> nil)
  # error: function parameters must have symbol keys
  #   --> m.dol:LL:LL
  #    |
  # LL | pub def any_keys[S @ {**Int}] f @ ((...S) -> nil)
  #    |                                    ^^^^^^^^^^^^^
  f

# An alias keeps the meaning of where it was written
pub @let AnyKeys = {**Int}
pub def aliased f @ ((...AnyKeys) -> nil)
  # error: function parameters must have symbol keys
  #   --> m.dol:LL:LL
  #    |
  # LL | pub def aliased f @ ((...AnyKeys) -> nil)
  #    |                      ^^^^^^^^^^^^^^^^^^^
  f

# In parentheses, `**V` is symbol-keyed
pub def parenthesized f @ ((**Int) -> nil)
  f

# `Phantom` only marks variance, so it takes any schema, and a function type
# within it may have any keys.
pub class Marker[S @ {*(Int): Int}]
  pub field keys @ Phantom[...S] = nil
  pub field marks @ Phantom[((...S) -> nil)] = nil

pub def reads f @ ((<Int) -> nil)
  f

pub def writes f @ ((>Int) -> nil)
  f

pub def source <Int
  nil

pub def drain >Int
  nil

pub def pipe <Iter[Int] >Sink[Int]
  nil

pub def bounded[N @ Iter[Int]] <N
  nil

# A `*` rest's schema has only positional items, and a `**` rest's only items
# keyed by symbols. A `...` rest takes both, but no other keys.
pub def positional[S @ {*Int}] *items @ S
  items

pub def keyed[S @ {*(Sym): Int}] **items @ S
  items

pub def both[S @ {*Int, *(Sym): Int}] ...items @ S
  items

pub def any_key ...items @ {**Int}
  # error: a `...` rest's schema must have only positional items and items keyed by symbols
  #   --> m.dol:LL:LL
  #    |
  # LL | pub def any_key ...items @ {**Int}
  #    |                            ^^^^^^^
  items

pub def keys_positional[S @ {*(Sym): Int}] *items @ S
  # error: a `*` rest's schema must have only positional items
  #   --> m.dol:LL:LL
  #    |
  # LL | pub def keys_positional[S @ {*(Sym): Int}] *items @ S
  #    |                                                     ^
  items

pub def items_keyed[S @ {*Int}] **items @ S
  # error: a `**` rest's schema must have only items keyed by symbols
  #   --> m.dol:LL:LL
  #    |
  # LL | pub def items_keyed[S @ {*Int}] **items @ S
  #    |                                           ^
  items

# A mapping keeps each item's lane, so a pattern's packs must fit the rest's
pub class Box[T]
  field item @ Phantom[T]

pub def mapped[S @ {*(Sym): Int}] **items @ ...Box[S]
  items

pub def mapped_positional[S @ {*Int}] **items @ ...Box[S]
  # error: a `**` rest's pattern must map over packs of only items keyed by symbols
  #   --> m.dol:LL:LL
  #    |
  # LL | pub def mapped_positional[S @ {*Int}] **items @ ...Box[S]
  #    |                                                    ^^^^^^
  items
