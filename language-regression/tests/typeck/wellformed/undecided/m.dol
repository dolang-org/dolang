# Where arguments after an expansion of unknown length go is not known, so their
# bounds are undecided: nothing is diagnosed, but the check is not validated.

pub class Num

pub class Split[*Ts, U @ Num]
  pub def items _self -> Split[...Ts, U]
    nil

pub def split[*Xs] x @ Split[...Xs, Num]
  #                    ^~~~~~~~~~~~~~~~~: wf undecided GenericArguments
  x
