# Type arguments satisfy their binders' bounds wherever they are written, and a
# binder's default satisfies its own bound.

pub class Num
pub class Int: Num
pub class Text

pub class Box[T @ Num]
  pub def get _self -> T
    ...

pub let good @ Box[Int] = ...
pub let bad @ Box[Text] = ...
# error: this does not satisfy `T @ Num`
#   --> m.dol:LL:LL
#    |
# LL | pub let bad @ Box[Text] = ...
#    |                   ^^^^

pub @let Boxed = Box[Text]
# error: this does not satisfy `T @ Num`
#   --> m.dol:LL:LL
#    |
# LL | pub @let Boxed = Box[Text]
#    |                      ^^^^

pub class Sub: Box[Text]
# error: this does not satisfy `T @ Num`
#   --> m.dol:LL:LL
#    |
# LL | pub class Sub: Box[Text]
#    |                    ^^^^

pub def bounded[T @ Box[Text]] x @ T
  # error: this does not satisfy `T @ Num`
  #   --> m.dol:LL:LL
  #    |
  # LL | pub def bounded[T @ Box[Text]] x @ T
  #    |                         ^^^^
  x

pub def defaulted[T @ Num = Text] x @ T
  # error: the default does not satisfy `T @ Num`
  #   --> m.dol:LL:LL
  #    |
  # LL | pub def defaulted[T @ Num = Text] x @ T
  #    |                             ^^^^
  x

# An omitted argument takes its default, substituted with the arguments before it.
pub class Pair[A @ Num, B @ Num = A]
  pub def first _self -> A
    ...
  pub def second _self -> B
    ...

pub let pair @ Pair[Int] = ...
pub let unpaired @ Pair[Text] = ...
# error: this does not satisfy `A @ Num`
#   --> m.dol:LL:LL
#    |
# LL | pub let unpaired @ Pair[Text] = ...
#    |                         ^^^^
# error: this does not satisfy `B @ Num`
#   --> m.dol:LL:LL
#    |
# LL | pub let unpaired @ Pair[Text] = ...
#    |                    ^^^^^^^^^^

# F-bounded and sibling-referencing bounds hold under the declaration's rigids.
pub class Cmp[T]
  pub def cmp _self _other @ T
    nil

pub class Sorted[T @ Cmp[T]]
  pub def first _self -> T
    ...

pub class Word: Cmp[Word]

pub let sorted @ Sorted[Word] = ...
pub let unsorted @ Sorted[Text] = ...
# error: this does not satisfy `T @ Cmp[T]`
#   --> m.dol:LL:LL
#    |
# LL | pub let unsorted @ Sorted[Text] = ...
#    |                           ^^^^

pub class Within[U, T @ U]
  pub def outer _self -> U
    ...
  pub def inner _self -> T
    ...

pub let within @ Within[Num, Int] = ...
pub let outside @ Within[Int, Num] = ...
# error: this does not satisfy `T @ U`
#   --> m.dol:LL:LL
#    |
# LL | pub let outside @ Within[Int, Num] = ...
#    |                               ^^^
