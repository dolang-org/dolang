# dolang: strict
# A strict unit is warned where the checker can't verify a check, with a note
# giving the reason.

import std:
  - @Unknown

pub class Num

pub class Split[*Ts, U @ Num]
  field items @ std.Phantom[...Ts, U] = ...

pub def split[*Xs] _x @ Split[...Xs, Num]
  # warning: the checker can't verify this
  #   --> m.dol:LL:LL
  #    |
  # LL | pub def split[*Xs] _x @ Split[...Xs, Num]
  #    |                         ^^^^^^^^^^^^^^^^^
  #    |
  #    = note: it can't match type arguments past an expansion; put positional arguments first
  ...

# Nothing tells apart overloads expected to take `Unknown`, so which one fits
# is undecided
@def o _x @ Int -> Int
@def o _x @ Int -> Str
pub def o x @ Value -> Value
  x

# A check undecided for several reasons has a note for each
pub class Keyed[**Ks]
  field items @ std.Phantom[...Ks] = ...

pub def both[**Xs, **Ys] p @ Keyed[...Xs, ...Ys] -> Tuple[(Unknown) -> Int, Keyed[...Ys, ...Xs]]
  let t = (o, p)
  t
  # warning: the checker can't verify this
  #   --> m.dol:LL:LL
  #    |
  # LL |   t
  #    |   ^
  #    |
  #    = note: these keyed packs come in a different order on each side; write them in the same order
  #    = note: several alternatives remain possible; an annotation may pick one

# Keyed packs in another order on each side don't pair, though none is
# positional
pub def swap[**Xs, **Ys] p @ Keyed[...Xs, ...Ys] -> Keyed[...Ys, ...Xs]
  p
  # warning: the checker can't verify this
  #   --> m.dol:LL:LL
  #    |
  # LL |   p
  #    |   ^
  #    |
  #    = note: these keyed packs come in a different order on each side; write them in the same order

# An optional item ahead of a positional pack leaves where the pack starts
# unknown
pub def optional_ahead[*Xs] p @ Tuple[Int, ...Xs] -> Tuple[?Int, ...Xs]
  p
  # warning: the checker can't verify this
  #   --> m.dol:LL:LL
  #    |
  # LL |   p
  #    |   ^
  #    |
  #    = note: it can't match up these positional items

# A def's omitted channels are instantiated and settled wherever its value is
# checked, as for an argument
@def picked _x @ Int -> Int
@def picked _x @ Str -> Str
pub def picked x @ Value -> Value
  x

def plain x @ Int -> Int
  x

pub def settled -> ((Int) -> Int)
  let _p @ ((Int) -> Int) = picked
  let _q = (plain @ ((Int) -> Int))
  plain

# A literal whose items are left undecided against what's expected of it is
# undecided where it's checked, as a value bound first is
pub def literal -> Tuple[(Unknown) -> Int]
  (o,)
  # warning: the checker can't verify this
  #   --> m.dol:LL:LL
  #    |
  # LL |   (o,)
  #    |   ^^^^
  #    |
  #    = note: several alternatives remain possible; an annotation may pick one

pub def elements -> Array[(Unknown) -> Int]
  [o]
  # warning: the checker can't verify this
  #   --> m.dol:LL:LL
  #    |
  # LL |   [o]
  #    |   ^^^
  #    |
  #    = note: several alternatives remain possible; an annotation may pick one
