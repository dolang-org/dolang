pub def constants value @ (200 | 404 | 500)
  if let 200 | 404 = value
    let _ = value
    #       ^~~~~: flow 200 | 404
  else
    let _ = value
    #       ^~~~~: flow 500

pub def asserted value @ (200 | 404 | 500)
  let (200 | 404) = value
  let _ = value
  #       ^~~~~: flow 200 | 404

pub def typed value @ (Int | Str | Bool)
  if let Int(x) | Str(x) = value
    let _ = x
    #       ^: flow std.Int | std.Str
  else
    let _ = value
    #       ^~~~~: flow std.Bool

pub def shapes value @ (Tuple[Int] | Tuple[Str, Bool])
  let (n) | n _ = value
  let _ = n
  #       ^: flow std.Int | std.Str

pub def defaults value @ Array[Int]
  let (1 a b = "none" | 2 b a = nil) = value
  let _ = a
  #       ^: flow std.Int | std.Nil
  let _ = b
  #       ^: flow std.Int | std.Str

pub def nested value @ Tuple[Sym, (1 | 2 | 3)]
  if let (k (1 | 2) | k _) = value
    let _ = k
    #       ^: flow std.Sym

# A pattern's mismatch drops the members it always matches
pub def mismatch value @ (Tuple[Int, Int] | Tuple[Str] | Array[Int])
  if let _a _b = value
    nil
  else
    let _ = value
    #       ^~~~~: flow (std.Str,) | [std.Int]

pub def mismatch_defaults value @ (Tuple[Int] | Tuple[Int, Int] | Tuple[Int, Int, Int])
  if let (_a _b = 0) = value
    nil
  else
    let _ = value
    #       ^~~~~: flow (std.Int, std.Int, std.Int)

pub def mismatch_keyed value @ ({a: Int, b: Int} | {a: Int} | Dict[Sym, Int])
  if let :a b: _b = value
    a
  else
    let _ = value
    #       ^~~~~: flow std.Dict[std.Sym, std.Int] | {a: std.Int}

# A sub-pattern's mismatch doesn't narrow the whole
pub def mismatch_nested value @ (Tuple[Int, Tuple[Int, Int]] | Tuple[Int])
  if let _a (_b _c) = value
    nil
  else
    let _ = value
    #       ^~~~~: flow (std.Int, (std.Int, std.Int)) | (std.Int,)

pub def mismatch_arms value @ (Tuple[Int, Int] | Tuple[Str]) -> Str
  match value
    _ _ do "pair"
    other do
      let _ = other
      #       ^~~~~: flow (std.Str,)
      "single"
