# Member use is checked through the member lookup, as the runtime makes it: a
# method call passes the receiver first, a class call runs `(init)`, and indexing
# and operators call special methods. An unknown receiver is dynamic, and a call
# through an overloaded method takes one of its overloads. A union receiver is in
# `union_members`.

import std:
  - @AssignItem
  - @Index

pub def drop x
  ...

pub class Point
  pub field x @ Int = 0
  field secret @ Str = ""

  def (init) self x @ Int
    self.x = x

  pub def moved self by @ Int -> Point
    Point (self.x + by)

  pub def peek self -> Str
    self.#secret

  #[getter]
  pub def norm self -> Int
    self.x

  #[setter]
  pub def label self value @ Str
    self.#secret = value

  @def pick _self x @ Int -> Int
  @def pick _self x @ Str -> Str
  pub def pick _self x
    x

  #[class]
  pub def origin cls -> Point
    ...

pub class Origin: Point

pub class Box[T]
  pub field item @ T = nil

  def (init) self item @ T
    self.item = item

  pub def map[U] self f @ ((T) -> U) -> Box[U]
    ...

  pub def (index) self key @ Int -> T
    ...

  pub def (assign) self key @ Int value @ T
    ...

  pub def (add) self other @ Box[T] -> Box[T]
    ...

  pub def (lt) self other @ Box[T] -> Bool
    ...

  #[class]
  pub def make cls item @ T -> Box[T]
    ...

  #[class]
  #[getter]
  pub def first cls -> T
    ...

pub class Made
  #[class]
  pub def (call) _cls n @ Int -> Str
    ...

pub class Dir
  pub def (div) self other @ Str -> Dir
    ...

  pub def (rdiv) self other @ Str -> Dir
    ...

pub class Bag
  pub def (get) self name @ Sym -> Int
    ...

  pub def (set) self name @ Sym value @ Int
    ...

pub def fields p @ Point
  let x = p.x
  let _ = x
  #       ^: flow std.Int
  p.x = 1
  p.x = "a"
  # error: expected `std.Int`, found `"a"`
  #   --> m.dol:LL:LL
  #    |
  # LL |   p.x = "a"
  #    |         ^^^
  let s = p.peek()
  let _ = s
  #       ^: flow std.Str
  let n = p.norm
  let _ = n
  #       ^: flow std.Int
  p.label = "a"
  let _ = p.missing
  # error: `m.Point` has no member `missing`
  #   --> m.dol:LL:LL
  #    |
  # LL |   let _ = p.missing
  #    |           ^^^^^^^^^
  p.norm = 1
  # error: `norm` has no setter
  #   --> m.dol:LL:LL
  #    |
  # LL |   p.norm = 1
  #    |   ^^^^^^^^^^
  p.moved = 1
# error: `moved` is a method, which can't be assigned
#   --> m.dol:LL:LL
#    |
# LL |   p.moved = 1
#    |   ^^^^^^^^^^^

pub def methods p @ Point
  let q = p.moved 1
  let _ = q
  #       ^: flow m.Point
  p.moved "a"
  # error: expected `std.Int`, found `"a"`
  #   --> m.dol:LL:LL
  #    |
  # LL |   p.moved "a"
  #    |           ^^^
  let m = p.moved
  let _ = m
  #       ^: flow (std.Int) -> m.Point
  let o = Point.origin()
  let _ = o
  #       ^: flow m.Point
  let k = p.pick 1
  let _ = k
  #       ^: flow std.Int

pub def generic b @ Box[Int]
  let i = b.item
  let _ = i
  #       ^: flow std.Int
  let c = b.map do |y|
    let _ = y
    #       ^: flow std.Int
    "a"
  let _ = c
  #       ^: flow m.Box[std.Str]
  let e = b[0]
  let _ = e
  #       ^: flow std.Int
  b[0] = 1
  b[0] = "a"
  # error: expected `std.Int`, found `"a"`
  #   --> m.dol:LL:LL
  #    |
  # LL |   b[0] = "a"
  #    |          ^^^
  let d = (b + b)
  let _ = d
  #       ^: flow m.Box[std.Int]
  let l = (b > b)
  let _ = l
  #       ^: flow std.Bool
  let q = (b == 1)
  let _ = q
  #       ^: flow std.Bool

# A generic class's object has its members quantified over the class's binders,
# which a call infers from its arguments. A class-level method or property is
# bound to the object, which is every application of the class.
pub def generic_objects b @ Box[Int] items @ Array[Str] cls @ Type[Box[Int]]
  let c = Box.map $b do |y|
    let _ = y
    #       ^: flow std.Int
    "a"
  let _ = c
  #       ^: flow m.Box[std.Str]
  let m = Box.map
  let _ = m
  #       ^: flow @[T1, T2] (m.Box[T1], (T1) -> T2) -> m.Box[T2]
  let n = Box.make 1
  let _ = n
  #       ^: flow m.Box[std.Int]
  # Nothing determines the getter's binder
  let f = Box.first
  let _ = f
  #       ^: flow Unknown
  let i = Iterable.iter $items
  let _ = i
  #       ^: flow std.Iter[std.Str]
  # An applied type object's members are its class's, applied
  let a = cls.make 1
  let _ = a
  #       ^: flow m.Box[std.Int]
  let g = cls.first
  let _ = g
  #       ^: flow std.Int
  let d = Box.map $b do |y| y
  let _ = d
  #       ^: flow m.Box[std.Int]
  Box.map 1 do |y| y
# error: expected `m.Box[Unknown]`, found `1`
#   --> m.dol:LL:LL
#    |
# LL |   Box.map 1 do |y| y
#    |           ^

pub def reflected d @ Dir
  let a = (d / "x")
  let _ = a
  #       ^: flow m.Dir
  # `Str` has no `(div)`, so the right operand's `(rdiv)` is called
  let b = ("x" / d)
  let _ = b
  #       ^: flow m.Dir

pub def fallback g @ Bag
  let n = g.anything
  let _ = n
  #       ^: flow std.Int
  g.anything = 1
  g.anything = "a"
# error: expected `std.Int`, found `"a"`
#   --> m.dol:LL:LL
#    |
# LL |   g.anything = "a"
#    |                ^^^

pub def constructed()
  let p = Point 1
  let _ = p
  #       ^: flow m.Point
  Point "a"
  # error: expected `std.Int`, found `"a"`
  #   --> m.dol:LL:LL
  #    |
  # LL |   Point "a"
  #    |         ^^^
  let m = Made 1
  let _ = m
  #       ^: flow std.Str
  let o = Origin 1
  let _ = o
  #       ^: flow m.Origin
  let b = Box "a"
  let _ = b
  #       ^: flow m.Box[std.Str]
  let r = 1..3
  let _ = r
  #       ^: flow std.Range[std.Int]

pub def dynamic x
  let a = x.anything
  let _ = a
  #       ^: flow Unknown

# A literal key picks its own item, since the key isn't decayed. A key must be
# one of the schema's.
pub def looked d @ Dict[{a: Int, b: Str}] k @ Sym i @ Index[{a: Int}] o @ Dict[{...}]
  let a = d[:a:]
  let _ = a
  #       ^: flow std.Int
  let b = d[:b:]
  let _ = b
  #       ^: flow std.Str
  let _ = d[:c:]
  # error: this call selects by `:c:`, which isn't one of the schema's keys
  #   --> m.dol:LL:LL
  #    |
  # LL |   let _ = d[:c:]
  #    |           ^^^^^^
  let _ = d[k]
  # error: this call selects by `std.Sym`, which isn't one of the schema's keys
  #   --> m.dol:LL:LL
  #    |
  # LL |   let _ = d[k]
  #    |           ^^^^
  let j = i[:a:]
  let _ = j
  #       ^: flow std.Int
  # An open schema has every key
  let x = o[k]
  let _ = x
  #       ^: flow Value
  d[:a:] = 1

# Iterating a dict gives its entries, each key with its own value. A key the
# schema writes stays a literal, where one a term gives would decay.
pub def iterated d @ Dict[{a: Int, b: Str}] s @ Dict[{*(Str): Int}]
  for p = d
    let _ = p
    #       ^: flow (:a:, std.Int) | (:b:, std.Str)
  for k v = d
    let _ = k
    #       ^: flow :a: | :b:
    let _ = v
    #       ^: flow std.Int | std.Str
  let ks = s.keys()
  let _ = ks
  #       ^~: flow std.UnpackIter[std.Str]
  let vs = d.values()
  let _ = vs
  #       ^~: flow std.UnpackIter[std.Int | std.Str]
  # The keys are the schema's
  keyed $d.keys()
  keyed $s.keys()
# error: expected `std.Iter[:a: | :b:]`, found `std.UnpackIter[std.Str]`
#   --> m.dol:LL:LL
#    |
# LL |   keyed $s.keys()
#    |          ^^^^^^^^
#    |
#    = note: `std.Str` does not fit `:a: | :b:`

pub def keyed ks @ Iter[(:a: | :b:)]
  ...

# A collection keys a schema's positions by their indexes, so a key that may be
# one of them conflicts.
pub def promoted p @ Dict[{Int, Str}] v @ Dict[{Int, *Bool}] c @ Dict[{Int, 0: Str}]
  for k x = p
    let _ = k
    #       ^: flow 0 | 1
    let _ = x
    #       ^: flow std.Int | std.Str
  let pk = p.keys()
  let _ = pk
  #       ^~: flow std.UnpackIter[0 | 1]
  let vk = v.keys()
  let _ = vk
  #       ^~: flow std.UnpackIter[std.Int]
  indexes $c.keys()
# error: this call indexes a schema with a key that may be one of its positions' indexes
#   --> m.dol:LL:LL
#    |
# LL |   indexes $c.keys()
#    |   ^^^^^^^^^^^^^^^^^

pub def indexes ks @ Iter[Int]
  ...

# A key selects items, positions by their indexes. A read gives the join of what
# it selects, and a write must fit their meet.
pub def selected
  r @ Record[Int, a: Str]
  w @ Dict[{Int, *Str}]
  d @ Dict[{a: Int, b: Str}]
  s @ Dict[{*(Sym): Int}]
  p @ Dict[{Int, Str}]
  c @ Dict[{Int, 0: Str}]
  k @ (:a: | :b:)
  y @ Sym
do
  # A narrower record passes where a wider one is expected
  widened $r
  let _ = r[0]
  #   ^: flow std.Int
  let _ = r[:a:]
  #   ^: flow std.Str
  let _ = r[5]
  # error: this call selects by `5`, which isn't one of the schema's keys
  #   --> m.dol:LL:LL
  #    |
  # LL |   let _ = r[5]
  #    |           ^^^^
  let _ = r[y]
  # error: this call selects by `std.Sym`, which isn't one of the schema's keys
  #   --> m.dol:LL:LL
  #    |
  # LL |   let _ = r[y]
  #    |           ^^^^
  let _ = w[1]
  #   ^: flow std.Str
  let _ = d[k]
  #   ^: flow std.Int | std.Str
  d[:a:] = "x"
  # error: expected `std.Int`, found `"x"`
  #   --> m.dol:LL:LL
  #    |
  # LL |   d[:a:] = "x"
  #    |            ^^^
  d[:c:] = 1
  # error: this call selects by `:c:`, which isn't one of the schema's keys
  #   --> m.dol:LL:LL
  #    |
  # LL |   d[:c:] = 1
  #    |   ^^^^^^^^^^
  s[:c:] = 1
  p[0] = "x"
  # error: expected `std.Int`, found `"x"`
  #   --> m.dol:LL:LL
  #    |
  # LL |   p[0] = "x"
  #    |          ^^^
  p[1] = "x"
  d[k] = "x"
  # error: expected `Never`, found `"x"`
  #   --> m.dol:LL:LL
  #    |
  # LL |   d[k] = "x"
  #    |          ^^^
  let _ = c[0]
# error: this call indexes a schema with a key that may be one of its positions' indexes
#   --> m.dol:LL:LL
#    |
# LL |   let _ = c[0]
#    |           ^^^^

pub def widened r @ Record[Int, a: Value]
  ...

# A key of unknown type may be any of the dict's keys
pub def unknown_key d @ Dict[Sym, Str] k
  let _ = d.get $k

# A dict's methods that take a key select by it, as indexing does
pub def dict_methods d @ Dict[{a: Int, ?b: Str}] k @ (:a: | :b:)
  # A binder nothing determines takes its default: `get`'s `nil`, `pop`'s
  # `Never`
  let _ = d.get :a:
  #   ^: flow nil | std.Int
  let _ = d.get $k default: 0
  #   ^: flow std.Int | std.Str
  let _ = d.pop :b:
  #   ^: flow std.Str
  let _ = d.values :b:
  #   ^: flow std.UnpackIter[std.Str]
  let _ = d.values()
  #   ^: flow std.UnpackIter[std.Int | std.Str]
  d.insert :a: 1
  d.insert :a: "x"
# error: expected `std.Int`, found `"x"`
#   --> m.dol:LL:LL
#    |
# LL |   d.insert :a: "x"
#    |                ^^^

pub def tuple_get t @ Tuple[Int, Str]
  let _ = t.get 0
  #   ^: flow nil | std.Int | std.Str

# An assigned value is a setter's, `(set)`'s or `(assign)`'s argument, so it's
# expected to be what the parameter takes, as a field's value is expected to be
# the field's type
pub class Holder
  pub field cb @ ((Int) -> Str) = do |_x| ""
  field saved @ ((Int) -> Str) = do |_x| ""

  #[getter]
  pub def cb2 self -> ((Int) -> Str)
    self.#saved

  #[setter]
  pub def cb2 self f @ ((Int, <Value, >Value) -> Str)
    self.#saved = f

  #[getter]
  pub def items self -> Array[(Int | Str)]
    ...

  #[setter]
  pub def items self items @ Array[(Int | Str)]
    ...

pub class Other
  #[getter]
  pub def cb2 self -> ((Int) -> Str)
    ...

  #[setter]
  pub def cb2 self f @ ((Int) -> Str)
    ...

pub class Hooks
  pub def (get) self name @ Sym -> ((Int) -> Str)
    ...

  pub def (set) self name @ Sym f @ ((Int) -> Str)
    ...

pub def assigned
  h @ Holder
  u @ (Holder | Other)
  k @ Hooks
  d @ Dict[Str, ((Int) -> Str)]
  a @ Array[((Int) -> Str)]
do
  h.cb = do |z| "$z"
  h.cb = do |z| z
  # error: expected `(std.Int) -> std.Str`, found `(std.Int) -> std.Int`
  #   --> m.dol:LL:LL
  #    |
  # LL |   h.cb = do |z| z
  #    |          ^^^^^^^^
  #    |
  #    = note: `std.Int` does not fit `std.Str`
  h.cb2 = do |z| "$z"
  h.cb2 = do |z| z
  # error: expected `(std.Int) -> std.Str`, found `(std.Int) -> std.Int`
  #   --> m.dol:LL:LL
  #    |
  # LL |   h.cb2 = do |z| z
  #    |           ^^^^^^^^
  #    |
  #    = note: `std.Int` does not fit `std.Str`
  u.cb2 = do |z| "$z"
  u.cb2 = do |z| z
  # error: expected `(std.Int) -> std.Str`, found `(std.Int) -> std.Int`
  #   --> m.dol:LL:LL
  #    |
  # LL |   u.cb2 = do |z| z
  #    |           ^^^^^^^^
  #    |
  #    = note: `std.Int` does not fit `std.Str`
  k.anything = do |z| "$z"
  k.anything = do |z| z
  # error: expected `(std.Int) -> std.Str`, found `(std.Int) -> std.Int`
  #   --> m.dol:LL:LL
  #    |
  # LL |   k.anything = do |z| z
  #    |                ^^^^^^^^
  #    |
  #    = note: `std.Int` does not fit `std.Str`
  d["k"] = do |z| "$z"
  d["k"] = do |z| z
  # error: expected `(std.Int) -> std.Str`, found `(std.Int) -> std.Int`
  #   --> m.dol:LL:LL
  #    |
  # LL |   d["k"] = do |z| z
  #    |            ^^^^^^^^
  #    |
  #    = note: `std.Int` does not fit `std.Str`
  a[0] = do |z| "$z"
  a[0] = do |z| z
  # error: expected `(std.Int) -> std.Str`, found `(std.Int) -> std.Int`
  #   --> m.dol:LL:LL
  #    |
  # LL |   a[0] = do |z| z
  #    |          ^^^^^^^^
  #    |
  #    = note: `std.Int` does not fit `std.Str`

  # A fresh array takes the element type it's expected to have
  h.items = [1]
  let items = [1]
  h.items = items
# error: expected `[std.Int | std.Str]`, found `[std.Int]`
#   --> m.dol:LL:LL
#    |
# LL |   h.items = items
#    |             ^^^^^
#    |
#    = note: `std.Int` doesn't accept `std.Str`

pub class Slots[S @ {...}]
  pub def put[K] self key@K value@AssignItem[S, K]
    ...

# A literal passed for an item's value is expected to be the item its key
# selects, which a literal key selects exactly
pub def assigned_items
  d @ Dict[Str, Array[(Int | Str)]]
  s @ Slots[{*(Str): Array[(Int | Str)]}]
  r @ Dict[{a: Array[(Int | Str)], b: Int}]
do
  d["k"] = [1]
  d.insert "k" [1]
  s.put "k" [1]
  r[:a:] = [1]
  r.insert :a: [1]
  d["k"] = [nil]
# error: expected `[std.Int | std.Str]`, found `[std.Nil]`
#   --> m.dol:LL:LL
#    |
# LL |   d["k"] = [nil]
#    |            ^^^^^
#    |
#    = note: `std.Nil` doesn't accept `std.Int | std.Str`
#    = note: `std.Nil` does not fit `std.Int | std.Str`

pub class Shadow: Func
  pub def tag self -> Int
    # warning: instance method `Shadow.tag` hides class member `Shadow.tag`, which is reachable only through `type(Shadow)`
    #   --> m.dol:LL:LL
    #    |
    # LL |   pub def tag self -> Int
    #    |           ^^^
    ...

  #[class]
  pub def tag cls -> Str
    ...

  pub def mode self -> Int
    # warning: instance method `Shadow.mode` hides class member `Shadow.mode`, which is reachable only through `type(Shadow)`
    #   --> m.dol:LL:LL
    #    |
    # LL |   pub def mode self -> Int
    #    |           ^^^^
    ...

  #[class]
  pub field mode @ Str = "a"

  pub field level @ Int = 0

  #[class]
  pub field level @ Str = "a"

  pub def (call) self -> Int
    ...

  #[class]
  pub def (call) _cls n @ Int -> Str
    ...

pub class Inherits: Shadow

pub class Labelled
  pub def label self -> Int
    ...

pub class Relabelled: Labelled
  #[class]
  pub def label cls -> Str
    # warning: instance method `Labelled.label` hides class member `Relabelled.label`, which is reachable only through `type(Relabelled)`
    #   --> m.dol:LL:LL
    #    |
    # LL |   pub def label cls -> Str
    #    |           ^^^^^
    ...

# Through a class object, an instance method is found first, unbound. An
# instance field isn't reached, and an assignment reaches only class members.
pub def shadowed()
  let t = Shadow.tag
  let _ = t
  #       ^: flow (m.Shadow) -> std.Int
  let i = Inherits.tag
  let _ = i
  #       ^: flow (m.Shadow) -> std.Int
  let r = Relabelled.label
  let _ = r
  #       ^: flow (m.Labelled) -> std.Int
  let l = Shadow.level
  let _ = l
  #       ^: flow std.Str
  Shadow.level = "b"
  Shadow.mode = "b"
  Shadow.mode = 1
  # error: expected `std.Str`, found `1`
  #   --> m.dol:LL:LL
  #    |
  # LL |   Shadow.mode = 1
  #    |                 ^

  # Construction reaches only a class `(call)`
  let s = Shadow 1
  let _ = s
  #       ^: flow std.Str
