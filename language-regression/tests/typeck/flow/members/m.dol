# Member use is checked through the member lookup, as the runtime makes it: a
# method call passes the receiver first, a class call runs `(init)`, and indexing
# and operators call special methods. An unknown receiver is dynamic, and a call
# through an overloaded method takes one of its overloads. A union receiver is in
# `union_members`.

import std:
  - @Index

pub def drop x
  ...

pub class Point
  pub field x @ Int = 0
  field secret @ Str = ""

  def (init) self x @ Int
    self.x = x

  pub def moved self by @ Int -> Point
    Point (self.x + by)

  pub def peek self -> Str
    self.#secret

  #[getter]
  pub def norm self -> Int
    self.x

  #[setter]
  pub def label self value @ Str
    self.#secret = value

  @def pick _self x @ Int -> Int
  @def pick _self x @ Str -> Str
  pub def pick _self x
    x

  #[class]
  pub def origin cls -> Point
    ...

pub class Origin: Point

pub class Box[T]
  pub field item @ T = nil

  def (init) self item @ T
    self.item = item

  pub def map[U] self f @ ((T) -> U) -> Box[U]
    ...

  pub def (index) self key @ Int -> T
    ...

  pub def (assign) self key @ Int value @ T
    ...

  pub def (add) self other @ Box[T] -> Box[T]
    ...

  pub def (lt) self other @ Box[T] -> Bool
    ...

  #[class]
  pub def make cls item @ T -> Box[T]
    ...

  #[class]
  #[getter]
  pub def first cls -> T
    ...

pub class Made
  #[class]
  pub def (call) _cls n @ Int -> Str
    ...

pub class Dir
  pub def (div) self other @ Str -> Dir
    ...

  pub def (rdiv) self other @ Str -> Dir
    ...

pub class Bag
  pub def (get) self name @ Sym -> Int
    ...

  pub def (set) self name @ Sym value @ Int
    ...

pub def fields p @ Point
  let x = p.x
  let _ = x
  #       ^: flow std.Int
  p.x = 1
  p.x = "a"
  # error: expected `std.Int`, found `"a"`
  #   --> m.dol:LL:LL
  #    |
  # LL |   p.x = "a"
  #    |         ^^^
  let s = p.peek()
  let _ = s
  #       ^: flow std.Str
  let n = p.norm
  let _ = n
  #       ^: flow std.Int
  p.label = "a"
  let _ = p.missing
  # error: `m.Point` has no member `missing`
  #   --> m.dol:LL:LL
  #    |
  # LL |   let _ = p.missing
  #    |           ^^^^^^^^^
  p.norm = 1
  # error: `norm` has no setter
  #   --> m.dol:LL:LL
  #    |
  # LL |   p.norm = 1
  #    |   ^^^^^^^^^^
  p.moved = 1
# error: `moved` is a method, which can't be assigned
#   --> m.dol:LL:LL
#    |
# LL |   p.moved = 1
#    |   ^^^^^^^^^^^

pub def methods p @ Point
  let q = p.moved 1
  let _ = q
  #       ^: flow m.Point
  p.moved "a"
  # error: expected `std.Int`, found `"a"`
  #   --> m.dol:LL:LL
  #    |
  # LL |   p.moved "a"
  #    |           ^^^
  let m = p.moved
  let _ = m
  #       ^: flow forall (std.Int) -> m.Point
  let o = Point.origin()
  let _ = o
  #       ^: flow m.Point
  let k = p.pick 1
  let _ = k
  #       ^: flow std.Int

pub def generic b @ Box[Int]
  let i = b.item
  let _ = i
  #       ^: flow std.Int
  let c = b.map do |y|
    let _ = y
    #       ^: flow std.Int
    "a"
  let _ = c
  #       ^: flow m.Box[std.Str]
  let e = b[0]
  let _ = e
  #       ^: flow std.Int
  b[0] = 1
  b[0] = "a"
  # error: expected `std.Int`, found `"a"`
  #   --> m.dol:LL:LL
  #    |
  # LL |   b[0] = "a"
  #    |          ^^^
  let d = (b + b)
  let _ = d
  #       ^: flow m.Box[std.Int]
  let l = (b > b)
  let _ = l
  #       ^: flow std.Bool
  let q = (b == 1)
  let _ = q
  #       ^: flow std.Bool

# A generic class's object has its members quantified over the class's binders,
# which a call infers from its arguments. A class-level method or property is
# bound to the object, which is every application of the class.
pub def generic_objects b @ Box[Int] items @ Array[Str] cls @ Type[Box[Int]]
  let c = Box.map $b do |y|
    let _ = y
    #       ^: flow std.Int
    "a"
  let _ = c
  #       ^: flow m.Box[std.Str]
  let m = Box.map
  let _ = m
  #       ^: flow forall (m.Box[#0.0], (#0.0) -> #0.1) -> m.Box[#0.1]
  let n = Box.make 1
  let _ = n
  #       ^: flow m.Box[std.Int]
  # Nothing determines the getter's binder
  let f = Box.first
  let _ = f
  #       ^: flow Unknown
  let i = Iterable.iter $items
  let _ = i
  #       ^: flow std.Iter[std.Str]
  # An applied type object's members are its class's, applied
  let a = cls.make 1
  let _ = a
  #       ^: flow m.Box[std.Int]
  let g = cls.first
  let _ = g
  #       ^: flow std.Int
  let d = Box.map $b do |y| y
  let _ = d
  #       ^: flow m.Box[std.Int]
  Box.map 1 do |y| y
# error: expected `m.Box[Unknown]`, found `1`
#   --> m.dol:LL:LL
#    |
# LL |   Box.map 1 do |y| y
#    |           ^

pub def reflected d @ Dir
  let a = (d / "x")
  let _ = a
  #       ^: flow m.Dir
  # `Str` has no `(div)`, so the right operand's `(rdiv)` is called
  let b = ("x" / d)
  let _ = b
  #       ^: flow m.Dir

pub def fallback g @ Bag
  let n = g.anything
  let _ = n
  #       ^: flow std.Int
  g.anything = 1
  g.anything = "a"
# error: expected `std.Int`, found `"a"`
#   --> m.dol:LL:LL
#    |
# LL |   g.anything = "a"
#    |                ^^^

pub def constructed()
  let p = Point 1
  let _ = p
  #       ^: flow m.Point
  Point "a"
  # error: expected `std.Int`, found `"a"`
  #   --> m.dol:LL:LL
  #    |
  # LL |   Point "a"
  #    |         ^^^
  let m = Made 1
  let _ = m
  #       ^: flow std.Str
  let o = Origin 1
  let _ = o
  #       ^: flow m.Origin
  let b = Box "a"
  let _ = b
  #       ^: flow m.Box[std.Str]
  let r = 1..3
  let _ = r
  #       ^: flow std.Range[std.Int]

pub def dynamic x
  let a = x.anything
  let _ = a
  #       ^: flow Unknown

# A literal key picks its own item, since the key isn't decayed. A key must be
# one of the schema's.
pub def looked d @ Dict[{a: Int, b: Str}] k @ Sym i @ Index[{a: Int}] o @ Dict[{...}]
  let a = d[:a:]
  let _ = a
  #       ^: flow std.Int
  let b = d[:b:]
  let _ = b
  #       ^: flow std.Str
  let _ = d[:c:]
  # error: this call selects by `:c:`, which isn't one of the schema's keys
  #   --> m.dol:LL:LL
  #    |
  # LL |   let _ = d[:c:]
  #    |           ^^^^^^
  let _ = d[k]
  # error: this call selects by `std.Sym`, which isn't one of the schema's keys
  #   --> m.dol:LL:LL
  #    |
  # LL |   let _ = d[k]
  #    |           ^^^^
  let j = i[:a:]
  let _ = j
  #       ^: flow std.Int
  # An open schema has every key
  let x = o[k]
  let _ = x
  #       ^: flow Value
  d[:a:] = 1

# Iterating a dict gives its entries, each key with its own value. A key the
# schema writes stays a literal, where one a term gives would decay.
pub def iterated d @ Dict[{a: Int, b: Str}] s @ Dict[{*(Str): Int}]
  for p = d
    let _ = p
    #       ^: flow std.Tuple[{:a:, std.Int}] | std.Tuple[{:b:, std.Str}]
  for k v = d
    let _ = k
    #       ^: flow :a: | :b:
    let _ = v
    #       ^: flow std.Int | std.Str
  let ks = s.keys()
  let _ = ks
  #       ^~: flow std.UnpackIter[std.Str]
  let vs = d.values()
  let _ = vs
  #       ^~: flow std.UnpackIter[std.Int | std.Str]
  # The keys are the schema's
  keyed $d.keys()
  keyed $s.keys()
# error: expected `std.Iter[:a: | :b:]`, found `std.UnpackIter[std.Str]`
#   --> m.dol:LL:LL
#    |
# LL |   keyed $s.keys()
#    |          ^^^^^^^^
#    |
#    = note: `std.Str` does not fit `:a: | :b:`

pub def keyed ks @ Iter[(:a: | :b:)]
  ...

# A collection keys a schema's positions by their indexes, so a key that may be
# one of them conflicts.
pub def promoted p @ Dict[{Int, Str}] v @ Dict[{Int, *Bool}] c @ Dict[{Int, 0: Str}]
  for k x = p
    let _ = k
    #       ^: flow 0 | 1
    let _ = x
    #       ^: flow std.Int | std.Str
  let pk = p.keys()
  let _ = pk
  #       ^~: flow std.UnpackIter[0 | 1]
  let vk = v.keys()
  let _ = vk
  #       ^~: flow std.UnpackIter[std.Int]
  indexes $c.keys()
# error: this call indexes a schema with a key that may be one of its positions' indexes
#   --> m.dol:LL:LL
#    |
# LL |   indexes $c.keys()
#    |   ^^^^^^^^^^^^^^^^^

pub def indexes ks @ Iter[Int]
  ...

# A key selects items, positions by their indexes. A read gives the join of what
# it selects, and a write must fit their meet.
pub def selected
  r @ Record[Int, a: Str]
  w @ Dict[{Int, *Str}]
  d @ Dict[{a: Int, b: Str}]
  s @ Dict[{*(Sym): Int}]
  p @ Dict[{Int, Str}]
  c @ Dict[{Int, 0: Str}]
  k @ (:a: | :b:)
  y @ Sym
do
  # A narrower record passes where a wider one is expected
  widened $r
  let _ = r[0]
  #   ^: flow std.Int
  let _ = r[:a:]
  #   ^: flow std.Str
  let _ = r[5]
  # error: this call selects by `5`, which isn't one of the schema's keys
  #   --> m.dol:LL:LL
  #    |
  # LL |   let _ = r[5]
  #    |           ^^^^
  let _ = r[y]
  # error: this call selects by `std.Sym`, which isn't one of the schema's keys
  #   --> m.dol:LL:LL
  #    |
  # LL |   let _ = r[y]
  #    |           ^^^^
  let _ = w[1]
  #   ^: flow std.Str
  let _ = d[k]
  #   ^: flow std.Int | std.Str
  d[:a:] = "x"
  # error: expected `std.Int`, found `"x"`
  #   --> m.dol:LL:LL
  #    |
  # LL |   d[:a:] = "x"
  #    |            ^^^
  d[:c:] = 1
  # error: this call selects by `:c:`, which isn't one of the schema's keys
  #   --> m.dol:LL:LL
  #    |
  # LL |   d[:c:] = 1
  #    |   ^^^^^^^^^^
  s[:c:] = 1
  p[0] = "x"
  # error: expected `std.Int`, found `"x"`
  #   --> m.dol:LL:LL
  #    |
  # LL |   p[0] = "x"
  #    |          ^^^
  p[1] = "x"
  d[k] = "x"
  # error: expected `Never`, found `"x"`
  #   --> m.dol:LL:LL
  #    |
  # LL |   d[k] = "x"
  #    |          ^^^
  let _ = c[0]
# error: this call indexes a schema with a key that may be one of its positions' indexes
#   --> m.dol:LL:LL
#    |
# LL |   let _ = c[0]
#    |           ^^^^

pub def widened r @ Record[Int, a: Value]
  ...

# A key of unknown type may be any of the dict's keys
pub def unknown_key d @ Dict[Sym, Str] k
  let _ = d.get $k

# A dict's methods that take a key select by it, as indexing does
pub def dict_methods d @ Dict[{a: Int, ?b: Str}] k @ (:a: | :b:)
  # A binder nothing determines takes its default: `get`'s `nil`, `pop`'s
  # `Never`
  let _ = d.get :a:
  #   ^: flow nil | std.Int
  let _ = d.get $k default: 0
  #   ^: flow std.Int | std.Str
  let _ = d.pop :b:
  #   ^: flow std.Str
  let _ = d.values :b:
  #   ^: flow std.UnpackIter[std.Str]
  let _ = d.values()
  #   ^: flow std.UnpackIter[std.Int | std.Str]
  d.insert :a: 1
  d.insert :a: "x"
# error: expected `std.Int`, found `"x"`
#   --> m.dol:LL:LL
#    |
# LL |   d.insert :a: "x"
#    |                ^^^

pub def tuple_get t @ Tuple[Int, Str]
  let _ = t.get 0
  #   ^: flow nil | std.Int | std.Str
