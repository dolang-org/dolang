# A dict or record literal holds back the items that take an expectation until
# its schema is known, then gives each what the schema expects of it

import std:
  - @BaseDict
  - @BaseRecord

pub def keyed _d @ Dict[{inner: Dict[{a: Str}]}]
  ...

pub def positional _d @ BaseRecord[name: Str, *BaseDict[{a: Str}]]
  ...

pub def text() -> Str
  "s"

pub def nested()
  keyed {inner: {a: "x"}}
  keyed {inner: {a: text()}}
  positional {name: "n", {a: "x"}, {a: "y"}}
  positional $
    name: n
    - a: x
  positional {name: "n", {a: 1}}
# error: expected `{a: std.Str}`, found `{a: 1}`
#   --> m.dol:LL:LL
#    |
# LL |   positional {name: "n", {a: 1}}
#    |                          ^^^^^^
#    |
#    = note: `1` does not fit `std.Str`

# A union expects several schemas of a dict. It takes the one its keys fit,
# along with the constants that tell members apart, and is checked against that
# one. What its other values are inferred to be doesn't choose.
pub @let Flag = BaseDict[{flag: Str, ?help: Str}]
pub @let Opt = BaseDict[{opt: Str, ?default: Int, ?help: Str}]
pub @let Cmd = BaseRecord ...$
  cmd: Str
  *(Item | Handler)
pub @let Item = (Flag | Opt | Cmd)
pub @let Handler = (Int -> Str)

pub def spec ...items @ Item
  ...

pub def handled ...items @ (Item | Handler)
  ...

pub def chosen()
  spec {flag: "v"} {opt: "n", default: 1}
  let f @ (Flag | Opt) = {opt: "n", help: "count"}
  let _ = f
  #       ^: flow std.Dict[{opt: std.Str, ?default: std.Int, ?help: std.Str}]
  spec
    - flag: verbose
      help: be chatty
    - cmd: deploy
      - opt: replicas
        default: 2
      - cmd: rollback
        - flag: force
      do |n|
        let _ = n
        #       ^: flow std.Int
        "deployed $n"
  handled
    - flag: list
    do |n| "$n"

pub def by_keys()
  spec {opt: "n", default: "two"}
# error: expected `{opt: std.Str, ?default: std.Int, ?help: std.Str}`, found `{opt: "n", default: "two"}`
#   --> m.dol:LL:LL
#    |
# LL |   spec {opt: "n", default: "two"}
#    |        ^^^^^^^^^^^^^^^^^^^^^^^^^^
#    |
#    = note: `"two"` does not fit `std.Int`

# Members with the same keys are told apart by a constant
pub @let Small = BaseDict[{kind: :SMALL:, size: Int}]
pub @let Named = BaseDict[{kind: :NAMED:, size: Str}]

pub def sized ...items @ (Small | Named)
  ...

pub def discriminated()
  sized {kind: :SMALL:, size: 1} {kind: :NAMED:, size: "big"}
  let s @ (Small | Named) = {kind: :NAMED:, size: "big"}
  let _ = s
  #       ^: flow std.Dict[{kind: :NAMED:, size: std.Str}]
  sized {kind: :SMALL:, size: "big"}
# error: expected `{kind: :SMALL:, size: std.Int}`, found `{kind: :SMALL:, size: "big"}`
#   --> m.dol:LL:LL
#    |
# LL |   sized {kind: :SMALL:, size: "big"}
#    |         ^^^^^^^^^^^^^^^^^^^^^^^^^^^^
#    |
#    = note: `"big"` does not fit `std.Int`

# Members told apart only by what a value's type would be aren't chosen between
pub @let Count = BaseDict[{x: Int}]
pub @let Label = BaseDict[{x: Str}]

pub def counted _item @ (Count | Label)
  ...

pub def by_value n @ Int
  counted {x: n}
