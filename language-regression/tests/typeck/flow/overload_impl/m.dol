# An overloaded function's body is checked against its implementation's
# signature, as one with a single signature is

@def double x@Int -> Int
@def double x@Str -> Str
pub def double x @ (Int | Str) -> (Int | Str)
  let y = x
  #   ^: flow std.Int | std.Str
  let _ @ Bool = x
  # error: `std.Int | std.Str` does not fit the annotation `std.Bool`
  #   --> m.dol:LL:LL
  #    |
  # LL |   let _ @ Bool = x
  #    |                  ^
  y

@def first[T] xs@Array[T] -> T
@def first[T] xs@Tuple[T, ...T] -> T
pub def first[T] xs @ (Array[T] | Tuple[T, ...T]) -> T
  let y = xs
  #   ^: flow (m.first.#0, *m.first.#0) | [m.first.#0]
  y[0]

pub class Picker
  @def pick self x@Int -> Int
  @def pick self x@Str -> Str
  pub def pick _self x @ (Int | Str) -> (Int | Str)
    let y = x
    #   ^: flow std.Int | std.Str
    y
