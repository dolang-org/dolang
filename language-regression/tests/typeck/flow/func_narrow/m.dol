# A test against `Func` keeps each function and each class that reaches `Func`.
# `Func` is disjoint, so a disjoint class that doesn't reach it is dropped. A
# mixable class becomes the gradual function type, since a subclass of it may
# reach `Func`.

pub class Adder: Func
  pub def (call) _self n @ Int -> Str
    ...

pub class Plain

#[mixable]
pub class Mixin

pub def kept f @ ((Int -> Str) | Adder | Type[Plain])
  if type(f, Func)
    let _ = f
    #       ^: flow ((std.Int, <m.kept.#0, >m.kept.#1) -> std.Str) | m.Adder | std.Type[m.Plain]

pub def dropped v @ (Plain | Adder)
  if type(v, Func)
    let _ = v
    #       ^: flow m.Adder

pub def widened v @ (Mixin | Adder)
  if type(v, Func)
    let _ = v
    #       ^: flow ((...Unknown{}) -> Unknown) | m.Adder

pub def negated v @ (Plain | (Int -> Str))
  if !(type(v, Func))
    let _ = v
    #       ^: flow m.Plain
