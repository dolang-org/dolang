# A call through an overloaded function takes the one overload its arguments
# don't contradict. None is an error with a note for each overload, and several
# are too, unless the arguments are partly dynamic: then the call is.

import std:
  - @Fmt
  - @Index
  - @Seq
import lib:
  - double

pub class Picker
  @def pick self x @ Int -> Int
  @def pick self x @ Str -> Str
  pub def pick _self x
    x

  @def each self n @ Int f @ (Int -> Str) -> Str
  @def each self s @ Str f @ (Str -> Int) -> Int
  pub def each _self x _f
    x

  @def tag self n @ Int xs @ Array[(:a: | :b:)] -> Int
  @def tag self s @ Str xs @ Array[Str] -> Str
  pub def tag _self x _xs
    x

  @def lone self n @ Int -> Int
  pub def lone _self x
    x

pub def indexed
  a @ Array[Int]
  t @ Tuple[Int, Str]
  r @ Tuple[...Str]
  i @ Int
  b @ BinBuf
  f @ Fmt[Int, {}]
do
  let _ = a[0]
  #   ^: flow std.Int
  let _ = a[1..3]
  #   ^: flow [std.Int]
  let _ = r[i]
  #   ^: flow std.Str
  # An `Int` may be any position, and a literal must be one
  let _ = t[i]
  #   ^: flow std.Int | std.Str
  let _ = t[0]
  #   ^: flow std.Int
  let _ = t[2]
  # error: no overload of `(index)` accepts these arguments
  #   --> m.dol:LL:LL
  #    |
  # LL |   let _ = t[2]
  #    |           ^^^^
  #    |
  #    = note: `@[K] ((std.Int, std.Str), K) -> std.IndexItem[{std.Int, std.Str}, K]`: this call selects by `2`, which isn't one of the schema's keys
  #    = note: `((std.Int, std.Str), std.Range[std.Int]) -> (*std.Int | std.Str)`: expected `std.Range[std.Int]`, found `2`
  let _ = b[0]
  #   ^: flow std.Int
  b[0] = 1
  # Nor does any overload take this
  b[0] = "x"
  # error: no overload of `(assign)` accepts these arguments
  #   --> m.dol:LL:LL
  #    |
  # LL |   b[0] = "x"
  #    |   ^^^^^^^^^^
  #    |
  #    = note: `@[K] (std.BinBuf, K, std.AssignItem[{*std.Int}, K]) -> nil`: expected `std.Int`, found `"x"`
  #    = note: `(std.BinBuf, std.Range[std.Int], std.Bin) -> nil`: expected `std.Bin`, found `"x"`; expected `std.Range[std.Int]`, found `0`
  let _ = f[0]
  #   ^: flow std.FmtSegment[std.Int]

pub def chosen p @ Picker x u @ (Int | Str)
  let _ = p.pick 1
  #   ^: flow std.Int
  let _ = p.pick "s"
  #   ^: flow std.Str
  # A dynamic argument leaves both overloads, and a union argument neither
  let _ = p.pick $x
  #   ^: flow Unknown
  let _ = p.pick $u
  #   ^: flow Unknown
  # error: no overload of `pick` accepts these arguments
  #   --> m.dol:LL:LL
  #    |
  # LL |   let _ = p.pick $u
  #    |           ^^^^^^^^^
  #    |
  #    = note: `(m.Picker, std.Int) -> std.Int`: expected `std.Int`, found `std.Int | std.Str`
  #    = note: `(m.Picker, std.Str) -> std.Str`: expected `std.Str`, found `std.Int | std.Str`
  let _s @ Str = p.pick 1
  # error: `std.Int` does not fit the annotation `std.Str`
  #   --> m.dol:LL:LL
  #    |
  # LL |   let _s @ Str = p.pick 1
  #    |                  ^^^^^^^^

  # A block and a collection are expected to be what the chosen overload takes
  let _ = p.each 1 do |v|
    let _ = v
    #       ^: flow std.Int
    "a"
  let _ = p.tag 1 [:a:]
  #   ^: flow std.Int
  # A block's result doesn't choose, but is checked against what's chosen
  let _ = p.each 1 do |v| v
  #   ^: flow std.Str
# error: expected `(std.Int) -> std.Str`, found `(std.Int) -> std.Int`
#   --> m.dol:LL:LL
#    |
# LL |   let _ = p.each 1 do |v| v
#    |                    ^^^^^^^^
#    |
#    = note: `std.Int` does not fit `std.Str`

# A lone overload is always chosen, so its arguments are checked as any call's
pub def lone p @ Picker
  let _ = p.lone 1
  #   ^: flow std.Int
  let _ = p.lone "s"
# error: expected `std.Int`, found `"s"`
#   --> m.dol:LL:LL
#    |
# LL |   let _ = p.lone "s"
#    |                  ^^^

@def twice x @ Int -> Int
@def twice x @ Str -> Str
pub def twice x
  x

pub def apply f @ (Int -> Int) -> Int
  ...

pub def negate f @ (Bool -> Bool) -> Bool
  ...

@def vague x @ Int -> Int
@def vague x @ (Int | Str) -> Str
pub def vague x
  x

# An overloaded def's value is the def, which a call through it, however it's
# reached, chooses an overload of, as does a function type it's passed as.
# Anything else relates it as its implementation.
pub def functions()
  let _ = twice 1
  #   ^: flow std.Int
  let _ = twice "s"
  #   ^: flow std.Str
  let t = twice
  let _ = t
  #   ^: flow m.twice
  let _ = t 1
  #   ^: flow std.Int
  let _ = double "s"
  #   ^: flow std.Str
  let _ = apply $twice
  #   ^: flow std.Int
  negate $twice
  # error: expected `(std.Bool) -> std.Bool`, found `m.twice`
  #   --> m.dol:LL:LL
  #    |
  # LL |   negate $twice
  #    |           ^^^^^
  twice 1.5
  # error: no overload of `m.twice` accepts these arguments
  #   --> m.dol:LL:LL
  #    |
  # LL |   twice 1.5
  #    |   ^^^^^^^^^
  #    |
  #    = note: `(std.Int) -> std.Int`: expected `std.Int`, found `std.Float`
  #    = note: `(std.Str) -> std.Str`: expected `std.Str`, found `std.Float`

  # Overloads that both take a call make it ambiguous
  let _ = vague 1
  #   ^: flow Unknown
# error: several overloads of `m.vague` accept these arguments
#   --> m.dol:LL:LL
#    |
# LL |   let _ = vague 1
#    |           ^^^^^^^
#    |
#    = note: `(std.Int) -> std.Int` accepts them
#    = note: `(std.Int | std.Str) -> std.Str` accepts them

# A call of a union of overloaded functions is a call of each
pub def alternatives c @ Bool
  let f = if c
    twice
  else
    double
  let _ = f 1
  #   ^: flow std.Int

# A class's overloaded `(init)` and class-level `(call)` are chosen among too
pub class Shape
  @def (init) self n @ Int
  @def (init) self s @ Str
  def (init) self _x
    ...

pub class Maker
  #[class]
  @def (call) cls n @ Int -> Int
  #[class]
  @def (call) cls s @ Str -> Str
  #[class]
  pub def (call) _cls x
    x

pub def constructed()
  let _ = Shape 1
  #   ^: flow m.Shape
  Shape true
  # error: no overload of `(init)` accepts these arguments
  #   --> m.dol:LL:LL
  #    |
  # LL |   Shape true
  #    |   ^^^^^^^^^^
  #    |
  #    = note: `(std.Int) -> m.Shape`: expected `std.Int`, found `true`
  #    = note: `(std.Str) -> m.Shape`: expected `std.Str`, found `true`
  let _ = Maker "s"
  #   ^: flow std.Str
  Maker true
# error: no overload of `(call)` accepts these arguments
#   --> m.dol:LL:LL
#    |
# LL |   Maker true
#    |   ^^^^^^^^^^
#    |
#    = note: `(Unknown, std.Int) -> std.Int`: expected `std.Int`, found `true`
#    = note: `(Unknown, std.Str) -> std.Str`: expected `std.Str`, found `true`

# A protocol's overloads are chosen among as a class's are
pub def sequenced s @ Seq[Int]
  let _ = s[0]
  #   ^: flow std.Int
  let _ = s[1..3]
  #   ^: flow std.Seq[std.Int]

pub def indexes _i @ Index[{Int, Str}]
  ...

pub def sequences _s @ Seq[(Int | Str)]
  ...

# A tuple is an index of its own items, and a sequence of their union
pub def tuples t @ Tuple[Int, Str]
  indexes $t
  sequences $t
