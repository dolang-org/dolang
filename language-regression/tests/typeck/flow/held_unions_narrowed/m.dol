# A handler in a record held back for a union of dict and record schemas widens
# the binder that the arguments not held back raise

import std:
  - @BaseDict
  - @BaseRecord

pub @let Flag = BaseDict[{flag: Str}]
pub @let Cmd[R] = BaseRecord[cmd: Str, ...(Item[R] | (Int -> R))]
pub @let Item[R] = (Flag | Cmd[R])

pub def spec[R] *items @ (Item[R] | (Int -> R)) -> R
  ...

pub def narrowed()
  let r = spec
    - cmd: c
      do |n| n
    do |n| "top $n"
  let _ = r
  #       ^: flow std.Int | std.Str
