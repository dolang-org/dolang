# A call types the `do` blocks it's given: each parameter written without an
# annotation takes what the callee passes it, and the block's result joins into
# the call's. A block a type is expected of, as by an annotation or a cast, is
# typed the same way. Elsewhere a block's parameters are dynamic.

pub def map[T, U] xs @ Array[T] f @ ((T) -> U) -> Array[U]
  ...

pub def apply[T] x @ T f @ ((T) -> nil) -> nil
  ...

pub def keyed :each @ ((Str) -> nil) -> nil
  ...

pub def fold[T] init @ T f @ ((T, T) -> T) -> T
  ...

pub def mapped()
  let ys = map [1, 2] do |x| [x]
  #                       ^: flow std.Int
  let _ = ys
  #       ^~: flow [[std.Int]]

pub def applied()
  apply 1 do |y|
    let _ = y
    #       ^: flow std.Int
    nil
  keyed each: do |s|
    let _ = s
    #       ^: flow std.Str
    nil

# A block's result, while unknown, doesn't hold up what the call passes it
pub def folded()
  let total = fold 0 do |a _b| a
  #                      ^: flow std.Int
  let _ = total
  #       ^~~~~: flow std.Int

pub def bound()
  let f = do |_x| 1
  #           ^~: flow Unknown
  let r = f 2
  let _ = r
  #       ^: flow std.Int

pub def annotated()
  let f @ ((Int) -> Int) = do |y| y
  #                            ^: flow std.Int
  let _ = f
  #       ^: flow (std.Int, <Value, >Value) -> std.Int

# A block's result is known once the block is analyzed, however the blocks that
# give it depend on each other
pub def mutual()
  let a = do 1
  let b = do a()
  let c = b()
  let _ = c
  #       ^: flow std.Int
  let f = do |n @ Int| n
  let g = do |n @ Int| f $n
  f = do |n @ Int| g $n
  let h = g 1
  let _ = h
  #       ^: flow std.Int

# A block reads a captured variable as every value assigned to it
pub def captured()
  let v = 1
  let read = do v
  v = "a"
  let w = read()
  let _ = w
  #       ^: flow std.Int | std.Str

# A variable a block assigns is volatile: its owner reads it as every value
# assigned to it too, and a test doesn't narrow it. A copy of it narrows.
pub def volatile()
  let v = nil
  let set = do v = "a"
  if v
    let _ = v
    #       ^: flow std.Nil | std.Str
  let c = v
  if c
    let _ = c
    #       ^: flow std.Str
  set()

# A variable only its owner assigns stays narrowed across a call, even once a
# block captures it
pub def cached v @ (Str | nil)
  let read = do v
  if v
    read()
    let _ = v
    #       ^: flow std.Str
  v = nil

# A block sees what a variable it captures holds when the block is created, and
# every value assigned to it after
pub def narrowed v @ (Str | nil)
  if !v
    throw "none"
  let read = do
    let _ = v
    #       ^: flow std.Str
    nil
  read()

pub def narrowed_after v @ (Str | nil)
  let read = do
    let _ = v
    #       ^: flow nil | std.Str
    nil
  if v
    read()

pub def looped()
  let v = 1
  while true
    let read = do
      let _ = v
      #       ^: flow std.Int | std.Str
      nil
    read()
    v = "a"

pub def handled()
  let v = 1
  try
    apply 1 do |_x|
      let _ = v
      #       ^: flow std.Int | std.Str
      nil
  catch _
    v = "a"

# A parameter's sentinel default is seen until it's narrowed away
pub def sentinel v @ Str = nil
  let read = do
    let _ = v
    #       ^: flow nil | std.Str
    nil
  if !v
    v = "d"
  read()

pub def sentinel_after v @ Str = nil
  if !v
    v = "d"
  let read = do
    let _ = v
    #       ^: flow std.Str
    nil
  read()

# A def sees itself
pub def recursive n @ Int
  def count m @ Int -> Int
    let r = count (m - 1)
    let _ = r
    #       ^: flow std.Int
    r
  count $n

# A module's variables escape through its defs the same way
let shared = nil
shared = "a"
let later = 1

pub def reads()
  let _ = shared
  #       ^~~~~~: flow std.Str
  let _ = later
  #       ^~~~~: flow std.Int | std.Str

later = "a"

# A block's omitted channels are inferred like its parameters. Here the call
# gives it the def's own, so it can call the callback its def is given.
pub def around[R] block @ (() -> R) -> R
  apply 1 do |_x|
    block()
    nil
  block()

pub def drop _x -> nil
  ...

pub def each[T] xs @ Array[T] fs @ Array[(T) -> nil] -> nil
  ...

pub def every[T] x @ T fs @ Array[(T) -> nil] -> nil
  ...

pub def table[T] xs @ Array[T] d @ Dict[{f: (T) -> nil}] -> nil
  ...

pub def made[T] f @ ((T) -> nil) -> Array[T]
  ...

pub def both[T] xs @ Array[T] ys @ Array[T] -> nil
  ...

pub def twice[T] x @ T fs @ Array[(T) -> T] -> T
  ...

# An argument that takes an expectation its generic callee's parameter gives only
# once the call is solved waits for the call's pre-solve. A binder the argument
# can't raise, as when it occurs only in a callback's parameters, takes what the
# other arguments give it.
pub def held ints @ Array[Int] strs @ Array[Str]
  each $ints [(do |y| drop y)]
  #                        ^: flow std.Int
  every 1 [(do |y| drop y)]
  #                     ^: flow std.Int
  table $strs {f: (do |y| drop y)}
  #                            ^: flow std.Str
  both $strs $made(do |y| drop y)
  #                            ^: flow std.Str
  # A callback's result can raise its binder, so the call gives no expectation
  let _ = twice 1 [(do |y| y)]
  #                        ^: flow Unknown

# A rest parameter binds a tuple of its items
pub def rested *xs @ Str
  let _ = xs
  #       ^~: flow (*std.Str)

# A `return` in a block returns from its def
pub def early xs @ Array[Int] -> Int
  map $xs do |x|
    return x
  0

pub def wrong xs @ Array[Int] -> Int
  map $xs do |_x|
    return "a"
  # error: `"a"` does not fit the declared result `std.Int`
  #   --> m.dol:LL:LL
  #    |
  # LL |     return "a"
  #    |            ^^^
  0

# A block that never completes gives the binder its result decides `Never`
pub def called[R] f @ (() -> R) -> R
  ...

pub def never c x @ Int
  let y = if c
    called do
      return x
  else
    "s"
  let _ = y
  #       ^: flow std.Str
