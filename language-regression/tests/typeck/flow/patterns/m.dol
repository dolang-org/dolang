# A pattern is walked against the schema `S` of the `Unpack[S]` its value
# reaches: each item takes the join of what it can bind, and a rest is the
# `Rest` its class claims for what the pattern leaves, which by default only
# spreads.

import std:
  - @Unpack

pub def tuple_rest()
  let a ...r = (1, "a", true)
  let _ = a
  #       ^: flow std.Int
  let _ = r
  #       ^: flow std.Unpack[{std.Str, std.Bool}]
  let xs = [...r]
  let _ = xs
  #       ^~: flow [std.Bool | std.Str]

pub def array_rest xs @ Array[Int]
  let a ...r = xs
  let _ = a
  #       ^: flow std.Int
  let _ = r
  #       ^: flow std.UnpackIter[std.Int]

pub def quantified source @ Unpack[{Int, ?Str, *Bool}]
  let a b = source
  let _ = a
  #       ^: flow std.Int
  let _ = b
  #       ^: flow std.Bool | std.Str
  let _ ...r = source
  let _ = r
  #       ^: flow std.Spread[{?std.Str, *std.Bool}]
  let _ _ ...t = source
  let _ = t
  #       ^: flow std.Spread[std.Bool]

pub def keyed()
  let :a ...r = (a: 1, b: "x")
  let _ = a
  #       ^: flow std.Int
  let _ = r
  #       ^: flow std.Unpack[{b: std.Str}]
  let :b *p **k = (1, b: "x", c: true)
  let _ = b
  #       ^: flow std.Str
  let _ = p
  #       ^: flow std.Unpack[{std.Int}]
  let _ = k
  #       ^: flow std.Unpack[{c: std.Bool}]

pub def const_keys d @ Dict[Str, Int]
  let "name": name = d
  let _ = name
  #       ^~~~: flow std.Int

pub def defaults xs @ Array[Int]
  bind xs
    a = "none"
    :b = nil
  let _ = a
  #       ^: flow std.Int | std.Str
  let _ = b
  #       ^: flow std.Nil

pub def unions c @ Bool
  let v = if c
    (1, "a")
  else
    (true,)
  let x ...r = v
  let _ = x
  #       ^: flow std.Bool | std.Int
  let _ = r
  #       ^: flow std.Unpack[{std.Str}] | std.Unpack[{}]

# An iterator's rest is an iterator of the same kind, and so is that rest's
pub def iterators s @ Str
  let _ ...r = s.split "="
  let _ = r
  #       ^: flow std.UnpackIter[std.Str]
  let _ ...again = r
  let _ = again
  #       ^~~~~: flow std.UnpackIter[std.Str]

pub def dict_rest d @ Dict[Str, Int]
  let "a": _a ...r = d
  let _ = r
  #       ^: flow std.Unpack[std.Str, std.Int]

pub def dynamic v
  let a ...r = v
  let _ = a
  #       ^: flow Unknown
  let _ = r
  #       ^: flow Unknown

# A rest is the `Rest` of the edge to `Unpack`, solved again from the tail
pub @class Rows[T]: Unpack[T, Rest: Rows[T]]
  pub def first self -> T

pub def rows r @ Rows[Int]
  let _ ...rest = r
  let _ = rest
  #       ^~~~: flow m.Rows[std.Int]

# A `Rest` the tail can't solve again falls back to the default
pub @class Pairs[A, B]: Unpack[{A, B}, Rest: Pairs[A, B]]
  pub def first self -> A

pub def pairs p @ Pairs[Int, Str]
  let _ ...rest = p
  let _ = rest
  #       ^~~~: flow std.Spread[{std.Str}]

pub def possible s @ Str
  let a _b = [4]
  let _ = a
  #       ^: flow std.Int
  let _k v = s.split "="
  let _ = v
  #       ^: flow std.Str

pub def impossible()
  if let _x _y = 4
    # error: `4` is not unpackable
    #   --> m.dol:LL:LL
    #    |
    # LL |   if let _x _y = 4
    #    |                  ^
    nil
  if let _foo _bar = (4,)
    # error: `(4,)` can never unpack as this pattern
    #   --> m.dol:LL:LL
    #    |
    # LL |   if let _foo _bar = (4,)
    #    |                      ^^^^
    nil
  let _a _b = (4,)
# error: `(4,)` can never unpack as this pattern
#   --> m.dol:LL:LL
#    |
# LL |   let _a _b = (4,)
#    |               ^^^^
