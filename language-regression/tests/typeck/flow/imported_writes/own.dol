# A module's def is declared with its value's type, which importers read, so
# reassigning one is checked against it. A class's binding cannot be reassigned.

pub def twice x @ Int -> Int
  (x * 2)

twice = (do |x @ Int| -> Int x)
twice = (do |x @ Str| -> Str x)
# error: `(std.Str) -> std.Str` does not fit the annotation `(std.Int) -> std.Int`
#   --> own.dol:LL:LL
#    |
# LL | twice = (do |x @ Str| -> Str x)
#    |          ^^^^^^^^^^^^^^^^^^^^^
twice = "nope"
# error: `"nope"` does not fit the annotation `(std.Int) -> std.Int`
#   --> own.dol:LL:LL
#    |
# LL | twice = "nope"
#    |         ^^^^^^
twice = nil
# error: `nil` does not fit the annotation `(std.Int) -> std.Int`
#   --> own.dol:LL:LL
#    |
# LL | twice = nil
#    |         ^^^

pub def rebind()
  twice = (do |x @ Str| -> Str x)
# error: `(std.Str) -> std.Str` does not fit the annotation `(std.Int) -> std.Int`
#   --> own.dol:LL:LL
#    |
# LL |   twice = (do |x @ Str| -> Str x)
#    |            ^^^^^^^^^^^^^^^^^^^^^

# An importer may write an exported variable, so the module reads it as what
# fits its annotation, or as dynamic without one
pub let loose = 2
pub let count @ (Int | nil) = 1

pub def read()
  let a = loose
  #   ^: flow Unknown
  let b = count
  #   ^: flow nil | std.Int
  [a, b]
