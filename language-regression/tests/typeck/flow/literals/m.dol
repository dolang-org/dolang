# A literal term's type decays to its class where a variable or collection holds
# it. A literal written in a type is exact, and never decays.

def plain x @ (:a: | :b:)
  ...

# A function keeps the literals of its signature, however it's reached
pub def called y @ Sym
  plain :a:
  plain :c:
  # error: expected `:a: | :b:`, found `:c:`
  #   --> m.dol:LL:LL
  #    |
  # LL |   plain :c:
  #    |         ^^^
  plain $y
  # error: expected `:a: | :b:`, found `std.Sym`
  #   --> m.dol:LL:LL
  #    |
  # LL |   plain $y
  #    |          ^
  let f = plain
  f :c:
# error: expected `:a: | :b:`, found `:c:`
#   --> m.dol:LL:LL
#    |
# LL |   f :c:
#    |     ^^^

pub def held p @ :a:
  let x = 1
  let _ = x
  #       ^: flow std.Int
  let y = p
  let _ = y
  #       ^: flow :a:
  let terms = [1, 2]
  let _ = terms
  #       ^~~~~: flow [std.Int]
  let written = [p]
  let _ = written
  #       ^~~~~~~: flow [:a:]
  let d = {a: 1}
  let _ = d
  #       ^: flow std.Dict[std.Sym, std.Int]

# A dict's positional items stay positional; only a written key is a key
pub def dicts t @ (Int, Str)
  let mixed = {1, foo: false, 2, bar: nil}
  let _ = mixed
  #       ^~~~~: flow {*std.Int, **std.Bool | std.Nil}
  let positional = {1, 2}
  let _ = positional
  #       ^~~~~~~~~~: flow std.Dict[std.Int]
  let keyed = {0: "a", 1: "b"}
  let _ = keyed
  #       ^~~~~: flow std.Dict[std.Int, std.Str]
  let spread = {...t, a: 1}
  let _ = spread
  #       ^~~~~~: flow {*std.Int | std.Str, **std.Int}
  bind {1, foo: false, 2, bar: nil}
    a b
    :foo :bar
  let _ = (a, b)
  #        ^: flow std.Int
  let _ = (foo, bar)
  #             ^~~: flow std.Bool | std.Nil
  let spread_only = {...t}
  let _ = spread_only
  #       ^~~~~~~~~~~: flow std.Dict[std.Int | std.Str]
