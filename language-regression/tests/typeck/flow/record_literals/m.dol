# A literal with positional items is a record. Without an expectation, it takes
# a positional lane and a keyed lane; with one, the schema it's expected to have.

pub def inferred()
  let r = {1, a: "x", 2}
  let _ = r
  #       ^: flow std.Record[{*std.Int, **std.Str}]

pub def takes r @ Record[{Str, *Int, ?tag: Str}]
  let _ = r

pub def reads r @ BaseRecord[{*(Int | Str)}]
  let _ = r

pub def wants_dict d @ Dict[{*Int}]
  let _ = d

pub def expected xs @ Array[Int]
  takes {"a", 1, 2, tag: "t"}
  takes $
    - a
    for x = xs
      - $x
    tag: t
  reads {1, "b"}
  takes {1}
  # error: expected `{std.Str, *std.Int, ?tag: std.Str}`, found `{1}`
  #   --> m.dol:LL:LL
  #    |
  # LL |   takes {1}
  #    |         ^^^
  #    |
  #    = note: `1` does not fit `std.Str`
  wants_dict {1}
# error: expected `std.Dict[std.Int]`, found `std.Record[std.Int]`
#   --> m.dol:LL:LL
#    |
# LL |   wants_dict {1}
#    |              ^^^
