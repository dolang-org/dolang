# A dict literal held back for a union of dict schemas that mentions the call's
# binder takes its schema open in the binder, which handlers nested in it raise
# with the others

import std:
  - @BaseDict

pub @let Flag = BaseDict[{flag: Str}]
pub @let Cmd[R] = BaseDict[{cmd: Str, *(Item[R] | (Int -> R))}]
pub @let Item[R] = (Flag | Cmd[R])

pub def spec[R] *items @ (Item[R] | (Int -> R)) -> R
  ...

pub def flagged()
  spec {flag: "x"}

pub def handled()
  let r = spec
    - flag: x
    - cmd: c
      - flag: y
      do |n| "nested $n"
    do |n| "top $n"
  let _ = r
  #       ^: flow std.Str

# A nested handler alone solves it
pub def nested()
  let r = spec
    - cmd: c
      do |n| "nested $n"
  let _ = r
  #       ^: flow std.Str
