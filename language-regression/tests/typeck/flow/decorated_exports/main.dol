# An importer reads what each export's decorators settled to, whether it checks
# the module from source or reads its typelib: a decorated def, one under a
# decorator factory with a constant argument, a decorated class, a decorator
# reached through a dotted path, a decorated export as another's decorator, a
# private helper as a public export's decorator, and an overloaded def. Exports
# whose decorators reach each other are unknown.

import m
import b

let a1 = m.a(1)
#   ^~: flow std.Int
let b1 = m.b(1)
#   ^~: flow std.Str
let c1 = m.C()
#   ^~: flow m.C
let d1 = m.d("d")
#   ^~: flow std.Str
let e1 = m.e(1)
#   ^~: flow std.Int
let f1 = m.f(1)
#   ^~: flow std.Int
let g1 = m.g(1)
#   ^~: flow std.Str
let m1 = m.M
#   ^~: flow <type m.M>
let h1 = m.h(1)
#   ^~: flow std.Int
let over1 = m.over(1)
#   ^~~~~: flow std.Int
let over2 = m.over("s")
#   ^~~~~: flow std.Str
let broken1 = m.broken
#   ^~~~~~~: flow Unknown
let cycle1 = b.g
#   ^~~~~~: flow Unknown
[a1, b1, c1, d1, e1, f1, g1, m1, h1, over1, over2, broken1, cycle1]
