# dolang: strict
# A schema alias as a collection's schema argument projects as the schema it
# stands for, whether it's declared before or after its use, and through the
# aliases it includes

pub @let Fields = {size: Int, total: (Int | nil)}

pub def struct_items x @ Struct[Fields]
  let _ = x[:size:]
  #   ^: flow std.Int
  let _ = x.total
  #   ^: flow nil | std.Int
  x.size = 3
  x.size = "x"
  # error: expected `std.Int`, found `"x"`
  #   --> m.dol:LL:LL
  #    |
  # LL |   x.size = "x"
  #    |            ^^^

pub def dict_items x @ Dict[Fields]
  let _ = x[:size:]
  #   ^: flow std.Int

pub def record_items x @ Record[...Fields]
  let _ = x[:total:]
  #   ^: flow nil | std.Int

pub def missing x @ Struct[Fields]
  let _ = x.missing
  # error: `std.Struct[m.Fields]` has no member `missing`
  #   --> m.dol:LL:LL
  #    |
  # LL |   let _ = x.missing
  #    |           ^^^^^^^^^
  #    |
  #    = note: `(get)`: expected `std.Keys[...m.Fields]`, found `:missing:`
  #    = note: `:missing:` does not fit `std.Keys[...m.Fields]`

pub def subclass x @ Sized
  let _ = x.size
  #   ^: flow std.Int

pub class Sized: Struct[Later]
  pub def (init) self
    Struct.(init) $self (size: 1)

pub @let Later = $
  size: Int

pub @let Base = {a: Int}
pub @let Left = {...Base, b: Str}
pub @let Both = {...Base, ...Left}

pub def included x @ Struct[Both]
  let _ = x[:a:]
  #   ^: flow std.Int
  let _ = x[:b:]
  #   ^: flow std.Str

pub @let Steps = $
  ?tag: Str
  ?count: Int

# A rest's entries, keys and values are those of the schema it stands for, as
# member uses and expectations see them
pub def rest_entries **steps @ Steps
  for entry = steps
    let _ = entry.len
    let _ @ ((:count:, Int) | (:tag:, Str)) = entry
  for key value = steps
    let _ = key.(str)()
    let _ @ (:count: | :tag:) = key
    let _ = value.(str)()
    let _ @ (Int | Str) = value
    let _ @ Str = value
# error: `std.Int | std.Str` does not fit the annotation `std.Str`
#   --> m.dol:LL:LL
#    |
# LL |     let _ @ Str = value
#    |                   ^^^^^
