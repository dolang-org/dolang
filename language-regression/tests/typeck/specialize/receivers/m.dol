# An overload whose receiver is annotated is specialized: the arguments its
# receiver reaches the class with replace the class's binders throughout its
# signature. An implementation's receiver may not specialize its class.

pub class Num
pub class Int: Num

pub class Array[T]
  pub def first _self -> T
    ...

pub class Box[T]
  pub def get _self -> T
    #     ^~~: decl (m.Box[T], <in, >out) -> T
    ...

  @def int _self @ Box[Int] -> T
  #    ^~~: decl (m.Box[m.Int], <in, >out) -> m.Int
  #    ^~~: quantifier ^T covariant, in contravariant, out contravariant
  pub def int _self -> T
    nil

  @def nested[U] _self @ Box[Array[U]] -> T
  #    ^~~~~~: decl (m.Box[m.Array[U]], <in, >out) -> m.Array[U]
  pub def nested _self -> T
    nil

  # Through the bound of a binder
  @def bounded[N @ Box[Int]] _self @ N -> T
  #    ^~~~~~~: decl (N, <in, >out) -> m.Int
  pub def bounded _self -> T
    nil

  # An implementation's receiver may be annotated with the class's own binders.
  pub def same _self @ Box[T] -> T
    #     ^~~~: decl (m.Box[T], <in, >out) -> T
    ...

  # An implementation that specializes keeps the unspecialized signature.
  pub def special _self @ Box[Int] -> T
    #     ^~~~~~~: decl (m.Box[m.Int], <in, >out) -> T
    # error: only an `@def` overload may specialize `self` to a `Box`
    #   --> m.dol:LL:LL
    #    |
    # LL |   pub def special _self @ Box[Int] -> T
    #    |                           ^^^^^^^^
    ...

  # A receiver that doesn't reach its class keeps the unspecialized signature.
  pub def wrong _self @ Int -> T
    #     ^~~~~: decl (m.Int, <in, >out) -> T
    # error: `self` must be a `Box` or a subtype of it
    #   --> m.dol:LL:LL
    #    |
    # LL |   pub def wrong _self @ Int -> T
    #    |                         ^^^
    ...

  @def wrong_overload _self @ Int -> T
  # error: `self` must be a `Box` or a subtype of it
  #   --> m.dol:LL:LL
  #    |
  # LL |   @def wrong_overload _self @ Int -> T
  #    |                               ^^^
  pub def wrong_overload _self -> T
    ...

# A class without binders has nothing to specialize, so an implementation's
# receiver may be a bound binder.
pub class Real: Num
  pub def abs[N @ Real] _self @ N -> N
    #     ^~~: decl (N, <in, >out) -> N
    ...
