# A method is called with its overloads, or its implementation's signature if
# it has none, so an override or a protocol's member is compared by those: each
# required signature must be below one provided signature. An implementation
# behind overloads isn't what callers see, so it never meets a requirement.

pub class Num
pub class Int: Num
pub class Other

pub class Base
  @def pick _self x @ Int -> Int
  @def pick _self x @ Num -> Num
  pub def pick _self x @ Num -> Num
    ...

# Each of `Base.pick`'s overloads is covered by one of these
pub class Covered: Base
  @def pick _self x @ Int -> Int
  @def pick _self x @ Num -> Num
  @def pick _self x @ Other -> Other
  pub def pick _self x @ (Num | Other) -> (Num | Other)
    ...

# Order doesn't matter: each overload is covered by whichever one fits
pub class Reordered: Base
  @def pick _self x @ Num -> Num
  @def pick _self x @ Int -> Int
  pub def pick _self x @ Num -> Num
    ...

# Neither of `Base.pick`'s overloads is covered, whatever the implementation
pub class Same: Base
  @def pick _self x @ Other -> Other
  pub def pick _self x @ Num -> Num
    # error: `pick` does not match `Base.pick`
    #   --> m.dol:LL:LL
    #    |
    # LL |   @def pick _self x @ Int -> Int
    #    |                       ---    --- as overload 1 of `Base.pick` declares it
    #    |                       |
    #    |                       as overload 1 of `Base.pick` declares it
    # LL |   @def pick _self x @ Num -> Num
    #    |                       ---    --- as overload 2 of `Base.pick` declares it
    #    |                       |
    #    |                       as overload 2 of `Base.pick` declares it
    # ...
    # LL |   @def pick _self x @ Other -> Other
    #    |                       -----    -----
    #    |                       |        |
    #    |                       |        return type: `m.Other` here, but `m.Int` in overload 1 of `Base.pick`
    #    |                       |        return type: `m.Other` here, but `m.Num` in overload 2 of `Base.pick`
    #    |                       parameter `x`: `m.Other` here, but `m.Int` in overload 1 of `Base.pick`
    #    |                       parameter `x`: `m.Other` here, but `m.Num` in overload 2 of `Base.pick`
    # LL |   pub def pick _self x @ Num -> Num
    #    |           ^^^^
    ...

pub class Narrow: Base
  pub def pick _self x @ Int -> Num
    # error: `pick` does not match `Base.pick`
    #   --> m.dol:LL:LL
    #    |
    # LL |   @def pick _self x @ Int -> Int
    #    |                              --- as overload 1 of `Base.pick` declares it
    # LL |   @def pick _self x @ Num -> Num
    #    |                       --- as overload 2 of `Base.pick` declares it
    # ...
    # LL |   pub def pick _self x @ Int -> Num
    #    |           ^^^^           ---    --- return type: `m.Num` here, but `m.Int` in overload 1 of `Base.pick`
    #    |                          |
    #    |                          parameter `x`: `m.Int` here, but `m.Num` in overload 2 of `Base.pick`
    ...

pub @class Picks
  pub def pick self x @ Int -> Int

pub class Asserted: @Picks
  @def pick _self x @ Int -> Int
  pub def pick _self x @ Num -> Num
    ...

pub class Unasserted: @Picks
  @def pick _self x @ Other -> Other
  pub def pick _self x @ Num -> Num
    # error: `pick` does not match `Picks.pick`
    #   --> m.dol:LL:LL
    #    |
    # LL |   pub def pick self x @ Int -> Int
    #    |                         ---    --- as `Picks.pick` declares it
    #    |                         |
    #    |                         as `Picks.pick` declares it
    # ...
    # LL |   @def pick _self x @ Other -> Other
    #    |                       -----    ----- return type: `m.Other` here, but `m.Int` in `Picks.pick`
    #    |                       |
    #    |                       parameter `x`: `m.Other` here, but `m.Int` in `Picks.pick`
    # LL |   pub def pick _self x @ Num -> Num
    #    |           ^^^^
    ...

# A protocol's overloads are each required
pub @class Converts
  @def convert self x @ Int -> Int
  @def convert self x @ Other -> Other
  pub def convert self x @ (Int | Other) -> (Int | Other)

pub class Converter: @Converts
  @def convert _self x @ Int -> Int
  @def convert _self x @ Other -> Other
  pub def convert _self x @ (Int | Other) -> (Int | Other)
    ...

pub class HalfConverter: @Converts
  pub def convert _self x @ Int -> Int
    # error: `convert` does not match `Converts.convert`
    #   --> m.dol:LL:LL
    #    |
    # LL |   @def convert self x @ Other -> Other
    #    |                         -----    ----- as overload 2 of `Converts.convert` declares it
    #    |                         |
    #    |                         as overload 2 of `Converts.convert` declares it
    # ...
    # LL |   pub def convert _self x @ Int -> Int
    #    |           ^^^^^^^           ---    --- return type: `m.Int` here, but `m.Other` in overload 2 of `Converts.convert`
    #    |                             |
    #    |                             parameter `x`: `m.Int` here, but `m.Other` in overload 2 of `Converts.convert`
    ...

# A requirement met only by several overloads together isn't met
pub @class Either
  pub def either self x @ (Int | Other) -> (Int | Other)

pub class Split: @Either
  @def either _self x @ Int -> Int
  @def either _self x @ Other -> Other
  pub def either _self x @ (Int | Other) -> (Int | Other)
    # error: `either` does not match `Either.either`
    #   --> m.dol:LL:LL
    #    |
    # LL |   pub def either _self x @ (Int | Other) -> (Int | Other)
    #    |           ^^^^^^
    ...

# A subclass that inherits a method with a specialized receiver on an overload
# has the method as its class does.
pub class Pair[K, V]
  pub field key @ K = ...
  pub field value @ V = ...

pub class Seq[T]
  pub field item @ T = ...
  @def key[K, V] _self @ Seq[Pair[K, V]] -> K
  pub def key _self
    ...

pub class PairSeq[T]: Seq[T]
