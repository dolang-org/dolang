# `Func` declares no `(call)`, so a callable class's `(call)` is its own. A
# subclass's `(call)` overrides it as any method does.

pub class Base: Func
  pub def (call) _self n @ Int -> Str
    ...

pub class Wider: Base
  pub def (call) _self n @ (Int | Str) -> Str
    ...

pub class Narrower: Base
  pub def (call) _self n @ Str -> Str
    # error: `(call)` does not match `Base.(call)`
    #   --> m.dol:LL:LL
    #    |
    # LL |   pub def (call) _self n @ Str -> Str
    #    |            ^^^^
    ...
