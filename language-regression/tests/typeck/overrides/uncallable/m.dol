# An instance `(call)` in a class or protocol that doesn't reach `Func` is warned
# of, since its instances aren't passed as functions. A class-level `(call)` is
# not.

pub class Plain
  pub def (call) _self n @ Int -> Str
    # warning: `Plain` has a `(call)` but not `Func` as a supertype, so it isn't passed as a function
    #   --> m.dol:LL:LL
    #    |
    # LL |   pub def (call) _self n @ Int -> Str
    #    |            ^^^^
    ...

pub @class Shaped
  pub def (call) self n @ Int -> Str
# warning: `Shaped` has a `(call)` but not `Func` as a supertype, so it isn't passed as a function
#   --> m.dol:LL:LL
#    |
# LL |   pub def (call) self n @ Int -> Str
#    |            ^^^^

pub class Callable: Func
  pub def (call) _self n @ Int -> Str
    ...

pub @class Claimed: Func
  pub def (call) self n @ Int -> Str

pub class Factory
  #[class]
  pub def (call) _cls n @ Int -> Str
    ...
