# An item projection of a rest binder's schema is below one of a wider schema.
# The overloads establish a protocol's `IndexItem` of another schema, so the
# implementations, whose results couldn't, aren't compared with it.

import std:
  - @Index
  - @IndexItem
  - @Union

pub @class Positions[T]
  pub def (index)[K] self key@K -> IndexItem[{*T}, K]

pub class Pack[*Ts]: @Index[Ts] @Positions[Union[...Ts]]
  @def (index)[K] self key@K -> IndexItem[Ts, K]
  @def (index) self range@Range[Int] -> Pack[...Union[...Ts]]
  pub def (index) self key -> Value
    ...

pub class Spelled[*Ts]: @Index[Ts] @Positions[Union[...Ts]]
  @def (index)[K] self key@K -> IndexItem[{...Ts}, K]
  @def (index) self range@Range[Int] -> Spelled[...Union[...Ts]]
  pub def (index) self key -> Value
    ...
