# An item projection of a rest binder's schema is the same as one of `{...Ts}`.
# Against a protocol's `IndexItem` of another schema, the overload's projection
# of the rigid schema goes to its bound with the method's own key binder in
# scope.

import std:
  - @Index
  - @IndexItem
  - @Union

pub @class Positions[T]
  pub def (index)[K] self key@K -> IndexItem[{*(Int): T}, K]

pub class Pack[*Ts]: @Index[Ts] @Positions[Union[...Ts]]
  @def (index)[K] self key@K -> IndexItem[Ts, K]
  @def (index) self range@Range[Int] -> Pack[...Union[...Ts]]
  pub def (index) self key
    ...

pub class Spelled[*Ts]: @Index[Ts] @Positions[Union[...Ts]]
  @def (index)[K] self key@K -> IndexItem[{...Ts}, K]
  @def (index) self range@Range[Int] -> Spelled[...Union[...Ts]]
  pub def (index) self key
    ...
