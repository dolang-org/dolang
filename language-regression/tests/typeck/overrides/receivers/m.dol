# An overridden method is called on the subclass's instances, so its receiver is
# narrowed to the subclass: an annotated receiver `Box[T]` becomes `Kept[T]`.

pub class Num
pub class Int: Num

pub class Box[T]
  pub field item @ T = nil
  pub def only self @ Box[T] -> T
    self.item

pub class Kept[T]: Box[T]
  pub def only self @ Kept[T] -> T
    self.item

pub class Inherited[T]: Box[T]

# An override callable on fewer of the instances
pub class Pinned[T]: Box[T]
  pub def only self @ Pinned[Int] -> T
    # error: only an `@def` overload may specialize `self` to a `Pinned`
    #   --> m.dol:LL:LL
    #    |
    # LL |   pub def only self @ Pinned[Int] -> T
    #    |                       ^^^^^^^^^^^
    # error: `only` does not match `Box.only`
    #   --> m.dol:LL:LL
    #    |
    # LL |   pub def only self @ Pinned[Int] -> T
    #    |           ^^^^
    self.item
# error: `m.Int` does not fit the declared result `m.Pinned.#0`
#   --> m.dol:LL:LL
#    |
# LL |     self.item
#    |     ^^^^^^^^^
