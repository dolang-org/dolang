# An overridden method is called on the subclass's instances, so its receiver is
# narrowed to the subclass: an annotated receiver `Box[T]` becomes `Kept[T]`.

pub class Num
pub class Int: Num

pub class Box[T]
  pub field item @ T = ...
  pub def only self @ Box[T] -> T
    self.item

pub class Kept[T]: Box[T]
  pub def only self @ Kept[T] -> T
    self.item

pub class Inherited[T]: Box[T]

# An override callable on fewer of the instances
pub class Pinned[T]: Box[T]
  pub def only self @ Pinned[Int] -> T
    # error: only an `@def` overload may narrow `self` below a `Pinned`
    #   --> m.dol:LL:LL
    #    |
    # LL |   pub def only self @ Pinned[Int] -> T
    #    |                       ^^^^^^^^^^^
    # error: `only` does not match `Box.only`
    #   --> m.dol:LL:LL
    #    |
    # LL |   pub def only self @ Box[T] -> T
    #    |                       ------ as `Box.only` declares it
    # ...
    # LL |   pub def only self @ Pinned[Int] -> T
    #    |           ^^^^        ----------- parameter `self`: `m.Pinned[m.Int]` here, but `m.Pinned[T]` in `Box.only`
    self.item
# error: `m.Int` does not fit the declared result `T`
#   --> m.dol:LL:LL
#    |
# LL |     self.item
#    |     ^^^^^^^^^

# A receiver wider than its class is still narrowed to the subclass, so an
# override needn't widen it too.
pub @class Readable[T]
  pub def read self -> T

pub class Source[T]: @Readable[T]
  pub def read _self -> T
    ...

  pub def twice self @ Readable[T] -> T
    self.read()

pub class Narrow[T]: Source[T]
  pub def twice self -> T
    self.read()
