# `=>` before a same-line body or a pattern on the header line is an operator.

if true => dbg 1
#       ^~: operator

let i = 0
while (i < 1) => i = (i + 1)
#             ^~: operator

bind [1] => a
#        ^~: operator
dbg $a

if bind [1] => b c = 2 => dbg $b $c
#           ^~: operator
#                      ^~: operator

for x = [1] => dbg $x
#           ^~: operator

def double x => (x * 2)
#            ^~: operator

let r = try double 1
catch e => dbg $e
#       ^~: operator
