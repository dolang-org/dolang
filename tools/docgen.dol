# Documentation extraction and docs/api page generation.
#
# dodo.dol loads this with `exec.module` for the `mkdocs` and `install`
# tasks. Both entry points take the build `Spec` supplying the `dolang`
# binary that does the extracting, so nothing here reaches back into
# dodo.dol.

import json strand sys
  fs:
    - Path

let MKDOCS_API_DIR = Path "docs/api"

def doc_paths()
  $
    dolang-shell-modules/lib
    dolang-shell-modules/stub

# Module-name resolution for a .dol source under a search dir: `foo/bar.dol`
# is module `foo.bar`; `foo/mod.dol` is module `foo`. This is also how
# identifiers are keyed in the pre-extracted JSON cache the mkdocstrings
# handler (docs/mkdocstrings_handlers/do/__init__.py) reads.
def dol_module_name path base
  let rel = path.relative $base
  let parts = [...rel.parent.components]
  if (rel.name != "mod.dol")
    parts.push $rel.stem
  ".".join $parts

def collect_doc_jobs()
  stream do for search_dir = doc_paths()
    let base = Path $search_dir
    for path = base.glob "**/*.dol"
      let name = dol_module_name $path $base
      put $ record :name :path

# The documented public classes a module declares or re-exports. Only
# documented ones receive pages because the handler hides undocumented
# entities by default. Each result keeps the bare name used for its filename
# and identifier alongside the binders its page title declares, whether it is
# a protocol, and its designated decorators.
def module_classes modules module entities chain = []
  let classes = []
  for e = entities
    if ((e["kind"] == "class") && e["pub"] && e["doc"])
      classes.push [e["name"], e.get("binders", default: []), e.get("protocol", default: false), e.get("decorators", default: [])]
    else if ((e["kind"] == "import_item") && e["pub"])
      let key = "$module.$(e["name"])"
      if chain.contains $key
        throw "cyclic public doc re-export: $(" -> ".join([...chain, key]))"
      let source = modules.get $e["module"] else: do
        throw "public doc re-export $key names missing module $(e["module"])"
      let target = source["entities"].find do |candidate|
        (candidate["name"] == e["item"])
      if (target == nil)
        throw "public doc re-export $key names missing item $(e["module"]).$(e["item"])"
      let resolved = module_classes $modules $e["module"] [target] [...chain, key]
      if resolved.len
        classes.push [e["name"], ...resolved[0][1..]]
  classes

# How tightly each type form binds, so that it is parenthesized where needed
let BINDS_FUNC = 0
let BINDS_UNION = 1
let BINDS_COMPACT = 2

# The sigil that declares each kind of parameter or binder
let SIGILS = $
  "pos": ""
  "key": ":"
  "mixed_rest": "..."
  "pos_rest": "*"
  "key_rest": "**"
  "input": "<"
  "output": ">"

# The sigil a schema item's quantifier is written with.
let QUANTS = $
  "opt": "?"
  "star": "*"
  "include": "..."

# A binder's name as its declaration writes it.
def binder_name binder
  "$(SIGILS[binder["kind"]])$(binder["name"])"

# A type tree from the extractor, as source writes it in a position binding as
# tightly as `context`.
def type_text ty context
  let kind = ty["kind"]
  if (kind == "name")
    return ty["name"]
  if (kind == "const")
    return ty["text"]
  let text = nil
  let binding = BINDS_COMPACT
  if (kind == "app")
    text = "$(type_text(ty["base"], BINDS_COMPACT))[$(type_args_text(ty["args"]))]"
  else if (kind == "schema")
    text = "{$(type_params_text(ty["params"]))}"
  else if (kind == "union")
    text = " | ".join([...ty["members"].map(do |member| type_text(member, BINDS_COMPACT))])
    binding = BINDS_UNION
  else
    # The implicits are written among the items, but a list holds at most one
    # of each, so they are rendered after them
    let parts = []
    let params = (type_params_text ty["params"])
    if (params != "")
      parts.push $params
    if let input = ty.get("input", default: nil)
      parts.push "<$(type_text(input, BINDS_FUNC))"
    if let output = ty.get("output", default: nil)
      parts.push ">$(type_text(output, BINDS_FUNC))"
    text = "($(", ".join(parts))) -> $(type_text(ty["ret"], BINDS_FUNC))"
    binding = BINDS_FUNC
  if (binding < context)
    "($text)"
  else
    text

# The arguments in the `[]` of an application type tree.
def type_args_text args
  let parts = []
  for arg = args
    let text = (type_text arg["type"] BINDS_FUNC)
    let kind = arg["kind"]
    if (kind == "expand")
      text = "...$text"
    else if (kind == "key")
      text = "$(arg["name"]): $text"
    parts.push $text
  ", ".join $parts

# The parameters in the `()` or `{}` of a function or schema type tree.
def type_params_text params
  let parts = []
  for param = params
    let text = QUANTS.get(param.get("quant", default: nil), default: "")
    let kind = param["kind"]
    if (kind == "open")
      parts.push "..."
      continue
    if (kind == "any_pos")
      parts.push "*"
      continue
    if (kind == "any_key")
      if (param.get("type", default: nil) == nil)
        parts.push "**"
        continue
      text = "**"
    else if (kind == "key")
      if let key_type = param.get("key_type", default: nil)
        # A name must be parenthesized to not be taken as a symbol key
        let key = (type_text key_type BINDS_COMPACT)
        text = if (key_type["kind"] == "name")
          "$text($key): "
        else
          "$text$key: "
      else
        text = "$text$(param["key"]): "
    parts.push "$text$(type_text(param["type"], BINDS_FUNC))"
  ", ".join $parts

# A binder as its declaration writes it.
def binder_text binder
  let text = binder_name $binder
  if let bound = binder.get "bound" default: nil
    text = "$text @ $(type_text(bound, BINDS_COMPACT))"
  if let value = binder.get "default" default: nil
    text = "$text = $(type_text(value, BINDS_COMPACT))"
  text

# A class page's title, naming its binders for the nav, and its heading, which
# declares them in full after any `#[final]` or `#[mixable]`. A protocol's name
# keeps the `@` it is declared with, so it is not mistaken for a class.
def class_titles entry
  let bare binders protocol decorators = entry
  let name = (protocol && "@$bare" || bare)
  let prefix = "".join([...decorators.map(do |d| "#[$d] ")])
  if !binders.len
    return [name, "$prefix$name"]
  let names = [...binders.map(binder_name)]
  let declared = [...binders.map(binder_text)]
  ["$name[$(", ".join(names))]", "$prefix$name[$(", ".join(declared))]"]

# Escapes the Markdown punctuation a title can contain. A binder's schema
# bound brings braces, as in `Dict[S @ {...}]`, and attr_list takes an
# unescaped brace as the start of the heading's `{: #... }` list; failing to
# parse that, it leaves the list in the heading text and the id unassigned.
def markdown_escape text
  let escaped = text
  # The backslash goes first, so the escapes added after it stay single.
  for c = ["\\", "`", "*", "_", "{", "}", "[", "]", "#"]
    escaped = escaped.replace $c "\\$c"
  escaped

def private_doc_module name
  name.split(".").any do |component| component.starts_with "_"

def write_doc_page path title heading identifier
  path.parent.create_dir all: true
  # The frontmatter `title` is for awesome-nav: with `use_index_title` on, it
  # reads this instead of falling back to a title-cased directory name (e.g.
  # `fs.unix` -> "Fs.unix"), which is wrong for names that are meant to stay
  # lowercase. It leaves out what the heading can spell out, like a binder's
  # bound, to keep the nav terse. The `{: #... }` attr_list anchor matches the identifier
  # mkdocstrings registers for this page's own root heading. Without it,
  # Python-Markdown's toc extension slugifies the plain title into its own
  # anchor id (e.g. "Args" -> "args"), which collides workspace-wide with any
  # unrelated heading that happens to slugify the same way (a module named
  # `args`, in this case). A matching id here just dedupes against that
  # registration instead of adding a second, colliding one.
  path.write |
    ---
    title: $(dbg title)
    ---

    # $(markdown_escape heading) {: #$identifier }

    ::: $identifier

# Writes docs/api pages for one module: an index page plus one page per public
# class. Each module gets its own single directory named after its full
# dotted name (`fs.unix` -> api/fs.unix/, not api/fs/unix/) rather than one
# nested per dotted component -- otherwise a module like `security.windows`
# would show up nested under an unrelated `security` section in the nav
# instead of as its own entry. Private modules (leading `_`, e.g.
# `_container.dockman`) are implementation detail and get no page of their
# own. Any component beginning with `_` makes the module private. Re-exported
# classes are written under the public importing module instead.
def generate_doc_pages modules name entities
  if !private_doc_module(name)
    let dir = (MKDOCS_API_DIR / name)
    write_doc_page (dir / "index.md") $name $name $name
    for entry = module_classes $modules $name $entities
      let title heading = class_titles $entry
      write_doc_page
        (dir / "$(entry[0]).md")
        $title
        $heading
        "$name.$(entry[0])"

# Runs `dolang -m doc` once per module, in parallel, writing each result as
# `<out_dir>/<module name>.json`. This is the JSON-only half of extract_docs
# (see there for the full doc comment on why extraction is parallelized) --
# used by `install` to feed dolang-lsp's build-time static doc index (see
# dolang-lsp/build.rs) without also touching the docs/api page tree.
pub def extract_doc_json spec out_dir
  out_dir.remove all: true ignore: true
  out_dir.create_dir all: true
  let workers = sys.cpu_info().logical_count
  strand.pool $workers $collect_doc_jobs() do |job|
    let :name :path = job
    spec.dolang -m compile extract --doc --strict --module $name $path stdout: (out_dir / "$name.json")

# The playground's hover docs (see playground/src/docs.ts), written to
# `out_dir`: the doc projection of each stub module as `modules/<name>.json`,
# with `test` from the playground's own stub, and `pages.json`, naming each
# public module's classes that get their own docs/api page, for resolving
# cross-references into the site. Pages are laid out from every module, as
# for mkdocs, since a link can point anywhere on the site. The `lib/` modules
# need the shell, which the playground lacks, so their docs aren't shipped.
pub def extract_playground_docs spec out_dir
  let json_dir = (spec.target_dir / "playground-doc-json").absolute()
  extract_doc_json $spec $json_dir
  let modules = $
    for doc = json_dir.glob("*.json").map do |p| (json.decode(str(p.read()))["doc"])
      $doc["module"]: $doc
  let pages = {}
  for name document = modules
    if private_doc_module(name)
      continue
    let classes = []
    for entry = module_classes $modules $name $document["entities"]
      classes.push $entry[0]
    pages[name] = classes
  out_dir.remove all: true ignore: true
  let modules_dir = (out_dir / "modules")
  modules_dir.create_dir all: true
  (out_dir / "pages.json").write $json.encode(pages)
  let stub = Path "dolang-shell-modules/stub"
  for path = stub.glob "**/*.dol"
    let name = dol_module_name $path $stub
    (modules_dir / "$name.json").write $json.encode(modules[name])
  let test = (spec.target_dir / "playground-test-doc.json").absolute()
  spec.dolang -m compile extract --doc --strict --module test
    dolang-shell-modules/wasm/stub/test.dol
    stdout: $test
  let test_doc = json.decode(str(test.read()))["doc"]
  (modules_dir / "test.json").write $json.encode(test_doc)

# Regenerates every bundled library's typelib for the LSP build. Keep private
# modules too: public declarations may refer to them.
pub def extract_typelibs spec out_dir
  let jobs = [...collect_doc_jobs()]
  let names = Set []
  let paths = []
  for job = jobs
    let :name :path = job
    if names.contains(name)
      throw "duplicate bundled module: $name"
    names.add $name
    paths.push $path
  out_dir.remove all: true ignore: true
  out_dir.create_dir all: true
  # Checked together, each module named as `dol_module_name` names it
  spec.dolang -m compile typelib --no-bundled --output $out_dir
    for dir = doc_paths()
      --path $dir
    ...paths

# Extracts the JSON cache and regenerates the docs/api page tree from it.
#
# `dolang -m compile extract --doc` nests the cooked documentation projection
# under "doc" alongside the raw nodes/tokens/diagnostics dump; only the
# former is relevant here, so it's unwrapped once when the cache is loaded.
pub def extract_docs spec out_dir
  extract_doc_json $spec $out_dir
  MKDOCS_API_DIR.remove all: true ignore: true
  let modules = $
    for doc = out_dir.glob("*.json").map do |p| (json.decode(str(p.read()))["doc"])
      $doc["module"]: $doc
  for name document = modules
    generate_doc_pages $modules $name $document["entities"]
