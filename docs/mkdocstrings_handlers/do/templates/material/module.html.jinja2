{% import "_params.html.jinja2" as params %}
{% set heading_level = options.get("heading_level", 2) %}
{% set show_private = options.get("show_private", false) %}

{% set classes = [] %}
{% set functions = [] %}
{% set values = [] %}
{% for entity in entities %}
  {% if entity.kind == "class" and (entity.pub or show_private) %}
    {% set _ = classes.append(entity) %}
  {% elif entity.kind == "function" and (entity.pub or show_private) %}
    {% set _ = functions.append(entity) %}
  {% elif entity.kind == "value" and (entity.pub or show_private) %}
    {% set _ = values.append(entity) %}
  {% endif %}
{% endfor %}

{# Registers the module's own dotted name as its heading id (rather than just the
   last component, as classes do) so links like [strand](strand) resolve to this
   page. Module names are unique workspace-wide, so this can't collide with
   another page's primary anchor the way a bare local name could. #}
{{ "" | heading(heading_level, id=entity.module, hidden=true) }}

{% if entity.doc %}
{{ entity.doc | convert_markdown(0, "") }}
{% endif %}

{% if classes %}
{{ "Types" | heading(heading_level, skip_inventory=true, id="types") }}
<table>
<thead><tr><th>Type</th><th>Description</th></tr></thead>
<tbody>
{% for cls in classes %}
{# `doc_summary` is the doc's first paragraph, split the same way a parameter
   description is. A class doc keeps that paragraph brief, since this table is
   where it is read. #}
<tr>
  {# A type is usually documented on a page of its own, so the link is resolved
     by identifier rather than assumed to be an anchor on this page. #}
  <td><autoref identifier="{{ cls._identifier }}"><code>{{ cls.name }}</code></autoref></td>
  {# The summary is prose written in a doc comment like any other, so it carries
     the markup one is written with -- links to other types especially. #}
  <td>{{ cls.doc_summary | convert_markdown(heading_level, cls.name, strip_paragraph=true) }}</td>
</tr>
{% endfor %}
</tbody>
</table>
{% endif %}

{% if functions %}
{{ "Functions" | heading(heading_level, skip_inventory=true, id="functions") }}
{% for entity in functions %}
{% set base_id = entity._identifier %}
{% set sig = entity.signature %}
{{ params.signature_heading(sig, entity.return_type, heading_level + 1, base_id, "function", sig) }}
{% if entity.doc_intro %}
{{ entity.doc_intro | convert_markdown(heading_level, base_id) }}
{% endif %}
{{ params.parameters(entity, heading_level + 2, base_id) }}
{% if entity.doc_sections %}
{{ entity.doc_sections | convert_markdown(heading_level, base_id) }}
{% endif %}
{% endfor %}
{% endif %}

{% if values %}
{{ "Values" | heading(heading_level, skip_inventory=true, id="values") }}
{% for entity in values %}
{% set base_id = entity._identifier %}
{{ ("<code>" ~ entity.name ~ "</code>") | heading(heading_level + 1, role="data", id=base_id, toc_label=entity.name) }}
{% if entity.doc %}
{{ entity.doc | convert_markdown(heading_level, base_id) }}
{% endif %}
{% endfor %}
{% endif %}
