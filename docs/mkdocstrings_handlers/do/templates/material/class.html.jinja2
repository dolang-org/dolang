{% import "_params.html.jinja2" as params %}
{% set heading_level = options.get("heading_level", 2) %}
{% set show_private = options.get("show_private", false) %}
{% set base_id = entity._identifier %}

{#
  A type is rendered on a page of its own, which carries its own title, so this
  heading only exists to register an anchor: without one, a link to the type
  from its module's Types table has nothing to resolve against. Like a module's,
  it has no label, which keeps it out of the table of contents, and the page's
  sections sit at its level rather than beneath it.
#}
{{ "" | heading(heading_level, role="class", id=base_id, hidden=true) }}
{% set heading_level = heading_level - 1 %}

{% if entity.doc %}
{{ entity.doc | convert_markdown(heading_level - 1, "") }}
{% endif %}

{# A protocol's supertypes are all type-only, but it has no runtime ones to
   tell them apart from. #}
{% set supers = entity.super_annotations + (entity.protocol_annotations if entity.protocol else []) %}
{% set protocols = [] if entity.protocol else entity.protocol_annotations %}
{% if supers %}
<p><strong>Inherits from:</strong> {{ supers | join(", ") | convert_markdown(heading_level, base_id ~ "--supers", strip_paragraph=true) }}</p>
{% endif %}
{% if protocols %}
<p><strong>Implements:</strong> {{ protocols | join(", ") | convert_markdown(heading_level, base_id ~ "--protocols", strip_paragraph=true) }}</p>
{% endif %}

{% set pub_members = entity.members | selectattr("pub") | list %}
{% set special_members = entity.members | selectattr("special") | list %}
{# A public special method is in both lists. Overloads share a name, so each
   member is told apart by its anchor. #}
{% set all_members = entity.members if show_private else (pub_members + special_members) | unique(attribute="_anchor") | list %}

{% set class_fields = all_members | selectattr("kind", "equalto", "field") | rejectattr("scope", "equalto", "instance") | list %}
{% set fields = all_members | selectattr("kind", "equalto", "field") | selectattr("scope", "equalto", "instance") | list %}
{# Calling the class runs a class-scope `(call)` when there is one, which,
   unlike `(init)`, can return something other than the new instance. Both are
   listed as constructors. #}
{% set class_calls = all_members | selectattr("kind", "equalto", "method") | selectattr("name", "equalto", "(call)") | rejectattr("scope", "equalto", "instance") | list %}
{% set class_methods = all_members | selectattr("kind", "equalto", "method") | rejectattr("scope", "equalto", "instance") | rejectattr("name", "equalto", "(call)") | list %}
{% set constructors = (all_members | selectattr("kind", "equalto", "method") | selectattr("name", "equalto", "(init)") | list) + class_calls %}
{% set methods = all_members | selectattr("kind", "equalto", "method") | selectattr("scope", "equalto", "instance") | rejectattr("name", "equalto", "(init)") | list %}

{% macro render_fields(items, title, anchor) %}
{{ title | heading(heading_level + 1, skip_inventory=true, id=anchor) }}
<dl>
{% for field in items %}
  {# The anchor is what a cross-page link to a getter, as in
     `[x][module.Class.x]`, resolves against. It has to come from the
     `heading` filter rather than a bare `id=` attribute on the `<dt>`:
     mkdocstrings renders this macro's output as a raw HTML block, and raw
     HTML is stashed out of the Markdown tree and never scanned for anchors,
     so an `id` placed there directly wouldn't register and strict builds
     would flag every link to it. The id is the field's fully-qualified
     identifier, not its bare name: a bare name would collide primary-registers
     with any other field/method/module across the whole site that happens to
     share it (autorefs registers heading ids workspace-wide, not per-page). #}
  {{ "" | heading(heading_level + 2, id=field._anchor, hidden=true, toc_label=field.name) }}
  <dt><code>{{ field.name }}</code>{% if field.type %} ({{ field.type | convert_markdown(heading_level + 2, field._anchor ~ "--type", strip_paragraph=true) }}){% endif %}</dt>
  {% if field.doc %}
  <dd>{{ field.doc | convert_markdown(heading_level + 2, field._anchor) }}</dd>
  {% else %}
  <dd></dd>
  {% endif %}
{% endfor %}
</dl>
{% endmacro %}

{% macro render_methods(items, title, anchor) %}
{{ title | heading(heading_level + 1, skip_inventory=true, id=anchor) }}
{% for method in items %}
{% set method_id = method._anchor %}
{% set sig = method.signature %}
{{ params.signature_heading(sig, method.return_type, heading_level + 2, method_id, "method", sig) }}
{% if method.doc_intro %}
{{ method.doc_intro | convert_markdown(heading_level + 1, method_id) }}
{% endif %}
{{ params.parameters(method, heading_level + 3, method_id) }}
{% if method.doc_sections %}
{{ method.doc_sections | convert_markdown(heading_level + 1, method_id) }}
{% endif %}
{% endfor %}
{% endmacro %}

{% if constructors %}
{{ "Constructor" | heading(heading_level + 1, skip_inventory=true, id="constructor") }}
{% for method in constructors %}
{% set method_id = method._anchor %}
{# A constructor is called through the class's name alone. The binders of
   `(init)` describe the type, not arguments a caller writes; those of a
   class-scope `(call)` are its own, and the parameter table shows them. #}
{% if method.name == "(call)" %}
{% set sig = entity.name ~ method.signature[method.declaration_name | length:] %}
{% else %}
{% set sig = method.signature | replace("(init)", entity.name, 1) %}
{% endif %}
{{ params.signature_heading(sig, method.return_type, heading_level + 2, method_id, "method", sig) }}
{% if method.doc_intro %}
{{ method.doc_intro | convert_markdown(heading_level + 1, method_id) }}
{% endif %}
{{ params.parameters(method, heading_level + 3, method_id) }}
{% if method.doc_sections %}
{{ method.doc_sections | convert_markdown(heading_level + 1, method_id) }}
{% endif %}
{% endfor %}
{% endif %}

{% if class_fields %}
{{ render_fields(class_fields, "Class Fields", "class-fields") }}
{% endif %}

{% if class_methods %}
{{ render_methods(class_methods, "Class Methods", "class-methods") }}
{% endif %}

{% if fields %}
{{ render_fields(fields, "Fields", "fields") }}
{% endif %}

{% if methods %}
{{ render_methods(methods, "Methods", "methods") }}
{% endif %}
