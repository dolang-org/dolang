# title: Time API
import time:
  - DateTime
  - TimeZone
  - timeout
  - sleep

let now = DateTime.now()
echo "Now: $now"
let today = now.date
echo "Today: $(today.weekday), $(today.month) $(today.day)"
echo "A week from today: $(today.add_days 7)"

# Instants are UTC; view one in a zone for its wall time
let local = now.zoned(TimeZone.local())
let clock = local.format "%H:%M %Z"
echo "Local time: $clock"
let tokyo = now.zoned(TimeZone.get "Asia/Tokyo")
echo "Tokyo: $tokyo"

# The offset is applied, giving a UTC instant
let leap = DateTime.parse_rfc 2024-02-29T12:30:00+02:00
echo "Parsed: $leap"

# A timeout interrupts a block that runs too long
let start = DateTime.now()
let outcome = try
  timeout 0.2 do
    sleep 5
    "finished"
catch std.TimedOutError: _
  "timed out"
echo "Slow task $outcome after $(DateTime.now() - start)"

# Two strands take turns printing
fork
  do for n = [1, 2, 3]
    echo "tick $n"
    sleep 0.2
  do for n = ["a", "b"]
    echo "tock $n"
    sleep 0.3
