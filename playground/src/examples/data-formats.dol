# title: Data Formats
import base64 digest json toml yaml

let Dict(data) = json.decode r|
  {
    "name": "Do",
    "numbers": [1, 2, 3]
  }
let Array(numbers) = data["numbers"]
numbers.push 4

let outputs = $
  yaml: (yaml.encode data)
  json: (json.encode data)
  # Assert to the type checker that this doesn't contain `nil`, unsupported by TOML
  toml: (toml.encode $ (data !@ toml.EncodeValue))

for format text = outputs
  echo -- "$format" --
  echo $text

# Checksum each output, as hex and in the base64 `sha256-...` form used by
# Subresource Integrity.
let manifest = $
  for format text = outputs
    $format:
      sha256: "${digest.sha256(text):x}"
      integrity: "sha256-$(base64.encode(digest.sha256(text)))"
echo -- manifest --
echo $ yaml.encode $manifest
