def assert_eq actual expected
  if (actual != expected)
    throw std.RuntimeError "expected $(dbg expected), got $(dbg actual)"
def assert value
  assert_eq $value true

import base64 compile digest glob load rand regex toml url uuid xml
assert_eq (base64.encode b"hello") aGVsbG8=
assert_eq (base64.decode "aGVsbG8=") b"hello"
assert_eq $(digest.sha256 "hello").len 32
assert_eq $(digest.blake3 "hello").len 32
assert (glob.matches "**/*.dol" "src/main.dol")
assert_eq (regex.Regex("[0-9]+").replace "x123" "y") xy
assert_eq $(toml.decode (toml.encode {"name": "Do"}))["name"] Do
assert_eq $(url.Url("https://example.com/test")).host example.com
let random = rand.int 100
assert ((random >= 0) && (random < 100))
assert_eq $(uuid.Uuid.generate()).version 4
assert_eq $(uuid.Guid(str(uuid.Uuid.NIL))).data1 0
assert_eq $(xml.decode "<hello>world</hello>").tag hello
let unit = compile.compile generated.dol "(20 + 22)"
assert_eq (load.run(unit.emit())) 42
let module = compile.compile dynamic.dol "pub let answer = 42" module: dynamic
load.import_handler do |name|
  if (name == "dynamic")
    load.run $module.emit()
  else
    throw std.ImportError $name
import dynamic
assert_eq $dynamic.answer 42
echo "extensions passed"
"extensions passed"
