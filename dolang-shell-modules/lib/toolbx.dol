import _vfs proc
  shell:
    - Vfs
  _container.common:
    - runtime_dir
  strand:
    - pipeline

let :toolbox ... = proc.run

def run_command
  :name = nil
  :cd = nil
  :env = {}
  ...args
do
  toolbox run
    if (name != nil)
      --container $name
    -- env ...(_vfs.env_args cd env) ...args

def run_agent
  thunk
  :name = nil
  :cd = nil
  :env = {}
do
  let socket = "$(runtime_dir())/toolbox-vfs-$name"
  let agent = _vfs.bin()
  let input = strand.input()
  # The socket sits at a predictable path in the runtime directory and its mode
  # cannot identify the client, so the session is keyed instead: `--accept`
  # serves one peer that proves the key, and unlinks the socket once it has.
  let key = _vfs.key()
  pipeline
    do run_command :cd :env :name $agent --key-stdin --accept $socket
      stdin: (_vfs.key_input key)
    do
      strand.next()
      let agent = Vfs.unix_socket $socket :key
      try
        return strand.redirect input: $input do agent.with $thunk
      finally
        agent.stop()

pub def run
  cmd
  :name = nil
  :cd = nil
  :env = {}
  ...args
do
  run_command :name :cd :env $cmd ...args.pos_only()

# Run a function inside a toolbox container.
#
# The block sees the toolbox filesystem and process environment.
pub def with
  block
  :name = nil
  :cd = nil
  :env = {}
do
  run_agent :name :cd :env $block
