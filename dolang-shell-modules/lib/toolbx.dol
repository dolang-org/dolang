# dolang: strict
# Run commands or block-scoped operations inside a
# [Toolbx](https://containertoolbx.org/) container.
import _vfs proc time
  fs:
    - @Path
  shell:
    - Vfs
  _container.common:
    - runtime_dir
  strand:
    - pipeline

# Runs a command inside a toolbox container.
#
# ## Example
#
# ```
# toolbx.run dnf list --installed name: fedora-toolbox-41
# ```
pub def run
  # Program to run.
  cmd @ (Str | Path)
  # Toolbox container. Defaults to the default toolbox.
  :name @ Str = nil
  # Working directory in the container.
  :cd @ (Str | Path) = nil
  # Environment overrides. `nil` unsets a variable, and `:INHERIT:` copies it
  # from the calling context.
  :env @ BaseDict[Str | Sym, Value] = {}
  # Arguments passed verbatim to `cmd`.
  *args @ Value
  <Iter[Value]
  >Sink[Str]
do -> nil
  proc.run toolbox run
    if (name != nil)
      --container $name
    -- env ...(_vfs.env_args cd env) $cmd ...args

# Runs `block` inside a toolbox container.
#
# Filesystem access, spawned programs, and environment use the toolbox for the
# duration of the block.
#
# ## Example
#
# ```
# toolbx.with do run dnf list --installed
# ```
pub def with[R]
  # Block to run.
  block @ (() -> R)
  # Toolbox container. Defaults to the default toolbox.
  :name @ Str = nil
  # Initial working directory in the container.
  :cd @ (Str | Path) = nil
  # Initial environment overrides. `nil` unsets a variable, and `:INHERIT:`
  # copies it from the calling context.
  :env @ BaseDict[Str | Sym, Value] = {}
do -> R
  let socket = "$(runtime_dir())/toolbox-vfs-$name"
  let agent = _vfs.bin()
  let input = strand.input()
  # The socket sits at a predictable path in the runtime directory and its mode
  # cannot identify the client, so the session is keyed instead: `--accept`
  # serves one peer that proves the key, and unlinks the socket once it has.
  let key = _vfs.key()
  pipeline input: (_vfs.key_input key)
    do
      # Locals, since a test of what a block captures doesn't narrow it
      let container = name
      let dir = cd
      run $agent --key-stdin --accept $socket :env
        if (container != nil)
          name: $container
        if (dir != nil)
          cd: $dir
    do
      strand.next()
      let agent = Vfs.unix_socket $socket :key
      try
        return strand.with_io input: $input do agent.with $block
      finally
        time.timeout 30 do agent.stop()
