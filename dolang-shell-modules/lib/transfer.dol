# dolang: strict
# Downloads, uploads, packs, and safely extracts artifacts.
#
# A URL source is resolved through `get` wherever one is accepted, so its cache
# serves `put`, `pack`, and `unpack` as well.
#
# Results are published atomically: output is staged and renamed into place, so
# an interrupted operation leaves no partial destination behind.
import _vfs digest fs http json proc progress shell std sys tar zip
  fs:
    - Path
    - with_temp_dir
  fs.unix:
    Path: UnixPath
    - @Mode
  regex:
    - Regex
  std:
    - @Seq
  time:
    - DateTime
  url:
    - Url

# An archive format [`pack`](transfer.pack) writes.
#
# | Value        | Meaning                  |
# | ------------ | ------------------------ |
# | `:TAR:`      | Uncompressed TAR         |
# | `:TAR_GZIP:` | gzip-compressed TAR      |
# | `:TAR_ZSTD:` | Zstandard-compressed TAR |
# | `:ZIP:`      | ZIP                      |
pub @let ArchiveFormat = (:TAR: | :TAR_GZIP: | :TAR_ZSTD: | :ZIP:)

# An input format [`unpack`](transfer.unpack) reads: an archive, or a raw
# compressed stream.
#
# | Value    | Meaning              |
# | -------- | -------------------- |
# | `:GZIP:` | Raw gzip stream      |
# | `:ZSTD:` | Raw Zstandard stream |
# | `:XZ:`   | Raw XZ stream        |
pub @let UnpackFormat = (ArchiveFormat | :GZIP: | :ZSTD: | :XZ:)
import security.unix: security_unix
import security.windows:
  - @Sid

let DIGESTS @ Dict[Str, (() -> digest.State)] = $
  "blake3": $digest.Blake3
  "md5": $digest.Md5
  "sha1": $digest.Sha1
  "sha256": $digest.Sha256
  "sha512": $digest.Sha512

let HEX_DIGEST @ Regex = Regex r"^[0-9a-f]+$"

let CONTENT_RANGE @ Regex = Regex r"^bytes (\d+)-(\d+)/(\d+|\*)$"

# A parsed `digest:` argument.
class DigestSpec: Struct[{algorithm: Str, expected: Str, constructor: (() -> digest.State)}]

# Fields common to both kinds of cache metadata.
@let Metadata = $
  version: 1
  url: Str
  final_url: (Str | nil)
  payload: Str
  etag: (Str | nil)
  last_modified: (Str | nil)
  fetched_at: (Str | nil)

# Cache metadata written before the first byte of a download lands, so an
# interrupted download can be resumed.
class Partial: Struct[{...Metadata, state: "partial", total: (Int | nil)}]

@let CompleteFields = $
  ...Metadata
  size: Int
  checked_at: (Str | nil)
  verified: Dict[Str, Str]

# Cache metadata for a complete payload.
class Complete: Struct[CompleteFields]

def parse_location value @ (Str | Url | Path) -> (Url | Path)
  if (type value Str)
    if (value.starts_with "http://" || value.starts_with "https://")
      Url $value
    else
      Path $value
  else if (type value Url || type value Path)
    value
  else
    throw std.TypeError "expected `Str`, `Url`, or `Path`"

def require_http url @ Url -> Url
  if !(url.scheme == "http" || url.scheme == "https")
    throw std.ValueError "unsupported URL scheme: $url.scheme"
  url

def default_app() -> Str
  let program = shell.program
  let app = if (type program Path)
    (program.stem || program.name)
  else if (type program Str)
    program
  else
    throw std.ValueError "app: required when shell.program is unavailable"
  if (app == nil || app == "")
    throw std.ValueError "can't infer cache app from shell.program"
  app

def normalize_app app @ (Str | nil) -> Str
  let name = (app || default_app())
  name = name.replace("/", "_").replace("\\", "_")
  if (name == "" || name == "." || name == "..")
    throw std.ValueError "cache app name must not be empty"
  name

def normalized_url url @ Url -> Url
  require_http(url).with_fragment nil

def safe_leaf name @ (Str | nil) -> Str
  if (name == nil || name == "" || name == "." || name == "..")
    return "data"
  name.replace("/", "_").replace("\\", "_")

def digest_spec spec @ Str -> DigestSpec
  let parts = [...spec.lower().split ":" limit: 1]
  if (parts.len != 2)
    throw std.ValueError "digest: expected `algorithm:hex`"
  let algorithm expected = parts
  let constructor = DIGESTS.get $algorithm else: do
    throw std.ValueError "digest: unsupported algorithm: $algorithm"
  let expected_len = (constructor().digest().len * 2)
  if (expected.len != expected_len ||
      !HEX_DIGEST.match(expected))
    throw std.ValueError "digest: invalid $algorithm hex value"
  DigestSpec {:algorithm, :expected, :constructor}

def digest_state path @ Path constructor @ (() -> digest.State) -> digest.State
  let state = constructor()
  path.open rb do |file|
    for chunk = file
      state.update $chunk
  state

def file_digest path @ Path constructor @ (() -> digest.State) -> Str
  "${digest_state(path, constructor).digest():x}"

def read_metadata path @ Path identity @ Str -> (Partial | Complete | nil)
  if !path.exists()
    return nil
  let data = try
    json.decode(path.read())
  catch _
    return nil
  # An absent `state` means complete, so metadata written before resumable
  # downloads existed still reads as a usable payload. Fields that are only
  # informational may be missing from hand-planted or older entries.
  match data
    | Dict $
        "version": 1
        "url": Str(url)
        ?"final_url": (Str(final_url = nil) | std.Nil(final_url))
        "payload": Str(payload)
        "state": "partial"
        ?"etag": (Str(etag = nil) | std.Nil(etag))
        ?"last_modified": (Str(last_modified = nil) | std.Nil(last_modified))
        ?"total": (Int(total = nil) | std.Nil(total))
        ?"fetched_at": (Str(fetched_at = nil) | std.Nil(fetched_at))
        ...
    if (url == identity)
      Partial $
        version: 1
        state: "partial"
        :url :final_url :payload :etag :last_modified :total :fetched_at
    | Dict $
        "version": 1
        "url": Str(url)
        ?"final_url": (Str(final_url = nil) | std.Nil(final_url))
        "payload": Str(payload)
        ?"etag": (Str(etag = nil) | std.Nil(etag))
        ?"last_modified": (Str(last_modified = nil) | std.Nil(last_modified))
        "size": Int(size)
        ?"fetched_at": (Str(fetched_at = nil) | std.Nil(fetched_at))
        ?"checked_at": (Str(checked_at = nil) | std.Nil(checked_at))
        ?"verified": Dict(raw_verified @ Dict[Str, json.DecodeValue] = {})
        ...
    if (url == identity)
      Complete $
        version: 1
        :url :final_url :payload :etag :last_modified :size :fetched_at
        :checked_at
        verified:
          for algorithm value = raw_verified
            if (type value Str)
              $algorithm: $value

def write_metadata path @ Path metadata @ (Partial | Complete) -> nil
  let tmp = path.add_ext tmp
  try
    tmp.write $ json.encode(metadata)
    tmp.rename $path
  finally
    tmp.remove ignore: true
  nil

def intact_payload payload @ Path metadata @ Complete -> Bool
  if !payload.exists()
    return false
  try
    let info = payload.metadata()
    (info.type == :FILE: && info.size == metadata.size)
  catch _
    false

def file_size path @ Path -> (Int | nil)
  try
    let info = path.metadata()
    if (info.type == :FILE:)
      info.size
    else
      nil
  catch _
    nil

# The resume offset for a retained partial, or `nil` to start over. The actual
# size of the sidecar is authoritative; metadata only says whether the bytes
# can be trusted and what the whole representation is expected to look like.
def partial_offset part @ Path metadata @ Partial -> (Int | nil)
  let size = (file_size part)
  if (size == nil || size == 0)
    return nil
  let total = metadata.total
  # At or past the recorded total there is nothing left to ask for, and no way
  # to tell a complete download from a corrupt one without a validator.
  if (total != nil && size >= total)
    return nil
  size

def conditional_headers metadata @ Complete -> Dict[Str, Str | DateTime]
  let etag = metadata.etag
  let modified = metadata.last_modified
  $
    if etag
      "if-none-match": $etag
    if modified
      "if-modified-since": $ DateTime.parse_rfc $modified

def range_headers metadata @ Partial offset @ Int -> Dict[Str, Str | DateTime]
  let etag = metadata.etag
  let modified = metadata.last_modified
  $
    "range": "bytes=$offset-"
    # `If-Range` needs a strong validator: a weak ETag says two representations
    # are equivalent, not byte-identical, which is not enough to splice ranges.
    if (etag && !etag.starts_with "W/")
      "if-range": $etag
    else if modified
      "if-range": $ DateTime.parse_rfc $modified

# The start and total (`nil` when unknown) of a `Content-Range` header.
def parse_content_range value @ (Str | DateTime | nil) -> ((Int, (Int | nil)) | nil)
  if !(type value Str)
    return nil
  let captures = CONTENT_RANGE.match $value
  if (captures == nil)
    return nil
  let raw = (str captures[3])
  let total = if (raw == "*")
    nil
  else
    int $raw
  (int (str captures[1]), total)

# A response header as recorded in metadata: dates in their RFC form.
def header_text value @ (Str | DateTime | nil) -> (Str | nil)
  if (type value DateTime)
    value.rfc()
  else
    value

def partial_metadata identity @ Str response @ http.Response payload @ Str total @ (Int | nil) -> Partial
  let headers = response.headers
  return Partial $
    version: 1
    url: $identity
    final_url: (str response.url)
    :payload
    state: "partial"
    etag: (header_text (headers.get "etag"))
    last_modified: (header_text (headers.get "last-modified"))
    :total
    fetched_at: $DateTime.now().rfc()

def response_metadata
  identity @ Str
  response @ http.Response
  payload @ Path
  name @ Str
  digest_info @ (DigestSpec | nil)
do -> Complete
  let headers = response.headers
  let now = DateTime.now().rfc()
  Complete $
    version: 1
    url: $identity
    final_url: (str response.url)
    payload: $name
    etag: (header_text (headers.get "etag"))
    last_modified: (header_text (headers.get "last-modified"))
    size: $payload.metadata().size
    fetched_at: $now
    checked_at: $now
    # Digests verified against a previous representation say nothing about the
    # bytes just downloaded, so `verified` starts empty on every fresh body.
    verified:
      if digest_info
        $digest_info.algorithm: $digest_info.expected

class Cache
  field root @ Path
  field client @ http.Client = http.Client()

  def (init) self root @ Path
    self.#root = root

  def entry self url @ Url -> (Str, Path)
    let identity = str(normalized_url url)
    let key = "${digest.blake3(identity):x}"
    let entry = (self.#root / key)
    entry.create_dir all: true
    (identity, entry)

  # Streams the body into the `.part` sidecar, appending to it when resuming.
  # Returns the payload, or `:RETRY:` when the request has to be reissued
  # without the range and validators it was conditioned on.
  def fetch
    self
    identity @ Str
    entry @ Path
    name @ Str
    part @ Path
    metadata @ (Partial | Complete | nil)
    digest_info @ (DigestSpec | nil)
    indicator @ progress.Indicator
  do -> (Path | :RETRY:)
    let payload = (entry / name)
    let metadata_path = (entry / "metadata.json")
    let offset @ (Int | nil) = nil
    let headers @ Dict[Str, Str | DateTime] = {}
    if (type metadata Partial)
      offset = partial_offset $part $metadata
      if (offset != nil)
        headers = range_headers $metadata $offset
    else if (type metadata Complete && digest_info == nil)
      headers = conditional_headers $metadata

    self.#client.get $identity :headers status: :IGNORE: do |response|
      if (response.status == 304)
        if (type metadata Complete && intact_payload payload metadata)
          metadata.checked_at = DateTime.now().rfc()
          write_metadata $metadata_path $metadata
          let total = metadata.size
          indicator.update message: "$name (cached)" :total position: $total units: :BYTES:
          return payload
        # The validators still match, but the payload they stand for is gone or
        # the wrong size, so there is nothing to serve and no body to fall back
        # on. Ask again without them rather than publishing the empty response.
        return :RETRY:

      # Where the body continues the sidecar, or `nil` when it replaces it.
      let resume_from @ (Int | nil) = nil
      let total @ (Int | nil) = nil

      if (offset != nil)
        if (response.status == 416)
          # The partial no longer lines up with the representation at all.
          part.remove ignore: true
          return :RETRY:
        if (response.status == 206)
          let range = (parse_content_range (response.headers.get "content-range"))
          if (range == nil || range[0] != offset)
            part.remove ignore: true
            return :RETRY:
          resume_from = range[0]
          total = range[1]
        else
          # A `200` means the range was ignored (or `If-Range` failed), so the
          # body is the whole representation: start over without another
          # request.
          response.throw_for_status()
      else
        response.throw_for_status()

      if (resume_from == nil)
        let length = (response.headers.get "content-length")
        if (type length Str)
          total = int $length

      if (resume_from != nil)
        indicator.update :total position: $resume_from units: :BYTES:
      else
        indicator.update :total units: :BYTES:

      # Recorded before the first byte lands so an abrupt exit still leaves an
      # entry that says what the sidecar holds and how to resume it.
      let pending = (partial_metadata identity response name total)
      write_metadata $metadata_path $pending

      let state = if (digest_info == nil)
        nil
      else if (resume_from != nil)
        digest_state $part $digest_info.constructor
      else
        digest_info.constructor()

      let mode @ ("ab" | "wb") = if (resume_from != nil)
        "ab"
      else
        "wb"
      part.open $mode do |file|
        for chunk = response.chunks()
          file.write $chunk
          if state
            state.update $chunk
          indicator.delta $chunk.len

      let size = part.metadata().size
      if (total != nil && size != total)
        # The sidecar and its metadata stay put: the next `get` resumes here.
        throw std.ValueError "incomplete download for $identity: got $size of $total bytes"
      if (digest_info != nil && state != nil && "${state.digest():x}" != digest_info.expected)
        part.remove ignore: true
        metadata_path.remove ignore: true
        throw std.ValueError "digest mismatch for $identity"

      part.rename $payload
      let updated = (response_metadata identity response payload name digest_info)
      write_metadata $metadata_path $updated
      payload

  def download
    self
    identity @ Str
    entry @ Path
    name @ Str
    metadata @ (Partial | Complete | nil)
    digest_info @ (DigestSpec | nil)
  do -> Path
    let part = (entry / name).add_ext part
    progress.show message: $name icon: ⬇️ do |indicator|
      let result = self.#fetch $identity $entry $name $part $metadata $digest_info $indicator
      if (type result Path)
        result
      else
        # Retry with no metadata as well as no offset: what we knew about the
        # entry is exactly what the server just refused to honor, so sending
        # its validators again would only repeat the same answer.
        let retried = self.#fetch $identity $entry $name $part nil $digest_info $indicator
        if (type retried Path)
          retried
        else
          throw std.ValueError "server refused an unconditional request for $identity"

  pub def get self url @ Url digest @ (Str | nil) -> Path
    url = (normalized_url url)
    let identity entry = (self.#entry url)
    let payload_name = (safe_leaf url.name)
    let metadata_path = (entry / "metadata.json")
    let lock_path = (entry / "lock")
    let digest_info = if digest
      digest_spec $digest
    else
      nil

    lock_path.open a+ do |lock| lock.lock (..) do |_|
      let metadata = (read_metadata metadata_path identity)
      let name = (metadata && metadata.payload || payload_name)
      let payload = (entry / name)
      if (type metadata Complete && intact_payload payload metadata)
        if digest_info
          let verified = metadata.verified
          if (verified.get(digest_info.algorithm) == digest_info.expected)
            return payload
          let actual = (file_digest payload digest_info.constructor)
          if (actual == digest_info.expected)
            verified[digest_info.algorithm] = digest_info.expected
            write_metadata $metadata_path $metadata
            return payload
        self.#download $identity $entry $name $metadata $digest_info
      else if (type metadata Partial)
        # Resume against the name the interrupted download was using.
        self.#download $identity $entry $name $metadata $digest_info
      else
        self.#download $identity $entry $payload_name $metadata $digest_info

# Resolves a local path or downloads an HTTP(S) URL into the application cache.
#
# A cached response is revalidated with whatever validators the server supplied
# for it. An interrupted download is kept and resumed with a range request on
# the next call, falling back to a full download when the server ignores the
# range or the representation has changed.
pub def get
  # Local path or HTTP(S) URL to resolve.
  source @ (Str | Url | Path)
  # Application name selecting the cache directory.
  #
  # Defaults to the name of the running program. Not valid together with
  # `cache`.
  :app @ Str = nil
  # Expected digest, as `algorithm:hex`.
  #
  # Supported algorithms are BLAKE3, MD5, SHA-1, SHA-256, and SHA-512. An entry
  # already verified against the digest is returned without contacting the
  # server.
  :digest @ Str = nil
  # Explicit cache directory.
  #
  # Bypasses `app` and `fs.cache_dir` entirely, and is not valid together with
  # `app`. Mainly useful for tests that want an isolated, disposable cache
  # root.
  :cache @ (Str | Path) = nil
do -> Path
  if (app != nil && cache != nil)
    throw std.ValueError "app: not valid together with cache"
  let location = parse_location $source
  if (type location Path)
    if (digest != nil)
      let digest_info = digest_spec $digest
      let actual = file_digest $location $digest_info.constructor
      if (actual != digest_info.expected)
        throw std.ValueError "digest mismatch for $location"
    return location

  let root = if (cache != nil)
    Path $cache
  else
    (fs.cache_dir app: (normalize_app app) / "transfer")
  (Cache root).get(location, digest)

def put_path source @ Path destination @ Path -> nil
  let parent = destination.parent
  if (parent != nil)
    parent.create_dir all: true
  let tmp = destination.add_ext tmp
  try
    source.copy $tmp
    tmp.rename $destination
  finally
    tmp.remove ignore: true

def put_url source @ Path destination @ Url headers @ (std.BaseDict[Str | Sym, Str] | nil) -> nil
  let total = source.metadata().size
  let message = (destination.name || str destination)
  progress.show :message :total icon: ⬆️ units: :BYTES: do |indicator|
    source.open rb do |file|
      let track = do |chunk @ Bin| -> Bin
        indicator.delta $chunk.len
        chunk
      let chunks = (file.map track)
      let response = http.put(destination, headers: (headers || ({} @ Dict[Str, Str])), body: chunks)
      response.close()

# Copies or uploads `source` to `destination`.
pub def put
  # Local path or HTTP(S) URL to copy from.
  #
  # A URL is resolved through [`get`](transfer.get) first.
  source @ (Str | Url | Path)
  # Local path or HTTP(S) URL to write to.
  destination @ (Str | Url | Path)
  # Request headers for an HTTP(S) destination.
  #
  # Only valid for an HTTP(S) destination.
  :headers @ std.BaseDict[Str | Sym, Str] = nil
do -> nil
  let from = (parse_location source)
  let local = if (type from Url)
    get $from
  else
    from
  let to = (parse_location destination)
  if (type to Url)
    put_url $local (require_http to) $headers
  else
    if (headers != nil)
      throw std.ValueError "headers: only valid for an HTTP destination"
    put_path $local $to

let ARCHIVE_FORMATS @ Set[ArchiveFormat] = Set $
  :TAR: :TAR_GZIP: :TAR_ZSTD: :ZIP:

let INPUT_FORMATS @ Set[UnpackFormat] = Set $
  :TAR: :TAR_GZIP: :TAR_ZSTD: :ZIP: :GZIP: :ZSTD: :XZ:

def parse_input_format format @ (UnpackFormat | nil) -> (UnpackFormat | nil)
  if (format == nil)
    return nil
  if !(INPUT_FORMATS.contains format)
    throw std.ValueError "format: expected :TAR:, :TAR_GZIP:, :TAR_ZSTD:, :ZIP:, :GZIP:, :ZSTD:, or :XZ:"
  format

def parse_archive_format format @ (ArchiveFormat | nil) -> (ArchiveFormat | nil)
  if (format == nil)
    return nil
  if !(ARCHIVE_FORMATS.contains format)
    throw std.ValueError "format: expected :TAR:, :TAR_GZIP:, :TAR_ZSTD:, or :ZIP:"
  format

def archive_format_from_name name @ (Str | nil) -> (ArchiveFormat | nil)
  if (name == nil)
    return nil
  let lower = name.lower()
  if lower.ends_with ".zip"
    :ZIP:
  else if (lower.ends_with ".tar.gz" || lower.ends_with ".tgz")
    :TAR_GZIP:
  else if (lower.ends_with ".tar.zst" || lower.ends_with ".tzst")
    :TAR_ZSTD:
  else if lower.ends_with ".tar"
    :TAR:

def input_format_from_name name @ (Str | nil) -> (UnpackFormat | nil)
  let format = archive_format_from_name $name
  if (format != nil || name == nil)
    return format
  let lower = name.lower()
  if lower.ends_with ".gz"
    :GZIP:
  else if lower.ends_with ".zst"
    :ZSTD:
  else if lower.ends_with ".xz"
    :XZ:

def sniff_format path @ Path -> UnpackFormat
  let head = path.open rb do |file| file.read 512
  if (head.starts_with b"PK\x03\x04" || head.starts_with b"PK\x05\x06" ||
      head.starts_with b"PK\x07\x08")
    :ZIP:
  else if head.starts_with b"\x1f\x8b"
    :TAR_GZIP:
  else if head.starts_with b"\x28\xb5\x2f\xfd"
    :TAR_ZSTD:
  else if head.starts_with b"\xfd7zXZ\x00"
    :XZ:
  else
    :TAR:

def input_format path @ Path format @ (UnpackFormat | nil) -> UnpackFormat
  (parse_input_format format || input_format_from_name path.name || sniff_format path)

def output_format destination @ (Url | Path) format @ (ArchiveFormat | nil) -> ArchiveFormat
  let selected = (parse_archive_format format || archive_format_from_name destination.name)
  if (selected == nil)
    throw std.ValueError "can't infer archive format from destination"
  selected

def compression_for format @ ArchiveFormat -> (:NONE: | :GZIP: | :ZSTD:)
  if (format == :TAR_GZIP:)
    :GZIP:
  else if (format == :TAR_ZSTD:)
    :ZSTD:
  else
    :NONE:

def safe_components path @ (Str | Path) label @ Str -> Seq[Str]
  let relative = UnixPath $path
  if relative.is_absolute
    throw std.ValueError "$label must be relative: $relative"
  let parts = relative.components
  if (parts.len == 0 ||
      parts.any(do |p| p == "" || p == "." || p == ".."))
    throw std.ValueError "unsafe $label: $relative"
  parts

def archive_name path @ Path source @ Path prefix @ Seq[Str] -> Path
  let relative = if (path == source)
    let name = path.name
    if (name == nil)
      throw std.ValueError "can't pack a path with no final component: $path"
    name
  else
    path.relative $source
  UnixPath.join ...prefix $relative

# Metadata for one packed entry, spread into the writer's call.
@let EntryMetadata = $
  mode: Int
  uid: Int
  gid: Int
  mtime: DateTime
  ?owner_name: Str
  ?group_name: Str

# Looks up the name of a file's owner or group, given as `Metadata.owner` or
# `Metadata.group` reports it.
def account_name id @ (Int | Sid) kind @ (:USER: | :GROUP:) -> (Str | nil)
  try
    if (type id Int)
      if (kind == :USER:)
        security_unix.user_name $id
      else
        security_unix.group_name $id
    else
      id.lookup().qualified_name
  catch sys.NotFoundError: _
    nil

def filesystem_metadata
  path @ Path
  kind @ (:FILE: | :DIR: | :SYMLINK:)
  options @ Dict[PackOptions]
do -> Dict[EntryMetadata]
  let metadata = path.metadata resolve: :LINK:
  let unix = (sys.os_info().family != :WINDOWS:)
  let requested default_mode = if (kind == :DIR:)
    (options.get(:dir_mode:), 0o755)
  else if (kind == :SYMLINK:)
    (options.get(:link_mode:), 0o777)
  else
    (options.get(:mode:), 0o644)
  let owner_name = options.get :owner_name: else: do account_name $metadata.owner :USER:
  let group_name = options.get :group_name: else: do account_name $metadata.group :GROUP:
  $
    mode: (_vfs.parse_mode(requested) || (unix && (metadata.mode.int & 0o7777)) || default_mode)
    uid: (options.get(:uid:) || (unix && metadata.uid) || 0)
    gid: (options.get(:gid:) || (unix && metadata.gid) || 0)
    mtime: (options.get(:mtime:) || metadata.modified || DateTime.from_unix(0))
    if owner_name
      :owner_name
    if group_name
      :group_name

def source_entries source @ Path -> Array[Path]
  let metadata = (source.metadata resolve: :LINK:)
  if (metadata.type == :DIR:)
    # `**` matches the source directory itself, which sorts first and must not
    # become an entry
    [...(source.glob "**" resolve: :LINK:).skip(1)]
  else
    [source]

def pack_tar
  source @ Path
  destination @ Path
  format @ ArchiveFormat
  prefix @ Seq[Str]
  metadata @ Dict[PackOptions]
  indicator @ progress.Indicator
do -> nil
  tar.write $destination compression: (compression_for format) do |archive|
    for path = source_entries(source)
      let file_metadata = (path.metadata resolve: :LINK:)
      let name = (archive_name path source prefix)
      if (file_metadata.type == :DIR:)
        let values = (filesystem_metadata path :DIR: metadata)
        archive.create_dir $name ...values
      else if (file_metadata.type == :SYMLINK:)
        let link = path.read_link()
        let target = (packed_link name link prefix path)
        let values = (filesystem_metadata path :SYMLINK: metadata)
        archive.symlink $target $name ...values
      else if (file_metadata.type == :FILE:)
        let values = (filesystem_metadata path :FILE: metadata)
        archive.entry $name size: $file_metadata.size ...values do |entry|
          path.open rb do |file|
            for chunk = file
              entry.write $chunk
              indicator.delta $chunk.len
      else
        throw std.ValueError "unsupported file type while packing: $path"

def pack_zip
  source @ Path
  destination @ Path
  prefix @ Seq[Str]
  metadata @ Dict[PackOptions]
  indicator @ progress.Indicator
do -> nil
  zip.open $destination w do |archive|
    for path = source_entries(source)
      let file_metadata = path.metadata resolve: :LINK:
      let name = (archive_name path source prefix)
      if (file_metadata.type == :DIR:)
        let values = (filesystem_metadata path :DIR: metadata)
        archive.create_dir (str name) mode: $values[:mode:]
      else if (file_metadata.type == :SYMLINK:)
        let link = path.read_link()
        let target = (packed_link name link prefix path)
        let values = (filesystem_metadata path :SYMLINK: metadata)
        archive.symlink (str target) (str name) mode: $values[:mode:]
      else if (file_metadata.type == :FILE:)
        let values = (filesystem_metadata path :FILE: metadata)
        # The size hint reserves the ZIP64 fields in the local file header,
        # without which an entry over 4 GiB cannot be written at all.
        archive.open (str name) mode: $values[:mode:] size: $file_metadata.size do |entry|
          path.open rb do |file|
            for chunk = file
              entry.write $chunk
              indicator.delta $chunk.len
      else
        throw std.ValueError "unsupported file type while packing: $path"

def pack_local
  source @ Path
  archive @ Path
  destination @ (Url | Path)
  format @ ArchiveFormat
  prefix @ Seq[Str]
  metadata @ Dict[PackOptions]
do -> nil
  let total = 0
  for path = source_entries(source)
    let item_metadata = path.metadata resolve: :LINK:
    if (item_metadata.type == :FILE:)
      total = (total + item_metadata.size)
  let message = (destination.name || str destination)
  progress.show :message :total units: :BYTES: do |indicator|
    if (format == :ZIP:)
      pack_zip $source $archive $prefix $metadata $indicator
    else
      pack_tar $source $archive $format $prefix $metadata $indicator

# Options for [`pack`](transfer.pack) that override what the filesystem reports
# for each entry.
pub @let PackOptions = $
  # Permissions for regular files. Defaults to the source mode, or `0o644` when
  # unavailable.
  ?mode: (Int | Mode)
  # Permissions for directories. Defaults to the source mode, or `0o755` when
  # unavailable.
  ?dir_mode: (Int | Mode)
  # Permissions for symlinks. Defaults to the source mode, or `0o777` when
  # unavailable.
  ?link_mode: (Int | Mode)
  # Owner ID. Defaults to the source owner, or `0` when unavailable.
  ?uid: Int
  # Group ID. Defaults to the source group, or `0` when unavailable.
  ?gid: Int
  # Owner name. Defaults to the source owner's qualified name when it can be
  # looked up.
  ?owner_name: Str
  # Group name. Defaults to the source group's qualified name when it can be
  # looked up.
  ?group_name: Str
  # Modification time. Defaults to the source modification time, or the Unix
  # epoch when unavailable.
  ?mtime: DateTime

# Packs a file or directory into TAR, compressed TAR, or ZIP.
#
# Directory contents are relative to the source root.
pub def pack
  # File or directory to pack.
  source @ (Str | Url | Path)
  # Archive to write.
  destination @ (Str | Url | Path)
  # Archive format.
  #
  # Inferred from the destination name when omitted, which fails if the name
  # carries no recognized extension.
  :format @ ArchiveFormat = nil
  # Relative path prepended to every archive entry.
  :prefix @ (Str | Path) = nil
  # Overrides for the metadata of each entry.
  ...options @ PackOptions
do -> nil
  let overrides @ Dict[PackOptions] = {...options}
  let from = (parse_location source)
  let local = if (type from Url)
    get $from
  else
    from
  let to = (parse_location destination)
  let parts @ Seq[Str] = if (prefix == nil)
    ([] @ Array[Str])
  else
    safe_components $prefix "prefix"
  let selected = (output_format to format)
  if (type to Url)
    with_temp_dir do |dir|
      let temporary = (dir / (to.name || "archive"))
      pack_local $local $temporary $to $selected $parts $overrides
      put $temporary $to
  else
    let parent = to.parent
    if (parent != nil)
      parent.create_dir all: true
    let tmp = to.add_ext tmp
    try
      pack_local $local $tmp $to $selected $parts $overrides
      tmp.rename $to
    finally
      tmp.remove ignore: true

def link_path path @ (Str | Path) label @ Str -> UnixPath
  let link = UnixPath $path
  if link.is_absolute
    throw std.ValueError "$label must be relative: $link"
  if (link.components.len == 0)
    throw std.ValueError "unsafe $label: $link"
  link

def packed_link name @ Path target @ Path prefix @ Seq[Str] source @ Path -> UnixPath
  let link = (link_path target "symlink target")
  let name_parts = name.components[prefix.len..]
  let resolved_parts = (resolve_link name_parts link).components
  if (resolved_parts.len > 0 && resolved_parts[0] == "..")
    throw std.ValueError "symlink escapes archive root: $source"
  link

# Fields of an archive entry, as parsed from the archive.
@let EntryFields = $
  raw: Str
  parts: Seq[Str]
  kind: (:FILE: | :DIR: | :SYMLINK: | :HARDLINK:)
  size: Int
  mode: (Int | nil)
  mtime: (DateTime | nil)
  # The target of a symlink or hard link, as the archive gives it.
  link: (Str | nil)

# One archive entry, as parsed from the archive.
class ArchiveEntry: Struct[EntryFields]

@let PlacedFields = $
  ...EntryFields
  output_parts: Seq[Str]
  output: Str
  resolved_link: (Str | nil)

# An archive entry and where it lands. Normalizing the manifest fills in
# `resolved_link` once every output is known.
class Placed: Struct[PlacedFields]

def strip_count entries @ Array[ArchiveEntry] strip @ (Int | :ROOT:) -> Int
  if (strip == :ROOT:)
    if (entries.len == 0)
      throw std.ValueError "strip: :ROOT: requires a non-empty archive"
    let root ...rest = [...entries.map do |p| p.parts[0]]
    if [...rest].any do |x| (x != root)
      throw std.ValueError "strip: :ROOT: requires one shared root component"
    1
  else if (type strip Int && strip >= 0)
    strip
  else
    throw std.ValueError "strip: expected a non-negative Int or :ROOT:"

def record_path parts @ Seq[Str] -> Str
  let path = UnixPath.join ...parts
  str $path

def resolve_link output_parts @ Seq[Str] target @ UnixPath -> Path
  let output = UnixPath.join ...output_parts
  let parent = output.parent
  if (parent == nil)
    throw std.ValueError "empty output path"
  UnixPath.join(parent, target).normalize()

def normalize_manifest
  entries @ Array[ArchiveEntry]
  strip @ (Int | :ROOT:)
do -> (Array[Placed], Dict[Str, Placed])
  let count = (strip_count entries strip)
  let outputs @ Dict[Str, Placed] = {}
  let placed @ Array[Placed] = []

  for item = entries
    let parts = item.parts
    if (parts.len < count)
      throw std.ValueError "archive path has fewer than $count components: $item.raw"
    let output_parts = parts[count..]
    if (output_parts.len == 0)
      if (item.kind != :DIR:)
        throw std.ValueError "stripping removes archive entry path: $item.raw"
    else
      let output = (record_path output_parts)
      if (outputs.contains output)
        throw std.ValueError "duplicate archive output: $output"
      for end = 1..output_parts.len
        let ancestor_key = (record_path output_parts[..end])
        let ancestor_record = (outputs.get ancestor_key)
        if (ancestor_record && ancestor_record.kind != :DIR:)
          throw std.ValueError "archive path conflicts with non-directory: $ancestor_key"
      if (item.kind != :DIR:)
        let prefix = "$output/"
        if outputs.keys().any(do |key| key.starts_with prefix)
          throw std.ValueError "archive path conflicts with directory: $output"
      let place = Placed {...item, :output_parts, :output, resolved_link: nil}
      outputs[output] = place
      placed.push $place

  for item = placed
    let link = item.link
    if (link == nil)
      continue
    if (item.kind == :SYMLINK:)
      let target = (link_path link "symlink target")
      let resolved_parts = (resolve_link item.output_parts target).components
      if (resolved_parts.len > 0 && resolved_parts[0] == "..")
        throw std.ValueError "link target escapes extraction root"
      item.resolved_link = (record_path resolved_parts)
    else if (item.kind == :HARDLINK:)
      let target_parts = (safe_components link "hard-link target")
      if (target_parts.len < count)
        throw std.ValueError "hard-link target removed by strip: $link"
      let target = (record_path target_parts[count..])
      let target_record = (outputs.get target)
      if (target_record == nil || target_record.kind != :FILE:)
        throw std.ValueError "hard-link target is not a regular archive file: $link"
      item.resolved_link = target

  (placed, outputs)

def output_path root @ Path item @ Placed -> Path
  (root / item.output)

def create_directories root @ Path placed @ Array[Placed] -> nil
  for item = placed
    let destination = (output_path root item)
    if (item.kind == :DIR:)
      destination.create_dir all: true
    else
      let parent = destination.parent
      if (parent != nil)
        parent.create_dir all: true

def apply_metadata path @ Path item @ Placed -> nil
  if !path.exists()
    throw std.ValueError "archive entry was not extracted: $item.output"
  let modified = item.mtime
  let mode = item.mode
  if (sys.os_info().family != :WINDOWS: && mode != nil)
    path.update_metadata mode: (mode & 0o7777)
  if modified
    path.update_metadata :modified

def finish_links
  root @ Path
  placed @ Array[Placed]
  outputs @ Dict[Str, Placed]
do -> nil
  for item = placed
    let target = item.resolved_link
    if (item.kind == :HARDLINK: && target != nil)
      let source = (root / target)
      source.hard_link (output_path root item)

  for item = placed
    let link = item.link
    let resolved = item.resolved_link
    if (item.kind == :SYMLINK: && link != nil && resolved != nil)
      let destination = (output_path root item)
      let target_record = (outputs.get resolved)
      if (target_record && target_record.kind == :DIR:)
        fs.symlink_dir $link $destination
      else
        fs.symlink_file $link $destination

def finish_metadata root @ Path placed @ Array[Placed] -> nil
  for item = placed
    if (item.kind == :FILE:)
      apply_metadata (output_path root item) $item
  for item = placed
    if (item.kind == :DIR:)
      apply_metadata (output_path root item) $item

def prepare_extraction root @ Path placed @ Array[Placed] -> Int
  create_directories $root $placed
  let total = 0
  for item = placed
    if (item.kind == :FILE:)
      total = (total + item.size)
  total

class TarUnpack
  field source @ Path
  # Raw paths `parse` saw, including entries that stripping drops.
  field parsed @ Set[Str]

  def (init) self source @ Path
    self.#source = source
    self.#parsed = Set()

  pub def parse self -> Array[ArchiveEntry]
    let entries @ Array[ArchiveEntry] = []
    tar.read $self.#source do |archive|
      for entry = archive
        let kind = entry.type
        if !(kind == :FILE: || kind == :DIR: || kind == :SYMLINK: ||
             kind == :HARDLINK:)
          throw std.ValueError "unsupported TAR entry type: $kind"
        let raw = (str entry.path)
        if (self.#parsed.contains raw)
          throw std.ValueError "duplicate archive entry: $raw"
        self.#parsed.add $raw
        let parts = (safe_components entry.path "archive path")
        let link_name = entry.link_name
        let link = if (kind == :SYMLINK: || kind == :HARDLINK:)
          if (link_name == nil)
            throw std.ValueError "archive link is missing its target: $raw"
          str $link_name
        else
          nil
        entries.push $ ArchiveEntry $
          :raw :parts :kind :link
          size: $entry.size
          mode: $entry.mode
          mtime: $entry.mtime
    entries

  pub def extract
    self
    root @ Path
    placed @ Array[Placed]
    outputs @ Dict[Str, Placed]
  do -> nil
    let by_raw @ Dict[Str, Placed] = $
      for item = placed
        $item.raw: $item
    let total = (prepare_extraction root placed)
    let message = (self.#source.name || str self.#source)
    progress.show :message :total units: :BYTES: do |indicator|
      tar.read $self.#source do |archive|
        for entry = archive
          let raw = (str entry.path)
          if !(self.#parsed.contains raw)
            throw std.ValueError "manifest entry missing during TAR extraction: $raw"
          # Entries that stripping drops have no placement.
          let item = (by_raw.get raw)
          if (item != nil && item.kind == :FILE:)
            let destination = (output_path root item)
            destination.open wb do |file|
              for chunk = entry
                file.write $chunk
                indicator.delta $chunk.len
    finish_links $root $placed $outputs
    finish_metadata $root $placed

class ZipUnpack
  field source @ Path

  def (init) self source @ Path
    self.#source = source

  pub def parse self -> Array[ArchiveEntry]
    let entries @ Array[ArchiveEntry] = []
    zip.open $self.#source do |archive|
      let seen @ Set[Str] = Set()
      for entry = archive.entries
        let raw = (str entry.name)
        if (seen.contains raw)
          throw std.ValueError "duplicate ZIP entry: $raw"
        seen.add $raw
        let kind = entry.type
        if !(kind == :FILE: || kind == :DIR: || kind == :SYMLINK:)
          throw std.ValueError "unsupported ZIP entry type: $raw"
        let parts = (safe_components raw "archive path")
        let link = if (kind == :SYMLINK:)
          entry.open do |file|
            let target = (file.read(entry.size + 1))
            file.read 1
            str $target
        else
          nil
        entries.push $ ArchiveEntry $
          :raw :parts :kind :link
          size: $entry.size
          mode: $entry.mode
          mtime: nil
    entries

  pub def extract
    self
    root @ Path
    placed @ Array[Placed]
    outputs @ Dict[Str, Placed]
  do -> nil
    let total = (prepare_extraction root placed)
    let message = (self.#source.name || str self.#source)
    progress.show :message :total units: :BYTES: do |indicator|
      zip.open $self.#source do |archive|
        for item = placed
          if (item.kind == :FILE:)
            archive.open $item.raw do |entry|
              let destination = (output_path root item)
              destination.open wb do |file|
                let remaining = item.size
                while (remaining > 0)
                  let amount = if (remaining < 65536)
                    remaining
                  else
                    65536
                  let chunk = (entry.read amount)
                  if (chunk.len == 0)
                    throw std.ValueError "truncated ZIP entry: $item.raw"
                  file.write $chunk
                  indicator.delta $chunk.len
                  remaining = (remaining - chunk.len)
                entry.read 1
    finish_links $root $placed $outputs
    finish_metadata $root $placed

# Raised when unpacking a raw compressed stream (gzip, Zstandard, XZ) fails.
pub class ArchiveError: std.RuntimeError
  # The stream that failed to unpack.
  pub field source @ Path = nil
  # The failing tool's error output, when it printed exactly one line.
  pub field detail @ (Str | nil) = nil

  def (init) self source @ Path detail @ (Str | nil) = nil
    std.RuntimeError.(init) $self
      if detail
        "archive operation failed: $source: $detail"
      else
        "archive operation failed: $source"
    self.source = source
    self.detail = detail

def decompress_raw
  source @ Path
  destination @ Path
  format @ (:GZIP: | :ZSTD: | :XZ:)
do -> nil
  let prog = if (format == :GZIP:)
    "gzip"
  else if (format == :ZSTD:)
    "zstd"
  else
    "xz"

  # Capture stderr instead of letting it leak straight to the real process
  # stderr, and use it for a clearer error on failure — a bare `proc.Error`
  # only reports the exit status, not why the tool failed. Only the
  # single-line case is handled specially; anything more just rethrows the
  # original error rather than guessing how to summarize it. If there's more
  # than a single line, dump it to stderr for logging purposes (same as
  # libvirt's fallback for unrecognized errors) before rethrowing.
  let lines @ Array[Str] = []
  try
    destination.open wb do |file|
      run $prog -dc -- $source stdin: [] stdout: $file stderr: $lines.prechomp()
  catch proc.Error: e
    if (lines.len == 1)
      throw ArchiveError $source $lines[0]
    if lines.len
      echo $"\n".join(lines)
    throw e

# Safely extracts an archive or decompresses a single file into a new
# destination.
#
# Extraction validates the whole manifest before writing anything, rejecting
# unsafe or conflicting paths. Raw decompression runs the corresponding `gzip`,
# `zstd`, or `xz` program.
pub def unpack
  # Archive or compressed file to extract.
  source @ (Str | Url | Path)
  # Path to create.
  #
  # Must not already exist, and may not be a URL.
  destination @ (Str | Path)
  # Input format.
  #
  # Inferred from the source name when omitted. A compressed TAR archive is
  # distinguished from a raw stream by filename: `.tar.gz` selects
  # `:TAR_GZIP:` while `.gz` selects `:GZIP:`.
  :format @ UnpackFormat = nil
  # Leading path components to
  # strip from each entry.
  #
  # `:ROOT:` strips one component, and requires a non-empty archive whose
  # entries share a single root component. Raw streams require `0`.
  :strip @ (Int | :ROOT:) = 0
  # Application name selecting the cache directory,
  # for a URL source.
  :app @ Str = nil
do -> nil
  let from = (parse_location source)
  let local = if (type from Url)
    get $from
      if (app != nil)
        :app
  else
    from
  let to = match parse_location(destination)
    Url(_) do throw std.ValueError "unpack destination must be a path"
    path do path
  if to.exists()
    throw std.ValueError "unpack destination already exists: $to"

  let selected = (input_format local format)
  let parent = (to.parent || Path ".")
  if (selected == :GZIP: || selected == :ZSTD: || selected == :XZ:)
    if (strip != 0)
      throw std.ValueError "strip: not valid for raw compressed input"
    parent.create_dir all: true
    with_temp_dir :parent do |staging|
      let output = (staging / "output")
      decompress_raw $local $output $selected
      if to.exists()
        throw std.ValueError "unpack destination appeared during decompression: $to"
      output.rename $to
    return nil

  let unpacker = if (selected == :ZIP:)
    ZipUnpack $local
  else
    TarUnpack $local
  let placed outputs = normalize_manifest $unpacker.parse() $strip
  parent.create_dir all: true
  with_temp_dir :parent do |staging|
    unpacker.extract $staging $placed $outputs
    if to.exists()
      throw std.ValueError "unpack destination appeared during extraction: $to"
    staging.rename $to
