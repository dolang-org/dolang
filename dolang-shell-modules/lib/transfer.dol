# Downloads, uploads, packs, and safely extracts artifacts.
#
# A URL source is resolved through `get` wherever one is accepted, so its cache
# serves `put`, `pack`, and `unpack` as well.
#
# Results are published atomically: output is staged and renamed into place, so
# an interrupted operation leaves no partial destination behind.

import _vfs digest fs http json proc progress shell std sys tar zip
  fs:
    - Path
    - with_temp_dir
  regex:
    - Regex
  time:
    - DateTime
  url:
    - Url

import fs.unix: unix_fs
import security.unix: security_unix

let DIGESTS = $
  "blake3": $digest.Blake3
  "md5": $digest.Md5
  "sha1": $digest.Sha1
  "sha256": $digest.Sha256
  "sha512": $digest.Sha512

let HEX_DIGEST = Regex r"^[0-9a-f]+$"

let CONTENT_RANGE = Regex r"^bytes (\d+)-(\d+)/(\d+|\*)$"

def parse_location value
  if (type value Url || type value Path)
    value
  else if (type value Str)
    if (value.starts_with "http://" || value.starts_with "https://")
      Url $value
    else
      Path $value
  else
    throw std.TypeError "expected `Str`, `Url`, or `Path`"

def require_http url
  if !(url.scheme == "http" || url.scheme == "https")
    throw std.ValueError "unsupported URL scheme: $url.scheme"
  url

def default_app()
  let program = shell.program
  if (program == nil)
    throw std.ValueError "app: required when shell.program is unavailable"
  let app = if (type program Path)
    (program.stem || program.name)
  else
    str $program
  if (app == nil || app == "")
    throw std.ValueError "can't infer cache app from shell.program"
  app

def normalize_app app
  app = str (app || default_app())
  app = app.replace("/", "_").replace("\\", "_")
  if (app == "" || app == "." || app == "..")
    throw std.ValueError "cache app name must not be empty"
  app

def normalized_url value
  require_http(Url value).with_fragment nil

def safe_leaf name
  if (name == nil || name == "" || name == "." || name == "..")
    return "data"
  name.replace("/", "_").replace("\\", "_")

def digest_spec spec
  if !(type spec Str)
    throw std.TypeError "digest: expected `algorithm:hex` string"
  let parts = [...spec.lower().split ":" limit: 1]
  if (parts.len != 2)
    throw std.ValueError "digest: expected `algorithm:hex`"
  let algorithm expected = parts
  let constructor = DIGESTS.get $algorithm else: do
    throw std.ValueError "digest: unsupported algorithm: $algorithm"
  let expected_len = (constructor().digest().len * 2)
  if (expected.len != expected_len ||
      !HEX_DIGEST.match(expected))
    throw std.ValueError "digest: invalid $algorithm hex value"
  record :algorithm :expected :constructor

def digest_state path constructor
  let state = constructor()
  path.open rb do |file|
    for chunk = file
      state.update $chunk
  state

def file_digest path constructor
  "${digest_state(path, constructor).digest():x}"

def read_metadata path identity
  if !path.exists()
    return nil
  try
    let metadata = json.decode(path.read())
    if (metadata.get("version") != 1 || metadata.get("url") != identity)
      nil
    else
      metadata
  catch _
    nil

def write_metadata path metadata
  let tmp = path.add_ext tmp
  try
    tmp.write $ json.encode(metadata)
    tmp.rename $path
  finally
    tmp.remove ignore: true

def metadata_payload entry metadata fallback
  let name = (metadata && metadata.get("payload"))
  (entry / (name || fallback))

def intact_payload payload metadata
  # An absent `state` means complete, so metadata written before resumable
  # downloads existed still reads as a usable payload.
  if (metadata == nil || metadata.get("state") != nil || !payload.exists())
    return false
  try
    (payload.metadata().type == :FILE: &&
      payload.metadata().size == metadata.get("size"))
  catch _
    false

def file_size path
  try
    let info = path.metadata()
    if (info.type == :FILE:)
      info.size
    else
      nil
  catch _
    nil

# The resume offset for a retained partial, or `nil` to start over. The actual
# size of the sidecar is authoritative; metadata only says whether the bytes
# can be trusted and what the whole representation is expected to look like.
def partial_offset part metadata
  if (metadata == nil || metadata.get("state") != "partial")
    return nil
  let size = (file_size part)
  if (size == nil || size == 0)
    return nil
  let total = metadata.get "total"
  # At or past the recorded total there is nothing left to ask for, and no way
  # to tell a complete download from a corrupt one without a validator.
  if (total != nil && size >= total)
    return nil
  size

def conditional_headers metadata
  let headers = {}
  let etag = metadata.get "etag"
  let modified = metadata.get "last_modified"
  if etag
    headers["if-none-match"] = etag
  if modified
    headers["if-modified-since"] = DateTime.parse_rfc $modified
  headers

def range_headers metadata offset
  let headers = {}
  headers["range"] = "bytes=$offset-"
  let etag = metadata.get "etag"
  let modified = metadata.get "last_modified"
  # `If-Range` needs a strong validator: a weak ETag says two representations
  # are equivalent, not byte-identical, which is not enough to splice ranges.
  if (etag && !etag.starts_with "W/")
    headers["if-range"] = etag
  else if modified
    headers["if-range"] = DateTime.parse_rfc $modified
  headers

def parse_content_range value
  if (value == nil)
    return nil
  let captures = CONTENT_RANGE.match(str value)
  if (captures == nil)
    return nil
  let raw = (str captures[3])
  let total = if (raw == "*")
    nil
  else
    int $raw
  record start: (int (str captures[1])) :total

def partial_metadata identity response payload total
  let headers = response.headers
  let modified = (headers.get "last-modified")
  let now = DateTime.now().rfc()
  return $
    version: 1
    url: $identity
    final_url: (str response.url)
    payload: $payload.name
    state: "partial"
    etag: (headers.get "etag")
    last_modified: (modified && modified.rfc())
    total: $total
    fetched_at: $now

def response_metadata identity response payload digest_info
  let headers = response.headers
  # Digests verified against a previous representation say nothing about the
  # bytes just downloaded, so `verified` starts empty on every fresh body.
  let verified = {}
  if digest_info
    verified[digest_info.algorithm] = digest_info.expected
  let now = DateTime.now().rfc()
  let modified = (headers.get "last-modified")
  return $
    version: 1
    url: $identity
    final_url: (str response.url)
    payload: $payload.name
    etag: (headers.get "etag")
    last_modified: (modified && modified.rfc())
    size: $payload.metadata().size
    fetched_at: $now
    checked_at: $now
    verified: $verified

class Cache
  field root = nil
  field client = http.Client()

  def (init) self app cache
    self.#root = if (cache != nil)
      Path $cache
    else
      (fs.cache_dir app: (normalize_app app) / "transfer")

  def entry self url
    let identity = str(normalized_url url)
    let key = "${digest.blake3(identity):x}"
    let entry = (self.#root / key)
    entry.create_dir all: true
    [identity, entry]

  # Streams the body into the `.part` sidecar, appending to it when resuming.
  # Returns the payload, or `:RETRY:` when the request has to be reissued
  # without the range and validators it was conditioned on.
  def fetch self identity entry payload part metadata digest_info offset indicator
    let metadata_path = (entry / "metadata.json")
    let headers = if (offset != nil)
      range_headers $metadata $offset
    else if (metadata && metadata.get("state") == nil && digest_info == nil)
      conditional_headers $metadata
    else
      {}
    let message = (payload.name || identity)

    self.#client.get $identity headers: $headers status: :IGNORE: do |response|
      if (response.status == 304 && intact_payload(payload, metadata))
        metadata["checked_at"] = DateTime.now().rfc()
        write_metadata $metadata_path $metadata
        let total = metadata["size"]
        indicator.update message: "$message (cached)" :total position: $total units: :BYTES:
        return payload

      if (response.status == 304)
        # The validators still match, but the payload they stand for is gone or
        # the wrong size, so there is nothing to serve and no body to fall back
        # on. Ask again without them rather than publishing the empty response.
        return :RETRY:

      let append = false
      let total = nil

      if (offset != nil)
        if (response.status == 416)
          # The partial no longer lines up with the representation at all.
          part.remove ignore: true
          return :RETRY:
        if (response.status == 206)
          let range = (parse_content_range (response.headers.get "content-range"))
          if (range == nil || range.start != offset)
            part.remove ignore: true
            return :RETRY:
          append = true
          total = range.total
        else
          # A `200` means the range was ignored (or `If-Range` failed), so the
          # body is the whole representation: start over without another
          # request.
          response.throw_for_status()
          offset = nil
      else
        response.throw_for_status()

      if !append
        let length = (response.headers.get "content-length")
        total = (length && int length)

      if append
        indicator.update total: $total position: $offset units: :BYTES:
      else
        indicator.update total: $total units: :BYTES:

      # Recorded before the first byte lands so an abrupt exit still leaves an
      # entry that says what the sidecar holds and how to resume it.
      let pending = (partial_metadata identity response payload total)
      write_metadata $metadata_path $pending

      let state = if (digest_info == nil)
        nil
      else if append
        digest_state $part $digest_info.constructor
      else
        digest_info.constructor()

      let mode = if append
        "ab"
      else
        "wb"
      part.open $mode do |file|
        for chunk = response.chunks()
          file.write $chunk
          if state
            state.update $chunk
          indicator.delta $chunk.len

      let size = part.metadata().size
      if (total != nil && size != total)
        # The sidecar and its metadata stay put: the next `get` resumes here.
        throw std.ValueError "incomplete download for $identity: got $size of $total bytes"
      if (state && "${state.digest():x}" != digest_info.expected)
        part.remove ignore: true
        metadata_path.remove ignore: true
        throw std.ValueError "digest mismatch for $identity"

      part.rename $payload
      let updated = (response_metadata identity response payload digest_info)
      write_metadata $metadata_path $updated
      payload

  def download self identity entry payload metadata digest_info
    let part = payload.add_ext part
    let offset = (partial_offset part metadata)
    let message = (payload.name || identity)
    progress.show :message icon: ⬇️ do |indicator|
      let result = self.#fetch $identity $entry $payload $part $metadata $digest_info $offset $indicator
      if (result == :RETRY:)
        # Retry with no metadata as well as no offset: what we knew about the
        # entry is exactly what the server just refused to honor, so sending
        # its validators again would only repeat the same answer.
        self.#fetch $identity $entry $payload $part nil $digest_info nil $indicator
      else
        result

  pub def get self url digest
    url = (normalized_url url)
    let identity entry = (self.#entry url)
    let payload_name = (safe_leaf url.name)
    let metadata_path = (entry / "metadata.json")
    let lock_path = (entry / "lock")
    let digest_info = (digest && digest_spec digest)

    lock_path.open a+ do |lock| lock.lock (..) do |_|
      let metadata = (read_metadata metadata_path identity)
      let payload = (metadata_payload entry metadata payload_name)
      if (intact_payload payload metadata)
        if digest_info
          let verified = (metadata.get "verified" || {})
          if (verified.get(digest_info.algorithm) == digest_info.expected)
            return payload
          let actual = (file_digest payload digest_info.constructor)
          if (actual == digest_info.expected)
            verified[digest_info.algorithm] = digest_info.expected
            metadata["verified"] = verified
            write_metadata $metadata_path $metadata
            return payload
        self.#download $identity $entry $payload $metadata $digest_info
      else if (metadata && metadata.get("state") == "partial")
        # Resume against the name the interrupted download was using.
        self.#download $identity $entry $payload $metadata $digest_info
      else
        self.#download $identity $entry (entry / payload_name) $metadata $digest_info

# Resolves a local path or downloads an HTTP(S) URL into the application cache.
#
# A cached response is revalidated with whatever validators the server supplied
# for it. An interrupted download is kept and resumed with a range request on
# the next call, falling back to a full download when the server ignores the
# range or the representation has changed.
pub def get
  # ([`Str`](std.Str)\|[`Url`](url.Url)\|[`fs.Path`](fs.Path))
  # Local path or HTTP(S) URL to resolve.
  source
  # ([`Str`](std.Str)) Application name selecting the cache directory.
  #
  # Defaults to the name of the running program. Not valid together with
  # `cache`.
  :app = nil
  # ([`Str`](std.Str)) Expected digest, as `algorithm:hex`.
  #
  # Supported algorithms are BLAKE3, MD5, SHA-1, SHA-256, and SHA-512. An entry
  # already verified against the digest is returned without contacting the
  # server.
  :digest = nil
  # ([`Str`](std.Str)\|[`fs.Path`](fs.Path)) Explicit cache directory.
  #
  # Bypasses `app` and `fs.cache_dir` entirely, and is not valid together with
  # `app`. Mainly useful for tests that want an isolated, disposable cache
  # root.
  :cache = nil
do
  if (app != nil && cache != nil)
    throw std.ValueError "app: not valid together with cache"
  source = parse_location $source
  if (type source Path)
    if (digest != nil)
      let digest_info = digest_spec $digest
      let actual = file_digest $source $digest_info.constructor
      if (actual != digest_info.expected)
        throw std.ValueError "digest mismatch for $source"
    return source

  (Cache app cache).get(source, digest)

def put_path source destination
  destination.parent.create_dir all: true
  let tmp = destination.add_ext tmp
  try
    source.copy $tmp
    tmp.rename $destination
  finally
    tmp.remove ignore: true

def put_url source destination headers
  let total = source.metadata().size
  let message = (destination.name || str destination)
  progress.show :message :total icon: ⬆️ units: :BYTES: do |indicator|
    source.open rb do |file|
      let track = do |chunk|
        indicator.delta $chunk.len
        chunk
      let chunks = (file.map track)
      let response = http.put(destination, headers: (headers || {}), body: chunks)
      response.close()
  nil

# Copies or uploads `source` to `destination`.
pub def put
  # ([`Str`](std.Str)\|[`Url`](url.Url)\|[`fs.Path`](fs.Path))
  # Local path or HTTP(S) URL to copy from.
  #
  # A URL is resolved through [`get`](transfer.get) first.
  source
  # ([`Str`](std.Str)\|[`Url`](url.Url)\|[`fs.Path`](fs.Path))
  # Local path or HTTP(S) URL to write to.
  destination
  # ([`Dict`](std.Dict)) Request headers for an HTTP(S) destination.
  #
  # Only valid for an HTTP(S) destination.
  :headers = nil
do
  source = (parse_location source)
  if (type source Url)
    source = get $source
  destination = (parse_location destination)
  if (type destination Url)
    put_url $source (require_http destination) $headers
  else
    if (headers != nil)
      throw std.ValueError "headers: only valid for an HTTP destination"
    put_path $source $destination
  nil

let ARCHIVE_FORMATS = Set $
  :TAR: :TAR_GZIP: :TAR_ZSTD: :ZIP:

let INPUT_FORMATS = Set $
  :TAR: :TAR_GZIP: :TAR_ZSTD: :ZIP: :GZIP: :ZSTD: :XZ:

def parse_input_format format
  if (format == nil)
    return nil
  if !(INPUT_FORMATS.contains format)
    throw std.ValueError "format: expected :TAR:, :TAR_GZIP:, :TAR_ZSTD:, :ZIP:, :GZIP:, :ZSTD:, or :XZ:"
  format

def parse_archive_format format
  if (format == nil)
    return nil
  if !(ARCHIVE_FORMATS.contains format)
    throw std.ValueError "format: expected :TAR:, :TAR_GZIP:, :TAR_ZSTD:, or :ZIP:"
  format

def archive_format_from_name name
  if (name == nil)
    return nil
  name = name.lower()
  if name.ends_with ".zip"
    :ZIP:
  else if (name.ends_with ".tar.gz" || name.ends_with ".tgz")
    :TAR_GZIP:
  else if (name.ends_with ".tar.zst" || name.ends_with ".tzst")
    :TAR_ZSTD:
  else if name.ends_with ".tar"
    :TAR:
  else
    nil

def input_format_from_name name
  let format = archive_format_from_name $name
  if (format != nil || name == nil)
    return format
  name = name.lower()
  if name.ends_with ".gz"
    :GZIP:
  else if name.ends_with ".zst"
    :ZSTD:
  else if name.ends_with ".xz"
    :XZ:
  else
    nil

def sniff_format path
  let head = path.open rb do |file| file.read 512
  if (head.starts_with b"PK\x03\x04" || head.starts_with b"PK\x05\x06" ||
      head.starts_with b"PK\x07\x08")
    :ZIP:
  else if head.starts_with b"\x1f\x8b"
    :TAR_GZIP:
  else if head.starts_with b"\x28\xb5\x2f\xfd"
    :TAR_ZSTD:
  else if head.starts_with b"\xfd7zXZ\x00"
    :XZ:
  else
    :TAR:

def input_format path format
  (parse_input_format format || input_format_from_name path.name || sniff_format path)

def output_format destination format
  let selected = (parse_archive_format format || archive_format_from_name destination.name)
  if (selected == nil)
    throw std.ValueError "can't infer archive format from destination"
  selected

def compression_for format
  if (format == :TAR_GZIP:)
    :GZIP:
  else if (format == :TAR_ZSTD:)
    :ZSTD:
  else
    :NONE:

def safe_components path label
  path = unix_fs.Path $path
  if path.is_absolute
    throw std.ValueError "$label must be relative: $path"
  let parts = path.components
  if (parts.len == 0 ||
      parts.any(do |p| p == "" || p == "." || p == ".."))
    throw std.ValueError "unsafe $label: $path"
  parts

def prefix_components prefix
  if (prefix == nil)
    []
  else
    safe_components $prefix "prefix"

def archive_name path source prefix
  unix_fs.Path.join ...prefix
    if (path == source)
      $path.name
    else
      $path.relative(source)

def filesystem_metadata path kind options
  let metadata = path.metadata resolve: :LINK:
  let unix = (sys.os_info().family != :WINDOWS:)
  let default_mode = if (kind == :DIR:)
    0o755
  else if (kind == :SYMLINK:)
    0o777
  else
    0o644
  let mode_key = if (kind == :DIR:)
    :dir_mode:
  else if (kind == :SYMLINK:)
    :link_mode:
  else
    :mode:
  let owner_name = options.get :owner_name: else: do
    try
      if unix
        security_unix.user_name $metadata.uid
      else
        metadata.owner.lookup().qualified_name
    catch sys.NotFoundError: _
      nil
  let group_name = options.get :group_name: else: do
    try
      if unix
        security_unix.group_name $metadata.gid
      else
        metadata.group.lookup().qualified_name
    catch sys.NotFoundError: _
      nil
  return $
    mode: (_vfs.parse_mode(options.get(mode_key)) || (unix && (metadata.mode.int & 0o7777)) || default_mode)
    uid: (options.get(:uid:) || (unix && metadata.uid) || 0)
    gid: (options.get(:gid:) || (unix && metadata.gid) || 0)
    mtime: (options.get(:mtime:) || metadata.modified || DateTime.from_unix(0))
    if owner_name
      :owner_name
    if group_name
      :group_name

let ALLOWED_METADATA = Set $
  :mode: :dir_mode: :link_mode: :uid: :gid:
  :owner_name: :group_name: :mtime:

def validate_metadata arguments
  let positional keyed = arguments.pos_keys()
  let positional = [...positional]
  if (positional.len != 0)
    throw std.ValueError "pack metadata accepts keyed options only"
  let metadata = (Dict keyed)
  for key = metadata.keys()
    if !(ALLOWED_METADATA.contains key)
      throw std.ValueError "unexpected pack metadata option: $key"
  metadata

def source_entries source
  let metadata = (source.metadata resolve: :LINK:)
  if (metadata.type == :DIR:)
    # `**` matches the source directory itself, which sorts first and must not
    # become an entry
    [...(source.glob "**" resolve: :LINK:).skip(1)]
  else
    [source]

def pack_tar source destination format prefix metadata indicator
  tar.write $destination compression: (compression_for format) do |archive|
    for path = source_entries(source)
      let file_metadata = (path.metadata resolve: :LINK:)
      let name = (archive_name path source prefix)
      if (file_metadata.type == :DIR:)
        let values = (filesystem_metadata path :DIR: metadata)
        archive.create_dir $name ...values
      else if (file_metadata.type == :SYMLINK:)
        let target = path.read_link()
        let target = (packed_link name target prefix path)
        let values = (filesystem_metadata path :SYMLINK: metadata)
        archive.symlink $target $name ...values
      else if (file_metadata.type == :FILE:)
        let values = (filesystem_metadata path :FILE: metadata)
        archive.entry $name size: $file_metadata.size ...values do |entry|
          path.open rb do |file|
            for chunk = file
              entry.write $chunk
              indicator.delta $chunk.len
      else
        throw std.ValueError "unsupported file type while packing: $path"

def pack_zip source destination prefix metadata indicator
  zip.open $destination w do |archive|
    for path = source_entries(source)
      let file_metadata = path.metadata resolve: :LINK:
      let name = (archive_name path source prefix)
      if (file_metadata.type == :DIR:)
        let values = (filesystem_metadata path :DIR: metadata)
        archive.create_dir (str name) mode: $values[:mode:]
      else if (file_metadata.type == :SYMLINK:)
        let target = path.read_link()
        let target = (packed_link name target prefix path)
        let values = (filesystem_metadata path :SYMLINK: metadata)
        archive.symlink (str target) (str name) mode: $values[:mode:]
      else if (file_metadata.type == :FILE:)
        let values = (filesystem_metadata path :FILE: metadata)
        # The size hint reserves the ZIP64 fields in the local file header,
        # without which an entry over 4 GiB cannot be written at all.
        archive.open (str name) mode: $values[:mode:] size: $file_metadata.size do |entry|
          path.open rb do |file|
            for chunk = file
              entry.write $chunk
              indicator.delta $chunk.len
      else
        throw std.ValueError "unsupported file type while packing: $path"

def pack_local source archive destination format prefix metadata
  let total = 0
  for path = source_entries(source)
    let item_metadata = path.metadata resolve: :LINK:
    if (item_metadata.type == :FILE:)
      total = (total + item_metadata.size)
  let message = (destination.name || str destination)
  progress.show :message :total units: :BYTES: do |indicator|
    if (format == :ZIP:)
      pack_zip $source $archive $prefix $metadata $indicator
    else
      pack_tar $source $archive $format $prefix $metadata $indicator

# Packs a file or directory into TAR, compressed TAR, or ZIP.
#
# Directory contents are relative to the source root.
pub def pack
  # ([`Str`](std.Str)\|[`Url`](url.Url)\|[`fs.Path`](fs.Path))
  # File or directory to pack.
  source
  # ([`Str`](std.Str)\|[`Url`](url.Url)\|[`fs.Path`](fs.Path))
  # Archive to write.
  destination
  # ([`Sym`](std.Sym)) Archive format.
  #
  # Inferred from the destination name when omitted, which fails if the name
  # carries no recognized extension.
  #
  # | Value        | Meaning                    |
  # | ------------ | -------------------------- |
  # | `:TAR:`      | Uncompressed TAR           |
  # | `:TAR_GZIP:` | gzip-compressed TAR        |
  # | `:TAR_ZSTD:` | Zstandard-compressed TAR   |
  # | `:ZIP:`      | ZIP                        |
  :format = nil
  # ([`Str`](std.Str)\|[`fs.Path`](fs.Path)) Relative path prepended
  # to every archive entry.
  :prefix = nil
  # ([`Value`](std.Value)) Metadata applied to every archive entry, as
  # keyword arguments.
  #
  # Each key overrides what would otherwise be taken from the source file.
  # Positional arguments are rejected, as is any key not listed here.
  #
  # | Name           | Type                                                                       | Meaning                                    |
  # | -------------- | -------------------------------------------------------------------------- | ------------------------------------------ |
  # | `mode`         | [`Int`](std.Int)\|[`fs.unix.Mode`](fs.unix.Mode)                  | Permissions for regular files              |
  # | `dir_mode`     | [`Int`](std.Int)\|[`fs.unix.Mode`](fs.unix.Mode)                  | Permissions for directories                |
  # | `link_mode`    | [`Int`](std.Int)\|[`fs.unix.Mode`](fs.unix.Mode)                  | Permissions for symlinks                   |
  # | `uid`          | [`Int`](std.Int)                                                      | Owner ID                                   |
  # | `gid`          | [`Int`](std.Int)                                                      | Group ID                                   |
  # | `owner_name`   | [`Str`](std.Str)                                                      | Owner name                                 |
  # | `group_name`   | [`Str`](std.Str)                                                      | Group name                                 |
  # | `mtime`        | [`DateTime`](time.DateTime)                                           | Modification time                          |
  #
  # Where the source carries no value of its own, `mode` falls back to `0o644`,
  # `dir_mode` to `0o755`, `link_mode` to `0o777`, `uid` and `gid` to `0`, and
  # `mtime` to the Unix epoch. A name that cannot be looked up is omitted.
  ...metadata
do
  metadata = (validate_metadata metadata)
  source = (parse_location source)
  if (type source Url)
    source = get $source
  destination = (parse_location destination)
  let prefix = (prefix_components prefix)
  if (type destination Url)
    let selected = (output_format destination format)
    with_temp_dir do |dir|
      let temporary = (dir / (destination.name || "archive"))
      pack_local $source $temporary $destination $selected $prefix $metadata
      put $temporary $destination
  else
    let selected = (output_format destination format)
    destination.parent.create_dir all: true
    let tmp = destination.add_ext tmp
    try
      pack_local $source $tmp $destination $selected $prefix $metadata
      tmp.rename $destination
    finally
      tmp.remove ignore: true
  nil

def link_path path label
  path = (unix_fs.Path path)
  if path.is_absolute
    throw std.ValueError "$label must be relative: $path"
  if (path.components.len == 0)
    throw std.ValueError "unsafe $label: $path"
  path

def packed_link name target prefix source
  let target = (link_path target "symlink target")
  let name_parts = name.components[prefix.len..]
  let resolved = (resolve_link name_parts target)
  let resolved_parts = resolved.components
  if (resolved_parts.len > 0 && resolved_parts[0] == "..")
    throw std.ValueError "symlink escapes archive root: $source"
  target

def strip_count records strip
  if (strip == :ROOT:)
    if (records.len == 0)
      throw std.ValueError "strip: :ROOT: requires a non-empty archive"
    let root ...rest = [...records.map do |p| p.parts[0]]
    if rest.any do |x| (x != root)
      throw std.ValueError "strip: :ROOT: requires one shared root component"
    1
  else if (type strip Int && strip >= 0)
    strip
  else
    throw std.ValueError "strip: expected a non-negative Int or :ROOT:"

def record_path parts
  let path = unix_fs.Path.join ...parts
  str $path

def resolve_link output_parts target
  let output = unix_fs.Path.join ...output_parts
  unix_fs.Path.join(output.parent, target).normalize()

def normalize_manifest records strip
  let count = (strip_count records strip)
  let outputs = {}
  let normalized = []

  for item = records
    let parts = item.parts
    if (parts.len < count)
      throw std.ValueError "archive path has fewer than $count components: $item.raw"
    let output_parts = parts[count..]
    if (output_parts.len == 0)
      if (item.kind == :DIR:)
        nil
      else
        throw std.ValueError "stripping removes archive entry path: $item.raw"
    else
      let output = (record_path output_parts)
      if (outputs.contains output)
        throw std.ValueError "duplicate archive output: $output"
      let ancestor = []
      for component = output_parts[..-1]
        ancestor.push $component
        let ancestor_key = (record_path ancestor)
        let ancestor_record = (outputs.get ancestor_key)
        if (ancestor_record && ancestor_record.kind != :DIR:)
          throw std.ValueError "archive path conflicts with non-directory: $ancestor_key"
      if (item.kind != :DIR:)
        let prefix = "$output/"
        if outputs.keys().any(do |key| key.starts_with prefix)
          throw std.ValueError "archive path conflicts with directory: $output"
      item.output_parts = output_parts
      item.output = output
      outputs[output] = item
      normalized.push $item

  for item = normalized
    if (item.kind == :SYMLINK:)
      let target = (link_path item.link  "symlink target")
      let resolved = (resolve_link item.output_parts target)
      let resolved_parts = resolved.components
      if (resolved_parts.len > 0 && resolved_parts[0] == "..")
        throw std.ValueError "link target escapes extraction root"
      item.resolved_link = (record_path resolved_parts)
    else if (item.kind == :HARDLINK:)
      let target_parts = (safe_components item.link "hard-link target")
      if (target_parts.len < count)
        throw std.ValueError "hard-link target removed by strip: $item.link"
      let target = (record_path target_parts[count..])
      let target_record = (outputs.get target)
      if (target_record == nil || target_record.kind != :FILE:)
        throw std.ValueError "hard-link target is not a regular archive file: $item.link"
      item.resolved_link = target

  [normalized, outputs]

def archive_record :raw :parts :kind :size :mode :mtime
  record :raw :parts :kind :size :mode :mtime
    link: nil
    output_parts: nil
    output: nil
    resolved_link: nil

def output_path root item
  (root / item.output)

def create_directories root records
  for item = records
    let destination = (output_path root item)
    if (item.kind == :DIR:)
      destination.create_dir all: true
    else
      destination.parent.create_dir all: true

def apply_metadata path item
  if !path.exists()
    throw std.ValueError "archive entry was not extracted: $item.output"
  let modified = item.mtime
  let mode = item.mode
  if (sys.os_info().family != :WINDOWS: && mode != nil)
    path.update_metadata mode: (mode & 0o7777)
  if modified
    path.update_metadata modified: $modified

def finish_links root records outputs
  for item = records
    if (item.kind == :HARDLINK:)
      let source = (root / item.resolved_link)
      source.hard_link (output_path root item)

  for item = records
    if (item.kind == :SYMLINK:)
      let destination = (output_path root item)
      let target_record = (outputs.get item.resolved_link)
      if (target_record && target_record.kind == :DIR:)
        fs.symlink_dir $item.link $destination
      else
        fs.symlink_file $item.link $destination

def finish_metadata root records
  for item = records
    if (item.kind == :FILE:)
      apply_metadata (output_path root item) $item
  for item = records
    if (item.kind == :DIR:)
      apply_metadata (output_path root item) $item

def prepare_extraction root records
  create_directories $root $records
  let total = 0
  for item = records
    if (item.kind == :FILE:)
      total = (total + item.size)
  total

class TarUnpack
  field source = nil
  field by_raw = nil

  def (init) self source
    self.#source = source

  pub def parse self
    let records = []
    self.#by_raw = {}
    tar.read $self.#source do |archive|
      for entry = archive
        let kind = entry.type
        if !(kind == :FILE: || kind == :DIR: || kind == :SYMLINK: ||
             kind == :HARDLINK:)
          throw std.ValueError "unsupported TAR entry type: $kind"
        let raw = (str entry.path)
        if (self.#by_raw.contains raw)
          throw std.ValueError "duplicate archive entry: $raw"
        let item = archive_record :raw :kind
          parts: $safe_components(entry.path, "archive path")
          size: $entry.size
          mode: $entry.mode
          mtime: $entry.mtime
        if (kind == :SYMLINK: || kind == :HARDLINK:)
          if (entry.link_name == nil)
            throw std.ValueError "archive link is missing its target: $raw"
          item.link = (str entry.link_name)
        self.#by_raw[raw] = item
        records.push $item
    records

  pub def extract self root records outputs
    let total = prepare_extraction(root, records)
    let message = (self.#source.name || str self.#source)
    progress.show message: $message total: $total units: :BYTES: do |indicator|
      tar.read $self.#source do |archive|
        for entry = archive
          let raw = (str entry.path)
          let item = (self.#by_raw.get raw)
          if (item == nil)
            throw std.ValueError "manifest entry missing during TAR extraction: $raw"
          if (item.kind == :FILE:)
            let destination = (output_path root item)
            destination.open wb do |file|
              for chunk = entry
                file.write $chunk
                indicator.delta $chunk.len
    finish_links $root $records $outputs
    finish_metadata $root $records

class ZipUnpack
  field source = nil

  def (init) self source
    self.#source = source

  pub def parse self
    let records = []
    zip.open $self.#source do |archive|
      let entries = [...archive.entries]
      let seen = Set()

      for entry = entries
        let raw = (str entry.name)
        if (seen.contains raw)
          throw std.ValueError "duplicate ZIP entry: $raw"
        seen.add $raw
        let mode = entry.mode
        let kind = entry.type
        if !(kind == :FILE: || kind == :DIR: || kind == :SYMLINK:)
          throw std.ValueError "unsupported ZIP entry type: $raw"
        let item = archive_record :kind :mode
          raw: $raw
          parts: $safe_components(raw, "archive path")
          size: $entry.size
          mtime: nil
        if (kind == :SYMLINK:)
          entry.open do |file|
            let target = (file.read(entry.size + 1))
            file.read 1
            item.link = (str target)
        records.push $item
    records

  pub def extract self root records outputs
    let total = prepare_extraction $root $records
    let message = (self.#source.name || str self.#source)
    progress.show message: $message total: $total units: :BYTES: do |indicator|
      zip.open $self.#source do |archive|
        for item = records
          if (item.kind == :FILE:)
            archive.open $item.raw do |entry|
              let destination = (output_path root item)
              destination.open wb do |file|
                let remaining = item.size
                while (remaining > 0)
                  let amount = if (remaining < 65536)
                    remaining
                  else
                    65536
                  let chunk = (entry.read amount)
                  if (chunk.len == 0)
                    throw std.ValueError "truncated ZIP entry: $item.raw"
                  file.write $chunk
                  indicator.delta $chunk.len
                  remaining = (remaining - chunk.len)
                entry.read 1
    finish_links $root $records $outputs
    finish_metadata $root $records

# Raised when unpacking a raw compressed stream (gzip, Zstandard, XZ) fails.
#
# `detail` is the failing tool's stderr, when it printed exactly one line.
pub class ArchiveError: std.RuntimeError
  pub field source = nil
  pub field detail = nil

  def (init) self source detail = nil
    std.RuntimeError.(init) $self
      if detail
        "archive operation failed: $source: $detail"
      else
        "archive operation failed: $source"
    self.source = source
    self.detail = detail

def raw_format format
  (format == :GZIP: || format == :ZSTD: || format == :XZ:)

def decompress_raw source destination format
  let prog = if (format == :GZIP:)
    "gzip"
  else if (format == :ZSTD:)
    "zstd"
  else
    "xz"

  # Capture stderr instead of letting it leak straight to the real process
  # stderr, and use it for a clearer error on failure — a bare `proc.Error`
  # only reports the exit status, not why the tool failed. Only the
  # single-line case is handled specially; anything more just rethrows the
  # original error rather than guessing how to summarize it. If there's more
  # than a single line, dump it to stderr for logging purposes (same as
  # libvirt's fallback for unrecognized errors) before rethrowing.
  let lines = []
  try
    destination.open wb do |file|
      run $prog -dc -- $source stdout: $file stderr: $lines.prechomp()
  catch proc.Error: e
    if (lines.len == 1)
      throw ArchiveError $source $lines[0]
    if lines.len
      echo $"\n".join(lines)
    throw e

# Safely extracts an archive or decompresses a single file into a new
# destination.
#
# Extraction validates the whole manifest before writing anything, rejecting
# unsafe or conflicting paths. Raw decompression runs the corresponding `gzip`,
# `zstd`, or `xz` program.
pub def unpack
  # ([`Str`](std.Str)\|[`Url`](url.Url)\|[`fs.Path`](fs.Path))
  # Archive or compressed file to extract.
  source
  # ([`Str`](std.Str)\|[`fs.Path`](fs.Path)) Path to create.
  #
  # Must not already exist, and may not be a URL.
  destination
  # ([`Sym`](std.Sym)) Input format.
  #
  # Inferred from the source name when omitted. A compressed TAR archive is
  # distinguished from a raw stream by filename: `.tar.gz` selects
  # `:TAR_GZIP:` while `.gz` selects `:GZIP:`.
  #
  # | Value        | Meaning                    |
  # | ------------ | -------------------------- |
  # | `:TAR:`      | Uncompressed TAR           |
  # | `:TAR_GZIP:` | gzip-compressed TAR        |
  # | `:TAR_ZSTD:` | Zstandard-compressed TAR   |
  # | `:ZIP:`      | ZIP                        |
  # | `:GZIP:`     | Raw gzip stream            |
  # | `:ZSTD:`     | Raw Zstandard stream       |
  # | `:XZ:`       | Raw XZ stream              |
  :format = nil
  # ([`Int`](std.Int)\|[`Sym`](std.Sym)) Leading path components to
  # strip from each entry.
  #
  # `:ROOT:` strips one component, and requires a non-empty archive whose
  # entries share a single root component. Raw streams require `0`.
  :strip = 0
  # ([`Str`](std.Str)) Application name selecting the cache directory,
  # for a URL source.
  :app = nil
do
  source = parse_location $source
  if (type source Url)
    source = get $source app: $app
  destination = parse_location $destination
  if (type destination Url)
    throw std.ValueError "unpack destination must be a path"
  if destination.exists()
    throw std.ValueError "unpack destination already exists: $destination"

  let selected = input_format $source $format
  let parent = (destination.parent || Path ".")
  if raw_format $selected
    if (strip != 0)
      throw std.ValueError "strip: not valid for raw compressed input"
    parent.create_dir all: true
    with_temp_dir parent: $parent do |staging|
      let output = (staging / "output")
      decompress_raw $source $output $selected
      if destination.exists()
        throw std.ValueError "unpack destination appeared during decompression: $destination"
      output.rename $destination
    return nil

  let unpacker = if (selected == :ZIP:)
    ZipUnpack $source
  else
    TarUnpack $source
  let records outputs = normalize_manifest $unpacker.parse() $strip
  parent.create_dir all: true
  with_temp_dir parent: $parent do |staging|
    unpacker.extract $staging $records $outputs
    if destination.exists()
      throw std.ValueError "unpack destination appeared during extraction: $destination"
    staging.rename $destination
