# Shared checking policy for boot and the compiler tooling entrypoint.
import _shell compile shell term
  fs:
    - Path

# A source's module name under a search directory, `a/b.dol` being `a.b`, or
# `nil` when it isn't under the directory.
def module_under file dir
  let parts = [...file.canonical().components]
  let base = [...dir.canonical().components]
  if (parts.len <= base.len || parts[..base.len] != base)
    return nil
  let rest = parts[base.len..]
  if (rest[rest.len - 1] == "mod.dol")
    rest.pop()
  else
    rest[rest.len - 1] = Path(rest[rest.len - 1]).stem
  ".".join $rest

# A source's module name under the first of the directories it is under, or
# `nil` when it is under none.
pub def module_among file dirs
  for dir = dirs
    let module = module_under $file $dir
    if (module != nil)
      return module
  nil

# Whether a file is a typelib, as `compile typelib` writes one.
pub def is_typelib file
  (file.ext == "dolt")

pub def check
  entries
  :paths = []
  :strict = false
  :no_bundled = false
  :undecided = false
  :script = false
  :prelude = {}
do
  let dirs = [...paths.map do |dir| (Path dir)]
  let units = []
  let typelibs = []
  let bundled = []
  let seen = Set []
  let pending = []

  def add_typelib typelib to
    to.push $typelib
    queue $typelib.imports()

  def queue imports
    for name = imports
      if !seen.contains(name)
        seen.add $name
        pending.push $name

  def add file module
    if (!script && is_typelib(file))
      add_typelib $compile.Typelib(file.read("b")) $typelibs
    else
      let imports = (module == nil && prelude || {})
      let unit = compile.compile "$file" $file.read() module: $module prelude: $imports typecheck: true document: true
      units.push $unit
      if (module != nil)
        seen.add $module
      queue $unit.imports()

  # Every entry's module is known before any is compiled, so an import of one
  # is met by the entry rather than found again
  let roots = []
  for entry = entries
    let file = Path $entry
    let module = if script
      nil
    else if is_typelib(file)
      compile.Typelib(file.read("b")).module
    else
      module_among $file $dirs
    if (module != nil)
      if seen.contains(module)
        continue
      seen.add $module
    roots.push [file, module]
  for root = roots
    add $root[0] $root[1]
  # `proc` holds the pipe types `strand`'s placeholders stand for
  if !seen.contains("proc")
    seen.add proc
    pending.push proc
  while (pending.len > 0)
    let name = pending.pop()
    let relative = name.replace(".", "/")
    let candidates = $
      for dir = dirs
        - (dir / "$relative.dol")
        - (dir / "$relative/mod.dol")
        if !script
          - (dir / "$relative.dolt")
    let found = candidates.find (do |file| file.exists()) default: nil
    if (found != nil)
      add $found $name
      continue
    if no_bundled
      continue
    let typelib = _shell.resource "dolang.typelib" $name
    if (typelib != nil)
      add_typelib $compile.Typelib(Bin(typelib)) $bundled

  let counts = {diagnostics: 0, errors: 0, warnings: 0}
  let failed = false

  def report diag
    counts[:diagnostics:] = (counts[:diagnostics:] + 1)
    if (diag.severity == :ERROR:)
      counts[:errors:] = (counts[:errors:] + 1)
      failed = true
    else if (diag.severity == :WARNING:)
      counts[:warnings:] = (counts[:warnings:] + 1)
    if (strict && (!script || diag.severity == :WARNING:))
      failed = true
    if script
      if (counts[:errors:] <= 10)
        term.print $diag.render() "\n"
    else
      echo $diag.render()

  for unit = units
    for diag = unit.diagnostics()
      report $diag
  let result = compile.check [...units, ...typelibs, ...bundled]
  for diag = result.diagnostics
    report $diag
  if script
    if (counts[:errors:] > 0)
      throw std.CompileError "check failed"
    if (strict && counts[:warnings:] > 0)
      throw std.CompileError "warnings treated as errors due to --strict flag"
    return nil
  if undecided
    let listing = result.undecided()
    if (listing != "")
      echo "undecided checks:\n$(listing.trim_end())"
  let verdict = if (result.validated && !failed)
    "validated"
  else
    "partial"
  let summary = "$verdict: $(units.len + typelibs.len) units, $(counts[:diagnostics:]) diagnostics"
  echo "$summary ($(bundled.len) bundled typelibs)"
  if (verdict != "validated")
    shell.exit 1

pub def check_script path :paths = [] :prelude = {} :strict = false
  check [path] :paths :prelude :strict script: true
