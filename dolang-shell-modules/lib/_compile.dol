# Shared checking policy for boot and the compiler tooling entrypoint.
import _shell compile shell term
  fs:
    - Path

# A source's module name under a search directory, `a/b.dol` being `a.b`, or
# `nil` when it isn't under the directory.
def module_under file dir
  let parts = [...file.canonical().components]
  let base = [...dir.canonical().components]
  if (parts.len <= base.len || parts[..base.len] != base)
    return nil
  let rest = parts[base.len..]
  if (rest[rest.len - 1] == "mod.dol")
    rest.pop()
  else
    rest[rest.len - 1] = Path(rest[rest.len - 1]).stem
  ".".join $rest

# A source's module name under the first of the directories it is under, or
# `nil` when it is under none.
pub def module_among file dirs
  for dir = dirs
    let module = module_under $file $dir
    if (module != nil)
      return module
  nil

# Whether a file is a typelib, as `compile typelib` writes one.
pub def is_typelib file
  (file.ext == "dolt")

# Each entry's file and module: a typelib's own, a script's `nil`, or else where
# it is under the first of `dirs`. An entry repeating a module is left out.
pub def roots entries dirs :script = false
  let seen = Set []
  let roots = []
  for entry = entries
    let file = Path $entry
    let module = if script
      nil
    else if is_typelib(file)
      compile.Typelib(file.read()).module
    else
      module_among $file $dirs
    if (module != nil)
      if seen.contains(module)
        continue
      seen.add $module
    roots.push [file, module]
  roots

# A check of `roots`, and of the modules they need, found under `dirs` or
# bundled, with the units and typelibs it was given. A root's unit comes before
# any found.
pub def gather
  roots
  dirs
  :no_bundled = false
  :script = false
  :prelude = {}
  :typelibs = false
do
  let check = compile.Check :typelibs
  let units = []
  let found = []
  let bundled = []

  def add file module
    if (!script && is_typelib(file))
      let typelib = compile.Typelib $file.read()
      found.push $typelib
      check.add $typelib
    else
      let imports = (module == nil && prelude || {})
      let unit = compile.compile "$file" $file.read_str() module: $module prelude: $imports typecheck: true
      units.push $unit
      check.add $unit

  # Every root is added before the check is asked what it is missing, so an
  # import of one is met by the root rather than found again
  for root = roots
    add $root[0] $root[1]
  let tried = Set []
  let more = true
  while more
    more = false
    for name = check.missing()
      if tried.contains(name)
        continue
      tried.add $name
      more = true
      let relative = name.replace(".", "/")
      let candidates = $
        for dir = dirs
          - (dir / "$relative.dol")
          - (dir / "$relative/mod.dol")
          if !script
            - (dir / "$relative.dolt")
      let file = candidates.find (do |file| file.exists()) default: nil
      if (file != nil)
        add $file $name
        continue
      if no_bundled
        continue
      let bytes = _shell.resource "dolang.typelib" $name
      if (bytes != nil)
        let typelib = compile.Typelib $Bin(bytes)
        bundled.push $typelib
        check.add $typelib
  record :check :units typelibs: $found :bundled

pub def check
  entries
  :paths = []
  :strict = false
  :no_bundled = false
  :undecided = false
  :script = false
  :prelude = {}
do
  let dirs = [...paths.map do |dir| (Path dir)]
  let found = roots $entries $dirs :script
  let :check :units :typelibs :bundled = gather $found $dirs :no_bundled :script :prelude

  let counts = {diagnostics: 0, errors: 0, warnings: 0}
  let failed = false

  def report diag
    counts[:diagnostics:] = (counts[:diagnostics:] + 1)
    if (diag.severity == :ERROR:)
      counts[:errors:] = (counts[:errors:] + 1)
      failed = true
    else if (diag.severity == :WARNING:)
      counts[:warnings:] = (counts[:warnings:] + 1)
    if (strict && (!script || diag.severity == :WARNING:))
      failed = true
    if script
      if (counts[:errors:] <= 10)
        term.print $diag.render() "\n"
    else
      echo $diag.render()

  for unit = units
    for diag = unit.diagnostics()
      report $diag
  let result = check.run()
  for diag = result.diagnostics
    report $diag
  if script
    if (counts[:errors:] > 0)
      throw std.CompileError "check failed"
    if (strict && counts[:warnings:] > 0)
      throw std.CompileError "warnings treated as errors due to --strict flag"
    return nil
  if undecided
    let listing = result.undecided()
    if (listing != "")
      echo "undecided checks:\n$(listing.trim_end())"
  let verdict = (failed && "failed" || "passed")
  let summary = "$verdict: $(units.len + typelibs.len) units, $(counts[:diagnostics:]) diagnostics"
  echo "$summary ($(bundled.len) bundled typelibs)"
  if failed
    shell.exit 1

pub def check_script path :paths = [] :prelude = {} :strict = false
  check [path] :paths :prelude :strict script: true
