# dolang: strict
import _vfs time
import shell:
  - Vfs
import fs:
  - @Path
import std:
  - @BaseDict

pub def build_linux_command
  command @ Iterable[Value]
  :distro @ Str = nil
  :user @ Str = nil
  :cd @ (Str | Path) = nil
  :env @ BaseDict[Str | Sym, Value] = {}
do -> [Value]
  let argv @ [Value] = ["wsl.exe"]
  if (distro != nil)
    argv.push --distribution $distro
  if (user != nil)
    argv.push --user $user
  argv.push --exec ...command.iter() ...(_vfs.vfs_args cd env) --stdio
  argv

pub def build_windows_command
  command @ Iterable[Value]
  :cd @ (Str | Path) = nil
  :env @ BaseDict[Str | Sym, Value] = {}
do -> [Value]
  let argv = [...command.iter()]
  argv.push ...(_vfs.vfs_args cd env) --stdio
  argv

pub def with_command[R] argv @ [Value] block @ (() -> R) -> R
  # `command` items are passed verbatim, the program included
  let program *args = argv
  let vfs = Vfs do run (str program) ...args
  try
    vfs.with $block
  finally
    time.timeout 30 do vfs.stop()
