# Guest-side provisioning payload for an unattended Windows install: the batch
# file the `specialize` pass runs to stage the payload onto the system disk,
# and the `provision.dol` the `auditUser` pass then runs out of it.
#
# Both ship as source on the provisioning disc rather than as code this module
# calls, so nothing here executes on the host — see `check_provision_source`
# for what keeps the embedded script honest.

import compile std

# Where an unattended install puts the guest payload. Unlike the cloud-init
# path there is no payload to copy over SSH afterwards: the binaries reach the
# guest on the provisioning media, so the command is known before the guest
# exists.
pub let WINDOWS_ROOT = "C:\\dolang"
pub let WINDOWS_VFS_COMMAND = "$WINDOWS_ROOT\\dolang-vfs.exe"

# Run from the `specialize` pass, as SYSTEM, with networking possibly still
# down. It copies the payload off the provisioning disc onto the system disk.
# Anything that needs a running system belongs in `provision.dol`, and anything
# that can wait until there is a VFS belongs on the host.
#
# The copy happens here rather than from the `auditUser` pass that runs
# `provision.dol` so that the audit command is a plain path on `C:` with no disc
# to find: by the time audit mode comes up, everything the guest needs is
# already where it will live permanently.
#
# It exits zero unconditionally. A nonzero exit here stops Setup behind a
# dialog with no way to answer it, which costs a full reinstall to discover;
# a failure to copy surfaces instead as the guest never answering SSH.
pub let BOOTSTRAP_CMD = r|
  @echo off
  setlocal
  set "ROOT=C:\dolang"
  mkdir "%ROOT%" 2>nul
  copy /y "%~dp0payload\*" "%ROOT%" >nul 2>&1
  copy /y "%~dp0provision.json" "%ROOT%" >nul 2>&1
  copy /y "%~dp0provision.dol" "%ROOT%" >nul 2>&1
  exit /b 0

# Run once from the `auditUser` pass, on the first boot into audit mode, out of
# the payload `bootstrap.cmd` staged in `specialize`. Audit mode auto-logs on as
# the built-in Administrator with an unfiltered token, so this runs elevated,
# which everything below needs. It does
# only what has to happen before SSH exists, because everything after that is
# reachable from the host over the VFS, where it compiles, lints and re-runs in
# seconds instead of costing a reinstall per iteration.
#
# The guest runs a *released* `dolang.exe` out of the payload tarball, so this
# cannot be a bundled module — it would not be in that release. It ships as
# source on the provisioning disc instead, which is why the load-time compile
# check below exists.
pub let PROVISION_SOURCE = r|
  import fs json proc std sys term winreg winscm
    security.windows:
      - Sid

  # The Feature-on-Demand package holding the Windows OpenSSH server, and the
  # inbound rule DISM is expected to add to the firewall along with it.
  let CAPABILITY = "OpenSSH.Server~~~~0.0.1.0"
  let FIREWALL_RULE = "OpenSSH-Server-In-TCP"

  # Where Windows keeps the machine-wide environment.
  let ENV_KEY = r"SYSTEM\CurrentControlSet\Control\Session Manager\Environment"

  # Accounts and groups are named by SID, never by name. Every account and
  # group name Windows ships is localized — `BUILTIN\Administrators` is
  # `VORDEFINIERT\Administratoren` on German media — and only the SID is the
  # same everywhere, so anything that has to name one resolves it from its SID
  # first.

  def log message
    echo "[provision] $message"

  # Reports whether a callable completed, rather than raising. A missing
  # program raises `sys.NotFoundError` rather than `proc.Error` — there is no
  # process error without a process — so a probe has to catch both or the one
  # case it exists for is the one that escapes.
  def probe func
    try
      func()
      true
    catch proc.Error: _
      false
    catch sys.NotFoundError: _
      false

  # Creates the account the host logs in as, and makes it an administrator.
  #
  # Audit mode has no `UserAccounts` to do this from the answer file — that is
  # an `oobeSystem` component, and `oobeSystem` never runs here — so the account
  # is created with `net user` instead. The password stays off every command
  # line Setup records: it comes out of `provision.json` on the provisioning
  # disc, which is never part of an exported image, rather than out of the
  # `RunSynchronous` command Setup logs to `Panther\setupact.log`.
  #
  # This is also why the host does not simply log in as the built-in
  # Administrator that audit mode auto-logs on: that account's *name* is
  # localized, and only its SID is not.
  #
  # `/add` fails on an account that is already there, so an existing one has its
  # password set instead — this script has to survive a second run on an
  # already-provisioned guest.
  #
  # `/y` on both: a password over 14 characters makes `net` stop to ask about
  # pre-Windows-2000 clients, and the audit pass has nobody to answer
  # it, so provisioning would hang there with no timeout and no way in.
  def create_account user password
    let present = probe do
      run net user $user
    if present
      log "setting the password on $user"
      run net user $user $password /y
    else
      log "creating $user"
      run net user $user $password /add /y
    let admins = Sid(:BUILTIN_ADMINISTRATORS:).lookup()
    log "adding $user to $(admins.qualified_name)"
    # Already a member is an error here too, and an uninteresting one.
    probe do
      run net localgroup $admins.name $user /add

  def install_openssh()
    log "installing $CAPABILITY"
    let capability = "/capabilityname:$CAPABILITY"
    run dism /online /add-capability $capability /norestart

  # OpenSSH reads an administrator's keys from one machine-wide file rather
  # than from the account's own `.ssh` directory, and refuses to read it unless
  # it is owned by an administrator and writable by nobody else. The refusal
  # reaches the client only as "publickey denied", so getting the descriptor
  # right here is what makes the failure mode diagnosable at all.
  def write_authorized_keys key
    let program_data = fs.Path $ env.get ProgramData default: C:\ProgramData
    let directory = (program_data / "ssh")
    directory.create_dir all: true
    let path = (directory / "administrators_authorized_keys")
    log "writing $path"
    path.write "$(key.trim())\n"

    # Protected, so the inherited entries granting the containing directory to
    # everyone do not come back and disqualify the file.
    path.update_sec_desc
      owner: :BUILTIN_ADMINISTRATORS:
      dacl_protected: true
      dacl:
        for sid = [:LOCAL_SYSTEM:, :BUILTIN_ADMINISTRATORS:]
          - allow: $sid
            mask: :GENERIC_ALL:

  # DISM adds this rule itself on the builds seen so far, but a build where it
  # does not looks exactly like a guest that never finished booting.
  def ensure_firewall_rule()
    let name = "name=$FIREWALL_RULE"
    # Only the exit status is wanted; the rule dump would otherwise land in
    # `provision.log` on every run of an already-provisioned guest.
    let present = probe do
      run netsh advfirewall firewall show rule $name
        stdout: $std.null
        stderr: $std.null
    if present
      log "firewall rule $FIREWALL_RULE is present"
      return
    log "adding firewall rule $FIREWALL_RULE"
    run netsh advfirewall firewall add rule $name dir=in action=allow protocol=TCP localport=22

  # Puts the payload directory on the machine `PATH`.
  #
  # This is one of the few things that genuinely has to happen in the guest,
  # and it has to happen before sshd starts. sshd hands a session an
  # environment composed from a snapshot it took when the service started, so
  # a `PATH` written any later — from the host, over the VFS — stays invisible
  # until the service is restarted or the guest reboots.
  #
  # Read-modify-write, and `:EXPAND_SZ:` because that is the kind the value
  # already has: rewriting it as a plain `:SZ:` would strip the `%SystemRoot%`
  # expansion most of its other entries are written in terms of.
  def set_machine_path directory
    winreg.open :LOCAL_MACHINE: do |root|
      root.open $ENV_KEY access: :READ_WRITE: do |key|
        let entry = key.get_value "Path"
        let current = if entry
          str $entry.value
        else
          ""
        let parts = []
        let present = false
        for part = current.split(";")
          if (part.trim() == "")
            continue
          if (part.trim().lower() == directory.lower())
            present = true
          parts.push $part
        if present
          log "$directory is already on the machine PATH"
        else
          log "adding $directory to the machine PATH"
          parts.push $directory
          key.set "Path" $";".join(parts) kind: :EXPAND_SZ:

  # Started last, so that "SSH answers" is the readiness signal: there is no
  # Windows analogue of the cloud-init ready file, and anything probed earlier
  # would race a half-provisioned guest.
  def start_sshd()
    log "configuring sshd"
    winscm.open access: :SC_MANAGER_CONNECT: do |manager|
      let access = [:SERVICE_CHANGE_CONFIG:, :SERVICE_START:, :SERVICE_QUERY_STATUS:]
      manager.open_service sshd access: $access do |service|
        service.update_config start_type: :AUTO_START:
        # Starting an already-running service raises rather than doing
        # nothing, which would make a second run of this script fail on a
        # guest that is already provisioned.
        if (service.query_status().current_state == :RUNNING:)
          log "sshd is already running"
        else
          log "starting sshd"
          service.start()

  def main config_path
    let config = json.decode $ config_path.read()
    create_account $config["user"] $config["password"]
    install_openssh()
    write_authorized_keys $config["authorized_key"]
    ensure_firewall_rule()
    set_machine_path $config["root"]
    start_sshd()
    log "done"

  # Writes everything to several consoles at once.
  class Tee: term.Console
    pub field consoles

    def (init) self ...consoles
      term.Console.(init) $self
      self.consoles = [...consoles.pos_only()]

    pub def write self data
      for console = self.consoles
        console.write $data
      data.len

    pub def flush self
      for console = self.consoles
        console.flush()

  # The answer file names this script directly, with no shell behind it to
  # redirect with, so the transcript is captured here instead. Child output
  # follows the capture too, which is what puts `dism`'s and `netsh`'s own
  # complaints in the log rather than nowhere.
  #
  # It goes to the console as well as the file. The audit pass runs this in a
  # visible window on the guest's console, and a capture that named only the
  # file would leave that window blank for the whole of provisioning — the one
  # view of it a person watching the install actually has. `term.console`
  # rather than `term.output()`: the target is the window behind the capture,
  # not whatever the capture just installed.
  #
  # It is written beside this script rather than beside anything derived from
  # the arguments: where the log goes must not depend on parsing succeeding, or
  # a failure early enough takes the record of itself with it.
  #
  # What throws is logged and then re-thrown, never swallowed. A failure that
  # exits zero leaves no exit code for sysprep to record, no event, and nothing
  # to distinguish "provisioning broke" from "provisioning never started" — the
  # difference that matters most when the only other evidence is a guest that
  # does not answer SSH.
  if (shell.args.len < 1)
    throw std.ValueError "usage: provision.dol <config.json>"
  let directory = (fs.Path(shell.program).absolute().parent || fs.Path ".")
  (directory / "provision.log").open w do |out|
    term.capture (Tee term.console (term.SinkConsole out)) do
      try
        main $ fs.Path(shell.args[0]).absolute()
      catch e
        log "failed: $e"
        throw e

# Compiles the script above at module load, so a mistake in it fails on
# `import libvirt` instead of halfway through an unattended install — where the
# only symptom is a guest that never answers SSH and the only way back is a
# full reinstall. Any diagnostic counts, warnings included: an unused import in
# a script nothing ever lints is exactly the kind of mistake this is here to
# catch. The bytecode is discarded; only the source ships.
def check_provision_source()
  let result = compile.compile "provision.dol" $PROVISION_SOURCE
  let diagnostics = [...result.diagnostics()]
  if (diagnostics.len == 0)
    return
  for diagnostic = diagnostics
    echo $diagnostic.render()
  throw std.RuntimeError "libvirt: the embedded provision.dol does not compile cleanly"

check_provision_source()
