# dolang: strict
# Bootstrap payload and guest paths for an unattended Windows install.
# The guest script is embedded as text from `resource/provision.dol` and
# checked with the shell prelude and Windows stubs by `dodo typecheck-test`.

# Where an unattended install puts the guest payload. Unlike the cloud-init
# path there is no payload to copy over SSH afterwards: the binaries reach the
# guest on the provisioning media, so the command is known before the guest
# exists.
pub let WINDOWS_ROOT @ Str = "C:\\dolang"
pub let WINDOWS_VFS_COMMAND @ Str = "$WINDOWS_ROOT\\dolang-vfs.exe"

# Run from the `specialize` pass, as SYSTEM, with networking possibly still
# down. It copies the payload off the provisioning disc onto the system disk.
# Anything that needs a running system belongs in `provision.dol`, and anything
# that can wait until there is a VFS belongs on the host.
#
# The copy happens here rather than from the `auditUser` pass that runs
# `provision.dol` so that the audit command is a plain path on `C:` with no disc
# to find: by the time audit mode comes up, everything the guest needs is
# already where it will live permanently.
#
# It exits zero unconditionally. A nonzero exit here stops Setup behind a
# dialog with no way to answer it, which costs a full reinstall to discover;
# a failure to copy surfaces instead as the guest never answering SSH.
pub let BOOTSTRAP_CMD @ Str = r|
  @echo off
  setlocal
  set "ROOT=C:\dolang"
  mkdir "%ROOT%" 2>nul
  copy /y "%~dp0payload\*" "%ROOT%" >nul 2>&1
  copy /y "%~dp0provision.json" "%ROOT%" >nul 2>&1
  copy /y "%~dp0provision.dol" "%ROOT%" >nul 2>&1
  exit /b 0
