# Synthesis of `autounattend.xml`, the answer file that drives an unattended
# Windows install, and of the two command lines it runs in the guest.
#
# `unattend_xml` is the whole of the interface; everything else here builds
# part of the document it returns.

import proc proc.windows xml
  _vm.provision:
    - WINDOWS_ROOT

# Drive letters the unattend file is told to look for media under. Windows
# assigns letters to removable devices in an order that depends on how many
# are attached and in what order Setup enumerates them, so no single letter
# can be named; Setup logs and skips the paths that do not exist.
let PROVISION_DRIVES = ["D", "E", "F", "G", "H", "I"]

# Where the drivers Setup needs in order to see a virtio disk and NIC live on
# the virtio-win media, relative to a drive root.
let DRIVER_SUBPATHS = $
  - "viostor\\w11\\amd64"
  - "vioscsi\\w11\\amd64"
  - "NetKVM\\w11\\amd64"

let UNATTEND_NS = "urn:schemas-microsoft-com:unattend"
let WCM_NS = "http://schemas.microsoft.com/WMIConfig/2002/State"

# Every `<component>` in an unattend document carries the same assembly
# identity; only `name` varies.
let COMPONENT_ATTRS = $
  processorArchitecture: amd64
  publicKeyToken: "31bf3856ad364e35"
  language: neutral
  versionScope: nonSxS

# The locale every pass is configured with. Only the installer's own UI and
# the guest's defaults depend on it, and nothing here reads the guest's
# language back, so it is not an argument yet.
let UNATTEND_LOCALE = "en-US"

# Finds the provisioning disc and hands off to it. This runs as an inline
# command line rather than out of a batch file, so `for` takes a single `%i` —
# the doubled `%%i` a `.cmd` file needs silently matches nothing here.
#
# The disc's drive letter is not knowable when the answer file is written, so
# every plausible one is tried in turn and the first that has the disc wins.
#
# `RunSynchronousCommand` takes one command line, and `proc.windows.join` is
# what encodes an argument list as one — the same encoding Windows parses back
# out. Quoting it by hand would work until the day an argument contained
# something the rules care about.
def bootstrap_command()
  let drives = " ".join(PROVISION_DRIVES)
  let scan = r#"@if exist %i:\bootstrap.cmd call %i:\bootstrap.cmd"#
  proc.windows.join ["cmd.exe", "/c", "for %i in ($drives) do $scan"]

# Runs `provision.dol` out of the payload `bootstrap.cmd` copied. This is the
# `auditUser` pass's command.
#
# No `cmd.exe`: the script writes its own transcript, so there is no redirect
# and nothing left for a shell to do. A program and its arguments, encoded by
# `proc.windows.join` rather than by hand.
def provision_command()
  let root = WINDOWS_ROOT
  proc.windows.join $
    - "$root\\dolang.exe"
    - "$root\\provision.dol"
    - "$root\\provision.json"

# Builds an element in the unattend namespace.
#
# Every element needs it named: `xml.encode` derives namespace declarations
# per node rather than from parent pointers, so a child of a namespaced node
# that does not carry one of its own is serialized into no namespace at all.
def unattend_node tag *items
  xml.Node $tag namespace: $UNATTEND_NS ...items

# `wcm:action="add"`, which the schema requires on every member of a repeated
# list — partitions, driver paths, accounts, commands.
def wcm_add()
  xml.Attr action add namespace: $WCM_NS prefix: wcm

def unattend_component name *items
  let attrs = COMPONENT_ATTRS.copy()
  attrs[:name:] = name
  xml.Node component namespace: $UNATTEND_NS attrs: $attrs ...items

# The `<InstallFrom>` selecting an edition off multi-edition media, or `nil`
# to let Setup pick — which on retail media means stopping to ask.
def unattend_install_from edition index
  let key = (edition != nil && "/IMAGE/NAME" || "/IMAGE/INDEX")
  let value = (edition != nil && edition || str(index))
  unattend_node InstallFrom
    $ unattend_node MetaData
      $ wcm_add()
      $ unattend_node Key $key
      $ unattend_node Value $value

# The `windowsPE` pass's disk layout: the GPT arrangement Windows 11 requires,
# written over whatever the disk held before.
#
# Setup is given an explicit layout rather than an existing partition because
# the disk it installs onto is blank — `create` sizes an overlay with no
# backing image on this path — so there is nothing for it to find.
def unattend_disk_config()
  unattend_node DiskConfiguration
    $ unattend_node WillShowUI "OnError"
    $ unattend_node Disk
      $ wcm_add()
      $ unattend_node DiskID "0"
      $ unattend_node WillWipeDisk "true"
      $ unattend_node CreatePartitions
        $ unattend_node CreatePartition
          $ wcm_add()
          $ unattend_node Order "1"
          $ unattend_node Type "EFI"
          $ unattend_node Size "260"
        $ unattend_node CreatePartition
          $ wcm_add()
          $ unattend_node Order "2"
          $ unattend_node Type "MSR"
          $ unattend_node Size "16"
        $ unattend_node CreatePartition
          $ wcm_add()
          $ unattend_node Order "3"
          $ unattend_node Type "Primary"
          $ unattend_node Extend "true"
      $ unattend_node ModifyPartitions
        $ unattend_node ModifyPartition
          $ wcm_add()
          $ unattend_node Order "1"
          $ unattend_node PartitionID "1"
          $ unattend_node Label "System"
          $ unattend_node Format "FAT32"
        $ unattend_node ModifyPartition
          $ wcm_add()
          $ unattend_node Order "2"
          $ unattend_node PartitionID "3"
          $ unattend_node Label "Windows"
          $ unattend_node Letter "C"
          $ unattend_node Format "NTFS"

# The `<DriverPaths>` Setup loads virtio storage and network drivers from,
# without which it does not see the disk it is told to install onto.
#
# Every candidate drive letter is crossed with every driver subdirectory
# rather than naming the one that is right: the letter the driver disc gets
# is not knowable from here, and Setup logs and skips a path that is not
# there.
def unattend_driver_paths()
  let paths = []
  let order = 1
  for drive = PROVISION_DRIVES
    for subpath = DRIVER_SUBPATHS
      paths.push $ unattend_node PathAndCredentials
        $ wcm_add()
        $ xml.Attr keyValue (str order) namespace: $WCM_NS prefix: wcm
        $ unattend_node Path "$drive:\\$subpath"
      order = (order + 1)
  unattend_component "Microsoft-Windows-PnpCustomizationsWinPE"
    $ unattend_node DriverPaths ...paths

# Builds `autounattend.xml`: the whole of what makes the install unattended.
#
# It installs Windows and reseals into **audit mode**, and nothing else. Audit
# mode is what makes the rest of provisioning tractable: it bypasses OOBE — and
# so the Cloud Experience Host's Zero Day Patch, which installs an update and
# reboots the guest out from under whatever the host is doing — it auto-logs on
# as the built-in Administrator, it survives reboots by design, and its
# `auditUser` pass has a `RunSynchronous` to hang provisioning off, which
# `oobeSystem` does not.
#
# Nothing here creates the account or sets a password: `UserAccounts` is an
# `oobeSystem` component and `oobeSystem` no longer runs anything but the
# reseal. `provision.dol` does both, which also keeps the password out of
# `Panther\setupact.log`, where Setup records every `RunSynchronous` command
# line and where it would survive into an exported image.
#
# One file drives every pass, including the audit ones: Setup caches it as
# `%WINDIR%\Panther\unattend.xml` and sysprep reads that back on the boot into
# audit mode. It is the same file, so the audit pass has to be *in* it — an
# audit-only answer file written to that path from `specialize` is overwritten
# by Setup's own cache afterwards, and what sysprep then finds has no audit
# section and is refused with "does not meet criteria to be used for this
# unattend pass".
#
# There is deliberately no answer file for the boot *after* a caller's own
# `sysprep /generalize`. That one is a caller decision, placed with an ordinary
# `add:` writing `C:\Windows\Panther\unattend.xml`.
pub def unattend_xml user :edition = nil :index = nil :drivers = false
  let install_from = nil
  if (edition != nil || index != nil)
    install_from = unattend_install_from $edition $index

  let locale_pe = unattend_component "Microsoft-Windows-International-Core-WinPE"
    $ unattend_node SetupUILanguage
      $ unattend_node UILanguage $UNATTEND_LOCALE
    $ unattend_node InputLocale $UNATTEND_LOCALE
    $ unattend_node SystemLocale $UNATTEND_LOCALE
    $ unattend_node UILanguage $UNATTEND_LOCALE
    $ unattend_node UserLocale $UNATTEND_LOCALE

  let setup = unattend_component "Microsoft-Windows-Setup"
    $ unattend_disk_config()
    $ unattend_node ImageInstall
      $ unattend_node OSImage
        if (install_from != nil)
          $ install_from
        $ unattend_node InstallTo
          $ unattend_node DiskID "0"
          $ unattend_node PartitionID "3"
        $ unattend_node InstallToAvailablePartition "false"
        $ unattend_node WillShowUI "OnError"
    $ unattend_node UserData
      $ unattend_node AcceptEula "true"
      $ unattend_node FullName $user
      $ unattend_node Organization ""
      $ unattend_node ProductKey
        $ unattend_node WillShowUI "Never"

  # `Microsoft-Windows-International-Core` is valid in `specialize` as well as
  # in `oobeSystem`, so the guest's locale defaults survive the latter's
  # removal. `TimeZone` moves here from `Shell-Setup` for the same reason.
  let locale = unattend_component "Microsoft-Windows-International-Core"
    $ unattend_node InputLocale $UNATTEND_LOCALE
    $ unattend_node SystemLocale $UNATTEND_LOCALE
    $ unattend_node UILanguage $UNATTEND_LOCALE
    $ unattend_node UserLocale $UNATTEND_LOCALE

  let shell_setup = unattend_component "Microsoft-Windows-Shell-Setup"
    $ unattend_node TimeZone "UTC"

  # The whole of `oobeSystem`: reseal into audit mode instead of running OOBE.
  let reseal = unattend_component "Microsoft-Windows-Deployment"
    $ unattend_node Reseal
      $ unattend_node Mode "Audit"

  # `specialize` stages the payload; `auditUser` runs it. Both are
  # `Microsoft-Windows-Deployment` `RunSynchronous` commands.
  #
  # `auditUser`, not `auditSystem`, despite the latter being the pass that
  # *looks* right for something running as the machine rather than as a user.
  # Measured on 26100 across three boots: an `auditSystem` `RunSynchronous`
  # command is accepted with the answer file, the pass is processed, the action
  # queue names `Microsoft-Windows-Deployment`, `SetupUGC` runs, and the pass is
  # stamped `wasPassProcessed="true"` — but the command is never staged into the
  # registry `SetupUGC` reads, so it never runs and nothing anywhere reports a
  # failure. The same command in `auditUser` runs. `RunAsynchronous` there works
  # too; synchronous is used so the pass does not finish early.
  let bootstrap = unattend_component "Microsoft-Windows-Deployment"
    $ unattend_node RunSynchronous
      $ unattend_node RunSynchronousCommand
        $ wcm_add()
        $ unattend_node Order "1"
        $ unattend_node Description "dolang bootstrap"
        $ unattend_node Path $(bootstrap_command())

  let provision = unattend_component "Microsoft-Windows-Deployment"
    $ unattend_node RunSynchronous
      $ unattend_node RunSynchronousCommand
        $ wcm_add()
        $ unattend_node Order "1"
        $ unattend_node Description "dolang provision"
        $ unattend_node Path $(provision_command())

  # Pass order as Windows documents it — windowsPE, specialize, auditUser,
  # oobeSystem — rather than in the order they run in wall-clock terms, which
  # puts `oobeSystem` and its reseal before the audit pass it leads to.
  let document = unattend_node unattend
    $ unattend_node settings
      $ xml.Attr pass windowsPE
      $ locale_pe
      if drivers
        $ unattend_driver_paths()
      $ setup
    $ unattend_node settings
      $ xml.Attr pass specialize
      $ locale
      $ shell_setup
      $ bootstrap
    $ unattend_node settings
      $ xml.Attr pass auditUser
      $ provision
    $ unattend_node settings
      $ xml.Attr pass oobeSystem
      $ reseal
  "<?xml version=\"1.0\" encoding=\"utf-8\"?>\n$(xml.encode document)\n"
