# dolang: strict
# Helpers shared by more than one of the `_vm` modules.

import proc
  fs:
    - @Path
  std:
    - null

# Runs a host program with no input and its output captured, returning its
# standard output. Standard error is collected in `stderr`, for the caller to
# classify a failure by.
#
# The program runs in a locale-independent environment, so that output this
# module parses back is not translated.
pub def capture program@(Str | Path) stderr@Array[Str] *args@Value -> Str
  env LC_ALL: C LANG: C do
    sub do run $program ...args stdin: $null stderr: $stderr.prechomp()

# Runs a host program as `capture` does, for a caller with no failure to
# classify. A failure prints what the program wrote to standard error before
# it is rethrown, since the exit status alone says nothing about the cause.
pub def cli program@(Str | Path) *args@Value -> Str
  let stderr @ Array[Str] = []
  try
    capture $program $stderr ...args
  catch proc.Error: e
    if stderr.len
      echo $"\n".join(stderr)
    throw e
