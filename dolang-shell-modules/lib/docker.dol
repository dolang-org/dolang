import
  proc
  _container.dockman: dockman

let docker_cli = proc.run[:docker:]

pub let Image = dockman.Image
pub let Container = dockman.Container
pub let NoImageError = dockman.NoImageError
pub let NoContainerError = dockman.NoContainerError
pub let ContainerExitError = dockman.ContainerExitError
pub let InvalidImageReferenceError = dockman.InvalidImageReferenceError
pub let RegistryAuthError = dockman.RegistryAuthError
pub let ArchiveError = dockman.ArchiveError

class DockerRuntime: dockman.Runtime
  def (init) self
    dockman.Runtime.(init) $self :DOCKER:

  pub def cli _self ...args
    env LC_ALL: C LANG: C do docker_cli ...args

let docker = DockerRuntime()

# Runs a command in a temporary Docker container.
#
# See [Create and run parameters](#create-and-run-parameters).
#
# ## Returns
#
# `nil`
pub def run
  image cmd
  :cd = nil
  :env = {}
  :pull = :MISSING:
  :name = nil
  :mounts = []
  :labels = {}
  :ports = []
  :networks = []
  :user = nil
  :entrypoint = nil
  ...args
do
  docker.run $image $cmd :cd :env :pull :name :mounts :labels :ports :networks
    :user :entrypoint ...args

# Creates a stopped Docker container.
#
# See [Create and run parameters](#create-and-run-parameters).
#
# ## Parameters
#
# | Name      | Type                          | Description              |
# | --------- | ----------------------------- | ------------------------ |
# | `restart` | [`Dict`](../std/dict.md) | Container restart policy |
#
# ### `restart`
#
# The dictionary accepts these keys:
#
# | Name          | Type                   | Meaning                              |
# | ------------- | ---------------------- | ------------------------------------ |
# | `policy`      | [`Sym`](../std/sym.md) | Restart policy                       |
# | `max_retries` | [`Int`](../std/int.md) | Optional retry limit for `:ON_FAILURE:` only |
#
# `policy` accepts:
#
# | Value              | Meaning                              |
# | ------------------ | ------------------------------------ |
# | `:NO:`             | Do not restart the container         |
# | `:ON_FAILURE:`     | Restart after an unsuccessful exit   |
# | `:ALWAYS:`         | Always restart the container         |
# | `:UNLESS_STOPPED:` | Restart unless explicitly stopped    |
#
# ## Returns
#
# [`Container`](./container.md) in the `:CREATED:` state
pub def create
  image cmd = nil
  :name = nil
  :env = {}
  :mounts = []
  :labels = {}
  :ports = []
  :networks = []
  :user = nil
  :cd = nil
  :entrypoint = nil
  :restart = nil
  :pull = :MISSING:
  ...args
do
  docker.create $image $cmd :name :env :mounts :labels :ports :networks :user
    :cd :entrypoint :restart :pull ...args

# Runs a function in a temporary Docker container.
#
# Program execution and filesystem access will be redirected for the
# duration of the function.
#
# ## Parameters
#
# | Name    | Type                     | Description                         |
# | ------- | ------------------------ | ----------------------------------- |
# | `image` | [`Str`](../std/str.md)   | Image name or ID                    |
# | `func`  | [`Func`](../std/func.md) | Function to run                     |
# | `cd`    | [`Str`](../std/str.md)   | Optional container working directory |
# | `env`   | [`Dict`](../std/dict.md) | Container environment               |
# | `pull`  | [`Sym`](../std/sym.md)   | `:MISSING:`, `:ALWAYS:`, or `:NEVER:` |
#
# ## Returns
#
# Result of `func`
pub def with image func :cd = nil :env = {} :pull = :MISSING:
  docker.with $image $func :cd :env :pull

# Build a Docker image.
#
# ## Parameters
#
# | Name     | Type                     | Description                            |
# | -------- | ------------------------ | -------------------------------------- |
# | `pull`   | [`Sym`](../std/sym.md)   | Image pull policy; default `:MISSING:` |
# | `mounts` | [`Iterable`](../std/iterable.md) | Mounts available to every build step   |
# | `cd`     | [`Str`](../std/str.md)   | Optional working directory for `run` steps |
# | `env`    | [`Dict`](../std/dict.md)  | Environment for `run` steps            |
# | `from`   | [`Str`](../std/str.md)   | Base image                             |
# | `args`   | [`Value`](../std/value.md) | Ordered build items                    |
#
# ### `pull`
#
# | Value       | Meaning                                  |
# | ----------- | ---------------------------------------- |
# | `:MISSING:` | Pull the image only when it is not local |
# | `:ALWAYS:`  | Always pull the image                    |
# | `:NEVER:`   | Never pull the image                     |
#
# ### `mounts`
#
# Each element is a [`Dict`](../std/dict.md) with these keys:
#
# | Name     | Type                   | Meaning                                      |
# | -------- | ---------------------- | -------------------------------------------- |
# | `type`   | [`Sym`](../std/sym.md) | `:CACHE:`, `:BIND:`, `:VOLUME:`, or `:TMPFS:` |
# | `target` | [`Value`](../std/value.md) | Mount path in the container                  |
# | `source` | [`Value`](../std/value.md) | Mount source; required for `:BIND:`           |
# | `id`     | [`Value`](../std/value.md) | Optional cache ID; defaults to `target`       |
#
# ### `args`
#
# Vertical keyword items define tags and build steps. Items may be repeated.
#
# | Pattern       | Value                       | Meaning                            |
# | ------------- | --------------------------- | ---------------------------------- |
# | `tag: name`   | [`Str`](../std/str.md)       | Apply an output image tag          |
# | `run: func`   | [`Func`](../std/func.md)    | Run a function inside the container |
# | `add: spec`   | [`Dict`](../std/dict.md)     | Add a file to the image            |
# | `patch: spec` | [`Dict`](../std/dict.md)     | Apply a patch inside the image     |
# | `commit: msg` | [`Str`](../std/str.md)       | Commit a layer with a message      |
#
# #### `add: spec`
#
# `spec` accepts exactly one of `source` and `content`.
#
# | Name      | Type                                                                  | Meaning                         |
# | --------- | --------------------------------------------------------------------- | ------------------------------- |
# | `source`  | [`Str`](../std/str.md)\|[`fs.Path`](../fs/path.md)\|[`url.Url`](../url/url.md) | Source path or URL              |
# | `content` | [`Str`](../std/str.md)\|[`Bin`](../std/bin.md)                        | Content to write                |
# | `target`  | [`Str`](../std/str.md)\|[`fs.Path`](../fs/path.md)                    | Destination path                |
# | `chmod`   | [`Int`](../std/int.md)\|[`fs.unix.Mode`](../fs/unix/mode.md)         | Optional destination permissions |
#
# If `target` is a directory, a source path or URL retains its filename.
# Direct content is always written to `target` itself.
#
# #### `patch: spec`
#
# `spec` accepts exactly one of `source` and `content`.
#
# | Name      | Type                                            | Meaning                    |
# | --------- | ----------------------------------------------- | -------------------------- |
# | `source`  | [`Str`](../std/str.md)\|[`fs.Path`](../fs/path.md) | Unified patch file         |
# | `content` | [`Str`](../std/str.md)\|[`Bin`](../std/bin.md) | Unified patch data         |
#
# ## Returns
#
# [`Image`](./image.md)
#
# ## Example
#
# ```
# let img = docker.build
#   from: ubuntu:24.04
#   run: do run apt install -y curl
#   tag: my-image
# assert_eq $img.tags()[0].tag my-image
# ```
pub def build
  :pull = :MISSING:
  :mounts = []
  :cd = nil
  :env = {}
  :from ...args
do
  docker.build :pull :mounts :cd :env :from ...args

# List images, returning an iterator of `Image` objects
#
# ## Parameters
#
# - `all`: list all images
# - `filter`: optional filter expression (e.g. `"reference=myapp*"`)
#
# ## Returns
#
# An iterator of `Image` objects, one per repository:tag pair
pub def images :all = false :filter = nil
  docker.images :all :filter

# Get a single image by reference
#
# ## Parameters
#
# - `ref`: image reference (e.g. `"myapp:latest"`, `"sha256:abc..."`)
#
# ## Returns
#
# An `Image` object
pub def image ref
  docker.image $ref

# List containers.
pub def containers :all = false :filter = nil
  docker.containers :all :filter

# Get a single container by ID or name.
pub def container ref
  docker.container $ref

# Save one or more images to an archive.
#
# `format:` accepts either strings such as `docker_archive` or symbols such as
# `:docker_archive:`.
pub def save target :format = :docker_archive: :platform = nil ...images
  docker.save $target :format :platform ...images

# Load images from an archive.
pub def load source :platform = nil
  docker.load $source :platform

# Pull an image from a registry.
pub def pull ref :platform = nil
  docker.pull $ref :platform

# Push an image to a registry.
pub def push ref :platform = nil
  docker.push $ref :platform
