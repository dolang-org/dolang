# Runs and manages Docker containers and images.

import
  proc
  fs:
    - @Path
  _container.dockman: dockman

pub import _container.dockman:
  - Image
  - Container
  - NoImageError
  - NoContainerError
  - ContainerExitError
  - InvalidImageReferenceError
  - RegistryAuthError
  - ArchiveError
  - ContainerState
  - ImageTag
  - MountInfo
  - PortBinding
  - PushResult
  - @AddSpec
  - @ArchiveFormat
  - @BuildMount
  - @ContainerMount
  - @ContainerStatus
  - @Env
  - @PatchSpec
  - @Platform
  - @PortProtocol
  - @PortSpec
  - @PullPolicy
  - @RestartSpec

let docker_cli = proc.run[:docker:]

class DockerRuntime: dockman.Runtime
  def (init) self
    dockman.Runtime.(init) $self :DOCKER:

  pub def cli _self ...args
    env LC_ALL: C LANG: C do docker_cli ...args

let docker = DockerRuntime()

# Runs a command in a temporary Docker container.
pub def run
  # Image name or ID.
  image @ Str
  # Command to run instead of the image command.
  cmd @ Str
  # Container working directory.
  :cd @ (Str | Path) = nil
  # Container environment.
  :env @ Env = {}
  # Image pull policy.
  :pull @ PullPolicy = :MISSING:
  # Container name.
  :name @ Str = nil
  # Mounts.
  :mounts @ Iterable[ContainerMount] = []
  # Container labels.
  :labels @ Dict[(Str | Sym), Value] = {}
  # Ports to publish.
  :ports @ Iterable[PortSpec] = []
  # Networks to connect to, by name or ID.
  :networks @ Iterable[Str] = []
  # User, or `user:group`.
  :user @ Str = nil
  # Entrypoint override.
  :entrypoint @ Str = nil
  # Arguments passed to `cmd`.
  ...args
do -> nil
  docker.run $image $cmd :cd :env :pull :name :mounts :labels :ports :networks
    :user :entrypoint ...args

# Creates a stopped Docker container, in the `:CREATED:` state.
pub def create
  # Image name or ID.
  image @ Str
  # Command to run instead of the image command.
  cmd @ Str = nil
  # Container working directory.
  :cd @ (Str | Path) = nil
  # Container environment. `nil` values are not supported.
  :env @ Env = {}
  # Image pull policy.
  :pull @ PullPolicy = :MISSING:
  # Container name.
  :name @ Str = nil
  # Mounts.
  :mounts @ Iterable[ContainerMount] = []
  # Container labels.
  :labels @ Dict[(Str | Sym), Value] = {}
  # Ports to publish.
  :ports @ Iterable[PortSpec] = []
  # Networks to connect to, by name or ID.
  :networks @ Iterable[Str] = []
  # User, or `user:group`.
  :user @ Str = nil
  # Entrypoint override.
  :entrypoint @ Str = nil
  # Restart policy.
  :restart @ RestartSpec = nil
  # Arguments passed to `cmd`.
  ...args
do -> Container
  docker.create $image $cmd :cd :env :pull :name :mounts :labels :ports
    :networks :user :entrypoint :restart ...args

# Runs a function in a temporary Docker container.
#
# Program execution and filesystem access are redirected for the duration of
# the function.
pub def with[R]
  # Image name or ID.
  image @ Str
  # Function to run.
  func @ (() -> R)
  # Container working directory.
  :cd @ (Str | Path) = nil
  # Container environment.
  :env @ Env = {}
  # Image pull policy.
  :pull @ PullPolicy = :MISSING:
do -> R
  docker.with $image $func :cd :env :pull

# Builds a Docker image.
#
# ## Example
#
# ```
# let img = docker.build
#   from: ubuntu:24.04
#   run: do run apt install -y curl
#   tag: my-image
# assert_eq $img.tags()[0].tag my-image
# ```
pub def build
  # Image pull policy for the base image.
  :pull @ PullPolicy = :MISSING:
  # Mounts available to every build step.
  :mounts @ Iterable[BuildMount] = []
  # Working directory for `run` steps.
  :cd @ (Str | Path) = nil
  # Environment for `run` steps.
  :env @ Env = {}
  # Base image.
  :from @ Str
  # Build steps and tags, in order, as keyword arguments. Keys may repeat.
  #
  # | Key      | Value                        | Meaning                              |
  # | -------- | ---------------------------- | ------------------------------------ |
  # | `tag`    | `Str`                        | Apply an output image tag            |
  # | `run`    | `() -> Value`                | Run a function inside the container  |
  # | `add`    | [`AddSpec`](docker.AddSpec)     | Add a file to the image              |
  # | `patch`  | [`PatchSpec`](docker.PatchSpec) | Apply a patch inside the image       |
  # | `commit` | `Str`                        | Commit a layer with a message        |
  ...steps
do -> Image
  docker.build :pull :mounts :cd :env :from ...steps

# Lists images, one per repository and tag.
pub def images
  # List all images, including intermediate layers.
  :all @ Bool = false
  # Filter expression, such as `"reference=myapp*"`.
  :filter @ Str = nil
do -> Iterable[Image]
  docker.images :all :filter

# Gets an image by reference.
pub def image
  # Image reference, such as `"myapp:latest"` or `"sha256:abc..."`.
  ref @ Str
do -> Image
  docker.image $ref

# Lists containers.
pub def containers
  # List all containers, including stopped ones.
  :all @ Bool = false
  # Filter expression, such as `"name=myapp*"`.
  :filter @ Str = nil
do -> Iterable[Container]
  docker.containers :all :filter

# Gets a container by ID or name.
pub def container
  # Container ID or name.
  ref @ Str
do -> Container
  docker.container $ref

# Saves one or more images to an archive, returning `target`.
pub def save
  # Archive path to write.
  target @ (Str | Path)
  # Archive format.
  :format @ ArchiveFormat = :DOCKER_ARCHIVE:
  # Platform to save.
  :platform @ Platform = nil
  # Image references to save. Only `:DOCKER_ARCHIVE:` holds more than one.
  ...images @ Str
do -> (Str | Path)
  docker.save $target :format :platform ...images

# Loads images from an archive.
pub def load
  # Archive to load.
  source @ (Str | Path)
  # Platform to load.
  :platform @ Platform = nil
do -> Array[Image]
  docker.load $source :platform

# Pulls an image from a registry.
pub def pull
  # Image reference.
  ref @ Str
  # Platform to pull.
  :platform @ Platform = nil
do -> Image
  docker.pull $ref :platform

# Pushes an image to a registry.
pub def push
  # Image reference.
  ref @ Str
  # Platform to push.
  :platform @ Platform = nil
do -> PushResult
  docker.push $ref :platform
