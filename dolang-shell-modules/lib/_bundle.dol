# dolang: strict
# Runs bundles: programs packaged as an optional `#!` line followed by a zip
# archive, with `main.dol` as the entry and modules under `lib/`.
import _shell io load shell strand zip
@import compile fs

# Program members, by name: sources and bytecode for the entry and modules.
def is_member name @ Str -> Bool
  let ext = (name.ends_with(".dol") || name.ends_with(".dolc"))
  (ext && (name.starts_with("lib/") || name == "main.dol" || name == "main.dolc"))

# The archive's offset within the file, after an optional `#!` line, or `nil`
# when the file isn't a bundle. Only a bounded prefix is read.
pub def offset path @ fs.Path -> (Int | nil)
  let prefix = shell.with_host do
    path.open do |file| file.read 4096
  let start = if prefix.starts_with(b"#!")
    let lines = [...prefix.split(b"\n", limit: 1)]
    if (lines.len < 2)
      return nil
    (lines[0].len + 1)
  else
    0
  if prefix[start..].starts_with(b"PK\x03\x04")
    start
  else
    nil

class Bundle
  field path @ fs.Path
  field members @ Dict[Str, Bin]
  field strict @ Bool
  # Imported modules and the reservation that serializes loading each one.
  field modules @ Dict[Str, Value]
  field guards @ Dict[Str, strand.Resource]
  # Modules this strand is loading, to detect a cycle within the guard.
  field pending @ Dict[Str, Bool]

  def (init) self path @ fs.Path members @ Dict[Str, Bin] strict @ Bool
    self.#path = path
    self.#members = members
    self.#strict = strict
    self.#modules = {}
    self.#guards = {}
    self.#pending = {}

  # Run a member's bytecode, else compile its source. Stale bytecode is
  # recompiled from its source when there is one.
  def load_member
    self
    stem @ Str
    mode @ (:SCRIPT: | Str)
    prelude @ compile.Prelude
    <Iter[Value]
    >Sink[Value]
  do -> Value
    let source = self.#members.get "$stem.dol"
    let bytecode = self.#members.get "$stem.dolc"
    if let Bin(bytecode) = bytecode
      try
        return load.run $bytecode importer: (do |name| self.#import_module(name))
      catch std.BytecodeError: error
        if (source == nil)
          throw error
    let Bin(source) = source
    else throw std.RuntimeError "missing bundle member: $(self.#path)/$stem.dol"
    let label = "$(self.#path)/$stem.dol"
    let compiled = _shell.compile $label (Str source) :mode :prelude strict: $self.#strict
    load.run $compiled importer: (do |name| self.#import_module(name))

  # The member stem holding a module, or `nil` when the bundle lacks it.
  def find_module self name @ Str -> (Str | nil)
    let relative = name.replace "." "/"
    for stem = ["lib/$relative", "lib/$relative/mod"]
      if (self.#members.contains("$stem.dol") || self.#members.contains("$stem.dolc"))
        return stem
    nil

  # Resolve an import inside the bundle first, then globally. Each module runs
  # once, without strand I/O; other strands wait while one loads it.
  def import_module self name @ Str -> Value
    let Str(stem) = self.#find_module(name)
    else return load.import $name
    let guard = self.#guards.get $name else: do
      let guard = strand.Resource 1
      self.#guards[name] = guard
      guard
    guard.with do
      let modules = self.#modules
      if modules.contains(name)
        modules[name]
      else if self.#pending.contains(name)
        throw std.CyclicImportError $name
      else
        self.#pending[name] = true
        try
          let module = strand.redirect input: ([] @ Array[Value]) output: $std.null do
            self.#load_member $stem $name {}
          modules[name] = module
          module
        finally
          self.#pending.delete $name

  pub def run self prelude @ compile.Prelude <Iter[Value] >Sink[Value] -> Value
    if !(self.#members.contains("main.dol") || self.#members.contains("main.dolc"))
      throw std.RuntimeError "bundle has no main.dol: $(self.#path)"
    self.#load_member main :SCRIPT: $prelude

# Run the bundle at `offset` within `path`. Members are read up front, so the
# file is closed before the program runs.
pub def run
  path @ fs.Path
  offset @ Int
  :prelude @ compile.Prelude = {}
  :strict @ Bool = false
  <Iter[Value]
  >Sink[Value]
do -> Value
  let members @ Dict[Str, Bin] = {}
  shell.with_host do
    path.open do |file|
      zip.open (io.Cursor(file, (offset..))) r do |archive|
        for entry = archive.entries
          let name = str $entry.name
          if (entry.type == :FILE: && is_member(name))
            members[name] = entry.open do |member| member.read_all()
  let bundle = Bundle $path $members $strict
  bundle.run $prelude
