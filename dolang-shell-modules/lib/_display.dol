# dolang: strict
# Shared rendering for the YAML-shaped dumps the shell's inspection
# entrypoints print.
#
# A dump is an ordinary value, built whole and then emitted rather than printed
# as it is discovered: a section that turns out to have no content can be
# dropped entirely, and a block can align its keys against the widest one it
# holds.
#
# The shape of the value is the shape of the output, and `Node` names the
# shapes there are: a dict is a block of `key: value` lines, an array or tuple
# a block of `- item` lines, and a `Leaf` one line, so most of a dump is
# written as vertical layout. Any other value is rendered ahead of time into a
# `term.Text` -- by one of the leaves here, or by the caller -- and the
# renderer prints that as the finished line it is. Nothing is taken apart or
# guessed at here: a value the caller left as it is either has a shape the
# renderer knows or is one line.

import std sys term
import security.unix security.windows
import @fs @time @uuid

# A value printed on one line as itself.
pub @let Leaf = (nil | Bool | Int | Float | Str | Sym | term.Text | fs.Path | time.DateTime | uuid.Uuid)

# A dump: a block of keyed entries, a list of items, or one line.
pub @let Node = (Leaf | BaseDict[Str | Sym, Node] | BaseArray[Node] | Tuple[...Node])

# A rendered line: the column it starts at, and what it shows there.
@let Row = (Int, term.Text)

# A dump reads as the spec that would recreate what it describes, so it is
# colored as that source would be: the shell's own syntax highlighting, with
# keys and structural punctuation yellow, string literals green, numbers cyan,
# constants magenta, and the parenthetical asides dim as comments are.
#
# A value with no counterpart in source -- a timestamp, a UUID, a path, or a
# description this module wrote itself -- is left uncolored rather than being
# passed off as the string its rendering happens to be.
#
# The section heading has no counterpart in source, and answers to nothing.
let section_style = term.Style fg: :BRIGHT_BLUE: bold: true
let key_style = term.Style fg: :YELLOW:
let delim_style = term.Style fg: :YELLOW:
let literal_style = term.Style fg: :GREEN:
let number_style = term.Style fg: :CYAN:
let constant_style = term.Style fg: :MAGENTA:
let note_style = term.Style fg: :WHITE: dim: true
let absent_style = term.Style dim: true

let bullet = delim_style "- "

def spaces n @ Int -> Str
  " ".repeat(n)

let SIZE_UNITS = ["KiB", "MiB", "GiB", "TiB", "PiB", "EiB"]
# A unit only takes over from the one below it once the count is half again
# larger than the unit itself: switching exactly at 1024 would render 1025
# bytes as `1.00 KiB`, which says less than the number it replaced.
let SIZE_STEP = 1536.0

# --- Renderer ---------------------------------------------------------------

# True when `node` opens a block beneath the line that introduces it. An empty
# block has nothing to open, so it reads as `{}` or `[]` in place.
def opens node @ Node -> Bool
  if (type node std.BaseDict)
    return (node.len > 0)
  if (type node std.BaseArray || type node Tuple)
    return (node.len > 0)
  false

# Renders a leaf colored as the token it would be in source. A `Text` has
# already decided how it looks and is left alone.
def scalar value @ Leaf -> term.Text
  if (value == nil)
    absent_style "~"
  else if (type value term.Text)
    value
  else if (type value Sym || type value Bool)
    constant_style (str value)
  else if (type value Int || type value Float)
    number_style (str value)
  else if (type value Str)
    literal_style $value
  else
    term.text $value

# Renders the one-line form of `node`, which for an empty block is the marker
# it reads as in place.
def inline node @ Node -> term.Text
  if (type node std.BaseDict)
    absent_style "{}"
  else if (type node std.BaseArray || type node Tuple)
    absent_style "[]"
  else
    scalar $node

# Renders the block `node` opens, its lines starting at `indent`.
def rows node @ Node indent @ Int -> Array[Row]
  if (type node std.BaseDict)
    entry_rows $node $indent
  else if (type node std.BaseArray || type node Tuple)
    item_rows $node $indent
  else
    [(indent, scalar(node))]

def entry_rows entries @ BaseDict[Str | Sym, Node] indent @ Int -> Array[Row]
  # A key that leads into a block is on a line of its own, so it takes no part
  # in the alignment of the keys that share a column with their values.
  let width = 0
  for key value = entries
    if !opens(value)
      let key_width = (term.text "$key:").width()
      if (key_width > width)
        width = key_width
  let result @ Array[Row] = []
  for key value = entries
    let label = key_style "$key:"
    if opens(value)
      result.push (indent, label)
      result.push ...(rows value (indent + 2))
    else
      let pad = spaces (width - label.width() + 1)
      result.push (indent, term.text(label, pad, inline(value)))
  result

def item_rows items @ Iterable[Node] indent @ Int -> Array[Row]
  let result @ Array[Row] = []
  for item = items
    if !opens(item)
      result.push (indent, term.text(bullet, inline(item)))
    else if (type item std.BaseDict)
      # The first entry shares the bullet's line. The bullet is as wide as the
      # step a nested block is indented by, so it takes the place of the end
      # of that entry's indentation and every key stays in one column.
      let nested = entry_rows $item (indent + 2)
      let _ first = nested[0]
      nested[0] = (indent, term.text(bullet, first))
      result.push ...nested
    else
      # Every item of a nested list carries its own bullet, so this one has
      # nothing to lead into, and the list opens on the line below.
      result.push (indent, delim_style("-"))
      result.push ...(rows item (indent + 2))
  result

# --- Leaves -----------------------------------------------------------------

# Renders `value` on one line, with a dim parenthetical aside naming what it
# resolves to.
#
# A leaf needs no help from this -- the renderer handles one where it sits --
# so this is for a caller that wants the aside.
pub def text
  value @ Leaf
  note @ (Str | nil) = nil
do -> term.Text
  let line = scalar $value
  if (note == nil)
    return line
  term.text $line " " (note_style "($note)")

# Renders any iterable of symbols -- every flag type, and every mask a
# security descriptor reports -- as the set of names it holds.
#
# The names are separated the way a mask is usually written rather than the way
# a Do array is: each is an enumerated value in its own right, and reads as one.
pub def flags value @ (Iterable[Sym] | nil) -> term.Text
  if (value == nil)
    return scalar nil
  let names = [...value.map(do |name| constant_style(str name))]
  if (names.len == 0)
    return absent_style "[]"
  delim_style(" | ").join(names)

# Renders a value that answers to none of the colors: a description this module
# composed, a string standing in for something that is not one, or a value
# that is not a `Leaf`, flattened to its string conversion.
pub def plain
  value @ Value
  note @ (Str | nil) = nil
do -> term.Text
  text (term.text value) $note

# A number the caller has already written out -- in hex or octal, say -- so
# that it is colored as the number it is rather than the string it arrives as.
pub def number
  value @ (Str | Int)
  note @ (Str | nil) = nil
do -> term.Text
  text (number_style (str value)) $note

# A byte count, scaled to the largest binary unit it fills, with the exact
# number kept as the aside so the size is still readable off the line it is
# scaled on. A count small enough that a unit would only cost it precision is
# left as it is, as is one the caller asked for `raw`.
pub def size
  value @ (Int | nil)
  raw @ Bool = false
do -> term.Text
  if (value == nil)
    return scalar nil
  let count = term.text (number_style "$value") " bytes"
  if (raw || value < SIZE_STEP)
    return count
  let scaled = (float(value) / 1024.0)
  let unit = 0
  while (scaled >= SIZE_STEP && unit + 1 < SIZE_UNITS.len)
    scaled = (scaled / 1024.0)
    unit = (unit + 1)
  text $count "${scaled:.2f} $(SIZE_UNITS[unit])"

# --- Sections ---------------------------------------------------------------

# Prints one `▸ name` block, or nothing at all when the section has no content
# to show. A section that could not be read at all arrives as `nil` and reads
# the same way as one that came back empty.
pub def section
  name @ Str
  node @ Node
do
  if !opens(node)
    return nil
  print "  " (section_style "▸ $name") "\n"
  for indent body = rows $node 6
    print (spaces indent) $body "\n"

# --- System values ----------------------------------------------------------

# Evaluates `func`, answering `nil` when the value simply isn't there: a field
# that doesn't apply to this platform, an operation the target VFS doesn't
# support, or a query the OS refused.
pub def opt[T] func @ (() -> T) -> (T | nil)
  try
    func()
  catch std.FieldError: _
    nil
  catch std.UnsupportedError: _
    nil
  catch sys.Error: _
    nil

# A uid or gid, annotated with the name it resolves to.
pub def id
  value @ (Int | nil)
  kind @ (:USER: | :GROUP:)
do -> term.Text
  if (value == nil)
    return scalar nil
  let name = opt do
    if (kind == :USER:)
      security.unix.user_name $value
    else
      security.unix.group_name $value
  text $value $name

# A Windows SID, annotated with the account it names.
pub def sid value @ (security.windows.Sid | nil) -> term.Text
  if (value == nil)
    return scalar nil
  let name = opt do
    let account = value.lookup()
    "$(account.kind): $(account.qualified_name)"
  plain $value $name
