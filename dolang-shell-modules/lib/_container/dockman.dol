# dolang: strict
import progress json patch rand shlex strand proc sys transfer _vfs time
  std:
    - RuntimeError
    - TypeError
    - ValueError
    - @Entries
    - null
  strand:
    - pipeline
    - stream
    - each
  fs:
    - Path
    - with_temp_dir
    - @BinFile
  url:
    - Url
  shell:
    - Vfs
  _container.common:
    - runtime_dir
    - cache_dir
  fs.unix:
    - @Mode
  json:
    - @DecodeValue

# An image pull policy.
#
# | Value       | Meaning                                  |
# | ----------- | ---------------------------------------- |
# | `:MISSING:` | Pull the image only when it is not local |
# | `:ALWAYS:`  | Always pull the image                    |
# | `:NEVER:`   | Never pull the image                     |
pub @let PullPolicy = (:MISSING: | :ALWAYS: | :NEVER:)

# Environment variables to set. A value of `:INHERIT:` copies the variable from
# the calling environment; any other value is converted to a string.
pub @let Env = BaseDict[Str | Sym, Value]

# A mount for a container.
#
# | Key        | Meaning                                         |
# | ---------- | ----------------------------------------------- |
# | `type`     | Mount type                                      |
# | `target`   | Mount path in the container                     |
# | `source`   | Host path or volume name. Required for `:BIND:` |
# | `readonly` | Mount read-only. Defaults to `false`            |
pub @let ContainerMount = BaseDict $
  type: (:BIND: | :VOLUME: | :TMPFS:)
  target: (Str | Path)
  ?source: (Str | Path)
  ?readonly: Bool

# A mount available to every build step.
#
# | Key        | Meaning                                         |
# | ---------- | ----------------------------------------------- |
# | `type`     | Mount type                                      |
# | `target`   | Mount path in the container                     |
# | `source`   | Host path or volume name. Required for `:BIND:` |
# | `id`       | Cache ID. Defaults to `target`                  |
# | `readonly` | Mount read-only. Defaults to `false`            |
# | `size`     | Size limit                                      |
# | `chown`    | Change the mount's owner to the container user  |
# | `selinux`  | Relabel for SELinux: `:SHARED:` or `:PRIVATE:`  |
pub @let BuildMount = BaseDict $
  type: (:CACHE: | :BIND: | :VOLUME: | :TMPFS:)
  target: (Str | Path)
  ?source: (Str | Path)
  ?id: Str
  ?readonly: Bool
  ?size: (Int | Str)
  ?chown: Bool
  ?selinux: (:SHARED: | :PRIVATE:)

# A network protocol for a published port.
pub @let PortProtocol = (:TCP: | :UDP: | :SCTP:)

# A container port to publish on the host.
#
# | Key              | Meaning                                         |
# | ---------------- | ----------------------------------------------- |
# | `container_port` | Container port                                  |
# | `host_port`      | Host port. Assigned automatically when omitted  |
# | `host_ip`        | Host address to bind                            |
# | `protocol`       | Protocol. Defaults to `:TCP:`                   |
pub @let PortSpec = BaseDict $
  container_port: (Int | Str)
  ?host_port: (Int | Str)
  ?host_ip: Str
  ?protocol: PortProtocol

# A container restart policy.
#
# | Value              | Meaning                            |
# | ------------------ | ---------------------------------- |
# | `:NO:`             | Do not restart the container       |
# | `:ON_FAILURE:`     | Restart after an unsuccessful exit |
# | `:ALWAYS:`         | Always restart the container       |
# | `:UNLESS_STOPPED:` | Restart unless explicitly stopped  |
#
# `max_retries` limits restarts, and applies only to `:ON_FAILURE:`.
pub @let RestartSpec = BaseDict $
  policy: (:NO: | :ON_FAILURE: | :ALWAYS: | :UNLESS_STOPPED:)
  ?max_retries: Int

# A target platform: an `os/arch[/variant]` string, or its parts.
pub @let Platform = $
  | Str
  | BaseDict $
      os: Str
      arch: Str
      ?variant: Str

# An image archive format. Docker supports only `:DOCKER_ARCHIVE:`.
#
# | Value              | Meaning                                                 |
# | ------------------ | ------------------------------------------------------- |
# | `:DOCKER_ARCHIVE:` | Single-file Docker archive, the only multi-image format |
# | `:OCI_ARCHIVE:`    | Single-file OCI archive                                 |
# | `:OCI_DIR:`        | OCI layout directory                                    |
# | `:DOCKER_DIR:`     | Docker directory format                                 |
# | `:DIR:`            | Plain directory of layers                               |
pub @let ArchiveFormat = $
  | :DOCKER_ARCHIVE:
  | :OCI_ARCHIVE:
  | :OCI_DIR:
  | :DOCKER_DIR:
  | :DIR:

# A file to add in a build step, from a path or URL or as direct content.
#
# If `target` is a directory, a source path or URL keeps its file name. Direct
# content is always written to `target` itself. `chmod` sets the destination's
# permissions.
pub @let AddSpec = $
  | BaseDict $
      source: (Str | Path | Url)
      target: (Str | Path)
      ?chmod: (Int | Mode)
  | BaseDict $
      content: (Str | Bin)
      target: (Str | Path)
      ?chmod: (Int | Mode)

# A unified patch to apply in a build step, from a file or as direct content.
pub @let PatchSpec = $
  | BaseDict $
      source: (Str | Path)
  | BaseDict $
      content: (Str | Bin)

# The lifecycle state of a container.
pub @let ContainerStatus = $
  | :CREATED:
  | :RUNNING:
  | :PAUSED:
  | :RESTARTING:
  | :REMOVING:
  | :EXITED:
  | :DEAD:


# Build steps and tags, in order, as keyword arguments. Keys may repeat.
#
# | Key      | Value                                         | Meaning                              |
# | -------- | --------------------------------------------- | ------------------------------------ |
# | `tag`    | `Str`                                         | Apply an output image tag            |
# | `run`    | `() -> nil`                                   | Run a function inside the container  |
# | `add`    | [`AddSpec`](_container.dockman.AddSpec)       | Add a file to the image              |
# | `patch`  | [`PatchSpec`](_container.dockman.PatchSpec)   | Apply a patch inside the image       |
# | `commit` | `Str`                                         | Commit a layer with a message        |
#
# A `run` function has the strand input and output of the build's caller.
pub @let BuildSteps[I, O] = $
  *tag: Str
  *run: ((<I, >O) -> nil)
  *add: AddSpec
  *patch: PatchSpec
  *commit: Str

# A published port of a container, as reported by
# [`Container.state`](_container.dockman.Container.state).
pub class PortBinding
  field protocol @ (PortProtocol | Str)
  field container_port @ Int
  field host_ip @ (Str | nil)
  field host_port @ (Int | nil)

  def (init)
    self
    :protocol @ (PortProtocol | Str)
    :container_port @ Int
    :host_ip @ (Str | nil)
    :host_port @ (Int | nil)
  do
    self.#protocol = protocol
    self.#container_port = container_port
    self.#host_ip = host_ip
    self.#host_port = host_port

  # Protocol, or the runtime's own name for an unrecognized one.
  #[getter]
  pub def protocol self -> (PortProtocol | Str)
    self.#protocol

  # Port inside the container.
  #[getter]
  pub def container_port self -> Int
    self.#container_port

  # Host address, or `nil` when unpublished.
  #[getter]
  pub def host_ip self -> (Str | nil)
    self.#host_ip

  # Host port, or `nil` when unpublished.
  #[getter]
  pub def host_port self -> (Int | nil)
    self.#host_port

# A mount type a runtime reports, or its own name for an unrecognized one.
pub @let MountType = (:BIND: | :VOLUME: | :TMPFS: | :IMAGE: | :NPIPE: | :CLUSTER: | Str)

# A mount of a container, as reported by
# [`Container.state`](_container.dockman.Container.state).
pub class MountInfo
  field type @ (MountType | nil)
  field source @ (Path | nil)
  field target @ (Path | nil)
  field readonly @ Bool
  field mode @ (Str | nil)
  field propagation @ (Str | nil)
  field name @ (Str | nil)

  def (init)
    self
    :type @ (MountType | nil)
    :source @ (Path | nil)
    :target @ (Path | nil)
    :readonly @ Bool
    :mode @ (Str | nil)
    :propagation @ (Str | nil)
    :name @ (Str | nil)
  do
    self.#type = type
    self.#source = source
    self.#target = target
    self.#readonly = readonly
    self.#mode = mode
    self.#propagation = propagation
    self.#name = name

  # Mount type, or the runtime's own name for an unrecognized one.
  #[getter]
  pub def type self -> (:BIND: | :VOLUME: | :TMPFS: | :IMAGE: | :NPIPE: | :CLUSTER: | Str | nil)
    self.#type

  # Source on the host.
  #[getter]
  pub def source self -> (Path | nil)
    self.#source

  # Mount point in the container.
  #[getter]
  pub def target self -> (Path | nil)
    self.#target

  # Whether the mount is read-only.
  #[getter]
  pub def readonly self -> Bool
    self.#readonly

  # Mount mode, as the runtime reports it.
  #[getter]
  pub def mode self -> (Str | nil)
    self.#mode

  # Bind propagation, as the runtime reports it.
  #[getter]
  pub def propagation self -> (Str | nil)
    self.#propagation

  # Volume name.
  #[getter]
  pub def name self -> (Str | nil)
    self.#name

# The live state of a container.
pub class ContainerState
  field name @ (Str | nil)
  field state @ (ContainerStatus | Str | nil)
  field status @ (Str | nil)
  field ports @ Tuple[...PortBinding]
  field mounts @ Tuple[...MountInfo]

  def (init)
    self
    :name @ (Str | nil)
    :state @ (ContainerStatus | Str | nil)
    :status @ (Str | nil)
    :ports @ Iterable[PortBinding]
    :mounts @ Iterable[MountInfo]
  do
    self.#name = name
    self.#state = state
    self.#status = status
    self.#ports = Tuple $ports
    self.#mounts = Tuple $mounts

  # Container name.
  #[getter]
  pub def name self -> (Str | nil)
    self.#name

  # Lifecycle state, the runtime's own word for an unrecognized one, or `nil`
  # when the runtime reports no status.
  #[getter]
  pub def state self -> (ContainerStatus | Str | nil)
    self.#state

  # The runtime's own word for the state.
  #[getter]
  pub def status self -> (Str | nil)
    self.#status

  # Published ports.
  #[getter]
  pub def ports self -> Tuple[...PortBinding]
    self.#ports

  # Mounts.
  #[getter]
  pub def mounts self -> Tuple[...MountInfo]
    self.#mounts

# A repository and tag naming an image.
pub class ImageTag
  field repo @ Str
  field tag @ Str

  def (init) self :repo@Str :tag@Str
    self.#repo = repo
    self.#tag = tag

  # Repository.
  #[getter]
  pub def repo self -> Str
    self.#repo

  # Tag.
  #[getter]
  pub def tag self -> Str
    self.#tag

# The result of pushing an image.
pub class PushResult
  field ref @ Str
  field digest @ (Str | nil)

  def (init) self :ref@Str :digest@(Str | nil)
    self.#ref = ref
    self.#digest = digest

  # The reference pushed.
  #[getter]
  pub def ref self -> Str
    self.#ref

  # Digest of the pushed image, when the runtime reports one.
  #[getter]
  pub def digest self -> (Str | nil)
    self.#digest

let COPY_BLOCK_SIZE = 1048576

let PROGRAMS @ Dict[(:DOCKER: | :PODMAN:), Str] = $
  DOCKER: docker
  PODMAN: podman

let SAVE_FORMATS @ Dict[ArchiveFormat, Str] = $
  DOCKER_ARCHIVE: docker-archive
  OCI_ARCHIVE: oci-archive
  OCI_DIR: oci-dir
  DOCKER_DIR: docker-dir
  DIR: dir

let CONTAINER_STATES @ Dict[Str, ContainerStatus] = $
  "created": :CREATED:
  # Podman's own name for the state a container is in between `create` and
  # `start`, which is what Docker calls `created`. Podman 3.x reports it
  # verbatim in inspect output; 4.x onward reports `created` there instead.
  "configured": :CREATED:
  "running": :RUNNING:
  "paused": :PAUSED:
  "restarting": :RESTARTING:
  "removing": :REMOVING:
  "exited": :EXITED:
  "dead": :DEAD:

let MOUNT_TYPES @ Dict[Str, MountType] = $
  "bind": :BIND:
  "volume": :VOLUME:
  "tmpfs": :TMPFS:
  "image": :IMAGE:
  "npipe": :NPIPE:
  "cluster": :CLUSTER:

let PORT_PROTOCOLS @ Dict[Str, PortProtocol] = $
  "tcp": :TCP:
  "udp": :UDP:
  "sctp": :SCTP:

let CONTAINER_MOUNT_TYPES @ Set[Sym] = Set $
  - :BIND:
  - :VOLUME:
  - :TMPFS:

let BUILD_MOUNT_TYPES @ Dict[Sym, Str] = $
  CACHE: cache
  BIND: bind
  VOLUME: volume
  TMPFS: tmpfs

let CONTAINER_PORT_PROTOCOLS @ Dict[Sym, Str] = $
  TCP: tcp
  UDP: udp
  SCTP: sctp

let RESTART_POLICIES @ Dict[Sym, Str] = $
  NO: no
  ON_FAILURE: on-failure
  ALWAYS: always
  UNLESS_STOPPED: unless-stopped

let PULL_POLICIES @ Dict[Sym, Str] = $
  MISSING: missing
  ALWAYS: always
  NEVER: never

let INVALID_IMAGE_REFERENCE_ERRORS @ Array[Str] = $
  - INVALID REFERENCE FORMAT

let REGISTRY_AUTH_ERRORS @ Array[Str] = $
  - UNAUTHORIZED
  - AUTHENTICATION REQUIRED
  - REQUESTED ACCESS TO THE RESOURCE IS DENIED
  - DENIED

let NO_IMAGE_ERRORS @ Array[Str] = $
  - NO SUCH IMAGE
  - IMAGE NOT KNOWN
  - DOES NOT EXIST LOCALLY
  - MANIFEST UNKNOWN
  - FAILED TO RESOLVE REFERENCE

let ARCHIVE_ERRORS @ Array[Str] = $
  - ARCHIVE
  - TAR
  - PAYLOAD
  - NO SUCH FILE
  - CANNOT OPEN

let PUSH_NO_IMAGE_ERRORS @ Array[Str] = $
  - TAG DOES NOT EXIST
  - DOES NOT EXIST LOCALLY
  - IMAGE NOT KNOWN
  - NO SUCH IMAGE

let NO_CONTAINER_ERRORS @ Array[Str] = $
  - NO SUCH CONTAINER
  - NO CONTAINER WITH NAME OR ID
  - CONTAINER NOT KNOWN
  - NO CONTAINER FOUND

# Raised when an image reference is malformed.
#[final]
pub class InvalidImageReferenceError: RuntimeError
  # The malformed reference.
  pub field ref @ Str = nil

  def (init) self ref @ Str
    self.ref = ref
    RuntimeError.(init) $self "invalid image reference: $ref"

# Raised when a registry rejects the credentials for an image.
#[final]
pub class RegistryAuthError: RuntimeError
  # The image reference.
  pub field ref @ Str = nil

  def (init) self ref @ Str
    self.ref = ref
    RuntimeError.(init) $self "registry authentication failed: $ref"

# Raised when an image archive cannot be read or written.
#[final]
pub class ArchiveError: RuntimeError
  # The archive.
  pub field source @ (Str | Path) = nil

  def (init) self source @ (Str | Path)
    self.source = source
    RuntimeError.(init) $self "archive operation failed: $source"

# Raised when an image reference cannot be found.
#
# ```
# import docker
#
# try
#   docker.image "nonexistent:latest"
# catch docker.NoImageError: e
#   echo "not found: $e.ref"
# ```
#[final]
pub class NoImageError: RuntimeError
  # The image reference that was not found.
  pub field ref @ Str = nil

  def (init) self ref @ Str
    self.ref = ref
    RuntimeError.(init) $self "image not found: $ref"

  pub def (dbg) self -> Str
    "<NoImageError ref: $(dbg self.ref)>"

# Raised when a container ID or name cannot be found.
#[final]
pub class NoContainerError: RuntimeError
  # The container ID or name that was not found.
  pub field ref @ Str = nil

  def (init) self ref @ Str
    self.ref = ref
    RuntimeError.(init) $self "container not found: $ref"

  pub def (dbg) self -> Str
    "<NoContainerError ref: $(dbg self.ref)>"

# Raised by `Container.wait` when the container exits unsuccessfully.
#[final]
pub class ContainerExitError: RuntimeError
  # Numeric container exit status.
  pub field rc @ Int = nil

  def (init) self rc @ Int
    self.rc = rc
    RuntimeError.(init) $self "container exited with status: $rc"

  pub def (dbg) self -> Str
    "<ContainerExitError rc: $(self.rc)>"

# Podman's short-name resolution (containers-registries.conf(5)) prompts
# interactively -- or, with no TTY attached, just fails -- when a reference
# has no registry component and more than one (or zero) unqualified search
# registries are configured. Docker has no equivalent step: it always
# defaults bare names to Docker Hub. Fully qualifying the reference up front
# sidesteps short-name resolution entirely, so callers don't need a
# registries.conf tuned for non-interactive use.
def qualify_ref ref @ Str -> Str
  if !(ref.contains "/")
    return "docker.io/library/$ref"
  let host _ = ref.split "/" limit: 1
  else return "docker.io/$ref"
  if (host.contains "." || host.contains ":" || host == "localhost")
    ref
  else
    "docker.io/$ref"

# Applies a pull policy ("always" / "missing" / "never") up front, as a step
# separate from starting a container. Docker/Podman's own inline
# `run --pull=...` prints pull progress and "unable to find image locally"
# straight to the real stderr with no way to capture or quiet it; pulling
# explicitly reuses `Runtime.pull`, which redirects output and classifies
# failures (`NoImageError`, `RegistryAuthError`, etc.) via known error
# patterns.
def ensure_image runtime@Runtime img@Str policy@PullPolicy
  let cli = PULL_POLICIES.get $policy else: do
    throw ValueError "unsupported pull policy: $policy"
  if (cli == "always")
    let _ = runtime.pull $img
  else if (cli == "missing")
    let present = try
      inspect_image $runtime $img
      true
    catch NoImageError: _
      false
    if !present
      let _ = runtime.pull $img

def normalize_known[K] mapping@Dict[Str, K] value@Str -> (K | Str)
  mapping.get $value default: $value

# Raises the error for inspect output of an unexpected shape
def malformed what @ Str -> Never
  throw TypeError "inspect: unexpected $what"

# A string in inspect output, or `nil` where it's absent or null
def optional_str what@Str value@DecodeValue -> (Str | nil)
  match value
    Str(s) do s
    nil do nil
  else
    malformed $what

# An array of strings in inspect output
def strings what@Str value@DecodeValue -> Array[Str]
  let Array(items) = value
  else malformed $what
  let result @ Array[Str] = []
  for item = items
    let Str(s) = item
    else malformed $what
    result.push $s
  result

# An object of strings in inspect output, or `nil` where it's null
def string_dict what@Str value@DecodeValue -> (Dict[Str, Str] | nil)
  if (value == nil)
    return nil
  let Dict(items) = value
  else malformed $what
  let result @ Dict[Str, Str] = {}
  for key item = items
    let Str(s) = item
    else malformed $what
    result[key] = s
  result

# `Cmd` and `Entrypoint` in inspect output are an argument array, except in
# podman 3.x, which reports `Entrypoint` as a single string. Split it back
# apart so the field has the same shape on every backend.
#
# Podman built the string with a plain space join, which does not quote, so
# an argument containing whitespace cannot be recovered faithfully by any
# splitting rule. `shlex` at least handles the case where such an argument
# was quoted before it reached the runtime.
def normalize_argv what@Str value@DecodeValue -> (Array[Str] | nil)
  match value
    Str(s) do [...shlex.split(s)]
    nil do nil
  else
    strings $what $value

def container_env_args env @ Env -> Array[Str]
  let args @ Array[Str] = []
  for key value = env
    if (value == nil)
      throw ValueError "env: nil values are not supported by create"
    if (value == :INHERIT:)
      args.push --env "$key"
    else
      args.push --env "$key=$value"
  args

def container_label_args labels @ BaseDict[Str | Sym, Value] -> Array[Str]
  let args @ Array[Str] = []
  for key value = labels
    args.push --label "$key=$value"
  args

def container_port_args ports @ Iterable[PortSpec] -> Array[Str]
  let args @ Array[Str] = []
  for port = ports
    bind port
      :container_port
      :host_port = nil
      :host_ip = nil
      :protocol = :TCP:
    let protocol = CONTAINER_PORT_PROTOCOLS.get $protocol else: do
      throw ValueError "unsupported port protocol: $protocol"
    let spec = "$container_port/$protocol"
    if (host_port != nil)
      spec = "$host_port:$spec"
    if (host_ip != nil)
      if (host_port == nil)
        spec = "$host_ip::$spec"
      else
        spec = "$host_ip:$spec"
    args.push --publish $spec
  args

def container_network_args networks @ Iterable[Str] -> Array[Str]
  let args @ Array[Str] = []
  for network = networks
    args.push --network $network
  args

def container_restart_args restart @ (RestartSpec | nil) -> Array[Str]
  if (restart == nil)
    return []
  bind restart
    :policy
    :max_retries = nil
  let cli = RESTART_POLICIES.get $policy else: do
    throw ValueError "unsupported restart policy: $policy"
  if (max_retries != nil)
    if (cli != "on-failure")
      throw ValueError "restart max_retries requires on-failure policy"
    cli = "$cli:$max_retries"
  ["--restart", cli]

def container_create_args
  :name @ (Str | nil)
  :env @ Env
  :mounts @ Iterable[ContainerMount]
  :labels @ BaseDict[Str | Sym, Value]
  :ports @ Iterable[PortSpec]
  :networks @ Iterable[Str]
  :user @ (Str | nil)
  :cd @ (Str | Path | nil)
  :entrypoint @ (Str | nil)
  :restart @ (RestartSpec | nil)
do -> Array[Value]
  return $
    if (name != nil)
      --name $name
    ...(container_env_args env)
    ...(container_mount_args mounts)
    ...(container_label_args labels)
    ...(container_port_args ports)
    ...(container_network_args networks)
    if (user != nil)
      --user $user
    if (cd != nil)
      --workdir $cd
    if (entrypoint != nil)
      --entrypoint $entrypoint
    ...(container_restart_args restart)

def container_run_args
  :name @ (Str | nil)
  :mounts @ Iterable[ContainerMount]
  :labels @ BaseDict[Str | Sym, Value]
  :ports @ Iterable[PortSpec]
  :networks @ Iterable[Str]
  :user @ (Str | nil)
do -> Array[Value]
  return $
    if (name != nil)
      --name $name
    ...(container_mount_args mounts)
    ...(container_label_args labels)
    ...(container_port_args ports)
    ...(container_network_args networks)
    if (user != nil)
      --user $user

def normalize_platform platform @ (Platform | nil) -> (Str | nil)
  match platform
    nil do nil
    Str(s) do s
  else
    bind platform
      :os
      :arch
      :variant = nil
    if variant
      "$os/$arch/$variant"
    else
      "$os/$arch"

def output_lines output@Str stderr@Iterable[Str] -> Array[Str]
  let lines @ Array[Str] = []
  if output
    for line = output.split "\n"
      line = line.trim()
      if line
        lines.push $line
  for line = stderr
    line = line.trim()
    if line
      lines.push $line
  lines

# Merges captured stdout and stderr line arrays, trimming and dropping blanks.
def merged_lines out@Array[Str] err@Array[Str] -> Array[Str]
  let lines @ Array[Str] = []
  for stream = [out, err]
    for line = stream
      line = line.trim()
      if line
        lines.push $line
  lines

def matches_any haystack@Str needles@Array[Str] -> Bool
  needles.any do |needle| haystack.contains $needle

def classify_image_error ref@Str lines@Array[Str]
  for line = lines
    let upper = line.upper()
    if (matches_any upper INVALID_IMAGE_REFERENCE_ERRORS)
      throw InvalidImageReferenceError $ref
    if (matches_any upper REGISTRY_AUTH_ERRORS)
      throw RegistryAuthError $ref
    if (matches_any upper NO_IMAGE_ERRORS)
      throw NoImageError $ref

def classify_archive_error source@(Str | Path) lines@Array[Str]
  for line = lines
    let upper = line.upper()
    if (matches_any upper INVALID_IMAGE_REFERENCE_ERRORS)
      throw InvalidImageReferenceError $(str source)
    if (matches_any upper ARCHIVE_ERRORS)
      throw ArchiveError $source

def classify_push_error ref@Str lines@Array[Str]
  for line = lines
    let upper = line.upper()
    if (matches_any upper INVALID_IMAGE_REFERENCE_ERRORS)
      throw InvalidImageReferenceError $ref
    if (matches_any upper REGISTRY_AUTH_ERRORS)
      throw RegistryAuthError $ref
    if (matches_any upper PUSH_NO_IMAGE_ERRORS)
      throw NoImageError $ref

def classify_container_error ref@Str lines@Array[Str]
  for line = lines
    let upper = line.upper()
    if (matches_any upper NO_CONTAINER_ERRORS)
      throw NoContainerError $ref

# Last resort for a CLI failure none of the `classify_*` tables recognized.
#
# Their captured output is redirected away from the real stderr so routine
# chatter (pull progress and the like) stays out of the log, which means an
# unrecognized failure would otherwise be rethrown as a bare `proc.Error`
# reporting only the exit status, with everything the CLI actually said
# discarded. Dump it before rethrowing, the same fallback `transfer` uses for
# unrecognized unpacking errors.
def report_unknown lines @ Array[Str]
  if lines.len
    echo $"\n".join(lines)

def parse_container_ports ports @ DecodeValue -> Array[PortBinding]
  let Dict(entries) = ports
  else malformed Ports
  let mapped @ Array[PortBinding] = []
  for key bindings = entries
    let port proto = key.split "/" limit: 1
    else malformed "port $key"
    let protocol = normalize_known $PORT_PROTOCOLS $proto
    let container_port = int $port
    match bindings
      nil do
        mapped.push $ PortBinding
          :protocol
          :container_port
          host_ip: nil
          host_port: nil
      Array(items) do
        for binding = items
          bind binding
            Dict $
              "HostIp": host_ip = nil
              "HostPort": host_port = nil
              ...
          else malformed "port $key"
          let host_port = optional_str HostPort $host_port
          mapped.push $ PortBinding
            :protocol
            :container_port
            host_ip: $optional_str("HostIp", host_ip)
            host_port: $(host_port != nil && int(host_port) || nil)
    else
      malformed "port $key"
  mapped

def parse_container_mounts mounts @ DecodeValue -> Array[MountInfo]
  let Array(items) = mounts
  else malformed Mounts
  let mapped @ Array[MountInfo] = []
  for mount = items
    bind mount
      Dict $
        "Type": type = nil
        "Source": source = nil
        "Destination": target = nil
        "Mode": mode = nil
        "RW": rw = true
        "Propagation": propagation = nil
        "Name": name = nil
        ...
    else malformed Mounts
    let Bool(writable) = rw
    else malformed RW
    let type = optional_str Type $type
    let source = optional_str Source $source
    let target = optional_str Destination $target
    mapped.push $ MountInfo
      type: $(type != nil && normalize_known(MOUNT_TYPES, type) || nil)
      source: $(source != nil && Path(source) || nil)
      target: $(target != nil && Path(target) || nil)
      readonly: (!writable)
      mode: $optional_str("Mode", mode)
      propagation: $optional_str("Propagation", propagation)
      name: $optional_str("Name", name)
  mapped

# Podman qualifies a locally built/tagged reference with a synthetic
# `localhost/` registry that Docker never adds for the equivalent
# unqualified name, so it is stripped for Podman to keep `repo` consistent
# across backends.
def parse_image_tags runtime@Runtime repo_tags@Array[Str] -> Array[ImageTag]
  let strip_localhost = (runtime.id == :PODMAN:)
  let tags @ Array[ImageTag] = []
  for ref = repo_tags
    let repo tag = ref.split ":" limit: 1
    else malformed "tag $ref"
    if (strip_localhost && repo.starts_with "localhost/")
      repo = repo.without_prefix "localhost/"
    tags.push $ ImageTag :repo :tag
  tags

# The first object in what `inspect` printed
def inspected output @ Str -> Dict[Str, DecodeValue]
  let Array(items) = json.decode $output
  else malformed output
  let Dict(data) = items[0]
  else malformed output
  data

def inspect_image runtime@Runtime ref@Str -> Dict[Str, DecodeValue]
  let lines @ Array[Str] = []
  let output = try
    sub do runtime.cli inspect --type image $ref stderr: $lines.prechomp()
  catch proc.Error: e
    classify_image_error $ref $lines
    report_unknown $lines
    throw e
  inspected $output

def inspect_container runtime@Runtime ref@Str -> Dict[Str, DecodeValue]
  let lines @ Array[Str] = []
  let output = try
    sub do runtime.cli inspect --type container $ref stderr: $lines.prechomp()
  catch proc.Error: e
    classify_container_error $ref $lines
    report_unknown $lines
    throw e
  inspected $output

# Recognized prefixes, in the forms `load` reports them:
#
# - `Loaded image: ref` and `Loaded image ID: sha256:...`, one line per
#   image, from Docker and podman 4.x onward
# - `Loaded image(s): ref,ref`, a single line listing every image, from
#   podman 3.x
def parse_loaded_refs output@Str stderr@Array[Str] -> Array[Str]
  let refs @ Array[Str] = []
  for line = output_lines $output $stderr
    if (line.starts_with "Loaded image(s):")
      let _ rest = line.split ":" limit: 1
      else continue
      for ref = rest.split ","
        refs.push $ref.trim()
    else if (
      line.starts_with "Loaded image ID:" ||
      line.starts_with "Loaded image:"
    )
      let _ ref = line.split ":" limit: 1
      else continue
      refs.push $ref.trim()
  refs

def parse_pushed_digest output@Str stderr@Array[Str] -> (Str | nil)
  for line = output_lines $output $stderr
    let upper = line.upper()
    if (upper.contains "DIGEST:")
      let separator = (line.contains("digest:") && "digest:" || "Digest:")
      let _ rest = line.split $separator limit: 1
      else continue
      let digest ..._ = rest.trim().split " " limit: 1
      else continue
      return digest

# Runs Docker or Podman.
pub class Runtime
  # Which runtime this is.
  pub field id @ (:DOCKER: | :PODMAN:)

  field program @ proc.Program

  def (init) self id @ (:DOCKER: | :PODMAN:)
    self.#program = proc.run[PROGRAMS[id]]
    self.id = id

  # Runs the CLI in a locale-independent environment, so that output this
  # module parses back is not translated. The CLI reads `stdin`, and nothing
  # without it.
  @def cli
    self
    :stdin @ (Path | Str | Iterable[Value]) = nil
    :stdout @ (Path | Str | Sinkable[Str])
    :stderr @ (Path | Str | Sinkable[Str] | :STDOUT:) = nil
    *args @ Value
  do

  @def cli
    self
    :stdin @ (Path | Str | Iterable[Value]) = nil
    :stderr @ (Path | Str | Sinkable[Str] | :STDOUT:) = nil
    *args @ Value
    >Sink[Str]
  do

  pub def cli
    self
    :stdin @ (Path | Str | Iterable[Value]) = nil
    :stdout @ (Path | Str | Sinkable[Str]) = nil
    :stderr @ (Path | Str | Sinkable[Str] | :STDOUT:) = nil
    *args @ Value
    >Sink[Str]
  do
    let program = self.#program
    let input = if (stdin == nil)
      null
    else
      stdin
    env LC_ALL: C LANG: C do
      # Locals, since a test of what a block captures doesn't narrow it
      let out = stdout
      let err = stderr
      program ...args stdin: $input
        if (out != nil)
          stdout: $out
        if (err != nil)
          stderr: $err

  # Runs the CLI with output captured, printing it only on failure
  pub def quiet_cli self *args @ Value
    let output = StrBuf()
    try
      self.cli ...args stdout: $output stderr: $output
    catch proc.Error: e
      if output.len
        print $output.freeze()
      throw e

  pub def mount_uopt self -> Str
    if (self.id == :PODMAN:)
      ",U"
    else
      ""

  pub def with[R]
    self
    ctr @ Str
    thunk @ (() -> R)
    :cd @ (Str | Path) = nil
    :env @ Env = {}
    :pull @ PullPolicy = :MISSING:
  do -> R
    ensure_image $self $ctr $pull
    let ctr_subdir = Path /tmp/dolang-vfs-dir
    let ctr_socket = (ctr_subdir / "socket")
    let ctr_agent = Path "/tmp/dolang-vfs"
    let agent_bin = _vfs.bin()
    let uopt = self.mount_uopt()

    with_temp_dir parent: $runtime_dir() do |subdir|
      subdir.update_metadata mode: 0o700
      let socket = (subdir / "socket")
      let input = strand.input()
      # The socket's mode cannot identify the client: the container maps uids
      # however it likes, so it is bound 0666 and anything that can traverse the
      # directory -- every process in the container, and root -- can connect.
      # The key is what distinguishes the real client: `--accept` serves one
      # peer that proves it, and unlinks the socket once it has.
      let key = _vfs.key()
      # The pipeline's first stage is only the agent bootstrap process, not
      # user command output, so capturing its stderr for classification
      # (rather than the pull chatter leaking to the real terminal) is safe.
      let lines @ Array[Str] = []
      try
        pipeline
          do self.cli run --rm -i --pull=never
            --entrypoint $ctr_agent
            -v $subdir:$ctr_subdir:rw,z$uopt
            -v $agent_bin:$ctr_agent:ro,z$uopt
            $ctr ...(_vfs.vfs_args cd env) --key-stdin --accept $ctr_socket
            stdin: (_vfs.key_input key)
            stderr: $lines.prechomp()
          do
            strand.next()
            let agent = Vfs.unix_socket $socket :key
            try
              return strand.with_io input: $input do agent.with $thunk
            finally
              time.timeout 30 do agent.stop()
      catch proc.Error: e
        classify_image_error $ctr $lines
        report_unknown $lines
        throw e

  def run_direct
    self
    ctr @ Str
    cmd @ Str
    :cd @ (Str | Path | nil)
    :env @ Env
    :argv @ Tuple[...Value]
    :pull @ PullPolicy
    :name @ (Str | nil)
    :mounts @ Iterable[ContainerMount]
    :labels @ BaseDict[Str | Sym, Value]
    :ports @ Iterable[PortSpec]
    :networks @ Iterable[Str]
    :user @ (Str | nil)
    :entrypoint @ (Str | nil)
    <Iter[Value]
    >Sink[Str]
  do
    ensure_image $self $ctr $pull
    let executable = (entrypoint || cmd)
    let executable_args = if entrypoint
      [cmd, ...argv]
    else
      [...argv]
    let config_args = container_run_args
      :name :mounts :labels :ports :networks :user
    self.cli run --rm -i --pull=never
      ...config_args
      --entrypoint env $ctr ...(_vfs.env_args cd env)
      $executable ...executable_args
      stdin: $strand.input()

  pub def run
    self
    ctr @ Str
    cmd @ Str
    :cd @ (Str | Path) = nil
    :env @ Env = {}
    :pull @ PullPolicy = :MISSING:
    :name @ Str = nil
    :mounts @ Iterable[ContainerMount] = []
    :labels @ BaseDict[Str | Sym, Value] = {}
    :ports @ Iterable[PortSpec] = []
    :networks @ Iterable[Str] = []
    :user @ Str = nil
    :entrypoint @ Str = nil
    *args @ Value
    <Iter[Value]
    >Sink[Str]
  do
    self.#run_direct $ctr $cmd
      :cd :env :pull :name :mounts :labels :ports :networks :user :entrypoint
      argv: $args

  pub def create
    self
    image @ Str
    cmd @ (Str | nil) = nil
    :name @ Str = nil
    :env @ Env = {}
    :mounts @ Iterable[ContainerMount] = []
    :labels @ BaseDict[Str | Sym, Value] = {}
    :ports @ Iterable[PortSpec] = []
    :networks @ Iterable[Str] = []
    :user @ Str = nil
    :cd @ (Str | Path) = nil
    :entrypoint @ Str = nil
    :restart @ RestartSpec = nil
    :pull @ PullPolicy = :MISSING:
    *args @ Value
  do -> Container
    ensure_image $self $image $pull
    let config_args = container_create_args
      :name :env :mounts :labels :ports :networks :user :cd :entrypoint :restart
    let lines @ Array[Str] = []
    let output = try
      sub do self.cli create --pull=never
        ...config_args
        $image
        if (cmd != nil)
          $cmd ...args
        stderr: $lines.prechomp()
    catch proc.Error: e
      classify_image_error $image $lines
      report_unknown $lines
      throw e
    self.container $output.trim()

  pub def build[I, O]
    self
    :pull @ PullPolicy = :MISSING:
    :mounts @ Iterable[BuildMount] = []
    :cd @ (Str | Path) = nil
    :env @ Env = {}
    :from @ Str
    **steps @ BuildSteps[I, O]
    <I
    >O
  do -> Image
    with_temp_dir parent: $runtime_dir() do |subdir|
      subdir.update_metadata mode: 0o700
      let b = Builder $self $subdir $_vfs.bin() $mounts $cd $env
      b.build $from :pull ...steps

  pub def images self :all@Bool = false :filter@Str = nil -> Iterable[Image]
    stream do pipeline
      do self.cli images --no-trunc -q
        if (filter != nil)
          --filter $filter
        if all
          --all
      do each do |id|
        self.image $id.trim()

  pub def containers self :all@Bool = false :filter@Str = nil -> Iterable[Container]
    stream do pipeline
      do self.cli ps --no-trunc -q
        if all
          --all
        if (filter != nil)
          --filter $filter
      do each do |id|
        self.container $id.trim()

  pub def image self ref @ Str -> Image
    let data = inspect_image $self $ref
    Image $self $data

  pub def container self ref @ Str -> Container
    let data = inspect_container $self $ref
    Container $self $data

  pub def save
    self
    target @ (Str | Path)
    :format @ ArchiveFormat = :DOCKER_ARCHIVE:
    :platform @ Platform = nil
    *images @ Str
  do -> (Str | Path)
    if (images.len == 0)
      throw "save: expected at least one image"
    let cli = SAVE_FORMATS.get $format else: do
      throw "unsupported save format: $format"
    if (self.id == :DOCKER: && cli != "docker-archive")
      throw "docker only supports docker_archive for save"
    let file = (cli == "docker-archive" || cli == "oci-archive")
    let multi = (cli == "docker-archive")
    if (!multi && images.len > 1)
      throw "save format does not support multiple images: $format"
    let platform = normalize_platform $platform
    let refs = [...images]
    let lines @ Array[Str] = []
    # Whatever the CLI prints when it doesn't write the archive there is only
    # for classifying a failure
    let out = if file
      target
    else
      lines.prechomp()
    try
      self.cli save
        if (self.id == :PODMAN:)
          --format $cli
        if !file
          --output $Path(target)
        if (platform != nil)
          --platform $platform
        ...refs
        stdout: $out
        stderr: $lines.prechomp()
    catch proc.Error: e
      classify_image_error $refs[0] $lines
      classify_archive_error $(file && target || Path(target)) $lines
      report_unknown $lines
      throw e
    target

  pub def load
    self
    source @ (Str | Path)
    :platform @ Platform = nil
  do -> Array[Image]
    let source = Path $source
    let platform = normalize_platform $platform
    let lines @ Array[Str] = []
    let output = try
      sub do self.cli load
        --input $source
        if (platform != nil)
          --platform $platform
        stderr: $lines.prechomp()
    catch proc.Error: e
      classify_archive_error $source $lines
      report_unknown $lines
      throw e
    let refs = parse_loaded_refs $output $lines
    if (refs.len == 0)
      throw ArchiveError $source
    let loaded @ Array[Image] = []
    let seen @ Set[Str] = Set()
    for ref = refs
      let img = self.image $ref
      if !(seen.contains img.id)
        seen.add $img.id
        loaded.push $img
    loaded

  pub def pull self ref@Str :platform@Platform = nil -> Image
    if (self.id == :PODMAN:)
      ref = qualify_ref $ref
    let platform = normalize_platform $platform
    let out @ Array[Str] = []
    let lines @ Array[Str] = []
    try
      self.cli pull --quiet
        if (platform != nil)
          --platform $platform
        $ref
        stdout: $out.prechomp()
        stderr: $lines.prechomp()
    catch proc.Error: e
      # Capture both streams rather than `sub`bing stdout: on failure `sub`'s
      # value never materializes, so anything the CLI said there would be lost.
      let all = merged_lines $out $lines
      classify_image_error $ref $all
      report_unknown $all
      throw e
    for line = merged_lines $out $lines
      if (line.starts_with "sha256:")
        return self.image $line
    self.image $ref

  pub def push self ref@Str :platform@Platform = nil -> PushResult
    let platform = normalize_platform $platform
    let lines @ Array[Str] = []
    let output = try
      sub do self.cli push
        if (platform != nil)
          --platform $platform
        $ref
        stderr: $lines.prechomp()
    catch proc.Error: e
      classify_push_error $ref $lines
      report_unknown $lines
      throw e
    let digest = parse_pushed_digest $output $lines
    PushResult :ref :digest

def mount_args mounts @ Iterable[BuildMount] -> Array[Str]
  let args @ Array[Str] = []
  for m = mounts
    bind m
      :type
      :target
      :id = nil
      :source = nil
      :readonly = false
      :size = nil
      :chown = false
      :selinux = nil
    let kind = BUILD_MOUNT_TYPES.get $type else: do
      throw ValueError "unsupported mount type: $type"
    if (kind == "cache")
      # Emulate cache mount with bind mount for Docker
      source = cache_dir $(id || str(target))
      kind = "bind"
    let label = match selinux
      :SHARED: do "z"
      :PRIVATE: do "Z"
    if (kind == "bind")
      let parts = $
        if readonly
          - ro
        else
          - rw
        if chown
          - U
        if (label != nil)
          - $label
      args.push -v $source:$target:$(",".join parts)
    else
      let parts = $
        - type=$kind
        - target=$target
        if (source != nil)
          - source=$source
        if readonly
          - readonly
        else
          - rw
        if (size != nil)
          - size=$size
        if chown
          - chown=$chown
        if (label != nil)
          - $label
      args.push --mount=$(",".join parts)
  args

def container_mount_args mounts @ Iterable[ContainerMount] -> Array[Str]
  let checked @ Array[ContainerMount] = []
  for mount = mounts
    bind mount
      :type
      :source = nil
      ...
    if !(CONTAINER_MOUNT_TYPES.contains type)
      throw ValueError "unsupported container mount type: $type"
    if (type == :BIND: && source == nil)
      throw ValueError "bind mount requires source"
    checked.push $mount
  mount_args $checked

def path_leaf path @ Path -> Str
  let name = path.name
  if !name
    throw "path has no filename: $path"
  name

def url_leaf url @ Url -> Str
  let name = url.name
  if !name
    throw "source URL has no filename: $url"
  name

def parse_source source @ (Str | Path | Url) -> (Path | Url)
  match source
    Str(s) do
      if (s.starts_with "http://" || s.starts_with "https://")
        Url $s
      else
        Path $s
  else
    source

class Cache
  field paths @ Dict[Str, Path] = {}

  pub def ensure self url @ Url
    self.#paths[str(url)] = transfer.get $url app: dolang-container

  pub def path self url @ Url -> Path
    self.#paths.get $str(url) else: do
      throw "cache entry missing for URL: $url"

let cache = Cache()

def prefetch_add_urls adds @ Array[AddSpec]
  let urls @ Set[Url] = Set()
  for add = adds
    bind add
      :source = nil
      ...
    if (source != nil)
      let Url(url) = parse_source $source
      else continue
      urls.add $url
  strand.pool 4 $urls do |url| cache.ensure $url

def patch_name p @ patch.Patch -> Str
  let kind = p.type
  match kind
    :CREATE: do "create $(p.target)"
    :DELETE: do "delete $(p.source)"
  else
    let source = p.source
    let target = p.target
    if (kind == :MODIFY: || source == target)
      "modify $source"
    else
      "$(str(kind).lower()): $source => $target"

pub class Builder
  field runtime @ Runtime
  field subdir @ Path
  field socket @ Path
  field ctr_subdir @ Path
  field ctr_socket @ Path
  field ctr_agent @ Path
  field bin @ Path
  field mounts @ Iterable[BuildMount]
  field cd @ (Str | Path | nil)
  field env @ Env
  field agent @ (Vfs | nil) = nil
  field ctr_name @ (Str | nil) = nil
  field handle @ (strand.Stream[nil, Value, Value] | nil) = nil

  def (init)
    self
    runtime @ Runtime
    subdir @ Path
    bin @ Path
    mounts @ Iterable[BuildMount]
    cd @ (Str | Path | nil)
    env @ Env
  do
    self.#runtime = runtime
    self.#subdir = subdir
    self.#bin = bin
    self.#mounts = mounts
    self.#cd = cd
    self.#env = env
    self.#socket = (subdir / "socket")
    let ctr_subdir = Path /tmp/dolang-vfs-dir
    self.#ctr_subdir = ctr_subdir
    self.#ctr_socket = (ctr_subdir / "socket")
    self.#ctr_agent = Path "/tmp/dolang-vfs"

  # The connected agent
  def live_agent self -> Vfs
    let agent = self.#agent
    if (agent == nil)
      throw RuntimeError "build container is not connected"
    agent

  # The running container's name
  def live_ctr_name self -> Str
    let name = self.#ctr_name
    if (name == nil)
      throw RuntimeError "build container is not running"
    name

  # Runs the container in the foreground under a background strand. The name
  # is generated because a foreground `run` prints no container ID, and the
  # commit steps need something to name the live container by. Callers are
  # responsible for ensuring `img` is present first (see `build`'s dedicated
  # pull step) -- `connect` never pulls.
  def connect self img @ Str
    if self.#socket.exists()
      self.#socket.remove()
    let name = "dolang-vfs-$(rand.string 16)"
    # The socket's mode cannot identify the client: the container maps uids
    # however it likes, so it is bound 0666 and anything that can traverse the
    # directory -- every process in the container, and root -- can connect. The
    # key is what distinguishes the real client: `--accept` serves one peer that
    # proves it, and unlinks the socket once it has. A fresh key per container
    # falls out of `step_commit` reconnecting through here.
    let key = _vfs.key()
    let lines @ Array[Str] = []
    let runtime = self.#runtime
    let uopt = runtime.mount_uopt()
    let handle = stream do runtime.cli run -i --rm --name $name --pull=never
      ...mount_args(self.#mounts)
      --entrypoint env
      -v $self.#subdir:$self.#ctr_subdir:rw,z$uopt
      -v $self.#bin:$self.#ctr_agent:ro,z$uopt
      $img
      $self.#ctr_agent ...(_vfs.vfs_args self.#cd self.#env) --key-stdin --accept $self.#ctr_socket
      stdin: (_vfs.key_input key)
      stderr: $lines.prechomp()
    # Recorded before the wait so a launch that never reports in still leaves
    # `cleanup` a container to remove.
    self.#ctr_name = name
    self.#handle = handle
    try
      # The agent writes a line once the socket is bound and connectable, which
      # beats polling for the path's existence. Any line will do: it is a
      # signal, not a message, and anything gone wrong reports itself on stderr
      # and as a nonzero exit instead. A failed `run` surfaces here: the output
      # channel re-raises the strand's error once it is exhausted, so
      # `default:` only covers a clean exit that said nothing.
      let line = handle.iter().next default: nil
      if (line == nil)
        handle.join()
        throw RuntimeError "container agent exited before reporting ready"
    catch proc.Error: e
      classify_image_error $img $lines
      report_unknown $lines
      throw e
    self.#agent = Vfs.unix_socket $self.#socket :key

  def cleanup self
    # Ending the session makes the agent exit, which exits the container, which
    # `--rm` then removes. If no session was ever established nothing will tell
    # the agent to exit, so force removal is the only way out.
    let agent = self.#agent
    let ctr_name = self.#ctr_name
    if (agent != nil)
      time.timeout 30 do agent.stop()
      self.#agent = nil
    else if (ctr_name != nil)
      try
        self.#runtime.quiet_cli rm -f $ctr_name
      catch proc.Error: _
        nil
    let handle = self.#handle
    if (handle != nil)
      self.#handle = nil
      # This runs from `build`'s `finally`; a nonzero exit (which a forced
      # removal produces) must not displace the error being unwound.
      try
        handle.join()
      catch proc.Error: _
        nil
    self.#ctr_name = nil

  def resolve_target self target@(Str | Path) leaf@Str -> Path
    let path = Path $target
    self.#live_agent().with do
      if (path.exists() && path.metadata().type == :DIR:)
        (path / leaf)
      else
        path

  def copy_to_target
    self
    target @ Path
    chmod @ (Int | Mode | nil)
    copy_data @ (BinFile -> nil)
  do
    let mode = _vfs.parse_mode $chmod
    self.#live_agent().with do
      let dir = target.parent
      if (dir != nil)
        dir.create_dir all: true
      target.open wb do |dest| copy_data $dest
      if (mode != nil)
        target.update_metadata mode: $mode

  def add_file self path@Path target@Path chmod@(Int | Mode | nil)
    path.open rb do |src|
      self.#copy_to_target $target $chmod do |dest|
        while true
          let chunk = src.read $COPY_BLOCK_SIZE
          if (chunk.len == 0)
            break
          let _ = dest.write $chunk

  def add_content self content@(Str | Bin) target@Path chmod@(Int | Mode | nil)
    self.#copy_to_target $target $chmod do |dest|
      let _ = dest.write $content

  def step_add self spec @ AddSpec
    bind spec
      :target
      :source = nil
      :content = nil
      :chmod = nil
    if (source != nil && content != nil)
      throw "add: expected exactly one of source or content"
    if (content != nil)
      self.#add_content $content (Path target) $chmod
    else if (source != nil)
      match parse_source(source)
        Url(url) do
          let path = self.#resolve_target $target (url_leaf url)
          self.#add_file (cache.path url) $path $chmod
        Path(source) do
          let path = self.#resolve_target $target (path_leaf source)
          self.#add_file $source $path $chmod
    else
      throw "add: expected exactly one of source or content"

  def step_patch self spec @ PatchSpec
    bind spec
      :source = nil
      :content = nil
    if (source != nil && content != nil)
      throw "patch: expected exactly one of source or content"
    let patch_data = if (content != nil)
      content
    else if (source != nil)
      (Path source).read b
    else
      throw "patch: expected exactly one of source or content"

    let _ = progress.steps message: patch
      for p = patch.decode $patch_data
        - name: (patch_name p)
          do self.#apply_patch $p

  def apply_patch self p @ patch.Patch
    let kind = p.type
    if (kind == :CREATE:)
      self.#add_content $p.apply(b"") $p.target nil
    else if (kind == :DELETE:)
      let source = p.source
      self.#live_agent().with do
        let result = p.apply (source.read "b")
        if (result.len != 0)
          throw "delete patch did not produce empty output: $source"
        source.remove()
    else
      self.#live_agent().with do
        let result = p.apply (p.source.read "b")
        self.#add_content $result $p.target nil
        if (kind == :MOVE: && p.source != p.target)
          p.source.remove()

  def step_commit self msg @ Str
    progress.show message: commit do |_|
      let img_id = sub do self.#runtime.cli commit
        if msg
          --message $msg
        $self.#live_ctr_name()
      self.#cleanup()
      self.#connect $img_id

  def step[I, O] self entry @ Entries[BuildSteps[I, O]] <I >O
    match entry
      (:run: func) do self.#live_agent().with $func
      (:add: spec) do self.#step_add $spec
      (:patch: spec) do self.#step_patch $spec
      (:commit: msg) do self.#step_commit $msg
      (:tag: _) do nil

  def finish_image self tags @ Array[Str] -> Image
    let runtime = self.#runtime
    let ctr_name = self.#live_ctr_name()
    let img_id = progress.show message: commit do |_|
      sub do runtime.cli commit $ctr_name
    progress.show message: tag do |_|
      for tag = tags
        runtime.quiet_cli tag $img_id $tag
    runtime.image $img_id

  pub def build[I, O]
    self
    from @ Str
    :pull @ PullPolicy = :MISSING:
    **steps @ BuildSteps[I, O]
    <I
    >O
  do -> Image
    let tags @ Array[Str] = []
    let adds @ Array[AddSpec] = []
    for entry = steps
      match entry
        (:tag: tag) do tags.push $tag
        (:add: spec) do adds.push $spec
    let message = if tags.len
      tags[0]
    else
      from

    try
      progress.steps :message icon: 🔨
        do prefetch_add_urls $adds
        do progress.show message: "pulling image" do |_|
          ensure_image $self.#runtime $from $pull
        do progress.show message: "starting container" do |_|
          self.#connect $from
        for entry = steps
          do self.#step $entry
      self.#finish_image $tags
    finally
      progress.show message: "stopping container" icon: 🧹 do |_|
        self.#cleanup()

# A container image.
#[final]
pub class Image
  # Full image ID, `sha256:...`.
  pub field id @ Str = nil
  # Creation timestamp, as the runtime reports it.
  pub field created @ Str = nil
  # Image size in bytes.
  pub field size @ Int = nil
  # Layer digests.
  pub field layers @ Array[Str] = nil
  # CPU architecture, such as `"amd64"`.
  pub field architecture @ Str = nil
  # Operating system, such as `"linux"`.
  pub field os @ Str = nil
  # Default command, or `nil` when unset.
  pub field cmd @ (Array[Str] | nil) = nil
  # Entrypoint, or `nil` when unset.
  pub field entrypoint @ (Array[Str] | nil) = nil
  # Environment variables.
  pub field env @ Dict[Str, Str] = nil
  # Working directory, or `nil` when unset.
  pub field working_dir @ (Path | nil) = nil
  # Default user, or `nil` when unset.
  pub field user @ (Str | nil) = nil
  # Labels, or `nil` when the image has none.
  pub field labels @ (Dict[Str, Str] | nil) = nil

  field runtime @ Runtime

  def (init) self runtime@Runtime data@Dict[Str, DecodeValue]
    self.#runtime = runtime

    bind data
      "Id": Str(id)
      "Created": Str(created)
      "Size": Int(size)
      "Architecture": Str(arch)
      "Os": Str(os)
      "Config": Dict(config)
      "RootFS": Dict(root_fs)
      ...
    else malformed image

    # Podman's inspect reports a bare hex digest; Docker's is always
    # `sha256:`-prefixed. Normalized here so `id` has one consistent format
    # regardless of backend.
    self.id = if (id.starts_with "sha256:")
      id
    else
      "sha256:$id"

    self.created = created
    self.size = size
    self.architecture = arch
    self.os = os
    bind root_fs
      "Layers": layers = []
      ...
    self.layers = strings Layers $layers

    bind config
      "Labels": labels = {}
      "Cmd": cmd = nil
      "Entrypoint": entrypoint = nil
      "Env": env = []
      "WorkingDir": working_dir = nil
      "User": user = nil
      ...

    self.labels = string_dict Labels $labels
    self.cmd = normalize_argv Cmd $cmd
    self.entrypoint = normalize_argv Entrypoint $entrypoint
    let working_dir = optional_str WorkingDir $working_dir
    self.working_dir = (working_dir != nil && Path(working_dir) || nil)
    self.user = optional_str User $user
    let vars @ Dict[Str, Str] = {}
    for var = strings Env $env
      let key value = var.split "=" limit: 1
      else malformed "Env $var"
      vars[key] = value
    self.env = vars

  pub def (str) self -> Str
    self.id

  # Returns the current tags, which are empty for an untagged image.
  pub def tags self -> Array[ImageTag]
    bind inspect_image(self.#runtime, self.id)
      "RepoTags": tags = []
      ...
    parse_image_tags $self.#runtime $strings("RepoTags", tags)

  # Tags the image with a new name.
  #
  # ```
  # img.tag "registry.example.com/myapp:v1.2"
  # ```
  pub def tag
    self
    # Reference to tag the image as.
    new_tag @ Str
  do
    self.#runtime.quiet_cli tag $self.id $new_tag

  # Removes the image.
  #
  # ```
  # img.remove()
  # img.remove force: true
  # ```
  pub def remove
    self
    # Remove the image even if containers use it, removing them too.
    :force @ Bool = false
  do
    if force
      # `rmi --force` removes containers using the image as part of the same
      # operation, but one can be self-removing at the same time (e.g. a
      # build container run with `--rm`), and podman treats that race as a
      # hard failure instead of the no-op it actually is. Removing them
      # ourselves first leaves nothing for `rmi` to race against; a
      # container that vanishes underneath this loop is exactly that race,
      # not a real failure.
      for ctr = self.#runtime.containers all: true filter: "ancestor=$(self.id)"
        try
          ctr.remove force: true
        catch NoContainerError: _
          nil
    self.#runtime.quiet_cli rmi
      if force
        --force
      $self.id

  # Saves the image to an archive or directory, returning `target`.
  pub def save
    self
    # Archive path or directory to write.
    target @ (Str | Path)
    # Archive format.
    :format @ ArchiveFormat = :DOCKER_ARCHIVE:
    # Platform to save.
    :platform @ Platform = nil
  do -> (Str | Path)
    self.#runtime.save $target :format $self.id
      if (platform != nil)
        platform: $platform

# A running or stopped container.
pub class Container
  # Full container ID.
  pub field id @ Str = nil
  # Image reference the container was created from.
  pub field image @ (Str | nil) = nil
  # ID of the image the container was created from.
  pub field image_id @ (Str | nil) = nil
  # Creation timestamp, as the runtime reports it.
  pub field created @ (Str | nil) = nil
  # Command, or `nil` when unset.
  pub field cmd @ (Array[Str] | nil) = nil
  # Entrypoint, or `nil` when unset.
  pub field entrypoint @ (Array[Str] | nil) = nil
  # Labels, or `nil` when the container has none.
  pub field labels @ (Dict[Str, Str] | nil) = nil

  field runtime @ Runtime

  def (init) self runtime@Runtime data@Dict[Str, DecodeValue]
    self.#runtime = runtime

    bind data
      "Id": Str(id)
      "Created": created = nil
      "Image": image_id = nil
      "Config": config = {}
      ...
    else malformed container
    let Dict(config) = config
    else malformed Config

    bind config
      "Image": image = nil
      "Cmd": cmd = nil
      "Entrypoint": entrypoint = nil
      "Labels": labels = {}
      ...

    self.id = id
    self.image = optional_str Image $image
    self.image_id = optional_str Image $image_id
    self.created = optional_str Created $created
    self.cmd = normalize_argv Cmd $cmd
    self.entrypoint = normalize_argv Entrypoint $entrypoint
    self.labels = string_dict Labels $labels

  pub def (str) self -> Str
    self.id

  # Runs `func` in this running container through a VFS context.
  #
  # A matching `dolang-vfs` helper is copied to a session-specific path under
  # `/tmp` and launched with the container runtime's `exec` command. The helper
  # is removed after the VFS connection starts when the container user has
  # permission to do so.
  pub def with[R]
    self
    # Function to run.
    func @ (() -> R)
    # Initial working directory.
    :cd @ (Str | Path) = nil
    # Environment overrides. `nil` unsets a variable.
    :env @ Env = {}
  do -> R
    let runtime = self.#runtime
    let id = self.id
    with_temp_dir parent: $runtime_dir() do |subdir|
      let ctr_agent = Path "/tmp/dolang-vfs-$(subdir.name)"
      runtime.quiet_cli cp $(_vfs.bin()) "$id:$ctr_agent"

      let vfs = Vfs do runtime.cli exec -i $id $ctr_agent
        ...(_vfs.vfs_args cd env) --stdio
        stdin: $strand.input()
      try
        return vfs.with do
          try
            ctr_agent.remove()
          catch sys.Error: _
            nil
          func()
      finally
        time.timeout 30 do vfs.stop()

  # Returns the container's live state.
  pub def state self -> ContainerState
    let data = inspect_container $self.#runtime $self.id
    bind data
      "Name": name = nil
      "State": state = {}
      "Mounts": mounts = []
      "NetworkSettings": network = {}
      ...
    let Dict(state) = state
    else malformed State
    let Dict(network) = network
    else malformed NetworkSettings
    bind network
      "Ports": ports = {}
      ...
    let status = optional_str Status $state.get("Status", default: nil)
    let name = optional_str Name $name
    let live_name = if (name == nil)
      nil
    else if (name.starts_with "/")
      name.without_prefix "/"
    else
      name
    let live_state = (status != nil && normalize_known(CONTAINER_STATES, status) || nil)
    ContainerState
      name: $live_name
      state: $live_state
      :status
      ports: $parse_container_ports(ports)
      mounts: $parse_container_mounts(mounts)

  # Stops the container.
  pub def stop
    self
    # Seconds to wait before killing the container. Defaults to the runtime's.
    :timeout @ Int = nil
  do
    self.#runtime.quiet_cli stop
      if (timeout != nil)
        --time $timeout
      $self.id

  # Starts the container.
  pub def start self
    self.#runtime.quiet_cli start $self.id

  # Waits for the container to stop.
  #
  # ## Errors
  #
  # [`ContainerExitError`](_container.dockman.ContainerExitError) for a nonzero
  # exit status.
  pub def wait self
    let lines @ Array[Str] = []
    let output = try
      sub do self.#runtime.cli wait $self.id stderr: $lines.prechomp()
    catch proc.Error: e
      classify_container_error $self.id $lines
      report_unknown $lines
      throw e
    let rc = int $output.trim()
    if (rc != 0)
      throw ContainerExitError $rc

  # Kills the container.
  pub def kill self
    self.#runtime.quiet_cli kill $self.id

  # Restarts the container.
  pub def restart
    self
    # Seconds to wait before killing the container. Defaults to the runtime's.
    :timeout @ Int = nil
  do
    self.#runtime.quiet_cli restart
      if (timeout != nil)
        --time $timeout
      $self.id

  # Removes the container.
  pub def remove
    self
    # Remove the container even if it is running.
    :force @ Bool = false
    # Also remove its anonymous volumes.
    :volumes @ Bool = false
  do
    let lines @ Array[Str] = []
    try
      let _ = sub do self.#runtime.cli rm
        if force
          --force
        if volumes
          --volumes
        $self.id
        stderr: $lines.prechomp()
    catch proc.Error: e
      classify_container_error $self.id $lines
      report_unknown $lines
      throw e
