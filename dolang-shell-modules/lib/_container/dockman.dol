import progress json patch rand shlex strand proc sys transfer _vfs time
  std:
    - RuntimeError
    - TypeError
    - ValueError
  strand:
    - pipeline
    - stream
    - each
  fs:
    - Path
    - with_temp_dir
  url:
    - Url
  shell:
    - Vfs
  _container.common:
    - runtime_dir
    - cache_dir

let COPY_BLOCK_SIZE = 1048576

let SAVE_FORMATS = $
  DOCKER_ARCHIVE: docker-archive
  OCI_ARCHIVE: oci-archive
  OCI_DIR: oci-dir
  DOCKER_DIR: docker-dir
  DIR: dir

let CONTAINER_STATES = $
  "created": :CREATED:
  # Podman's own name for the state a container is in between `create` and
  # `start`, which is what Docker calls `created`. Podman 3.x reports it
  # verbatim in inspect output; 4.x onward reports `created` there instead.
  "configured": :CREATED:
  "running": :RUNNING:
  "paused": :PAUSED:
  "restarting": :RESTARTING:
  "removing": :REMOVING:
  "exited": :EXITED:
  "dead": :DEAD:

let MOUNT_TYPES = $
  "bind": :BIND:
  "volume": :VOLUME:
  "tmpfs": :TMPFS:
  "image": :IMAGE:
  "npipe": :NPIPE:
  "cluster": :CLUSTER:

let PORT_PROTOCOLS = $
  "tcp": :TCP:
  "udp": :UDP:
  "sctp": :SCTP:

let CONTAINER_MOUNT_TYPES = Set $
  - :BIND:
  - :VOLUME:
  - :TMPFS:

let BUILD_MOUNT_TYPES = $
  CACHE: cache
  BIND: bind
  VOLUME: volume
  TMPFS: tmpfs

let CONTAINER_PORT_PROTOCOLS = $
  TCP: tcp
  UDP: udp
  SCTP: sctp

let RESTART_POLICIES = $
  NO: no
  ON_FAILURE: on-failure
  ALWAYS: always
  UNLESS_STOPPED: unless-stopped

let PULL_POLICIES = $
  MISSING: missing
  ALWAYS: always
  NEVER: never

let INVALID_IMAGE_REFERENCE_ERRORS = $
  - INVALID REFERENCE FORMAT

let REGISTRY_AUTH_ERRORS = $
  - UNAUTHORIZED
  - AUTHENTICATION REQUIRED
  - REQUESTED ACCESS TO THE RESOURCE IS DENIED
  - DENIED

let NO_IMAGE_ERRORS = $
  - NO SUCH IMAGE
  - IMAGE NOT KNOWN
  - DOES NOT EXIST LOCALLY
  - MANIFEST UNKNOWN
  - FAILED TO RESOLVE REFERENCE

let ARCHIVE_ERRORS = $
  - ARCHIVE
  - TAR
  - PAYLOAD
  - NO SUCH FILE
  - CANNOT OPEN

let PUSH_NO_IMAGE_ERRORS = $
  - TAG DOES NOT EXIST
  - DOES NOT EXIST LOCALLY
  - IMAGE NOT KNOWN
  - NO SUCH IMAGE

let NO_CONTAINER_ERRORS = $
  - NO SUCH CONTAINER
  - NO CONTAINER WITH NAME OR ID
  - CONTAINER NOT KNOWN
  - NO CONTAINER FOUND

pub class InvalidImageReferenceError: RuntimeError
  pub field ref = nil

  def (init) self ref
    RuntimeError.(init) $self "invalid image reference: $ref"
    self.ref = ref

pub class RegistryAuthError: RuntimeError
  pub field ref = nil

  def (init) self ref
    RuntimeError.(init) $self "registry authentication failed: $ref"
    self.ref = ref

pub class ArchiveError: RuntimeError
  pub field source = nil

  def (init) self source
    RuntimeError.(init) $self "archive operation failed: $source"
    self.source = source

# Raised when an image reference cannot be found.
#
# ```
# import docker
#
# try
#   docker.image "nonexistent:latest"
# catch docker.NoImageError: e
#   echo "not found: $e.ref"
# ```
pub class NoImageError: RuntimeError
  # The image reference that was not found
  pub field ref = nil

  def (init) self ref
    RuntimeError.(init) $self "image not found: $ref"
    self.ref = ref

  pub def (dbg) self
    "<NoImageError ref: $(dbg self.ref)>"

pub class NoContainerError: RuntimeError
  pub field ref = nil

  def (init) self ref
    RuntimeError.(init) $self "container not found: $ref"
    self.ref = ref

  pub def (dbg) self
    "<NoContainerError ref: $(dbg self.ref)>"

# Raised by `Container.wait` when the container exits unsuccessfully.
pub class ContainerExitError: RuntimeError
  # Numeric container exit status.
  pub field rc = nil

  def (init) self rc
    RuntimeError.(init) $self "container exited with status: $rc"
    self.rc = rc

  pub def (dbg) self
    "<ContainerExitError rc: $(self.rc)>"

# Podman's short-name resolution (containers-registries.conf(5)) prompts
# interactively -- or, with no TTY attached, just fails -- when a reference
# has no registry component and more than one (or zero) unqualified search
# registries are configured. Docker has no equivalent step: it always
# defaults bare names to Docker Hub. Fully qualifying the reference up front
# sidesteps short-name resolution entirely, so callers don't need a
# registries.conf tuned for non-interactive use.
def qualify_ref ref
  if !(ref.contains "/")
    "docker.io/library/$ref"
  else
    let host _ = ref.split "/" limit: 1
    if (host.contains "." || host.contains ":" || host == "localhost")
      ref
    else
      "docker.io/$ref"

# Applies a pull policy ("always" / "missing" / "never") up front, as a step
# separate from starting a container. Docker/Podman's own inline
# `run --pull=...` prints pull progress and "unable to find image locally"
# straight to the real stderr with no way to capture or quiet it; pulling
# explicitly reuses `Runtime.pull`, which redirects output and classifies
# failures (`NoImageError`, `RegistryAuthError`, etc.) via known error
# patterns.
def ensure_image runtime img policy
  policy = PULL_POLICIES.get $policy else: do
    throw ValueError "unsupported pull policy: $policy"
  if (policy == "always")
    runtime.pull $img
  else if (policy == "missing")
    let present = try
      inspect_image $runtime $img
      true
    catch NoImageError: _
      false
    if !present
      runtime.pull $img

def normalize_known mapping value
  mapping.get $value default: $value

# `Cmd` and `Entrypoint` in inspect output are an argument array, except in
# podman 3.x, which reports `Entrypoint` as a single string. Split it back
# apart so the field has the same shape on every backend.
#
# Podman built the string with a plain space join, which does not quote, so
# an argument containing whitespace cannot be recovered faithfully by any
# splitting rule. `shlex` at least handles the case where such an argument
# was quoted before it reached the runtime.
def normalize_argv value
  if !(type value Str)
    return value
  [...shlex.split value]

def container_env_args env
  if !(type env Dict)
    throw TypeError "env: expected Dict"
  let args = []
  for key value = env
    if !(type key Str || type key Sym)
      throw TypeError "env key: expected Str or Sym"
    if (value == nil)
      throw ValueError "env: nil values are not supported by create"
    if (value == :INHERIT:)
      args.push --env $key
    else
      args.push --env "$key=$value"
  args

def container_label_args labels
  if !(type labels Dict)
    throw TypeError "labels: expected Dict"
  let args = []
  for key value = labels
    args.push --label "$key=$value"
  args

def container_port_args ports
  let args = []
  for port = ports
    bind port
      :container_port
      :host_port = nil
      :host_ip = nil
      :protocol = :TCP:
    let protocol = CONTAINER_PORT_PROTOCOLS.get $protocol else: do
      throw ValueError "unsupported port protocol: $protocol"
    let spec = "$container_port/$protocol"
    if (host_port != nil)
      spec = "$host_port:$spec"
    if (host_ip != nil)
      if (host_port == nil)
        spec = "$host_ip::$spec"
      else
        spec = "$host_ip:$spec"
    args.push --publish $spec
  args

def container_network_args networks
  let args = []
  for network = networks
    args.push --network $network
  args

def container_restart_args restart
  if (restart == nil)
    return []
  bind restart
    :policy
    :max_retries = nil
  let policy = RESTART_POLICIES.get $policy else: do
    throw ValueError "unsupported restart policy: $policy"
  if (max_retries != nil)
    if (policy != "on-failure")
      throw ValueError "restart max_retries requires on-failure policy"
    policy = "$policy:$max_retries"
  ["--restart", policy]

def container_create_args
  :name
  :env
  :mounts
  :labels
  :ports
  :networks
  :user
  :cd
  :entrypoint
  :restart
do
  return $
    if (name != nil)
      --name $name
    ...(container_env_args env)
    ...(container_mount_args mounts)
    ...(container_label_args labels)
    ...(container_port_args ports)
    ...(container_network_args networks)
    if (user != nil)
      --user $user
    if (cd != nil)
      --workdir $cd
    if (entrypoint != nil)
      --entrypoint $entrypoint
    ...(container_restart_args restart)

def container_run_args
  :name
  :mounts
  :labels
  :ports
  :networks
  :user
do
  return $
    if (name != nil)
      --name $name
    ...(container_mount_args mounts)
    ...(container_label_args labels)
    ...(container_port_args ports)
    ...(container_network_args networks)
    if (user != nil)
      --user $user

def normalize_save_format runtime format
  let cli = SAVE_FORMATS.get $format else: do
    throw "unsupported save format: $format"
  if (runtime.id == :DOCKER: && cli != "docker-archive")
    throw "docker only supports docker_archive for save"
  let file = (cli == "docker-archive" || cli == "oci-archive")
  let multi = (cli == "docker-archive")
  record :cli :file :multi

def normalize_platform platform
  if (platform == nil)
    return nil
  if (type platform Str)
    return platform
  let os = platform.get :os: default: nil
  let arch = platform.get :arch: default: nil
  let variant = platform.get :variant: default: nil
  if !(os && arch)
    throw "platform requires os and arch"
  let platform = "$os/$arch"
  if variant
    platform = "$platform/$variant"
  platform

def output_lines output stderr
  let lines = []
  if output
    for line = output.split "\n"
      line = line.trim()
      if line
        lines.push $line
  for line = stderr
    line = line.trim()
    if line
      lines.push $line
  lines

# Merges captured stdout and stderr line arrays, trimming and dropping blanks.
def merged_lines out err
  let lines = []
  for stream = [out, err]
    for line = stream
      line = line.trim()
      if line
        lines.push $line
  lines

def matches_any haystack needles
  needles.any do |needle| haystack.contains $needle

def classify_image_error ref lines
  for line = lines
    let upper = line.upper()
    if (matches_any upper INVALID_IMAGE_REFERENCE_ERRORS)
      throw InvalidImageReferenceError $ref
    if (matches_any upper REGISTRY_AUTH_ERRORS)
      throw RegistryAuthError $ref
    if (matches_any upper NO_IMAGE_ERRORS)
      throw NoImageError $ref

def classify_archive_error source lines
  for line = lines
    let upper = line.upper()
    if (matches_any upper INVALID_IMAGE_REFERENCE_ERRORS)
      throw InvalidImageReferenceError $source
    if (matches_any upper ARCHIVE_ERRORS)
      throw ArchiveError $source

def classify_push_error ref lines
  for line = lines
    let upper = line.upper()
    if (matches_any upper INVALID_IMAGE_REFERENCE_ERRORS)
      throw InvalidImageReferenceError $ref
    if (matches_any upper REGISTRY_AUTH_ERRORS)
      throw RegistryAuthError $ref
    if (matches_any upper PUSH_NO_IMAGE_ERRORS)
      throw NoImageError $ref

def classify_container_error ref lines
  for line = lines
    let upper = line.upper()
    if (matches_any upper NO_CONTAINER_ERRORS)
      throw NoContainerError $ref

# Last resort for a CLI failure none of the `classify_*` tables recognized.
#
# Their captured output is redirected away from the real stderr so routine
# chatter (pull progress and the like) stays out of the log, which means an
# unrecognized failure would otherwise be rethrown as a bare `proc.Error`
# reporting only the exit status, with everything the CLI actually said
# discarded. Dump it before rethrowing, the same fallback `transfer` uses for
# unrecognized unpacking errors.
def report_unknown lines
  if lines.len
    echo $"\n".join(lines)

def parse_container_ports ports
  let mapped = []
  for key bindings = ports
    let port proto = key.split "/" limit: 1
    let protocol = normalize_known $PORT_PROTOCOLS $proto
    let container_port = int $port
    if (bindings == nil)
      mapped.push $ record
        :protocol
        :container_port
        host_ip: nil
        host_port: nil
    else
      for binding = bindings
        bind binding
          "HostIp": host_ip = nil
          "HostPort": host_port = nil
          ...
        mapped.push $ record
          :protocol
          :container_port
          :host_ip
          host_port: (host_port != nil && int host_port)
  mapped

def parse_container_mounts mounts
  let mapped = []
  for mount = mounts
    bind mount
      "Type": type = nil
      "Source": source = nil
      "Destination": target = nil
      "Mode": mode = nil
      "RW": rw = true
      "Propagation": propagation = nil
      "Name": name = nil
      ...
    mapped.push $ record
      type: (type && normalize_known(MOUNT_TYPES, type))
      source: (source && Path source)
      target: (target && Path target)
      readonly: (!rw)
      :mode
      :propagation
      :name
  mapped

# Podman qualifies a locally built/tagged reference with a synthetic
# `localhost/` registry that Docker never adds for the equivalent
# unqualified name, so it is stripped for Podman to keep `repo` consistent
# across backends.
def parse_image_tags runtime repo_tags
  let strip_localhost = (runtime.id == :PODMAN:)
  Array $ repo_tags.map do |tag|
    let repo tag = tag.split ":" limit: 1
    if (strip_localhost && repo.starts_with "localhost/")
      repo = repo.without_prefix "localhost/"
    record :repo :tag

def inspect_image runtime ref
  let lines = []
  let output = try
    sub do runtime.cli inspect --type image $ref stderr: $lines.prechomp()
  catch proc.Error: e
    classify_image_error $ref $lines
    report_unknown $lines
    throw e
  (json.decode output)[0]

def inspect_container runtime ref
  let lines = []
  let output = try
    sub do runtime.cli inspect --type container $ref stderr: $lines.prechomp()
  catch proc.Error: e
    classify_container_error $ref $lines
    report_unknown $lines
    throw e
  (json.decode output)[0]

# Recognized prefixes, in the forms `load` reports them:
#
# - `Loaded image: ref` and `Loaded image ID: sha256:...`, one line per
#   image, from Docker and podman 4.x onward
# - `Loaded image(s): ref,ref`, a single line listing every image, from
#   podman 3.x
def parse_loaded_refs output stderr
  let refs = []
  for line = output_lines $output $stderr
    if (line.starts_with "Loaded image(s):")
      let _ rest = line.split ":" limit: 1
      for ref = rest.split ","
        refs.push $ref.trim()
    else if (
      line.starts_with "Loaded image ID:" ||
      line.starts_with "Loaded image:"
    )
      let _ ref = line.split ":" limit: 1
      refs.push $ref.trim()
  refs

def parse_pushed_digest output stderr
  for line = output_lines $output $stderr
    let upper = line.upper()
    if (upper.contains "DIGEST:")
      let rest = if (line.contains "digest:")
        let _ rest = line.split "digest:" limit: 1
        rest
      else
        let _ rest = line.split "Digest:" limit: 1
        rest
      let digest _ = rest.trim().split " " limit: 1
      return digest
  nil

pub class Runtime
  pub field id = nil

  def (init) self id
    self.id = id

  pub def cli self ...args
    let _ = [self, args]
    throw "Runtime.cli not implemented"

  # Run CLI with output captured, printing it only on failure
  pub def quiet_cli self ...args
    let output = StrBuf()
    try
      self.cli ...args stdout: $output stderr: $output
    catch proc.Error: e
      if output.len
        print $output.freeze()
      throw e

  pub def mount_uopt self
    if (self.id == :PODMAN:)
      ",U"
    else
      ""

  pub def with self ctr thunk :cd = nil :env = {} :pull = :MISSING:
    ensure_image $self $ctr $pull
    let ctr_subdir = Path /tmp/dolang-vfs-dir
    let ctr_socket = (ctr_subdir / "socket")
    let ctr_agent = Path "/tmp/dolang-vfs"
    let agent_bin = _vfs.bin()
    let uopt = self.mount_uopt()

    with_temp_dir parent: $runtime_dir() do |subdir|
      subdir.update_metadata mode: 0o700
      let socket = (subdir / "socket")
      let input = strand.input()
      # The socket's mode cannot identify the client: the container maps uids
      # however it likes, so it is bound 0666 and anything that can traverse the
      # directory -- every process in the container, and root -- can connect.
      # The key is what distinguishes the real client: `--accept` serves one
      # peer that proves it, and unlinks the socket once it has.
      let key = _vfs.key()
      # The pipeline's first stage is only the agent bootstrap process, not
      # user command output, so capturing its stderr for classification
      # (rather than the pull chatter leaking to the real terminal) is safe.
      let lines = []
      try
        pipeline
          do self.cli run --rm -i --pull=never
            --entrypoint $ctr_agent
            -v $subdir:$ctr_subdir:rw,z$uopt
            -v $agent_bin:$ctr_agent:ro,z$uopt
            $ctr ...(_vfs.vfs_args cd env) --key-stdin --accept $ctr_socket
            stdin: (_vfs.key_input key)
            stderr: $lines.prechomp()
          do
            strand.next()
            let agent = Vfs.unix_socket $socket :key
            try
              return strand.redirect input: $input do agent.with $thunk
            finally
              time.timeout 30 do agent.stop()
      catch proc.Error: e
        classify_image_error $ctr $lines
        report_unknown $lines
        throw e

  def run_direct
    self ctr cmd
    :cd
    :env
    :argv
    :pull
    :name
    :mounts
    :labels
    :ports
    :networks
    :user
    :entrypoint
  do
    ensure_image $self $ctr $pull
    let executable = (entrypoint || cmd)
    let executable_args = if entrypoint
      [cmd, ...argv]
    else
      argv
    let config_args = container_run_args
      :name :mounts :labels :ports :networks :user
    self.cli run --rm -i --pull=never
      ...config_args
      --entrypoint env $ctr ...(_vfs.env_args cd env)
      $executable ...executable_args

  pub def run
    self ctr cmd
    :cd = nil
    :env = {}
    :pull = :MISSING:
    :name = nil
    :mounts = []
    :labels = {}
    :ports = []
    :networks = []
    :user = nil
    :entrypoint = nil
    ...args
  do
    self.#run_direct $ctr $cmd
      :cd :env :pull :name :mounts :labels :ports :networks :user :entrypoint
      argv: $args.pos_only()

  pub def create
    self image cmd = nil
    :name = nil
    :env = {}
    :mounts = []
    :labels = {}
    :ports = []
    :networks = []
    :user = nil
    :cd = nil
    :entrypoint = nil
    :restart = nil
    :pull = :MISSING:
    ...args
  do
    ensure_image $self $image $pull
    let config_args = container_create_args
      :name :env :mounts :labels :ports :networks :user :cd :entrypoint :restart
    let lines = []
    let output = try
      sub do self.cli create --pull=never
        ...config_args
        $image
        if (cmd != nil)
          $cmd ...args.pos_only()
        stderr: $lines.prechomp()
    catch proc.Error: e
      classify_image_error $image $lines
      report_unknown $lines
      throw e
    self.container $output.trim()

  pub def build self :pull = :MISSING: :mounts = [] :cd = nil :env = {} :from ...args
    with_temp_dir parent: $runtime_dir() do |subdir|
      subdir.update_metadata mode: 0o700
      let b = Builder $self $subdir $_vfs.bin() $mounts $cd $env
      b.build $from :pull ...args

  pub def images self :all = false :filter = nil
    stream do pipeline
      do self.cli images --no-trunc -q
        if (filter != nil)
          --filter $filter
        if all
          --all
      do each do |id|
        id = id.trim()
        let data = json.decode $ sub do self.cli inspect --type image $id
        Image $self $data[0]

  pub def containers self :all = false :filter = nil
    stream do pipeline
      do self.cli ps --no-trunc -q
        if all
          --all
        if (filter != nil)
          --filter $filter
      do each do |id|
        id = id.trim()
        let data = inspect_container $self $id
        Container $self $data

  pub def image self ref
    let data = inspect_image $self $ref
    Image $self $data

  pub def container self ref
    let data = inspect_container $self $ref
    Container $self $data

  pub def save self target :format = :DOCKER_ARCHIVE: :platform = nil ...images
    if (images.len == 0)
      throw "save: expected at least one image"
    let spec = normalize_save_format $self $format
    if (!spec.multi && images.len > 1)
      throw "save format does not support multiple images: $format"
    let path_target = if spec.file
      nil
    else
      Path $target
    let platform = normalize_platform $platform
    let refs = [...images.pos_only()]
    let lines = []
    try
      self.cli save
        if (self.id == :PODMAN:)
          --format $spec.cli
        if !spec.file
          --output $path_target
        if (platform != nil)
          --platform $platform
        ...refs
        if spec.file
          stdout: $target
        stderr: $lines.prechomp()
    catch proc.Error: e
      classify_image_error $refs[0] $lines
      classify_archive_error $(spec.file && target || path_target) $lines
      report_unknown $lines
      throw e
    target

  pub def load self source :platform = nil
    let source = Path $source
    let platform = normalize_platform $platform
    let lines = []
    let output = try
      sub do self.cli load
        --input $source
        if (platform != nil)
          --platform $platform
        stderr: $lines.prechomp()
    catch proc.Error: e
      classify_archive_error $source $lines
      report_unknown $lines
      throw e
    let refs = parse_loaded_refs $output $lines
    if (refs.len == 0)
      throw ArchiveError $source
    let loaded = []
    let seen = Set()
    for ref = refs
      let img = self.image $ref
      if !(seen.contains img.id)
        seen.add $img.id
        loaded.push $img
    loaded

  pub def pull self ref :platform = nil
    if (self.id == :PODMAN:)
      ref = qualify_ref $ref
    let platform = normalize_platform $platform
    let out = []
    let lines = []
    try
      self.cli pull --quiet
        if (platform != nil)
          --platform $platform
        $ref
        stdout: $out.prechomp()
        stderr: $lines.prechomp()
    catch proc.Error: e
      # Capture both streams rather than `sub`bing stdout: on failure `sub`'s
      # value never materializes, so anything the CLI said there would be lost.
      let all = merged_lines $out $lines
      classify_image_error $ref $all
      report_unknown $all
      throw e
    for line = merged_lines $out $lines
      if (line.starts_with "sha256:")
        return self.image $line
    self.image $ref

  pub def push self ref :platform = nil
    let platform = normalize_platform $platform
    let lines = []
    let output = try
      sub do self.cli push
        if (platform != nil)
          --platform $platform
        $ref
        stderr: $lines.prechomp()
    catch proc.Error: e
      classify_push_error $ref $lines
      report_unknown $lines
      throw e
    let digest = parse_pushed_digest $output $lines
    record :ref :digest

pub def mount_args mounts
  let args = []
  for m = mounts
    bind m
      :type :target
      :id = nil
      :source = nil
      :readonly = nil
      :size = nil
      :chown = nil
      :selinux = nil
    type = BUILD_MOUNT_TYPES.get $type else: do
      throw ValueError "unsupported mount type: $type"
    if (type == "cache")
      # Emulate cache mount with bind mount for Docker
      source = str $ cache_dir (id || target)
      type = "bind"
    if (type == "bind")
      let parts = $
        if readonly
          - ro
        else
          - rw
        if chown
          - U
        if (selinux == "shared")
          - z
        else if (selinux == "private")
          - Z
      args.push -v $source:$target:$(",".join parts)
    else
      let parts = $
        - type=$type
        if target
          - target=$target
        if source
          - source=$source
        if readonly
          - readonly
        else
          - rw
        if size
          - size=$size
        if chown
          - chown=$chown
        if (selinux == "shared")
          - z
        else if (selinux == "private")
          - Z
      args.push --mount=$(",".join parts)
  args

def container_mount_args mounts
  let normalized = []
  for mount = mounts
    bind mount
      :type :target
      :source = nil
      :readonly = false
    if !(CONTAINER_MOUNT_TYPES.contains type)
      throw ValueError "unsupported container mount type: $type"
    if (type == :BIND: && source == nil)
      throw ValueError "bind mount requires source"
    normalized.push $ record :type :target :source :readonly
  mount_args $normalized

def path_leaf path
  let name = path.name
  if !name
    throw "path has no filename: $path"
  name

def url_leaf url
  let name = url.name
  if !name
    throw "source URL has no filename: $url"
  name

def parse_source source
  if (type source Str)
    if (source.starts_with "http://" || source.starts_with "https://")
      Url $source
    else
      Path $source
  else
    source

class Cache
  field paths = {}

  pub def ensure self url
    let payload = (transfer.get(url, app: "dolang-container"))
    self.#paths[str(url)] = payload
    payload

  pub def path self url
    let payload = (self.#paths.get(str(url)))
    if (payload == nil)
      throw "cache entry missing for URL: $url"
    payload

let cache = Cache()

def prefetch_add_urls spec
  let urls = Set()
  for add = spec.values(:add:).filter(do |add| add.contains :source:)
    let source = parse_source $add[:source:]
    if (type source Url)
      urls.add $source
  strand.pool 4 $urls do |url| cache.ensure $url

def patch_name p
  let kind = p.type
  if (p.type == :CREATE:)
    "create $(p.target)"
  else if (p.type == :DELETE:)
    "delete $(p.source)"
  else
    let source = p.source
    let target = p.target
    if (kind == :MODIFY: || source == target)
      "modify $source"
    else
      "$(str(kind).lower()): $source => $target"

pub class Builder
  field runtime = nil
  field subdir = nil
  field socket = nil
  field ctr_subdir = nil
  field ctr_socket = nil
  field ctr_agent = nil
  field bin = nil
  field mounts = nil
  field cd = nil
  field env = nil
  field agent = nil
  field ctr_name = nil
  field handle = nil

  def (init) self runtime subdir bin mounts cd env
    self.#runtime = runtime
    self.#subdir = subdir
    self.#bin = bin
    self.#mounts = mounts
    self.#cd = cd
    self.#env = env
    self.#socket = (subdir / "socket")
    self.#ctr_subdir = Path /tmp/dolang-vfs-dir
    self.#ctr_socket = (self.#ctr_subdir / "socket")
    self.#ctr_agent = Path "/tmp/dolang-vfs"

  # Runs the container in the foreground under a background strand. The name
  # is generated because a foreground `run` prints no container ID, and the
  # commit steps need something to name the live container by. Callers are
  # responsible for ensuring `img` is present first (see `build`'s dedicated
  # pull step) -- `connect` never pulls.
  def connect self img
    if self.#socket.exists()
      self.#socket.remove()
    let name = "dolang-vfs-$(rand.string 16)"
    # The socket's mode cannot identify the client: the container maps uids
    # however it likes, so it is bound 0666 and anything that can traverse the
    # directory -- every process in the container, and root -- can connect. The
    # key is what distinguishes the real client: `--accept` serves one peer that
    # proves it, and unlinks the socket once it has. A fresh key per container
    # falls out of `step_commit` reconnecting through here.
    let key = _vfs.key()
    let lines = []
    let handle = stream do self.#runtime.cli run -i --rm --name $name --pull=never
      ...mount_args(self.#mounts)
      --entrypoint env
      -v $self.#subdir:$self.#ctr_subdir:rw,z$(self.#runtime.mount_uopt())
      -v $self.#bin:$self.#ctr_agent:ro,z$(self.#runtime.mount_uopt())
      $img
      $self.#ctr_agent ...(_vfs.vfs_args self.#cd self.#env) --key-stdin --accept $self.#ctr_socket
      stdin: (_vfs.key_input key)
      stderr: $lines.prechomp()
    # Recorded before the wait so a launch that never reports in still leaves
    # `cleanup` a container to remove.
    self.#ctr_name = name
    self.#handle = handle
    try
      # The agent writes a line once the socket is bound and connectable, which
      # beats polling for the path's existence. Any line will do: it is a
      # signal, not a message, and anything gone wrong reports itself on stderr
      # and as a nonzero exit instead. A failed `run` surfaces here: the output
      # channel re-raises the strand's error once it is exhausted, so
      # `default:` only covers a clean exit that said nothing.
      let line = handle.iter().next default: nil
      if (line == nil)
        handle.join()
        throw RuntimeError "container agent exited before reporting ready"
    catch proc.Error: e
      classify_image_error $img $lines
      report_unknown $lines
      throw e
    self.#agent = Vfs.unix_socket $self.#socket :key

  def cleanup self
    # Ending the session makes the agent exit, which exits the container, which
    # `--rm` then removes. If no session was ever established nothing will tell
    # the agent to exit, so force removal is the only way out.
    if self.#agent
      time.timeout 30 do self.#agent.stop()
      self.#agent = nil
    else if self.#ctr_name
      try
        self.#runtime.quiet_cli rm -f $self.#ctr_name
      catch proc.Error: _
        nil
    if self.#handle
      let handle = self.#handle
      self.#handle = nil
      # This runs from `build`'s `finally`; a nonzero exit (which a forced
      # removal produces) must not displace the error being unwound.
      try
        handle.join()
      catch proc.Error: _
        nil
    self.#ctr_name = nil

  def step_run self thunk
      self.#agent.with $thunk

  def resolve_target self target leaf
    target = Path $target
    self.#agent.with do
      if (target.exists() && target.metadata().type == :DIR:)
        (target / leaf)
      else
        target

  def copy_to_target self target chmod copy_data
    let mode = _vfs.parse_mode $chmod
    self.#agent.with do
      target.parent.create_dir all: true
      target.open wb do |dest|
        copy_data $dest
      if (mode != nil)
        target.update_metadata mode: $mode

  def add_file self path target chmod
    path.open rb do |src|
      self.#copy_to_target $target $chmod do |dest|
        while true
          let chunk = src.read $COPY_BLOCK_SIZE
          if (chunk.len == 0)
            break
          dest.write $chunk

  def add_url self url target chmod
    self.#add_file (cache.path url) $target $chmod

  def add_content self content target chmod
    self.#copy_to_target $target $chmod do |dest|
      dest.write $content

  def step_add self spec
    bind spec
      :target
      :source = nil
      :content = nil
      :chmod = nil
    if ((source == nil) == (content == nil))
      throw "add: expected exactly one of source or content"
    source = parse_source $source

    if (content != nil)
      self.#add_content $content (Path target) $chmod
    else if (type source Url)
      target = self.#resolve_target $target (url_leaf source)
      self.#add_url $source $target $chmod
    else if (type source Path)
      target = self.#resolve_target $target (path_leaf source)
      self.#add_file $source $target $chmod
    else
      throw "source: expected Str, Path, or Url"

  def step_patch self spec
    bind spec
      :source = nil
      :content = nil
    if ((source == nil) == (content == nil))
      throw "patch: expected exactly one of source or content"

    let patch_data = if (content != nil)
      content
    else
      (Path source).read b

    progress.steps message: patch
      for p = patch.decode $patch_data
        - name: (patch_name p)
          do
            let kind = p.type
            if (kind == :CREATE:)
              let target = p.target
              let result = p.apply b""
              self.#add_content $result $target nil
            else if (kind == :DELETE:)
              let source = p.source
              self.#agent.with do
                let result = p.apply (source.read "b")
                if (result.len != 0)
                  throw "delete patch did not produce empty output: $source"
                p.source.remove()
            else if (kind == :MODIFY: || kind == :MOVE: || kind == :COPY:)
              self.#agent.with do
                let result = p.apply (p.source.read "b")
                self.#add_content $result $p.target nil
                if (kind == :MOVE: && p.source != p.target)
                  p.source.remove()

  def step_commit self msg
    progress.show message: "commit" do |_|
      let img_id = sub do self.#runtime.cli commit
        if msg
          --message $msg
        $self.#ctr_name
      self.#cleanup()
      self.#connect $img_id

  def finish_image self tags
    let img_id = progress.show message: "commit" do |_|
      sub do self.#runtime.cli commit $self.#ctr_name
    progress.show message: tag do |_|
      for tag = tags
        self.#runtime.quiet_cli tag $img_id $tag
    self.#runtime.image $img_id

  pub def build self from :pull = :MISSING: ...args
    let spec = {...args}
    let tags = [...spec.values :tag:]
    spec.delete :tag:
    let steps = $
      run: $self.#step_run
      add: $self.#step_add
      patch: $self.#step_patch
      commit: $self.#step_commit

    let message = if tags.len
      tags[0]
    else
      from

    try
      progress.steps :message icon: 🔨
        do prefetch_add_urls $spec
        do progress.show message: "pulling image" do |_|
          ensure_image $self.#runtime $from $pull
        do progress.show message: "starting container" do |_|
          self.#connect $from
        for key value = spec
          do
            let step = steps.get $key else: do throw "unrecognized step: $key: $value"
            step $value
        do
          return self.#finish_image $tags
    finally
      progress.show message: "stopping container" icon: 🧹 do |_|
        self.#cleanup()

# A container image.
pub class Image
  # Full image ID (`sha256:...`)
  pub field id = nil
  # Creation timestamp
  pub field created = nil
  # Image size in bytes
  pub field size = nil
  # Array of layer digest strings
  pub field layers = nil
  # CPU architecture (e.g. `"amd64"`)
  pub field architecture = nil
  # Operating system (e.g. `"linux"`)
  pub field os = nil
  # Command (`Array` of `Str`)
  pub field cmd = nil
  # Entrypoint (`Array` of `Str`)
  pub field entrypoint = nil
  # Environment (a `Dict`)
  pub field env = nil
  # Working directory (a `Path`)
  pub field working_dir = nil
  # User (`Str`)
  pub field user = nil
  # Labels (`dict)`A
  pub field labels = nil

  field runtime = nil

  def (init) self runtime data
    self.#runtime = runtime

    bind data
      "Id": id
      "Created": created
      "Size": size
      "Architecture": arch
      "Os": os
      "Config": config
      "RootFS": root_fs
      ...

    # Podman's inspect reports a bare hex digest; Docker's is always
    # `sha256:`-prefixed. Normalized here so `id` has one consistent format
    # regardless of backend.
    self.id = if (id.starts_with "sha256:")
      id
    else
      "sha256:$id"

    self.created = created
    self.size = size
    self.architecture = arch
    self.os = os
    self.layers = root_fs.get "Layers" default: []

    bind config
      "Labels": labels = {}
      "Cmd": cmd = nil
      "Entrypoint": entrypoint = nil
      "Env": env = []
      "WorkingDir": working_dir = nil
      "User": user = nil
      ...

    self.labels = labels
    self.cmd = normalize_argv $cmd
    self.entrypoint = normalize_argv $entrypoint
    self.working_dir = (working_dir && Path working_dir)
    self.user = user
    self.env = Dict $ env.map do |e| e.split "=" limit: 1

  pub def (str) self
    self.id

  # Current tags, or an empty array for untagged images.
  pub def tags self
    let data = inspect_image $self.#runtime $self.id
    parse_image_tags $self.#runtime (data.get "RepoTags"  default: [])

  # Tag the image with a new name.
  #
  # ```
  # img.tag "registry.example.com/myapp:v1.2"
  # ```
  pub def tag self new_tag
    let ref = str $self
    self.#runtime.quiet_cli tag $ref $new_tag

  # Remove the image.
  #
  # - `force`: force removal even if the image is in use
  #
  # ```
  # img.remove()
  # img.remove force: true
  # ```
  pub def remove self :force = false
    if force
      # `rmi --force` removes containers using the image as part of the same
      # operation, but one can be self-removing at the same time (e.g. a
      # build container run with `--rm`), and podman treats that race as a
      # hard failure instead of the no-op it actually is. Removing them
      # ourselves first leaves nothing for `rmi` to race against; a
      # container that vanishes underneath this loop is exactly that race,
      # not a real failure.
      for ctr = self.#runtime.containers all: true filter: "ancestor=$(self.id)"
        try
          ctr.remove force: true
        catch NoContainerError: _
          nil
    self.#runtime.quiet_cli rmi
      if force
        --force
      $self.id

  # Save the image to an archive or directory.
  pub def save self target :format = :DOCKER_ARCHIVE: :platform = nil
    self.#runtime.save $target :format :platform $self.id

# A running or stopped container.
pub class Container
  pub field id = nil
  pub field image = nil
  pub field image_id = nil
  pub field created = nil
  pub field cmd = nil
  pub field entrypoint = nil
  pub field labels = nil

  field runtime = nil

  def (init) self runtime data
    self.#runtime = runtime

    bind data
      "Id": id
      "Created": created = nil
      "Image": image_id = nil
      "Config": config = {}
      ...

    bind config
      "Image": image = nil
      "Cmd": cmd = nil
      "Entrypoint": entrypoint = nil
      "Labels": labels = {}
      ...

    self.id = id
    self.image = image
    self.image_id = image_id
    self.created = created
    self.cmd = normalize_argv $cmd
    self.entrypoint = normalize_argv $entrypoint
    self.labels = labels

  pub def (str) self
    self.id

  # Runs `func` in this running container through a VFS context.
  #
  # A matching `dolang-vfs` helper is copied to a session-specific path under
  # `/tmp` and launched with the container runtime's `exec` command. The helper
  # is removed after the VFS connection starts when the container user has
  # permission to do so.
  #
  # `cd` selects the initial working directory. `env` applies initial
  # environment overrides; `nil` unsets a variable and `:INHERIT:` copies its
  # value from the calling context.
  #
  # Returns the result of `func`.
  pub def with self func :cd = nil :env = {}
    with_temp_dir parent: $runtime_dir() do |subdir|
      let ctr_agent = Path "/tmp/dolang-vfs-$(subdir.name)"
      self.#runtime.cli cp $(_vfs.bin()) "$(self.id):$ctr_agent"

      let vfs = Vfs do self.#runtime.cli exec -i $self.id $ctr_agent
        ...(_vfs.vfs_args cd env) --stdio
      try
        return vfs.with do
          try
            ctr_agent.remove()
          catch sys.Error: _
            nil
          func()
      finally
        time.timeout 30 do vfs.stop()

  # Current container state.
  pub def state self
    let data = inspect_container $self.#runtime $self.id
    let name = data.get "Name"
    let state = data.get "State" default: {}
    let mounts = data.get "Mounts" default: []
    let network = data.get "NetworkSettings" default: {}
    let status = state.get "Status" default: nil
    let live_name = if (name == nil)
      nil
    else if (name.starts_with "/")
      let _ trimmed = name.split "/" limit: 1
      trimmed
    else
      name
    let live_state = (status && normalize_known(CONTAINER_STATES, status) || nil)
    record
      name: $live_name
      state: $live_state
      :status
      ports: $parse_container_ports(network.get("Ports", default: {}))
      mounts: $parse_container_mounts(mounts)

  pub def stop self :timeout = nil
    self.#runtime.quiet_cli stop
      if (timeout != nil)
        --time $timeout
      $self.id

  pub def start self
    self.#runtime.quiet_cli start $self.id

  # Waits for the container to stop.
  #
  # Returns `nil` when the container exits successfully. Raises
  # `ContainerExitError` for a nonzero exit status.
  pub def wait self
    let lines = []
    let output = try
      sub do self.#runtime.cli wait $self.id stderr: $lines.prechomp()
    catch proc.Error: e
      classify_container_error $self.id $lines
      report_unknown $lines
      throw e
    let rc = int $output.trim()
    if (rc != 0)
      throw ContainerExitError $rc

  pub def kill self
    self.#runtime.quiet_cli kill $self.id

  pub def restart self :timeout = nil
    self.#runtime.quiet_cli restart
      if (timeout != nil)
        --time $timeout
      $self.id

  pub def remove self :force = false :volumes = false
    let lines = []
    try
      sub do self.#runtime.cli rm
        if force
          --force
        if volumes
          --volumes
        $self.id
        stderr: $lines.prechomp()
    catch proc.Error: e
      classify_container_error $self.id $lines
      report_unknown $lines
      throw e
