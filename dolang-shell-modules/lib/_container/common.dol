# dolang: strict
import
  fs:
   - Path
  security.unix: unix
  xdg

pub def runtime_dir() -> Path
  (xdg.runtime_dir() || Path "/run/user/$(unix.id().euid)")

pub def cache_home() -> Path
  xdg.cache_home()

pub def cache_root() -> Path
  let path = (cache_home() / "dolang-container")
  if !path.exists()
    path.create_dir all: true
  path

pub def cache_dir id @ Str -> Path
  let path = (cache_root() / "mounts" / id.replace "/" "_")
  if !path.exists()
    path.create_dir all: true
  path
