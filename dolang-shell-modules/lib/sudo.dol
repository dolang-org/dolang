# Run direct commands or block-scoped operations with elevated privileges via
# `sudo`.

import _vfs shell proc time
  strand:
    - pipeline

let :sudo ... = proc.run

def run_agent
  thunk
  :user = nil
  :cd = nil
  :env = {}
do
  let agent = _vfs.bin()

  _vfs.with_socket_dir do |subdir|
    let socket = (subdir / "socket")
    let input = strand.input()
    # The agent runs as another user and binds its socket 0666, since it cannot
    # know which uid will connect. The directory keeps other users out, but not
    # this one: any process sharing our uid could otherwise take a session that
    # is typically root. `--accept` serves one peer that proves the key, then
    # unlinks the socket.
    let key = _vfs.key()
    pipeline
      do sudo -E
        if (user != nil)
          -u $user
        $agent ...(_vfs.vfs_args cd env) --key-stdin --accept $socket
        stdin: (_vfs.key_input key)
      do
        strand.next()
        let a = shell.Vfs.unix_socket $socket :key
        try
          return strand.redirect :input do a.with $thunk
        finally
          time.timeout 30 do a.stop()

def run_command
  cmd
  :user = nil
  :cd = nil
  :env = {}
  ...args
do
  shell.env $env do sudo
    if (user != nil)
      -u $user
    if (cd != nil)
      -D $cd
    if (env.len > 0)
      --preserve-env=$(",".join(env.keys()))
    -- $cmd ...args

# (`nil`) Runs a verbatim command through `sudo`.
#
# ## Example
#
# ```
# sudo.run install -m 0644 example.conf /etc/example.conf
# ```
pub def run
  # Program to run.
  cmd
  # ([`Str`](std.Str)) Account to use instead of root.
  :user = nil
  # ([`Str`](std.Str)\|[`Path`](fs.Path)) Working directory requested via
  # sudo.
  :cd = nil
  # ([`Dict`](std.Dict)) Environment requested via sudo policy.
  :env = {}
  # Arguments passed verbatim to `cmd`.
  ...args
do
  run_command $cmd :user :cd :env ...args.pos_only()

# Runs a block with elevated privileges through `sudo`.
#
# Filesystem access and spawned programs use a temporary elevated VFS for the
# duration of the block. Pass `user` to run as an account other than root.
#
# ## Returns
#
# The result of `func`.
#
# ## Example
#
# ```
# sudo.with do run cat /etc/shadow
# ```
pub def with
  # ([`Func`](std.Func)) Block to run.
  func
  # ([`Str`](std.Str)) Account to use instead of root.
  :user = nil
  # ([`Str`](std.Str)\|[`Path`](fs.Path)) Initial elevated directory.
  :cd = nil
  # ([`Dict`](std.Dict)) Initial environment overrides.
  :env = {}
do
  run_agent $func :user :cd :env
