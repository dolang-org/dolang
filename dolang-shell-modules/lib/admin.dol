# Query administrator privileges and elevate to them in a cross-platform manner.
import sudo sys shell time
  fs:
    - @Path
  security.unix: security_unix
  security.windows: security_windows

# Reports whether the active target has effective administrator privileges.
#
# On Windows, this checks whether the access token is elevated. On Unix, it
# checks whether the effective user ID is zero.
pub def query() -> Bool
  if (sys.os_info().family == :WINDOWS:)
    security_windows.token_info().is_elevated
  else
    (security_unix.id().euid == 0)

# Runs `block` with administrator privileges.
#
# Windows uses UAC and Unix uses `sudo`. If the current context already has
# administrator privileges, `block` runs directly.
#
# Filesystem access and spawned programs use the elevated VFS for the duration
# of the block.
#
# ## Example
#
# ```
# admin.with do
#   echo "administrator: $(admin.query())"
# ```
pub def with[R]
  # Block to run.
  block @ (() -> R)
  # Initial working directory.
  :cd @ (Str | Path) = nil
  # Initial environment overrides.
  :env @ Dict = {}
do -> R
  if (sys.os_info().family == :WINDOWS:)
    if security_windows.token_info().is_elevated
      return shell.env $env do
        if (cd != nil)
          shell.cd $cd $block
        else
          block()
    let vfs = shell.Vfs.windows_admin :env
      if cd
        :cd
    try
      vfs.with $block
    finally
      time.timeout 30 do vfs.stop()
  else
    if (security_unix.id().euid == 0)
      return shell.env $env do
        if (cd != nil)
          shell.cd $cd $block
        else
          block()
    sudo.with $block :cd :env
