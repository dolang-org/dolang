# dolang: strict

import base64 rand shell sys std xdg
import
  regex:
    - Regex
  fs:
    - @Path
    - with_temp_dir
import fs.unix: unix_fs
import std:
  - @BaseDict

# Survives unquoted in both POSIX shells and cmd.exe. The base64 alphabet is a
# subset, so an encoded value always matches.
let BARE = Regex r"^[A-Za-z0-9_.:/=@+,-]+$"

# Render one VFS option, encoding its value when the transport asks for it and
# the value is not self-delimiting.
#
# `encode` is for transports that hand the command line to a shell on the far
# end -- SSH does, and the shell it lands in is a POSIX shell on a Unix host
# and cmd.exe on a Windows one. Since the answering system is unknown when the
# command is built, no quoting style is portable; base64 sidesteps quoting
# altogether.
def option encode@Value name@Str value@Value -> Tuple[Str, Str]
  let value = str $value
  if (encode && !(BARE.match value))
    return ("$name-base64", (base64.encode value))
  (name, value)

# `--login-env` carries its value in the option itself rather than as a
# separate argument, so it cannot be spread like the others.
def login_option encode@Value shell@Str -> Str
  let name value = option $encode "--login-env" $shell
  "$name=$value"

# Normalizes `mode:`/`chmod:`-style input into a plain `Int`, accepting
# either a raw integer or an `fs.unix.Mode` flags value. A `Mode`'s
# file-type bits (`IFREG`, `IFDIR`, ...) aren't meaningful for a chmod-style
# operation, so they're masked off rather than propagated.
pub def parse_mode value @ (Int | unix_fs.Mode | nil) -> (Int | nil)
  if (value == nil)
    nil
  else if (type value Int)
    value
  else if (type value unix_fs.Mode)
    (value.int & 0o7777)
  else
    throw std.TypeError "mode: expected Int or fs.unix.Mode"

pub def bin exe @ Path = nil -> Path
  let vfs_exe = shell.vfs_exe()
  if vfs_exe
    return vfs_exe

  let exe = (exe || shell.exe).canonical()
  let bin = exe.with_stem "dolang-vfs"
  let bin_meta = bin.metadata resolve: :LINK:

  if (bin_meta.type != :FILE:)
    throw "VFS helper is not a regular file: $bin"
  if (sys.os_info().family != :WINDOWS:)
    let exe_meta = exe.metadata resolve: :LINK:
    if (bin_meta.uid != exe_meta.uid)
      throw "VFS helper owner does not match interpreter: $bin"
    if (bin_meta.gid != exe_meta.gid)
      throw "VFS helper group does not match interpreter: $bin"
    if ((bin_meta.mode.int & 0o7777) != (exe_meta.mode.int & 0o7777))
      throw "VFS helper permissions do not match interpreter: $bin"

  bin

# Generates a pre-shared key for an authenticated agent session.
#
# The default alphabet is ASCII, so this is 32 bytes, well over the protocol's
# 16 byte minimum.
pub def key() -> Str
  rand.string 32

# Frames a key the way `--key-stdin` reads it: one length byte followed by that
# many key bytes.
#
# The result is an array because it is handed to a launch as `stdin:`. A `Bin`
# item crosses that boundary verbatim, with no line ending appended, so the
# agent sees exactly these bytes.
pub def key_input key @ Str -> Iterable[Bin]
  let bytes = Bin $key
  let buf = BinBuf()
  buf.push $bytes.len
  buf.extend $bytes
  [buf.freeze()]

# Creates a temporary directory to host an authenticated agent socket, mode
# `0700` so only the current user can traverse it, and cleans it up once
# `thunk` returns.
#
# Prefers `xdg.runtime_dir()` as the parent directory. That's unset on some
# systems (e.g. stock FreeBSD), and `with_temp_dir` would error on an
# explicit `nil` `parent:` (it only accepts `Path`/`Str` there), so `nil`
# is not passed through -- `with_temp_dir`'s own default (`$TMPDIR`, falling
# back to `/tmp`) is used instead.
pub def with_socket_dir[R] thunk @ (Path -> R) -> R
  let runtime_dir = xdg.runtime_dir()
  with_temp_dir
    if (runtime_dir != nil)
      parent: $runtime_dir
    do |subdir|
      subdir.update_metadata mode: 0o700
      thunk $subdir

def env_key key @ (Str | Sym) -> Str
  if (type key Str || type key Sym)
    return str $key
  throw std.TypeError "env key: expected Str or Sym"

def validate_env overrides @ BaseDict[(Str | Sym), Value] -> nil
  if !(type overrides Dict)
    throw std.TypeError "env: expected Dict"

def env_pairs overrides @ BaseDict[(Str | Sym), Value] -> Array[Tuple[Str, Value]]
  validate_env $overrides
  let pairs @ Array[Tuple[Str, Value]] = []
  for key value = overrides
    let key = env_key $key
    if (value == :INHERIT:)
      value = shell.env.get $key
    pairs.push (key, value)
  pairs

pub def env_args
  cd @ (Path | Str | nil)
  overrides @ BaseDict[(Str | Sym), Value]
do -> Array[Str | Path]
  let unsets @ Array[Str] = []
  let sets @ Array[Str] = []
  let pairs = env_pairs $overrides
  for k v = pairs
    if (v == nil)
      unsets.push -u $k
    else
      sets.push "$k=$v"
  return $
    if cd
      -C $cd
    ...unsets ...sets

pub def vfs_args
  cd @ (Path | Str | nil)
  overrides @ BaseDict[(Str | Sym), Value]
  :login @ (Bool | Str) = false
  :encode @ Value = false
do -> Array[Str]
  return $
    if login
      if (login == true)
        --login-env
      else
        (login_option encode login)
    if cd
      ...(option encode "--cd" cd)
    for k v = env_pairs $overrides
      if (v == nil)
        ...(option encode "--unset" k)
      else
        ...(option encode "--set" "$k=$v")
