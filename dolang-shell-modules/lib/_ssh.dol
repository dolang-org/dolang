# dolang: strict
import _vfs time
import
  fs:
    - @Path
  shell:
    - Vfs
  std:
    - @BaseDict
    - UnexpectedKeyError
    - UnexpectedPosError
    - ValueError

def yes_no value @ Bool -> Str
  if value
    "yes"
  else
    "no"

let HOST_KEY_VALID = $
  :DEFAULT: :STRICT: :ACCEPT_NEW:

# The options `build_command` takes after the host.
pub @let Options = $
  ?user: Str
  ?port: Int
  ?identities_only: Bool
  ?forward_agent: Bool
  ?connect_timeout: Int
  ?keepalive_interval: Int
  ?keepalive_count: Int
  ?batch: Bool
  ?host_key: (:DEFAULT: | :STRICT: | :ACCEPT_NEW:)
  ?known_hosts: (Str | Path)
  ?command: Iterable[Value]
  ?cd: (Str | Path)
  ?env: BaseDict[Str | Sym, Value]
  ?login_env: (Bool | Str)
  *identity: (Str | Path)
  *jump: Str

pub def build_command
  host @ Str
  :user @ Str = nil
  :port @ Int = nil
  :identities_only @ Bool = false
  :forward_agent @ Bool = false
  :connect_timeout @ Int = nil
  :keepalive_interval @ Int = nil
  :keepalive_count @ Int = nil
  :batch @ Bool = false
  :host_key @ (:DEFAULT: | :STRICT: | :ACCEPT_NEW:) = :DEFAULT:
  :known_hosts @ (Str | Path) = nil
  :command @ Iterable[Value] = ["dolang-vfs"]
  :cd @ (Str | Path) = nil
  :env @ BaseDict[Str | Sym, Value] = {}
  :login_env @ (Bool | Str) = true
  ...options @ (Str | Path)
do -> [Value]
  let identities @ [Value] = []
  let jumps @ [Value] = []
  for key value = options
    if (key == :identity:)
      identities.push $value
    else if (key == :jump:)
      jumps.push $value
    else
      if (type key Int)
        throw UnexpectedPosError $key
      else
        throw UnexpectedKeyError $key

  if !(HOST_KEY_VALID.contains host_key)
    throw ValueError "ssh.with: invalid host-key policy: $host_key"

  let vfs_args = _vfs.vfs_args $cd $env login: $login_env encode: true

  $
    ssh -T -e none
    -o Compression=no
    -o ClearAllForwardings=yes
    -o IdentitiesOnly=$(yes_no identities_only)
    -o BatchMode=$(yes_no batch)
    if forward_agent
      -A
    else
      -a
    if (user != nil)
      -l $user
    if (port != nil)
      -p $port
    for identity = identities
      -i $identity
    if (jumps.len > 0)
      -J $(",".join jumps)
    if (connect_timeout != nil)
      -o ConnectTimeout=$connect_timeout
    if (keepalive_interval != nil)
      -o ServerAliveInterval=$keepalive_interval
    if (keepalive_count != nil)
      -o ServerAliveCountMax=$keepalive_count
    if (host_key == :STRICT:)
      -o StrictHostKeyChecking=yes
    else if (host_key == :ACCEPT_NEW:)
      -o StrictHostKeyChecking=accept-new
    if (known_hosts != nil)
      -o UserKnownHostsFile=$known_hosts
    -- $host ...command.iter() ...vfs_args --stdio

pub def with_program[R]
  executable @ (Str | Path)
  host @ Str
  block @ (() -> R)
  ...options @ Options
do -> R
  let _ *args = build_command $host ...options
  let vfs = Vfs do run $executable ...args
  try
    vfs.with $block
  finally
    time.timeout 30 do vfs.stop()
