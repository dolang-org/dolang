import _vfs time
import
  shell:
    - Vfs
  std:
    - UnexpectedKeyError
    - UnexpectedPosError
    - ValueError

def yes_no value
  if value
    "yes"
  else
    "no"

let HOST_KEY_VALID = $
  :DEFAULT: :STRICT: :ACCEPT_NEW:

pub def build_command
  host
  :user = nil
  :port = nil
  :identities_only = false
  :forward_agent = false
  :connect_timeout = nil
  :keepalive_interval = nil
  :keepalive_count = nil
  :batch = false
  :host_key = :DEFAULT:
  :known_hosts = nil
  :command = ["dolang-vfs"]
  :cd = nil
  :env = {}
  :login_env = true
  ...options
do
  let identities = []
  let jumps = []
  for key value = options
    if (key == :identity:)
      identities.push $value
    else if (key == :jump:)
      jumps.push $value
    else
      if (type key Int)
        throw UnexpectedPosError $key
      else
        throw UnexpectedKeyError $key

  if !(HOST_KEY_VALID.contains host_key)
    throw ValueError "ssh.with: invalid host-key policy: $host_key"

  let vfs_args = _vfs.vfs_args $cd $env login: $login_env encode: true

  $
    ssh -T -e none
    -o Compression=no
    -o ClearAllForwardings=yes
    -o IdentitiesOnly=$(yes_no identities_only)
    -o BatchMode=$(yes_no batch)
    if forward_agent
      -A
    else
      -a
    if (user != nil)
      -l $user
    if (port != nil)
      -p $port
    for identity = identities
      -i $identity
    if (jumps.len > 0)
      -J $(",".join jumps)
    if (connect_timeout != nil)
      -o ConnectTimeout=$connect_timeout
    if (keepalive_interval != nil)
      -o ServerAliveInterval=$keepalive_interval
    if (keepalive_count != nil)
      -o ServerAliveCountMax=$keepalive_count
    if (host_key == :STRICT:)
      -o StrictHostKeyChecking=yes
    else if (host_key == :ACCEPT_NEW:)
      -o StrictHostKeyChecking=accept-new
    if (known_hosts != nil)
      -o UserKnownHostsFile=$known_hosts
    -- $host ...command ...vfs_args --stdio

pub def with_program
  executable
  host
  block
  :user = nil
  :port = nil
  :identities_only = false
  :forward_agent = false
  :connect_timeout = nil
  :keepalive_interval = nil
  :keepalive_count = nil
  :batch = false
  :host_key = :DEFAULT:
  :known_hosts = nil
  :command = ["dolang-vfs"]
  :cd = nil
  :env = {}
  :login_env = true
  ...options
do
  let argv = build_command $host :user :port
    :identities_only :forward_agent :connect_timeout
    :keepalive_interval :keepalive_count :batch
    :host_key :known_hosts :command :cd :env
    :login_env ...options
  argv[0] = executable
  let vfs = Vfs do run ...argv
  try
    vfs.with $block
  finally
    time.timeout 30 do vfs.stop()
