# dolang: strict
# Convenience helpers for the common “compile if needed, cache, then execute”
# workflow.
#
# Cached bytecode is stored under `fs.cache_dir()`, scoped by application name.
# If `app:` is omitted, the scope is derived from `shell.program`.

import compile digest fs load std shell strand

# Derive a default cache application name from `shell.program`.
#
# - script path: basename without the last extension
# - `-m` module: module name string
# - unset / REPL: `dolang`
def default_app() -> Str
  let p = shell.program
  if (p == nil)
    "dolang"
  else if (type p fs.Path)
    (p.stem || p.name || "dolang")
  else
    p

def normalize_app app @ (Str | nil) -> Str
  app = (app || default_app()).replace("/", "_").replace("\\", "_")
  if (app == "")
    throw std.RuntimeError "cache app name must not be empty"
  app

def module_name path @ fs.Path name @ (Str | nil) -> Str
  if (name != nil)
    name
  else
    let stem = path.stem
    if (stem == nil)
      throw std.RuntimeError "can't derive module name from path: $path"
    stem

def inject_keys inject @ BaseDict[Sym, Value] -> [Sym]
  let keys = [...inject.keys()]
  if !(keys.all do |k| type k Sym)
    throw std.TypeError "inject key: expected `Sym`"
  keys

def cache_root app @ (Str | nil) -> fs.Path
  let path = (fs.cache_dir() / normalize_app app  / "bytecode")
  path.create_dir all: true
  path

def synthetic_module_name key @ Str -> Str
  "\$$key\$"

def cache_usable cache @ fs.Path path @ fs.Path -> Bool
  (cache.exists() && path.metadata().modified < cache.metadata().modified)

# Values a script reads as the fields of an imported module.
class Namespace
  field values @ Record[...{**Value}]

  def (init) self values @ BaseDict[{...}]
    let fields @ Dict[Sym, Value] = {}
    for name value = values
      if !(type name Sym)
        throw std.TypeError "module field: expected `Sym`"
      fields[name] = value
    self.#values = Record $fields

  def (get) self name @ Sym -> Value
    self.#values.get $name else: do throw std.FieldError $name

  def (set) _self _name @ Sym _value @ Value
    throw std.ImmutableError()

def normalize_imports imports @ BaseDict[Str | Sym, Value] -> Dict[Str, Value]
  let normalized @ Dict[Str, Value] = {}
  for name value = imports
    normalized[str name] = if (type value std.BaseDict)
      Namespace $value
    else
      value
  normalized

# Calls `func` with `shell.args` and `shell.program` overridden by whichever of
# `args` and `program` is given
def with_invocation[R]
  args @ (Iterable[Value] | nil)
  program @ (Str | fs.Path | nil)
  func @ (() -> R)
do -> R
  shell.with_override
    if (args != nil)
      args: $args
    if (program != nil)
      program: $program
    - $func

# The key a source's compiled bytecode is cached under
def cache_key
  path @ fs.Path
  name @ (Str | nil)
  prelude @ BaseDict[Str | Sym, compile.PreludeBinding]
  inject @ BaseDict[Sym, Value]
do -> Str
  let state = digest.Blake3()
  state.update $ str $ path.absolute().normalize()
  state.update "\0"
  state.update (name == nil && "script" || "module")
  state.update "\0"
  state.update (name || "")
  state.update "\0"
  state.update (str prelude)
  state.update "\0"
  state.update (str $ inject_keys inject)
  "${state.digest():x}"

# A source to compile, cache and run: a module when it has a `name`, otherwise a
# script
class Operation
  field path @ fs.Path
  field name @ (Str | nil)
  field prelude @ BaseDict[Str | Sym, compile.PreludeBinding]
  field inject @ BaseDict[Sym, Value]
  field import @ Dict[Str, Value]
  field key @ Str
  field cache @ fs.Path
  field synthetic @ Str

  def (init)
    self
    path @ (Str | fs.Path)
    :name @ (Str | nil)
    :app @ (Str | nil)
    :prelude @ BaseDict[Str | Sym, compile.PreludeBinding]
    :inject @ BaseDict[Sym, Value]
    :import @ BaseDict[Str | Sym, Value]
  do
    if !(type inject Dict)
      throw std.TypeError "inject: expected `Dict`"
    if !(type import Dict)
      throw std.TypeError "import: expected `Dict`"
    self.#path = fs.Path $path
    self.#name = name
    self.#prelude = prelude
    self.#inject = inject
    self.#import = normalize_imports $import
    self.#key = cache_key $self.#path $name $prelude $inject
    self.#cache = (cache_root app / "$(self.#key).dolc")
    self.#synthetic = synthetic_module_name $self.#key

  def compile self -> compile.Unit
    let source = self.#path.read_str()
    let prelude = {...self.#prelude, $self.#synthetic: inject_keys self.#inject}
    let name = self.#name
    if (name == nil)
      compile.compile "$(self.#path)" $source prelude: $prelude
    else
      compile.compile "$(self.#path)" $source module: $name prelude: $prelude

  def run_loaded self bytecode @ Bin <Iter[Value] >Sink[Value] -> Value
    let module = Namespace $self.#inject
    let synthetic = self.#synthetic
    let imports = self.#import
    load.run $bytecode importer: do |name|
      if (name == synthetic)
        module
      else
        imports.get $name else: do load.import $name

  def compile_cached self <Iter[Value] >Sink[Value] -> Value
    let compiled = self.#compile()
    let diagnostics = [...compiled.diagnostics()]
    for diag = diagnostics
      echo $diag.render()
    if diagnostics.any do |diag| (diag.severity == :ERROR:)
      let path = self.#path.shorten()
      throw std.CompileError "failed to compile $path"
    let bytecode = compiled.emit()
    self.#cache.write $bytecode
    self.#run_loaded $bytecode

  pub def run self <Iter[Value] >Sink[Value] -> Value
    if cache_usable $self.#cache $self.#path
      try
        return self.#run_loaded $ self.#cache.read()
      catch std.BytecodeError: _
        nil
    self.#compile_cached()

# Compiles a script if needed, caches the bytecode, and runs it.
#
# The script uses the caller's input and output. Its import handlers run with
# input ended and output discarded.
#
# ## Returns
#
# The value of the script's final expression or early return.
#
# ## Example
#
# ```
# exec.run "./tool.dol"
# exec.run "./tool.dol" app: "my-tool"
# exec.run "./tool.dol" inject: {answer: 42}
# exec.run "./tool.dol" import: {config: {answer: 42}}
# exec.run "./tool.dol" args: ["--verbose"] program: "./tool.dol"
# ```
pub def run
  # Script path.
  path @ (Str | fs.Path)
  # Cache scope. Defaults to a name derived from the caller's `shell.program`.
  :app @ Str = nil
  # Imports to bind before the source, as
  # [`compile.compile`](compile.compile) takes them.
  :prelude @ BaseDict[Str | Sym, compile.PreludeBinding] = {}
  # Global bindings visible to the source when compiled and run.
  :inject @ BaseDict[Sym, Value] = {}
  # Modules supplied by name while running. A dictionary with symbol keys is
  # exposed as a module whose fields are its entries.
  :import @ BaseDict[Str | Sym, Value] = {}
  # Arguments the script sees as [`shell.args`](shell.args). Defaults to the
  # caller's.
  :args @ Iterable[Value] = nil
  # Identity the script sees as [`shell.program`](shell.program). Defaults to
  # the caller's.
  :program @ (Str | fs.Path) = nil
  <Iter[Value]
  >Sink[Value]
do -> Value
  let op = Operation $path name: nil :app :prelude :inject :import
  with_invocation $args $program do op.run()

# Compiles a module if needed, caches the bytecode, and loads it.
#
# While the module initializes, input ends immediately and output is discarded.
# The caller's input and output are restored when initialization returns or
# raises. Exported functions use the channels of their caller when invoked.
#
# ## Errors
#
# Raises [`std.TypeError`](std.TypeError) if the loaded bytecode returns a value
# other than a module.
#
# ## Example
#
# ```
# let mod = exec.module "./lib/build.dol"
# mod.main()
#
# let plugin = exec.module "./plugin.dol" name: "plugins.build"
# let injected = exec.module "./plugin.dol" inject: {answer: 42}
# ```
pub def module
  # Module source path.
  path @ (Str | fs.Path)
  # Module name. Defaults to the source file stem.
  :name @ Str = nil
  # Cache scope. Defaults to a name derived from the caller's `shell.program`.
  :app @ Str = nil
  # Imports to bind before the source, as
  # [`compile.compile`](compile.compile) takes them.
  :prelude @ BaseDict[Str | Sym, compile.PreludeBinding] = {}
  # Global bindings visible to the source when compiled and run.
  :inject @ BaseDict[Sym, Value] = {}
  # Modules supplied by name while running. A dictionary with symbol keys is
  # exposed as a module whose fields are its entries.
  :import @ BaseDict[Str | Sym, Value] = {}
  # Arguments the module sees as [`shell.args`](shell.args) while it loads.
  # Defaults to the caller's.
  :args @ Iterable[Value] = nil
  # Identity the module sees as [`shell.program`](shell.program) while it
  # loads. Defaults to the caller's.
  :program @ (Str | fs.Path) = nil
do -> std.Module
  let name = module_name (fs.Path path) $name
  let op = Operation $path :name :app :prelude :inject :import
  let module = strand.redirect input: $std.null output: $std.null do
    with_invocation $args $program do op.run()
  if type(module, std.Module)
    module
  else
    throw std.TypeError "module result: expected `Module`"
