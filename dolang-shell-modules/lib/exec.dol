# Convenience helpers for the common “compile if needed, cache, then execute”
# workflow.
#
# Cached bytecode is stored under `fs.cache_dir()`, scoped by application name.
# If `app:` is omitted, the scope is derived from `shell.program`.
#
# ## Common Parameters {: #exec.common-parameters }
#
# `run` and `module` share these options:
#
# | Name      | Type                   | Description                              |
# | --------- | ---------------------- | ----------------------------------------- |
# | `app`     | [`Str`](std.Str)  | Cache scope; defaults from `shell.program` |
# | `prelude` | [`Dict`](std.Dict) | Passed through to `compile.compile`       |
# | `inject`  | [`Dict`](std.Dict) | Global symbol/value bindings for compilation and execution |
# | `import`  | [`Dict`](std.Dict) | Modules supplied by name during execution |
#
# ### `import`
#
# Dictionary values are exposed as records.

import compile digest fs load std shell

# Derive a default cache application name from `shell.program`.
#
# - script path: basename without the last extension
# - `-m` module: module name string
# - unset / REPL: `dolang`
def default_app()
  let p = shell.program
  if (p == nil)
    "dolang"
  else if (type p fs.Path)
    (p.stem || p.name || "dolang")
  else
    p

def normalize_app app
  app = (app || default_app()).replace("/", "_").replace("\\", "_")
  if (app == "")
    throw std.RuntimeError "cache app name must not be empty"
  app

def module_name path name
  if (name != nil)
    name
  else
    let stem = path.stem
    if (stem == nil)
      throw std.RuntimeError "can't derive module name from path: $path"
    stem

def inject_keys inject
  let keys = [...inject.keys()]
  if !(keys.all do |k| type k Sym)
    throw std.TypeError "inject key: expected `Sym`"
  keys

def cache_root app
  let path = (fs.cache_dir() / normalize_app app  / "bytecode")
  path.create_dir all: true
  path

def synthetic_module_name key
  "\$$key\$"

def cache_usable cache path
  (cache.exists() && path.metadata().modified < cache.metadata().modified)

def injected_module inject
  record ...inject

def normalize_imports imports
  let normalized = {}
  for name value = imports
    value = if (type value Dict)
      record ...value
    else
      value
    name = if (type name Sym)
      str $name
    else
      name
    normalized[name] = value
  normalized

class Operation
  field path mode name prelude inject import key cache synthetic

  def (init) self path :mode :name :app :prelude :inject :import
    if !(type inject Dict)
      throw std.TypeError "inject: expected `Dict`"
    if !(type import Dict)
      throw std.TypeError "import: expected `Dict`"
    self.#path = fs.Path $path
    self.#mode = mode
    self.#name = name
    self.#prelude = prelude
    self.#inject = inject
    self.#import = normalize_imports $import
    self.#key = self.#cache_key()
    self.#cache = (cache_root app / "$(self.#key).dolc")
    self.#synthetic = synthetic_module_name $self.#key

  def cache_key self
    let state = digest.Blake3()
    state.update $ str $ self.#path.absolute().normalize()
    state.update "\0"
    state.update $self.#mode
    state.update "\0"
    state.update (self.#name || "")
    state.update "\0"
    state.update (str self.#prelude)
    state.update "\0"
    state.update (str $ inject_keys self.#inject)
    "${state.digest():x}"

  def compile self
    let source = self.#path.read()
    let prelude = {...self.#prelude, $self.#synthetic: inject_keys self.#inject}
    if (self.#mode == "script")
      compile.compile $self.#path $source prelude: $prelude
    else
      compile.compile $self.#path $source module: $self.#name prelude: $prelude

  def run_loaded self bytecode
    let module = injected_module $self.#inject
    let synthetic = self.#synthetic
    let imports = self.#import
    load.run $bytecode importer: do |name|
      if (name == synthetic)
        module
      else
        imports.get $name else: do load.import $name

  def compile_cached self
    let compiled = self.#compile()
    let diagnostics = [...compiled.diagnostics()]
    for diag = diagnostics
      echo $diag.render()
    if diagnostics.any do |diag| (diag.severity == :ERROR:)
      throw std.CompileError "failed to compile $(self.#path.relative())"
    let bytecode = compiled.emit()
    self.#cache.write $bytecode
    self.#run_loaded $bytecode

  pub def run self
    if cache_usable $self.#cache $self.#path
      try
        return self.#run_loaded $ self.#cache.read "b"
      catch std.BytecodeError: _
        nil
    self.#compile_cached()

# Compile `path` in script mode if needed, cache the bytecode, and execute it.
#
# See [common parameters](exec.common-parameters).
#
# ## Example
#
# ```
# import exec
#
# exec.run "./tool.dol"
# exec.run "./tool.dol" app: "my-tool"
# exec.run "./tool.dol" inject: {answer: 42}
# exec.run "./tool.dol" import: {config: {answer: 42}}
# ```
pub def run
  # ([`Str`](std.Str)) Script path.
  path
  # ([`Str`](std.Str)) See [common parameters](exec.common-parameters).
  :app = nil
  # ([`Dict`](std.Dict)) See [common parameters](exec.common-parameters).
  :prelude = {}
  # ([`Dict`](std.Dict)) See [common parameters](exec.common-parameters).
  :inject = {}
  # ([`Dict`](std.Dict)) See [common parameters](exec.common-parameters).
  :import = {}
do
  (Operation path mode: "script" name: nil :app :prelude :inject :import).run()

# Compile `path` in module mode if needed, cache the bytecode, and return the
# loaded module object.
#
# See [common parameters](exec.common-parameters).
#
# ## Example
#
# ```
# import exec
#
# let mod = exec.module "./lib/build.dol"
# mod.main()
#
# let plugin = exec.module "./plugin.dol" name: "plugins.build"
# let injected = exec.module "./plugin.dol" inject: {answer: 42}
# ```
pub def module
  # ([`Str`](std.Str)) Module source path.
  path
  # ([`Str`](std.Str)) Module name. Defaults to the source file stem.
  :name = nil
  # ([`Str`](std.Str)) See [common parameters](exec.common-parameters).
  :app = nil
  # ([`Dict`](std.Dict)) See [common parameters](exec.common-parameters).
  :prelude = {}
  # ([`Dict`](std.Dict)) See [common parameters](exec.common-parameters).
  :inject = {}
  # ([`Dict`](std.Dict)) See [common parameters](exec.common-parameters).
  :import = {}
do
  let name = module_name (fs.Path path) $name
  (Operation path mode: "module" :name :app :prelude :inject :import).run()
