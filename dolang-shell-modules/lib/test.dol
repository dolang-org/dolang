# Utilities for writing and running test suites.
#
# `dolang -m test` runs the tests under its path arguments with
# [`run`](test.run). Its `--jobs`, `--module-jobs` and `--timeout` options set
# the keywords of the same names, and `--no-capture` turns off `capture`.
#
# `--filter` takes a glob matched against `module/name`, where `module` is the
# test file's path without its extension. The repeatable `--tags` option splits
# each occurrence on commas: alternatives in one occurrence are ORed, while
# occurrences are ANDed. Prefix a tag with `!` to require its absence.
# Matching is exact and case-sensitive.
#
# `--tags !windows,!macos` means “not Windows OR not macOS.” Use
# `--tags !windows --tags !macos` to exclude both.
#
# The repeatable `--id` option selects tests by exact
# [ID](test.TestInfo.id), with no glob syntax to escape. It combines with
# `--filter` and `--tags`, all of which must match.
#
# ## Listing Tests
#
# `--list` loads each module with [`list`](test.list) and reports the selected
# tests without running them. `--jobs` and `--no-capture` don't apply. The exit
# status is one when a module fails to compile or load, and zero otherwise,
# including when a module skips while loading.
#
# By default the list is a report on the console. `--format json` instead
# writes one JSON document to standard output, or to the file given by
# `--output`:
#
# ```json
# {
#   "version": 1,
#   "modules": [
#     {
#       "path": "test/foo.dol",
#       "module": "test/foo",
#       "status": "loaded",
#       "tests": [
#         {
#           "id": "test/foo/connects/backend=sqlite",
#           "module": "test/foo",
#           "name": "connects/backend=sqlite",
#           "base": "connects",
#           "params": [["backend", "sqlite"]],
#           "tags": ["slow"],
#           "location": {"file": "test/foo.dol", "line": 12, "column": 0, "len": 12}
#         }
#       ]
#     },
#     {
#       "path": "test/bar.dol",
#       "module": "test/bar",
#       "status": "failed",
#       "error": {"kind": "compile", "message": "...", "diagnostics": [...]}
#     }
#   ]
# }
# ```
#
# - `version` changes when the format changes incompatibly.
# - Modules appear in path order, and tests in registration order. Paths are
#   as given on the command line, with directories expanded.
# - `status` is `loaded`, `failed`, `skipped` or `ignored`. A skipped or ignored
#   module has a `message`, which may be `null`.
# - A test's fields are those of [`TestInfo`](test.TestInfo). `location` is
#   `null` when unknown.
# - A failed module's `error` has a `kind` of `compile` or `load` and a
#   `message`. A compile error lists `diagnostics`, each with a `severity`
#   (`error` or `warning`), `message` and `location`. A load error has
#   `rendered`, the error as the run report prints it, with its backtrace. An
#   `output` field holds what the module wrote while loading, when it wrote
#   anything.
# - Locations are zero-based, with columns and lengths in characters, as in
#   [`inspect.Location`](inspect.Location).
import _shell compile inspect json load progress shell strand term
  fs:
    - Path
  time:
    - timeout

let err_style = term.Style bold: true fg: :BRIGHT_RED:
let info_style = term.Style fg: :YELLOW:
let pass_style = term.Style fg: :GREEN:
let name_style = term.Style dim: true
let note_style = term.Style bold: true

class TestCase
  pub field module name tags func base params location

  def (init) self module name tags func base params location
    self.module = module
    self.name = name
    self.tags = tags
    self.func = func
    self.base = base
    self.params = params
    self.location = location

class TestCollection
  field module
  field tests = []
  field tags = []

  def (init) self module
    self.#module = module

  pub def add self name tags func base params location
    if (self.#module == nil)
      throw std.StateError "test registration outside a test file"
    let all_tags = Tuple [...self.#tags, ...tags]
    self.#tests.push $TestCase(self.#module, name, all_tags, func, base, params, location)

  pub def add_tags self tags
    if (self.#module == nil)
      throw std.StateError "test registration outside a test file"
    self.#tags.push ...tags

  pub def take self
    self.#tests

let collect_key @ strand.Key[TestCollection] = strand.Key(TestCollection nil)

# Accumulates parametrize axes around a composed test function. Any
# decorator that needs to attach metadata beyond a function (currently
# only `parametrize`) normalizes its input into a `TestDef` via
# `to_test_def`; `fixture` reaches through (or creates) one transparently,
# so `#[fixture]`-only tests register the same function as before.
#
# The definition location is taken from the function the first decorator
# receives, before any fixture wraps it.
class TestDef: Func
  pub field func location
  pub field params = []

  def (init) self func
    self.func = func
    self.location = inspect.definition $func

  # Transparently forwards to `func`, so a `TestDef` remains a drop-in
  # function/stringifiable value wherever the decorated function itself
  # would be.
  def (call) self ...rest
    self.func(...rest)

  def (str) self
    str $self.func

def to_test_def x
  if (type x TestDef)
    x
  else
    TestDef $x

# A parametrize value paired with tags contributed only when that value is
# selected. Not constructed directly; use `tagged`.
class TaggedValue[T]: @Tagged[T]
  pub field value @ T
  pub field tags

  def (init) self value @ T tags = []
    self.value = value
    self.tags = tags

def normalize_param_value v
  if (type v TaggedValue)
    v
  else
    TaggedValue $v []

# A [`parametrize`](test.parametrize) value carrying tags, made by
# [`tagged`](test.tagged).
pub @class Tagged[T]
  field _ @ T

# Attaches tags to a single `parametrize` value, honored only in cases that
# select it.
#
# ## Example
#
# ```
# #[parametrize backend: [sqlite_conn, tagged(postgres_conn, "slow")]]
# ```
pub def tagged[T]
  # The parametrize value.
  value @ T
  # Tags to attach.
  *values @ Str
do -> Tagged[T]
  let tag_values = []
  for tag = values
    if !(type tag Str)
      throw std.TypeError "tagged: expected strings"
    tag_values.push $tag
  TaggedValue $value $tag_values

# Read-only metadata for a discovered test.
pub class TestInfo
  field case

  def (init) self case
    self.#case = case

  # The module containing the test.
  #[getter]
  pub def module self -> Path
    self.#case.module

  # The registered test name without normalization.
  #[getter]
  pub def name self -> Str
    self.#case.name

  # The immutable test tags. Order and duplicates are preserved.
  #[getter]
  pub def tags self -> Tuple[...Str]
    self.#case.tags

  # The test's ID, `module/name` with the module path's extension removed: the
  # string `--filter` and `--id` match.
  #[getter]
  pub def id self -> Str
    "$(module_name self.#case.module)/$(self.#case.name)"

  # The name the test was registered under, before any
  # [`parametrize`](test.parametrize) axes are appended. Equal to
  # [`name`](test.TestInfo.name) for a test without axes.
  #[getter]
  pub def base self -> Str
    self.#case.base

  # The case's `parametrize` axes as `(axis, value)` pairs, in the order they
  # appear in the name. Values are given as in the name. Empty for a test
  # without axes.
  #[getter]
  pub def params self -> Tuple[...Tuple[Str, Str]]
    self.#case.params

  # Where the test function is defined, as given by
  # [`inspect.definition`](inspect.definition) for the function the first
  # test decorator received, or `nil` when unknown.
  #[getter]
  pub def location self -> (inspect.Location | nil)
    self.#case.location

class ModuleCompileError: std.RuntimeError
  pub field path output

  def (init) self path output
    std.RuntimeError.(init) $self "compilation failed: $path"
    self.path = path
    self.output = output

class Failure
  pub field error backtrace path test output

  def (init) self error backtrace path test = nil output = nil
    self.error = error
    self.backtrace = backtrace
    self.path = path
    self.test = test
    self.output = output

# The outcome of loading a test module: `status` is `:LOADED:` with the
# selected `cases`, or `:FAILED:`, `:SKIPPED:` or `:IGNORED:` with `error`.
class ModuleResult
  pub field path status error backtrace output
  pub field cases = []

  def (init) self path status
    self.path = path
    self.status = status

def module_name path
  let name = str $path.without_ext()
  name.replace "\\" "/"

# Prints a failure, skip or ignore in the run report's style, returning which
# it was.
def print_failure failure
  let e = failure.error
  let module = module_name $failure.path
  if (type e Ignore)
    return :IGNORED:
  if (type e Skip)
    let name = (failure.test && "$module/$(failure.test)" || module)
    print (info_style "skipped") ": " (name_style name)
    if e.message
      print " (" (note_style e.message) ")"
    echo()
    return :SKIPPED:
  if (type e ModuleCompileError)
    print (err_style "failed") ": " (name_style "$module")
      " (" (note_style "compilation failed") ")\n"
    for diag = e.output.diagnostics()
      echo $diag.render().indent(2)
    return :FAILED:
  if failure.test
    print (err_style "failed") ": " (name_style "$module/$(failure.test)") ": "
  else
    print (err_style "failed") ": " (name_style "$module") ": "
  echo $ shell.render_error $e backtrace: $failure.backtrace
  if failure.output
    print "  ──\n" $term.preformat(failure.output).indent(2)
  :FAILED:

class Harness
  field module_jobs jobs filter timeout capture
  field errors = []
  field success total = 0

  def (init) self :jobs :module_jobs :filter :timeout :capture
    self.#module_jobs = strand.Resource $module_jobs
    self.#jobs = strand.Resource $jobs
    self.#timeout = timeout
    self.#filter = filter
    self.#capture = capture

  def matches_filter self case
    self.#filter $TestInfo(case)

  def record_test self
    self.#total = (self.#total + 1)

  def record_success self
    self.#success = (self.#success + 1)

  def with_timeout self func
    if (self.#timeout != nil)
      timeout $self.#timeout $func
    else
      func()

  def record_error self error backtrace path test = nil output = nil
    self.#errors.push $Failure(error, backtrace, path, test, output)

  def with_capture self output func
    if self.#capture
      term.capture (term.IoConsole output can_style: true) $func
    else
      func()

  def run_test self case
    self.#record_test()
    let output = BinBuf()
    try
      self.#with_capture $output do self.#with_timeout $case.func
      self.#record_success()
    catch std.RuntimeError: e
      let captured = (self.#capture && output.freeze_str())
      self.#record_error $e $(strand.error_backtrace()) $case.module $case.name $captured

  def run_module self path cases
    progress.show message: (module_name path) icon: ▶ total: $cases.len do |w|
      strand.fork
        for case = cases
          do self.#jobs.with do
            progress.show message: $case.name do |_|
              w.update icon: ▼
              self.#run_test $case
              w.delta()

  # Compiles and loads a module, collecting the tests it registers that pass
  # the filter. With `redirect`, the module's strand output goes to the
  # capture buffer as well, so none of it reaches stdout.
  def load_file self path :redirect = false
    let output = BinBuf()
    try
      let source = path.read_str()
      let compiled = compile.compile $path $source
      let diagnostics = [...compiled.diagnostics()]
      let warnings = diagnostics.any do |d| (d.severity == :WARNING:)
      let errors = diagnostics.any do |d| (d.severity == :ERROR:)
      if (errors || warnings)
        throw ModuleCompileError $path $compiled

      let cases = collect_key.with (TestCollection path) do
        if redirect
          strand.redirect output: $output do
            self.#with_capture $output do self.#with_timeout do load.run $compiled.emit()
        else
          self.#with_capture $output do self.#with_timeout do load.run $compiled.emit()
        collect_key.value.take()
      let result = ModuleResult $path :LOADED:
      result.cases = [...cases.filter(do |case| self.#matches_filter case)]
      result
    catch std.RuntimeError: e
      let status = if (type e Skip)
        :SKIPPED:
      else if (type e Ignore)
        :IGNORED:
      else
        :FAILED:
      let result = ModuleResult $path $status
      result.error = e
      result.backtrace = strand.error_backtrace()
      result.output = (self.#capture && output.freeze_str() || nil)
      result

  def run_file self path
    let result = self.#load_file $path
    if (result.status == :LOADED:)
      self.#run_module $path $result.cases
    else
      self.#record_error $result.error $result.backtrace $path nil $result.output

  def report self
    let rc = 0
    let ignored = 0
    let skipped = 0
    for failure = self.#errors
      let kind = print_failure $failure
      if (kind == :FAILED:)
        rc = 1
      else if failure.test
        if (kind == :SKIPPED:)
          skipped = (skipped + 1)
        else
          ignored = (ignored + 1)
    print (pass_style "passed") ": $(self.#success)/$(self.#total - skipped - ignored)"
    if skipped
      print " ($skipped " (info_style "skipped") ")"
    echo()
    rc

  pub def run self files
    progress.show message: modules total: $files.len do |w|
      strand.fork
        for path = files
          do self.#module_jobs.with do
            self.#run_file $path
            w.delta()
    self.#report()

  # Loads each module without running its tests, giving a `ModuleResult` for
  # each file in order.
  pub def list self files
    let results = []
    for _ = files
      results.push nil
    progress.show message: modules total: $files.len do |w|
      strand.fork
        for i path = files.enumerate()
          do self.#module_jobs.with do
            results[i] = self.#load_file $path redirect: true
            w.delta()
    results

# The JSON form of an `inspect.Location`, or `nil`.
def location_record loc
  if (loc == nil)
    return nil
  $
    file: $loc.source
    line: $loc.line
    column: $loc.column
    len: $loc.len

# The JSON record of a test case, shared by `--list` and progress events.
def test_record case
  let module = module_name $case.module
  $
    id: "$module/$(case.name)"
    module: $module
    name: $case.name
    base: $case.base
    params: $case.params
    tags: $case.tags
    location: $(location_record case.location)

def diagnostic_record diag path
  let span = diag.span.span
  $
    severity: (diag.severity == :ERROR: && "error" || "warning")
    message: $diag.message
    location:
      file: $(str path)
      line: $span.start.line
      column: $span.start.column
      len: $span.len

def module_record result
  let record = $
    path: $(str result.path)
    module: $(module_name result.path)
  let e = result.error
  if (result.status == :LOADED:)
    record[:status:] = "loaded"
    record[:tests:] = [...result.cases.map(test_record)]
  else if (result.status == :FAILED:)
    record[:status:] = "failed"
    let error = if (type e ModuleCompileError)
      let diagnostics = [...e.output.diagnostics().map(do |d| diagnostic_record d result.path)]
      $
        kind: compile
        message: $(str e)
        diagnostics: $diagnostics
    else
      $
        kind: load
        message: $(str e)
        rendered: $(str (shell.render_error e backtrace: result.backtrace))
    if result.output
      error[:output:] = result.output
    record[:error:] = error
  else
    record[:status:] = (result.status == :SKIPPED: && "skipped" || "ignored")
    record[:message:] = e.message
  record

def print_listing results
  let tests = 0
  let modules = 0
  for result = results
    if (result.status != :LOADED:)
      continue
    modules = (modules + 1)
    let module = module_name $result.path
    for case = result.cases
      tests = (tests + 1)
      print (name_style "$module/") $case.name
      if case.tags.len
        print " " (name_style "[$(", ".join(case.tags))]")
      echo()
  for result = results
    if (result.status != :LOADED:)
      print_failure $Failure(result.error, result.backtrace, result.path, nil, result.output)
  print (pass_style "listed") ": $tests " (tests == 1 && "test" || "tests")
  print " in $modules " (modules == 1 && "module" || "modules")
  echo()

def test_files paths
  let files = []
  for path = paths
    let path = Path $path
    if (path.metadata().type == :DIR:)
      files.push ...path.glob("**/*.dol")
    else
      files.push $path
  files

class Fixture: Func
  field wrap func

  def (init) self wrap func
    self.#wrap = wrap
    self.#func = func

  def (call) self ...rest
    self.#wrap $self.#func ...rest

  def (str) self
    str $self.#func

# Defines a test fixture. `wrap` should be a function which accepts a block
# and invokes it with surrounding setup and teardown logic. `wrap` receives
# any trailing keyword parameters supplied by `parametrize` (or by an outer
# fixture) after `block` and should forward them to `block` — typically via
# a variadic `...rest` parameter — so they reach the test function. `wrap`
# may also pass its own additional keyword parameters to `block` to inject
# values into the test.
#
# ## Example
#
# ```
# #[fixture]
# def example_fixture block ...rest
#   setup()
#   try
#     block(...rest)
#   finally
#     teardown()
#
# #[test]
# #[example_fixture]
# def example_test()
#   do_something()
# ```
pub def fixture wrap -> (Value -> Value)
  do |value|
    let test_def = to_test_def $value
    test_def.func = Fixture $wrap $test_def.func
    test_def

# Returns a decorator that registers a zero-argument test function.
#
# ## Example
#
# ```
# #[test name: "connects" tags: ["integration", "linux"]]
# def connects_to_service()
#   connect()
# ```
@def test
  # Reporting name. Defaults to the test function's string form.
  :name @ Str = nil
  # Tags to attach. Order and duplicates are
  # preserved.
  :tags @ Iterable[Str] = []
do -> (Value -> Value)

# Registers a zero-argument test function, returning it.
@def test[F]
  # Reporting name. Defaults to `str(func)`.
  :name @ Str = nil
  # Tags to attach. Order and duplicates are
  # preserved.
  :tags @ Iterable[Str] = []
  # Test function, or a test decorated with
  # [`parametrize`](test.parametrize) or a fixture.
  func @ F
do -> F

pub def test
  :name @ Str = nil
  :tags @ Iterable[Str] = []
  func = nil
do
  if (func == nil)
    return do |func| test name: $name tags: $tags $func
  let tag_values = []
  for tag = tags
    if !(type tag Str)
      throw std.TypeError "test tags: expected strings"
    tag_values.push $tag

  let test_def = to_test_def $func
  let base_name = (name || str(test_def.func))

  let location = test_def.location
  if (test_def.params.len == 0)
    collect_key.value.add $base_name $tag_values $test_def.func $base_name () $location
    return func

  let combos = [[{}, [], []]]
  for axis_name axis_values = test_def.params
    let next = []
    for combo = combos
      let kwargs extra_tags params = combo
      for pv = axis_values
        let new_kwargs = {...kwargs}
        new_kwargs[axis_name] = pv.value
        # `/` is stripped so a stringified value can't split the registered
        # name across what `--filter` treats as path segments.
        let value_part = str(pv.value).replace("/", "_")
        next.push [new_kwargs, [...extra_tags, ...pv.tags], [...params, (str(axis_name), value_part)]]
    combos = next

  for combo = combos
    let kwargs extra_tags params = combo
    let name_parts = [...params.map(do |p| "$(p[0])=$(p[1])")]
    let case_name = "$base_name/$("/".join(name_parts))"
    let case_tags = [...tag_values, ...extra_tags]
    let case_func = do test_def.func(...kwargs)
    collect_key.value.add $case_name $case_tags $case_func $base_name $Tuple(params) $location

  func

# Registers one or more parametrize axes on a test. Each keyword argument
# names an axis under which its value is passed to the decorated test
# function (and to any fixture that declares it). Stacks with other
# `parametrize` decorators, and composes freely with `#[fixture]`
# decorators; the cartesian product is taken over every axis registered by
# any application.
#
# Because decorators apply bottom-to-top, axes accumulate in
# closest-to-`def`-first order (axes from one decorator are ordered as
# written); this affects only the generated case names
# (`$base_name/$axis1=$v/$axis2=$v/...`).
#
# ## Example
#
# ```
# #[test]
# #[parametrize backend: [sqlite_conn, tagged(postgres_conn, "slow")]]
# def connects :backend
#   backend.ping()
# ```
@def parametrize
  # An axis name paired with an iterable of raw
  # values and/or `tagged(value, ...tags)` wrappers for that axis.
  ...axes @ Iterable[Value]
do -> (Value -> Value)

# Registers parametrize axes on a test function directly, returning the
# decorated test for [`test`](test.test).
@def parametrize
  # Test function, or a test already decorated with
  # `parametrize` or a fixture.
  func
  # An axis name paired with an iterable of raw
  # values and/or `tagged(value, ...tags)` wrappers for that axis.
  ...axes @ Iterable[Value]
do

pub def parametrize
  func = nil
  ...axes @ Iterable[Value]
do
  if (func == nil)
    return do |func| parametrize $func ...axes
  let test_def = to_test_def $func
  for name values = axes
    if !(type name Sym)
      throw std.UnexpectedPosError $name
    if (values.len == 0)
      throw std.ValueError "parametrize: '$name' has no values"
    test_def.params.push [name, [...values.map(normalize_param_value)]]
  test_def

# Adds tags to tests subsequently registered in the current module.
#
# Repeated calls accumulate tags. Module tags precede tags supplied directly
# to `test`; order and duplicates are preserved.
#
# ## Example
#
# ```
# tags "integration" "linux"
#
# #[test tags: ["slow"]]
# def connects()
#   connect()
# ```
pub def tags
  # Tag to add.
  *values @ Str
do
  let tag_values = []
  for tag = values
    if !(type tag Str)
      throw std.TypeError "test tags: expected strings"
    tag_values.push $tag
  collect_key.value.add_tags $tag_values

# Raised when an assertion fails.
pub class Assert: std.RuntimeError
  # The assertion's message, or `nil` if none was given.
  pub field message @ (Str | nil) = nil

  def (init) self message
    std.RuntimeError.(init) $self
      if (message != nil)
        "assertion failed: $message"
      else
        "assertion failed"
    self.message = message

# Raised to skip a test case.
#
# Raise it from a test function, or call [`skip`](test.skip), to mark the test
# as skipped rather than failed.
pub class Skip: std.RuntimeError
  # Skip message, or `nil` if none was given.
  pub field message @ (Str | nil) = nil

  def (init) self message = nil
    std.RuntimeError.(init) $self
      if (message != nil)
        "test skipped: $message"
      else
        "test skipped"
    self.message = message

# Skips the current test by raising [`Skip`](test.Skip).
pub def skip
  # Reason to report.
  msg @ Str = nil
do
  throw Skip $msg

# Raised to omit a test case from the report.
pub class Ignore: std.RuntimeError
  # Ignore message, or `nil` if none was given.
  pub field message @ (Str | nil) = nil

  def (init) self message = nil
    std.RuntimeError.(init) $self
      if (message != nil)
        "test ignored: $message"
      else
        "test ignored"
    self.message = message

# Omits the current test from the report by raising
# [`Ignore`](test.Ignore).
pub def ignore
  # Reason to record.
  msg @ Str = nil
do
  throw Ignore $msg

# Asserts that `cond` is truthy.
#
# ## Errors
#
# [`Assert`](test.Assert) if the assertion fails.
pub def assert
  # Condition to test.
  cond
  # Message to add to the failure.
  msg @ Str = nil
do
  if !cond
    throw Assert $msg

# Asserts that `cond` is falsy.
#
# ## Errors
#
# [`Assert`](test.Assert) if the assertion fails.
pub def assert_not
  # Condition to test.
  cond
  # Message to add to the failure.
  msg @ Str = nil
do
  if cond
    throw Assert $msg

# Asserts that `left == right`.
#
# ## Errors
#
# [`Assert`](test.Assert) if the assertion fails.
pub def assert_eq
  # Actual value.
  left
  # Expected value.
  right
  # Message to add to the failure.
  msg @ Str = nil
do
  if (left != right)
    if msg
      throw Assert "${left:?} == ${right:?}: $msg"
    else
      throw Assert "${left:?} == ${right:?}"

# Asserts that `left != right`.
#
# ## Errors
#
# [`Assert`](test.Assert) if the assertion fails.
pub def assert_ne
  # Actual value.
  left
  # Value it must differ from.
  right
  # Message to add to the failure.
  msg @ Str = nil
do
  if (left == right)
    if msg
      throw Assert "${left:?} != ${right:?}: $msg"
    else
      throw Assert "${left:?} != ${right:?}"

# Asserts that `block` raises an error of `type`, and returns the error.
#
# ## Errors
#
# [`Assert`](test.Assert) if the assertion fails.
pub def assert_throws[E]
  # Error type expected, or a supertype of it.
  type @ Type[E]
  # Expected string form of the error.
  :str @ Str = nil
  # Message to add to the failure.
  :msg @ Str = nil
  # Block to run.
  block @ (() -> Value)
do -> E
  try
    block()
  catch type: e
    if (str != nil && std.str e != str)
      if msg
        throw Assert "$msg (error str ${std.str(e):?} == ${str:?})"
      else
        throw Assert "error str ${std.str(e):?} == ${str:?}"
    return e
  if msg
    throw Assert "$msg ($type thrown)"
  else
    throw Assert "$type thrown"

# Asserts that `value` is an instance of `expected` or a subtype of it.
#
# ## Errors
#
# [`Assert`](test.Assert) if the assertion fails.
pub def assert_type[T]
  # Expected type.
  expected @ Type[T]
  # Value to test.
  value
  # Message to add to the failure.
  msg @ Str = nil
do
  if !(type value expected)
    if msg
      throw Assert "$msg (${value:?} @ $(type value) <: $expected)"
    else
      throw Assert "${value:?} @ $(type value) <: $expected"

# Discovers and runs tests under the given files and directories.
#
# A directory is searched recursively for `.dol` files.
#
# ## Returns
#
# Zero when all selected tests pass, or one when any module or test fails.
pub def run
  # Maximum concurrent tests.
  :jobs @ Int = 8
  # Maximum concurrent modules.
  :module_jobs @ Int = 4
  # Predicate receiving a
  # [`TestInfo`](test.TestInfo). Defaults to accepting every test.
  :filter @ (TestInfo -> Bool) = (do |_| true)
  # Per-test and module-load timeout in seconds.
  :timeout @ Int = 600
  # Capture output and show it for failures.
  :capture @ Bool = true
  # Test file or directory.
  *paths @ (Str | Path)
do -> Int
  let harness = Harness :jobs :module_jobs :filter :timeout :capture
  harness.run $(test_files paths)

# Discovers tests under the given files and directories without running them.
#
# Each module is compiled and loaded as [`run`](test.run) loads it, and the
# tests it registers that pass `filter` are reported in file order, then in
# registration order. Output a module writes while loading is captured. Modules
# that fail to compile or load, or that skip while loading, are reported
# alongside the tests.
#
# The human-readable report goes to the console. The JSON document is
# described in the [module documentation](test).
#
# ## Returns
#
# One when any module fails to compile or load, otherwise zero.
pub def list
  # Maximum concurrent modules.
  :module_jobs @ Int = 4
  # Predicate receiving a
  # [`TestInfo`](test.TestInfo). Defaults to accepting every test.
  :filter @ (TestInfo -> Bool) = (do |_| true)
  # Module-load timeout in seconds.
  :timeout @ Int = 600
  # `:HUMAN:` for a report on the console, or `:JSON:` for a JSON document.
  :format @ (:HUMAN: | :JSON:) = :HUMAN:
  # File to write the JSON document to instead of standard output.
  :output @ (Str | Path | nil) = nil
  # Test file or directory.
  *paths @ (Str | Path)
do -> Int
  let harness = Harness jobs: 1 :module_jobs :filter :timeout capture: true
  let results = harness.list $(test_files paths)
  if (format == :JSON:)
    let document = $
      version: 1
      modules: $[...results.map(module_record)]
    let text = "$(json.encode document)\n"
    if (output != nil)
      Path(output).write $text
    else
      shell.stdout.write $text
  else
    print_listing $results
  (results.any(do |r| r.status == :FAILED:) && 1 || 0)
