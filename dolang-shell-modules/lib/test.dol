import compile load progress strand term
  fs:
    - Path
  time:
    - timeout

let err_style = term.Style bold: true fg: :BRIGHT_RED:
let info_style = term.Style fg: :YELLOW:
let pass_style = term.Style fg: :GREEN:
let name_style = term.Style dim: true
let note_style = term.Style bold: true

let collect_key = strand.Key()

class TestCase
  pub field module name tags func

  def (init) self module name tags func
    self.module = module
    self.name = name
    self.tags = tags
    self.func = func

class TestCollection
  field module
  field tests = []
  field tags = []

  def (init) self module
    self.#module = module

  pub def add self name tags func
    self.#tests.push $TestCase(self.#module, name, Tuple([...self.#tags, ...tags]), func)

  pub def add_tags self tags
    self.#tags.push ...tags

  pub def take self
    self.#tests

# Accumulates parametrize axes around a composed test callable. Any
# decorator that needs to attach metadata beyond "a callable" (currently
# only `parametrize`) normalizes its input into a `TestDef` via
# `to_test_def`; `fixture` reaches through (or creates) one transparently,
# so `#[fixture]`-only tests register the same callable as before.
class TestDef
  pub field func
  pub field params = []

  def (init) self func
    self.func = func

  # Transparently forwards to `func`, so a `TestDef` remains a drop-in
  # callable/stringifiable value wherever the decorated function itself
  # would be.
  def (call) self ...rest
    self.func(...rest)

  def (str) self
    str $self.func

def to_test_def x
  if (type x TestDef)
    x
  else
    TestDef $x

# A parametrize value paired with tags contributed only when that value is
# selected. Not constructed directly; use `tagged`.
class TaggedValue
  pub field value tags

  def (init) self value tags = []
    self.value = value
    self.tags = tags

def normalize_param_value v
  if (type v TaggedValue)
    v
  else
    TaggedValue $v []

# Attaches tags to a single `parametrize` value, honored only in cases that
# select it.
#
# # Example
#
# ```
# #[parametrize backend: [sqlite_conn, tagged(postgres_conn, "slow")]]
# ```
pub def tagged value ...values
  let tag_values = []
  for tag = values.pos_only()
    if !(type tag Str)
      throw std.TypeError "tagged: expected strings"
    tag_values.push $tag
  TaggedValue $value $tag_values

# Read-only metadata for a discovered test.
pub class TestInfo
  field case

  def (init) self case
    self.#case = case

  # The `Path` of the module containing the test.
  #[getter]
  pub def module self
    self.#case.module

  # The registered test name without normalization.
  #[getter]
  pub def name self
    self.#case.name

  # The immutable test tags. Order and duplicates are preserved.
  #[getter]
  pub def tags self
    self.#case.tags

class ModuleCompileError: std.RuntimeError
  pub field path output

  def (init) self path output
    std.RuntimeError.(init) $self "compilation failed: $path"
    self.path = path
    self.output = output

class Failure
  pub field error backtrace path test output

  def (init) self error backtrace path test = nil output = nil
    self.error = error
    self.backtrace = backtrace
    self.path = path
    self.test = test
    self.output = output

def module_name path
  let name = str $path.without_ext()
  name.replace "\\" "/"

class Harness
  field module_jobs jobs filter timeout capture
  field errors = []
  field success total = 0

  def (init) self :jobs :module_jobs :filter :timeout :capture
    self.#module_jobs = strand.Resource $module_jobs
    self.#jobs = strand.Resource $jobs
    self.#timeout = timeout
    self.#filter = filter
    self.#capture = capture

  def matches_filter self case
    self.#filter $TestInfo(case)

  def record_test self
    self.#total = (self.#total + 1)

  def record_success self
    self.#success = (self.#success + 1)

  def with_timeout self func
    if (self.#timeout != nil)
      timeout $self.#timeout $func
    else
      func()

  def record_error self error backtrace path test = nil output = nil
    self.#errors.push $Failure(error, backtrace, path, test, output)

  def with_capture self output func
    if self.#capture
      term.capture (term.SinkConsole(output, can_style: true)) $func
    else
      func()

  def run_test self case
    self.#record_test()
    let output = StrBuf()
    try
      self.#with_capture $output do self.#with_timeout $case.func
      self.#record_success()
    catch std.RuntimeError: e
      let captured = (self.#capture && output.freeze())
      self.#record_error $e $(strand.error_backtrace()) $case.module $case.name $captured

  def run_module self path cases
    progress.show message: (module_name path) icon: ▶ total: $cases.len do |w|
      strand.fork
        for case = cases
          do self.#jobs.with do
            progress.show message: $case.name do |_|
              w.update icon: ▼
              self.#run_test $case
              w.delta()

  def run_file self path
    let output = StrBuf()
    try
      let source = path.read b
      let compiled = compile.compile $path $source
      let diagnostics = [...compiled.diagnostics()]
      let warnings = diagnostics.any do |d| (d.severity == :WARNING:)
      let errors = diagnostics.any do |d| (d.severity == :ERROR:)
      if (errors || warnings)
        throw ModuleCompileError $path $compiled

      collect_key.value = TestCollection $path
      self.#with_capture $output do self.#with_timeout do load.run $compiled.emit()
      let cases = collect_key.value.take()
      collect_key.value = nil
      cases = [...cases.filter(do |case| self.#matches_filter case)]
      self.#run_module $path $cases
    catch std.RuntimeError: e
      collect_key.value = nil
      let captured = (self.#capture && output.freeze())
      self.#record_error $e $(strand.error_backtrace()) $path nil $captured

  def report self
    let rc = 0
    let skipped = 0
    for failure = self.#errors
      let e = failure.error
      let module = module_name $failure.path
      if (type e Skip)
        if failure.test
          print (info_style "skipped") ": " (name_style "$module/$(failure.test)")
          if e.message
            print " (" (note_style e.message) ")"
          echo()
          skipped = (skipped + 1)
        else
          print (info_style "skipped") ": " (name_style "$module")
          if e.message
            print " (" (note_style e.message) ")"
          echo()
      else if (type e ModuleCompileError)
        rc = 1
        print (err_style "failed") ": " (name_style "$module")
          " (" (note_style "compilation failed") ")\n"
        for diag = e.output.diagnostics()
          echo $diag.render().indent(2)
      else
        rc = 1
        if failure.test
          print (err_style "failed") ": " (name_style "$module/$(failure.test)") ": "
        else
          print (err_style "failed") ": " (name_style "$module") ": "
        echo $ term.render_error $e backtrace: $failure.backtrace
        if failure.output
          print "  ──\n" $term.preformat(failure.output).indent(2)
    print (pass_style "passed") ": $(self.#success)/$(self.#total - skipped)"
    if skipped
      print " ($skipped " (info_style "skipped") ")"
    echo()
    rc

  pub def run self files
    progress.show message: modules total: $files.len do |w|
      strand.fork
        for path = files
          do self.#module_jobs.with do
            self.#run_file $path
            w.delta()
    self.#report()

class Fixture
  field wrap func

  def (init) self wrap func
    self.#wrap = wrap
    self.#func = func

  def (call) self ...rest
    self.#wrap $self.#func ...rest

  def (str) self
    str $self.#func

# Defines a test fixture.  `wrap` should be a function which accepts a block
# and invokes it with surrounding setup and teardown logic. `wrap` receives
# any trailing keyword parameters supplied by `parametrize` (or by an outer
# fixture) after `block` and should forward them to `block` — typically via
# a variadic `...rest` parameter — so they reach the test function. `wrap`
# may also pass its own additional keyword parameters to `block` to inject
# values into the test.
#
# # Returns
#
# A function suitable for use as a decorator on a test function.
#
# # Example
#
# ```
# #[fixture]
# def example_fixture block ...rest
#   setup()
#   try
#     block(...rest)
#   finally
#     teardown()
#
# #[test]
# #[example_fixture]
# def example_test()
#   do_something()
# ```
pub def fixture wrap
  do |value|
    let test_def = to_test_def $value
    test_def.func = Fixture $wrap $test_def.func
    test_def

# Registers a zero-argument test callable.
#
# # Parameters
#
# `name` is the reporting name and defaults to `str(func)`. `tags` is an
# iterable of strings; order and duplicates are preserved. `func` is supplied
# implicitly when this function is used as a decorator.
#
# # Returns
#
# Returns `func`, or a decorator awaiting it when `func` is omitted.
#
# # Example
#
# ```
# #[test name: "connects" tags: ["integration", "linux"]]
# def connects_to_service()
#   connect()
# ```
pub def test
  :name = nil
  :tags = []
  func = nil
do
  if (func == nil)
    return do |func| test name: $name tags: $tags $func
  let tag_values = []
  for tag = tags
    if !(type tag Str)
      throw std.TypeError "test tags: expected strings"
    tag_values.push $tag

  let test_def = to_test_def $func
  let base_name = (name || str(test_def.func))

  if (test_def.params.len == 0)
    collect_key.value.add $base_name $tag_values $test_def.func
    return func

  let combos = [[{}, [], []]]
  for axis_name axis_values = test_def.params
    let next = []
    for combo = combos
      let kwargs extra_tags name_parts = combo
      for pv = axis_values
        let new_kwargs = {...kwargs}
        new_kwargs[axis_name] = pv.value
        # `/` is stripped so a stringified value can't split the registered
        # name across what `--filter` treats as path segments.
        let value_part = str(pv.value).replace("/", "_")
        next.push [new_kwargs, [...extra_tags, ...pv.tags], [...name_parts, "$axis_name=$value_part"]]
    combos = next

  for combo = combos
    let kwargs extra_tags name_parts = combo
    let case_name = "$base_name[$(",".join(name_parts))]"
    let case_tags = [...tag_values, ...extra_tags]
    let case_func = do test_def.func(...kwargs)
    collect_key.value.add $case_name $case_tags $case_func

  func

# Registers one or more parametrize axes on a test. Each keyword argument
# names an axis under which its value is passed to the decorated test
# function (and to any fixture that declares it). Stacks with other
# `parametrize` decorators, and composes freely with `#[fixture]`
# decorators; the cartesian product is taken over every axis registered by
# any application.
#
# Because decorators apply bottom-to-top, axes accumulate in
# closest-to-`def`-first order (axes from one decorator are ordered as
# written); this only affects generated case names
# (`$base_name[$axis1=$v,$axis2=$v,...]`), not correctness.
#
# # Parameters
#
# Each keyword argument's value is an iterable of raw values and/or
# `tagged(value, ...tags)` wrappers for that axis.
#
# # Example
#
# ```
# #[test]
# #[parametrize backend: [sqlite_conn, tagged(postgres_conn, "slow")]]
# def connects :backend
#   backend.ping()
# ```
pub def parametrize func = nil ...axes
  if (func == nil)
    return do |func| parametrize $func ...axes
  let test_def = to_test_def $func
  for name values = axes
    if !(type name Sym)
      throw std.UnexpectedPos $name
    if (values.len == 0)
      throw std.ValueError "parametrize: '$name' has no values"
    test_def.params.push [name, [...values.map(normalize_param_value)]]
  test_def

# Adds tags to tests subsequently registered in the current module.
#
# Repeated calls accumulate tags. Module tags precede tags supplied directly
# to `test`; order and duplicates are preserved.
#
# # Parameters
#
# `values` are the string tags to add.
#
# # Example
#
# ```
# tags "integration" "linux"
#
# #[test tags: ["slow"]]
# def connects()
#   connect()
# ```
pub def tags ...values
  let tag_values = []
  for tag = values.pos_only()
    if !(type tag Str)
      throw std.TypeError "test tags: expected strings"
    tag_values.push $tag
  collect_key.value.add_tags $tag_values

pub class Assert: std.RuntimeError
  pub field message = nil

  def (init) self message
    std.RuntimeError.(init) $self
      if (message != nil)
        "assertion failed: $message"
      else
        "assertion failed"
    self.message = message

# Exception thrown to skip a test case.
#
# Throw this (or call `skip()`) from a test function to mark it as skipped
# rather than failed.
pub class Skip: std.RuntimeError
  # Skip message, or `nil` is none specified
  pub field message = nil

  def (init) self message = nil
    std.RuntimeError.(init) $self
      if (message != nil)
        "test skipped: $message"
      else
        "test skipped"
    self.message = message

# Skip the current test with an optional message.
pub def skip msg = nil
  throw Skip $msg

# Assert that `cond` is truthy, throwing an error with optional `msg` on failure.
pub def assert cond msg = nil
  if !cond
    throw Assert $msg

# Assert that `cond` is falsy, throwing an error with optional `msg` on failure.
pub def assert_not cond msg = nil
  if cond
    throw Assert $msg

# Assert that `left == right`, throwing an error with optional `msg` on failure.
pub def assert_eq left right msg = nil
  if (left != right)
    if msg
      throw Assert "${left:?} == ${right:?}: $msg"
    else
      throw Assert "${left:?} == ${right:?}"

# Assert that `left != right`, throwing an error with optional `msg` on failure.
pub def assert_ne left right msg = nil
  if (left == right)
    if msg
      throw Assert "${left:?} != ${right:?}: $msg"
    else
      throw Assert "${left:?} != ${right:?}"

# Assert that `block` throws an error of `type`, throwing an error with optional `msg`
# otherwise.  The caught error is returned for further inspection if desired.
pub def assert_throws type :str = nil :msg = nil block
  try
    block()
  catch type: e
    if (str != nil && std.str e != str)
      if msg
        throw Assert "$msg (error str ${std.str(e):?} == ${str:?})"
      else
        throw Assert "error str ${std.str(e):?} == ${str:?}"
    return e
  if msg
    throw Assert "$msg ($type thrown)"
  else
    throw Assert "$type thrown"

# Assert that `value` is of type `expected` (including a subtype), throwing an
# error with optional `msg` otherwise.
pub def assert_type expected value msg = nil
  if !(type value expected)
    if msg
      throw Assert "$msg (${value:?} @ $(type value) <: $expected)"
    else
      throw Assert "${value:?} @ $(type value) <: $expected"

# Discovers and runs tests under the trailing file and directory paths.
#
# # Parameters
#
# `jobs` and `module_jobs` limit concurrent tests and modules. `filter` is a
# predicate receiving a `TestInfo` and defaults to accepting every test.
# `timeout` is the per-test and module-load timeout in seconds. `capture`
# captures output and shows it for failures. `paths` contains test files or
# directories.
#
# The bundled `dolang -m test` command retains `--filter` glob matching against
# `module/name`. Its repeatable `--tags` option splits each occurrence on
# commas: alternatives in one occurrence are ORed, while occurrences are
# ANDed. Prefix a tag with `!` to require its absence. Matching is exact and
# case-sensitive.
#
# `--tags !windows,!macos` means “not Windows OR not macOS.” Use
# `--tags !windows --tags !macos` to exclude both.
#
# # Returns
#
# Returns zero when all selected tests pass, or one when any module or test
# fails.
pub def run
  :jobs = 8
  :module_jobs = 4
  :filter = (do |_| true)
  :timeout = 600
  :capture = true
  ...paths
do
  let paths = [...paths.pos_only()]
  let harness = Harness :jobs :module_jobs :filter :timeout :capture
  let files = []
  for path = paths
    let path = Path $path
    if (path.metadata().type == :DIR:)
      files.push ...path.glob("**/*.dol")
    else
      files.push $path
  harness.run $files
