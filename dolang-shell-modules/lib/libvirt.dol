# dolang: strict
# Creates, provisions, exports, and restores libvirt domains.
#
# ## Domain Options {: #libvirt.common-domain-options }
#
# [`create`](libvirt.create), [`with`](libvirt.with), and
# [`build`](libvirt.build) take the keyword arguments
# [`DomainOptions`](libvirt.DomainOptions) lists.
#
# Exactly one of `image`, `bundle`, and `installer` is required.
#
# ### `bundle` {: #libvirt.create-bundle }
#
# A bundle produced by [`Domain.export`](libvirt.Domain.export): a ZIP holding
# the domain's flattened disk and a manifest of the configuration that goes with
# it. Restoring one skips provisioning entirely — no seed, no cloud-init, no
# payload install — so the domain is ready as soon as it accepts SSH, and the
# steps then run as usual.
#
# A bundle already supplies `os`, `arch`, `user`, `dolang`, and `init`, so
# passing any of them with `bundle` is an error. The SSH key a bundle's guest
# trusts is the one generated for the `app` it was exported under, so `app`
# must match; a mismatch is an error rather than a guest that never accepts a
# connection.
#
# ### `installer` {: #libvirt.create-installer }
#
# Install media for a guest that has no cloud image to lay an overlay over. The
# disk starts blank and Setup writes it, driven by an unattended answer file
# this module generates and puts on a provisioning disc of its own, alongside
# the guest payload. Only `os: :WINDOWS:` installs this way.
#
# The first `installer` is what the domain boots; any others are attached in
# the order given, for media split across more than one disc. `drivers` media
# is read by Setup and never booted — attach the virtio driver ISO here,
# without which Setup does not see a virtio disk at all — and is an error
# without `installer`.
#
# ```
# libvirt.create
#   installer:
#     source: ./Win11_24H2_English_x64.iso
#     edition: Windows 11 Pro
#   drivers: ./virtio-win.iso
#   os: :WINDOWS:
# ```
#
# What `create` returns is a guest sitting in **audit mode** with a working
# sshd and VFS, and nothing else. Windows Update, hibernation and trim policy,
# account removal, and `sysprep /generalize` are all decisions with no single
# right answer, so they are the caller's, expressed as
# [steps](libvirt.create-steps).
#
# `init` is an error here: it names cloud-init provisioning semantics, and an
# unattended install has no cloud-init. The host needs `swtpm`, `swtpm_setup`,
# and one of `xorrisofs` or `mkisofs`, all checked before anything is defined.
#
# ## Steps {: #libvirt.create-steps }
#
# `add` and `run` options, and the bare positional item `reboot`, are steps.
# They run after the guest accepts SSH, in the order written, including repeats
# and interleaving:
#
# ```
# libvirt.create
#   installer: ./Win11_24H2_English_x64.iso
#   drivers: ./virtio-win.iso
#   os: :WINDOWS:
#   run: do
#     run powercfg /h off
#   reboot
#   run: do
#     run defrag "C:" /L
# ```
#
# `reboot` reboots the guest and waits for it. Power state belongs to this
# module: a step must reboot with `reboot` rather than rebooting the guest
# itself, and must not shut the guest down — `build` does that, and a step that
# powers the guest off is an error rather than a case that is tolerated.
# `reboot` is also the only place a lost connection is not an error; a guest
# that vanishes during a `run` block propagates.

import _shell _vfs base64 digest json proc progress rand shell shlex ssh std strand sys tar term time transfer xdg xml @yaml zip
  fs:
    - Path
    - with_temp_dir
    - @BaseFile
  url:
    - Url
  _vm.cloud_init: cloud_init
  _vm.unattend: unattend
  _vm.common:
    - capture
    - cli
  _vm.cloud_init:
    - READY_PATH
  _vm.provision:
    - BOOTSTRAP_CMD
    - WINDOWS_ROOT
    - WINDOWS_VFS_COMMAND
  fs.unix:
    - @Mode

# A file this module fetches: a bare source, or a source with an
# `algorithm:hex` digest to verify it against.
#
# A `Path` source is verified in place. A `Url` is downloaded, verified, and
# cached, and a previously verified digest-pinned entry is returned without
# contacting the server.
#
# ```
# libvirt.create
#   image:
#     source: https://example.com/disk.qcow2
#     digest: blake3:0123...
#   os: :LINUX:
# ```
pub @let ArtifactSpec = $
  | Str
  | Path
  | Url
  | BaseDict $
      source: (Str | Path | Url)
      ?digest: Str

# Install media, as an artifact spec that may also select an edition.
#
# Multi-edition media otherwise stops to ask which edition to install, which on
# an unattended install means stopping for good. `edition` selects one by name,
# such as `"Windows 11 Pro"`, and `index` by position in the media's image
# list; they are alternatives.
pub @let InstallerSpec = $
  | Str
  | Path
  | Url
  | BaseDict $
      source: (Str | Path | Url)
      ?digest: Str
      ?edition: Str
  | BaseDict $
      source: (Str | Path | Url)
      ?digest: Str
      ?index: Int

# A file to write into the guest, from an artifact or as direct content.
#
# `chmod` is a Unix file mode, and is rejected for a guest provisioned by
# unattended install.
pub @let AddSpec = $
  | BaseDict $
      target: Str
      source: ArtifactSpec
      ?chmod: (Int | Mode)
  | BaseDict $
      target: Str
      content: (Str | Bin)
      ?chmod: (Int | Mode)

# A file for cloud-init to write during early boot. `owner`, `append`, and
# `defer` are passed to cloud-init's `write_files`.
pub @let InitAddSpec = $
  | BaseDict $
      target: Str
      source: ArtifactSpec
      ?chmod: (Int | Mode)
      ?owner: Str
      ?append: Bool
      ?defer: Bool
  | BaseDict $
      target: Str
      content: (Str | Bin)
      ?chmod: (Int | Mode)
      ?owner: Str
      ?append: Bool
      ?defer: Bool

# Boot-time provisioning, interpreted by cloud-init on the guest's first boot,
# before any steps. Each key may repeat.
#
# | Key        | Description                                              |
# | ---------- | -------------------------------------------------------- |
# | `add`      | Writes a file                                            |
# | `run`      | Runs a command, split with `shlex` when given as a `Str` |
# | `packages` | Installs guest packages                                  |
pub @let InitSpec = BaseDict $
  *add: InitAddSpec
  *run: (Str | BaseArray[Str])
  *packages: (Str | BaseArray[Str])

# The Do build to install into a guest.
#
# Do is installed into every guest: `dolang-vfs` is the transport `with`,
# `upload`, and `download` run over, and an unattended install has no guest at
# all without it. This selects *which* build, not whether; when omitted, it is
# the release matching this interpreter's version.
#
# | Value                   | Installs                                    |
# | ----------------------- | ------------------------------------------- |
# | a `Str`, e.g. `"v0.1.1"` | The release with that version tag          |
# | `{version: tag}`        | The same, spelled explicitly                |
# | a `Path` or `Url`       | The given release archive                   |
# | a dictionary spec       | The given release archive, digest-pinned    |
pub @let DolangSpec = $
  | Str
  | Path
  | Url
  | BaseDict $
      version: Str
  | BaseDict $
      source: (Str | Path | Url)
      ?digest: Str

# A host cache mode for the domain disk. The hypervisor's own default, which
# honors guest flushes, applies when none is given. A `Str` is matched
# ignoring case.
#
# | Value            | Behavior                                              |
# | ---------------- | ----------------------------------------------------- |
# | `:NONE:`         | `O_DIRECT`; no host page cache, guest flushes honored |
# | `:WRITEBACK:`    | Host page cache, guest flushes honored                |
# | `:WRITETHROUGH:` | Host page cache, every write flushed                  |
# | `:DIRECTSYNC:`   | `O_DIRECT` and every write flushed                    |
# | `:UNSAFE:`       | Host page cache, guest flushes **ignored**            |
#
# `:UNSAFE:` loses the disk's contents if the host or the domain dies
# uncleanly, since nothing the guest wrote is guaranteed to have reached
# storage until the domain shuts down. That is a fair trade for a disposable
# build domain — dropping flushes removes them from the critical path, and
# files written and deleted within one run need never reach storage at all —
# but it is not a safe default for a domain whose disk matters.
pub @let DiskCache = $
  | :NONE:
  | :WRITEBACK:
  | :WRITETHROUGH:
  | :DIRECTSYNC:
  | :UNSAFE:
  | Str

# A disk I/O submission mode. Defaults to `:IO_URING:`. A `Str` is matched
# ignoring case.
#
# | Value        | Behavior                                                                 |
# | ------------ | ------------------------------------------------------------------------ |
# | `:IO_URING:` | `io_uring`; needs QEMU 6.0+ on a 5.1+ kernel                             |
# | `:THREADS:`  | Thread pool                                                              |
# | `:NATIVE:`   | Linux AIO; only asynchronous with `cache:` `:NONE:` or `:DIRECTSYNC:`    |
#
# An older host fails at domain start rather than falling back, so select
# `:THREADS:` there. `:NATIVE:` needs `O_DIRECT` to be asynchronous; paired
# with a cache mode that uses the host page cache it quietly degrades to
# blocking submission.
pub @let DiskIo = (:IO_URING: | :THREADS: | :NATIVE: | Str)

# qcow2 compression for an exported disk.
#
# | Value    | Behavior                                                          |
# | -------- | ----------------------------------------------------------------- |
# | `true`   | Compress with the default algorithm, currently `:ZSTD:`           |
# | `:ZSTD:` | zstd; needs QEMU 5.1+ to read the result                          |
# | `:ZLIB:` | zlib; readable by any QEMU, and around nine times slower to write |
# | `false`  | No compression                                                    |
#
# The disk is compressed rather than its ZIP member. It stays compressed when
# extracted into the image store, where it backs every domain laid over it.
pub @let Compress = (Bool | :ZSTD: | :ZLIB:)

# A readiness probe.
@let Probe = $
  # `dolang-vfs` runs, which is what `with` needs
  | :VFS:
  # sshd accepts a connection
  | :SSH:
  # cloud-init has written its ready file
  | :CLOUD_INIT:
# A medium attached as a cdrom, and its UEFI boot order if it boots.
@let Medium = (path: Path, boot: (Int | nil))
# A firmware variable store and its format, as `dumpxml` reports them.
@let NvramSource = (path: Path, format: (Str | nil))
@let Attrs = BaseDict[Sym | Str, Str]

# A domain's state.
pub @let DomainState = $
  | :RUNNING:
  | :IDLE:
  | :PAUSED:
  | :IN_SHUTDOWN:
  | :SHUTOFF:
  | :CRASHED:
  | :PMSUSPENDED:
  | :BLOCKED:

# Guest firmware, as a profile selects it.
@let Firmware = (:BIOS: | :EFI_SECURE:)

# A guest vTPM model.
@let TpmModel = :CRB_2_0:

# Domain options and steps, as keyword arguments and positional items in
# order. Those marked `*` may repeat.
pub @let DomainOptions[I, O] = $
  # Base disk image, optionally gzip-, xz-, or zstd-compressed
  ?image: ArtifactSpec
  # Bundle written by [`Domain.export`](libvirt.Domain.export)
  ?bundle: ArtifactSpec
  # Install media to boot
  *installer: InstallerSpec
  # Driver media read by Setup
  *drivers: ArtifactSpec
  # Domain name; generated when omitted
  ?name: Str
  # Guest OS
  ?os: sys.Os
  # Guest CPU architecture; defaults to and must match the host
  ?arch: sys.Arch
  # Cache and data namespace; derived from `shell.program` by default
  ?app: Str
  # Guest user to create
  ?user: Str
  # Do build to install
  ?dolang: DolangSpec
  # Guest memory in MiB; defaults to the bundle or OS value
  ?memory: Int
  # Guest vCPU count; defaults to the bundle or OS value
  ?vcpus: Int
  # Disk size; defaults to the OS value, while a bundle keeps its size
  ?disk_size: Str
  # Disk host cache mode
  ?cache: DiskCache
  # Disk I/O submission mode
  ?io: DiskIo
  # libvirt connection URI
  ?connect_uri: Str
  # Early boot provisioning
  ?init: InitSpec
  # Seconds to wait for the guest; defaults to the OS timeout
  ?wait_timeout: (Int | Float)
  # [Step](libvirt.create-steps): uploads a file
  *add: AddSpec
  # [Step](libvirt.create-steps): runs a block in the guest VFS, with the
  # strand input and output of the caller
  *run: ((<I, >O) -> Value)
  # [Step](libvirt.create-steps): reboots the guest
  *"reboot"

# One step, in the order `create` runs them.
@let Step[I, O] = (Add | :REBOOT: | ((<I, >O) -> Value))

let VM_NAMESPACE = "https://github.com/dolang-org/dolang"
let DEFAULT_CONNECT_URI = "qemu:///session"
# The `sd*` targets attachable media is assigned, in order. The SATA
# controller a q35 machine gets by default has six ports, and nothing here
# needs more than an installer, a driver disc and a provisioning disc.
let MEDIA_TARGETS = ["sda", "sdb", "sdc", "sdd"]

# Windows install media prints "Press any key to boot from CD or DVD" and falls
# through to the next boot device if nothing is pressed. On a first boot the
# next device is a blank disk, so the firmware lands in its boot manager and
# waits there forever. The prompt's window is a few seconds somewhere in the
# first half minute of a boot whose length varies with the host, so the only
# answer that does not involve rewriting multi-gigabyte media is to hold a key
# across the whole of it.
#
# `F9` is deliberate. It must be a real keystroke — a bare modifier is not one,
# since UEFI's `ReadKeyStroke` never reports modifier-only presses, so the
# prompt ignores it — and it must be inert everywhere else it can land, because
# the loop is still running while the next screen comes up. `F9` is unbound in
# the OVMF boot manager, in the Windows boot manager (`F8` is advanced boot
# options) and in Setup (`F3` quits). `Enter` satisfies the prompt too, but it
# activates whatever a later screen has focused.
let BOOT_KEY = "KEY_F9"
let BOOT_KEY_INTERVAL = 0.25
let BOOT_KEY_PRESSES = 80

# Programs the unattended-install path shells out to that the cloud-init path
# does not. Checked before anything is defined, so a missing one is reported by
# name rather than as a libvirt rejection at domain start.
let WINDOWS_PROGRAMS = ["swtpm", "swtpm_setup"]

# The libvirt that first understands `<tpm><backend><source>`, as
# `major * 1000000 + minor * 1000 + patch`. See `require_tpm_source`.
let TPM_SOURCE_VERSION = 10010000

# Set to keep a failed domain, its workdir and its NVRAM instead of removing
# them. An unattended install that goes wrong is diagnosable only from what it
# left behind, and reproducing one costs a full reinstall.
let KEEP_FAILED_VAR = "DOLANG_LIBVIRT_KEEP_FAILED"

# The provisioning disc's volume label. Setup finds `autounattend.xml` by
# scanning the media attached to the machine rather than by label, so this is
# only what identifies the disc in the guest and in `dumpxml`.
let PROVISION_LABEL = "DOPROV"

# ISO authoring programs, in preference order. `cloud-localds` already shells
# out to one of these on the cloud-init path, so neither is a new dependency.
let ISO_PROGRAMS = ["xorrisofs", "mkisofs"]

# directory. `unattend.xml` is the redacted one — Setup replaces every password
# with a placeholder — but `unattend-original.xml` beside it is the verbatim
# answer file, so they all go. `UnattendGC` is OOBE's own directory and should
# not exist on a guest that resealed straight into audit mode; it is listed
# anyway, because a path that is not there costs nothing and a copy left behind
# would not announce itself.
let UNATTEND_COPIES = $
  - "Panther\\unattend.xml"
  - "Panther\\unattend-original.xml"
  - "Panther\\UnattendGC\\unattend.xml"
  - "System32\\Sysprep\\unattend.xml"

# Host cache modes for the domain disk, spelled as libvirt spells them.
let DISK_CACHE_MODES = Set $
  - none
  - writeback
  - writethrough
  - directsync
  - unsafe

# Disk I/O submission modes, likewise.
let DISK_IO_MODES = Set $
  - threads
  - native
  - io_uring

# `io_uring` is the best-performing submission mode and needs QEMU 6.0+ on a
# 5.1+ kernel, which any currently supported host satisfies. An older host
# fails at domain start rather than falling back, so `io:` can select a
# different mode.
let DEFAULT_DISK_IO @ DiskIo = :IO_URING:
let PORT_START = 20000
let PORT_END = 60000
let PORT_ATTEMPTS = 10
let READY_SLEEP = 2.5
let STATE_SLEEP = 0.5
# How long a `reboot` step waits for the guest to stop answering before it gives
# up on seeing it go and starts waiting for it to come back. Generous, because a
# Windows guest can spend minutes on "configuring updates" with sshd still up,
# and overrunning it costs only a message.
let REBOOT_GONE_TIMEOUT = 300
let PAYLOAD_PATH = "/var/tmp/dolang-payload.tar.gz"
let DOLANG_REPO = "dolang-org/dolang"

# A bundle is a ZIP holding a JSON manifest describing the domain, plus one
# file per state member the domain cannot be reconstituted without: always the
# flattened qcow2 disk, and — for a guest whose firmware or TPM holds anything
# — the EFI variable store and the vTPM state directory as a tar. `version` is
# the manifest's first key because this format will change.
let BUNDLE_VERSION = 1
let MANIFEST_MEMBER = "manifest.json"
let DISK_MEMBER = "disk.qcow2"
let NVRAM_MEMBER = "nvram.bin"
let TPM_MEMBER = "tpm.tar"
let BUNDLE_CHUNK = (1024 * 1024)
# The manifest is the one member read whole, and a bundle behind a URL is an
# untrusted input, so its size is bounded.
let MANIFEST_LIMIT = (1024 * 1024)
let DIGEST_ALGORITHM = "blake3"

let DOLANG_PLATFORMS = Set $
  - x86_64-linux
  - x86_64-windows
  - aarch64-macos
  - x86_64-freebsd

# `virsh domstate` spells this state `shut off`, with the space, so the
# unspelled `shutoff` never matches it — but it is what a caller would write,
# and mapping both costs nothing.
let DOMAIN_STATES @ Dict[Str, DomainState] = $
  "running": :RUNNING:
  "idle": :IDLE:
  "paused": :PAUSED:
  "in shutdown": :IN_SHUTDOWN:
  "shut off": :SHUTOFF:
  "shutoff": :SHUTOFF:
  "crashed": :CRASHED:
  "pmsuspended": :PMSUSPENDED:
  "blocked": :BLOCKED:

# Normalizes a libvirt state word into a symbol, or returns it as reported when
# it is not one this module knows.
def normalized_state text @ Str -> (DomainState | Str)
  let text = text.trim()
  DOMAIN_STATES.get $text.lower() default: $text

# Raised when a requested libvirt domain does not exist.
#[final]
pub class NoDomainError: std.RuntimeError
  # The domain name.
  pub field name @ Str

  def (init) self name @ Str
    self.name = name
    std.RuntimeError.(init) $self "libvirt domain does not exist: $name"

def virsh connect_uri @ Str *args @ Value -> Str
  cli virsh --quiet --connect $connect_uri ...args

def capture_virsh connect_uri @ Str stderr @ Array[Str] *args @ Value -> Str
  capture virsh $stderr --quiet --connect $connect_uri ...args

def error_text lines @ Array[Str] -> Str
  "\n".join(lines).upper()

def missing_domain_error lines @ Array[Str] -> Bool
  let text = error_text $lines
  (text.contains "DOMAIN NOT FOUND" ||
    text.contains "FAILED TO GET DOMAIN" ||
    text.contains "NO DOMAIN WITH MATCHING NAME")

def address_in_use_error lines @ Array[Str] -> Bool
  let text = error_text $lines
  (text.contains "ADDRESS ALREADY IN USE" ||
    text.contains "FAILED TO BIND" && text.contains "PORT")

def require_name name @ Str -> Str
  if (name == "" || name == "." || name == ".." ||
      name.contains("/") || name.contains("\\"))
    throw std.ValueError "invalid libvirt domain name: $name"
  name

def require_os os @ (sys.Os | nil) -> sys.Os
  if (os == nil)
    throw std.ValueError "os: is required"
  os

# The machine shape and provisioning style a guest OS needs.
#
# This class is the shape a cloud image expects: a plain BIOS machine with a
# serial console, provisioned by cloud-init on first boot. `WindowsProfile`
# below is the one guest that needs something else, and it is written as the
# difference rather than as a second full set of answers — which is also the
# readable statement of what an unattended Windows install actually costs.
#
# `machine:`, `firmware:` and `tpm:` override what this OS would choose today.
# They are how a bundle keeps the machine shape it was built as: a disk that
# was installed against UEFI and a TPM must not be redefined without them
# because the profile has since moved on. Nothing else here is overridable —
# graphics, sizing and provisioning style are host policy, not something the
# restored disk depends on.
class Profile
  # The machine shape: what the domain document has to say to make a guest of
  # this OS boot at all.
  pub field machine @ (Str | nil) = nil
  pub field firmware @ Firmware = :BIOS:
  pub field tpm @ (TpmModel | nil) = nil
  pub field smm hyperv graphics @ Bool = false
  pub field serial @ Bool = true
  pub field clock_offset @ Str = "utc"
  # How long the guest takes to come up, and whether its install media has a
  # prompt that has to be answered to get there.
  pub field boot_key @ Bool = false
  pub field wait_timeout @ Int = 900
  # The defaults `create` sizes the guest with, each overridable per domain.
  pub field memory @ Int = 2048
  pub field vcpus @ Int = 2
  pub field disk_size @ Str = "20G"

  def (init)
    self
    :machine @ (Str | nil) = nil
    :firmware @ (Firmware | nil) = nil
    :tpm @ (TpmModel | nil) = nil
  do
    self.machine = machine
    if (firmware != nil)
      self.firmware = firmware
    self.tpm = tpm

  # Whether a guest of this shape is installed from media rather than
  # provisioned by cloud-init on a disk somebody else built.
  pub def unattended _self -> Bool
    false

  # Rejects a host that cannot define a guest of this shape — or, with
  # `installing:`, cannot install one.
  #
  # The two are separate because a restored bundle is not held to the second
  # set: its guest was installed on whatever host exported it, so the ISO
  # authoring and vTPM setup programs an install shells out to need not be
  # here. What it does still need is a libvirt that can be told where to keep
  # the vTPM state it is restoring.
  pub def require_host self :installing @ Bool = false
    if (self.tpm != nil)
      require_tpm_source()
    if (installing && self.unattended())
      require_programs $WINDOWS_PROGRAMS
      require_iso_program()
    nil

# What Windows 11 needs on top of that, and nothing else.
#
# It refuses to install without q35, UEFI with secure boot, and a TPM 2.0, and
# its own floor is 4 GiB of memory, two CPUs and a 64 GB disk. Those sizes are
# that floor, not a recommendation: a build guest should raise them with
# `memory:`/`vcpus:`/`disk_size:`, exactly as the FreeBSD guests already do.
class WindowsProfile: Profile
  def (init)
    self
    :machine @ (Str | nil) = nil
    :firmware @ (Firmware | nil) = nil
    :tpm @ (TpmModel | nil) = nil
  do
    Profile.(init) $self
      machine: (machine || "q35")
      firmware: (firmware || :EFI_SECURE:)
      tpm: (tpm || :CRB_2_0:)
    # What each of these buys is at the element it emits, in `to_xml`.
    self.smm = true
    self.hyperv = true
    self.graphics = true
    self.serial = false
    self.boot_key = true
    # `localtime` is the usual answer for a Windows guest, because Windows
    # reads the RTC as local time. It is the wrong one here: the unattend pins
    # the guest to UTC, so an RTC holding the *host's* local time is read as
    # UTC and the guest boots however far the host is from it — for hours,
    # until `w32time` reaches the network and corrects it. Both ends agree on
    # UTC instead, which also makes the guest clock independent of where the
    # host happens to be. Set explicitly, inheriting the same value, so that
    # the deliberate part is not mistaken for a default nobody considered.
    self.clock_offset = "utc"
    self.memory = 4096
    self.disk_size = "64G"
    # An unattended install is measured in tens of minutes, not minutes.
    self.wait_timeout = 3600

  pub def unattended _self -> Bool
    true

# The profile `os` calls for, with any recorded overrides applied. The one
# place an OS is mapped to a shape; everything downstream reads the profile.
def os_profile
  os @ sys.Os
  :machine @ (Str | nil) = nil
  :firmware @ (Firmware | nil) = nil
  :tpm @ (TpmModel | nil) = nil
do -> Profile
  if (os == :WINDOWS:)
    WindowsProfile :machine :firmware :tpm
  else
    Profile :machine :firmware :tpm


# Rejects a host program the requested configuration needs but cannot find.
def require_programs programs @ Array[Str]
  for program = programs
    if !run[program].which()
      throw std.RuntimeError "$program is required but was not found on PATH"

# Rejects a libvirt too old to be told where to keep a vTPM's state.
#
# `<tpm><backend><source>` arrives in libvirt 10.10.0. An older one parses the
# document, ignores the element, and keeps the state in a directory of its own
# choosing under its state root — so the domain starts, the guest sees a TPM,
# the install succeeds, and the loss surfaces much later as an `export` that
# silently omits the vTPM and a restore that refuses the bundle for not having
# one. Checking here costs a `virsh --version` and turns that into an error
# before the install is paid for.
#
# An unparseable version is taken as new enough: this is an early report of a
# known-bad host, not a gate, and the export-time behavior is unchanged either
# way.
def require_tpm_source()
  let text = cli virsh --version
  let version = try
    let value = 0
    for part = text.trim().split(".").take(3)
      value = (value * 1000 + int(part))
    value
  catch _
    return nil
  if (version < TPM_SOURCE_VERSION)
    let found = text.trim()
    throw std.RuntimeError "libvirt 10.10.0 or newer is required for a guest with a vTPM, but this host has $found"
  nil

# Picks the ISO authoring program to build the provisioning disc with, in
# `ISO_PROGRAMS` order. Unlike `require_programs` any one of them will do, so
# the report names the whole set.
def require_iso_program -> Str
  for program = ISO_PROGRAMS
    if run[program].which()
      return program
  throw std.RuntimeError "one of $(", ".join(ISO_PROGRAMS)) is required but was not found on PATH"

# Defaults `arch` to the host's, and rejects any other.
#
# `DomainConfig.to_xml` emits `<domain type="kvm">` with a `host-passthrough`
# CPU, both of which require the guest architecture to match the host — a
# foreign one needs TCG emulation, plus a machine type and firmware chosen per
# target. Rejecting it here reports the unsupported argument instead of letting
# libvirt refuse the document with an error about KVM.
def require_arch arch @ (sys.Arch | nil) -> sys.Arch
  let host = sys.cpu_info().arch
  let arch = (arch || host)
  if (arch != host)
    throw std.ValueError "arch: must be the host architecture $host, got $arch"
  arch

# qcow2 compression algorithms, spelled as `qemu-img`'s `compression_type`
# spells them.
#
# `zstd` compresses an image about nine times faster than `zlib` for the same
# size, and decompresses fast enough that a compressed image stays practical as
# a backing file, where every guest read pays for it. It needs QEMU 5.1+ to
# write *and to read*, so `zlib` remains available for an image destined for an
# older reader — the same tradeoff `io:`'s `:IO_URING:` default already makes
# for QEMU 6.0+.
let DISK_COMPRESSION = Set $
  - zstd
  - zlib

let DEFAULT_COMPRESSION @ Compress = :ZSTD:

# Converting with several coroutines and unordered writes is what makes
# compression bearable: it cuts a compressed conversion to a ninth of the time
# a serial one takes, and the destination is always a file this module is
# creating fresh, which is the case unordered writes are safe for.
let CONVERT_PARALLEL = ["-m", "16", "-W"]

# Normalizes a `compress:` option to a `qemu-img compression_type`, or `nil`
# for an uncompressed conversion. `true` selects the default algorithm.
def require_compression compress @ Compress -> (Str | nil)
  if (compress == nil || compress == false)
    return nil
  if (compress == true)
    compress = DEFAULT_COMPRESSION
  let text = str(compress).lower()
  if !DISK_COMPRESSION.contains(text)
    throw std.ValueError "compress: unsupported value: $compress"
  text

# Normalizes a disk `cache:`/`io:` option to its libvirt attribute spelling.
#
# The symbol vocabulary is libvirt's own value set, so lowercasing the name is
# the whole mapping (`:IO_URING:` becomes `io_uring`); a `Str` is accepted as
# written. Checking the value here reports a typo as a Do error naming the
# argument, instead of letting libvirt reject the whole document over one
# attribute.
def require_disk_mode value@(Sym | Str | nil) allowed@Set[Str] name@Str -> (Str | nil)
  if (value == nil)
    return nil
  let text = str(value).lower()
  if !allowed.contains(text)
    throw std.ValueError "$name: unsupported value: $value"
  text

def normalized_app app @ (Str | nil) -> Str
  let candidate = (app || shell.program || "dolang-libvirt")
  let value = if (type candidate Path)
    (candidate.stem || candidate.name || "")
  else
    str $candidate
  let value = value.replace("/", "_").replace("\\", "_")
  if (value == "" || value == "." || value == "..")
    throw std.ValueError "libvirt app name must not be empty"
  value

def data_root app @ Str -> Path
  let root = (xdg.data_home() / app / "libvirt")
  root.create_dir all: true
  root

def file_digest path @ Path -> Str
  let state = digest.Blake3()
  path.open buffer: false do |file|
    for chunk = file
      state.update $chunk
  "${state.digest():x}"

def find_child node@xml.Element tag@Str :namespace@(Str | nil) = nil -> (xml.Element | nil)
  for child = node.children
    if (type child xml.Element &&
        child.tag == tag &&
        child.namespace == namespace)
      return child
  nil

def require_child node@xml.Element tag@Str :namespace@(Str | nil) = nil -> xml.Element
  let child = find_child $node $tag :namespace
  if !child
    throw std.ValueError "missing XML element: $tag"
  child

def node_text node @ xml.Element -> Str
  let text = ""
  for child = node.children
    if (type child Str)
      text = "$text$child"
  text

def metadata_value metadata@xml.Element name@Str -> (Str | nil)
  let node = find_child $metadata $name
  if node
    node_text $node
  else
    nil

def path_within path@(Path | nil) root@Path -> Bool
  while path
    if (path == root)
      return true
    path = path.parent
  false

# `virsh undefine`, taking the NVRAM with it where this libvirt understands the
# flag. In the `virsh` family rather than a `Domain` method because both the
# public handle and the half-built domain `create` is still assembling need it,
# and neither can reach the other's privates. `quiet:` discards what a failure
# printed, for a caller that is cleaning up after an error already reported.
def virsh_undefine connect_uri@Str name@Str :quiet@Bool = false
  try
    capture_virsh $connect_uri [] undefine $name --nvram
  catch proc.Error: _
    if quiet
      capture_virsh $connect_uri [] undefine $name
    else
      virsh $connect_uri undefine $name
  nil

let CHUNK_SIZE = (512 * 1024)
let PARALLEL = 8

def copy_chunks total@Int input@BaseFile output@BaseFile indicator@progress.Indicator
  strand.pipeline
    do strand.pool $PARALLEL (Range 0 total CHUNK_SIZE) do |offset|
      let chunk = input.read $CHUNK_SIZE :offset
      strand.put [offset, chunk]
    do strand.pool $PARALLEL $strand.input() do |item|
      # Pipeline stages are unchecked; the first stage puts these pairs
      let offset chunk = (item @ (Int, Bin))
      output.write $chunk :offset
      indicator.delta $chunk.len

def payload_directory user @ Str -> Str
  "/home/$(user)/.dolang-libvirt-guest"

# Collects console output as plain text.
class Transcript: term.Console
  field buffer @ StrBuf

  def (init) self buffer @ StrBuf
    self.#buffer = buffer
    term.Console.(init) $self

  pub def write self *data @ (Str | Bin) -> Int
    let written = 0
    for piece = data
      let text = Str $piece
      self.#buffer.append $text
      written = (written + text.len)
    written

  pub def flush _self
    nil

# How to reach a managed domain's guest over SSH.
#
# These are exactly the facts `create` records in the domain's `<dolang:vm>`
# metadata, so the metadata is this class's serialized form — see
# `guest_from_metadata`.
#
# Two transports use them. `exec` and `install_payload` drive the `ssh` and
# `scp` binaries directly, which is what bootstrap has to do: `dolang-vfs`
# does not exist in the guest until the payload is installed. Once it does,
# `with` runs blocks through the VFS instead.
#[final]
class Guest
  # The forwarded SSH port. Public because `create` reassigns it while hunting
  # for a free one.
  pub field port @ Int
  # What the most recent failed probe in `wait` wrote to the console, or `nil`
  # if the last attempt succeeded. Public so that whoever bounded the wait can
  # show it when the wait is what ran out.
  pub field probe_output @ (Str | nil) = nil
  field user @ Str
  field identity known_hosts @ Path
  field command @ Str

  def (init)
    self
    :port @ Int
    :user @ Str
    :identity @ Path
    :known_hosts @ Path
    :command @ Str
  do
    self.port = port
    self.#user = user
    self.#identity = identity
    self.#known_hosts = known_hosts
    self.#command = command

  # The `ssh`/`scp` options every direct connection to the guest shares.
  #
  # Host key checking is `accept-new` rather than `no` so that a key change
  # after first contact is still an error.
  def options self -> Array[Str]
    $
      -o IdentitiesOnly=yes -o BatchMode=yes -o StrictHostKeyChecking=accept-new
      -o UserKnownHostsFile=$self.#known_hosts

  # Runs `command` in the guest over `ssh` as `cli` runs a host program,
  # returning its standard output.
  def exec self command @ Str -> Str
    let flags = self.#options()
    cli ssh -T -e none -a ...flags
      -l $self.#user -p $self.port -i $self.#identity
      -- 127.0.0.1 $command

  # Polls `probe` until it succeeds.
  #
  # It polls forever: a guest that never comes up is bounded by the
  # `time.timeout` `create` wraps the wait in, which is also what turns the
  # failure into a message naming the console screenshot.
  # Each attempt's console output is captured rather than printed. A guest
  # that is not listening yet produces one `ssh` complaint per attempt, and a
  # Windows install polled for an hour under a progress display would be
  # nothing but those. The last one is kept in `probe_output` instead, where a
  # wait that ran out of time can report it.
  def wait self probe @ (() -> Value)
    while true
      let output = StrBuf()
      # An SSH transport that is not up yet fails as a nonzero `ssh` exit; a
      # VFS that cannot be reached over one fails as a `sys.Error`.
      try
        term.capture (Transcript output) do
          probe()
        self.probe_output = nil
        return
      catch proc.Error: _
        self.probe_output = output.freeze().trim()
        time.sleep $READY_SLEEP
      catch sys.Error: _
        self.probe_output = output.freeze().trim()
        time.sleep $READY_SLEEP

  # The probe `probe` names, as the function the waits below poll. It raises if
  # the guest does not answer, and prints why to the console for the caller to
  # capture.
  #
  # | Value          | Answers when |
  # | -------------- | ------------------------------------------------------ |
  # | `:VFS:`        | `dolang-vfs` runs, which is what `with` needs |
  # | `:SSH:`        | sshd accepts a connection |
  # | `:CLOUD_INIT:` | cloud-init has written its ready file |
  #
  # `:VFS:` is the strongest: a guest whose sshd is up but whose `dolang-vfs`
  # is missing or unrunnable is not ready for anything this module does with
  # it. `:SSH:` runs `true`, which is a command on a Unix guest and nothing at
  # all under Windows OpenSSH's `cmd.exe`, so it is only usable on a guest
  # whose VFS does not exist yet — exactly the cloud-init path, where the
  # payload is installed over SSH after the wait returns.
  def probe_for self probe @ Probe -> (() -> Value)
    match probe
      :VFS: do
        do self.with do
          nil
      :CLOUD_INIT: do
        do self.#exec "test -f $(shlex.quote READY_PATH)"
      :SSH: do
        do self.#exec "true"

  # Waits until the guest answers the probe `probe` names.
  pub def wait_for self probe @ Probe
    self.#wait $ self.#probe_for $probe

  # Waits until the guest stops answering it instead — the near side of a
  # reboot, whose far side is `wait_for` again.
  pub def wait_gone self probe @ Probe
    let probe = self.#probe_for $probe
    while true
      let output = StrBuf()
      try
        term.capture (Transcript output) do
          probe()
      catch proc.Error: _
        return
      catch sys.Error: _
        return
      time.sleep $READY_SLEEP

  # Copies one local file into the guest with `scp`.
  pub def send self source@Path destination@Str
    let flags = self.#options()
    cli scp -q ...flags
      -P $self.port -i $self.#identity
      -- $source "$(self.#user)@127.0.0.1:$destination"
    nil

  # Copies one file out of the guest with `scp`. The counterpart to `send`.
  pub def fetch self source@Str destination@Path
    let flags = self.#options()
    cli scp -q ...flags
      -P $self.port -i $self.#identity
      -- "$(self.#user)@127.0.0.1:$source" $destination
    nil

  # Copies `payload` into the guest and unpacks it.
  pub def install_payload self payload @ Path
    self.send $payload $PAYLOAD_PATH
    let dir = shlex.quote (payload_directory self.#user)
    let archive = shlex.quote $PAYLOAD_PATH
    self.#exec "mkdir -p $dir && tar -xzf $archive -C $dir && rm -f $archive"
    nil

  # Runs `block` in the guest's VFS context, in `cd:` and with `env:` applied
  # to the environment.
  pub def with[R]
    self
    block @ (() -> R)
    :cd @ (Str | Path | nil) = nil
    :env @ BaseDict[Str | Sym, Value] = {}
  do -> R
    ssh.with 127.0.0.1 $block
      user: $self.#user
      port: $self.port
      identity: $self.#identity
      known_hosts: $self.#known_hosts
      command: [self.#command]
      host_key: :ACCEPT_NEW:
      batch: true
      identities_only: true
      if (cd != nil)
        cd: $cd
      :env

  # The `<dolang:vm>` elements recording how to reach this guest — the form
  # `guest_from_metadata` reads back.
  pub def to_metadata self -> Array[xml.Element]
    $
      $ xml.Element ssh_port (str self.port)
      $ xml.Element ssh_user $self.#user
      $ xml.Element ssh_identity (str self.#identity)
      $ xml.Element ssh_known_hosts (str self.#known_hosts)
      $ xml.Element vfs_command $self.#command

# Reads a `Guest` out of a domain's `<dolang:vm>` metadata subtree, which is
# where `create` recorded it.
def guest_from_metadata metadata @ (xml.Element | nil) -> Guest
  if !metadata
    throw std.ValueError "domain has no dolang:vm metadata"
  let port = metadata_value $metadata ssh_port
  let user = metadata_value $metadata ssh_user
  let identity = metadata_value $metadata ssh_identity
  let known_hosts = metadata_value $metadata ssh_known_hosts
  let command = metadata_value $metadata vfs_command
  if (port == nil || user == nil || identity == nil ||
      known_hosts == nil || command == nil)
    throw std.ValueError "domain has incomplete dolang:vm metadata"
  Guest
    port: $int(port)
    :user
    identity: $Path(identity)
    known_hosts: $Path(known_hosts)
    :command

# Everything that describes a domain to be created, with the libvirt XML
# document as its serialized form.
#
# Grouping these means `create` decides each one once and then hands over a
# single value, instead of threading a dozen positional arguments through to
# the emitter. It also makes the port-retry loop a mutate-and-re-emit rather
# than a re-derivation of the whole document.
#[final]
class DomainConfig
  pub field name @ Str
  # The `Guest` this domain will be reachable as, whose `port` `create`
  # reassigns between definition attempts.
  pub field guest @ Guest
  field profile @ Profile
  field memory vcpus @ Int
  field overlay workdir @ Path
  field media @ Array[Medium]
  field nvram tpm_state @ (Path | nil)
  field nvram_format @ (Str | nil)
  field os @ sys.Os
  field arch @ sys.Arch
  field disk_boot @ (Int | nil)
  field app @ Str
  field cache io @ (Str | nil)

  # `source` carries everything about the guest that is not a property of this
  # host or this run: what OS and architecture it is, what disk and media it
  # boots, what it is reachable as, and — for a restored bundle — the machine
  # shape and sizing it was built with. `memory:` and `vcpus:` are the caller's
  # overrides on top of that; everything else is where this domain's files go.
  def (init)
    self
    :name @ Str
    :source @ Source
    :overlay @ Path
    :app @ Str
    :workdir @ Path
    :identity @ Path
    :nvram @ (Path | nil) = nil
    :tpm_state @ (Path | nil) = nil
    :memory @ (Int | nil) = nil
    :vcpus @ (Int | nil) = nil
    :cache @ (DiskCache | nil) = nil
    :io @ (DiskIo | nil) = DEFAULT_DISK_IO
  do
    self.name = require_name $name
    self.#os = source.os
    self.#arch = source.arch
    let profile = source.profile
    self.#profile = profile
    # The caller's override, then what a restored bundle was built with, then
    # what this OS calls for.
    self.#memory = (memory || source.memory || profile.memory)
    self.#vcpus = (vcpus || source.vcpus || profile.vcpus)
    self.#app = app
    self.#workdir = workdir
    # Built here rather than handed in: everything it needs is either on the
    # source or derived from the work directory, and the port is this class's
    # to reassign when libvirt refuses the one it picked.
    self.guest = Guest
      port: (rand.int PORT_START PORT_END)
      user: $source.user
      identity: $identity.absolute()
      known_hosts: $((workdir / "known_hosts").absolute())
      command: $source.command
    # Every path this document names is made absolute here rather than trusted
    # as given. QEMU resolves a disk source in its own working directory, not
    # in the caller's, so a relative one — an `installer:` named as
    # `./win11.iso`, say — is reported at domain start as a storage file that
    # does not exist, naming a path that plainly does.
    self.#overlay = overlay.absolute()
    # A domain reconstituted from a bundle has no media: it was provisioned
    # once, before it was exported, so there is no seed for cloud-init to read
    # and no installer left to boot.
    let media @ Array[Medium] = []
    for :path :boot = source.media
      media.push (path: path.absolute(), :boot)
    if (media.len > MEDIA_TARGETS.len)
      throw std.ValueError "at most $(MEDIA_TARGETS.len) media may be attached"
    self.#media = media
    self.#nvram = (nvram != nil && nvram.absolute() || nil)
    self.#nvram_format = source.nvram_format
    self.#tpm_state = (tpm_state != nil && tpm_state.absolute() || nil)
    if (profile.firmware == :EFI_SECURE: && nvram == nil)
      throw std.ValueError "nvram: is required for os: $(self.#os)"
    if (profile.tpm != nil && tpm_state == nil)
      throw std.ValueError "tpm_state: is required for os: $(self.#os)"
    # UEFI boot ordering is per device: the media that installs the guest boots
    # first, and the disk it writes boots after it, so that the same domain
    # boots the finished install once Setup is done with the media. A BIOS
    # profile keeps `<boot dev="hd">` instead, which libvirt will not accept
    # alongside per-device orders.
    self.#disk_boot = nil
    if (profile.firmware == :EFI_SECURE:)
      let last = 0
      for path: _ :boot = media
        if (boot != nil && boot > last)
          last = boot
      self.#disk_boot = (last + 1)
    self.#cache = require_disk_mode $cache $DISK_CACHE_MODES cache
    self.#io = require_disk_mode $io $DISK_IO_MODES io

  # The `<os>` element: firmware selection, and on a BIOS profile the boot
  # device.
  def os_node self -> xml.Element
    let Element = xml.Element
    let profile = self.#profile
    let secure = (profile.firmware == :EFI_SECURE:)
    # `firmware="efi"` asks libvirt to pick a loader satisfying the requested
    # features rather than naming one, so the document does not encode this
    # host's OVMF paths. libvirt fills in the loader, the NVRAM template and
    # both formats on define; `dumpxml` is what reports which it chose.
    let os_attrs @ Attrs = $
      if secure
        firmware: efi
    let machine = profile.machine
    let type_attrs @ Attrs = $
      arch: $str(self.#arch).lower()
      if (machine != nil)
        machine: $machine
    # `format` is written only when restoring a variable store this module
    # exported, where the file already exists and libvirt has no template to
    # infer its format from. On a fresh define it is left out, so libvirt picks
    # the template and reports both formats in `dumpxml` — which is where the
    # exported format came from in the first place.
    let format = self.#nvram_format
    let nvram_attrs @ Attrs = $
      if (format != nil)
        :format
    Element os attrs: $os_attrs
      $ Element type hvm attrs: $type_attrs
      if secure
        $ Element firmware
          $ Element feature attrs: {enabled: "yes", name: "secure-boot"}
          $ Element feature attrs: {enabled: "yes", name: "enrolled-keys"}
        $ Element nvram (str self.#nvram) attrs: $nvram_attrs
      else
        $ Element boot attrs: {dev: "hd"}

  # The domain's disks: the overlay, then each attached medium as a cdrom.
  def disk_nodes self overlay_driver @ Attrs -> Array[xml.Element]
    let Element = xml.Element
    let overlay = Element disk attrs: {type: "file", device: "disk"}
      $ Element driver attrs: $overlay_driver
      $ Element source attrs: {file: str(self.#overlay)}
      $ Element target attrs: {dev: "vda", bus: "virtio"}
      if (self.#disk_boot != nil)
        $ Element boot attrs: {order: str(self.#disk_boot)}
    let nodes @ Array[xml.Element] = [overlay]
    let index = 0
    for :path :boot = self.#media
      let cdrom = Element disk attrs: {type: "file", device: "cdrom"}
        $ Element driver attrs: {name: "qemu", type: "raw"}
        $ Element source attrs: {file: str(path)}
        $ Element target attrs: {dev: MEDIA_TARGETS[index], bus: "sata"}
        $ Element readonly
        if (boot != nil)
          $ Element boot attrs: {order: str(boot)}
      nodes.push $cdrom
      index = (index + 1)
    nodes

  # The libvirt domain document for this configuration.
  pub def to_xml self -> xml.Element
    # Locally aliased so the tree below reads like the XML it emits.
    let Element = xml.Element
    let profile = self.#profile
    let machine = profile.machine
    let tpm = profile.tpm
    let cache = self.#cache
    let io = self.#io

    # Only the overlay carries the tuning options: media is a read-only ISO
    # read once at boot, so its driver has nothing to gain from them.
    let overlay_driver @ Attrs = $
      name: "qemu"
      type: "qcow2"
      # Without `discard`, qemu advertises no discard feature to the guest at
      # all, so a guest that does trim its filesystem has the request dropped
      # before qcow2 ever sees it. `detect_zeroes` (which requires `discard`)
      # additionally turns a written run of zeroes into the same unmap, so the
      # zero-fill fallback guests without a batch trim need actually frees
      # clusters rather than merely writing bytes that compress well.
      #
      # Unmapping a cluster in an overlay cannot expose the backing image
      # underneath: qcow2 records a zero cluster and frees the host cluster, so
      # the guest still reads zeros and `export` still flattens correctly.
      discard: "unmap"
      detect_zeroes: "unmap"
      if (cache != nil)
        :cache
      if (io != nil)
        :io

    Element domain attrs: {type: "kvm"}
      $ Element name $self.name
      $ Element memory (str self.#memory) attrs: {unit: "MiB"}
      $ Element vcpu (str self.#vcpus)
      $ self.#os_node()
      $ Element features
        $ Element acpi
        $ Element apic
        # Windows 11 checks for a secure boot capable machine, and without SMM
        # the firmware cannot protect the variable store that makes it one.
        # libvirt starts the domain regardless; it is Setup that refuses.
        if profile.smm
          $ Element smm attrs: {state: "on"}
        # Without the Hyper-V enlightenments a Windows guest burns host CPU in
        # its own spinlocks and idles badly enough to look hung.
        if profile.hyperv
          $ Element hyperv
            $ Element relaxed attrs: {state: "on"}
            $ Element vapic attrs: {state: "on"}
            $ Element spinlocks attrs: {state: "on", retries: "8191"}
            $ Element vpindex attrs: {state: "on"}
            $ Element synic attrs: {state: "on"}
            $ Element stimer attrs: {state: "on"}
      $ Element cpu attrs: {mode: "host-passthrough"}
      # Windows keeps the hardware clock in local time and, left on the default
      # timer set, drifts badly enough for Setup and for TLS afterwards.
      $ Element clock attrs: {offset: profile.clock_offset}
        if profile.hyperv
          $ Element timer attrs: {name: "rtc", tickpolicy: "catchup"}
          $ Element timer attrs: {name: "pit", tickpolicy: "delay"}
          $ Element timer attrs: {name: "hpet", present: "no"}
          $ Element timer attrs: {name: "hypervclock", present: "yes"}
      $ Element on_poweroff destroy
      $ Element on_reboot restart
      $ Element on_crash destroy
      $ Element devices
        ...self.#disk_nodes(overlay_driver)
        $ Element interface attrs: {type: "user"}
          $ Element backend attrs: {type: "passt"}
          $ Element model attrs: {type: "virtio"}
          $ Element portForward attrs: {proto: "tcp", address: "127.0.0.1"}
            $ Element range attrs: {start: str(self.guest.port), to: "22"}
        if profile.serial
          $ Element serial attrs: {type: "pty"}
            $ Element target attrs: {port: "0"}
          $ Element console attrs: {type: "pty"}
            $ Element target attrs: {type: "serial", port: "0"}
        # Windows has no serial console worth reading, so the graphical one is
        # the only way to see an install stopped at a dialog. `vga` needs no
        # driver from the virtio media to be legible during Setup, and without
        # an absolute-positioning tablet the pointer is unusable over VNC.
        if profile.graphics
          $ Element graphics attrs: {type: "vnc", autoport: "yes", listen: "127.0.0.1"}
          $ Element video
            $ Element model attrs: {type: "vga"}
          $ Element input attrs: {type: "tablet", bus: "usb"}
        if (tpm != nil)
          $ Element tpm attrs: {model: "tpm-crb"}
            $ Element backend attrs: {type: "emulator", version: "2.0"}
              # libvirt launches swtpm as the session user and lets it keep its
              # state here, so the vTPM lives and dies with the workdir like
              # everything else `undefine` does not remove.
              $ Element source attrs: {type: "dir", path: str(self.#tpm_state)}
      $ Element metadata
        $ Element vm namespace: $VM_NAMESPACE namespaces: {dolang: VM_NAMESPACE}
          $ Element managed "true"
          $ Element app $self.#app
          $ Element workdir (str self.#workdir)
          # `os` is not recoverable from the document libvirt hands back and
          # `arch` only as an attribute of `<os><type>`, so both are recorded
          # here for `Domain.export` to put in a bundle manifest.
          $ Element os (str(self.#os).lower())
          $ Element arch (str(self.#arch).lower())
          $ Element memory (str self.#memory)
          $ Element vcpus (str self.#vcpus)
          # Recorded so a restored bundle takes its machine shape from what it
          # was built as, rather than from whatever `Profile` says today.
          if (machine != nil)
            $ Element machine $machine
          $ Element firmware (str(profile.firmware).lower())
          if (tpm != nil)
            $ Element tpm (str(tpm).lower())
          ...self.guest.to_metadata()

# A read-only view over a libvirt domain document.
#
# `virsh dumpxml` returns libvirt's own expansion of whatever was defined — a
# generated uuid, PCI addresses, filled-in defaults, rewritten devices — so
# this reads back only the parts we wrote and can still recognize. It is
# deliberately not the inverse of the document `create` emits: there is no
# faithful parse of an expanded document back into a configuration, so none is
# offered.
class DomainXml
  field document @ xml.Element

  def (init) self document @ xml.Element
    self.#document = document

  # The `<name>` text, validated as a usable domain name.
  pub def name self -> Str
    if (self.#document.tag != "domain")
      throw std.ValueError "expected a libvirt <domain> document"
    let node = require_child $self.#document name
    let name = node_text(node).trim()
    require_name $name

  # The `<dolang:vm>` subtree `create` writes, or `nil` for a domain this
  # module did not create.
  def vm self -> (xml.Element | nil)
    for node = self.#document.traverse()
      if (type node xml.Element &&
          node.tag == "vm" &&
          node.namespace == VM_NAMESPACE)
        return node
    nil

  # The guest's SSH connection facts. Throws if the domain is not one of ours
  # or its metadata is incomplete.
  pub def guest self -> Guest
    guest_from_metadata $self.#vm()

  # The `<source file=...>` of the first disk with the given `device`.
  def disk_source self device @ Str -> (Str | nil)
    let devices = find_child $self.#document devices
    if !devices
      return nil
    for disk = devices.children
      if (type disk xml.Element &&
          disk.tag == "disk" &&
          disk.attrs.get("device") == device)
        let source = find_child $disk source
        if source
          return source.attrs.get "file"
    nil

  # The firmware variable store: where libvirt keeps it and, from libvirt's own
  # expansion of the definition, what format it wrote it in. `nil` for a domain
  # with no `<nvram>` at all.
  #
  # The format matters because it is not guessable: this host's secure-boot
  # template is a qcow2, but a raw one is equally legal, and a restored
  # varstore attached without saying which is read wrong.
  pub def nvram_source self -> (NvramSource | nil)
    let os = find_child $self.#document os
    if !os
      return nil
    let node = find_child $os nvram
    if !node
      return nil
    let path = node_text(node).trim()
    if (path == "")
      return nil
    (path: Path(path).absolute(), format: node.attrs.get("format"))

  # The vTPM's state directory, or `nil` for a domain with no TPM.
  pub def tpm_state self -> (Path | nil)
    let devices = find_child $self.#document devices
    if !devices
      return nil
    let tpm = find_child $devices tpm
    if !tpm
      return nil
    let backend = find_child $tpm backend
    if !backend
      return nil
    let source = find_child $backend source
    if (!source || source.attrs.get("type") != "dir")
      return nil
    let path = source.attrs.get "path"
    if (path == nil)
      return nil
    Path(path).absolute()

  # Every file-backed disk source, in document order.
  pub def disk_sources self -> Array[Str]
    let sources @ Array[Str] = []
    let devices = find_child $self.#document devices
    if !devices
      return sources
    for disk = devices.children
      if (type disk xml.Element &&
          disk.tag == "disk" &&
          disk.attrs.get("device") == "disk")
        let source = find_child $disk source
        if source
          let path = source.attrs.get "file"
          if (path != nil)
            sources.push $path
    sources

  # The `<dolang:vm>` facts a bundle manifest records: everything about the
  # guest that the disk image itself does not carry.
  #
  # `os`, `arch`, `memory`, and `vcpus` were only written from the version of
  # this module that grew `Domain.export`, so a domain defined by an older one
  # is reported as unexportable rather than silently exported with holes in its
  # manifest.
  pub def bundle_info self -> BundleInfo
    let metadata = self.#vm()
    if !metadata
      throw std.ValueError "domain has no dolang:vm metadata"
    let app = metadata_value $metadata app
    let os = metadata_value $metadata os
    let arch = metadata_value $metadata arch
    let memory = metadata_value $metadata memory
    let vcpus = metadata_value $metadata vcpus
    let user = metadata_value $metadata ssh_user
    let command = metadata_value $metadata vfs_command
    if (app == nil || os == nil || arch == nil || memory == nil ||
        vcpus == nil || user == nil || command == nil)
      let message = "domain metadata predates bundle export; recreate the domain to export it"
      throw std.ValueError $message
    # The machine shape, recorded so that a restored bundle is defined as what
    # it was built as. Absent from a domain defined before the module emitted
    # them, which restores under whatever its OS profile says today — the same
    # behavior that domain was created with.
    (
      :app, :os, :arch, :user, :command,
      machine: metadata_value(metadata, "machine"),
      firmware: metadata_value(metadata, "firmware"),
      tpm: metadata_value(metadata, "tpm"),
      memory: int(memory),
      vcpus: int(vcpus),
    )

  # The work directory of a domain this module manages, or `nil` if the domain
  # is not ours or its recorded paths fail validation.
  #
  # Every condition here is a guard against removing something we did not
  # create: the domain must claim to be managed, its overlay must sit directly
  # in the recorded work directory, and that directory must live under the XDG
  # data home.
  pub def managed_workdir self -> (Path | nil)
    let metadata = self.#vm()
    if !metadata
      return nil
    let workdir = metadata_value $metadata workdir
    let managed = metadata_value $metadata managed
    let source = self.#disk_source("disk")
    if (managed != "true" || workdir == nil || source == nil)
      return nil
    let workdir = Path(workdir).absolute()
    let source = Path(source).absolute()
    if (source.parent != workdir)
      return nil
    if !path_within(workdir, xdg.data_home().absolute())
      return nil
    workdir

  # The domain's single file-backed disk, which is what any export flattens.
  pub def export_source self -> Path
    let sources = self.disk_sources()
    if (sources.len != 1)
      throw std.ValueError "expected exactly one file-backed domain disk; found $(sources.len)"
    Path(sources[0]).absolute()

  # Validates an export destination against the domain's own files: it must not
  # be the disk being exported, must not sit inside the managed work directory
  # (which `undefine` removes wholesale), and must not already exist.
  pub def export_destination self destination@(Str | Path) source@Path -> Path
    let destination = Path(destination).absolute()
    if (source == destination)
      throw std.ValueError "export destination is the domain disk"
    let workdir = self.managed_workdir()
    if (workdir && path_within(destination, workdir))
      throw std.ValueError "export destination is inside the managed domain work directory"
    if destination.exists()
      throw std.ValueError "export destination already exists: $destination"
    let parent = (destination.parent || Path ".")
    parent.create_dir all: true
    destination

  # The document `create` emitted for this domain, which it left in the work
  # directory, or `nil` if it is not there to read.
  #
  # A manifest records it as an escape hatch for anything the structured fields
  # do not model yet. `virsh dumpxml` output is deliberately not used in its
  # place: that is libvirt's expansion of the definition — a generated uuid,
  # filled-in defaults, rewritten devices — rather than what this module wrote.
  pub def generated_xml self -> (Str | nil)
    let workdir = self.managed_workdir()
    if !workdir
      return nil
    let path = (workdir / "domain.xml")
    if !path.exists()
      return nil
    path.read_str()

# Everything a domain can be asked to do, including the parts `create_domain`
# needs and a caller has no business calling.
#
# Do has no module-private class members: `pub` is the only visibility that
# module-level code like `create_domain` can reach, so a single class would
# have to publish its own scaffolding — `send_key`, `add`, the waits — as API.
# The public `Domain` below is a facade over this one, and forwards exactly
# what is meant to be API. Nothing here is documented, because this class is
# not `pub`.
#[final]
class DomainImpl
  pub field name @ Str
  pub field connect_uri @ Str
  # The `Guest` read out of `<dolang:vm>`, cached — see `guest`.
  field guest_handle @ (Guest | nil) = nil

  def (init) self name@Str connect_uri@Str
    self.name = require_name $name
    self.connect_uri = connect_uri

  # How to reach this domain's guest, out of the metadata `create_domain`
  # recorded.
  #
  # Read once and kept: none of it changes after the domain is defined, and a
  # `dumpxml` per attempt would make polling for the guest expensive.
  def guest self -> Guest
    let cached = self.#guest_handle
    if (cached != nil)
      return cached
    let guest = self.#xml().guest()
    self.#guest_handle = guest
    guest

  # Parses the domain's current libvirt XML.
  pub def dumpxml self -> xml.Element
    let stderr @ Array[Str] = []
    let source = try
      capture_virsh $self.connect_uri $stderr dumpxml $self.name
    catch proc.Error: e
      if missing_domain_error $stderr
        throw NoDomainError $self.name
      echo $"\n".join(stderr)
      throw e
    (xml.decode source).root

  # A view over the domain's current libvirt XML.
  def xml self -> DomainXml
    DomainXml $self.dumpxml()

  # Runs `virsh domstate`, mapping a missing domain onto `NoDomainError`.
  def domstate self *options @ Str -> Str
    let stderr @ Array[Str] = []
    try
      capture_virsh $self.connect_uri $stderr domstate ...options $self.name
    catch proc.Error: e
      if missing_domain_error $stderr
        throw NoDomainError $self.name
      throw e

  # Returns the normalized libvirt state.
  pub def state self -> (DomainState | Str)
    normalized_state $self.#domstate()

  # The domain's state together with libvirt's reason for it, as
  # `virsh domstate --reason` reports the pair — for example
  # `shut off (destroyed)` becomes `:SHUTOFF:` and `"destroyed"`.
  #
  # The reason is runtime state rather than a property of the definition, so it
  # reads back as `"unknown"` after libvirtd restarts.
  def state_reason self -> (state: (DomainState | Str), reason: Str)
    let text = self.#domstate("--reason").trim()
    let parts = [...text.split "(" limit: 1]
    let state = normalized_state $parts[0]
    let reason = if (parts.len > 1)
      parts[1].replace(")", "").trim()
    else
      "unknown"
    (:state, :reason)

  # Starts the domain.
  pub def start self
    virsh $self.connect_uri start $self.name
    nil

  # Force-stops the domain without undefining it.
  pub def destroy self
    virsh $self.connect_uri destroy $self.name
    nil

  # Requests a graceful shutdown and waits until the domain is shut off.
  pub def shutdown self
    progress.show message: "shut down $(self.name)" icon: ⏻ do |_|
      let state = self.state()
      if (state != :SHUTOFF:)
        if (state != :IN_SHUTDOWN:)
          if !(state == :RUNNING: || state == :BLOCKED: || state == :IDLE:)
            throw std.StateError "cannot gracefully shut down domain in state $state"
          self.#request_shutdown()
        while (self.state() != :SHUTOFF:)
          time.sleep $STATE_SLEEP

  # Asks the guest to shut down, through libvirt and nothing else.
  def request_shutdown self
    virsh $self.connect_uri shutdown $self.name
    nil

  # Asks the guest to reboot, without waiting for it to come back: what "back"
  # means is the caller's probe, not the domain's state, which never leaves
  # `:RUNNING:` across a reboot. `reboot_ready` is the form that waits.
  pub def reboot self
    let state = self.state()
    if !(state == :RUNNING: || state == :BLOCKED: || state == :IDLE:)
      throw std.StateError "cannot reboot domain in state $state"
    virsh $self.connect_uri reboot $self.name
    nil

  # Writes a screenshot of the domain's graphical console to `destination`,
  # which is created along with any missing parent directories.
  pub def screenshot self destination @ (Str | Path) -> Path
    let destination = Path(destination).absolute()
    let parent = destination.parent
    if parent
      parent.create_dir all: true
    # QEMU dumps the console as PNG for the video models this module emits,
    # whatever the file it is asked to write is called.
    virsh $self.connect_uri screenshot $self.name --file $destination
    destination

  # Sends a keystroke to the domain's console, as `virsh send-key` does.
  #
  # A domain that is rebooting or shutting down refuses the keystroke; that is
  # not an error here, because the point of `repeat:` is to cover a window
  # whose position is not known and which the guest may pass through partway.
  pub def send_key
    self
    # Linux keycode name, such as `"KEY_F9"`.
    key @ Str
    # Number of times to send the key.
    :repeat @ Int = 1
    # Seconds between key presses.
    :interval @ (Int | Float) = nil
  do
    for press = 0..repeat
      if (press > 0 && interval != nil)
        time.sleep $interval
      try
        capture_virsh $self.connect_uri [] send-key $self.name --codeset linux $key
      catch proc.Error: _
        nil

  # Waits until the domain's guest answers, under a deadline.
  #
  # A wait that runs out prints what it can — the console screenshot, if asked
  # for one, and whatever the last probe complained about — and then throws.
  # Both are printed rather than folded into the error: the last complaint is
  # not always one line, and `std.TimedOutError` is a more useful thing to
  # catch than a message.
  #
  # ## Errors
  #
  # | Error           | Condition |
  # | --------------- | ---------------------------------------------- |
  # | `TimedOutError` | The guest did not answer within `timeout` |
  # | `ValueError`    | The domain has no `dolang:vm` metadata |
  pub def wait_ready
    self
    # Readiness probe.
    #
    # `:VFS:` proves the transport `with` runs over. `:SSH:` proves only that
    # sshd accepts a connection, which is all a guest has before its payload is
    # installed.
    :probe @ Probe = :VFS:
    # Seconds to wait; unbounded when
    # omitted.
    :timeout @ (Int | Float | nil) = nil
    # Directory for a console dump when
    # the wait expires.
    #
    # The dump is named for the domain and the moment the wait gave up, so
    # successive runs do not overwrite each other's evidence. Capture is best
    # effort: a guest with no graphics has no console to dump, and a capture
    # failure does not replace the timeout.
    :screenshot_dir @ (Str | Path | nil) = nil
  do
    let guest = self.#guest()
    try
      if (timeout == nil)
        guest.wait_for $probe
      else
        # `time.timeout` does interrupt a `run` blocked in `ssh`, so the bound
        # covers the whole wait rather than only the gaps between attempts.
        time.timeout $timeout do
          guest.wait_for $probe
    catch std.TimedOutError: e
      echo "$(self.name) was not reachable within $timeout seconds"
      if (screenshot_dir != nil)
        let shot = try
          let stamp = int(time.DateTime.now().unix_secs)
          self.screenshot (Path(screenshot_dir) / "$(self.name)-$stamp.png")
        catch _
          nil
        if shot
          echo "console screenshot written to $shot"
      # Whatever the last attempt complained about, which the poll captured
      # rather than printing once per attempt.
      let last = guest.probe_output
      if last
        echo $last
      throw e

  # Reboots the guest and waits for it to come back, under the same deadline
  # and with the same probe as any other wait. Takes `wait_ready`'s arguments.
  #
  # Both halves of the reboot are waited out. `virsh reboot` returns as soon as
  # the request is delivered and the domain never leaves `:RUNNING:`, so
  # without waiting for the guest to *stop* answering this would find one that
  # still answers, conclude the reboot was over, and go on talking to a machine
  # that was still on its way down.
  #
  # The disappearance is bounded separately and generously: a guest that never
  # stops answering has not started rebooting, and the reason for that is worth
  # reporting as a timeout of its own rather than folding into the wait for it
  # to return.
  pub def reboot_ready
    self
    :probe @ Probe = :VFS:
    :timeout @ (Int | Float | nil) = nil
    :screenshot_dir @ (Str | Path | nil) = nil
  do
    progress.show message: "reboot guest" icon: 🔁 do |_|
      self.reboot()
      try
        time.timeout $REBOOT_GONE_TIMEOUT do
          self.#guest().wait_gone $probe
      catch std.TimedOutError: _
        let name = self.name
        echo "$name was still answering $REBOOT_GONE_TIMEOUT seconds after being asked to reboot"
    progress.show message: "wait for guest" icon: ☕ do |_|
      self.wait_ready :probe :timeout :screenshot_dir

  # Refuses a domain that is not shut off, or that reached `SHUTOFF` any way
  # other than a guest shutdown.
  #
  # A killed domain's disk is arbitrarily stale — spectacularly so under
  # `cache: :UNSAFE:`, where guest flushes are discarded outright — so an image
  # taken from one is not a gold image but a corrupted one. `force` exists
  # because libvirt forgets the reason when it restarts, reporting `"unknown"`
  # for a domain that did shut down cleanly.
  def require_clean_shutoff self force @ Bool
    let :state :reason = self.#state_reason()
    if (state != :SHUTOFF:)
      throw std.StateError "domain must be shut off before exporting its disk"
    if (!force && reason != "shutdown")
      let message = "domain did not shut down cleanly (reason: $reason); pass force: true to export anyway"
      throw std.StateError $message
  # Flattens the shut-off domain's file-backed disk into a standalone qcow2.
  pub def export_disk self destination@(Str | Path) :compress@Compress = false -> Path
    let compression = require_compression $compress
    if (self.state() != :SHUTOFF:)
      throw std.StateError "domain must be shut off before exporting its disk"
    let document = self.#xml()
    let source = document.export_source()
    let destination = document.export_destination $destination $source
    progress.show message: "export disk" icon: 💾 do |_|
      with_temp_dir parent: (destination.parent || Path(".")) do |staging|
        let temporary = (staging / "disk.qcow2")
        if compression
          cli qemu-img convert -q -c -o compression_type=$compression
            ...CONVERT_PARALLEL -O qcow2 -- $source $temporary
        else
          cli qemu-img convert -q ...CONVERT_PARALLEL -O qcow2 -- $source $temporary
        if destination.exists()
          throw std.ValueError "export destination appeared during conversion: $destination"
        temporary.rename $destination
    destination
  # Writes the bundle. See `Domain.export` for what one holds and why.
  pub def export
    self
    destination @ (Str | Path)
    :compress @ Compress = true
    :force @ Bool = false
  do -> Path
    self.#require_clean_shutoff $force
    let document = self.#xml()
    let info = document.bundle_info()
    let source = document.export_source()
    let destination = document.export_destination $destination $source
    progress.show message: "export $(self.name)" icon: 📦 do |_|
      with_temp_dir parent: (destination.parent || Path(".")) do |staging|
        let disk = (staging / DISK_MEMBER)
        self.export_disk $disk :compress
        let members @ Array[PackedMember] = []
        members.push (kind: "disk", path: disk, name: DISK_MEMBER, format: image_format(disk))
        # The firmware variable store and the vTPM state go in beside the disk.
        # Both are quiescent — `require_clean_shutoff` ran — and without them a
        # restored guest loses what it sealed into them: its boot entries, its
        # enrolled secure boot keys, and anything the TPM was holding.
        let nvram = document.nvram_source()
        if (nvram != nil)
          let :path :format = nvram
          members.push (kind: "nvram", :path, name: NVRAM_MEMBER, :format)
        let tpm = document.tpm_state()
        if (tpm != nil)
          # A directory of several files, so it travels as a tar: one member,
          # one digest, and the modes swtpm gave it preserved.
          let archive = (staging / TPM_MEMBER)
          transfer.pack $tpm $archive format: :TAR:
          members.push (kind: "tpm", path: archive, name: TPM_MEMBER, format: nil)
        let bundle = (staging / "bundle")
        write_bundle $bundle $members $info document.generated_xml()
        if destination.exists()
          throw std.ValueError "export destination appeared during export: $destination"
        bundle.rename $destination
    destination

  # Copies the guest payload archive in over SSH and unpacks it.
  #
  # Only the cloud-init path needs this: it is the one source whose guest
  # brings up sshd itself, so the VFS every other transfer runs over does not
  # exist yet. An installed or restored guest arrives with the payload already
  # on its disk.
  pub def install_payload self archive @ Path
    self.#guest().install_payload $archive

  # Performs one `add:` step, on the host VFS: uploads what `source:` resolved
  # to, or writes `content:` straight into the guest.
  #
  # The artifact was resolved before the domain existed, by `prefetch_artifacts`,
  # so the resolve here is the memo.
  pub def add self step@Add app@Str
    let resolved = step.resolve $app
    if (type resolved Path)
      return self.upload $resolved $step.target chmod: $step.chmod
    # Inline content is a config file or a script, not something a staging file
    # on the host or a progress indicator would earn their keep on.
    self.with do
      # Inside the VFS block, so `Path` builds the guest's flavor — see
      # `upload`.
      let target = Path $step.target
      target.write $resolved
      let chmod = step.chmod
      if (chmod != nil)
        target.update_metadata mode: $chmod

  # Copies one local file into the domain.
  # `chmod:` sets `dest`s mode if given
  pub def upload self source@(Str | Path) dest@(Str | Path) :chmod@(Int | Mode | nil) = nil
    let source = Path $source
    let message = (source.name || str source)
    source.open do |input|
      let total = input.metadata().size
      progress.show :message :total icon: ⬆️ units: :BYTES: do |ind|
        self.with do
          # Inside the VFS block, so `Path` builds the *guest's* flavor.
          # Normalized out here it would be the host's, and a `fs.unix.Path`
          # opened against a Windows target fails with "path cannot be
          # converted between path types".
          let target = Path $dest
          target.open w do |output|
            copy_chunks $total $input $output $ind
          if (chmod != nil)
            target.update_metadata mode: $chmod

  # Copies one file from the domain to the local VFS.
  pub def download self source@(Str | Path) dest@(Str | Path)
    let dest = Path $dest
    dest.open w do |output|
      self.with do
        # The guest's path, so built in the guest's context — see `upload`.
        let remote = Path $source
        let message = (remote.name || str remote)
        remote.open do |input|
          let total = input.metadata().size
          progress.show :message :total icon: ⬇️ units: :BYTES: do |ind|
            copy_chunks $total $input $output $ind

  # Undefines the domain and removes a validated managed overlay.
  pub def undefine self
    let workdir = self.#xml().managed_workdir()
    virsh_undefine $self.connect_uri $self.name
    if workdir
      workdir.remove all: true ignore: true

  # Runs `block` in the domain's VFS context.
  pub def with[R]
    self
    block @ (() -> R)
    :cd @ (Str | Path | nil) = nil
    :env @ BaseDict[Str | Sym, Value] = {}
  do -> R
    let guest = self.#guest()
    if (self.state() != :RUNNING:)
      throw std.ValueError "libvirt domain is not running: $(self.name)"
    guest.with $block :cd :env

# Creates, starts and provisions a domain, for `create`.
#
# Defaults live here so the public wrapper can preserve every option in the
# variadic argument stream.
def create_domain[I, O]
  :image @ ArtifactSpec = nil
  :bundle @ ArtifactSpec = nil
  :name @ Str = nil
  :os @ sys.Os = nil
  :arch @ sys.Arch = nil
  :app @ Str = nil
  :user @ Str = nil
  :dolang @ DolangSpec = nil
  :memory @ Int = nil
  :vcpus @ Int = nil
  :disk_size @ Str = nil
  :cache @ DiskCache = nil
  :init @ InitSpec = nil
  :wait_timeout @ (Int | Float) = nil
  :io @ DiskIo = DEFAULT_DISK_IO
  :connect_uri @ Str = DEFAULT_CONNECT_URI
  ...options @ DomainOptions[I, O]
  <I
  >O
do -> DomainImpl
  let :steps :installers :drivers = parse_options $options
  # Three provisioning sources, one at a time: an `image:` to lay an overlay
  # over, a `bundle:` to restore, or `installer:` media to install from.
  let given @ Array[Str] = []
  if (image != nil)
    given.push "image:"
  if (bundle != nil)
    given.push "bundle:"
  if (installers.len > 0)
    given.push "installer:"
  if (given.len == 0)
    throw std.ValueError "image:, bundle:, or installer: is required"
  if (given.len > 1)
    throw std.ValueError "$(", ".join(given)) are mutually exclusive"
  if (drivers.len > 0 && installers.len == 0)
    throw std.ValueError "drivers: is not valid without installer:"
  if (wait_timeout != nil && wait_timeout <= 0)
    throw std.ValueError "wait_timeout: expected a positive number of seconds"
  let app = normalized_app $app
  let name = require_name(name || "$app-$(rand.string 8)")
  let root = data_root $app
  let workdir = (root / "domains" / name).absolute()

  # Validated up front, before anything is defined or written, so a bad
  # argument is reported without leaving a domain behind. Each source also
  # names the artifacts it will consume, and is built from them in `prepare`
  # once they are fetched.
  let artifacts @ Array[Artifact | Add] = []
  let prepare @ ((KeyPair) -> Source) = if (bundle != nil)
    for k v = {:os, :arch, :user, :dolang, :init}
      if (v != nil)
        throw std.ValueError "$k is not valid together with bundle"
    let restored = parse_artifact $bundle
    artifacts.push $restored
    do |_keys @ KeyPair| BundleSource bundle: $restored :app :root :workdir
  else
    let os = require_os $os
    let arch = require_arch $arch
    let requested = os_profile $os
    requested.require_host installing: true
    let unattended = requested.unattended()
    if (installers.len > 0 && !unattended)
      throw std.ValueError "installer: is not valid for os: $os"
    let user = require_name (user || "ci")
    let payload = dolang_artifact $dolang $os $arch
    if unattended
      # An unattended guest installs itself from media; there is no image for
      # cloud-init to provision.
      if (image != nil)
        throw std.ValueError "image: is not valid for os: $os; use installer:"
      # `init:` names cloud-init provisioning semantics, and there is no
      # cloud-init here. The equivalent is the ordered
      # `add:`/`run:`/`reboot` step list, which runs against a guest that is
      # already up rather than against one that is still booting.
      if (init != nil)
        throw std.ValueError "init: is cloud-init provisioning; use add:/run:/reboot steps for os: $os"
      # `Domain.upload`'s `chmod:` is a Unix file mode, and there is nothing
      # for one to mean on an NTFS destination. Rejected here rather than at
      # the upload itself, which happens with the domain already up and the
      # install already paid for.
      for step = steps
        if (type step Add && step.chmod != nil)
          throw std.ValueError "add: chmod: is not supported for os: $os"
    # A bundle's disk is already sized for the guest built around it, so an
    # overlay over one inherits that size unless `disk_size:` says otherwise.
    if (disk_size == nil)
      disk_size = requested.disk_size
    if (image != nil)
      let base = parse_artifact $image
      let staged = parse_init $init
      let boot: _ :write packages: _ = staged
      artifacts.push $base
      artifacts.push $payload
      artifacts.push ...write
      do |keys @ KeyPair|
        ImageSource image: $base dolang: $payload
          :os :arch :app :user :staged :keys :root
    else
      artifacts.push $payload
      artifacts.push ...installers
      artifacts.push ...drivers
      do |keys @ KeyPair|
        InstallerSource dolang: $payload
          :installers :drivers :os :arch :user :keys :root :workdir :app

  try
    attach $name :connect_uri
    throw std.ValueError "libvirt domain already exists: $name"
  catch NoDomainError: _
    nil

  # Everything this run has to fetch, fetched now: after the checks that cost
  # nothing, and before the first thing that would have to be cleaned up.
  for step = steps
    if (type step Add)
      artifacts.push $step
  prefetch_artifacts $artifacts $app

  workdir.remove all: true ignore: true
  workdir.create_dir all: true
  # Where a wait that runs out dumps the guest console. Under the data root
  # rather than the work directory, which the failure path removes wholesale: a
  # screenshot deleted along with the domain it was taken of is no help in
  # working out what the boot stopped at.
  #
  # Only a guest with a graphical console has one to dump; the rest pass `nil`
  # and the wait skips it.
  let shots = (root / "screenshots").absolute()
  let domain = DomainImpl $name $connect_uri

  progress.show message: "create $name" icon: 🖥️ do |_|
    let succeeded = false
    try
      let keys = ensure_key $root $app
      let source = prepare $keys
      # The source's, not `os:`'s: a bundle does not supply `os:` at all, and
      # the shape it was built as is the one it has to be redefined with.
      let profile = source.profile
      let wait_seconds = (wait_timeout || profile.wait_timeout)

      let overlay = progress.show message: "create disk" icon: 💾 do |_|
        let overlay = (workdir / "disk.qcow2").absolute()
        let base = source.image
        if (base == nil)
          # An unattended install has nothing to lay an overlay over: Setup
          # partitions and writes the disk itself, from blank.
          cli qemu-img create -q -f qcow2 $overlay $disk_size
        else if (disk_size != nil)
          cli qemu-img create -q -f qcow2 -F $source.format -b $base $overlay $disk_size
        else
          cli qemu-img create -q -f qcow2 -F $source.format -b $base $overlay
        overlay

      # Both live in the workdir, which `undefine --nvram` and the failure path
      # remove wholesale, so neither outlives the domain it belongs to and two
      # domains never share one variable store. A restored bundle has already
      # written its own copies to these paths; libvirt fills in a fresh
      # variable store from its template for anything else.
      let nvram @ (Path | nil) = nil
      if (profile.firmware == :EFI_SECURE:)
        nvram = (workdir / "nvram.bin").absolute()
      let tpm_state @ (Path | nil) = nil
      if (profile.tpm != nil)
        let directory = (workdir / "tpm").absolute()
        directory.create_dir all: true
        tpm_state = directory

      let :key public: _ = keys
      let config = DomainConfig
        :name :source :overlay :app :workdir :cache :io :nvram :tpm_state
        :memory :vcpus
        identity: $key.absolute()

      progress.show message: "start domain" do |_|
        # A forwarded port is only known to be free once libvirt has bound it,
        # so a collision means re-emitting the document with a fresh one.
        let started = false
        for attempt = 0..PORT_ATTEMPTS
          if (attempt > 0)
            config.guest.port = rand.int $PORT_START $PORT_END
          # Left in the work directory, which is where `DomainXml.generated_xml`
          # reads it back at export time.
          let path = (workdir / "domain.xml")
          path.write $ xml.encode(xml.Document(config.to_xml()))
          virsh $connect_uri define $path
          let stderr @ Array[Str] = []
          try
            capture_virsh $connect_uri $stderr start $name
            started = true
          catch proc.Error: e
            try
              virsh_undefine $connect_uri $name quiet: true
            catch _
              nil
            if (!address_in_use_error(stderr) || attempt == PORT_ATTEMPTS - 1)
              echo $"\n".join(stderr)
              throw e
          if started
            break
        if !started
          throw std.RuntimeError "could not allocate a forwarded SSH port"

      # Only an install has a "press any key" prompt to answer. A restored
      # bundle boots the disk it was exported from, with no media attached at
      # all.
      if (profile.boot_key && source.media.len > 0)
        progress.show message: "boot install media" icon: ⌨️ do |_|
          domain.send_key $BOOT_KEY
            repeat: $BOOT_KEY_PRESSES
            interval: $BOOT_KEY_INTERVAL

      # The first wait is also what proves libvirt recorded the `<dolang:vm>`
      # metadata: the guest is read back out of the defined domain rather than
      # reused from the local one, so a domain that lost it fails here instead
      # of at the first `with`.
      let screenshot_dir = (profile.graphics && shots || nil)
      progress.show message: "wait for guest" icon: ☕ do |_|
        domain.wait_ready probe: $source.probe timeout: $wait_seconds :screenshot_dir
      # Whatever this source still owes the guest — copying the payload in and
      # waiting cloud-init out, finishing an unattended install, or nothing at
      # all for a bundle whose guest was provisioned before it was exported. It
      # runs before the caller's own steps, which may depend on any of it.
      source.provision $domain
      for step = steps
        match step
          Add(add) do domain.add $add $app
          :REBOOT: do
            domain.reboot_ready probe: $source.probe timeout: $wait_seconds :screenshot_dir
            continue
          block do domain.with $block
        # Power state belongs to this module. A step that took the guest down
        # is an error, not a case to tolerate — `reboot` exists precisely so
        # that no step has to — and it is said here, where the step that did it
        # is still named, rather than left to surface as the next step or the
        # export failing for a reason that looks unrelated.
        let state = domain.state()
        if !(state == :RUNNING: || state == :BLOCKED: || state == :IDLE:)
          let kind = (type step Add && "add" || "run")
          throw std.StateError "$kind: step left the domain in state $state; use the reboot step"
      succeeded = true
      domain
    finally
      if !succeeded
        if keep_failed()
          echo "$KEEP_FAILED_VAR is set: leaving domain $name and $workdir behind"
        else
          progress.show message: "clean up" icon: 🧹 do |_|
            # Every step is best effort and silent: the error that got us here
            # is the one worth reporting, and half of these are expected to
            # fail on a domain that never got as far as being defined.
            try
              if (domain.state() != :SHUTOFF:)
                capture_virsh $connect_uri [] destroy $name
            catch _
              nil
            try
              virsh_undefine $connect_uri $name quiet: true
            catch _
              nil
            workdir.remove all: true ignore: true

# References a libvirt domain by name and connection URI.
#
# Domains returned by `create` carry connection metadata used by `with`.
pub class Domain
  # Everything the domain can actually be asked to do. The members below are
  # the ones that are API; the rest of `DomainImpl` is `create`'s scaffolding.
  field impl @ DomainImpl

  # `DomainImpl` is module-private, so nothing outside this module can produce
  # one to pass: checking it here is what makes this constructor private.
  def (init) self impl @ Value
    if !(type impl DomainImpl)
      let message = "libvirt.Domain is not constructible; use create or attach"
      throw std.TypeError $message
    self.#impl = impl

  # The libvirt domain name.
  #[getter]
  pub def name obj -> Str
    obj.#impl.name

  # The libvirt connection URI the domain is defined on.
  #[getter]
  pub def connect_uri obj -> Str
    obj.#impl.connect_uri

  # Returns the domain's state. A state this module does not know is returned
  # as libvirt reports it.
  pub def state self -> (DomainState | Str)
    self.#impl.state()

  # Starts the domain.
  pub def start self
    self.#impl.start()

  # Force-stops the domain without undefining it.
  pub def destroy self
    self.#impl.destroy()

  # Requests a graceful shutdown and waits until the domain is shut off.
  pub def shutdown self
    self.#impl.shutdown()

  # Asks the guest to reboot, without waiting for it to come back: what "back"
  # means is the caller's probe, not the domain's state, which never leaves
  # `:RUNNING:` across a reboot.
  pub def reboot self
    self.#impl.reboot()

  # Flattens the shut-off domain's file-backed disk into a standalone qcow2,
  # returning the path written.
  pub def export_disk
    self
    # Image to write.
    destination @ (Str | Path)
    # qcow2 compression.
    :compress @ Compress = false
  do -> Path
    self.#impl.export_disk $destination :compress

  # Exports the shut-off domain as a bundle: its flattened disk, the firmware
  # variable store and vTPM state of a guest that has them, and the
  # configuration needed to define an equivalent domain again — none of which
  # the disk image alone carries.
  #
  # ## Errors
  #
  # | Error        | Condition |
  # | ------------ | -------------------------------------------------------- |
  # | `StateError` | The domain is not shut off, or did not shut down cleanly and `force:` was not given |
  # | `ValueError` | The domain has no `dolang:vm` metadata, does not have exactly one file-backed disk, or the destination is unusable |
  #
  # ## Example
  #
  # ```
  # domain.shutdown()
  # domain.export ./freebsd-gold.dolvm
  # domain.undefine()
  # ```
  pub def export
    self
    # Bundle to write; `.dolvm` is the
    # conventional extension.
    destination @ (Str | Path)
    # qcow2 compression.
    :compress @ Compress = true
    # Export a domain that did not shut down cleanly.
    :force @ Bool = false
  do -> Path
    self.#impl.export $destination :compress :force

  # Copies one local file into the domain.
  pub def upload
    self
    # Local file to copy.
    source @ (Str | Path)
    # Guest path to write.
    destination @ (Str | Path)
    # Mode to set on the destination, in the same VFS session as the copy.
    :chmod @ (Int | Mode) = nil
  do
    self.#impl.upload $source $destination :chmod

  # Copies one file from the domain to the local VFS.
  pub def download
    self
    # Guest file to copy.
    source @ (Str | Path)
    # Local path to write.
    destination @ (Str | Path)
  do
    self.#impl.download $source $destination

  # Undefines the domain and removes a validated managed overlay.
  pub def undefine self
    self.#impl.undefine()

  # Runs `block` in the domain's VFS context.
  #
  # ## Errors
  #
  # | Error        | Condition                     |
  # | ------------ | ----------------------------- |
  # | `ValueError` | The domain is not running     |
  #
  # ## Example
  #
  # ```
  # domain.with cd: /usr/src env: {MAKEOBJDIRPREFIX: "/tmp/obj"} do
  #   run make buildworld
  # ```
  pub def with[R]
    self
    # Block to run in the guest.
    block @ (() -> R)
    # Initial guest working directory.
    :cd @ (Str | Path) = nil
    # Environment overrides for the block. `nil` unsets a variable, and
    # `:INHERIT:` copies it from the calling context.
    :env @ BaseDict[Str | Sym, Value] = {}
  do -> R
    self.#impl.with $block :cd :env


# Attaches to an existing domain.
#
# ## Errors
#
# [`NoDomainError`](libvirt.NoDomainError) if the domain does not exist.
pub def attach
  # Domain name.
  name @ Str
  # libvirt connection URI.
  :connect_uri @ Str = DEFAULT_CONNECT_URI
do -> Domain
  let impl = DomainImpl $name $connect_uri
  # Reading the domain back is what proves it exists: a missing one raises
  # `NoDomainError` from here rather than from the caller's first real use.
  impl.dumpxml()
  Domain $impl

# One input this module has to get hold of before it can be used.
#
# Every provisioning artifact — `image:`, `bundle:`, `installer:`, `drivers:`,
# `dolang:`, an `add:` `source:` — is spelled one of two ways: a bare
# `Str`/`Path`/`Url`, or a dict naming the source under `source:` alongside
# metadata keys:
#
# ```
# image:
#   source: https://example.com/disk.qcow2
#   digest: blake3:...
# ```
#
# One shape for all of them is why there is no `image_digest:` beside `image:`
# and no `bundle_digest:` beside `bundle:`.
#
# Resolution is memoized on the instance. That is what lets `create` resolve
# every artifact in a spec up front and in parallel — see `prefetch_artifacts` —
# while the call sites that actually consume them stay written as if each
# resolved its own: the second call is the memo, not a second fetch. One that
# was never prefetched still resolves on demand, so no call site has to know
# which of the two happened.
class Artifact
  pub field source @ (Str | Path | Url)
  # `algorithm:hex`, verified against whatever `source` resolved to.
  pub field digest @ (Str | nil)
  field resolved @ (Path | nil) = nil

  def (init) self :source@(Str | Path | Url) :digest@(Str | nil) = nil
    self.source = source
    self.digest = digest

  # The fetched file.
  #
  # `app` scopes the download cache. It is a parameter rather than a field
  # because artifacts are parsed where no `app` is in scope yet; an artifact
  # belongs to one `create`, so the memo does not key on it.
  pub def resolve self app @ Str -> Path
    let resolved = self.#resolved
    if (resolved != nil)
      return resolved
    let digest = self.digest
    let path = transfer.get :app $self.source
      if (digest != nil)
        :digest
    self.#resolved = path
    path

# An `installer:`, which carries two metadata keys beyond a plain artifact's.
#
# Install media carries more than one edition, and Setup stops to ask which
# unless it is told — which on an unattended install means stopping forever.
# `edition:` names one (`Windows 11 Pro`) and `index:` selects one by position;
# they are alternatives, not a pair.
class Installer: Artifact
  pub field edition @ (Str | nil)
  pub field index @ (Int | nil)

  def (init)
    self
    :source @ (Str | Path | Url)
    :digest @ (Str | nil) = nil
    :edition @ (Str | nil) = nil
    :index @ (Int | nil) = nil
  do
    Artifact.(init) $self :source :digest
    self.edition = edition
    self.index = index

# One `add:` step: what to write, and where it lands in the guest.
#
# `payload` is the artifact a `source:` names, or the `content:` itself, which
# is why `resolve` answers with either a `Path` to fetched bytes or the bytes
# themselves. `extra` carries the cloud-init-only `owner:`/`append:`/`defer:`
# keys, which only an `init:` `add:` has.
#[final]
class Add
  pub field target @ Str
  pub field payload @ (Artifact | Str | Bin)
  pub field chmod @ (Int | nil)
  pub field extra @ Dict[Sym, (Str | Bool)]

  def (init)
    self
    :target @ Str
    :payload @ (Artifact | Str | Bin)
    :chmod @ (Int | nil)
    :extra @ Dict[Sym, (Str | Bool)]
  do
    self.target = target
    self.payload = payload
    self.chmod = chmod
    self.extra = extra

  # A `Path` for a `source:`, the payload itself for inline `content:`.
  pub def resolve self app @ Str -> (Path | Str | Bin)
    let payload = self.payload
    if (type payload Artifact)
      payload.resolve $app
    else
      payload

  # The payload's bytes, however it is spelled.
  pub def read self app @ Str -> (Str | Bin)
    let resolved = self.resolve $app
    if (type resolved Path)
      resolved.read()
    else
      resolved

# Parses an artifact spec. Inline `content:` is not accepted: it is an `add:`
# spelling, and nothing else here would know what to do with a disk image or an
# install ISO handed over as a literal.
def parse_artifact spec @ ArtifactSpec -> Artifact
  if (type spec Str || type spec Path || type spec Url)
    return Artifact source: $spec
  Artifact source: $spec[:source:] digest: $(spec.get :digest:)

def parse_installer spec @ InstallerSpec -> Installer
  if (type spec Str || type spec Path || type spec Url)
    return Installer source: $spec
  match spec
    | :source
      :digest = nil
      :edition
    do Installer :source :digest :edition
    | :source
      :digest = nil
      :index
    do Installer :source :digest :index
    | :source
      :digest = nil
    do Installer :source :digest
  else
    throw std.ValueError "installer: edition: and index: are alternatives"

# Parses an `add:` step, mirroring `dockman`'s own `add:` build step. No VFS
# access and no fetching — just shape checking, so it is safe to call eagerly at
# parse time.
#
# Only an `init:` `add:` admits the three `write_files` keys, which mean
# something only where the entry is rendered into the seed rather than
# uploaded over a VFS.
def parse_add spec @ InitAddSpec name @ Str -> Add
  let target = spec.get :target: else: do
    throw std.ValueError "$name: missing target"
  # A call the checker never saw can still give both.
  let raw = (spec @ BaseDict[Sym, Value])
  if (raw.contains(:source:) && raw.contains(:content:))
    throw std.ValueError "$name: expected exactly one of source or content"
  let payload @ (Artifact | Str | Bin) = match spec
    # Pinned the same way as every other artifact, rather than with an
    # `add:`-specific spelling.
    (:source ...) do parse_artifact $source
    (:content ...) do content
  else
    throw std.ValueError "$name: expected exactly one of source or content"

  let extra @ Dict[Sym, (Str | Bool)] = {}
  let owner = spec.get :owner:
  if (owner != nil)
    extra[:owner:] = owner
  let append = spec.get :append:
  if (append != nil)
    extra[:append:] = append
  let defer = spec.get :defer:
  if (defer != nil)
    extra[:defer:] = defer

  Add :target :payload :extra chmod: $(require_chmod (spec.get :chmod:))

# How many artifacts are fetched at once. Matches `dockman`, which prefetches
# its own `add:` URLs the same way.
let FETCH_JOBS = 4

# Resolves every artifact a run needs, in parallel, before it needs any of them.
#
# Left to themselves the call sites resolve one at a time at the point of use,
# which spreads the downloads across image preparation, domain definition, boot
# and install. Resolving here overlaps them with each other and with everything
# that follows, and means an unreachable source or a digest mismatch is reported
# before a domain exists rather than partway through provisioning it.
#
# Duplicate sources are not filtered out. `transfer` locks each cache entry, and
# the lock is both keyed on the open file description — so two strands really do
# contend rather than both proceeding — and awaited, so the waiter yields to the
# strand holding it instead of stalling the pool.
def prefetch_artifacts artifacts@Array[Artifact | Add] app@Str
  strand.pool $FETCH_JOBS $artifacts do |artifact|
    artifact.resolve $app
    nil

let COMPRESSED_IMAGE_EXTS = Set ["gz", "xz", "zst"]

def prepared_image source@Path root@Path -> Path
  let ext = source.ext
  let compressed = (ext != nil && COMPRESSED_IMAGE_EXTS.contains(ext.lower()))
  let key = file_digest $source
  let entry = (root / "images" / key)
  entry.create_dir all: true
  let destination = (entry / "image")
  let lock_path = (entry / "lock")
  lock_path.open a+ do |lock| lock.lock (..) do |_|
    if !destination.exists()
      with_temp_dir parent: $entry do |staging|
        let temporary = (staging / "image")
        if compressed
          transfer.unpack $source $temporary
        else
          source.copy $temporary
        temporary.rename $destination
  destination.absolute()

def image_format image @ Path -> Str
  let output = cli qemu-img info --output json -- $image
  match json.decode(output)
    Dict("format": Str(format) ...) do format
  else
    throw std.ValueError "qemu-img did not report an image format"

# One state member to pack into a bundle: its kind, the file holding it, what
# it is called in the ZIP, and its format.
#
# Every member carries its own blake3 digest: a ZIP entry's CRC32 is a
# corruption check rather than an integrity property, and a member is extracted
# on its own — the disk into a shared image store — where the bundle's own
# digest no longer covers it.
@let PackedMember = (kind: Str, path: Path, name: Str, format: (Str | nil))

# The `<dolang:vm>` facts a bundle manifest records: everything about the guest
# that the disk image itself does not carry. See `DomainXml.bundle_info`.
@let BundleInfo = (
  app: Str,
  os: Str,
  arch: Str,
  user: Str,
  command: Str,
  machine: (Str | nil),
  firmware: (Str | nil),
  tpm: (Str | nil),
  memory: Int,
  vcpus: Int,
)

# Builds the manifest for a bundle, with `version` first because this format
# will change.
#
# `machine`, `firmware` and `tpm` record the shape the domain was defined as,
# so that restoring an old bundle cannot be quietly redefined by a later change
# to `Profile`.
#
# `digests` maps each member's kind to its hex digest. They are taken while the
# member is packed rather than in a pass of their own here, which is why this
# runs after the members are written rather than before — see `write_bundle`.
def bundle_manifest
  info @ BundleInfo
  members @ Array[PackedMember]
  domain_xml @ (Str | nil)
  digests @ Dict[Str, Str]
do -> Str
  let :app :os :arch :user :command :memory :vcpus :machine :firmware :tpm = info
  json.encode $
    :app :user :memory :vcpus
    version: $BUNDLE_VERSION
    os: $os.lower()
    arch: $arch.lower()
    vfs_command: $command
    if (machine != nil)
      :machine
    if (firmware != nil)
      :firmware
    if (tpm != nil)
      :tpm
    members:
      for :kind :path :name :format = members
        $kind:
          :name
          size: $path.metadata().size
          digest: $DIGEST_ALGORITHM:$digests[kind]
          # Only a member whose bytes have a format worth recording carries
          # one: the disk and the variable store do, the vTPM tar does not.
          if (format != nil)
            :format
    # Stored for debugging purposes, but presently unused. Written only for a
    # domain whose generated document was still on disk.
    if (domain_xml != nil)
      :domain_xml

# Writes the bundle itself: each member, then the manifest describing them.
#
# Members are `STORE`d because `qemu-img convert -c` has already done any
# compressing the disk is getting, and storing leaves each one a contiguous
# byte range that extraction can copy straight out. `size:` reserves the ZIP64
# fields in the entry's local header, without which a disk over 4 GiB could not
# be written at all.
#
# The manifest goes last because each member's digest is taken as it is packed,
# so there is nothing to describe until the members are written. ZIP entries
# carry their own names and the reader finds them by name, so entry order is
# free; a whole extra read of a multi-gigabyte disk is not.
#
# Each member is packed through a two-stage pipeline: one strand reads, the
# next forks the ZIP write against the digest. That keeps a read and a write in
# flight at once and runs blake3 in the gap the write yields, which on an 8 GiB
# disk is worth about 1.6x over reading, digesting, and writing in turn — the
# packed rate stops being bounded by the sum of the three.
def write_bundle
  path @ Path
  members @ Array[PackedMember]
  info @ BundleInfo
  domain_xml @ (Str | nil)
do
  let digests @ Dict[Str, Str] = {}
  zip.open $path w do |archive|
    for :kind :path :name format: _ = members
      let total = path.metadata().size
      let state = digest.Blake3()
      archive.open $name
        mode: 0o644
        compression: :STORED:
        size: $total
        do |entry| progress.show
          message: "pack $kind"
          icon: 🗜️
          total: $total
          units: :BYTES:
          do |ind| path.open do |file| strand.pipeline
            do while let chunk = file.read $BUNDLE_CHUNK
              strand.put $chunk
            do for chunk
              let bytes = (chunk @ Bin)
              strand.fork
                do entry.write $bytes
                do state.update $bytes
              ind.delta $bytes.len
      digests[kind] = "${state.digest():x}"
    archive.open $MANIFEST_MEMBER mode: 0o644 do |entry|
      entry.put $ bundle_manifest $info $members $domain_xml $digests

# Finds a bundle member by name, or `nil`.
def find_member archive@zip.Archive name@Str -> (zip.Entry | nil)
  for entry = archive.entries
    if (str(entry.name) == name)
      return entry
  nil

# Reads a whole bundle member, refusing one that is implausibly large. Only the
# manifest is read this way; the disk is streamed.
def read_member entry @ zip.Entry -> Bin
  let chunks @ Array[Bin] = []
  let total = 0
  entry.open do |file|
    while true
      let chunk = (file.read BUNDLE_CHUNK)
      if (chunk.len == 0)
        break
      total = (total + chunk.len)
      if (total > MANIFEST_LIMIT)
        throw std.ValueError "bundle manifest is too large"
      chunks.push $chunk
  b"".join $chunks

# The values a manifest may record for each of its symbolic fields, and the
# symbols they stand for.
#
# The keys are quoted so that they are `Str`, which is what a key decoded from
# JSON is; written as barewords they would be `Sym` and never match.
#
# `os` and `arch` list exactly the platforms `DOLANG_PLATFORMS` has a release
# artifact for, which is already the set a domain can be created as: `create`
# installs Do into every guest, so an OS with no artifact fails long before it
# could be exported.
let MANIFEST_OS @ Dict[Str, sys.Os] = $
  "linux": :LINUX:
  "macos": :MACOS:
  "windows": :WINDOWS:
  "freebsd": :FREEBSD:

let MANIFEST_ARCH @ Dict[Str, sys.Arch] = $
  "x86_64": :X86_64:
  "aarch64": :AARCH64:

let MANIFEST_FIRMWARE @ Dict[Str, Firmware] = $
  "bios": :BIOS:
  "efi_secure": :EFI_SECURE:

let MANIFEST_TPM @ Dict[Str, TpmModel] = $
  "crb_2_0": :CRB_2_0:

# The symbol a manifest's recorded text stands for, looked up in `table`.
#
# Looked up rather than interned with `sym`. A manifest is untrusted text, and
# interning it would let a bundle name an OS, architecture, firmware or TPM this
# module has never heard of — which does not fail, it falls through every
# comparison against the ones it has. A bundle recording a firmware nobody
# recognizes would restore as a BIOS guest, quietly, rather than being refused.
def manifest_enum[T] text@Str table@Dict[Str, T] key@Str bundle@Path -> T
  table.get $text else: do
    let known = ", ".join(table.keys())
    let message = "bundle manifest has an unknown $key: $text (expected one of $known): $bundle"
    throw std.ValueError $message

# `manifest_enum` for a field a bundle written by an older version may not
# carry.
def manifest_optional_enum[T] text@(Str | nil) table@Dict[Str, T] key@Str bundle@Path -> (T | nil)
  if (text == nil)
    return nil
  manifest_enum $text $table $key $bundle

# Splits a manifest digest into its algorithm and hex digits. Only blake3 is
# written, and only blake3 is accepted: the field is spelled `algorithm:hex` so
# that a later format version can add one, not so that a bundle can choose.
def manifest_hex value@Str source@Path -> Str
  let parts = [...value.split ":" limit: 1]
  let algorithm = (parts.len == 2 && parts[0] || nil)
  let hex = (parts.len == 2 && parts[1].lower() || nil)
  if (algorithm != DIGEST_ALGORITHM || hex == nil || hex.len == 0)
    throw std.ValueError "unsupported bundle disk digest: $value ($source)"
  hex

# One state member as a manifest describes it, for extracting and verifying it.
class ManifestMember: Struct[{kind: Str, name: Str, format: (Str | nil), size: Int, hex: Str}]

@let ManifestFields = $
  app: Str
  os: sys.Os
  arch: sys.Arch
  user: Str
  command: Str
  memory: Int
  vcpus: Int
  machine: (Str | nil)
  firmware: (Firmware | nil)
  tpm: (TpmModel | nil)
  # The state members. A BIOS guest has no variable store and no vTPM, and its
  # bundle carries neither.
  disk: ManifestMember
  nvram: (ManifestMember | nil)
  tpm_state: (ManifestMember | nil)

# A bundle's manifest, validated: the record the rest of the import path
# consumes.
class Manifest: Struct[ManifestFields]

# Reads one member's description out of a manifest's `members` map, or `nil`
# for state the bundle does not carry.
#
# A member's `format` is optional because only a member whose bytes have a
# format worth recording carries one: the disk and the variable store do, the
# vTPM tar does not.
def manifest_member
  members @ Dict[Str, json.DecodeValue]
  key @ Str
  bundle @ Path
do -> (ManifestMember | nil)
  let member = members.get $key
  if (member == nil)
    return nil
  if !(type member Dict)
    throw std.ValueError "bundle manifest member $key is not an object: $bundle"
  match member
    | "name": Str(name)
      "size": Int(size)
      "digest": Str(spec)
      ?"format": Str(format = nil)
    do
      ManifestMember (kind: key, :name, :format, :size, hex: manifest_hex(spec, bundle))
  else
    throw std.ValueError "bundle manifest member $key is malformed: $bundle"

# Reads and validates a bundle's manifest.
#
# A bundle may come from a URL, so its manifest is an untrusted input. Checking
# each field's JSON type here is what turns a wrong one into a single error,
# instead of a failure much later on a value that came out of a JSON file.
def read_manifest bundle @ Path -> Manifest
  let manifest = zip.open $bundle do |archive|
    let entry = find_member $archive $MANIFEST_MEMBER
    if !entry
      throw std.ValueError "not a Do VM bundle (no $MANIFEST_MEMBER): $bundle"
    json.decode $ str $ read_member $entry
  if !(type manifest Dict)
    throw std.ValueError "bundle manifest is not an object: $bundle"
  # Read before the shape is checked, so that a bundle written by a version
  # that knows keys this one does not is reported as the wrong version rather
  # than as a malformed manifest.
  let version = manifest.get "version"
  if (version != BUNDLE_VERSION)
    let message = "unsupported bundle version $version, expected $BUNDLE_VERSION: $bundle"
    throw std.ValueError $message
  # The whole of the format, in one place. Exhaustive on purpose: with the
  # version already pinned, a key this does not name is a writer and a reader
  # disagreeing about what version 1 means, which is worth an error rather than
  # a field silently dropped. `version` was read above, and is listed so that
  # this pattern is the whole format; `machine`, `firmware` and `tpm` are absent
  # from a bundle written before they were recorded, and `domain_xml`, stored
  # for debugging purposes but presently unused, from a domain whose generated
  # document was gone.
  match manifest
    | "version": _
      "app": Str(app)
      "os": Str(os)
      "arch": Str(arch)
      "user": Str(user)
      "vfs_command": Str(command)
      "memory": Int(memory)
      "vcpus": Int(vcpus)
      "members": Dict(members)
      ?"machine": Str(machine = nil)
      ?"firmware": Str(firmware = nil)
      ?"tpm": Str(tpm = nil)
      "domain_xml": _ = nil
    do
      let disk = manifest_member $members disk $bundle
      if (disk == nil)
        throw std.ValueError "bundle manifest is missing member disk: $bundle"
      Manifest $
        :app :user :command :memory :vcpus :machine :disk
        os: $ manifest_enum $os $MANIFEST_OS os $bundle
        arch: $ manifest_enum $arch $MANIFEST_ARCH arch $bundle
        firmware: $ manifest_optional_enum $firmware $MANIFEST_FIRMWARE firmware $bundle
        tpm: $ manifest_optional_enum $tpm $MANIFEST_TPM tpm $bundle
        nvram: $ manifest_member $members nvram $bundle
        tpm_state: $ manifest_member $members tpm $bundle
  else
    throw std.ValueError "bundle manifest is malformed: $bundle"

# Extracts one bundle member, verifying it against the manifest digest as it
# streams.
#
# Shaped like `write_bundle`'s packing loop and for the same reason: a strand
# reading out of the archive, a strand forking the write against the digest.
def extract_member bundle@Path member@ManifestMember dest@Path
  zip.open $bundle do |archive|
    let entry = find_member $archive $member.name
    if !entry
      throw std.ValueError "bundle is missing $(member.name): $bundle"
    let state = digest.Blake3()
    progress.show
      message: "extract $(member.kind)"
      icon: 📤
      total: $member.size
      units: :BYTES:
      do |ind| dest.open w do |out| entry.open do |file| strand.pipeline
        do while let chunk = file.read $BUNDLE_CHUNK
          strand.put $chunk
        do for chunk
          let bytes = (chunk @ Bin)
          strand.fork
            do out.write $bytes
            do state.update $bytes
          ind.delta $bytes.len
    let actual = "${state.digest():x}"
    if (actual != member.hex)
      let expected = member.hex
      let message = "bundle $(member.kind) digest mismatch: expected $expected, got $actual"
      throw std.ValueError $message

# Extracts a bundle's disk into the shared image store, the same durable store
# `prepared_image` fills. Keyed on the manifest digest rather than a digest of
# the bundle, so two bundles minted from one disk share an entry — and so the
# key is known before anything is extracted.
def bundle_image bundle@Path manifest@Manifest root@Path -> Path
  let disk = manifest.disk
  let entry = (root / "images" / disk.hex)
  entry.create_dir all: true
  let destination = (entry / "image")
  let lock_path = (entry / "lock")
  lock_path.open a+ do |lock| lock.lock (..) do |_|
    if !destination.exists()
      with_temp_dir parent: $entry do |staging|
        let temporary = (staging / "image")
        extract_member $bundle $disk $temporary
        temporary.rename $destination
  destination.absolute()

# The SSH key pair this module's guests trust, for one `app`.
@let KeyPair = (key: Path, public: Path)

def ensure_key root@Path app@Str -> KeyPair
  let directory = (root / "ssh")
  directory.create_dir all: true
  let key = (directory / "id_ed25519")
  let public = key.add_ext "pub"
  let lock_path = (directory / "lock")
  lock_path.open a+ do |lock| lock.lock (..) do |_|
    if !(key.exists() && public.exists())
      key.remove ignore: true
      public.remove ignore: true
      cli ssh-keygen -q -t ed25519 -N "" -C $app -f $key
  (:key, :public)

# `chmod:` accepts an `Int` mode or a `fs.unix.Mode`, normalized to a
# plain `Int` here, whichever `add:` it appears in.
#
# cloud-init's `write_files` wants `permissions` as an octal string, but that is
# its serialization detail, not a second calling convention: `write_files_entry`
# formats the int as octal instead.
def require_chmod chmod @ (Int | Mode | nil) -> (Int | nil)
  _vfs.parse_mode $chmod

# Renders one parsed `init:` `add:` step as a cloud-init `write_files` entry.
#
# Separate from `parse_add` so that the parse — which every `add:` in the spec
# goes through before anything is fetched — stays free of I/O, leaving the read
# until after `prefetch_artifacts` has the payload in hand.
def write_files_entry add@Add app@Str -> Dict[Sym, (Str | Bool)]
  let content = add.read $app
  let file @ Dict[Sym, (Str | Bool)] = {path: add.target}
  if (type content Str)
    file[:content:] = content
  else
    file[:content:] = base64.encode $content
    file[:encoding:] = "b64"

  let chmod = add.chmod
  if (chmod != nil)
    file[:permissions:] = "${chmod:o}"
  for key value = add.extra
    file[key] = value
  file

# Boot-time cloud-init state, parsed from `init:`: the commands to run, the
# files to write, and the packages to install.
@let InitState = (boot: Array[Array[Str]], write: Array[Add], packages: Array[Str])

# Parses the `init:` sub-dict into boot-time cloud-init state. Like the
# top-level keyword arguments, `add:`, `run:` and `packages:` may repeat (dicts
# are multimaps). `run:` entries here must be a raw string or Array of strings —
# anything needing a live VFS connection belongs in the top-level repeated
# `run:` keyword argument instead.
def parse_init init @ (InitSpec | nil) -> InitState
  let boot @ Array[Array[Str]] = []
  let write @ Array[Add] = []
  let packages @ Array[Str] = []
  if (init != nil)
    for entry = init
      match entry
        (:add: spec) do write.push $ parse_add $spec init.add
        (:run: command) do
          if (type command Str)
            boot.push [...shlex.split(command)]
          else
            boot.push [...command]
        (:packages: names) do
          if (type names Str)
            packages.push $names
          else
            packages.push ...names
  (:boot, :write, :packages)

# The top-level repeated options, parsed: the steps `add:`, `run:` and
# `reboot`, in order, and the `installer:`/`drivers:` media.
@let ParsedOptions[I, O] = (
  steps: Array[Step[I, O]],
  installers: Array[Installer],
  drivers: Array[Artifact],
)

# Parses the top-level repeated options: the steps `add:`, `run:` and `reboot`,
# all run post-SSH, and `installer:`/`drivers:`, the media an unattended install
# boots from. Boot-time commands belong in `init: {run: ...}` instead.
#
# These are repeatable, which a declared keyword parameter cannot be, so they
# arrive through `...options` and are sorted out here instead. The order they
# arrive in is the order they run in, positional steps included.
#
# This is also where a registered step macro would resolve, so that a builtin
# and a macro are looked up the same way.
def parse_options[I, O] options @ Record[...DomainOptions[I, O]] -> ParsedOptions[I, O]
  let steps @ Array[Step[I, O]] = []
  let installers @ Array[Installer] = []
  let drivers @ Array[Artifact] = []
  for entry = options
    match entry
      # The positional `reboot`.
      (Int(_) _) do steps.push :REBOOT:
      (:add: spec) do steps.push $ parse_add $spec add
      (:run: block) do steps.push $block
      (:installer: spec) do installers.push $ parse_installer $spec
      (:drivers: spec) do drivers.push $ parse_artifact $spec
  (:steps, :installers, :drivers)

# Unpacks the guest payload archive into the image store, cached under a
# digest of the archive so it is unpacked once per release rather than once
# per domain.
#
# The cloud-init path copies this archive over SSH after the guest is up. An
# unattended install cannot: SSH is what the payload brings, so the binaries
# have to ride in on the provisioning disc, which needs them as files.
def unpack_payload root@Path archive@Path -> Path
  let key = file_digest $archive
  let entry = (root / "payloads" / key)
  entry.create_dir all: true
  let destination = (entry / "payload")
  let lock_path = destination.add_ext lock
  lock_path.open a+ do |lock| lock.lock (..) do |_|
    if !destination.exists()
      with_temp_dir parent: $entry do |dir|
        let staging = (dir / "payload")
        staging.create_dir all: true
        tar.read $archive do |archive|
          for member = archive
            let name = member.path.name
            if (member.type != :FILE: || name == nil)
              continue
            # Flattened onto the disc by basename: the archive's directory
            # layout is a release-artifact detail, and `bootstrap.cmd` copies
            # one directory.
            let target = (staging / name)
            target.open w do |file|
              for chunk = member
                file.write $chunk
        staging.rename $destination
  destination.absolute()

# Builds the provisioning ISO, cached under a digest of its contents so
# identical configurations share one — the same arrangement
# `cloud_init.build_seed` uses for the cloud-init seed.
#
# `files` maps a path on the disc to either a `Path` to copy there or text to
# write there. The key is taken over each member's digest rather than over the
# bytes of the disc, so it can be computed without building the disc first.
def build_provision_iso root@Path files@Dict[Str, (Path | Str)] -> Path
  let names @ Array[Str] = []
  for name _ = files
    names.push $name
  names.sort()
  let manifest @ Dict[Str, Str] = {}
  for name = names
    let value = files[name]
    manifest[name] = if (type value Path)
      file_digest $value
    else
      "${digest.blake3(value):x}"

  let key = "${(digest.blake3(json.encode manifest)):x}"
  let entry = (root / "provision" / key)
  entry.create_dir all: true
  let destination = (entry / "provision.iso")
  let lock_path = destination.add_ext lock
  lock_path.open a+ do |lock| lock.lock (..) do |_|
    if !destination.exists()
      let program = require_iso_program()
      with_temp_dir parent: $entry do |dir|
        let staging = (dir / "root")
        staging.create_dir all: true
        for name = names
          let target = (staging / name)
          let parent = target.parent
          if parent
            parent.create_dir all: true
          let value = files[name]
          if (type value Path)
            target.write $(value.read())
          else
            target.write $value
        let temporary = (dir / "provision.iso")
        # Joliet and Rock Ridge both: Setup reads the disc through Joliet, and
        # Rock Ridge is what makes it legible when it is mounted on the host
        # to work out why an install went wrong.
        cli $program -J -R -V $PROVISION_LABEL -o $temporary $staging
        temporary.rename $destination
  destination.absolute()

def dolang_platform_key os@sys.Os arch@sys.Arch -> Str
  "$(str(arch).lower())-$(str(os).lower())"

def dolang_artifact_name os@sys.Os arch@sys.Arch -> (Str | nil)
  let key = (dolang_platform_key os arch)
  (DOLANG_PLATFORMS.contains(key) && "dolang-$key.tar.gz" || nil)

def dolang_current_tag -> Str
  let major minor patch = shell.VERSION
  "v$major.$minor.$patch"

# GitHub serves public release assets at a predictable, unauthenticated URL,
# so fetching one is just another `transfer.get`-cached download — no `gh`
# CLI (and no token) required.
def dolang_release_url tag@Str artifact@Str -> Str
  "https://github.com/$DOLANG_REPO/releases/download/$tag/$artifact"

# Normalizes `dolang:` into the release tag it names, or the archive it names
# as an `Artifact`. `nil` selects the release matching this interpreter.
#
# A bare `Str` is a version tag rather than a source, which is why this is not
# just `parse_artifact`: everything else is an artifact spec and goes through
# it.
def dolang_release spec @ (DolangSpec | nil) -> (Str | Artifact)
  if (spec == nil)
    return dolang_current_tag()
  if (type spec Str)
    return spec
  if (type spec Path || type spec Url)
    return Artifact source: $spec
  match spec
    (:version) do version
    artifact do parse_artifact $artifact

# The archive `dolang:` names, as an `Artifact`.
#
# There is no "install nothing" answer. A guest without `dolang-vfs` has no
# `with`, no `upload` and no `download` — which is most of what a domain is
# for — and an unattended install has no guest at all without one, since the
# payload is what brings up SSH. So a platform with no release artifact is an
# error, and one whose release cannot be fetched fails the fetch, rather than
# either producing a domain that comes up quietly crippled.
#
# The version form resolves to a release URL rather than to an artifact spec the
# caller wrote, which is why this needs `os`/`arch` and so cannot be built at
# the same point as the rest of them.
def dolang_artifact spec@(DolangSpec | nil) os@sys.Os arch@sys.Arch -> Artifact
  let release = dolang_release $spec
  if (type release Artifact)
    return release
  let artifact = dolang_artifact_name $os $arch
  if (artifact == nil)
    throw std.ValueError "dolang: no known release artifact for $(dolang_platform_key os arch)"
  Artifact source: (Url (dolang_release_url release artifact))

# Whether a failed `create` should leave what it built behind for inspection.
def keep_failed -> Bool
  let value = env.get $KEEP_FAILED_VAR
  (value != nil && value != "" && value != "0")

# Where a domain's disk, media and guest identity come from, and whatever is
# left to do to the guest once it answers.
#
# `create` accepts three provisioning sources and has to treat them alike from
# the moment the domain is defined: an `image:` to lay an overlay over, a
# `bundle:` to restore, or `installer:` media to install from. Each subclass
# resolves one of them in its constructor — fetching, unpacking and caching
# whatever that takes — and then differs only in `provision`.
class Source
  # The guest this source produces and how to reach it. `probe` is what
  # "reachable" means for it: a bundle and an unattended install both bring
  # their own VFS, where a cloud-init guest has only sshd until the payload
  # lands.
  #
  # Those that are never `nil` are private behind getters, and written first:
  # a write to a pub field could reach a subclass, so it lets `self` escape.
  field os @ sys.Os
  field arch @ sys.Arch
  field user command @ Str
  field probe @ Probe
  # The disk to lay the domain's overlay over, its format, and the media to
  # attach. `image` is `nil` for a source that installs onto a blank disk.
  pub field image @ (Path | nil)
  pub field format @ (Str | nil)
  field media @ Array[Medium]
  # The machine shape to define the domain as: the one a restored bundle was
  # built as, or the one this OS calls for today. Resolved here so that nothing
  # downstream has to know which of the two it got.
  field profile @ Profile
  # What a source that was a domain once brings back with it. Everything else
  # leaves these `nil` and lets the profile decide.
  pub field memory vcpus @ (Int | nil)
  pub field nvram_format @ (Str | nil)

  def (init)
    self
    :os @ sys.Os
    :arch @ sys.Arch
    :user @ Str
    :command @ Str
    :probe @ Probe
    :image @ (Path | nil) = nil
    :format @ (Str | nil) = nil
    :media @ Array[Medium] = []
    :profile @ (Profile | nil) = nil
    :memory @ (Int | nil) = nil
    :vcpus @ (Int | nil) = nil
    :nvram_format @ (Str | nil) = nil
  do
    self.#os = os
    self.#arch = arch
    self.#user = user
    self.#command = command
    self.#probe = probe
    self.#media = media
    self.#profile = (profile || os_profile os)
    self.image = image
    self.format = format
    self.memory = memory
    self.vcpus = vcpus
    self.nvram_format = nvram_format

  #[getter]
  pub def os self -> sys.Os
    self.#os

  #[getter]
  pub def arch self -> sys.Arch
    self.#arch

  #[getter]
  pub def user self -> Str
    self.#user

  #[getter]
  pub def command self -> Str
    self.#command

  #[getter]
  pub def probe self -> Probe
    self.#probe

  #[getter]
  pub def media self -> Array[Medium]
    self.#media

  #[getter]
  pub def profile self -> Profile
    self.#profile

  # Whatever the guest still needs once it answers its probe, before the
  # caller's own `add:`/`run:`/`reboot` steps run.
  #
  # Nothing, for a source whose guest was provisioned before it ever became a
  # bundle. The other two override this.
  pub def provision _self _domain @ DomainImpl
    nil

# The `image:` source: a base image to lay an overlay over, plus the cloud-init
# seed that provisions the guest on first boot.
class ImageSource: Source
  field payload @ Path

  def (init)
    self
    :image @ Artifact
    :os @ sys.Os
    :arch @ sys.Arch
    :app @ Str
    :user @ Str
    :staged @ InitState
    :dolang @ Artifact
    :keys @ KeyPair
    :root @ Path
  do
    let resolved = image.resolve $app
    let payload = dolang.resolve $app
    let stored = prepared_image $resolved $root
    let seed = progress.show message: "prepare cloud-init" icon: ☁️ do |_|
      let key: _ :public = keys
      let public_key = public.read_str().trim()
      let :boot :write :packages = staged
      # Rendered here rather than at parse time: an `init:` `add:` naming a
      # `source:` is fetched with everything else, and its bytes are only in
      # hand once that has happened.
      let write_files @ Array[yaml.EncodeValue] = $
        for add = write
          - (write_files_entry add app)
      let user_data = cloud_init.cloud_config $user $public_key
        $packages $boot $write_files
      cloud_init.build_seed $root $user_data
    self.#payload = payload
    Source.(init) $self
      :os :arch :user
      command: "$(payload_directory user)/dolang-vfs"
      probe: :SSH:
      image: $stored
      format: $(image_format stored)
      media: [(path: seed, boot: nil)]

  # The payload is copied in over SSH — this is the one path where the guest
  # brings up sshd itself and the VFS arrives afterwards — and then cloud-init
  # is waited out, since the seed's `runcmd` is still running when sshd starts
  # answering.
  pub def provision self domain @ DomainImpl
    progress.show message: "copy payload" icon: 📦 do |_|
      domain.install_payload $self.#payload
    progress.show message: "wait for provisioning" do |_|
      domain.wait_ready probe: :CLOUD_INIT:

# The `installer:` source: install media the guest boots from onto a blank
# disk, plus any `drivers:` media Setup needs in order to see that disk at all.
#
# There is no base image here. The other two sources lay an overlay over a disk
# somebody else built; this one starts from nothing and lets Setup write it, so
# `image` is `nil` and `create` sizes the overlay instead of backing it.
class InstallerSource: Source
  def (init)
    self
    :installers @ Array[Installer]
    :drivers @ Array[Artifact]
    :os @ sys.Os
    :arch @ sys.Arch
    :app @ Str
    :user @ Str
    :dolang @ Artifact
    :keys @ KeyPair
    :root @ Path
    :workdir @ Path
  do
    # The guest runs a released interpreter, so deliver source rather than
    # host bytecode or a module that would need to exist in that release.
    let provision_source = _shell.resource dolang-shell-modules provision.dol
    if !type(provision_source, Str)
      throw std.RuntimeError "libvirt: missing or non-text resource dolang-shell-modules/provision.dol"
    let media @ Array[Medium] = []
    # The installer boots first and the disk it writes boots after it; driver
    # media is read by Setup and never booted, so it takes no order.
    let boot = 1
    # Which edition to install is a property of the media it is on, so it is
    # spelled on `installer:` — and taken from the disc that boots first, which
    # is the one Setup runs from.
    let edition @ (Str | nil) = nil
    let index @ (Int | nil) = nil
    for spec = installers
      if (boot == 1)
        edition = spec.edition
        index = spec.index
      let resolved = spec.resolve $app
      media.push (path: resolved, :boot)
      boot = (boot + 1)
    for spec = drivers
      let resolved = spec.resolve $app
      media.push (path: resolved, boot: nil)

    let archive = dolang.resolve $app
    let payload = unpack_payload $root $archive

    # Written beside the domain so the console is usable while an install is
    # being watched. It is also what any bundle exported from this domain
    # carries — see the Windows section of the module documentation.
    let password = rand.string 20
    (workdir / "password").write "$password\n"

    let key: _ :public = keys
    let provision = progress.show message: "prepare unattend" icon: 💿 do |_|
      build_provision_iso $root $
        "autounattend.xml": $ unattend.unattend_xml $user :edition :index
          drivers: (drivers.len > 0)
        "bootstrap.cmd": $BOOTSTRAP_CMD
        "provision.dol": $provision_source
        # The password reaches the guest here rather than through the answer
        # file: this disc is a cdrom, which `export_source` excludes, so
        # nothing on it survives into an exported image.
        "provision.json": $ json.encode $
          :user :password
          root: $WINDOWS_ROOT
          authorized_key: $(public.read_str().trim())
        for file = payload.entries()
          "payload/$(file.name)": (payload / file)
    media.push (path: provision, boot: nil)

    Source.(init) $self
      :os :arch :user :media
      command: $WINDOWS_VFS_COMMAND
      probe: :VFS:

  # Finishes an unattended install, over the guest's VFS: makes the guest stop
  # when libvirt asks it to, and removes the answer file Setup left behind. It
  # is all the module does to a Windows guest once sshd answers — what the
  # guest then does with itself, from Windows Update to `sysprep`, is the
  # caller's, expressed as `add:`/`run:`/`reboot` steps.
  #
  # Host-side rather than in `provision.dol` because host code compiles, lints
  # and re-runs against a live guest in seconds, where a mistake inside the
  # guest script costs a full reinstall to find. Only what has to happen before
  # there is an SSH server to reach stays in the guest.
  #
  # Removing our answer file also frees `C:\Windows\Panther\unattend.xml` for a
  # caller's own post-generalize one; leaving ours there would silently pre-empt
  # it.
  pub def provision _self domain @ DomainImpl
    progress.show message: "provision guest" icon: 🪟 do |_|
      domain.with do
        # Hibernating a guest that is ephemeral, snapshottable and exportable
        # buys nothing and costs plenty: with Fast Startup on, a shutdown is a
        # partial hibernation, and a disk captured mid-hibernation restores
        # kernel state for hardware that may no longer be there.
        cli powercfg /h off
        # The power button defaults to sleep, which is not what `shutdown`
        # asking through ACPI means: bind it to an orderly shutdown so a
        # `Domain.shutdown` reaches `:SHUTOFF:` rather than suspending the
        # guest. Both values are set — the guest has no battery to put it on
        # the DC one, but a scheme that agrees with itself cannot be read the
        # wrong way.
        cli powercfg /setacvalueindex SCHEME_CURRENT SUB_BUTTONS PBUTTONACTION 3
        cli powercfg /setdcvalueindex SCHEME_CURRENT SUB_BUTTONS PBUTTONACTION 3
        cli powercfg /setactive SCHEME_CURRENT

        let windows = Path $ env.get windir default: C:\Windows
        # Logs each removal rather than removing quietly: `ignore: true` cannot
        # tell "already gone" from "looked in the wrong place", and an earlier
        # version of this built its path from a bareword and so silently
        # scrubbed nothing at all. A transcript naming the files makes that
        # visible.
        for name = UNATTEND_COPIES
          let path = (windows / name)
          path.remove ignore: true

# The `bundle:` source: a disk that was provisioned once, before it was
# exported, and the configuration recorded alongside it.
#
# There is no seed and no payload — both were already applied to the disk being
# restored — so the domain is ready as soon as its VFS answers, and `provision`
# is inherited as the no-op.
class BundleSource: Source
  def (init) self :bundle@Artifact :app@Str :root@Path :workdir@Path
    let resolved = progress.show message: "resolve bundle" do |_|
      bundle.resolve $app
    let manifest = read_manifest $resolved
    # The key a bundle's guest trusts is the one generated for the app it was
    # minted under, and that key lives under that app's data directory.
    # Restoring under a different app would hand the guest a key it has never
    # seen, which surfaces as the wait for the guest never returning rather
    # than as an error.
    if (manifest.app != app)
      throw std.ValueError "bundle was exported from app $(manifest.app), not $app"
    let image = progress.show message: "prepare image" icon: 💿 do |_|
      bundle_image $resolved $manifest $root
    # The profile the disk was installed against, not the one this OS would be
    # given today.
    let profile = os_profile $manifest.os
      machine: $manifest.machine
      firmware: $manifest.firmware
      tpm: $manifest.tpm
    profile.require_host()
    # Unlike the disk, which is shared between every domain laid over it, these
    # go straight into this domain's work directory: a variable store records
    # one machine's boot entries and a vTPM holds one machine's secrets, so two
    # domains must never be pointed at the same copy.
    let nvram_format @ (Str | nil) = nil
    let nvram = manifest.nvram
    if (nvram != nil)
      extract_member $resolved $nvram (workdir / "nvram.bin")
      nvram_format = nvram.format
    else if (profile.firmware == :EFI_SECURE:)
      let message = "bundle has no firmware variable store, which os: $(manifest.os) requires"
      throw std.ValueError $message
    let tpm_state = manifest.tpm_state
    if (tpm_state != nil)
      with_temp_dir parent: $workdir do |staging|
        let archive = (staging / TPM_MEMBER)
        extract_member $resolved $tpm_state $archive
        transfer.unpack $archive (workdir / "tpm")
    else if (profile.tpm != nil)
      throw std.ValueError "bundle has no vTPM state, which os: $(manifest.os) requires"
    Source.(init) $self
      :image :profile :nvram_format
      os: $manifest.os
      arch: $(require_arch manifest.arch)
      user: $(require_name manifest.user)
      command: $manifest.command
      probe: :VFS:
      format: $manifest.disk.format
      memory: $manifest.memory
      vcpus: $manifest.vcpus

# Creates and starts a domain, provisioning it with cloud-init from a base
# `image:`, installing it from `installer:` media, or restoring it from an
# already-provisioned `bundle:`.
#
# ## Errors
#
# | Exception      | Condition                                                            |
# | -------------- | ----------------------------------------------------------------------- |
# | `ValueError`   | None or more than one of `image`, `bundle`, and `installer` are given, `os` is omitted with `image`, an argument is given that `bundle` already answers or that the guest's provisioning method cannot act on, `arch` is not the host's, the bundle was exported from another `app`, or a domain named `name` already exists |
# | `RuntimeError` | No forwarded SSH port could be allocated, or a host program the requested configuration needs is not on `PATH` |
# | `TimedOutError` | The guest was not reachable within `wait_timeout` |
#
# ## Example
#
# ```
# let domain = libvirt.create
#   image: freebsd.qcow2.xz
#   os: :FREEBSD:
#   name: freebsd-build
#   init:
#     packages:
#       - sqlite3
#     add:
#       target: /etc/example.conf
#       content: |
#         enabled=yes
#   run: do
#     run uname -a
#
# echo $domain.name
# ```
#
# Restoring a bundle instead, which runs no provisioning:
#
# ```
# let domain = libvirt.create
#   bundle: ./freebsd-gold.dolvm
#   app: dolang-libvirt-test
#   name: freebsd-build
#   run: do
#     run uname -a
# ```
pub def create[I, O]
  # [Domain options](libvirt.common-domain-options) and
  # [steps](libvirt.create-steps).
  ...options @ DomainOptions[I, O]
  <I
  >O
do -> Domain
  Domain $(create_domain ...options)

# Creates a domain from an `image:` or a `bundle:`, runs `block` through its
# VFS, and tears it down — even if `block` throws.
#
# ## Example
#
# ```
# libvirt.with
#   image: freebsd.qcow2.xz
#   os: :FREEBSD:
#   do
#     run uname -a
# ```
pub def with[R, I, O]
  # Block to run in the guest VFS.
  block @ (() -> R)
  # [Domain options](libvirt.common-domain-options) and
  # [steps](libvirt.create-steps).
  ...options @ DomainOptions[I, O]
  <I
  >O
do -> R
  let domain = create ...options
  try
    domain.with $block
  finally
    if (domain.state() != :SHUTOFF:)
      domain.destroy()
    domain.undefine()

# Provisions a domain, shuts it down cleanly, exports it as a bundle, and
# tears it down.
#
# This is the minting half of the gold-image workflow: `build` produces the
# bundle, and `create bundle:` consumes it. Keeping the two passes separate is
# the point — a caller that provisions on a cache miss and restores on a hit
# would otherwise run its real work against two different guests, one of them
# freshly cloud-inited, and only discover the divergence on the rarer path.
# Build the bundle in its own pass and always start from it.
#
# Preparation is the caller's to specify through the same `init:`, `add:`, and
# `run:` arguments `create` takes; `run:` in particular is where
# anything the guest must do for itself belongs, such as reclaiming free space
# before the disk is flattened.
#
# ## Example
#
# ```
# libvirt.build (CACHE_DIR / "freebsd-gold.dolvm")
#   image: freebsd.qcow2.xz
#   os: :FREEBSD:
#   init:
#     packages:
#       - git
# ```
pub def build[I, O]
  # Bundle to write; `.dolvm` is the
  # conventional extension.
  destination @ (Str | Path)
  # qcow2 compression.
  :compress @ Compress = true
  # [Domain options](libvirt.common-domain-options) and
  # [steps](libvirt.create-steps).
  ...options @ DomainOptions[I, O]
  <I
  >O
do -> Path
  let domain = create ...options
  try
    domain.shutdown()
    domain.export $destination :compress
  finally
    if (domain.state() != :SHUTOFF:)
      domain.destroy()
    domain.undefine()
