# dolang: strict
# Runs and manages Podman containers and images.

import
  fs:
    - @Path
  _container.dockman: dockman

pub import _container.dockman:
  - Image
  - Container
  - NoImageError
  - NoContainerError
  - ContainerExitError
  - InvalidImageReferenceError
  - RegistryAuthError
  - ArchiveError
  - ContainerState
  - ImageTag
  - MountInfo
  - PortBinding
  - PushResult
  - @AddSpec
  - @ArchiveFormat
  - @BuildMount
  - @BuildSteps
  - @ContainerMount
  - @ContainerStatus
  - @Env
  - @PatchSpec
  - @Platform
  - @PortProtocol
  - @PortSpec
  - @PullPolicy
  - @RestartSpec

let podman = dockman.Runtime :PODMAN:

# Runs a command in a temporary Podman container.
pub def run
  # Image name or ID.
  image @ Str
  # Command to run instead of the image command.
  cmd @ Str
  # Container working directory.
  :cd @ (Str | Path) = nil
  # Container environment.
  :env @ Env = {}
  # Image pull policy.
  :pull @ PullPolicy = :MISSING:
  # Container name.
  :name @ Str = nil
  # Mounts.
  :mounts @ Iterable[ContainerMount] = []
  # Container labels.
  :labels @ BaseDict[Str | Sym, Value] = {}
  # Ports to publish.
  :ports @ Iterable[PortSpec] = []
  # Networks to connect to, by name or ID.
  :networks @ Iterable[Str] = []
  # User, or `user:group`.
  :user @ Str = nil
  # Run an init process that forwards signals and reaps child processes.
  :init @ Bool = false
  # Entrypoint override.
  :entrypoint @ Str = nil
  # Arguments passed to `cmd`.
  *args @ Value
  <Iter[Value]
  >Sink[Str]
do
  podman.run $image $cmd :env :pull :mounts :labels :ports :networks :init ...args
    if (cd != nil)
      :cd
    if (name != nil)
      :name
    if (user != nil)
      :user
    if (entrypoint != nil)
      :entrypoint

# Creates a stopped Podman container, in the `:CREATED:` state.
pub def create
  # Image name or ID.
  image @ Str
  # Command to run instead of the image command.
  cmd @ Str = nil
  # Container working directory.
  :cd @ (Str | Path) = nil
  # Container environment. `nil` values are not supported.
  :env @ Env = {}
  # Image pull policy.
  :pull @ PullPolicy = :MISSING:
  # Container name.
  :name @ Str = nil
  # Mounts.
  :mounts @ Iterable[ContainerMount] = []
  # Container labels.
  :labels @ BaseDict[Str | Sym, Value] = {}
  # Ports to publish.
  :ports @ Iterable[PortSpec] = []
  # Networks to connect to, by name or ID.
  :networks @ Iterable[Str] = []
  # User, or `user:group`.
  :user @ Str = nil
  # Run an init process that forwards signals and reaps child processes.
  :init @ Bool = false
  # Entrypoint override.
  :entrypoint @ Str = nil
  # Restart policy.
  :restart @ RestartSpec = nil
  # Arguments passed to `cmd`.
  *args @ Value
do -> Container
  podman.create $image $cmd :env :pull :mounts :labels :ports :networks :init ...args
    if (cd != nil)
      :cd
    if (name != nil)
      :name
    if (user != nil)
      :user
    if (entrypoint != nil)
      :entrypoint
    if (restart != nil)
      :restart

# Runs a block in a temporary Podman container.
#
# Program execution and filesystem access are redirected for the duration of
# the block.
pub def with[R]
  # Image name or ID.
  image @ Str
  # Block to run.
  func @ (() -> R)
  # Container working directory.
  :cd @ (Str | Path) = nil
  # Container environment.
  :env @ Env = {}
  # Image pull policy.
  :pull @ PullPolicy = :MISSING:
do -> R
  podman.with $image $func :env :pull
    if (cd != nil)
      :cd

# Builds a Podman image.
#
# ## Example
#
# ```
# let img = podman.build
#   from: ubuntu:24.04
#   run: do run apt install -y curl
#   tag: my-image
# assert_eq $img.tags()[0].tag my-image
# ```
pub def build[I, O]
  # Image pull policy for the base image.
  :pull @ PullPolicy = :MISSING:
  # Mounts available to every build step.
  :mounts @ Iterable[BuildMount] = []
  # Working directory for `run` steps.
  :cd @ (Str | Path) = nil
  # Environment for `run` steps.
  :env @ Env = {}
  # Base image.
  :from @ Str
  # Build steps and tags, in order, as keyword arguments. Keys may repeat.
  **steps @ BuildSteps[I, O]
  <I
  >O
do -> Image
  podman.build :pull :mounts :env :from ...steps
    if (cd != nil)
      :cd

# Lists images, one per repository and tag.
pub def images
  # List all images, including intermediate layers.
  :all @ Bool = false
  # Filter expression, such as `"reference=myapp*"`.
  :filter @ Str = nil
do -> Iterable[Image]
  podman.images :all
    if (filter != nil)
      :filter

# Gets an image by reference.
pub def image
  # Image reference, such as `"myapp:latest"` or `"sha256:abc..."`.
  ref @ Str
do -> Image
  podman.image $ref

# Lists containers.
pub def containers
  # List all containers, including stopped ones.
  :all @ Bool = false
  # Filter expression, such as `"name=myapp*"`.
  :filter @ Str = nil
do -> Iterable[Container]
  podman.containers :all
    if (filter != nil)
      :filter

# Gets a container by ID or name.
pub def container
  # Container ID or name.
  ref @ Str
do -> Container
  podman.container $ref

# Saves one or more images to an archive or directory, returning `target`.
pub def save
  # Archive path to write, or the directory for a directory format.
  target @ (Str | Path)
  # Archive format.
  :format @ ArchiveFormat = :DOCKER_ARCHIVE:
  # Platform to save.
  :platform @ Platform = nil
  # Image references to save. Only `:DOCKER_ARCHIVE:` holds more than one.
  *images @ Str
do -> (Str | Path)
  podman.save $target :format ...images
    if (platform != nil)
      :platform

# Loads images from an archive.
pub def load
  # Archive to load.
  source @ (Str | Path)
  # Platform to load.
  :platform @ Platform = nil
do -> Array[Image]
  podman.load $source
    if (platform != nil)
      :platform

# Pulls an image from a registry.
pub def pull
  # Image reference.
  ref @ Str
  # Platform to pull.
  :platform @ Platform = nil
do -> Image
  podman.pull $ref
    if (platform != nil)
      :platform

# Pushes an image to a registry.
pub def push
  # Image reference.
  ref @ Str
  # Platform to push.
  :platform @ Platform = nil
do -> PushResult
  podman.push $ref
    if (platform != nil)
      :platform
