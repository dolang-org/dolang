# dolang: strict
# Utilities for reading systemd/OS configuration files.

import shlex term
  fs:
    - open
    - Path
  time:
    - Date
  url:
    - Url
  std:
    - @Index
    - @IndexItem
    - @Spread
    - @Unpack

let ESC = str b"\x1b"

let RELEASE_TYPES @ Dict[Str, ReleaseType] = $
  "stable": :STABLE:
  "lts": :LTS:
  "development": :DEVELOPMENT:
  "experiment": :EXPERIMENT:

let PORTABLE_SCOPES @ Dict[Str, PortableScope] = $
  "system": :SYSTEM:
  "user": :USER:
  "any": :ANY:

let EXTENSION_SCOPES @ Dict[Str, ExtensionScope] = $
  "system": :SYSTEM:
  "initrd": :INITRD:
  "portable": :PORTABLE:

let SGR_OPTIONS = $
  1: {bold: true}
  2: {dim: true}
  3: {italic: true}
  4: {underline: true}
  5: {blink: true}
  6: {blink: true}
  7: {reverse: true}
  8: {hidden: true}
  9: {strikethrough: true}
  22: {bold: :INHERIT:, dim: :INHERIT:}
  23: {italic: :INHERIT:}
  24: {underline: :INHERIT:}
  25: {blink: :INHERIT:}
  27: {reverse: :INHERIT:}
  28: {hidden: :INHERIT:}
  29: {strikethrough: :INHERIT:}

def read_keys path @ (Str | Path) -> Dict[Str, Str]
  open $path do |file|
    let res @ Dict[Str, Str] = {}
    for line = file.chomp()
      # Ignore comments and empty lines
      if (line.starts_with "#" || !line.trim())
        continue
      try
        let k v = shlex.split(line).next().split "=" limit: 1
        res[k] = v
      catch std.RuntimeError: _
        # Ignore lines that are malformed
        continue
    res

def words value @ Str -> Iter[Str]
  value.split(" ").map(Str.trim).filter do |x| x

def url_value value @ (Str | nil) -> (Url | nil)
  if (value == nil)
    return nil
  try
    Url $value
  catch _
    nil

def support_end value @ (Str | nil) -> (Date | nil)
  if (value == nil)
    return nil
  try
    Date.parse_rfc $value
  catch _
    nil

def scopes value @ Str -> Iter[ExtensionScope]
  words(value).map do |item| EXTENSION_SCOPES.get $item default: $item

def sgr_color code @ Int :bright @ Bool = false -> Sym
  let names = [:BLACK:, :RED:, :GREEN:, :YELLOW:, :BLUE:, :MAGENTA:, :CYAN:, :WHITE:]
  let bright_names = [
    :BRIGHT_BLACK:, :BRIGHT_RED:, :BRIGHT_GREEN:, :BRIGHT_YELLOW:,
    :BRIGHT_BLUE:, :BRIGHT_MAGENTA:, :BRIGHT_CYAN:, :BRIGHT_WHITE:
  ]
  if bright
    bright_names[code]
  else
    names[code]

# Takes the next SGR parameter if it is a color component (0 through 255).
def sgr_byte parts @ Iter[Int] -> (Int | nil)
  let byte = parts.next default: nil
  if (byte != nil && byte >= 0 && byte <= 255)
    byte
  else
    nil

def ansi_style value @ (Str | nil) -> (term.Style | nil)
  if (value == nil)
    return nil

  let codes @ Array[Int] = []
  for part = value.split(";")
    try
      codes.push (int part)
    catch std.TypeError: _
      return nil
    catch std.OverflowError: _
      return nil

  let parts = codes.iter()
  let args @ Dict[Sym, Value] = {}
  for code = parts
    if (code == 0)
      args.clear()
    else if (code >= 30 && code <= 37)
      args[:fg:] = sgr_color(code - 30)
    else if (code >= 90 && code <= 97)
      args[:fg:] = sgr_color(code - 90, bright: true)
    else if (code >= 40 && code <= 47)
      args[:bg:] = sgr_color(code - 40)
    else if (code >= 100 && code <= 107)
      args[:bg:] = sgr_color(code - 100, bright: true)
    else if (code == 38 || code == 48)
      let key = (code == 38 && :fg: || :bg:)
      let mode = parts.next default: nil
      if (mode == 5)
        let color = sgr_byte $parts
        if (color != nil)
          args[key] = color
      else if (mode == 2)
        let red = sgr_byte $parts
        let green = sgr_byte $parts
        let blue = sgr_byte $parts
        if (red != nil && green != nil && blue != nil)
          args[key] = [red, green, blue]
    else
      let options = SGR_OPTIONS.get $code else: do return nil
      for key value = options
        args[key] = value
  term.Style ...args

def fancy_value value @ (Str | nil) -> (term.Text | nil)
  if (value == nil)
    return nil
  # FANCY_NAME specifies C-style escapes for terminal presentation.
  let value = value.replace r"\033" $ESC
  term.preformat $value

# A system- or configuration-extension scope. An unrecognized scope is kept as
# written.
pub @let ExtensionScope = (:SYSTEM: | :INITRD: | :PORTABLE: | Str)

# An operating system's release channel.
pub @let ReleaseType = (:STABLE: | :LTS: | :DEVELOPMENT: | :EXPERIMENT:)

# A portable-service scope. An unrecognized scope is kept as written.
pub @let PortableScope = (:SYSTEM: | :USER: | :ANY: | Str)

# Parsed operating-system identification data with standard-aware projections.
#
# Named fields apply the defaults and conversions prescribed by the
# os-release specification.
pub class OsRelease: @Index[Str, Str] @Unpack[Str, Str, Rest: Unpack[Str, Str]] Iterable[Tuple[Str, Str]]
  field values @ Dict[Str, Str]

  def (init) self values @ Dict[Str, Str]
    self.#values = values

  # Reads a parsed `os-release` assignment by key.
  pub def (index)[K] self key @ K -> IndexItem[{*(Str): Str}, K]
    self.#values[key]

  # Iterates the parsed `os-release` assignments.
  pub def (iter) self -> Iter[Tuple[Str, Str]]
    self.#values.iter()

  # Destructures the parsed `os-release` assignments.
  pub def (unpack) self -> Unpack[Str, Str, Rest: Unpack[Str, Str]]
    self.#values

  # Spreads the parsed `os-release` assignments.
  pub def (spread) self -> Spread[Str, Str]
    self.#values

  # The operating system name, defaulting to `Linux`.
  #[getter]
  pub def name self -> Str
    self.#values.get "NAME" default: "Linux"

  # The operating-system identifier, defaulting to `linux`.
  #[getter]
  pub def id self -> Str
    self.#values.get "ID" default: "linux"

  # The presentation name, defaulting to `Linux`.
  #[getter]
  pub def pretty_name self -> Str
    self.#values.get "PRETTY_NAME" default: "Linux"

  # The preformatted fancy presentation name, if defined.
  #[getter]
  pub def fancy_name self -> (term.Text | nil)
    fancy_value $ self.#values.get "FANCY_NAME" default: nil

  # The fancy name when available, otherwise the ANSI-colored presentation name.
  #[getter]
  pub def display_name self -> term.Text
    let fancy = fancy_value $ self.#values.get "FANCY_NAME" default: nil
    if (fancy != nil)
      return fancy
    let color = ansi_style $ self.#values.get "ANSI_COLOR" default: nil
    if (color == nil)
      term.preformat $ self.#values.get "PRETTY_NAME" default: "Linux"
    else
      color $ self.#values.get "PRETTY_NAME" default: "Linux"

  # An ordered set of compatible operating-system identifiers.
  #[getter]
  pub def id_like self -> Set[Str]
    Set $ words $ self.#values.get "ID_LIKE" default: ""

  # The release channel symbol, defaulting to `:STABLE:`.
  #[getter]
  pub def release_type self -> ReleaseType
    let value = self.#values.get "RELEASE_TYPE" default: "stable"
    RELEASE_TYPES.get $value default: :STABLE:

  # The portable-service scope, defaulting to `:SYSTEM:`.
  #[getter]
  pub def portable_scope self -> PortableScope
    let value = self.#values.get "PORTABLE_SCOPE" default: "system"
    PORTABLE_SCOPES.get $value default: $value

  # An ordered set of system-extension scopes.
  #[getter]
  pub def sysext_scope self -> Set[ExtensionScope]
    Set $ scopes $ self.#values.get "SYSEXT_SCOPE" default: "system portable"

  # An ordered set of configuration-extension scopes.
  #[getter]
  pub def confext_scope self -> Set[ExtensionScope]
    Set $ scopes $ self.#values.get "CONFEXT_SCOPE" default: "system portable"

  # An ordered set of portable-service unit-name prefixes.
  #[getter]
  pub def portable_prefixes self -> Set[Str]
    Set $ words $ self.#values.get "PORTABLE_PREFIXES" default: ""

  # The support end date, in UTC, if valid and defined.
  #[getter]
  pub def support_end self -> (Date | nil)
    support_end $ self.#values.get "SUPPORT_END" default: nil

  # The terminal style specified by `ANSI_COLOR`, if defined.
  #[getter]
  pub def ansi_color self -> (term.Style | nil)
    ansi_style $ self.#values.get "ANSI_COLOR" default: nil

  # The terminal style specified by `ANSI_COLOR_REVERSE`, if defined.
  #[getter]
  pub def ansi_color_reverse self -> (term.Style | nil)
    ansi_style $ self.#values.get "ANSI_COLOR_REVERSE" default: nil

  # The project's home page, if valid and defined.
  #[getter]
  pub def home_url self -> (Url | nil)
    url_value $ self.#values.get "HOME_URL" default: nil

  # The documentation URL, if valid and defined.
  #[getter]
  pub def documentation_url self -> (Url | nil)
    url_value $ self.#values.get "DOCUMENTATION_URL" default: nil

  # The support URL, if valid and defined.
  #[getter]
  pub def support_url self -> (Url | nil)
    url_value $ self.#values.get "SUPPORT_URL" default: nil

  # The bug-report URL, if valid and defined.
  #[getter]
  pub def bug_report_url self -> (Url | nil)
    url_value $ self.#values.get "BUG_REPORT_URL" default: nil

  # The privacy-policy URL, if valid and defined.
  #[getter]
  pub def privacy_policy_url self -> (Url | nil)
    url_value $ self.#values.get "PRIVACY_POLICY_URL" default: nil

  # The vendor's URL, if valid and defined.
  #[getter]
  pub def vendor_url self -> (Url | nil)
    url_value $ self.#values.get "VENDOR_URL" default: nil

  # The experiment URL, if valid and defined.
  #[getter]
  pub def experiment_url self -> (Url | nil)
    url_value $ self.#values.get "EXPERIMENT_URL" default: nil

  # The human-readable operating-system version, if defined.
  #[getter]
  pub def version self -> (Str | nil)
    self.#values.get "VERSION" default: nil

  # The operating-system version identifier, if defined.
  #[getter]
  pub def version_id self -> (Str | nil)
    self.#values.get "VERSION_ID" default: nil

  # The operating-system version codename, if defined.
  #[getter]
  pub def version_codename self -> (Str | nil)
    self.#values.get "VERSION_CODENAME" default: nil

  # The human-readable operating-system variant, if defined.
  #[getter]
  pub def variant self -> (Str | nil)
    self.#values.get "VARIANT" default: nil

  # The operating-system variant identifier, if defined.
  #[getter]
  pub def variant_id self -> (Str | nil)
    self.#values.get "VARIANT_ID" default: nil

  # The build identifier, if defined.
  #[getter]
  pub def build_id self -> (Str | nil)
    self.#values.get "BUILD_ID" default: nil

  # The image identifier, if defined.
  #[getter]
  pub def image_id self -> (Str | nil)
    self.#values.get "IMAGE_ID" default: nil

  # The image version, if defined.
  #[getter]
  pub def image_version self -> (Str | nil)
    self.#values.get "IMAGE_VERSION" default: nil

  # The CPE name, if defined.
  #[getter]
  pub def cpe_name self -> (Str | nil)
    self.#values.get "CPE_NAME" default: nil

  # The icon name for the operating system, if defined.
  #[getter]
  pub def logo self -> (Str | nil)
    self.#values.get "LOGO" default: nil

  # The vendor name, if defined.
  #[getter]
  pub def vendor_name self -> (Str | nil)
    self.#values.get "VENDOR_NAME" default: nil

  # The experiment identifier, if defined.
  #[getter]
  pub def experiment self -> (Str | nil)
    self.#values.get "EXPERIMENT" default: nil

  # The default hostname, if defined.
  #[getter]
  pub def default_hostname self -> (Str | nil)
    self.#values.get "DEFAULT_HOSTNAME" default: nil

  # The system-extension compatibility level, if defined.
  #[getter]
  pub def sysext_level self -> (Str | nil)
    self.#values.get "SYSEXT_LEVEL" default: nil

  # The configuration-extension compatibility level, if defined.
  #[getter]
  pub def confext_level self -> (Str | nil)
    self.#values.get "CONFEXT_LEVEL" default: nil

# Returns parsed OS-identification data from an `os-release` file.
pub def os_release
  # File to read. Defaults to
  # `/etc/os-release`, falling back to `/usr/lib/os-release` as required by
  # the os-release specification.
  :path @ (Str | Path) = nil
do -> OsRelease
  if (path == nil)
    let etc = Path /etc/os-release
    path = if etc.exists()
      etc
    else
      Path /usr/lib/os-release
  OsRelease (read_keys path)
