# Run block-scoped operations between Windows and WSL Linux through a remote
# VFS.

import _wsl sys
import std:
  - RuntimeError

def require_windows()
  if (sys.os_info().family != :WINDOWS:)
    throw RuntimeError "wsl.with_linux requires a Windows VFS target"

def require_linux()
  if (sys.os_info().os != :LINUX:)
    throw RuntimeError "wsl.with_windows requires a Linux VFS target"

def find_windows_command()
  require_linux()
  let vfs = run["dolang-vfs.exe"].which()
  if (vfs != nil)
    return [vfs]

  let dolang = run["dolang.exe"].which()
  if (dolang != nil)
    return [dolang, "--vfs"]

  throw RuntimeError "wsl.with_windows: neither dolang-vfs.exe nor dolang.exe was found"

# Runs `block` in a WSL Linux distribution through a stdio VFS.
#
# The active VFS target must be Windows.
#
# ## Returns
#
# The result of `block`.
pub def with_linux
  # ([`Func`](std.Func)) Block to run in Linux.
  block
  # ([`Str`](std.Str)) WSL distribution. Defaults to WSL's configured
  # default.
  :distro = nil
  # ([`Str`](std.Str)) Linux user. Defaults to WSL's configured default.
  :user = nil
  # ([`Iterable`](std.Iterable)) Linux VFS launcher command and arguments.
  :command = ["dolang-vfs"]
  # ([`Str`](std.Str)\|[`Path`](fs.Path)) Initial Linux working directory.
  :cd = nil
  # ([`Dict`](std.Dict)) Initial Linux environment overrides.
  :env = {}
do
  require_windows()
  let executable = run["wsl.exe"].which()
  if (executable == nil)
    throw RuntimeError "wsl.with_linux: wsl.exe was not found"
  let argv = _wsl.build_linux_command $command :distro :user :cd :env
  argv[0] = executable
  _wsl.with_command $argv $block

# Runs `block` on the Windows host through WSL interoperability and a stdio
# VFS. The active VFS target must be Linux.
#
# ## Returns
#
# The result of `block`.
pub def with_windows
  # ([`Func`](std.Func)) Block to run on Windows.
  block
  # ([`Iterable`](std.Iterable)) Windows VFS launcher command and arguments.
  # Defaults to `dolang-vfs.exe`, preferring `dolang.exe --vfs` as a
  # fallback.
  :command = find_windows_command()
  # ([`Str`](std.Str)\|[`Path`](fs.Path)) Initial Windows working directory.
  :cd = nil
  # ([`Dict`](std.Dict)) Initial Windows environment overrides.
  :env = {}
do
  require_linux()
  let argv = _wsl.build_windows_command $command :cd :env
  _wsl.with_command $argv $block
