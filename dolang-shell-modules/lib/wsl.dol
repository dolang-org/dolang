# dolang: strict
# Run block-scoped operations between Windows and WSL Linux through a remote
# VFS.

import _wsl sys
  fs:
    - @Path
import std:
  - @BaseDict
  - RuntimeError

def require_windows() -> nil
  if (sys.os_info().family != :WINDOWS:)
    throw RuntimeError "wsl.with_linux requires a Windows VFS target"

def require_linux() -> nil
  if (sys.os_info().os != :LINUX:)
    throw RuntimeError "wsl.with_windows requires a Linux VFS target"

def find_windows_command() -> [Str | Path]
  require_linux()
  let vfs = run["dolang-vfs.exe"].which()
  if (vfs != nil)
    return [vfs]

  let dolang = run["dolang.exe"].which()
  if (dolang != nil)
    return [dolang, "--vfs"]

  throw RuntimeError "wsl.with_windows: neither dolang-vfs.exe nor dolang.exe was found"

# Runs `block` in a WSL Linux distribution through a stdio VFS.
#
# The active VFS target must be Windows.
pub def with_linux[R]
  # Block to run in Linux.
  block @ (() -> R)
  # WSL distribution. Defaults to WSL's configured
  # default.
  :distro @ Str = nil
  # Linux user. Defaults to WSL's configured default.
  :user @ Str = nil
  # Linux VFS launcher command and arguments.
  :command @ Iterable[Value] = ["dolang-vfs"]
  # Initial Linux working directory.
  :cd @ (Str | Path) = nil
  # Initial Linux environment overrides.
  :env @ BaseDict[Str | Sym, Value] = {}
do -> R
  require_windows()
  let executable = run["wsl.exe"].which()
  if (executable == nil)
    throw RuntimeError "wsl.with_linux: wsl.exe was not found"
  let argv = _wsl.build_linux_command $command :env
    if (distro != nil)
      :distro
    if (user != nil)
      :user
    if (cd != nil)
      :cd
  argv[0] = executable
  _wsl.with_command $argv $block

# Runs `block` on the Windows host through WSL interoperability and a stdio
# VFS. The active VFS target must be Linux.
pub def with_windows[R]
  # Block to run on Windows.
  block @ (() -> R)
  # Windows VFS launcher command and arguments.
  # Defaults to `dolang-vfs.exe`, preferring `dolang.exe --vfs` as a
  # fallback.
  :command @ Iterable[Value] = find_windows_command()
  # Initial Windows working directory.
  :cd @ (Str | Path) = nil
  # Initial Windows environment overrides.
  :env @ BaseDict[Str | Sym, Value] = {}
do -> R
  require_linux()
  let argv = _wsl.build_windows_command $command :env
    if (cd != nil)
      :cd
  _wsl.with_command $argv $block
