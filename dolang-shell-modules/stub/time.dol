# dolang: strict
# Instants, time zones, calendar dates, durations, sleeping, and scoped timeouts.
#
# A [`DateTime`](time.DateTime) is an instant, with no zone. To read its wall
# time, date or offset somewhere, view it in a [`TimeZone`](time.TimeZone)
# with [`zoned`](time.DateTime.zoned). Functions that take a `zone:` key use
# UTC when it is omitted; pass `zone: TimeZone.local()` for the system zone.
#
# ## Patterns {: #time.patterns }
#
# [`DateTime.format`](time.DateTime.format),
# [`DateTime.parse`](time.DateTime.parse) and
# [`Zoned.format`](time.Zoned.format) take strftime-style patterns, such as
# `%Y-%m-%d %H:%M:%S %Z`. `%Z` is the zone abbreviation, `%z` the offset, and
# `%Q` the IANA zone name.
#
# ## Duration arguments {: #time.duration-arguments }
#
# Wherever a duration is accepted, it may be given either as a
# [`Duration`](time.Duration) or as a plain number of seconds --
# [`Int`](std.Int) or [`Float`](std.Float). Numeric durations must
# be non-negative, and floating-point ones finite.

# A UTC instant, held as Unix nanoseconds.
#
# There is no constructor; use [`now`](time.DateTime.now),
# [`from_unix`](time.DateTime.from_unix) or
# [`parse_rfc`](time.DateTime.parse_rfc).
pub class DateTime
  # Returns the current UTC instant.
  #
  # ## Example
  #
  # ```
  # echo $DateTime.now()
  # ```
  #[class]
  pub def now self -> DateTime
    ...

  # Builds an instant from a Unix timestamp.
  #
  # At least one of `seconds` and `nanos` must be given. When both are, `nanos`
  # is added to `seconds`, which is how a whole-seconds timestamp and a
  # sub-second remainder are combined without going through a float.
  #
  # ## Errors
  #
  # | Exception        | Condition                                           |
  # | ---------------- | --------------------------------------------------- |
  # | `TypeError`      | Neither argument was given                          |
  # | `OverflowError`  | The combined timestamp does not fit                 |
  #
  # ## Example
  #
  # ```
  # echo $ DateTime.from_unix 1700000000
  # echo $ DateTime.from_unix 1.25
  # echo $ DateTime.from_unix nanos: 1700000000123000000
  # echo $ DateTime.from_unix 1700000000 nanos: 123000000
  # ```
  #[class]
  pub def from_unix
    self
    # Seconds since the
    # Unix epoch.
    seconds @ (Int | Float) = ...
    # Nanoseconds since the Unix epoch, or, when
    # `seconds` is also given, nanoseconds to add to it.
    :nanos @ Int = ...
  do -> DateTime
    ...

  # Parses an RFC 3339 date-time.
  #
  # An offset is required, and is applied to give the UTC instant; the offset
  # itself is not retained.
  #
  # ## Errors
  #
  # [`DataError`](std.DataError) if the input is not a valid RFC 3339
  # string.
  #
  # ## Example
  #
  # ```playground
  # #> import time:
  # #>   - DateTime
  # #> import test:
  # #>   - assert_eq
  # let dt = DateTime.parse_rfc("2024-01-02T03:04:05Z")
  # assert_eq $dt.rfc() "2024-01-02T03:04:05Z"
  # ```
  #[class]
  pub def parse_rfc
    self
    # Date-time text.
    text @ Str
  do -> DateTime
    ...

  # Parses text with a [pattern](time.patterns).
  #
  # When the text has an offset (`%z`), it gives the instant. Otherwise the
  # text is wall time in `zone`: a time that happens twice is the earlier
  # instant, and one skipped by a transition moves forward by the gap.
  #
  # ## Errors
  #
  # [`DataError`](std.DataError) if the text does not match the pattern, or
  # does not name a date and time.
  #
  # ## Example
  #
  # ```playground
  # #> import time:
  # #>   - DateTime
  # #>   - TimeZone
  # #> import test:
  # #>   - assert_eq
  # let ny = TimeZone.get America/New_York
  # let dt = DateTime.parse "%Y-%m-%d %H:%M" "2024-07-01 09:30" zone: $ny
  # assert_eq $dt.rfc() "2024-07-01T13:30:00Z"
  # ```
  #[class]
  pub def parse
    self
    # Pattern to match.
    pattern @ Str
    # Date-time text.
    text @ Str
    # Zone for text without an offset. UTC by default.
    :zone @ TimeZone = ...
  do -> DateTime
    ...

  # Unix seconds. Approximate: far-from-epoch
  # instants lose sub-second precision.
  #[getter]
  pub def unix_secs self -> Float
    ...

  # Unix nanoseconds. Exact.
  #[getter]
  pub def unix_nanos self -> Int
    ...

  # UTC calendar date. For the date in another zone, use
  # [`zoned`](time.DateTime.zoned).
  #
  # ## Errors
  #
  # [`OverflowError`](std.OverflowError) if the instant is outside the
  # supported range.
  #[getter]
  pub def date self -> Date
    ...

  # Views this instant in a time zone.
  #
  # ## Example
  #
  # ```
  # let local = DateTime.now().zoned(TimeZone.local())
  # echo "$(local.hour):$(local.minute)"
  # ```
  pub def zoned
    self
    # Zone to view the instant in.
    zone @ TimeZone
  do -> Zoned
    ...

  # Formats this instant with a [pattern](time.patterns).
  #
  # The same as `dt.zoned(zone).format(pattern)`.
  #
  # ## Errors
  #
  # [`ValueError`](std.ValueError) if the pattern is invalid.
  #
  # ## Example
  #
  # ```
  # echo $ DateTime.now().format "%H:%M %Z" zone: $TimeZone.local()
  # ```
  pub def format
    self
    # Pattern to format with.
    pattern @ Str
    # Zone for the wall time. UTC by default.
    :zone @ TimeZone = ...
  do -> Str
    ...

  # Returns the RFC 3339 representation, in UTC.
  #
  # ## Example
  #
  # ```
  # let dt = DateTime.from_unix(1700000000)
  # echo $dt.rfc()
  # ```
  pub def rfc self -> Str
    ...

  # Compares two instants.
  pub def (eq) self other @ Value -> Bool
    ...

  # Orders two instants.
  pub def (lt) self other @ DateTime -> Bool
    ...

  # Returns the [`Duration`](time.Duration) from `other` to this instant.
  #
  # ## Example
  #
  # ```
  # let elapsed = (finish - start)
  # echo $elapsed.secs
  # ```
  pub def (sub)
    self
    # Instant to subtract.
    other @ DateTime
  do -> Duration
    ...

  # Returns the RFC 3339 representation, as [`rfc`](time.DateTime.rfc) does.
  pub def (str) self -> Str
    ...

# A calendar date, with no time of day and no time zone.
#
# To shift a date, use [`add_days`](time.Date.add_days) and
# [`sub_days`](time.Date.sub_days) -- a [`Duration`](time.Duration) cannot be
# added to a `Date`.
pub class Date
  # Returns the current date.
  #[class]
  pub def today
    self
    # Zone whose date to return. UTC by default.
    :zone @ TimeZone = ...
  do -> Date
    ...

  # Builds a date from calendar components.
  #
  # ## Errors
  #
  # [`ValueError`](std.ValueError) if the month is out of range, or the
  # components are not a real date.
  #
  # ## Example
  #
  # ```
  # let d = Date.from_ymd 2024 1 2
  # let d = Date.from_ymd 2024 $Month.JANUARY 2
  # ```
  #[class]
  pub def from_ymd
    self
    # Calendar year.
    year @ Int
    # Month, or its number from
    # 1 through 12.
    month @ (Month | Int)
    # Day of month.
    day @ Int
  do -> Date
    ...

  # Parses an RFC full-date, `YYYY-MM-DD`.
  #
  # ## Errors
  #
  # [`DataError`](std.DataError) if the input is not a valid `YYYY-MM-DD`
  # date.
  #[class]
  pub def parse_rfc
    self
    # Date text.
    text @ Str
  do -> Date
    ...

  # Calendar year.
  #[getter]
  pub def year self -> Int
    ...

  # Calendar month.
  #[getter]
  pub def month self -> Month
    ...

  # Day of month.
  #[getter]
  pub def day self -> Int
    ...

  # Day of week.
  #[getter]
  pub def weekday self -> Weekday
    ...

  # Returns the RFC full-date representation, `YYYY-MM-DD`.
  pub def rfc self -> Str
    ...

  # Returns the start of this date.
  #
  # This is midnight in `zone`, or, when a transition skips midnight, the
  # first instant of the day.
  pub def datetime
    self
    # Zone whose midnight to return. UTC by default.
    :zone @ TimeZone = ...
  do -> DateTime
    ...

  # Returns the date a signed number of days later.
  #
  # ## Errors
  #
  # [`OverflowError`](std.OverflowError) if the result is outside the
  # supported range.
  #
  # ## Example
  #
  # ```
  # let tomorrow = Date.today().add_days(1)
  # ```
  pub def add_days
    self
    # Days to add. May be negative.
    days @ Int
  do -> Date
    ...

  # Returns the date a signed number of days earlier.
  #
  # ## Errors
  #
  # [`OverflowError`](std.OverflowError) if the result is outside the
  # supported range.
  pub def sub_days
    self
    # Days to subtract. May be negative.
    days @ Int
  do -> Date
    ...

  # Compares two dates.
  pub def (eq) self other @ Value -> Bool
    ...

  # Orders two dates.
  pub def (lt) self other @ Date -> Bool
    ...

  # Returns the [`Duration`](time.Duration) between the two dates' midnights.
  #
  # The result is always a whole number of days.
  pub def (sub)
    self
    # Date to subtract.
    other @ Date
  do -> Duration
    ...

  # Returns the `YYYY-MM-DD` form, as [`rfc`](time.Date.rfc) does.
  pub def (str) self -> Str
    ...

# A calendar month.
#
# The twelve months are class fields, `Month.JANUARY` through `Month.DECEMBER`,
# and are also indexable by number: `Month[1]` through `Month[12]`. There is no
# constructor; the twelve values are the only instances.
#
# ## Example
#
# ```
# assert_eq $Month[1] $Month.JANUARY
# assert (Month.JANUARY < Month.FEBRUARY)
# ```
pub class Month
  # January.
  #[class]
  pub field JANUARY @ Month = ...

  # February.
  #[class]
  pub field FEBRUARY @ Month = ...

  # March.
  #[class]
  pub field MARCH @ Month = ...

  # April.
  #[class]
  pub field APRIL @ Month = ...

  # May.
  #[class]
  pub field MAY @ Month = ...

  # June.
  #[class]
  pub field JUNE @ Month = ...

  # July.
  #[class]
  pub field JULY @ Month = ...

  # August.
  #[class]
  pub field AUGUST @ Month = ...

  # September.
  #[class]
  pub field SEPTEMBER @ Month = ...

  # October.
  #[class]
  pub field OCTOBER @ Month = ...

  # November.
  #[class]
  pub field NOVEMBER @ Month = ...

  # December.
  #[class]
  pub field DECEMBER @ Month = ...

  # Returns the following month, wrapping from December to January.
  pub def next self -> Month
    ...

  # Returns the preceding month, wrapping from January to December.
  pub def previous self -> Month
    ...

  # Returns the month with the given number.
  #
  # ## Errors
  #
  # | Exception                             | Condition                     |
  # | ------------------------------------- | ----------------------------- |
  # | [`ValueError`](std.ValueError) | The number is not 1 through 12 |
  #
  # ## Example
  #
  # ```
  # assert_eq $Month[1] $Month.JANUARY
  # ```
  #[class]
  pub def (index)
    self
    # Month number, 1 through 12.
    number @ Int
  do -> Month
    ...

  # Compares two months.
  pub def (eq) self other @ Value -> Bool
    ...

  # Orders two months, in calendar order.
  pub def (lt) self other @ Month -> Bool
    ...

  # Returns the uppercase English name, such as `JANUARY`.
  pub def (str) self -> Str
    ...

# A day of the week.
#
# The seven days are class fields, `Weekday.MONDAY` through `Weekday.SUNDAY`.
# There is no constructor, and the type is not indexable the way
# [`Month`](time.Month) is. Weekdays are not ordered, so `<` and friends raise.
pub class Weekday
  # Monday.
  #[class]
  pub field MONDAY @ Weekday = ...

  # Tuesday.
  #[class]
  pub field TUESDAY @ Weekday = ...

  # Wednesday.
  #[class]
  pub field WEDNESDAY @ Weekday = ...

  # Thursday.
  #[class]
  pub field THURSDAY @ Weekday = ...

  # Friday.
  #[class]
  pub field FRIDAY @ Weekday = ...

  # Saturday.
  #[class]
  pub field SATURDAY @ Weekday = ...

  # Sunday.
  #[class]
  pub field SUNDAY @ Weekday = ...

  # Returns the following weekday, wrapping from Sunday to Monday.
  pub def next self -> Weekday
    ...

  # Returns the preceding weekday, wrapping from Monday to Sunday.
  pub def previous self -> Weekday
    ...

  # Compares two weekdays.
  pub def (eq) self other @ Value -> Bool
    ...

  # Returns the uppercase English name, such as `MONDAY`.
  pub def (str) self -> Str
    ...

# A time zone: the rules that give the offset from UTC at each instant.
#
# There is no constructor; use [`local`](time.TimeZone.local),
# [`utc`](time.TimeZone.utc), [`get`](time.TimeZone.get) or
# [`fixed`](time.TimeZone.fixed).
pub class TimeZone
  # Returns the system time zone.
  #
  # This follows the `TZ` environment variable when it is set, and otherwise
  # the system configuration. In the browser it is the browser's zone. When
  # neither gives a zone, as on some minimal container or VM images, the
  # result behaves like UTC and has no [`name`](time.TimeZone.name).
  #[class]
  pub def local self -> TimeZone
    ...

  # Returns UTC.
  #[class]
  pub def utc self -> TimeZone
    ...

  # Looks up a zone by its IANA name, such as `America/New_York`.
  #
  # ## Errors
  #
  # [`DataError`](std.DataError) if there is no zone by that name.
  #[class]
  pub def get
    self
    # IANA zone name.
    name @ Str
  do -> TimeZone
    ...

  # Returns a zone with one offset at every instant.
  #
  # ## Errors
  #
  # [`ValueError`](std.ValueError) if the offset is not a whole number of
  # seconds, or is beyond 25:59:59 either way.
  #
  # ## Example
  #
  # ```
  # let est = TimeZone.fixed -18000
  # ```
  #[class]
  pub def fixed
    self
    # Offset east of UTC. Unlike other
    # [duration arguments](time.duration-arguments), it may be negative.
    offset @ (Duration | Int | Float)
  do -> TimeZone
    ...

  # IANA name, or `nil` for a fixed or unnamed zone.
  #[getter]
  pub def name self -> (Str | nil)
    ...

  # Returns the offset from UTC at an instant.
  pub def offset_at
    self
    # Instant to look up.
    datetime @ DateTime
  do -> Duration
    ...

  # Returns the instant at a wall time in this zone.
  #
  # Around a transition, a wall time can happen twice, or not at all.
  # `disambiguate` chooses the result:
  #
  # | Value           | Repeated time       | Skipped time                    |
  # | --------------- | ------------------- | ------------------------------- |
  # | `:COMPATIBLE:`  | The earlier instant | Moved forward by the gap        |
  # | `:EARLIER:`     | The earlier instant | Moved back by the gap           |
  # | `:LATER:`       | The later instant   | Moved forward by the gap        |
  # | `:REJECT:`      | Raises `ValueError` | Raises `ValueError`             |
  #
  # ## Errors
  #
  # [`ValueError`](std.ValueError) if the components are not a real date and
  # time, or `disambiguate` is `:REJECT:` and the time is ambiguous.
  #
  # ## Example
  #
  # ```playground
  # #> import time:
  # #>   - TimeZone
  # #> import test:
  # #>   - assert_eq
  # let ny = TimeZone.get America/New_York
  # let dt = ny.datetime 2024 11 3 hour: 1 minute: 30 disambiguate: :LATER:
  # assert_eq $dt.rfc() "2024-11-03T06:30:00Z"
  # ```
  pub def datetime
    self
    # Calendar year.
    year @ Int
    # Month, or its number from
    # 1 through 12.
    month @ (Month | Int)
    # Day of month.
    day @ Int
    # Hour, 0 through 23. 0 by default.
    :hour @ Int = ...
    # Minute. 0 by default.
    :minute @ Int = ...
    # Second. 0 by default.
    :second @ Int = ...
    # Nanosecond within the second. 0 by default.
    :nanosecond @ Int = ...
    # How to resolve an ambiguous wall time. `:COMPATIBLE:` by default.
    :disambiguate @ (:COMPATIBLE: | :EARLIER: | :LATER: | :REJECT:) = ...
  do -> DateTime
    ...

  # Compares two zones by their rules.
  #
  # Zones are equal when they give the same offset and abbreviation at every
  # instant, so aliases such as `US/Eastern` and `America/New_York` are
  # equal.
  pub def (eq) self other @ Value -> Bool
    ...

  # Returns the IANA name, a fixed zone's offset such as `-05:00`, or
  # `unnamed`.
  pub def (str) self -> Str
    ...

# An instant viewed in a time zone.
#
# Returned by [`DateTime.zoned`](time.DateTime.zoned). The parts are the wall
# time in the zone. Zoned values compare by instant, whatever their zones.
#
# ## Example
#
# ```
# let z = DateTime.now().zoned(TimeZone.local())
# echo $ z.format "%Y-%m-%d %H:%M %Z"
# ```
pub class Zoned
  # Calendar year.
  #[getter]
  pub def year self -> Int
    ...

  # Calendar month.
  #[getter]
  pub def month self -> Month
    ...

  # Day of month.
  #[getter]
  pub def day self -> Int
    ...

  # Hour, 0 through 23.
  #[getter]
  pub def hour self -> Int
    ...

  # Minute.
  #[getter]
  pub def minute self -> Int
    ...

  # Second.
  #[getter]
  pub def second self -> Int
    ...

  # Nanosecond within the second.
  #[getter]
  pub def nanosecond self -> Int
    ...

  # Day of week.
  #[getter]
  pub def weekday self -> Weekday
    ...

  # Calendar date in the zone.
  #[getter]
  pub def date self -> Date
    ...

  # Offset from UTC.
  #[getter]
  pub def offset self -> Duration
    ...

  # Zone abbreviation, such as `EST`. For display only: abbreviations are not
  # unique.
  #[getter]
  pub def abbrev self -> Str
    ...

  # Time zone.
  #[getter]
  pub def zone self -> TimeZone
    ...

  # The instant.
  #[getter]
  pub def datetime self -> DateTime
    ...

  # Returns the RFC 3339 representation, with the offset, such as
  # `2024-01-02T03:04:05-05:00`.
  pub def rfc self -> Str
    ...

  # Formats with a [pattern](time.patterns).
  #
  # ## Errors
  #
  # [`ValueError`](std.ValueError) if the pattern is invalid.
  pub def format
    self
    # Pattern to format with.
    pattern @ Str
  do -> Str
    ...

  # Compares two instants.
  pub def (eq) self other @ Value -> Bool
    ...

  # Orders two instants.
  pub def (lt) self other @ Zoned -> Bool
    ...

  # Returns the RFC 3339 representation, as [`rfc`](time.Zoned.rfc) does.
  pub def (str) self -> Str
    ...

# A signed time span, with nanosecond precision.
#
# There is no constructor. Durations come from subtracting two
# [`DateTime`](time.DateTime)s or two [`Date`](time.Date)s, and from APIs
# elsewhere that report elapsed time.
#
# Durations do not support arithmetic: they cannot be added, subtracted, scaled
# or negated.
pub class Duration
  # Seconds. Approximate: long spans lose
  # sub-second precision.
  #[getter]
  pub def secs self -> Float
    ...

  # Total nanoseconds. Exact.
  #[getter]
  pub def nanos self -> Int
    ...

  # Compares two durations.
  pub def (eq) self other @ Value -> Bool
    ...

  # Orders two durations.
  pub def (lt) self other @ Duration -> Bool
    ...

  # Returns a compact seconds form, such as `0s`, `2.5s` or `-2.5s`.
  pub def (str) self -> Str
    ...

# Suspends the current strand.
#
# ## Errors
#
# [`ValueError`](std.ValueError) if the duration is negative, or a
# non-finite float.
#
# ## Example
#
# ```
# sleep 0.25
# sleep (finish - start)
# ```
pub def sleep
  # How long to sleep. See [Duration
  # arguments](time.duration-arguments).
  duration @ (Duration | Int | Float)
do
  ...

# Runs a block under a scoped timeout.
#
# When the duration elapses, the block's strand is interrupted. The interrupt
# arrives when the block next waits, as for I/O or [`sleep`](time.sleep), so a
# block that computes without waiting may run to completion. The timeout ends when
# the block does, however it exits.
#
# ## Errors
#
# | Exception                            | Condition                                       |
# | ------------------------------------ | ----------------------------------------------- |
# | [`ValueError`](std.ValueError)       | The duration is negative, or a non-finite float |
# | [`TimedOutError`](std.TimedOutError) | The timeout elapsed before the block completed  |
#
# ## Example
#
# ```
# timeout 1 do
#   sleep 10
# ```
pub def timeout[R]
  # How long the block may run. See [Duration
  # arguments](time.duration-arguments).
  duration @ (Duration | Int | Float)
  # Block to run.
  block @ (() -> R)
do -> R
  ...
