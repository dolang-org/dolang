# dolang: strict
# Compiles Do source to bytecode and describes what it declares.
#
# ## Usage
#
# ```
# let source = "let x = (1 + 2)"
# let unit = compile "example.dol" $source
# let bytecode = unit.emit()
# ```
#
# ## Document nodes
#
# A unit compiled with `document: true` also describes what the source
# declares, as a tree of [`Node`](compile.Node) objects reached through
# [`Unit.nodes`](compile.Unit.nodes). Most of a node's interesting text is
# reported as a [`Span`](compile.Span) rather than a string: the source is
# already in hand, so a span says where a name was written without copying it.
#
# ```
# let unit = compile "example.dol" $source document: true
# for id node = unit.nodes()
#   echo $id $node.span
# ```

import term:
  - @Text

# What a prelude binds a module to: an alias, an array of items, or a
# dictionary of items to their aliases. Prefix an item name with `@` to bind it
# only in types; aliases are written without the prefix.
pub @let PreludeBinding = $
  | Str
  | Sym
  | BaseArray[Str | Sym]
  | BaseDict[Str | Sym, Str | Sym]

# Imports to bind before compiled source: a module name, an array of module
# names, or a dictionary of module names to their bindings. Positional
# dictionary entries import unaliased modules.
pub @let Prelude = $
  | Str
  | Sym
  | BaseArray[Str | Sym]
  | BaseDict[{*(Str | Sym), *(Str | Sym): PreludeBinding}]

# A staged compilation unit.
#
# Provides diagnostics and document nodes for one source file before emitting
# bytecode.
#
# ## Example
#
# ```
# let unit = compile "example.dol" "pub let answer = 42\n" document: true
# for id node = unit.nodes()
#   echo $id $node.span
# let bytecode = unit.emit()
# ```
pub class Unit
  # Returns a fresh iterator of diagnostics.
  pub def diagnostics self -> Iter[Diagnostic]
    ...

  # Returns a fresh iterator of node IDs paired with their nodes.
  #
  # Empty unless the unit was compiled with `document: true`. An enabled unit
  # always contains one [`Root`](compile.Root), even for empty source.
  #
  # ## Example
  #
  # ```
  # for id node = unit.nodes()
  #   echo $id $node.span
  # ```
  pub def nodes self -> Iter[Tuple[NodeId, Node]]
    ...

  # The [`Root`](compile.Root) node, or `nil` unless the unit was compiled with
  # `document: true`.
  #[getter]
  pub def root self -> (Root | nil)
    ...

  # Returns the modules the unit imports, by statement or through the prelude
  # bindings it uses, each once, in order.
  #
  # Empty unless the unit was compiled with `document: true`.
  #
  # ## Errors
  #
  # Raises `std.StateError` if the unit was emitted.
  pub def imports self -> Iterable[Str]
    ...

  # Looks up a node by [`NodeId`](compile.NodeId).
  #
  # ## Returns
  #
  # `nil` when the ID belongs to another unit.
  pub def node
    self
    # The ID to look up.
    id @ NodeId
  do -> (Node | nil)
    ...

  # Returns a fresh iterator of tokens covering the whole source, in source
  # order.
  #
  # ## Example
  #
  # ```
  # for token = unit.tokens()
  #   echo $token.kind $token.span
  # ```
  pub def tokens self -> Iter[Token]
    ...

  # Consumes the unit and returns its bytecode.
  #
  # ## Errors
  #
  # | Exception          | Condition                                          |
  # | ------------------ | -------------------------------------------------- |
  # | `std.CompileError` | Compilation failed                                 |
  # | `std.StateError`   | The unit, its node iterators, or its nodes are used after emission |
  pub def emit self -> Bin
    ...

# A module's typelib: its declarations as [`check`](compile.check) reads them,
# without its source.
#
# Checking units against a typelib checks them against the module's
# declarations, but not the module's own bodies. A typelib is read only by the
# version of Do that wrote it.
#
# ## Example
#
# ```
# let lib = compile "lib.dol" $lib_source module: lib typecheck: true
# let result = check [lib] typelibs: true
# let typelib = Typelib $result.typelib(lib)
# echo $typelib.module ...typelib.imports()
# ```
pub class Typelib
  # Reads a typelib.
  #
  # ## Errors
  #
  # [`ValueError`](std.ValueError) if `bytes` is malformed, or from another
  # version of Do.
  pub def (init)
    self
    # Bytes from [`Check.typelib`](compile.Check.typelib).
    bytes @ Bin
  do
    ...

  # The module's name.
  #[getter]
  pub def module self -> Str
    ...

  # The path of the module's source when the typelib was written.
  #[getter]
  pub def path self -> Str
    ...

  # Returns the modules the module imports or its declarations name, each once, in
  # order. [`check`](compile.check) reports those it isn't given as not found.
  pub def imports self -> Iterable[Str]
    ...

# An opaque handle identifying one node within a [`Unit`](compile.Unit).
#
# IDs compare equal and hash by identity, so they work as dict keys and as a
# way to recognize a node reached by more than one route. An ID from one unit
# never matches a node in another: [`Unit.node`](compile.Unit.node) returns `nil`
# rather than a foreign node.
#
# ## Example
#
# ```
# let seen = {}
# for id node = unit.nodes()
#   seen[id] = node.span
# ```
pub class NodeId

# Supertype of every document node.
#
# Nodes form a tree rooted at [`Root`](compile.Root), reached through
# [`Unit.root`](compile.Unit.root) or [`Unit.nodes`](compile.Unit.nodes). The
# four intermediate supertypes -- [`Declaration`](compile.Declaration),
# [`Param`](compile.Param), [`Block`](compile.Block), and
# [`Reference`](compile.Reference) -- group the concrete kinds by what they
# carry, so a consumer can match on the level it cares about.
#
# A node is a view of its unit, so reaching the same node twice may give two
# objects. Nodes compare and hash by unit and ID, as a
# [`NodeId`](compile.NodeId) does.
pub class Node
  # The nodes whose parent is this one, in no particular order. Sort them by
  # [`span`](compile.Node.span) for source order.
  #[getter]
  pub def children self -> Array[Node]
    ...

  # The span of the comment block documenting the node, or `nil` where none
  # attaches.
  #[getter]
  pub def doc self -> (Span | nil)
    ...

  # The node's ID.
  #[getter]
  pub def id self -> NodeId
    ...

  # The ID of the enclosing node, or `nil` for
  # [`Root`](compile.Root).
  #[getter]
  pub def parent self -> (NodeId | nil)
    ...

  # The span the node covers in the source, or `nil` for a
  # prelude node, which has no source text.
  #[getter]
  pub def span self -> (Span | nil)
    ...

# The complete source document.
#
# A unit compiled with `document: true` always has exactly one, even for empty
# source. It spans the whole source, has no parent, and parents every other
# top-level node. Its `doc` is the initial comment block on the first line, or
# immediately after an initial `#!` line.
pub class Root: Node

# Supertype of the nodes that bind a name.
#
# Every subtype reports a `name`. Most report it as a [`Span`](compile.Span) into
# the source; [`PreludeModule`](compile.PreludeModule) and
# [`PreludeItem`](compile.PreludeItem) report a [`Str`](std.Str) instead,
# since a prelude binding has no source text to point at.
pub class Declaration: Node
  # The bound name.
  #[getter]
  pub def name self -> (Span | Str)
    ...

# A class declaration.
#
# Each superclass is a [`Type`](compile.Type) node the class parents.
pub class Class: Declaration
  # Whether the class was declared `pub`.
  #[getter]
  pub def is_pub self -> Bool
    ...

  # Whether the class is a protocol, declared `@class Name`.
  #[getter]
  pub def type_only self -> Bool
    ...

# A `def` at statement level.
pub class Function: Declaration
  # Whether the function was declared `pub`. An overload is public when its
  # implementation is.
  #[getter]
  pub def is_pub self -> Bool
    ...

  # Whether the function is an overload signature, declared `@def name`.
  #[getter]
  pub def type_only self -> Bool
    ...

# A `def` in a class body. Its class is its parent.
pub class Method: Declaration
  # Whether the method was declared `pub`. An overload is public when its
  # implementation is.
  #[getter]
  pub def is_pub self -> Bool
    ...

  # Whether the method has no body: an overload signature or a protocol member.
  #[getter]
  pub def type_only self -> Bool
    ...

# A method implementing a protocol, such as `(init)` or `(next)`. Its class is
# its parent.
#
# The `name` span includes the parentheses the protocol name is written in. A
# special method is part of the type's interface however it was declared, so
# there is no visibility to report.
pub class SpecialMethod: Declaration
  # Whether the method has no body: an overload signature or a protocol member.
  #[getter]
  pub def type_only self -> Bool
    ...

# A field declaration in a class body. Its class is its parent.
#
# A declaration naming several fields yields one node per name.
pub class Field: Declaration
  # Whether the field was declared `pub`.
  #[getter]
  pub def is_pub self -> Bool
    ...

# A `let` or other binding.
pub class Bind: Declaration

# A type alias.
pub class Alias: Declaration
  # Whether the binding was declared `pub`.
  #[getter]
  pub def is_pub self -> Bool
    ...

  # Whether the alias is opaque, declared with `...` in place of a type. An
  # opaque alias has no [`Type`](compile.Type) child.
  #[getter]
  pub def opaque self -> Bool
    ...

# The `self` parameter of a method.
pub class SelfParam: Declaration

# Supertype of the nodes that bind a name to something imported.
pub class Import: Declaration
  # The module path as written, or as a string for a prelude binding.
  #[getter]
  pub def module self -> (Span | Str)
    ...

# A module bound by `import foo` or `import foo: bar`.
pub class ImportModule: Import
  # Whether the module was imported `pub`.
  #[getter]
  pub def is_pub self -> Bool
    ...

  # Whether the module was imported with `@`, for types only.
  #[getter]
  pub def type_only self -> Bool
    ...

# An item bound from a module, as in `import foo: - bar`.
pub class ImportItem: Import
  # Whether the item was imported `pub`.
  #[getter]
  pub def is_pub self -> Bool
    ...
  # The span of the item name within the module.
  #[getter]
  pub def item self -> Span
    ...

  # Whether the item was imported with `@`, for types only. Such an item binds no
  # variable.
  #[getter]
  pub def type_only self -> Bool
    ...

# A module bound by the prelude.
#
# A prelude binding comes from the compiler's configuration rather than the
# source, so its `name` and `module` are [`Str`](std.Str) values and its
# `span` is `nil`.
#
# A prelude node is recorded where its binding resolves, so a configured
# prelude the source never mentions produces no node at all.
pub class PreludeModule: Import

# An item bound by the prelude.
#
# Like [`PreludeModule`](compile.PreludeModule), its names are
# [`Str`](std.Str) values rather than spans, and it appears only where
# the binding it introduces is referenced.
pub class PreludeItem: Import
  # Whether this binding is available only in types.
  #[getter]
  pub def type_only self -> Bool
    ...

  # The item name within the module.
  #[getter]
  pub def item self -> Str
    ...

# Supertype of a function's parameters. The function is the parent.
pub class Param: Node
  # The bound name.
  #
  # `nil` for an anonymous [`RestParam`](compile.RestParam) and for an
  # [`ImplicitParam`](compile.ImplicitParam), which binds nothing; every other
  # parameter has one.
  #[getter]
  pub def name self -> (Span | nil)
    ...

# A positional parameter.
pub class PositionalParam: Param
  # The span of the default value expression, or `nil` when the parameter has
  # no default. Slice the source for its text.
  #[getter]
  pub def default self -> (Span | nil)
    ...

# A keyword parameter.
#
# The kind is at the granularity of the language rather than the parser: `:foo`
# and `foo: local` both arrive here, differing only in whether `key` and `name`
# cover the same text.
pub class KeyParam: Param
  # The span of the default value expression, or `nil` when the parameter has
  # no default. Slice the source for its text.
  #[getter]
  pub def default self -> (Span | nil)
    ...

  # The span of the key as written, without the `:` sigil.
  #[getter]
  pub def key self -> Span
    ...

# Supertype of rest parameters. Its subtype says which items it takes, and its
# `name` is `nil` when it is anonymous.
pub class RestParam: Param
  # The explicit `...` in the type annotation, or `nil` when absent.
  #[getter]
  pub def type_ellipsis self -> (Span | nil)
    ...

# A rest parameter for positional and keyed items, such as `...rest`.
pub class MixedRestParam: RestParam

# A rest parameter for positional items only, such as `*rest`.
pub class PosRestParam: RestParam

# A rest parameter for keyed items only, such as `**rest`.
pub class KeyRestParam: RestParam

# Supertype of the implicit parameters naming a strand's ambient channels.
#
# An implicit binds no name; its type is its [`Type`](compile.Type) child.
pub class ImplicitParam: Param

# The `<T` implicit parameter, giving the ambient input a function reads from.
pub class InputParam: ImplicitParam

# The `>T` implicit parameter, giving the ambient output a function writes to.
pub class OutputParam: ImplicitParam

# Supertype of the nodes that introduce a nested body.
#
# A block node carries nothing beyond what every [`Node`](compile.Node) does; its
# type is what says which construct opened the body.
pub class Block: Node

# A `do` block.
pub class Lambda: Block

# An `if` or `else if` body.
pub class If: Block

# An `else` body.
pub class Else: Block

# A `match` arm: its pattern, guard and body.
pub class Arm: Block

# A `while` body.
pub class While: Block

# A `for` body.
pub class For: Block

# A `try` body.
pub class Try: Block

# A `catch` handler.
pub class Catch: Block

# A `finally` body.
pub class Finally: Block

# A comprehension `for`.
pub class ForElem: Block

# A comprehension `if`.
pub class IfElem: Block

# Supertype of the nodes that name another node.
pub class Reference: Node
  # The ID of the node named, or `nil` when the compiler could not resolve one.
  #[getter]
  pub def target self -> (NodeId | nil)
    ...

# A decorator.
#
# What it decorates is its parent, and its `target` is the node the decorator
# expression names when that expression is an identifier.
pub class Decorator: Reference

# A `break`. Its `target` is the loop broken out of.
pub class Break: Reference

# A `continue`. Its `target` is the loop continued.
pub class Continue: Reference

# A `return`. Its `target` is the function returned from.
pub class Return: Reference

# A type in an annotation, return type, alias body, or superclass list.
#
# Its parent is what it describes: the parameter, binding, or field it
# annotates, the function, method, or lambda whose return type it is, the alias
# it defines, or the class it is a superclass of. A declaration naming several
# fields yields one type per field.
pub class Type: Node
  # The type's form, a child of this node.
  #[getter]
  pub def expr self -> TypeExpr
    ...

  # Whether this is a supertype written with `@`, which the class does not
  # inherit from at runtime.
  #[getter]
  pub def type_only self -> Bool
    ...

# Supertype of binders: names standing for types within the function, method,
# or class that is their parent.
pub class Binder: Declaration
  # The form of the binder's bound, a child of the binder, or `nil` when it
  # has none.
  #[getter]
  pub def bound self -> (TypeExpr | nil)
    ...

  # The form of the binder's default, a child of the binder, or `nil` when it
  # has none.
  #[getter]
  pub def default self -> (TypeExpr | nil)
    ...

# A positional binder, such as `T`.
pub class PosBinder: Binder

# A keyed binder, such as `:K`.
pub class KeyBinder: Binder

# Supertype of rest binders. Its subtype says which items it stands for.
pub class RestBinder: Binder

# A rest binder for positional and keyed items, such as `...R`.
pub class MixedRestBinder: RestBinder

# A rest binder for positional items only, such as `*R`.
pub class PosRestBinder: RestBinder

# A rest binder for keyed items only, such as `**R`.
pub class KeyRestBinder: RestBinder

# Supertype of the forms a type takes.
#
# A form is a child of whatever refers to it: a [`Type`](compile.Type), a
# [`Binder`](compile.Binder), or an enclosing form. Its span includes any
# parentheses around it, since parentheses that only group a type are not a
# form of their own. Type forms, arguments, and items declare nothing. Only a
# union member written after a `|` carries a doc, from the comment block above
# that `|`.
pub class TypeExpr: Node

# A possibly dotted name, such as `Str` or `time.Duration`.
pub class NameType: TypeExpr
  # The span of the first name.
  #[getter]
  pub def head self -> Span
    ...

  # The ID of the node the first name refers to, or `nil` when the compiler
  # could not resolve it.
  #[getter]
  pub def target self -> (NodeId | nil)
    ...

# A constant, such as `:TARGET:` or `nil`.
pub class ConstType: TypeExpr
  # The constant's value.
  #[getter]
  pub def value self -> (Sym | Str | Int | Bool | nil)
    ...

# Type arguments applied to a type, such as `Array[Int]`.
pub class AppType: TypeExpr
  # The type arguments, in the order written.
  #[getter]
  pub def args self -> Array[TypeArg]
    ...

  # The type the arguments apply to.
  #[getter]
  pub def base self -> TypeExpr
    ...

# A schema, such as `{name: Str, ?port: Int}`.
pub class SchemaType: TypeExpr
  # The items, in the order written.
  #[getter]
  pub def items self -> Array[TypeItem]
    ...

# A tuple or record type, such as `(Int, Str)` or `(name: Str)`.
pub class ParensType: TypeExpr
  # The items, in the order written.
  #[getter]
  pub def items self -> Array[TypeItem]
    ...

# An array type, such as `[Int]`.
pub class ArrayType: TypeExpr
  # The element type.
  #[getter]
  pub def elem self -> TypeExpr
    ...

# A union, such as `(Str | Path)`.
pub class UnionType: TypeExpr
  # The members, in the order written.
  #[getter]
  pub def members self -> Array[TypeExpr]
    ...

# A function type, such as `(Int, ?Int) -> Int`.
pub class FuncType: TypeExpr
  # The items of the parameter list, in the order written.
  #[getter]
  pub def items self -> Array[TypeItem]
    ...

  # The return type.
  #[getter]
  pub def ret self -> TypeExpr
    ...

  # The `<` implicit parameter, giving the ambient input, or `nil` when absent.
  #[getter]
  pub def input self -> (TypeExpr | nil)
    ...

  # The `>` implicit parameter, giving the ambient output, or `nil` when absent.
  #[getter]
  pub def output self -> (TypeExpr | nil)
    ...

# Supertype of the type arguments in the `[]` of an
# [`AppType`](compile.AppType). Its span leaves out a trailing `,`.
pub class TypeArg: Node

# A positional argument, such as `T`.
pub class PosTypeArg: TypeArg
  # The argument's type.
  #[getter]
  pub def ty self -> TypeExpr
    ...

# A keyword argument, such as `name: T`.
pub class KeyTypeArg: TypeArg
  # The argument's type.
  #[getter]
  pub def ty self -> TypeExpr
    ...
  # The span of the name.
  #[getter]
  pub def name self -> Span
    ...

# An expansion of a pack into further arguments, such as `...T`.
pub class ExpandTypeArg: TypeArg
  # The type expanded.
  #[getter]
  pub def ty self -> TypeExpr
    ...

# Supertype of the items of a [`SchemaType`](compile.SchemaType),
# [`ParensType`](compile.ParensType), or [`FuncType`](compile.FuncType). Its
# span includes a leading `-` and leaves out a trailing `,`. An item carries
# the doc of the comment block directly above it, except the lone parameter of
# a function type written without parentheses.
pub class TypeItem: Node

# A positional item, such as `T`, `?T`, `*T` or `...S`.
pub class PosTypeItem: TypeItem
  # How many of the element the item admits, or `nil` for exactly one.
  #
  # | Value       | Sigil | Admits                          |
  # | ----------- | ----- | ------------------------------- |
  # | `:OPT:`     | `?`   | Zero or one                     |
  # | `:STAR:`    | `*`   | Zero or more                    |
  # | `:INCLUDE:` | `...` | The items of the schema it gives |
  #[getter]
  pub def quant self -> (Sym | nil)
    ...
  # The item's type.
  #[getter]
  pub def ty self -> TypeExpr
    ...

# A keyed item, such as `name: T`, `?name: T` or `*(K): V`.
pub class KeyTypeItem: TypeItem
  # How many of the element the item admits, or `nil` for exactly one, as
  # for [`PosTypeItem.quant`](compile.PosTypeItem.quant).
  #[getter]
  pub def quant self -> (Sym | nil)
    ...
  # The item's type.
  #[getter]
  pub def ty self -> TypeExpr
    ...
  # The span of the key as written. A bareword key is a symbol; any other
  # key is a type, such as a quoted string or a parenthesized name.
  #[getter]
  pub def key self -> Span
    ...
  # The type giving the key, or `nil` for a bareword symbol.
  #[getter]
  pub def key_ty self -> (TypeExpr | nil)
    ...

# A `*` alone, admitting any positional items.
pub class AnyPosTypeItem: TypeItem

# A `**V`, admitting symbol-keyed items of type `V`, or a `**` alone, admitting
# any keyed items.
pub class AnyKeyTypeItem: TypeItem
  # The value type, or `nil` for a `**` alone.
  #[getter]
  pub def ty self -> (TypeExpr | nil)
    ...

# A `...` alone, admitting any items.
pub class OpenTypeItem: TypeItem

# The kind of a [`Token`](compile.Token).
pub @let TokenKind = $
  # An `@` annotation marker
  | :ANNOTATION:
  # A type binder declaration
  | :BINDER:
  # A comment
  | :COMMENT:
  # A non-numeric, non-string constant such as `nil` or `false`
  | :CONSTANT:
  # A delimiter such as `(`, `[`, etc
  | :DELIM:
  # An escape within a string
  | :ESCAPE:
  # A field, e.g. `bar` in `foo.bar`
  | :FIELD:
  # A method declaration name
  | :METHOD:
  # A key such as `foo:`
  | :KEY:
  # A module name
  | :MODULE_NAME:
  # A module item
  | :MODULE_ITEM:
  # A keyword such as `while`, `for`, `do`, `import`
  | :KEYWORD:
  # A literal string, including non-escape, non-interpolated portions of quoted
  # strings
  | :LITERAL:
  # A numeric constant
  | :NUMBER:
  # A unary or binary operator such as `+` or `-`
  | :OPERATOR:
  # A string delimiter (`"`)
  | :STRING_DELIM:
  # A name within a type expression
  | :TYPE:
  # A keyed argument within a type expression
  | :TYPE_KEY:
  # A variable
  | :VARIABLE:
  # A sigil like `$` or `...`
  | :SIGIL:

# A syntactic token.
#
# Tokens describe how a span of source text should be presented (for syntax
# highlighting, say), which is a different question from what it *is* --
# [`Node`](compile.Node) answers that. A token that names a declaration
# reports it as an opaque [`NodeId`](compile.NodeId) in `node`, resolvable
# with [`Unit.node`](compile.Unit.node).
#
# ## Example
#
# ```
# for token = unit.tokens()
#   echo $token.kind $token.span
# ```
pub class Token
  # The token kind.
  #[getter]
  pub def kind self -> TokenKind
    ...

  # The span of source text the token covers.
  #[getter]
  pub def span self -> Span
    ...

  # The ID of the declaration this token names, or `nil` when it names none.
  #[getter]
  pub def node self -> (NodeId | nil)
    ...

  # The syntactic context the token appears in: `:CALL:` for a callee position,
  # or `nil`.
  #[getter]
  pub def context self -> (:CALL: | nil)
    ...

# A compiler diagnostic.
#
# ## Example
#
# ```
# let unit = compile "bad.dol" "let =\n"
# for diag = unit.diagnostics()
#   echo $diag.render()
# ```
pub class Diagnostic
  # Additional highlighted source regions.
  #[getter]
  pub def annotations self -> Array[Annotation]
    ...

  # The primary diagnostic message.
  #[getter]
  pub def message self -> Str
    ...

  # Notes with extra context or help.
  #[getter]
  pub def notes self -> Array[Note]
    ...

  # Suggested edits.
  #[getter]
  pub def patches self -> Array[Patch]
    ...

  # The severity.
  #[getter]
  pub def severity self -> (:ERROR: | :WARNING:)
    ...

  # The primary source span.
  #[getter]
  pub def span self -> SourceSpan
    ...

  # Renders the diagnostic for terminal presentation.
  #
  # ## Returns
  #
  # The rendering, without a final newline.
  pub def render self -> Text
    ...

# An additional highlighted region attached to a
# [`Diagnostic`](compile.Diagnostic).
pub class Annotation
  # The annotation kind.
  #[getter]
  pub def kind self -> (:PRIMARY: | :CONTEXT:)
    ...

  # The annotation label.
  #[getter]
  pub def message self -> Str
    ...

  # The annotated span.
  #[getter]
  pub def span self -> SourceSpan
    ...

# An auxiliary note attached to a [`Diagnostic`](compile.Diagnostic).
pub class Note
  # The note kind.
  #[getter]
  pub def kind self -> (:INFO: | :HELP:)
    ...

  # The note text.
  #[getter]
  pub def message self -> Str
    ...

# A suggested source edit attached to a [`Diagnostic`](compile.Diagnostic).
pub class Patch
  # Human-readable text describing the suggested change.
  #[getter]
  pub def message self -> Str
    ...

  # The span to replace.
  #[getter]
  pub def span self -> SourceSpan
    ...

  # The replacement text.
  #[getter]
  pub def sub self -> Str
    ...

# Where part of a diagnostic applies: a span, and which unit it is in.
#
# A diagnostic from [`check`](compile.check) may point into any of the units
# checked together. A unit index is meaningful only within the check that
# produced it. Locations compare and hash by unit index and span.
pub class SourceSpan
  # Zero-based index of the unit among those checked together, or `nil` for a
  # location in the unit that reported the diagnostic.
  #[getter]
  pub def unit self -> (Int | nil)
    ...

  # The region within that source.
  #[getter]
  pub def span self -> Span
    ...

# A region of source text.
#
# Spans compare and order by position, so they can be sorted or used as dict
# keys.
pub class Span
  # The exclusive end position.
  #[getter]
  pub def end self -> Pos
    ...

  # The inclusive start position.
  #[getter]
  pub def start self -> Pos
    ...

# A position within source text. All coordinates are zero-based.
pub class Pos
  # Byte offset from the start of the source.
  #[getter]
  pub def byte_offset self -> Int
    ...

  # Column offset within the line.
  #[getter]
  pub def column self -> Int
    ...

  # Line offset from the start of the source.
  #[getter]
  pub def line self -> Int
    ...

# Parses and elaborates Do source into a staged compilation unit.
#
# ## Returns
#
# A [`Unit`](compile.Unit), which exposes diagnostics and, with `document: true`,
# document nodes before emission. Ordinary compiler diagnostics are reported
# through [`Unit.diagnostics`](compile.Unit.diagnostics) rather than thrown.
#
# ## Errors
#
# [`ValueError`](std.ValueError) if `prelude` is malformed.
#
# ## Example
#
# ```
# # Additional prelude modules
# compile "test.dol" $source
#   prelude:
#     - sys
#     - fs
#
# # Module with alias
# compile "test.dol" $source
#   prelude:
#     sys: shell
#
# # Import specific items
# compile "test.dol" $source
#   prelude:
#     sys:
#       - echo
#       - exit
#
# # Checker-only items
# compile "test.dol" $source
#   prelude:
#     std:
#       - "@Seq"
#
# # Items with aliases
# compile "test.dol" $source
#   prelude:
#     sys:
#       echo: echo_alias
# ```
pub def compile
  # Source path, used in debug information and
  # diagnostics.
  path @ Str
  # Source code to compile.
  source @ Str
  # Compile in module mode under this name.
  #
  # Without it the source is compiled as a script, and running the bytecode
  # yields the value of the final expression or of an early return. In module
  # mode, running it yields a module object holding the exported bindings, or
  # the value of an early return.
  :module @ Str = ...
  # Additional imports to bind before the source, in the shapes the LSP prelude
  # settings take.
  :prelude @ Prelude = ...
  # Continue parsing after syntax errors. Defaults
  # to `false`.
  #
  # Recovery is what lets a file be described while it is still being written,
  # at the cost of a document that is missing whatever the compiler could not
  # read. Check [`Unit.diagnostics`](compile.Unit.diagnostics) before trusting
  # one.
  :recover @ Bool = ...
  # Build document nodes. Defaults to `false`.
  :document @ Bool = ...
  # Prepare the unit for [`check`](compile.check). Defaults to `false`.
  :typecheck @ Bool = ...
  # Check the unit strictly, overriding its `# dolang: strict` or
  # `# dolang: nostrict` directive. Defaults to what the directive says, or
  # `false` without one.
  :strict @ Bool = ...
do -> Unit
  ...

# Checks the types of units together.
#
# A unit's imports of another unit's module are checked against that module.
# An import of a module that isn't among the units is an error, and the names it
# imports have unknown types. A unit that failed to compile is skipped; its own
# diagnostics report why.
#
# A module may be given by its [`Typelib`](compile.Typelib) in place of a unit.
# Its declarations are checked, but not its bodies, and a diagnostic in it is
# located by line and column, without its source.
#
# [`strand.PipeSender`](strand.PipeSender) and
# [`strand.PipeReceiver`](strand.PipeReceiver) are checked as the shell's
# pipes, [`proc.PipeSender`](proc.PipeSender) and
# [`proc.PipeReceiver`](proc.PipeReceiver).
#
# ## Errors
#
# | Exception          | Condition                                           |
# | ------------------ | --------------------------------------------------- |
# | `ValueError`       | A unit was compiled without `typecheck: true`       |
# | `ValueError`       | Two units are compiled as the same module           |
# | `StateError`       | A unit was emitted, or a typelib is given twice     |
#
# ## Example
#
# ```
# let lib = compile "lib.dol" $lib_source module: lib typecheck: true
# let main = compile "main.dol" $main_source typecheck: true
# let result = check [lib, main]
# for diag = result.diagnostics
#   echo $diag.render()
# let written = check [lib, main] typelibs: true
# let again = check [Typelib(written.typelib(lib)), main]
# ```
pub def check
  units @ Iterable[Unit | Typelib]
  # Whether the result keeps what [`Check.typelib`](compile.Check.typelib)
  # writes. False by default.
  :typelibs @ Bool = ...
do -> Check
  ...

# The result of [`check`](compile.check).
pub class Check
  # The checker's diagnostics. Their locations may be in any of the units, and
  # their rendering shows each one's source.
  #[getter]
  pub def diagnostics self -> Array[Diagnostic]
    ...

  # Whether the check reported no errors and could decide everything it
  # checked. When it couldn't, the units' declarations are still usable, but
  # checking proves nothing about the code using them.
  #[getter]
  pub def validated self -> Bool
    ...

  # Renders the checks the checker couldn't decide, grouped by the kind of
  # reason, for developing the checker. The format may change.
  pub def undecided self -> Str
    ...

  # Returns the bytes of a module's typelib, which [`Typelib`](compile.Typelib)
  # reads.
  #
  # The typelib is written whatever the diagnostics say about the module's
  # declarations.
  #
  # ## Errors
  #
  # | Exception          | Condition                                                   |
  # | ------------------ | ----------------------------------------------------------- |
  # | `std.ValueError`   | The check wasn't given `typelibs: true`, or `unit` wasn't checked |
  # | `std.CompileError` | `unit` is a typelib or not a module, imports a module that wasn't checked with it, or has a private declaration in its public interface |
  pub def typelib
    self
    # A unit given to [`check`](compile.check).
    unit @ (Unit | Typelib)
  do -> Bin
    ...
