    ...


# What [`getter`](std.getter) makes from a function with no parameters, the
# getter of a static computed field.
pub @class StaticGetter[R]
  field func @Phantom[(() -> R)]


# What [`setter`](std.setter) makes from a function of only the new value, the
# setter of a static computed field.
pub @class StaticSetter[V]
  field func @Phantom[(V -> nil)]


# Decorator placing a class member in the type-object namespace without making it
# inheritable.
#
# Applies to a `def` or a `field` inside a class body. A static method takes no
# receiver; it names its class to reach it. Because a static is not inherited,
# it shadows an inherited class member of the same name without propagating that
# shadowing to subclasses — which is what makes a static `(call)` usable as a
# factory that cannot recurse into itself:
#
# ```
# class Shape
#   pub field kind = ""
#
#   def (init) self kind
#     self.kind = kind
#
#   #[static]
#   pub def (call) kind
#     Type.(call) $Shape $kind
#
# class Circle: Shape
#
# let c = Circle "arc"   # default instantiation: the factory is not inherited
# ```
#
# See [`class`](std.class) for the inherited counterpart, and
# [Class and Static Members](../../language/classes.md#class-and-static-members)
# for the full semantics.
pub let static @ Value = ...

# Strings are immutable sequences of UTF-8 bytes.
pub class Str: @Index[Range[Int], Str]
  # Accepts a string or decodes UTF-8 binary data. The lowercase `str` function
  # instead returns the general-purpose textual representation of any value.
  #
  # ```
  # assert_eq (Str b"hello") "hello"
  # assert_eq (str 42) "42"
  # ```
  pub def (init) self value @ Value
    ...

  # Returns the byte length of the string.
  #
  # ## Example
  #
  # ```
  # assert_eq $"hello".len 5
  # assert_eq $"".len 0
  # ```
  #[getter]
  pub def len self -> Int
    ...

  # Iterates over the string's Unicode scalar values.
  #
  # Destructuring reads from the current position without advancing the iterator.
  # Materialize `[...s.scalars()]` for positional access.
  #
  # ## Example
  #
  # ```
  # assert_eq [..."Aé".scalars()] ["A", "e", "́"]
  # ```
  pub def scalars self -> UnpackIter[Str]
    ...

  # Iterates over the string's scalar boundary byte offsets.
  #
  # Each offset starts the corresponding fragment in [`scalars`](std.Str.scalars),
  # followed by the string's byte length. An empty string yields only `0`.
  # Destructuring reads from the current position without advancing the iterator.
  #
  # ## Example
  #
  # ```
  # let s = "Aé"
  # let bounds = [...s.scalar_bounds()]
  # assert_eq $s[bounds[1]..bounds[-1]] "é"
  # ```
  pub def scalar_bounds self -> UnpackIter[Int]
    ...

  # Returns the Unicode scalar value encoded by a single-scalar string.
  #
  # ## Errors
  #
  # Raises [`ValueError`](std.ValueError) if the string contains zero or multiple
  # Unicode scalar values.
  #
  # ## Example
  #
  # ```
  # assert_eq ("A".scalar()) 65
  # assert_eq ("😀".scalar()) 128512
  # ```
  pub def scalar self -> Int
    ...

  # Removes one trailing line terminator.
  #
  # One complete terminator — `\r\n` or `\n`, never a lone `\r` — and nothing
  # else. A string without one is returned unchanged. Distinct from
  # [`trim_end`](std.Str.trim_end), which is about whitespace generally and takes
  # an optional character set. [`Iterable.chomp`](std.Iterable.chomp) does the
  # same to each item of an iterable.
  #
  # ## Example
  #
  # ```
  # assert_eq ("line\n".chomp()) "line"
  # assert_eq ("line\r\n".chomp()) "line"
  # assert_eq ("line".chomp()) "line"
  # assert_eq ("z  \n".chomp()) "z  "
  # assert_eq ("z  \n".trim_end()) "z"
  # ```
  pub def chomp self -> Str
    ...

  # Tests whether the string contains the given substring.
  #
  # ## Example
  #
  # ```
  # assert ("foobar".contains "foo")
  # assert ("foobar".contains "bar")
  # assert (!"foobar".contains "baz")
  # assert ("foobar".contains "")  # empty string is always contained
  # ```
  pub def contains
    self
    # the substring to find
    needle @ Str
  do -> Bool
    ...

  # Tests whether the string ends with the given suffix.
  #
  # ## Example
  #
  # ```
  # assert ("foobar".ends_with "bar")
  # ```
  pub def ends_with
    self
    # the suffix string
    suffix @ Str
  do -> Bool
    ...

  # Iterates over the string's extended grapheme clusters.
  #
  # Keeps combining sequences and emoji sequences together. Destructuring reads
  # from the current position without advancing the iterator.
  # Materialize `[...s.graphemes()]` for positional access.
  #
  # ## Example
  #
  # ```
  # assert_eq [..."é👩‍💻".graphemes()] ["é", "👩‍💻"]
  # ```
  pub def graphemes self -> UnpackIter[Str]
    ...

  # Iterates over the string's grapheme boundary byte offsets.
  #
  # Each offset starts the corresponding fragment in [`graphemes`](std.Str.graphemes),
  # followed by the string's byte length. An empty string yields only `0`.
  # Destructuring reads from the current position without advancing the iterator.
  #
  # ## Example
  #
  # ```
  # let s = "Aé"
  # let bounds = [...s.grapheme_bounds()]
  # assert_eq $s[bounds[1]..bounds[-1]] "é"
  # ```
  pub def grapheme_bounds self -> UnpackIter[Int]
    ...

  # Joins values from an input source using this string as a separator.
  #
  # ## Example
  #
  # ```
  # assert_eq (",".join ["a", "b", "c"]) "a,b,c"
  # ```
  pub def join
    self
    # iterable to join; uses the default input when omitted
    iter @ Iterable[Value] = ...
  do -> Str
    ...

  # Returns the string converted to lowercase.
  #
  # ## Example
  #
  # ```
  # assert_eq ("HELLO".lower()) "hello"
  # assert_eq ("Hello World".lower()) "hello world"
  # ```
  pub def lower self -> Str
    ...

  # Returns the string repeated `count` times.
  #
  # ## Example
  #
  # ```
  # assert_eq ("ab".repeat 3) "ababab"
  # assert_eq ("ab".repeat 0) ""
  # ```
  pub def repeat
    self
    # non-negative repetition count
    count @ Int
  do -> Str
    ...

  # Returns a new string with all non-overlapping occurrences of `from` replaced
  # with `to`.
  #
  # ## Example
  #
  # ```
  # assert_eq ("foo bar foo".replace "foo" "baz") "baz bar baz"
  # assert_eq ("banana".replace "na" "") "ba"
  # assert_eq ("abc".replace "" "-") "-a-b-c-"
  # ```
  pub def replace
    self
    # substring to replace
    from @ Str
    # replacement string
    to @ Str
  do -> Str
    ...

  # Like `split`, but yields segments in **right-to-left** order (rightmost segment
  # first).
  #
  # ## Example
  #
  # ```
  # assert_eq [..."a,b,c".rsplit ","] ["c", "b", "a"]
  # assert_eq [..."a,b,c".rsplit "," limit: 1] ["c", "a,b"]
  #
  # # Negative limit: split from the left, yield right-to-left
  # assert_eq [..."a,b,c".rsplit "," limit: -1] ["b,c", "a"]
  # ```
  pub def rsplit
    self
    # the delimiter string
    delimiter @ Str
    # Maximum splits; negative values split from the left.
    #
    # - `limit: N` splits at most N times from the **right**; the last element
    #   yielded is the unsplit left remainder.
    # - `limit: -N` splits at most N times from the **left**, but still yields
    #   segments right-to-left.
    # - Omitted splits fully with no limit.
    :limit @ Int = ...
  do -> UnpackIter[Str]
    ...

  # Splits the string by the delimiter, returning an iterator that yields segments
  # in **left-to-right** order.
  #
  # ## Example
  #
  # ```playground
  # #> import test:
  # #>   - assert_eq
  # assert_eq [..."a,b,c".split ","] ["a", "b", "c"]
  # assert_eq [..."a,b,c".split "," limit: 1] ["a", "b,c"]
  #
  # # Negative limit: split from the right, yield left-to-right
  # let base ext = "archive.tar.gz".split "." limit: -1
  # assert_eq $base "archive.tar"
  # assert_eq $ext "gz"
  # ```
  pub def split
    self
    # the delimiter string
    delimiter @ Str
    # Maximum splits; negative values split from the right.
    #
    # - `limit: N` (positive) splits at most N times from the **left**; the last
    #   element is the unsplit remainder.
    # - `limit: -N` (negative) splits at most N times from the **right**, but still
    #   yields segments left-to-right. This is useful for splitting off a known-length
    #   suffix such as a file extension.
    # - Omitted splits fully with no limit.
    :limit @ Int = ...
  do -> UnpackIter[Str]
    ...

  # Tests whether the string starts with the given prefix.
  #
  # ## Example
  #
  # ```
  # assert ("foobar".starts_with "foo")
  # assert (!("foobar".starts_with "bar"))
  # ```
  pub def starts_with
    self
    # the prefix string
    prefix @ Str
  do -> Bool
    ...

  # Removes whitespace (or specified characters) from both ends.
  #
  # ## Example
  #
  # ```
  # assert_eq ("  hello  ".trim()) "hello"
  # assert_eq ("xxhelloxx".trim "x") "hello"
  # assert_eq ("xyhelloyx".trim ["x", "y"]) "hello"
  # ```
  pub def trim
    self
    chars @ (Str | Iterable[Str]) = ...
  do -> Str
    ...

  # Removes whitespace (or specified characters) from the end.
  #
  # ## Example
  #
  # ```
  # assert_eq ("  hello  ".trim_end()) "  hello"
  # assert_eq ("xxhelloxx".trim_end "x") "xxhello"
  # ```
  pub def trim_end
    self
    chars @ (Str | Iterable[Str]) = ...
  do -> Str
    ...

  # Removes whitespace (or specified characters) from the start.
  #
  # ## Example
  #
  # ```
  # assert_eq ("  hello  ".trim_start()) "hello  "
  # assert_eq ("xxhelloxx".trim_start "x") "helloxx"
  # ```
  pub def trim_start
    self
    chars @ (Str | Iterable[Str]) = ...
  do -> Str
    ...

  # Returns the string converted to uppercase.
  #
  # ## Example
  #
  # ```
  # assert_eq ("hello".upper()) "HELLO"
  # assert_eq ("Hello World".upper()) "HELLO WORLD"
  # ```
  pub def upper self -> Str
    ...

  # Returns the string with the prefix removed if it matches, otherwise returns
  # the original string.
  #
  # ## Example
  #
  # ```
  # assert_eq ("foobar".without_prefix "foo") "bar"
  # assert_eq ("foobar".without_prefix "baz") "foobar"
  # ```
  pub def without_prefix
    self
    # the prefix to remove
    prefix @ Str
  do -> Str
    ...

  # Returns the string with the suffix removed if it matches, otherwise returns
  # the original string.
  #
  # ## Example
  #
  # ```
  # assert_eq ("foobar".without_suffix "bar") "foo"
  # ```
  pub def without_suffix
    self
    # the suffix to remove
    suffix @ Str
  do -> Str
    ...

  # Returns the bytes in a range as a new string.
  #
  # ```
  # assert_eq $"abcd"[1..3] "bc"
  # assert_eq $"abcd"[..2] "ab"
  # assert_eq $"abcd"[2..] "cd"
  # assert_eq $"abcd"[..] "abcd"
  # assert_eq $"foobar"[-3..] "bar"
  # ```
  #
  # The range must lie within the string, and its endpoints must fall on UTF-8
  # character boundaries. Omitted `start` means `0`, omitted `end` means the
  # string length, and negative endpoints count from the end.
  pub def (index) self range@Range[Int] -> Str
    ...


# Mutable UTF-8 string buffer; the mutable counterpart to [`Str`](std.Str).
#
# `StrBuf` is a [sink](std.Sink), so it can be the target of a pipeline, of
# [`strand.put`](strand.put), or of a
# [`run`](../../shell/external-programs.md#redirecting-io) redirect. `put` is
# [`append`](std.StrBuf.append): the value's string form goes in verbatim, with
# no line terminator added.
#
# ```
# let buf = StrBuf()
# run uname -r stdout: $buf
# ```
#
# Line termination is the caller's to choose, so a `StrBuf` can stand in for any
# other sink without changing what gets written:
#
# ```
# let buf = StrBuf()
# let out = buf.precrimp()
# out.put "first"
# out.put "second"
# assert_eq $buf.freeze() "first\nsecond\n"
# ```
#
# A `StrBuf` is not an [`Io`](io.Io), since bytes written in pieces can split a
# character. An [`io.Cursor`](io.Cursor) over it takes bytes from anything that
# writes to a stream, holding back a split character until it is complete.
pub class StrBuf: @Index[Range[Int], Str] @Assign[Range[Int], Str] Sink[Value]
  # Builds a buffer, optionally seeded with the contents of an existing string.
  #
  # ## Example
  #
  # ```
  # let buf = StrBuf("hello")
  # assert_eq $buf.len 5
  # ```
  pub def (init)
    self
    # initial contents
    initial @ Str = ...
  do
    ...

  # Returns the byte length of the buffer's current contents.
  #
  # ## Example
  #
  # ```
  # assert_eq (StrBuf("hello").len) 5
  # ```
  #[getter]
  pub def len self -> Int
    ...

  # Appends `value` to the buffer. `Str` input is copied byte-for-byte; anything
  # else is converted the same way [`str`](std.str) would convert
  # it, written directly into the buffer.
  #
  # ## Example
  #
  # ```
  # let buf = StrBuf()
  # buf.append "foo"
  # buf.append 42
  # assert_eq $buf.freeze() "foo42"
  # ```
  pub def append
    self
    # value to append
    value @ Value
  do
    ...

  # Empties the buffer, retaining its allocated capacity.
  #
  # ```
  # let buf = StrBuf("foobar")
  # buf.clear()
  # assert_eq $buf.len 0
  # buf.append "x"
  # assert_eq $buf.freeze() "x"
  # ```
  pub def clear self
    ...

  # Tests whether the buffer's contents contain the given substring.
  #
  # ## Example
  #
  # ```
  # assert (StrBuf("foobar").contains "oob")
  # ```
  pub def contains
    self
    # the substring to find
    needle @ Str
  do -> Bool
    ...

  # Returns an iterator that removes and yields up to `size` bytes at a time
  # from the front of the buffer as it's consumed.
  #
  # Each chunk boundary is rounded down to the nearest UTF-8 code point
  # boundary, unless that would produce an empty chunk (`size` smaller than the
  # first remaining code point), in which case it rounds up instead so every
  # chunk yielded is non-empty.
  #
  # ## Example
  #
  # ```
  # let buf = StrBuf("hello world")
  # assert_eq [...buf.drain(4)] ["hell", "o wo", "rld"]
  # assert_eq $buf.len 0
  # ```
  #
  # Draining doesn't move the remaining contents for each chunk, so its cost
  # grows with the bytes drained, not with what is left. Indexes given to other
  # methods count from the start of what remains. Several `drain` iterators over
  # one buffer take turns removing from the same content.
  pub def drain
    self
    # Maximum bytes per chunk; 512 KiB when omitted.
    size @ Int = ...
  do -> Iter[Str]
    ...

  # Tests whether the buffer's contents end with the given suffix.
  #
  # ## Example
  #
  # ```
  # assert (StrBuf("foobar").ends_with "bar")
  # ```
  pub def ends_with
    self
    # the suffix string
    suffix @ Str
  do -> Bool
    ...

  # Appends the raw bytes of `value`, which must be a [`Str`](std.Str).
  #
  # ## Example
  #
  # ```
  # let buf = StrBuf("foo")
  # buf.extend "bar"
  # assert_eq $buf.freeze() "foobar"
  # ```
  pub def extend
    self
    # string to append
    value @ Str
  do
    ...

  # Converts the buffer's current contents into an immutable [`Str`](std.Str)
  # in place, without copying, and empties the buffer. The buffer stays usable
  # afterward, and the returned string is unaffected by later mutation.
  #
  # ## Example
  #
  # ```
  # let buf = StrBuf("abc")
  # let frozen = buf.freeze()
  # assert_eq $frozen "abc"
  # assert_eq $buf.len 0
  # buf.append "def"
  # assert_eq $frozen "abc"
  # ```
  pub def freeze self -> Str
    ...

  # Inserts `value` at the given byte index, shifting the rest of the buffer
  # right in place.
  #
  # ## Example
  #
  # ```
  # let buf = StrBuf("foobar")
  # buf.insert 3 "XYZ"
  # assert_eq $buf.freeze() "fooXYZbar"
  # ```
  pub def insert
    self
    # insertion point; must fall on a UTF-8 boundary
    index @ Int
    # string to insert
    value @ Str
  do
    ...

  # Removes and returns the substring covered by `range`, shifting the rest of
  # the buffer left in place.
  #
  # ## Example
  #
  # ```
  # let buf = StrBuf("foobar")
  # assert_eq (buf.remove (1..3)) "oo"
  # assert_eq $buf.freeze() "fbar"
  # ```
  #
  # Unlike `insert`, `remove` only accepts a range — a scalar index would remove
  # a single UTF-8 code unit, which is rarely a useful result.
  pub def remove
    self
    # byte range to remove; must fall on UTF-8 boundaries
    range @ Range[Int]
  do -> Str
    ...

  # Tests whether the buffer's contents start with the given prefix.
  #
  # ## Example
  #
  # ```
  # assert (StrBuf("foobar").starts_with "foo")
  # ```
  pub def starts_with
    self
    # the prefix string
    prefix @ Str
  do -> Bool
    ...

  # Shrinks the buffer to `len` bytes, discarding anything past that point.
  #
  # ## Example
  #
  # ```
  # let buf = StrBuf("foobar")
  # buf.truncate 3
  # assert_eq $buf.freeze() "foo"
  # ```
  pub def truncate
    self
    # new length; must fall on a UTF-8 boundary
    len @ Int
  do
    ...

  # Returns the text in a range as a new string.
  #
  # Like `Str`, `StrBuf` supports only range indexing and assignment, since a
  # single byte is rarely useful on its own.
  #
  # ```
  # let buf = StrBuf("foobar")
  # assert_eq $buf[2..4] "ob"
  # buf[1..3] = "XYZ"
  # assert_eq $buf.freeze() "fXYZbar"
  # ```
  #
  # The range's endpoints must fall on UTF-8 character boundaries.
  pub def (index) self range@Range[Int] -> Str
    ...

  # Replaces the text in a range. The replacement may differ in length from the
  # range, growing or shrinking the buffer. The range's endpoints must fall on
  # UTF-8 character boundaries.
  pub def (assign) self range@Range[Int] value@Str
    ...

  pub def (put) self value @ Value
    ...


# A read-only view of a [`Struct`](std.Struct), covariant in its schema: a
# `Struct[{a: Int}]` is a `BaseStruct[{a: (Int | Str)}]`. A parameter that only
# reads a struct takes a `BaseStruct`, so it accepts structs with narrower items.
#
# `BaseStruct` is `Struct` at runtime, so only a struct is a `BaseStruct`.
pub class BaseStruct[S @ {...}]: @BaseIterable[Entries[S]] @Index[S] @Spread[S] @Unpack[S, Rest: MapRest[S]]
  # Gets the value for a symbol or position, with an optional default.
  #
  # ```
  # let s = struct name: Alice
  # assert_eq (Struct.get s :name:) Alice
  # assert_eq (Struct.get s :port: default: 22) 22
  # ```
  #[class]
  pub def get[T @ {...}, K, D = nil]
    self
    target @ BaseStruct[T]
    key @ K
    :default @ D = ...
    :else @ (() -> D) = ...
  do -> (IndexItem[T, K] | D)
    ...

  # Tests whether a struct has an item for a symbol or position.
  #
  # ```
  # let s = struct name: Alice
  # assert (Struct.contains s :name:)
  # assert (!Struct.contains(s, :port:))
  # ```
  #[class]
  pub def contains self target @ BaseStruct[{...}] key @ (Int | Sym) -> Bool
    ...

  # Reads the item a name keys, as in `s.name`.
  #
  # ## Errors
  #
  # Raises [`FieldError`](std.FieldError) when no item has the key.
  pub def (get)[K] self key@K -> IndexItem[S, K]
    ...

  # Returns the value at a position or key.
  #
  # ## Errors
  #
  # Raises [`IndexError`](std.IndexError) when no item has the key.
  pub def (index)[K] self key@K -> IndexItem[S, K]
    ...

  # Iterates items as `(key, value)` pairs in order. A positional item's key is
  # its position.
  pub def (iter) self -> UnpackIter[Entries[S]]
    ...

  # Spreads the struct's items.
  pub def (spread) self -> Spread[S]
    ...

  # Unpacks items by position and symbol, as a [`Record`](std.Record) does.
  pub def (unpack) self -> BaseStruct[S]
    ...


# A mutable sequence of positional and symbol-keyed items, whose plain names are
# its keyed items. A struct has no methods of its own, so `s.name` reads the item
# keyed `:name:` and `s.name = value` replaces or adds it. Calling `s.name args`
# calls the item.
#
# ```
# let s = struct host: localhost port: 22
# s.port = 2222
# assert_eq $s.port 2222
# ```
#
# Each symbol key appears at most once. Positional items are read and replaced
# through indexing, as in `s[0]`. Class methods such as
# [`get`](std.BaseStruct.get) take the struct as their first argument, so they
# can't collide with an item.
#
# The schema `S` types each item, so the type checker reports reading or
# writing a name the schema lacks.
pub class Struct[S @ {...}]: BaseStruct[S] @Assign[S]
  # Builds a struct from one spreadable source of key-value pairs.
  #
  # ```
  # let s = Struct {host: "localhost", port: 22}
  # ```
  #
  # Integer keys counting up from `0` become positional items, as when
  # spreading a dict.
  #
  # The lowercase [`struct`](std.struct) factory instead builds a struct from
  # its arguments.
  #
  # ## Errors
  #
  # | Exception | Condition |
  # | --------- | --------- |
  # | [`TypeError`](std.TypeError) | Another key is not a symbol |
  # | [`ValueError`](std.ValueError) | A symbol key is repeated |
  pub def (init) self source @ Spread[S]
    ...

  # Replaces the item a name keys, or adds one, as in `s.name = value`.
  pub def (set)[K] self key@K value@AssignItem[S, K]
    ...

  # Replaces the item at a position or key. A new symbol key adds an item.
  #
  # ## Errors
  #
  # Raises [`IndexError`](std.IndexError) for a position with no item.
  pub def (assign)[K] self key@K value@AssignItem[S, K]
    ...


# Symbols are interned identifiers used for dictionary keys and enum-like
# values.
#
# ## Creating Symbols
#
# Literal syntax with surrounding colons:
#
# ```
# let s = :my_symbol:
# ```
#
# From a string with the lowercase `sym` coercion:
#
# ```
# let s = sym "my_symbol"
# assert_eq $s :my_symbol:
# ```
#
# Enum-like values:
#
# ```
# let status = :ok:
# let mode = :verbose:
# ```
#
# Dictionary keys:
#
# ```
# let d = {}
# d[:status:] = "active"
# ```
#[final]
pub class Sym
  # Symbols are compared by identity.
  #
  # ```
  # assert_eq :foo: :foo:
  # assert (:foo: != :bar:)
  # ```
  pub def (eq) self other @ Value -> Bool
    ...

  # Symbols compare lexicographically by name.
  #
  # ```
  # assert (:alpha: < :beta:)
  # ```
  pub def (lt) self other @ Sym -> Bool
    ...


# Raised when a strand times out. As with cancellation, a strand raises it the
# next time it suspends.
#[mixable]
pub class TimedOutError: RuntimeError
  # Builds an error reporting that a strand timed out.
  pub def (init) self
    ...


# Tuples are immutable, ordered sequences of values. They are produced by
# certain operations such as iterating over key-value pairs. The `Tuple` type
# object is in the prelude, so `Tuple(iterable)` is available without an
# explicit import.
pub class Tuple[*Ts]:
  - @Spread[Ts]
  - @Unpack[Ts, Rest: Unpack[Ts]]
  - Iterable[Union[...Ts]]
  - @Index[Ts]
  - @Seq[Union[...Ts]]
do
  # Builds a tuple from an iterable.
  #
  # The lowercase `tuple` factory instead collects its positional arguments
  # verbatim.
  #
  # ## Example
  #
  # ```
  # let tup = Tuple([1, 2, 3])
  # assert_eq $tup[1] 2
  #
  # for k v = {name: "Alice", age: 30}
  #   # each pair is a tuple
  #   echo "$k: $v"
  # ```
  @def (init)[T]
    self @ Tuple[...T]
    # values to collect
    iterable @ Iterable[T]
  do

  pub def (init) self iterable @ Value
    ...

  # Returns the number of elements.
  #[getter]
  pub def len self -> Int
    ...

  # Tests whether the tuple contains the given element (by equality).
  pub def contains
    self
    # the value to check
    element @ Value
  do -> Bool
    ...

  # Returns a shallow copy of the tuple. Because tuples are immutable, the
  # returned copy may be the same object.
  pub def copy self -> Tuple[...Ts]
    ...

  # Retrieves the value at the given index. Returns `nil` if out of bounds and no
  # alternative is provided. Negative indexes count from the end.
  pub def get[D = nil]
    self
    # the index to access
    index @ Int
    :default @ D = ...
    :else @ (() -> D) = ...
  do -> (Union[...Ts] | D)
    ...

  # Returns an iterator with read-only unpacking.
  pub def iter self -> UnpackIter[Union[...Ts]]
    ...

  # Returns an iterator yielding `(index, value)` pairs.
  pub def pairs self -> UnpackIter[Tuple[Int, Value]]
    ...

  @def (index)[K] self key@K -> IndexItem[Ts, K]
  @def (index) self range@Range[Int] -> Tuple[...Union[...Ts]]

  # Returns an element, or a new tuple for a slice.
  #
  # ```
  # let pair = {name: "Alice"}.pairs().next()
  # assert_eq $pair[0] :name:
  # assert_eq $pair[1] "Alice"
  # assert_eq $pair[-1] "Alice"
  # ```
  #
  # Tuples are immutable; indexed assignment is not supported.
  #
  # ```
  # let tup = Tuple [0, 1, 2, 3]
  # assert_eq $tup[1..3] (tuple 1 2)
  # assert_eq $tup[..2] (tuple 0 1)
  # assert_eq $tup[2..] (tuple 2 3)
  # assert_eq $tup[..] (tuple 0 1 2 3)
  # assert_eq $tup[Range 0 4 2] (tuple 0 2)
  # assert_eq $tup[Range nil nil -1] (tuple 3 2 1 0)
  # ```
  #
  # Omitted `start` means `0`, omitted `end` means the tuple length, and negative
  # endpoints count from the end. Negative steps reverse the slice.
  pub def (index)[K] self key@K -> IndexItem[{*Union[...Ts]}, K]
    ...

  # Returns an iterator with read-only unpacking.
  pub def (iter) self -> UnpackIter[Union[...Ts]]
    ...

  # Unpacks tuple elements.
  #
  # ```
  # for k v = {name: "Alice", age: 30}
  #   echo "$k = $v"
  # ```
  pub def (unpack) self -> Tuple[...Ts]
    ...

  # Spreads the items.
  pub def (spread) self -> Spread[Ts]
    ...


# Raised when an operation receives a value of the wrong type.
#[mixable]
pub class TypeError: RuntimeError
  # Builds an error reporting a value of the wrong type.
  pub def (init)
    self
    # description of the mismatch
    message @ Str
  do
    ...


# The type of a class whose instances are `T`. `Type` is the type of all types
# and cannot be constructed directly.
pub class Type[T]: Func
  field instance @ Phantom[T]

# Raised when a key argument is unexpected or repeats a named parameter.
#[mixable]
pub class UnexpectedKeyError: RuntimeError
  # Builds an error naming an unexpected key item.
  pub def (init)
    self
    # the unexpected key
    key @ Value
  do
    ...


# Raised when an unexpected positional argument is passed.
#[mixable]
pub class UnexpectedPosError: RuntimeError
  # Builds an error naming an unexpected positional item.
  pub def (init)
    self
    # zero-based position of the unexpected item
    index @ Int
  do
    ...


# Raised when an unsupported operation is attempted.
#[mixable]
pub class UnsupportedError: RuntimeError
  # Builds an error reporting that an operation is not supported.
  pub def (init) self
    ...


# Raised when a value has an acceptable type but invalid contents, range, or
# meaning for the operation.
#[mixable]
pub class ValueError: RuntimeError
  # Builds an error reporting a value of the right type but unusable contents.
  pub def (init)
    self
    # description of the problem with the value
    message @ Str
  do
    ...


# `Value` is the abstract supertype of all values.
#
# `Value` is not constructible directly. Every value has its members, and a
# class declares one only to replace it.
pub class Value
  # Returns the hash code, which is equal for equal values.
  pub def (hash) self -> Int
    ...

  # Compares with another value of any type.
  pub def (eq) self other @ Value -> Bool
    ...

  # Compares with another value when this value is the right operand.
  pub def (req) self other @ Value -> Bool
    ...

  # Compares with another value for inequality.
  pub def (ne) self other @ Value -> Bool
    ...

  # Compares for inequality when this value is the right operand.
  pub def (rne) self other @ Value -> Bool
    ...

  # Returns the string conversion that interpolation uses.
  pub def (str) self -> Str
    ...

  # Returns the debug representation.
  pub def (dbg) self -> Str
    ...

  # Returns the representation as written in source.
  pub def (verbatim) self -> Str
    ...

# Raised on integer division or modulo by zero.
#[mixable]
pub class ZeroDivError: RuntimeError
  # Builds an error reporting division by an integer zero.
  pub def (init) self
    ...
