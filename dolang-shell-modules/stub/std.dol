# dolang: strict
#
# The `std` module provides core language facilities.

import io:
  - Io

# The union of its type arguments. `Union[Int, Str]` is `(Int | Str)`, and an
# expanded schema adds its items' types, as in `Union[T, ...Us]`.
pub @let Union[...Ts] = ...

# The type with no values, which a function that never returns can declare as
# its result.
pub @let Never = Union[]

# The unchecked type. Unlike [`Value`](std.Value), which admits every value but
# allows few operations without narrowing, `Unknown` converts to and from every
# type, so the checker accepts any use of it. A
# [strict](../../language/type-checking.md#strict-checking) file may write it to leave
# one declaration unchecked.
pub @let Unknown = ...

# The union of a schema's keys, as a collection indexes it: positional items
# are indexed by `Int`. `Keys[{a: Int, b: Str}]` is `(:a: | :b:)`,
# `Keys[{**Int}]` is `Sym`, and `Keys[{Int, Str}]` and `Keys[{*Int}]` are `Int`.
pub @let Keys[S @ {...}] = ...

# The union of the values of a schema's items, positional or keyed.
# `Values[{Bool, a: Int, b: Str}]` is `(Bool | Int | Str)`.
pub @let Values[S @ {...}] = ...

# The union of a `Tuple` of key and value for each of a schema's items, which
# keeps each key with its own value. A positional item's key is its index, as in
# `Keys`. `Entries[{a: Int, b: Str}]` is
# `(Tuple[:a:, Int] | Tuple[:b:, Str])`.
pub @let Entries[S @ {...}] = ...

# The union of the values of the items of `S` that a key selects, which a read
# at a key of type `K` may give. A positional item's key is its index, as in
# `Keys`. `IndexItem[{a: Int, b: Str}, :a:]` is `Int`, and
# `IndexItem[{a: Int, b: Str}, (:a: | :b:)]` is `(Int | Str)`. A key `S` doesn't
# admit is an error.
pub @let IndexItem[S @ {...}, K] = ...

# The values that fit every item of `S` that a key selects, which a write at a
# key of type `K` must fit. `AssignItem[{a: Int, b: Str}, :a:]` is `Int`, and
# a value fits `AssignItem[{a: Int, b: Str}, (:a: | :b:)]` if it fits both `Int`
# and `Str`. A key `S` doesn't admit is an error.
pub @let AssignItem[S @ {...}, K] = ...

# The values that fit every item of `S` that a key selects, as in
# `AssignItem`, which a value added at a key of type `K` must fit. Each item
# selected must be keyed and admit repetition: `InsertItem[{*(Str): Int}, Str]`
# is `Int`, but `InsertItem[{a: Int}, :a:]` is an error.
pub @let InsertItem[S @ {...}, K] = ...

# `S`, where removing every item that a key of type `K` selects leaves a value
# of `S`. Each item selected must be keyed and admit zero:
# `Deletable[{a: Int, ?b: Str}, :b:]` is `{a: Int, ?b: Str}`, but
# `Deletable[{a: Int, ?b: Str}, :a:]` is an error.
pub @let Deletable[S @ {...}, K] = ...

# `S`, where every item admits zero, so removing all of them leaves a value of
# `S`. `Clearable[{?a: Int, *Str}]` is `{?a: Int, *Str}`, but
# `Clearable[{a: Int}]` is an error.
pub @let Clearable[S @ {...}] = ...

# The keyed schema of the public members of `T` that can be read: a required
# item for each field, at its type, and each getter, at its result. A class
# that isn't [`final`](std.final) may have subclasses with more members, so its
# schema also admits other keys, as `Value`. For
# `#[final] class Point` with `pub field x y @ Int`, `Fields[Point]` is
# `{x: Int, y: Int}`.
pub @let Fields[T] = ...

# The keyed schema of the public members of `T` that can be set: an optional
# item for each field, at its type, and each setter, at the value it takes. A
# class that isn't [`final`](std.final) also admits other keys, as `Never`, so
# that no value can be set at a key its subclasses might add.
pub @let MutFields[T] = ...

# The singleton [`Null`](std.Null) value.
#
# As an iterator it ends immediately; as a sink it discards every value.
pub let null @ Null = ...

# Creates an array from positional arguments.
pub def array[T] ...values @ T -> Array[T]
  ...

# Converts a value to [`Bool`](std.Bool) according to its truthiness.
#
# ## Example
#
# ```
# assert_eq (bool 0) false
# assert_eq (bool 1) true
# assert_eq (bool nil) false
# assert_eq (bool "") false
# assert_eq (bool "hello") true
# ```
pub def bool value @ Value -> Bool
  ...

# Converts a value to its debug representation. Shows internal structure (e.g.
# quotes strings, shows type tags).
pub def dbg value @ Value -> Str
  ...

# Creates a dictionary from positional and key arguments.
#
# Positional arguments receive incrementing integer keys starting at `0`.
# Key arguments become symbol keys. The function-call syntax cannot specify
# other key types; use a [horizontal dictionary
# literal](../../language/data-structures.md#literals) or [vertical
# data](../../language/vertical-layout.md#vertical-data) instead.
pub def dict[...Ts] ...pairs @ Ts -> Dict[Ts]
  ...

# Makes a proxy for a value's public fields and properties.
#
# Indexing the proxy with a member's symbol reads or sets the member, and
# unpacking or spreading it reads members by key, so a value without its own
# [`(unpack)`](../../language/classes.md#unpack-pattern-unpacking) can be
# destructured through `fields`. Iterating it gives `(key, value)` pairs. A
# member is read when the proxy is indexed, unpacked, spread or iterated, not
# when it is made.
#
# ```
# #[final]
# class Point
#   pub field x y = 0
#
# let p = Point()
# fields(p)[:x:] = 3
# let :x :y = fields(p)
# assert_eq [x, y] [3, 0]
# ```
#
# ## Errors
#
# Indexing the proxy raises [`IndexError`](std.IndexError) for a key that isn't a
# member it can read, or set when assigning.
pub def fields[T] value @ T -> FieldProxy[Fields[T], MutFields[T]]
  ...

# Decorator forbidding subclasses of a class.
#
# A class that inherits from a final class fails to be created. Since a final
# class has no subclasses, the type checker knows that its instances belong to
# no class other than its supertypes.
#
# ```
# #[final]
# class Point
#   pub field x y = 0
# ```
#
# ## Errors
#
# | Exception | Condition |
# | --- | --- |
# | [`TypeError`](std.TypeError) | `cls` isn't a class written in Do. |
# | [`StateError`](std.StateError) | A class already inherits from `cls`. |
pub def final[T] cls @ Type[T] -> Type[T]
  ...

# Decorator letting a class be combined with classes unrelated to it.
#
# A class is disjoint unless it is mixable, and no class can inherit from two
# disjoint classes neither of which inherits from the other. A mixable class
# takes the place of its nearest disjoint superclass, so subclasses of unrelated
# disjoint classes may share it as a superclass. The type checker reports a
# class that breaks this rule, and relies on it to know that unrelated disjoint
# classes share no instances. See
# [Disjoint Classes](../../language/classes.md#disjoint-classes).
#
# ```
# #[mixable]
# class Named
#   pub field name = nil
#
# class Shape
# class Image
# class Square: Shape Named
# class Icon: Image Named
# ```
#
# ## Errors
#
# | Exception | Condition |
# | --- | --- |
# | [`TypeError`](std.TypeError) | `cls` isn't a class written in Do. |
# | [`StateError`](std.StateError) | A class already inherits from `cls`. |
pub def mixable[T] cls @ Type[T] -> Type[T]
  ...

# Coerces or parses a value as a [`Float`](std.Float).
#
# ## Errors
#
# | Exception | Condition |
# | --- | --- |
# | [`ValueError`](std.ValueError) | The string is empty or malformed. |
# | [`TypeError`](std.TypeError) | The value cannot be converted. |
pub def float value @ (Num | Str) -> Float
  ...

# Makes a field getter from a function of the object read.
#
# ## Example
#
# ```
# class Config
#   field port = 8080
#
#   #[getter]
#   pub def port obj
#     obj.#port
# ```
@def getter[T, R]
  # Function called for field reads.
  func @ ((T, <Value, >Value) -> R)
do -> Getter[T, R]

# Makes a static field getter from a function with no parameters.
@def getter[R]
  # Function called for field reads.
  func @ ((<Value, >Value) -> R)
do -> StaticGetter[R]

# Makes a field getter from a function, marking it for a class body to store
# as a computed field.
pub def getter func @ Func -> (Getter[Value, Value] | StaticGetter[Value])
  ...

# Returns a hash code computed over all supplied values in sequence. Passing
# multiple values is useful for combining fields in a `(hash)` implementation:
#
# ```
# def (hash) self
#   hash $self.x $self.y $self.z
# ```
#
# An unchanged value keeps its hash code while a program runs, but the code
# may differ between runs, so don't store hash codes as identifiers.
pub def hash
  # Values to hash.
  *values @ Value
do -> Int
  ...

@def int value @ (Num | Str) -> Int
@def int value @ Str :base @ Int -> Int

# Coerces or parses a value as an [`Int`](std.Int).
#
# Strings accept an optional sign and single `_` separators between digits.
# Without `base:`, `0x`, `0o`, and `0b` prefixes (in either case) select
# hexadecimal, octal, and binary; other strings are decimal. No whitespace
# is stripped.
#
# ## Errors
#
# | Exception | Condition |
# | --- | --- |
# | [`ValueError`](std.ValueError) | The string is empty or malformed, or the base is outside 2–36. |
# | [`OverflowError`](std.OverflowError) | The integer string is out of range. |
# | [`TypeError`](std.TypeError) | The value cannot be converted, the base is not an integer, or `base:` is supplied with a non-string value. |
#
# ## Example
#
# ```
# assert_eq (int "0xFF") 255
# assert_eq (int "FF" base: 16) 255
# assert_eq (int "1_000") 1000
# ```
pub def int
  value @ (Num | Str)
  # Base from 2 to 36, using digits `0-9` and letters `a-z` (in either case).
  # When supplied, the string contains raw digits: no prefix is stripped.
  :base @ Int = ...
do -> Int
  ...

# Creates a record from positional and key arguments.
#
# Positional arguments become positional items, and key arguments become
# symbol-keyed items.
#
# ## Example
#
# ```
# let r = record name: Alice age: 30
# echo $r[:name:]  # Alice
# ```
pub def record[...Ts]
  # Positional and key field values.
  ...args @ Ts
do -> Record[...Ts]
  ...

# Makes a field setter from a function of the object assigned and its new
# value.
#
# ## Example
#
# ```
# class Config
#   field port = 8080
#
#   #[setter]
#   pub def port obj value
#     obj.#port = value
# ```
@def setter[T, V]
  # Function called for field writes.
  func @ ((T, V, <Value, >Value) -> nil)
do -> Setter[T, V]

# Makes a static field setter from a function of only the new value.
@def setter[V]
  # Function called for field writes.
  func @ ((V, <Value, >Value) -> nil)
do -> StaticSetter[V]

# Makes a field setter from a function, marking it for a class body to store
# as a computed field.
pub def setter func @ Func -> (Setter[Value, Value] | StaticSetter[Value])
  ...

# Returns the general-purpose [`Str`](std.Str) representation of a value.
pub def str value @ Value -> Str
  ...

# Creates a [`Struct`](std.Struct) from positional and key arguments.
#
# ```
# let s = struct host: localhost port: 22
# assert_eq $s.port 22
# ```
#
# ## Errors
#
# Raises [`ValueError`](std.ValueError) when a key is repeated.
pub def struct[...Ts]
  # Positional and key item values.
  ...items @ Ts
do -> Struct[Ts]
  ...

# Interns a string as a [`Sym`](std.Sym).
pub def sym
  # Value to intern.
  value @ (Str | Sym)
do -> Sym
  ...

# Creates a tuple from positional arguments.
pub def tuple[*Ts] *values@Ts -> Tuple[...Ts]
  ...

# Returns the value's type
#
# ## Example
#
# ```
# assert_eq (type 42) $Int
# ```
@def type[T] value @ T -> Type[T]

# Tests whether `value` is an instance of `type`.
#
# ## Example
#
# ```
# assert (type 42 Int)
# ```
@def type[T] value@Value type@Type[T] -> Bool

# Returns a value's type, or tests whether it's an instance of a type.
pub def type value@Value *type@Type[Value] -> (Type[Value] | Bool)
  ...

# Converts a value to its verbatim representation. Preserves the literal textual
# form of values where possible, which is useful for passing values as
# command-line arguments to external programs.
pub def verbatim value @ Value -> Str
  ...

# The following types are declared out of alphabetical order because many
# other types in this module reference them as supertypes.

# The abstract base type for all errors. All error types in `std` inherit
# from `Error`, so it can be used as a catch-all in typed `catch` handlers.
#
# `Error` is abstract: it has no representation of its own, so it can be neither
# constructed nor inherited from directly. Subclass one of its concrete subtypes
# instead — usually [`RuntimeError`](std.RuntimeError).
pub class Error


# Supertype of ordinary catchable runtime failures, and a generic runtime error
# in its own right when no more specific type applies.
#
# ## Subclassing
#
# A class may inherit from `RuntimeError` or any of its subtypes. The subclass
# must chain to the supertype's constructor, which is what gives the instance
# its string form:
#
# ```
# class NoDomainError: RuntimeError
#   pub field name = nil
#
#   def (init) self name
#     RuntimeError.(init) $self "domain does not exist: $name"
#     self.name = name
#
# try
#   throw NoDomainError "guest0"
# catch RuntimeError: e
#   assert_eq (str e) "domain does not exist: guest0"
# ```
#
# See [Error handling](../../language/error-handling.md#subclassing-error-types).
pub class RuntimeError: Error
  # Builds a runtime error carrying `message` verbatim — unlike the more specific
  # types, it adds no prefix of its own.
  pub def (init)
    self
    # the error's complete string form
    message @ Str
  do
    ...


# A value that implements the [`(iter)`](../../language/classes.md#iter-obtain-iterator)
# protocol, as `for` and spreading require. Only an [`Iterable`](std.Iterable)
# also has its methods.
pub @class BaseIterable[T]
  # Returns an iterator over the value.
  pub def (iter) self -> BaseIter[T]


# A value that implements the [`(next)`](../../language/classes.md#next-iterator-protocol)
# protocol. Only an [`Iter`](std.Iter) also has its methods.
pub @class BaseIter[T]
  # Returns the next value, raising [`IterStop`](std.IterStop) once exhausted.
  pub def (next) self -> T


# A value that implements the [`(sink)`](../../language/classes.md#sink-obtain-sink)
# protocol. Only a [`Sinkable`](std.Sinkable) also has its methods.
pub @class BaseSinkable[T]
  # Returns a sink that writes to the value.
  pub def (sink) self -> BaseSink[T]


# A value that implements the [`(put)`](../../language/classes.md#put-sink-protocol)
# protocol. Only a [`Sink`](std.Sink) also has its methods.
pub @class BaseSink[T]
  # Writes a value.
  pub def (put) self value @ T


# An opaque type that mentions its type arguments, for a field that only marks
# how a class varies with its binders. A field of this type uses its arguments
# covariantly, although a field is otherwise invariant, so `Phantom[T]` marks a
# class covariant in `T` and `Phantom[(T -> nil)]` contravariant. A schema
# binder is mentioned by expanding it: `Phantom[...S]`.
pub @let Phantom[...Ts] = ...


# A value that implements the
# [`(index)`](../../language/classes.md#index-and-assign-subscript-access)
# protocol for the keys in `S`. A key must be one of `S`'s, though an item
# `S` may omit can still be missing.
pub @class Index[S @ {...}]
  field schema @Phantom[...S]

  # Returns the value at `key`.
  pub def (index)[K] self key@K -> IndexItem[S, K]


# A value that implements the
# [`(assign)`](../../language/classes.md#index-and-assign-subscript-access)
# protocol for the keys in `S`, which it need not already have.
pub @class Assign[S @ {...}]
  field schema @Phantom[((...S) -> nil)]

  # Sets the value at `key`.
  pub def (assign)[K] self key@K value@AssignItem[S, K]


# A value that implements the
# [`(spread)`](../../language/classes.md#spread-spreading) protocol, spreading
# as the items in `S`.
pub @class Spread[S @ {...}]
  field schema @Phantom[...S]

  # Returns a value to spread in place of this one.
  pub def (spread) self -> Spread[S]


# A value that implements the
# [`(unpack)`](../../language/classes.md#unpack-pattern-unpacking) protocol,
# destructuring as the items in `S` without changing the receiver.
#
# A `...` pattern captures the remaining items as a `Rest`, with the schema of
# those items in place of `S`. By default, the rest can only be spread.
pub @class Unpack[S @ {...}, :Rest @ Spread[S] = Spread[S]]: Spread[S]
  field schema @Phantom[...S]
  field rest @Phantom[Rest]

  # Returns a value to destructure in place of this one.
  pub def (unpack) self -> Unpack[S, Rest: Rest]


# Reads dictionary-like entries, including multiple values for a key.
# Integer keys retain the positional structure described by `S`.
pub @class Map[S @ {...}]:
  Index[S] Spread[S] Unpack[S, Rest: MapRest[S]] Iterable[Entries[S]]
do
  # The number of pairs, counting repeated keys separately.
  #[getter]
  pub def len self -> Int

  # Tests for a key, or for a matching key and value.
  pub def contains self key @ Value value @ Value = ... -> Bool

  # Counts distinct keys, or the values of one key. Missing keys count as zero.
  pub def count self key @ Value = ... -> Int

  # Reads an instance, defaulting to the last. Negative instances count backward.
  # Returns `nil` for a missing instance unless a fallback is supplied.
  pub def get[K, D = nil]
    self
    key @ K
    instance @ Int = ...
    :default @ D = ...
    :else @ (() -> D) = ...
  do -> (IndexItem[S, K] | D)

  # Yields each distinct key once.
  pub def keys self -> Iterable[Keys[S]]

  # Yields all values, or the values of one key.
  @def values self -> Iterable[Values[S]]
  @def values[K] self key @ K -> Iterable[IndexItem[S, K]]
  pub def values self key @ Value = ... -> Iterable[Values[S]]

  # Yields key-value pairs, as ordinary iteration does.
  pub def pairs self -> Iter[Entries[S]]

  # Destructures by key, leaving a rest that can also be destructured.
  pub def (unpack) self -> Map[S]


# A [`fields`](std.fields) proxy, which reads the members in `S` and sets those
# in `M`. A captured rest reads the members left over and sets none.
pub @class FieldProxy[S @ {...}, M @ {...}]:
  Iterable[Entries[S]] Index[S] Assign[M] Unpack[S, Rest: FieldProxy[S, {}]]
do
  # Returns this proxy, which destructures by key.
  pub def (unpack) self -> FieldProxy[S, M]


# A [`Map`](std.Map) supporting assignment, which replaces every value of a key.
# It need not support adding or removing keys.
pub @class AssignMap[S @ {...}]: Map[S] Assign[S]


# A [`Map`](std.Map) supporting assignment and removal.
pub @class MutMap[S @ {...}]: AssignMap[S]
  @def delete[K] self @ MutMap[Deletable[S, K]] key @ K -> Bool

  # Removes every value of a key, reporting whether any were present.
  pub def delete self key @ Value -> Bool

  @def pop[K, D = Never]
    self @ MutMap[Deletable[S, K]]
    key @ K
    instance @ Int = ...
    :default @ D = ...
    :else @ (() -> D) = ...
  do -> (IndexItem[S, K] | D)

  # Removes one instance, defaulting to the first. Negative instances count backward.
  #
  # ## Errors
  #
  # [`IndexError`](std.IndexError) if the instance is missing and no fallback is supplied.
  pub def pop[K, D = Never]
    self
    key @ K
    instance @ Int = ...
    :default @ D = ...
    :else @ (() -> D) = ...
  do -> (IndexItem[S, K] | D)

  @def clear self @ MutMap[Clearable[S]]

  # Removes every pair.
  pub def clear self


# An iterable sequence of `T`, which integers index, slices, spreads, and
# destructures.
pub @class Seq[T]: Iterable[T] Index[T] Spread[T] Unpack[T, Rest: Unpack[T]]
  # The number of items.
  #[getter]
  pub def len self -> Int

  @def (index)[K] self key@K -> IndexItem[{*T}, K]
  @def (index) self range@Range[Int] -> Seq[T]

  # Returns the item at an index, or the items in a range.
  pub def (index)[K] self key@K -> IndexItem[{*T}, K]


# A [`Seq`](std.Seq) whose items can be replaced, but not added or removed.
pub @class AssignSeq[T]: Seq[T] Assign[T]


# A [`Seq`](std.Seq) whose items can be replaced, added, and removed.
pub @class MutSeq[T]: AssignSeq[T]
  # Appends values.
  pub def push
    self
    # The values to append.
    ...values @ T
  do

  # Inserts values before `index`, shifting later items.
  pub def insert
    self
    # The position to insert at. Negative indexes count from the end.
    index @ Int
    # The values to insert.
    ...values @ T
  do

  # Removes and returns the last item, or the item at `index`.
  #
  # ## Errors
  #
  # [`IndexError`](std.IndexError) if the item does not exist and there is no
  # `default` or `else`.
  pub def pop[D = Never]
    self
    # The position to remove. Negative indexes count from the end.
    index @ Int = ...
    # The value to return when the item does not exist.
    :default @ D = ...
    # A block whose result to return when the item does not exist and there is
    # no `default`.
    :else @ (() -> D) = ...
  do -> (T | D)

  # Removes the item at `index` if it exists, returning whether it did.
  pub def delete
    self
    # The position to remove. Negative indexes count from the end.
    index @ Int
  do -> Bool

  # Removes all items.
  pub def clear self


# Abstract type for iterable values, whose instances have the methods below.
# Arrays, dicts, and ranges are `Iterable`; a [`Record`](std.Record), or a
# class that only implements [`(iter)`](std.BaseIterable), is not.
#[mixable]
pub class Iterable[T]: @BaseIterable[T]
  # Returns an iterator over the value.
  pub def iter self -> Iter[T]
    ...

  # Tests whether every item is truthy, or satisfies `pred`. An empty iterable
  # passes.
  pub def all self pred @ ((T) -> Value) = ... -> Bool
    ...

  # Tests whether any item is truthy, or satisfies `pred`. An empty iterable
  # fails.
  pub def any self pred @ ((T) -> Value) = ... -> Bool
    ...

  # Returns an iterator over the items, followed by the items of each additional
  # iterable.
  pub def chain[*Us] self *values @ ...Iterable[Us] -> Iter[Union[T, ...Us]]
    ...

  @def chomp self @ Iterable[Str] -> Iter[Str]
  @def chomp self @ Iterable[Bin] -> Iter[Bin]

  # Returns an iterator with one trailing line terminator (`\r\n` or `\n`)
  # removed from each item, if present.
  #
  # Distinct from [`Str.trim_end`](std.Str.trim_end), which is about whitespace
  # generally and takes an optional character set. `chomp` is about a line
  # terminator specifically and takes nothing.
  #
  # ## Errors
  #
  # Getting an item raises [`TypeError`](std.TypeError) if it is neither a `Str`
  # nor a `Bin`.
  #
  # ## Example
  #
  # ```
  # assert_eq [...["a\n", "b\r\n", "c"].chomp()] ["a", "b", "c"]
  #
  # for line = shell.stdin.chomp()
  #   echo "got $line"
  # ```
  pub def chomp self -> Iter[Str | Bin]
    ...

  @def crimp self@Iterable[Str] terminator@(Str | Bin) = ... -> Iter[Str]
  @def crimp self@Iterable[Bin] terminator@(Str | Bin) = ... -> Iter[Bin]

  # Returns an iterator with a line terminator appended to each item.
  #
  # The inverse of [`chomp`](std.Iterable.chomp), and the usual way to terminate
  # values on their way into a byte stream. The terminator is appended
  # **unconditionally**: an item that already ends in one gets a second.
  #
  # ## Errors
  #
  # Raises [`TypeError`](std.TypeError) for an item, or a terminator, that is
  # neither a `Str` nor a `Bin`, or if a `Bin` terminator would leave a `Str` item
  # invalid UTF-8.
  #
  # ## Example
  #
  # ```
  # assert_eq [...["a", "b"].crimp()] ["a\n", "b\n"]
  # assert_eq [...["a"].crimp("\r\n")] ["a\r\n"]
  #
  # run cmd stdin: (["one", "two"].crimp())
  # ```
  pub def crimp self terminator@(Str | Bin) = ... -> Iter[Str | Bin]
    ...

  # Returns an iterator of `(index, value)` tuples, counting from `0`.
  pub def enumerate self -> Iter[Tuple[Int, T]]
    ...

  # Returns an iterator of the items for which `pred` is truthy.
  pub def filter self pred @ ((T, <Value, >Value) -> Value) -> Iter[T]
    ...

  # Returns the first item for which `pred` is truthy.
  #
  # ## Errors
  #
  # Raises [`RuntimeError`](std.RuntimeError) if no item matches and there is
  # no `default` or `else`.
  pub def find[D = T]
    self
    pred @ ((T) -> Value)
    :default @ D = ...
    :else @ (() -> D) = ...
  do -> (T | D)
    ...

  # Accumulates a value left to right, calling `func` with the accumulated value
  # and each item. Returns `init` if there are no items.
  pub def fold[A] self init@A func@((A, T) -> A) -> A
    ...

  @def kv[K, V] self @ Iterable[Unpack[{K, V}]] -> Spread[K, V]

  # Adapts the elements for keyed spreading, using [`iter`](std.Iterable.iter).
  #
  # Each element must unpack into exactly two values without being consumed.
  # Spreading consumes the source iterator. The adapter does not support iteration.
  #
  # ```
  # let entries = [("x", 1), ("y", 2)]
  # assert_eq {...entries.kv()} {"x": 1, "y": 2}
  # ```
  pub def kv self -> Spread[{...}]
    ...

  # Returns an iterator that maps each item through `func`.
  pub def map[U] self func @ ((T, <Value, >Value) -> U) -> Iter[U]
    ...

  # Returns the largest item.
  #
  # ## Errors
  #
  # Raises [`IterStop`](std.IterStop) if there are no items and no `default`.
  pub def max[D = T] self :default @ D = ... -> (T | D)
    ...

  # Returns the smallest item.
  #
  # ## Errors
  #
  # Raises [`IterStop`](std.IterStop) if there are no items and no `default`.
  pub def min[D = T] self :default @ D = ... -> (T | D)
    ...

  # Returns an iterator that discards the first `n` items.
  #
  # ## Errors
  #
  # Raises [`ValueError`](std.ValueError) if `n` is negative.
  pub def skip self n @ Int -> Iter[T]
    ...

  # Returns an iterator yielding at most `n` items.
  #
  # ## Errors
  #
  # Raises [`ValueError`](std.ValueError) if `n` is negative.
  pub def take self n @ Int -> Iter[T]
    ...

  # Returns an iterator of tuples across this and additional iterables, which
  # stops at the end of the shortest.
  pub def zip[*Us] self *values @ ...Iterable[Us] -> Iter[Tuple[T, ...Us]]
    ...

  # Returns an iterator over the items.
  pub def (iter) self -> BaseIter[T]
    ...


# Abstract type for values that sinks can be obtained from, whose instances have
# the methods below. An [`Array`](std.Array) is `Sinkable`; a class that only
# implements [`(sink)`](std.BaseSinkable) is not.
#[mixable]
pub class Sinkable[T]: @BaseSinkable[T]
  # Returns a sink over the value.
  pub def sink self -> Sink[T]
    ...

  # Writes a value to the sink.
  pub def put self value @ T
    ...

  @def prechomp self @ Sinkable[Str] -> Sink[Str]
  @def prechomp self @ Sinkable[Bin] -> Sink[Bin]

  # Returns a sink that removes one trailing line terminator (`\n` or `\r\n`)
  # from each value, if present, before writing it.
  #
  # ## Errors
  #
  # Putting a value raises [`TypeError`](std.TypeError) if it is neither a
  # `Str` nor a `Bin`.
  #
  # ## Example
  #
  # ```
  # let acc = []
  # let out = acc.prechomp()
  # out.put "line\n"
  # assert_eq $acc ["line"]
  # ```
  pub def prechomp self -> Sink[T]
    ...

  @def precrimp self@Sinkable[Str] terminator@(Str | Bin) = ... -> Sink[Str]
  @def precrimp self@Sinkable[Bin] terminator@(Str | Bin) = ... -> Sink[Bin]

  # Returns a sink that appends a line terminator to each value before writing
  # it. The append is unconditional, so a value that already ends in one gets a
  # second.
  #
  # ## Errors
  #
  # Raises [`TypeError`](std.TypeError) for a value, or a terminator, that is
  # neither a `Str` nor a `Bin`, or if a `Bin` terminator would leave a `Str` value
  # invalid UTF-8.
  #
  # ## Example
  #
  # ```
  # let out = shell.stdout.precrimp()
  # out.put "hello"
  # # writes "hello\n"
  #
  # open $path w do |file|
  #   file.precrimp(shell.line_ending()).put "native"
  # ```
  pub def precrimp self terminator@(Str | Bin) = ... -> Sink[T]
    ...

  # Returns a sink that writes only the values for which `pred` is truthy.
  #
  # Because each wrapper transforms values on the way in, the outermost wrapper
  # sees a value first — the reverse of an iterator chain.
  #
  # ## Example
  #
  # ```
  # let acc = []
  # let out = acc.prefilter (do |x| x % 2 == 0)
  # out.put 1
  # out.put 2
  # assert_eq $acc [2]
  # ```
  pub def prefilter[U @ T] self pred @ ((U, <Value, >Value) -> Value) -> Sink[U]
    ...

  # Returns a sink that transforms each value with `func` before writing it.
  #
  # The `pre` prefix marks the direction: unlike [`map`](std.Iterable.map),
  # which transforms values on their way *out*, `premap` transforms values on
  # their way *into* the sink. A value that is both [`Iterable`](std.Iterable)
  # and `Sinkable` — an [`Array`](std.Array), say — therefore offers `map` and
  # `premap` as separate methods running in opposite directions.
  #
  # ## Example
  #
  # ```
  # let acc = []
  # let out = acc.premap (do |x| x * 2)
  # out.put 3
  # assert_eq $acc [6]
  # ```
  pub def premap[U] self func @ ((U, <Value, >Value) -> T) -> Sink[U]
    ...

  # Returns a sink that writes to the value.
  pub def (sink) self -> Sink[T]
    ...


# Abstract type for sinks, whose instances have the methods below. Built-in
# sinks are `Sink`; a class that only implements [`(put)`](std.BaseSink) is not.
#
# `Sink` is not constructible directly.
#
# ```
# assert_eq (type $ [].sink()) $Sink
# ```
#[mixable]
pub class Sink[T]: Sinkable[T] @BaseSink[T]
  @def prechomp self @ Sink[Str] -> Sink[Str]
  @def prechomp self @ Sink[Bin] -> Sink[Bin]

  # Returns a sink that removes one trailing line terminator from each value
  # before writing it, as [`Sinkable.prechomp`](std.Sinkable.prechomp) does.
  pub def prechomp self -> Sink[T]
    ...

  @def precrimp self@Sink[Str] terminator@(Str | Bin) = ... -> Sink[Str]
  @def precrimp self@Sink[Bin] terminator@(Str | Bin) = ... -> Sink[Bin]

  # Returns a sink that appends a line terminator to each value before writing
  # it, as [`Sinkable.precrimp`](std.Sinkable.precrimp) does.
  pub def precrimp self terminator@(Str | Bin) = ... -> Sink[T]
    ...

  # Returns a sink that writes only the values for which `pred` is truthy.
  pub def prefilter[U @ T] self pred @ ((U, <Value, >Value) -> Value) -> Sink[U]
    ...

  # Returns a sink that transforms each value with `func` before writing it.
  pub def premap[U] self func @ ((U, <Value, >Value) -> T) -> Sink[U]
    ...

  # Writes a value to the sink.
  pub def put self value @ T
    ...

  # Writes a value.
  pub def (put) self value @ T
    ...


# Raised when execution is aborted by the host trap mechanism.
#
# Cannot be caught.
pub class AbortError: Error

# The read-only half of an [`Array`](std.Array), whose elements it holds
# covariantly: an `Array[Str]` is a `BaseArray[Str | Sym]`.
#
# Use `BaseArray` for inputs that only read an array. Unlike [`Seq`](std.Seq),
# it requires an actual array. It is `Array` at runtime; the view neither
# prevents mutation through another reference nor takes a snapshot.
pub class BaseArray[T]: Iterable[T] @Unpack[T, Rest: SeqRest[T]] @Seq[T]
  # Returns the number of elements.
  #
  # ## Example
  #
  # ```
  # assert_eq $[1, 2, 3].len 3
  # ```
  #[getter]
  pub def len self -> Int
    ...

  # Tests whether the array contains the given element (by equality).
  #
  # ## Example
  #
  # ```
  # let arr = [1, 2, 3, "hello"]
  # assert (arr.contains 2)
  # assert (arr.contains "hello")
  # assert (!arr.contains 4)
  # assert (![].contains 1)
  # ```
  pub def contains
    self
    # the value to check
    element @ Value
  do -> Bool
    ...

  # Returns a shallow copy of the array. Contents are *not* copied recursively.
  #
  # When inherited by a Do subclass, `copy()` calls the subclass constructor with
  # the source array as a single positional argument.
  pub def copy self -> BaseArray[T]
    ...

  # Retrieves the value at the given index. Returns `nil` if out of bounds and no
  # alternative is provided. Negative indexes count from the end.
  #
  # ## Example
  #
  # ```
  # let arr = [10, 20, 30]
  # assert_eq (arr.get 0) 10
  # assert_eq (arr.get -1) 30
  # assert_eq (arr.get 5 default: "missing") "missing"
  # assert_eq (arr.get 5 else: do "computed") "computed"
  # ```
  pub def get[D = nil]
    self
    # the index to access
    index @ Int
    :default @ D = ...
    :else @ (() -> D) = ...
  do -> (T | D)
    ...

  # Returns an iterator with read-only unpacking.
  pub def iter self -> UnpackIter[T]
    ...

  # Returns an iterator yielding `(index, value)` pairs.
  #
  # ## Example
  #
  # ```
  # for i v = [10, 20, 30].pairs()
  #   echo "$i: $v"
  # # 0: 10
  # # 1: 20
  # # 2: 30
  # ```
  pub def pairs self -> UnpackIter[Tuple[Int, T]]
    ...

  @def (index)[K] self key@K -> IndexItem[{*T}, K]
  @def (index) self range@Range[Int] -> BaseArray[T]

  # Returns an element, or a new array for a slice.
  #
  # ```
  # let arr = [10, 20, 30]
  # assert_eq $arr[0] 10
  # assert_eq $arr[-1] 30
  # ```
  #
  # An index out of bounds raises [`IndexError`](std.IndexError); `get` returns
  # a default instead.
  #
  # Arrays also accept [`Range`](std.Range) values for slicing:
  #
  # ```playground
  # #> import test:
  # #>   - assert_eq
  # let arr = [0, 1, 2, 3]
  # assert_eq $arr[1..3] [1, 2]
  # assert_eq $arr[..2] [0, 1]
  # assert_eq $arr[2..] [2, 3]
  # assert_eq $arr[..] [0, 1, 2, 3]
  # assert_eq $arr[Range 0 4 2] [0, 2]
  # assert_eq $arr[Range nil nil -1] [3, 2, 1, 0]
  # ```
  #
  # Omitted `start` means `0`, omitted `end` means the array length, and negative
  # `start` and `end` values count from the end. Negative steps reverse the slice.
  pub def (index)[K] self key@K -> IndexItem[{*T}, K]
    ...

  # Returns an iterator over the elements.
  #
  # ```
  # for value = [1, 2, 3]
  #   echo $value
  # ```
  pub def (iter) self -> UnpackIter[T]
    ...

  # Destructures the array positionally.
  #
  # ```
  # let a b ...rest = [1, 2, 3, 4]
  # assert_eq $a 1
  # assert_eq $b 2
  # ```
  pub def (unpack) self -> Unpack[T, Rest: SeqRest[T]]
    ...

  # Spreads the items positionally.
  pub def (spread) self -> Spread[T]
    ...


# Arrays are ordered, mutable sequences of values.
#
# The element type is invariant. Use [`BaseArray`](std.BaseArray) for a
# covariant read view, or [`Seq`](std.Seq) to accept other sequences too.
pub class Array[T]: BaseArray[T] Sinkable[T] @MutSeq[T]
  # Builds an array from one iterable. The lowercase `array` factory instead
  # collects its positional arguments verbatim.
  pub def (init) self iterable @ Iterable[T]
    ...

  # Removes all elements from the array.
  #
  # ```
  # let arr = [1, 2, 3]
  # arr.clear()
  # assert_eq $arr.len 0
  # ```
  pub def clear self
    ...

  # Indicates whether an element was removed. Deletes the element at `index` if it exists.
  # Negative indexes count from the end.
  #
  # Out-of-bounds indexes are ignored.
  #
  # ## Example
  #
  # ```
  # let arr = [10, 20, 30]
  # assert (arr.delete 1)
  # assert (arr.delete -1)
  # assert (!(arr.delete 99))
  # assert_eq $arr [10]
  # ```
  pub def delete self index @ Int -> Bool
    ...

  # Inserts one or more values at the specified index, shifting existing elements.
  # Negative indexes count from the end; `-1` inserts before the last element.
  #
  # ## Example
  #
  # ```
  # let arr = [1, 2, 3]
  # arr.insert 1 42
  # assert_eq $arr [1, 42, 2, 3]
  # arr.insert -1 99
  # assert_eq $arr [1, 42, 2, 99, 3]
  # ```
  pub def insert
    self
    # the position to insert at
    index @ Int
    # values to insert
    ...values @ T
  do
    ...

  # Removes and returns the last element, or the element at `index` if provided.
  # Negative indexes count from the end.
  #
  # ## Errors
  #
  # Raises [`IndexError`](std.IndexError) if the element does not exist and
  # there is no `default` or `else`.
  #
  # ## Example
  #
  # ```
  # let arr = [1, 2, 3]
  # assert_eq $arr.pop() 3
  # assert_eq $arr [1, 2]
  # assert_eq $arr.pop(0) 1
  #
  # let empty = []
  # assert_eq (empty.pop default: "none") "none"
  # ```
  pub def pop[D = Never]
    self
    # optional index to remove; defaults to the last element
    index @ Int = ...
    :default @ D = ...
    :else @ (() -> D) = ...
  do -> (T | D)
    ...

  # Appends one or more values to the end of the array.
  #
  # ## Example
  #
  # ```
  # let arr = [1, 2]
  # arr.push 3
  # assert_eq $arr [1, 2, 3]
  # ```
  pub def push
    self
    # values to append
    ...values @ T
  do
    ...

  # Sorts the array in place.
  #
  # ## Example
  #
  # ```playground
  # #> import test:
  # #>   - assert_eq
  # let arr = ["bbb", "a", "cc"]
  # arr.sort key: (do |x| x.len)
  # assert_eq $arr ["a", "cc", "bbb"]
  #
  # arr.sort reverse: true
  # assert_eq $arr ["cc", "bbb", "a"]
  # ```
  pub def sort
    self
    :key @ ((T) -> Value) = ...
    :reverse @ Bool = ...
  do
    ...

  # Returns a shallow copy, as [`BaseArray.copy`](std.BaseArray.copy) does.
  pub def copy self -> Array[T]
    ...

  @def (index)[K] self key@K -> IndexItem[{*T}, K]
  @def (index) self range@Range[Int] -> Array[T]

  # Returns an element, or a new array for a slice.
  pub def (index)[K] self key@K -> IndexItem[{*T}, K]
    ...

  @def (assign)[K] self key@K value@AssignItem[{*T}, K]
  @def (assign) self range@Range[Int] value@(BaseArray[T] | Tuple[...T])

  # Replaces an element, or the elements of a slice.
  #
  # ```
  # let arr = [0, 1, 2, 3]
  # arr[1..3] = [9, 9]
  # assert_eq $arr [0, 9, 9, 3]
  #
  # arr[1..1] = (tuple 4 5)
  # assert_eq $arr [0, 4, 5, 9, 9, 3]
  # ```
  #
  # A slice's replacement must be an [`Array`](std.Array) or a
  # [`Tuple`](std.Tuple), and its length may differ from the slice's. Any other
  # value, including a [`Range`](std.Range) or an iterator, raises
  # [`TypeError`](std.TypeError). A slice with a step other than 1 can't be
  # assigned and raises [`IndexError`](std.IndexError).
  pub def (assign)[K] self key@K value@AssignItem[{*T}, K]
    ...


# Binary data; an immutable sequence of bytes.
pub class Bin: @Index[Range[Int], Bin]
  # Accepts binary data or copies the UTF-8 bytes of a string.
  #
  # ## Example
  #
  # ```
  # let data = Bin "hello"
  # assert_eq $data b"hello"
  # ```
  pub def (init)
    self
    # source bytes
    value @ (Bin | Str)
  do
    ...

  # Returns the byte length of the binary data.
  #
  # ## Example
  #
  # ```
  # assert_eq (b"hello".len) 5
  # assert_eq (b"".len) 0
  # ```
  #[getter]
  pub def len self -> Int
    ...

  # Removes one trailing line terminator.
  #
  # One complete terminator — `\r\n` or `\n`, never a lone `\r` — and nothing
  # else. Data without one is returned unchanged. Distinct from
  # [`trim_end`](std.Bin.trim_end), which strips whitespace generally.
  # [`Iterable.chomp`](std.Iterable.chomp) does the same to each item of an
  # iterable.
  #
  # ## Example
  #
  # ```
  # assert_eq (b"line\n".chomp()) b"line"
  # assert_eq (b"line\r\n".chomp()) b"line"
  # ```
  pub def chomp self -> Bin
    ...

  # Tests whether the binary data contains the given bytes.
  #
  # ## Example
  #
  # ```
  # assert (b"hello".contains b"ell")
  # assert (b"hello".contains b"lo")
  # assert (!(b"hello".contains b"world"))
  # assert (b"hello".contains b"")
  # ```
  pub def contains
    self
    # the bytes to find
    needle @ Bin
  do -> Bool
    ...

  # Tests whether the binary data ends with the given suffix.
  #
  # ## Example
  #
  # ```
  # assert (b"hello".ends_with b"lo")
  # ```
  pub def ends_with
    self
    # the suffix bytes
    suffix @ Bin
  do -> Bool
    ...

  # Joins values from an input source using this binary data as a separator.
  #
  # ## Example
  #
  # ```
  # assert_eq (b",".join [b"a", b"b", b"c"]) b"a,b,c"
  # ```
  pub def join
    self
    # iterable to join; uses the default input when omitted
    iter @ Iterable[Str | Bin] = ...
  do -> Bin
    ...

  # Like `split`, but yields segments in **right-to-left** order. Mirrors
  # [`str.rsplit`](std.Str.rsplit).
  #
  # ## Example
  #
  # ```
  # assert_eq [...b"a,b,c".rsplit b","] [b"c", b"b", b"a"]
  # assert_eq [...b"a,b,c".rsplit b"," limit: 1] [b"c", b"a,b"]
  # ```
  pub def rsplit
    self
    # the delimiter bytes
    delimiter @ Bin
    # max splits; negative means split from left
    :limit @ Int = ...
  do -> UnpackIter[Bin]
    ...

  # Splits the binary data by the delimiter, returning an iterator that yields
  # segments in **left-to-right** order.
  #
  # The optional `limit` works identically to
  # [`str.split`](std.Str.split): positive splits from the
  # left, negative splits from the right (but still yields left-to-right).
  #
  # ## Example
  #
  # ```
  # assert_eq [...b"a,b,c".split b","] [b"a", b"b", b"c"]
  # assert_eq [...b"a,b,c".split b"," limit: 1] [b"a", b"b,c"]
  # let base ext = b"archive.tar.gz".split b"." limit: -1
  # assert_eq $base b"archive.tar"
  # assert_eq $ext b"gz"
  # ```
  pub def split
    self
    # the delimiter bytes
    delimiter @ Bin
    # max splits; negative means split from right
    :limit @ Int = ...
  do -> UnpackIter[Bin]
    ...

  # Tests whether the binary data starts with the given prefix.
  #
  # ## Example
  #
  # ```
  # assert (b"hello".starts_with b"he")
  # assert (!(b"hello".starts_with b"lo"))
  # ```
  pub def starts_with
    self
    # the prefix bytes
    prefix @ Bin
  do -> Bool
    ...

  # Removes bytes (or specified characters) from both ends.
  #
  # ## Example
  #
  # ```
  # assert_eq (b"  hello  ".trim()) b"hello"
  # assert_eq (b"xxhelloxx".trim b"x") b"hello"
  # assert_eq (b"xyhelloyx".trim [b"x", b"y"]) b"hello"
  # assert_eq (b"\x00\xffdata\xff\x00".trim b"\x00\xff") b"data"
  # ```
  pub def trim
    self
    chars @ (Bin | Iterable[Bin]) = ...
  do -> Bin
    ...

  # Removes bytes (or specified characters) from the end.
  #
  # ## Example
  #
  # ```
  # assert_eq (b"  hello  ".trim_end()) b"  hello"
  # assert_eq (b"xxhelloxx".trim_end b"x") b"xxhello"
  # ```
  pub def trim_end
    self
    chars @ (Bin | Iterable[Bin]) = ...
  do -> Bin
    ...

  # Removes bytes (or specified characters) from the start.
  #
  # ## Example
  #
  # ```
  # assert_eq (b"  hello  ".trim_start()) b"hello  "
  # assert_eq (b"xxhelloxx".trim_start b"x") b"helloxx"
  # ```
  pub def trim_start
    self
    chars @ (Bin | Iterable[Bin]) = ...
  do -> Bin
    ...

  # Returns an immutable view of the binary data's byte values.
  #
  # The view retains the binary data without copying it. It supports `len`,
  # positive and negative integer indexing, iteration, spreading, and positional
  # destructuring. Elements are integers from 0 to 255. Range slices materialize
  # independent, mutable arrays of integers. Use `[...bytes.unpack()]` to copy
  # the whole view into a mutable array.
  #
  # ## Example
  #
  # ```
  # let bytes = b"hello"
  # assert_eq [...bytes.unpack()] [104, 101, 108, 108, 111]
  # ```
  pub def unpack self -> Seq[Int]
    ...

  # Returns the binary data with the prefix removed if it matches, otherwise
  # returns the original data.
  #
  # ## Example
  #
  # ```
  # assert_eq (b"hello".without_prefix b"he") b"llo"
  # assert_eq (b"hello".without_prefix b"xx") b"hello"
  # ```
  pub def without_prefix
    self
    # the prefix to remove
    prefix @ Bin
  do -> Bin
    ...

  # Returns the binary data with the suffix removed if it matches, otherwise returns
  # the original data.
  #
  # ## Example
  #
  # ```
  # assert_eq (b"hello".without_suffix b"lo") b"hel"
  # ```
  pub def without_suffix
    self
    # the suffix to remove
    suffix @ Bin
  do -> Bin
    ...

  # Returns the bytes in a range as a new binary value.
  #
  # ```
  # assert_eq (b"abcd"[1..3]) b"bc"
  # assert_eq (b"abcd"[..2]) b"ab"
  # assert_eq (b"abcd"[2..]) b"cd"
  # assert_eq (b"abcd"[..]) b"abcd"
  # assert_eq (b"foobar"[-3..]) b"bar"
  # assert_eq (b"abcd"[Range 0 4 2]) b"ac"
  # assert_eq (b"abcd"[Range nil nil -1]) b"dcba"
  # ```
  #
  # The range must lie within the value. Omitted `start` means `0`, omitted `end`
  # means the binary length, and negative endpoints count from the end. Negative
  # steps reverse the slice.
  pub def (index) self range@Range[Int] -> Bin
    ...

  # Packs an array of integers (0-255) into binary data.
  #
  # ## Example
  #
  # ```
  # let bytes = Bin.pack [104, 101, 108, 108, 111]
  # assert_eq $bytes b"hello"
  # ```
  #[class]
  pub def pack
    self
    # array of integers (0-255)
    array @ Array[Int]
  do -> Bin
    ...


# Mutable byte buffer; the mutable counterpart to [`Bin`](std.Bin).
#
# A buffer is an [`Io`](io.Io) that only writes, appending what it is given, so
# it can collect the output of anything that writes to a stream:
#
# ```
# let buf = BinBuf()
# run uname -r stdout: $buf
# let release = buf.freeze_str()
# ```
#
# To read, overwrite or seek within a buffer, use an [`io.Cursor`](io.Cursor).
pub class BinBuf: @Index[Int] @Assign[Int] Io
  # Builds a buffer, optionally seeded with the contents of existing binary data.
  #
  # ## Example
  #
  # ```
  # let buf = BinBuf(b"hello")
  # assert_eq $buf.len 5
  # ```
  pub def (init)
    self
    # initial contents
    initial @ Bin = ...
  do
    ...

  # Returns the byte length of the buffer's current contents.
  #
  # ## Example
  #
  # ```
  # assert_eq (BinBuf(b"hello").len) 5
  # ```
  #[getter]
  pub def len self -> Int
    ...

  # Appends `value` to the buffer. `Str`/`Bin` input is copied byte-for-byte
  # (round-tripping non-UTF-8 bytes exactly); anything else is converted the
  # same way [`str`](std.str) would convert it, written directly
  # into the buffer.
  #
  # ## Example
  #
  # ```
  # let buf = BinBuf()
  # buf.append b"foo"
  # buf.append "bar"
  # buf.append 42
  # assert_eq $buf.freeze() b"foobar42"
  # ```
  pub def append
    self
    # value to append
    value @ Value
  do
    ...

  # Empties the buffer, retaining its allocated capacity.
  #
  # ```
  # let buf = BinBuf(b"foobar")
  # buf.clear()
  # assert_eq $buf.len 0
  # buf.append b"x"
  # assert_eq $buf.freeze() b"x"
  # ```
  pub def clear self
    ...

  # Tests whether the buffer's contents contain the given bytes.
  #
  # ## Example
  #
  # ```
  # assert (BinBuf(b"foobar").contains b"oob")
  # ```
  pub def contains
    self
    # the bytes to find
    needle @ Bin
  do -> Bool
    ...

  # Returns an iterator that removes and yields up to `size` bytes at a time
  # from the front of the buffer as it's consumed.
  #
  # ## Example
  #
  # ```
  # let buf = BinBuf(b"hello world")
  # assert_eq [...buf.drain(4)] [b"hell", b"o wo", b"rld"]
  # assert_eq $buf.len 0
  # ```
  #
  # Draining doesn't move the remaining contents for each chunk, so its cost
  # grows with the bytes drained, not with what is left. Indexes given to other
  # methods count from the start of what remains. Several `drain` iterators over
  # one buffer take turns removing from the same content.
  pub def drain
    self
    # Maximum bytes per chunk; 512 KiB when omitted.
    size @ Int = ...
  do -> Iter[Bin]
    ...

  # Tests whether the buffer's contents end with the given suffix.
  #
  # ## Example
  #
  # ```
  # assert (BinBuf(b"foobar").ends_with b"bar")
  # ```
  pub def ends_with
    self
    # the suffix bytes
    suffix @ Bin
  do -> Bool
    ...

  # Appends the raw bytes of `value`, which must be a [`Str`](std.Str) or
  # [`Bin`](std.Bin).
  #
  # ## Example
  #
  # ```
  # let buf = BinBuf(b"foo")
  # buf.extend b"bar"
  # assert_eq $buf.freeze() b"foobar"
  # ```
  pub def extend
    self
    value @ (Bin | Str)
  do
    ...

  # Converts the buffer's current contents into an immutable [`Bin`](std.Bin)
  # in place, without copying, and empties the buffer. The buffer stays usable
  # afterward, and the returned value is unaffected by later mutation.
  #
  # ## Example
  #
  # ```
  # let buf = BinBuf(b"abc")
  # let frozen = buf.freeze()
  # assert_eq $frozen b"abc"
  # assert_eq $buf.len 0
  # buf.append b"def"
  # assert_eq $frozen b"abc"
  # ```
  pub def freeze self -> Bin
    ...

  # Converts the buffer's current contents into an immutable [`Str`](std.Str)
  # without copying, and empties the buffer, as [`freeze`](std.BinBuf.freeze)
  # does.
  #
  # The contents are checked as UTF-8 only here, so text written in pieces
  # that split characters is collected intact.
  #
  # ## Errors
  #
  # Raises a [`RuntimeError`](std.RuntimeError) if the contents are not valid
  # UTF-8, leaving them in the buffer.
  #
  # ## Example
  #
  # ```
  # let buf = BinBuf()
  # buf.write b"caf\xc3"
  # buf.write b"\xa9"
  # assert_eq $buf.freeze_str() "café"
  # ```
  pub def freeze_str self -> Str
    ...

  # Always `true`.
  #[getter]
  pub def writable self -> Bool
    ...

  # Appends data, given in pieces.
  #
  # ## Returns
  #
  # The number of bytes appended, which is all of them.
  pub def write
    self
    # Data to append.
    *data @ (Str | Bin)
  do -> Int
    ...

  # Does nothing, since writes are never held back.
  pub def flush self
    ...

  # Inserts `value` at the given byte index, shifting the rest of the buffer
  # right in place. `value` may be a single byte value, or a `Str`/`Bin` slice.
  #
  # ## Example
  #
  # ```
  # let buf = BinBuf(b"foobar")
  # buf.insert 3 b"XYZ"
  # buf.insert 0 65
  # assert_eq $buf.freeze() b"AfooXYZbar"
  # ```
  pub def insert
    self
    # insertion point
    index @ Int
    # Byte value (0-255) or binary data.
    value @ (Int | Bin)
  do
    ...

  # Appends one or more raw byte values to the buffer.
  #
  # ## Example
  #
  # ```
  # let buf = BinBuf()
  # buf.push 104 105
  # assert_eq $buf.freeze() b"hi"
  # ```
  pub def push
    self
    # byte values (0-255) to append
    *bytes @ Int
  do
    ...

  # Removes and returns a byte or a range of bytes, shifting the rest of the
  # buffer left in place. An [`Int`](std.Int) index removes and returns a
  # single byte; a [`Range`](std.Range) removes and returns a [`Bin`](std.Bin)
  # of the removed bytes.
  #
  # ## Example
  #
  # ```
  # let buf = BinBuf(b"foobar")
  # assert_eq (buf.remove 0) 102
  # assert_eq $buf.freeze() b"oobar"
  #
  # let buf2 = BinBuf(b"foobar")
  # assert_eq (buf2.remove (1..3)) b"oo"
  # assert_eq $buf2.freeze() b"fbar"
  # ```
  pub def remove
    self
    index_or_range @ (Int | Range[Int])
  do -> (Int | Bin)
    ...

  # Tests whether the buffer's contents start with the given prefix.
  #
  # ## Example
  #
  # ```
  # assert (BinBuf(b"foobar").starts_with b"foo")
  # ```
  pub def starts_with
    self
    # the prefix bytes
    prefix @ Bin
  do -> Bool
    ...

  # Shrinks the buffer to `len` bytes, discarding anything past that point.
  #
  # ## Example
  #
  # ```
  # let buf = BinBuf(b"foobar")
  # buf.truncate 3
  # assert_eq $buf.freeze() b"foo"
  # ```
  pub def truncate
    self
    # new length
    len @ Int
  do
    ...

  # Unlike `StrBuf`, `BinBuf` supports both scalar and range indexing and
  # indexing:
  #
  # ```
  # let buf = BinBuf(b"foobar")
  # assert_eq $buf[0] 102
  # assert_eq $buf[2..4] b"ob"
  # ```
  @def (index)[K] self key@K -> IndexItem[{*Int}, K]
  @def (index) self range@Range[Int] -> Bin
  pub def (index)[K] self key@K -> IndexItem[{*Int}, K]
    ...

  # Assigns a byte or byte range. Range assignment may grow or shrink the buffer.
  #
  # ```
  # let buf = BinBuf(b"foobar")
  # buf[0] = 70
  # buf[1..3] = b"XYZ"
  # assert_eq $buf.freeze() b"FXYZbar"
  # ```
  @def (assign)[K] self key@K value@AssignItem[{*Int}, K]
  @def (assign) self range@Range[Int] value@Bin
  pub def (assign)[K] self key@K value@AssignItem[{*Int}, K]
    ...

  pub def (put) self value@Value -> nil
    ...


# Boolean values: `true` and `false`.
#[final]
pub class Bool
  # Accepts an existing boolean.
  pub def (init) self
    ...

  # Converts to a boolean.
  pub def (bool) self -> Bool
    ...


# Raised on bytecode verification errors.
#[mixable]
pub class BytecodeError: RuntimeError
  # Builds an error reporting a bytecode verification failure.
  pub def (init)
    self
    # description of the verification failure
    message @ Str
  do
    ...


# Raised when a strand is canceled. During `finally` blocks, cancellation is
# masked so cleanup can complete. See
# [Concurrency](../../language/concurrency.md) for details.
pub class CanceledError: Error
  # Builds an error reporting that a strand was canceled.
  pub def (init) self
    ...


# Decorator placing a class member in the type-object namespace, where subclasses
# inherit it.
#
# Applies to a `def` or a `field` inside a class body. A class method receives the
# class it was reached through as its first parameter. Each class in a hierarchy
# gets its own storage for a class field, seeded from the declared initializer.
#
# ```
# class Counter
#   #[class]
#   pub field count = 0
#
#   #[class]
#   pub def bump cls
#     cls.count = (cls.count + 1)
#     cls.count
#
# assert_eq $Counter.bump() 1
# ```
#
# See [`static`](std.static) for the uninherited counterpart, and
# [Class and Static Members](../../language/classes.md#class-and-static-members)
# for the full semantics.
pub let class @ Value = ...

# Raised on compilation errors.
#[mixable]
pub class CompileError: RuntimeError
  # Builds an error reporting a compilation failure.
  pub def (init)
    self
    # description of the compilation failure
    message @ Str
  do
    ...


# Raised when a concurrent access violation is detected.
#[mixable]
pub class ConcurrencyError: RuntimeError
  # Builds an error reporting a conflicting concurrent operation.
  pub def (init)
    self
    # detail appended to the generic message
    message @ Str = ...
  do
    ...


# Raised when a cyclic module dependency is detected.
#[mixable]
pub class CyclicImportError: RuntimeError
  # Builds an error naming the module at which an import cycle was detected.
  pub def (init)
    self
    # the module at which the cycle was detected
    name @ Str
  do
    ...


# The read-only half of a [`Dict`](std.Dict), whose items it holds covariantly:
# a `Dict[{a: Int}]` is a `BaseDict[{a: (Int | Str)}]`. A parameter that only
# reads a dict takes a `BaseDict`, so it accepts dicts with narrower items.
#
# `BaseDict` is `Dict` at runtime, so only a dict is a `BaseDict`.
pub class BaseDict[S @ {...}]:
  @Map[S] @Index[S] @Spread[S]
  @Unpack[S, Rest: MapRest[S]]
  Iterable[Entries[S]]
do
  # Returns the number of key-value pairs (counting each value in a multi-map
  # separately).
  #[getter]
  pub def len self -> Int
    ...

  # Tests whether the dictionary contains the given key. If a value is provided,
  # tests whether any value associated with that key matches the given value
  # (multi-map aware).
  #
  # ## Example
  #
  # ```playground
  # #> import test:
  # #>   - assert
  # let d = {a: 1, b: 2}
  # d.insert :a: 3
  #
  # # Key-only check. A bareword key is a `Sym`, so `"a"` would not match it.
  # assert (d.contains :a:)
  # assert (!d.contains :z:)
  #
  # # Key + value check (multi-map aware)
  # assert (d.contains :a: 1)
  # assert (d.contains :a: 3)
  # assert (!d.contains :a: 2)
  # ```
  pub def contains
    self
    # the key to check
    key @ Value
    # optional value to check for (multi-map)
    value @ Value = ...
  do -> Bool
    ...

  # Returns a shallow copy of the dictionary.
  #
  # Insertion order and multiple per-key values are preserved. Keys and
  # values are *not* copied recursively.
  #
  # When inherited by a Do subclass, `copy()` calls the subclass constructor with
  # the source dict as a single positional argument.
  pub def copy self -> BaseDict[S]
    ...

  # Returns a count derived from the dictionary's multi-map structure.
  #
  # With no `key`, it returns the number of distinct keys. With a `key`, it returns
  # the number of values associated with that key.
  #
  # Missing keys return `0`.
  pub def count self key @ Value = ... -> Int
    ...

  # Retrieves the value for a key. Returns `nil` if the key is missing and no
  # alternative is provided. Negative `instance` indexes count from the end.
  #
  # ## Example
  #
  # ```
  # let d = {name: "Alice"}
  # assert_eq (d.get :name:) "Alice"
  # assert_eq ({name: "Alice", name: "Bob"}.get :name: -1) "Bob"
  # assert_eq (d.get :missing: default: "unknown") "unknown"
  # ```
  pub def get[K, D = nil]
    self
    # the key to look up
    key @ K
    # which value to retrieve when a key has multiple values (0-indexed; negative counts from end; default: last)
    instance @ Int = ...
    :default @ D = ...
    :else @ (() -> D) = ...
  do -> (IndexItem[S, K] | D)
    ...

  # Returns an iterator of keys. Each distinct key is yielded exactly once, in the
  # order its first pair was inserted.
  #
  # To visit each value of a repeated key, use
  # [`pairs`](std.BaseDict.pairs) instead.
  pub def keys self -> UnpackIter[Keys[S]]
    ...

  # Returns an iterator yielding `(key, value)` pairs, the same as ordinary
  # iteration, so that a [`Dict`](std.Dict) and an [`Array`](std.Array) can be
  # iterated by key and value alike.
  pub def pairs self -> Iter[Entries[S]]
    ...

  # Returns an iterator of values. With no argument, it yields all stored values in
  # pair insertion order. With a `key`, it yields only the values associated with
  # that key, in that key's insertion order.
  #
  # Missing keys return an empty iterator.
  @def values self -> UnpackIter[Values[S]]
  @def values[K] self key@K -> UnpackIter[IndexItem[S, K]]
  pub def values self key @ Value = ... -> UnpackIter[Values[S]]
    ...

  # Returns the value of a key, the last one if it is repeated.
  #
  # ```
  # let d = {name: "Alice"}
  # assert_eq $d[:name:] "Alice"
  # ```
  #
  # A missing key raises [`IndexError`](std.IndexError).
  #
  # [`Range`](std.Range) values are treated as ordinary keys, not as slices.
  pub def (index)[K] self key@K -> IndexItem[S, K]
    ...

  # Spreads the dictionary's entries.
  pub def (spread) self -> Spread[S]
    ...

  # Iterating over a dictionary yields `(key, value)` pairs:
  #
  # ```
  # for pair = {a: 1, b: 2}
  #   echo $pair
  # ```
  pub def (iter) self -> Iter[Entries[S]]
    ...

  # Destructures the dictionary by key.
  #
  # ```
  # let :name age: years = {name: "Alice", age: 30}
  # ```
  pub def (unpack) self -> BaseDict[S]
    ...


# Dictionaries are **ordered**, mutable key-value mappings. They preserve
# insertion order and are **multi-maps**: a single key can have multiple values.
#
# Keys can be any hashable type.
#
# ## Ordering
#
# Dictionaries preserve insertion order. Iteration yields entries in the order
# they were inserted.
#
# ## Multi-Map Semantics
#
# A dict can store multiple values per key. This is primarily relevant when
# constructing dicts from spreading or using methods with the `instance`
# parameter:
#
# - **Construction** with duplicate keys preserves all values
# - **Plain indexing** (`d[key]`) returns the last value for a key, so a
#   duplicate key overrides the values before it: last wins
# - **Plain assignment** (`d[key] = value`) replaces all values for a key
# - **`insert`** adds a new value without removing existing ones for that key
# - **`get`** and **`pop`** accept an `instance` parameter to access specific
#   values by their position (0-indexed) among values for that key; negative
#   instance indexes count from the end
pub class Dict[S @ {...}]: BaseDict[S] @MutMap[S] @Assign[S]
  # Builds a dictionary by spreading one source, as `{...source}` does.
  #
  # Spreading an array gives positional items, so an array of pairs is not a
  # mapping: `Dict [(:a:, 1)]` is `{(:a:, 1)}`. Adapt pairs with
  # [`Iter.kv`](std.Iter.kv) instead:
  #
  # ```
  # let d = Dict $ pairs.iter().kv()
  # ```
  #
  # The lowercase `dict` factory instead assigns integer keys to positional
  # arguments and symbol keys to key arguments.
  pub def (init) self source @ Spread[S]
    ...

  @def clear self @ Dict[Clearable[S]]

  # Removes all key-value pairs.
  #
  # ```
  # let d = {a: 1, b: 2}
  # d.clear()
  # assert_eq $d.len 0
  # ```
  pub def clear self
    ...

  # Returns a shallow copy of the dictionary, as
  # [`BaseDict.copy`](std.BaseDict.copy) does.
  pub def copy self -> Dict[S]
    ...

  @def delete[K] self @ Dict[Deletable[S, K]] key @ K -> Bool

  # Indicates whether any values were removed. Removes all values for the key.
  #
  # ## Example
  #
  # ```
  # let d = {a: 1, b: 2}
  # assert (d.delete :a:)
  # assert (!(d.delete :missing:))
  # assert_eq $d.len 1
  # ```
  pub def delete
    self
    # the key to remove
    key @ Value
  do -> Bool
    ...

  # Adds a key-value pair. Does **not** remove existing values for the same key
  # (multi-map insert).
  pub def insert[K]
    self
    # the key
    key @ K
    # the value
    value @ InsertItem[S, K]
  do
    ...

  @def pop[K, D = Never]
    self @ Dict[Deletable[S, K]]
    key @ K
    instance @ Int = ...
    :default @ D = ...
    :else @ (() -> D) = ...
  do -> (IndexItem[S, K] | D)

  # Removes and returns a value for a key.
  #
  # `instance` selects one of a repeated key's values by position; negative
  # positions count from the end.
  #
  # ## Errors
  #
  # Raises [`IndexError`](std.IndexError) if the key is missing and there is no
  # `default` or `else`.
  #
  # ## Example
  #
  # ```
  # let d @ Dict[Str, Str] = {}
  # d.insert "multi" "first"
  # d.insert "multi" "second"
  #
  # # Pop first instance (default)
  # assert_eq (d.pop "multi") "first"
  #
  # # Pop specific instance
  # assert_eq (d.pop "multi" 0) "second"
  # ```
  pub def pop[K, D = Never]
    self
    # the key to remove
    key @ K
    # which value to remove when a key has multiple values (0-indexed; negative counts from end; default: first)
    instance @ Int = ...
    :default @ D = ...
    :else @ (() -> D) = ...
  do -> (IndexItem[S, K] | D)
    ...

  # Replaces every value of `key`.
  #
  # ```
  # let d = {name: "Alice"}
  # d[:age:] = 30
  # ```
  pub def (assign)[K] self key@K value@AssignItem[S, K]
    ...


# Raised when accessing a nonexistent field on an object.
#[mixable]
pub class FieldError: RuntimeError
  # Builds an error naming a field that does not exist.
  pub def (init)
    self
    # the field that does not exist
    name @ Sym
  do
    ...


# Abstract supertype for numeric values.
pub class Num
  # Returns the magnitude of the value.
  #
  # Raises [`OverflowError`](std.OverflowError) if the result is not
  # representable.
  pub def abs[N @ Num] self @ N -> N
    ...

  # Returns the signum of the value: negative one, zero, or positive one.
  pub def signum[N @ Num] self @ N -> N
    ...

  # Rounds to the nearest integral value, with halfway cases away from zero.
  pub def round[N @ Num] self @ N -> N
    ...

  # Rounds toward negative infinity.
  pub def floor[N @ Num] self @ N -> N
    ...

  # Rounds toward positive infinity.
  pub def ceil[N @ Num] self @ N -> N
    ...

  # Rounds toward zero.
  pub def trunc[N @ Num] self @ N -> N
    ...

  # Returns the smallest of this value and `others`.
  #
  # If a comparison is unordered, which input is returned is unspecified.
  pub def min[N @ Num] self@N *others@N -> N
    ...

  # Returns the largest of this value and `others`.
  #
  # If a comparison is unordered, which input is returned is unspecified.
  pub def max[N @ Num] self@N *others@N -> N
    ...

  # Restricts the value to the inclusive interval from `lower` to `upper`.
  #
  # Raises [`ValueError`](std.ValueError) if `lower > upper`. If a comparison
  # is unordered, which input is returned is unspecified.
  pub def clamp[N @ Num] self@N lower@N upper@N -> N
    ...

  pub def (add) self other @ Num -> Num
    ...

  pub def (radd) self other @ Num -> Num
    ...

  pub def (sub) self other @ Num -> Num
    ...

  pub def (mul) self other @ Num -> Num
    ...

  pub def (rmul) self other @ Num -> Num
    ...

  pub def (div) self other @ Num -> Float
    ...

  pub def (ediv) self other @ Num -> Int
    ...

  pub def (mod) self other @ Num -> Num
    ...

  pub def (neg)[N @ Num] self @ N -> N
    ...

  pub def (lt) self other @ Num -> Bool
    ...


# 64-bit floating point numbers.
#
# Rounding preserves signed zero and rounds halfway cases away from zero.
# `signum` returns NaN for NaN and distinguishes positive and negative zero.
pub class Float: Num
  # Difference between `1.0` and the next greater representable value.
  #[static]
  pub field EPSILON @ Float = ...

  # Positive infinity.
  #[static]
  pub field INF @ Float = ...

  # A not-a-number value.
  #[static]
  pub field NAN @ Float = ...

  # Converts a number to a float.
  #
  # `Float` accepts a float or an integer that can be represented exactly.
  #
  # ```
  # assert_eq (Float 42) 42.0
  # ```
  #
  # The lowercase `float` function performs numeric coercion and parsing:
  #
  # ```
  # assert_eq (float "3.14") 3.14
  # assert_eq (float true) 1.0
  # ```
  pub def (init) self
    ...

  pub def (add) self other @ Num -> Float
    ...

  pub def (radd) self other @ Num -> Float
    ...

  pub def (sub) self other @ Num -> Float
    ...

  pub def (mul) self other @ Num -> Float
    ...

  pub def (rmul) self other @ Num -> Float
    ...

  pub def (mod) self other @ Num -> Float
    ...

  # Tests whether the value is NaN.
  pub def is_nan self -> Bool
    ...

  # Tests whether the value is finite.
  pub def is_finite self -> Bool
    ...

  # Tests whether the value is positive or negative infinity.
  pub def is_infinite self -> Bool
    ...

  # Tests whether the value is normal.
  pub def is_normal self -> Bool
    ...

  # Tests whether the value is subnormal.
  pub def is_subnormal self -> Bool
    ...

# A fill for formatted output: a single character, or `:ZERO:` for numeric
# zero padding.
pub @let FmtFill = (Str | :ZERO:)

# An alignment for formatted output.
pub @let FmtAlign = (:LEFT: | :RIGHT: | :CENTER:)

# A sign display for formatted numbers.
pub @let FmtSign = (:PLUS: | :SPACE:)

# A representation kind for formatted output. See
# [`FmtSpec.kind`](std.FmtSpec.kind).
pub @let FmtKind = $
  | :STR:
  | :DBG:
  | :VERBATIM:
  | :HEX:
  | :OCT:
  | :BIN:
  | :DEC:
  | :EXP:
  | :FIXED:

# `Func` is the abstract supertype of function values.
#
# In a type, `Func` is any function. A class that declares `(call)` names
# `Func` among its supertypes to be passed as a function, with its `(call)`'s
# signature.
#[mixable]
pub class Func

# An unbound interpolation in a [`Fmt`](std.Fmt).
#
# A [`FmtValue`](std.FmtValue) already carries a value. A `FmtParam` carries
# only a name and a specification. What the hole means is up to the consumer of
# the sequence — a SQL statement binds it as a placeholder, for example.
# [`Fmt.format`](std.Fmt.format) fills holes from its arguments.
#
# `FmtParam` exposes the same formatting fields and `pad` method as
# [`FmtSpec`](std.FmtSpec). Calling it with new keyword options returns a new
# `FmtParam` naming the same parameter.
pub class FmtParam: Func
  # Creates a parameter named by a position or a symbol.
  #
  # ## Errors
  #
  # | Exception                      | Condition                              |
  # | ------------------------------ | -------------------------------------- |
  # | [`TypeError`](std.TypeError) | `name` is neither an `Int` nor a `Sym` |
  #
  # ## Example
  #
  # ```
  # let hole = FmtParam :user: width: 8
  # assert_eq $hole.name :user:
  # assert_eq $hole.width 8
  # ```
  pub def (init)
    self
    name @ (Int | Sym)
    :fill @ FmtFill = ...
    :align @ FmtAlign = ...
    :sign @ FmtSign = ...
    :width @ Int = ...
    :precision @ Int = ...
    :alt @ Bool = ...
    :kind @ FmtKind = ...
    # Interpolation as written in source
    :source @ Str = ...
  do
    ...

  # The parameter named by this position, as an `Int` or a `Sym`.
  #[getter]
  pub def name self -> (Int | Sym)
    ...

  # The text the parameter was written as, or nil. A `${#...}` in a
  # [`t"..."`](../../language/strings.md#formatted-sequences) records the
  # whole interpolation, sigil and delimiters included.
  #
  # ```
  # let seq = t"a=${#0:>3}"
  # assert_eq $seq[1].source r"${#0:>3}"
  # ```
  #[getter]
  pub def source self -> (Str | nil)
    ...

  # Returns a new `FmtParam` naming the same parameter with the supplied options
  # merged. Positional arguments are not accepted. The result wasn't written in
  # source, so its [`source`](std.FmtParam.source) is nil.
  pub def (call)
    self
    # Padding fill
    :fill @ (FmtFill | nil) = ...
    # Alignment
    :align @ (FmtAlign | nil) = ...
    # Sign display
    :sign @ (FmtSign | nil) = ...
    # Minimum width in grapheme clusters
    :width @ (Int | nil) = ...
    # Numeric precision or maximum graphemes
    :precision @ (Int | nil) = ...
    # Enables alternate formatting
    :alt @ (Bool | nil) = ...
    # Representation kind
    :kind @ (FmtKind | nil) = ...
  do -> FmtParam
    ...

  # Two parameters are equal when they name the same parameter under the same
  # specification and record the same [`source`](std.FmtParam.source).
  pub def (eq) self other @ Value -> Bool
    ...


# Stores reusable formatting options.
#
# `FmtSpec` values are immutable. Calling one returns a new specification with
# the supplied options overridden, or a bound [`FmtValue`](std.FmtValue) when
# given a positional value.
pub class FmtSpec: Func
  # Creates a specification from formatting options.
  #
  # ## Example
  #
  # ```
  # let money = FmtSpec precision: 2 kind: :FIXED:
  # assert_eq "$(money 1.5)/$(money 2.25)" "1.50/2.25"
  # ```
  pub def (init)
    self
    # Padding fill
    :fill @ FmtFill = ...
    # Alignment
    :align @ FmtAlign = ...
    # Sign display
    :sign @ FmtSign = ...
    # Minimum width in grapheme clusters
    :width @ Int = ...
    # Numeric precision or maximum graphemes
    :precision @ Int = ...
    # Enables alternate formatting
    :alt @ Bool = ...
    # Representation kind
    :kind @ FmtKind = ...
  do
    ...

  # The fill character, `:ZERO:` for numeric zero padding, or nil for spaces.
  #[getter]
  pub def fill self -> (FmtFill | nil)
    ...

  # `:LEFT:`, `:RIGHT:`, `:CENTER:`, or nil for the formatted value's default.
  #[getter]
  pub def align self -> (FmtAlign | nil)
    ...

  # `:PLUS:`, `:SPACE:`, or nil to show only negative signs.
  #[getter]
  pub def sign self -> (FmtSign | nil)
    ...

  # The minimum width in extended grapheme clusters, or nil when unset. A value
  # may measure itself differently: [`term.Text`](term.Text) measures
  # terminal cells.
  #[getter]
  pub def width self -> (Int | nil)
    ...

  # The numeric precision or maximum number of extended grapheme clusters,
  # depending on the formatted value, or nil when unset.
  #[getter]
  pub def precision self -> (Int | nil)
    ...

  # Whether alternate formatting is enabled.
  #[getter]
  pub def alt self -> Bool
    ...

  # The requested representation, or nil to inherit the surrounding conversion.
  #
  # | Kind         | Representation     | Conversion |
  # | ------------ | ------------------ | ---------- |
  # | `:STR:`      | string             | `s`        |
  # | `:DBG:`      | debug              | `?`        |
  # | `:VERBATIM:` | verbatim           | `!`        |
  # | `:HEX:`      | integer (hex)      | `x`        |
  # | `:OCT:`      | integer (octal)    | `o`        |
  # | `:BIN:`      | integer (binary)   | `b`        |
  # | `:DEC:`      | integer (decimal)  | `d`        |
  # | `:EXP:`      | float (scientific) | `e`        |
  # | `:FIXED:`    | float (fixed)      | `f`        |
  #
  # The Conversion column gives the equivalent character in a [formatted
  # interpolation](../../language/strings.md#formatted-interpolation).
  #[getter]
  pub def kind self -> (FmtKind | nil)
    ...

  # Returns a new specification, or a bound [`FmtValue`](std.FmtValue) when
  # `value` is provided. Omitted options retain their current values; nil resets
  # an option.
  #
  # Binding a [`FmtValue`](std.FmtValue) nests it: the inner specification
  # renders the value and this one lays that rendering out. See
  # [Sequencing](std.FmtValue.sequencing).
  @def (call)
    self
    # Padding fill
    :fill @ (FmtFill | nil) = ...
    # Alignment
    :align @ (FmtAlign | nil) = ...
    # Sign display
    :sign @ (FmtSign | nil) = ...
    # Minimum width in grapheme clusters
    :width @ (Int | nil) = ...
    # Numeric precision or maximum graphemes
    :precision @ (Int | nil) = ...
    # Enables alternate formatting
    :alt @ (Bool | nil) = ...
    # Representation kind
    :kind @ (FmtKind | nil) = ...
  do -> FmtSpec

  @def (call)[T]
    self
    # value to bind
    value @ T
    # Padding fill
    :fill @ (FmtFill | nil) = ...
    # Alignment
    :align @ (FmtAlign | nil) = ...
    # Sign display
    :sign @ (FmtSign | nil) = ...
    # Minimum width in grapheme clusters
    :width @ (Int | nil) = ...
    # Numeric precision or maximum graphemes
    :precision @ (Int | nil) = ...
    # Enables alternate formatting
    :alt @ (Bool | nil) = ...
    # Representation kind
    :kind @ (FmtKind | nil) = ...
  do -> FmtValue[T]

  pub def (call) self ...args @ Value -> FmtValue[Value]
    ...

  # Applies fill, alignment, width, and truncation to a string.
  #
  # ## Example
  #
  # ```
  # let column = FmtSpec fill: . align: :CENTER: width: 8
  # echo $column.pad("name")
  # ```
  pub def pad
    self
    # String to lay out
    value @ Str
  do -> Str
    ...


# Binds a value to reusable formatting options.
#
# A [formatted
# interpolation](../../language/strings.md#formatted-interpolation) produces
# one for each `${...}` it contains; the constructor is for binding a value
# where no interpolation is being written.
#
# `FmtValue` exposes the same formatting fields and `pad` method as
# [`FmtSpec`](std.FmtSpec), but is a distinct type rather than a subtype of
# it. Calling it with new keyword options returns a new `FmtValue` retaining
# the original value.
#
# ## Sequencing {: #std.FmtValue.sequencing }
#
# Binding a `FmtValue` sequences the two specifications rather than merging
# them: the inner one renders the value, and the outer one lays that rendering
# out as text. So a width under a width pads what the inner layout produced,
# and a precision clips it.
#
# An outer option the inner rendering cannot honor — a numeric `kind`, say — is
# a `TypeError`, because a rendering is text. Each level is honored or rejected;
# none is skipped.
#
# Nesting is bounded by the ordinary call depth.
#
# ```
# let money = FmtSpec precision: 2 kind: :FIXED:
# let bound = money 1.5
# assert_eq "${bound:8}" "1.50    "
#
# # `value` descends exactly one level.
# let outer = (FmtValue bound width: 8)
# assert_eq (str outer.value) "1.50"
# ```
#
# ## Example
#
# ```
# let amount = 12.5
# let money = FmtSpec precision: 2 kind: :FIXED:
# echo "total: $(money $amount)"
#
# # A bound value carries its options into an interpolation that adds more.
# assert_eq "${money(amount):>10}" "     12.50"
# ```
#
# When `kind` is nil, interpolation in an ordinary quoted string or here string
# uses display formatting. `str` and `dbg` supply display and debug formatting,
# respectively. An explicit `kind` overrides the surrounding operation.
pub class FmtValue[T]: Func
  # Binds a value to formatting options.
  #
  # ## Example
  #
  # ```
  # let money = FmtValue 1.5 precision: 2 kind: :FIXED:
  # assert_eq (str money) "1.50"
  # ```
  pub def (init)
    self
    # Value to bind
    value @ T
    # Padding fill
    :fill @ FmtFill = ...
    # Alignment
    :align @ FmtAlign = ...
    # Sign display
    :sign @ FmtSign = ...
    # Minimum width in grapheme clusters
    :width @ Int = ...
    # Numeric precision or maximum graphemes
    :precision @ Int = ...
    # Enables alternate formatting
    :alt @ Bool = ...
    # Representation kind
    :kind @ FmtKind = ...
    # Interpolation as written in source
    :source @ Str = ...
  do
    ...

  # The bound value, one level down. It is itself a `FmtValue` when this one
  # binds another.
  #[getter]
  pub def value self -> T
    ...

  # As [`FmtSpec.fill`](std.FmtSpec.fill).
  #[getter]
  pub def fill self -> (FmtFill | nil)
    ...

  # As [`FmtSpec.align`](std.FmtSpec.align).
  #[getter]
  pub def align self -> (FmtAlign | nil)
    ...

  # As [`FmtSpec.sign`](std.FmtSpec.sign).
  #[getter]
  pub def sign self -> (FmtSign | nil)
    ...

  # As [`FmtSpec.width`](std.FmtSpec.width).
  #[getter]
  pub def width self -> (Int | nil)
    ...

  # As [`FmtSpec.precision`](std.FmtSpec.precision).
  #[getter]
  pub def precision self -> (Int | nil)
    ...

  # As [`FmtSpec.alt`](std.FmtSpec.alt).
  #[getter]
  pub def alt self -> Bool
    ...

  # As [`FmtSpec.kind`](std.FmtSpec.kind).
  #[getter]
  pub def kind self -> (FmtKind | nil)
    ...

  # The text the value was written as, or nil. Formatted interpolation records
  # the whole interpolation including its sigil and delimiters, so a consumer can
  # reproduce the form it was written in.
  #
  # ```
  # let sourced = FmtValue 42 width: 4 source: r"${x:>4}"
  # assert_eq $sourced.source r"${x:>4}"
  # ```
  #[getter]
  pub def source self -> (Str | nil)
    ...

  # Returns a new `FmtValue` with the supplied options merged. Positional
  # arguments are not accepted. The result wasn't written in source, so its
  # [`source`](std.FmtValue.source) is nil.
  pub def (call)
    self
    # Padding fill
    :fill @ (FmtFill | nil) = ...
    # Alignment
    :align @ (FmtAlign | nil) = ...
    # Sign display
    :sign @ (FmtSign | nil) = ...
    # Minimum width in grapheme clusters
    :width @ (Int | nil) = ...
    # Numeric precision or maximum graphemes
    :precision @ (Int | nil) = ...
    # Enables alternate formatting
    :alt @ (Bool | nil) = ...
    # Representation kind
    :kind @ (FmtKind | nil) = ...
  do -> FmtValue[T]
    ...

  # Two bindings are equal when they bind equal values to the same specification
  # and record the same [`source`](std.FmtValue.source).
  pub def (eq) self other @ Value -> Bool
    ...


# A segment of a [`Fmt`](std.Fmt): literal text, a bound interpolation, or an
# unbound parameter.
pub @let FmtSegment[V] = (Str | FmtValue[V] | FmtParam)

# Preserves literal text, bound interpolations, and unbound parameters from a
# [`t"..."` string](../../language/strings.md#formatted-sequences).
#
# `V` is the union of the interpolated values' types, and `S` is the schema of
# the arguments that [`format`](std.Fmt.format) needs to fill the sequence's
# parameters, by position or by name. Since a sequence is immutable, one whose
# values have narrower types can stand in for one whose values are wider.
#
# Every segment is a [`Str`](std.Str) of literal text, a
# [`FmtValue`](std.FmtValue) interpolation, or a [`FmtParam`](std.FmtParam)
# still waiting to be filled. This type behaves like an immutable array:
# indexable, iterable, spreadable, and destructurable.
#
# ## Trust {: #std.Fmt.trust }
#
# A sequence written as `t"..."` carries a guarantee: its `Str` segments are
# program text, and everything interpolated into it is a `FmtValue` or
# `FmtParam`. That is what lets a consumer treat the literal segments as the
# trusted skeleton of a command and each interpolation as data to be bound or
# quoted. [`sqlite`](sqlite) is a prime example, as it relies on
# this guarantee to exclude SQL injection vulnerabilities.
#
# Toward that end, **no conversion implicitly expands a sequence**, so it can't
# be expanded by accident before it reaches its consumer. `str` and plain
# interpolation (`"$seq"`, `"${seq}"`, `"${seq:s}"`) raise a
# [`TypeError`](std.TypeError). `dbg` and `verbatim`, and so the `!` conversion
# and command arguments, give the source form, reconstructed from the literal
# text and each interpolation's [`source`](std.FmtValue.source). An interpolation built at runtime has no
# source, so its bound value's debug form stands in.
# [`format()`](std.Fmt.format) is the only expansion.
#
# ```
# let count = 3
# assert_eq (dbg t"n=${count:03d}") r#"t"n=${count:03d}""#
# assert_eq (verbatim t"n=${count:03d}") (dbg t"n=${count:03d}")
# ```
#
# **Building a sequence yourself must uphold this guarantee.** The
# [constructor](std.Fmt.(init)) accepts whatever segments it is given, so a
# `Str` built from untrusted input would subsequently be treated as trusted.
# Programmatic construction of `Fmt` must be done with care.
#
# ```
# # Fine: the query text is literal, the value is bound.
# let query = t"select * from users where name = $name"
#
# # Fine: assembled at runtime, but the untrusted value is still bound.
# let assembled = Fmt ["select * from users where name = ", (FmtValue name)]
#
# # Danger: untrusted input is treated as a trusted string literal
# let injected = Fmt ["select * from users where name = ", name]
# ```
#
# ## Example
#
# ```playground
# #> import test:
# #>   - assert_eq
# let user = "root"
# let seq = t"user: ${user:>8}"
#
# # Expanding gives what the equivalent `"..."` would have.
# assert_eq $seq.format() "user:     root"
#
# # The interpolated value is still there to be inspected.
# let std.FmtValue(segment) = seq[1]
# assert_eq $segment.value $user
# assert_eq $segment.width 8
# ```
pub class Fmt[V, S @ {*, *(Int | Sym): Value}]: @Index[FmtSegment[V]] @Spread[FmtSegment[V]] @Unpack[FmtSegment[V], Rest: SeqRest[FmtSegment[V]]]
  field schema @ Phantom[((...S) -> nil)]

  # Builds a sequence from an iterable of segments.
  #
  # Writing a `t"..."` is the usual way to get one; the constructor is for
  # assembling a sequence at runtime. The type checker doesn't know which
  # parameters the result has.
  #
  # ## Errors
  #
  # | Exception                      | Condition                                           |
  # | ------------------------------ | --------------------------------------------------- |
  # | [`TypeError`](std.TypeError) | A segment is not a `Str`, `FmtValue`, or `FmtParam` |
  #
  # ## Example
  #
  # ```
  # let built = Fmt ["a=", (FmtValue 42), ";"]
  # assert_eq $built.len 3
  # assert_eq $built.format() "a=42;"
  # ```
  pub def (init) self segments @ Iterable[FmtSegment[V]]
    ...

  # The number of segments.
  #
  # ```
  # let greeting = t"hello $name!"
  # assert_eq $greeting.len 3
  # ```
  #[getter]
  pub def len self -> Int
    ...

  @def format[B @ {*Value, **Value}] self @ Fmt[V, B] ...bindings @ B -> Str

  # Expands the sequence and returns the result: literal text as it stands, and
  # each interpolation through its own specification. This is the only way to get
  # the expansion — see [Trust](std.Fmt.trust).
  #
  # Given arguments, it fills the [parameters](std.FmtParam) first. Positional
  # argument *i* fills `${#i}`, and a keyword argument fills `${#name}`:
  #
  # - Holes inside a bound `Fmt` are filled too, depth first, by the same
  #   arguments: a nested `${#0}` is filled by argument `0` as well. The type
  #   checker sees only the outer holes, so it may report an argument for a
  #   nested hole as unused.
  # - A filled hole keeps the parameter's specification and
  #   [`source`](std.FmtParam.source).
  # - A hole left unfilled, or an argument no hole consumed, is an error.
  #
  # ## Errors
  #
  # | Exception                                         | Condition                     |
  # | ------------------------------------------------- | ----------------------------- |
  # | [`MissingPosError`](std.MissingPosError)       | A numbered parameter unfilled |
  # | [`MissingKeyError`](std.MissingKeyError)       | A named parameter unfilled    |
  # | [`UnexpectedPosError`](std.UnexpectedPosError) | A positional argument unused  |
  # | [`UnexpectedKeyError`](std.UnexpectedKeyError) | A keyword argument unused     |
  #
  # ## Example
  #
  # ```
  # let count = 3
  # assert_eq $(t"n=${count:03d}").format() "n=003"
  #
  # let stmt = t"select * from t where a = ${#0} and c = ${#name}"
  # assert_eq $stmt.format(1, name: "n") "select * from t where a = 1 and c = n"
  # ```
  pub def format self ...bindings @ Value -> Str
    ...

  # Returns a segment: a [`Str`](std.Str) of literal text, a
  # [`FmtValue`](std.FmtValue), or a [`FmtParam`](std.FmtParam).
  #
  # ```
  # let greeting = t"hello $name!"
  # assert_eq $greeting[0] "hello "
  # assert_eq $greeting[1].source r"$name"
  # ```
  #
  # Assigning to a segment raises an [`ImmutableError`](std.ImmutableError).
  @def (index)[K] self key@K -> IndexItem[{*FmtSegment[V]}, K]
  @def (index) self range@Range[Int] -> Seq[FmtSegment[V]]
  pub def (index)[K] self key@K -> IndexItem[{*FmtSegment[V]}, K]
    ...

  # Returns an iterator over the segments in order, so a consumer can decide
  # what to do with each.
  #
  # ```
  # for segment = greeting
  #   echo $ type $segment
  # ```
  #
  # The console is the worked example of such a consumer:
  # [`term`](term.Text.sequences) walks a sequence segment by segment rather
  # than converting it, which is what lets styling interpolated into one survive
  # to the terminal.
  pub def (iter) self -> UnpackIter[FmtSegment[V]]
    ...

  # Two sequences are equal when their segments are. How a sequence was assembled
  # does not show. The text each interpolation records does: a segment carries its
  # [`source`](std.FmtValue.source), so `t"$name"` and `t"${name}"` are not
  # equal.
  pub def (eq) self other @ Value -> Bool
    ...

  # Formats the sequence's source form for `dbg` and `verbatim`. Display
  # formatting raises [`TypeError`](std.TypeError); see
  # [Trust](std.Fmt.trust).
  pub def (fmt) self spec @ FmtSpec -> Str
    ...

  # Spreads the segments.
  pub def (spread) self -> Spread[FmtSegment[V]]
    ...

  # Destructures the segments positionally.
  pub def (unpack) self -> Unpack[FmtSegment[V], Rest: SeqRest[FmtSegment[V]]]
    ...

# A module object, produced by `import` or by loading a compiled module. Its
# fields are the module's exported bindings.
pub class Module: @Spread[Tuple[Sym, Value]]
  # Spreads exported name/value pairs positionally.
  pub def (spread) self -> Spread[Tuple[Sym, Value]]
    ...

# What [`getter`](std.getter) makes from a function of the object read.
#
# A class member holding one is a computed field: reading `obj.name` calls the
# function with `obj`. A decorator that wraps a getter's function returns this
# type by calling `getter` itself.
pub @class Getter[T, R]
  field func @Phantom[(T -> R)]


# Raised when attempting to mutate an immutable value.
#[mixable]
pub class ImmutableError: RuntimeError
  # Builds an error reporting an attempt to mutate an immutable object.
  pub def (init) self
    ...


# Raised when a module import fails (e.g. module not found).
#[mixable]
pub class ImportError: RuntimeError
  # Builds an error naming a module that could not be found.
  pub def (init)
    self
    # the module that could not be found
    name @ Str
  do
    ...


# Raised when accessing an array or other indexed collection with an out-of-bounds
# index.
#[mixable]
pub class IndexError: RuntimeError
  # Builds an error reporting an out-of-range or otherwise invalid index.
  pub def (init) self
    ...


# 128-bit signed integers.
#
# The rounding methods return the receiver unchanged.
pub class Int: Num
  # Smallest representable integer.
  #[static]
  pub field MIN @ Int = ...

  # Largest representable integer.
  #[static]
  pub field MAX @ Int = ...

  # Converts a value to an integer.
  #
  # `Int` accepts an integer, a boolean, or an integral float. It rejects
  # fractional floats and interpretive conversions such as parsing strings.
  #
  # ```
  # assert_eq (Int true) 1
  # assert_eq (Int 3.0) 3
  # ```
  #
  # The lowercase `int` function performs coercion and parsing:
  #
  # ```
  # assert_eq (int "42") 42
  # assert_eq (int 3.14) 3
  # ```
  pub def (init) self
    ...

  @def (add) self other@Int -> Int
  @def (add) self other@Float -> Float
  pub def (add) self other @ Num -> Num
    ...

  @def (sub) self other@Int -> Int
  @def (sub) self other@Float -> Float
  pub def (sub) self other @ Num -> Num
    ...

  @def (mul) self other@Int -> Int
  @def (mul) self other@Float -> Float
  pub def (mul) self other @ Num -> Num
    ...

  @def (mod) self other@Int -> Int
  @def (mod) self other@Float -> Float
  pub def (mod) self other @ Num -> Num
    ...

  # Computes bitwise AND.
  pub def (band) self other @ (Int | Bool) -> Int
    ...

  pub def (rband) self other @ (Int | Bool) -> Int
    ...

  # Computes bitwise OR.
  pub def (bor) self other @ (Int | Bool) -> Int
    ...

  pub def (rbor) self other @ (Int | Bool) -> Int
    ...

  # Computes bitwise XOR.
  pub def (bxor) self other @ (Int | Bool) -> Int
    ...

  pub def (rbxor) self other @ (Int | Bool) -> Int
    ...

  # Computes bitwise NOT.
  pub def (bnot) self -> Int
    ...

  # Shifts left.
  pub def (shl) self other @ Int -> Int
    ...

  pub def (rshl) self other @ Int -> Int
    ...

  # Shifts right arithmetically, sign-extending negative values.
  pub def (shr) self other @ Int -> Int
    ...

  pub def (rshr) self other @ Int -> Int
    ...

# Error raised to signal that an iterator is exhausted. This is used
# internally by the iteration protocol and can be caught in `try`/`catch`
# statements.
pub class IterStop: Error
  # Builds the signal that an iterator is exhausted.
  pub def (init) self
    ...


# Abstract type for iterators, whose instances have the methods below. Built-in
# iterators are `Iter`; a class that only implements [`(next)`](std.BaseIter)
# is not.
#
# `Iter` is not constructible directly. See
# [Classes](../../language/classes.md) for defining custom iterators.
#
# ```
# assert_eq (type $ [1, 2, 3].iter()) $Iter
# ```
#[mixable]
pub class Iter[T]: Iterable[T] @BaseIter[T] @Spread[T]
  # Consumes the iterator and tests whether every value is truthy, or satisfies
  # `pred`, as [`Iterable.all`](std.Iterable.all) does.
  pub def all self pred @ ((T) -> Value) = ... -> Bool
    ...

  # Consumes the iterator and tests whether any value is truthy, or satisfies
  # `pred`, as [`Iterable.any`](std.Iterable.any) does.
  pub def any self pred @ ((T) -> Value) = ... -> Bool
    ...

  # Returns an iterator that yields this iterator's values followed by those of
  # each additional iterable.
  pub def chain[*Us] self *values @ ...Iterable[Us] -> Iter[Union[T, ...Us]]
    ...

  @def chomp self @ Iter[Str] -> Iter[Str]
  @def chomp self @ Iter[Bin] -> Iter[Bin]

  # Returns an iterator with one trailing line terminator removed from each
  # value, as [`Iterable.chomp`](std.Iterable.chomp) does.
  pub def chomp self -> Iter[Str | Bin]
    ...

  # Consumes the iterator and returns the number of values it yielded.
  pub def count self -> Int
    ...

  @def crimp self@Iter[Str] terminator@(Str | Bin) = ... -> Iter[Str]
  @def crimp self@Iter[Bin] terminator@(Str | Bin) = ... -> Iter[Bin]

  # Returns an iterator with a line terminator appended to each value, as
  # [`Iterable.crimp`](std.Iterable.crimp) does.
  pub def crimp self terminator@(Str | Bin) = ... -> Iter[Str | Bin]
    ...

  # Returns an iterator of `(index, value)` tuples, counting from `0`.
  pub def enumerate self -> Iter[Tuple[Int, T]]
    ...

  # Returns an iterator of the values for which `pred` is truthy.
  pub def filter self pred @ ((T, <Value, >Value) -> Value) -> Iter[T]
    ...

  # Consumes values up to and including the first for which `pred` is truthy,
  # and returns it, as [`Iterable.find`](std.Iterable.find) does.
  pub def find[D = T]
    self
    pred @ ((T) -> Value)
    :default @ D = ...
    :else @ (() -> D) = ...
  do -> (T | D)
    ...

  # Consumes the iterator, accumulating a value as
  # [`Iterable.fold`](std.Iterable.fold) does.
  pub def fold[A] self init@A func@((A, T) -> A) -> A
    ...

  @def kv[K, V] self @ Iter[Unpack[{K, V}]] -> Spread[K, V]

  # Adapts the remaining elements for keyed spreading.
  #
  # Each element must unpack into exactly two values without being consumed.
  # Spreading consumes the source. The adapter does not support iteration.
  #
  # ```
  # let entries = [("x", 1), ("y", 2)].iter()
  # assert_eq {...entries.kv()} {"x": 1, "y": 2}
  # ```
  pub def kv self -> Spread[{...}]
    ...

  # Returns an iterator that maps each value through `func`.
  pub def map[U] self func @ ((T, <Value, >Value) -> U) -> Iter[U]
    ...

  # Consumes the iterator and returns the largest value, as
  # [`Iterable.max`](std.Iterable.max) does.
  pub def max[D = T] self :default @ D = ... -> (T | D)
    ...

  # Consumes the iterator and returns the smallest value, as
  # [`Iterable.min`](std.Iterable.min) does.
  pub def min[D = T] self :default @ D = ... -> (T | D)
    ...

  # Returns the next value from the iterator.
  #
  # ## Errors
  #
  # Raises [`IterStop`](std.IterStop) when exhausted and there is no `default`
  # or `else`.
  pub def next[D = T]
    self
    :default @ D = ...
    :else @ (() -> D) = ...
  do -> (T | D)
    ...

  # Returns an iterator that discards the first `n` values, then yields the
  # rest, as [`Iterable.skip`](std.Iterable.skip) does.
  pub def skip self n @ Int -> Iter[T]
    ...

  # Returns an iterator that yields at most `n` values, as
  # [`Iterable.take`](std.Iterable.take) does.
  pub def take self n @ Int -> Iter[T]
    ...

  # Returns an iterator of tuples across this iterator and the additional
  # iterables, which stops at the end of the shortest.
  pub def zip[*Us] self *values @ ...Iterable[Us] -> Iter[Tuple[T, ...Us]]
    ...

  # Returns the next value, raising [`IterStop`](std.IterStop) once exhausted.
  pub def (next) self -> T
    ...

  # Spreads the remaining items positionally.
  pub def (spread) self -> Spread[T]
    ...

  # Returns this iterator.
  pub def iter self -> Iter[T]
    ...

  # Returns this iterator.
  pub def (iter) self -> Iter[T]
    ...


# An iterable whose iterator supports read-only unpacking.
pub @class UnpackIterable[T]: Iterable[T]
  # Returns an iterator with read-only unpacking.
  pub def iter self -> UnpackIter[T]

  # Returns an iterator with read-only unpacking.
  pub def (iter) self -> UnpackIter[T]


# An iterator whose remaining elements can be unpacked without advancing it.
# Spreading and `next` still consume it. Captured rests are separate iterators
# over what is left.
pub @class UnpackIter[T]: Iter[T] Unpack[T, Rest: UnpackIter[T]]
  # Returns this iterator.
  pub def iter self -> UnpackIter[T]

  # Returns this iterator.
  pub def (iter) self -> UnpackIter[T]


# The rest of a sequence that can be iterated again, such as an array's.
# Iterating, spreading or unpacking it does not consume it, though changes to
# the source may show through.
pub @class SeqRest[T]: Iterable[T] Unpack[T, Rest: SeqRest[T]]


# The rest of a keyed container, such as a dictionary's. Iterating a `*name`
# rest yields its values; iterating any other rest yields its entries, the way
# the source does. Iterating, spreading or unpacking it does not consume it,
# though changes to the source may show through or raise.
pub @class MapRest[S @ {...}]:
  Iterable[Values[S] | Entries[S]] Unpack[S, Rest: MapRest[S]]
do


# Raised when a required key argument is not provided.
#[mixable]
pub class MissingKeyError: RuntimeError
  # Builds an error naming a missing key item.
  pub def (init)
    self
    # the missing key
    key @ Value
  do
    ...


# Raised when a required positional argument is not provided.
#[mixable]
pub class MissingPosError: RuntimeError
  # Builds an error naming a missing positional item.
  pub def (init)
    self
    # zero-based position of the missing item
    index @ Int
  do
    ...


# The type object for the `nil` value.
#
# `Nil` is not constructible directly.
#[final]
pub class Nil

# Acts as an empty iterator and a sink that discards every value.
#
# The [`std.null`](std.null) singleton is the only `Null` value. Use it to
# provide an empty input or discard output:
#
# ```
# run tool stdin: $null stdout: $null
# ```
pub class Null: Iter[Never] @UnpackIter[Never] Sink[Value]
  # Ends the iteration immediately without yielding a value.
  pub def (next) self -> Never
    ...

  # Destructures as no items.
  pub def (unpack) self -> UnpackIter[Never]
    ...

  # Returns this iterator.
  pub def iter self -> UnpackIter[Never]
    ...

  # Returns this iterator.
  pub def (iter) self -> UnpackIter[Never]
    ...

  # Discards the value.
  pub def (put) self value @ Value
    ...


# Raised on integer overflow.
#[mixable]
pub class OverflowError: RuntimeError
  # Builds an error reporting numeric overflow.
  pub def (init) self
    ...


# Describes a numeric interval for iteration and slicing.
pub class Range[T @ Num]: Iterable[T] @Spread[T]
  # Creates a range from `start` to `end`, counting by `step`.
  #
  # ```
  # let bounded = (1..5)
  # let from_start = (..5)
  # let to_end = (1..)
  # let all = (..)
  # ```
  #
  # `a..b` is half-open: it includes `a` and excludes `b`. An omitted endpoint
  # is `nil`.
  #
  # Iteration counts from `start`, or 0 when it is `nil`, toward `end` by
  # `step`, which defaults to `1`. A range whose end lies on the wrong side of
  # its start for the step is empty: `5..1` has no values, while
  # `Range 5 1 -1` yields 5, 4, 3, 2. A range with no `end` iterates forever.
  # Iterating with a zero step raises [`ValueError`](std.ValueError).
  pub def (init) self start@(T|nil) = ... end@(T|nil) = ... step@(T|nil) = ...
    ...

  # The ending value (exclusive), or `nil` for open-end ranges.
  #[getter]
  pub def end self -> (T | nil)
    ...

  # The starting value, or `nil` for open-start ranges.
  #[getter]
  pub def start self -> (T | nil)
    ...

  # The step size, or `nil` when unset.
  #[getter]
  pub def step self -> (T | nil)
    ...

  # Tests whether the given value lies in the range: from `start` (inclusive)
  # toward `end` (exclusive) in the step's direction. With an explicit `step`,
  # the value must also be a whole number of steps from `start`. Without one,
  # any value in the interval matches, so ranges of any ordered type work.
  # Raises [`ValueError`](std.ValueError) for a zero step.
  #
  # ## Example
  #
  # ```playground
  # #> import test:
  # #>   - assert
  # let r1 = Range 0 5
  # assert (r1.contains 0)
  # assert (r1.contains 4)
  # assert (!r1.contains 5)
  #
  # let r2 = Range 5 0 -2
  # assert (r2.contains 5)
  # assert (r2.contains 1)
  # assert (!r2.contains 2)
  #
  # # Without a step, the range ascends, and 5..0 is empty
  # assert (!(Range 5 0).contains 3)
  # ```
  pub def contains
    self
    # the value to check
    value @ T
  do -> Bool
    ...

  # Iterates the range's values.
  pub def (iter) self -> Iter[T]
    ...

  # Spreads the interval's values positionally.
  pub def (spread) self -> Spread[T]
    ...


# Stores an immutable sequence of positional items and symbol-keyed items.
#
# Records keep their items in order, and a key may repeat. A lookup finds the
# latest value for a key. Spreading a repeated key into a call raises
# [`UnexpectedKeyError`](std.UnexpectedKeyError) if it names a parameter;
# duplicates captured by a rest remain in order. Keys are read by indexing,
# not as fields:
#
# ```
# let r = record name: Alice age: 30
# assert_eq $r[:name:] Alice
# ```
#
# A variadic capture such as `...rest` binds a record of the remaining
# arguments. Use [`with`](std.Record.with) to replace keys in a new record:
#
# ```
# let updated = old.with status: ready
# ```
pub class Record[...Ts]: Iterable[Entries[Ts]] @Index[Ts] @Spread[Ts] @Unpack[Ts, Rest: MapRest[Ts]]
  # Builds a record from one spreadable source of key-value pairs.
  #
  # ```
  # let r = Record {name: Alice, age: 30}
  # ```
  #
  # Integer keys counting up from `0` become positional items, as when
  # spreading a dict.
  #
  # The lowercase `record` factory instead builds a record from its arguments.
  #
  # ```
  # let r = record first second name: Alice
  # ```
  #
  # ## Errors
  #
  # Raises `TypeError` for any other key that is not a symbol.
  pub def (init) self source @ Spread[Ts]
    ...

  # Gets the value for a symbol or position, with an optional default.
  pub def get[D = nil]
    self
    key @ (Int | Sym)
    :default @ D = ...
    :else @ (() -> D) = ...
  do -> (Value | D)
    ...

  # Replaces keys in a new record, leaving the original unchanged.
  #
  # Each updated key occupies its first position; later occurrences are removed.
  # New keys append in the order first supplied. Repeated updates use their last
  # value. Other items, including positional items, keep their relative order.
  # Spread a source with `...source` to supply updates.
  #
  # ```
  # let r = record status: pending name: Alice status: queued
  # assert_eq (r.with status: ready) (status: "ready", name: "Alice")
  # ```
  #
  # The result is typed as a plain [`Record`](std.Record), so the type checker
  # doesn't know its keys.
  #
  # ## Errors
  #
  # Raises [`UnexpectedPosError`](std.UnexpectedPosError) for positional arguments.
  pub def with self **updates @ Value -> Record
    ...

  # Removes all occurrences of the keys in a new record.
  #
  # Missing and repeated keys are harmless. Remaining items keep their relative
  # order, and the original is unchanged. Only symbol keys can be removed. The
  # result is typed as a plain [`Record`](std.Record), so the type checker
  # doesn't know its keys.
  #
  # ```
  # let r = record name: Alice status: ready debug: true
  # assert_eq (r.without :status: :debug:) (name: "Alice")
  # ```
  #
  # ## Errors
  #
  # | Exception | Condition |
  # | --------- | --------- |
  # | [`TypeError`](std.TypeError) | A key is not a symbol |
  # | [`UnexpectedKeyError`](std.UnexpectedKeyError) | A keyword argument is supplied |
  pub def without self *keys@Sym -> Record
    ...

  # Number of items, counting each instance of a repeated key.
  #[getter]
  pub def len self -> Int
    ...

  # Iterates record items as `(key, value)` pairs in order. A positional item's
  # key is its position.
  pub def (iter) self -> UnpackIter[Entries[Ts]]
    ...

  # Unpacks record items by position and symbol.
  pub def (unpack) self -> Record[...Ts]
    ...

  # Returns the value at a position or key.
  pub def (index)[K] self key@K -> IndexItem[Ts, K]
    ...

  # Spreads the record's items.
  pub def (spread) self -> Spread[Ts]
    ...


# Sets are ordered, mutable collections with unique membership semantics.
#
# Iteration preserves insertion order. Reinserting an existing value is a no-op
# and does not move it to the end.
pub class Set[T]: Iterable[T] @Spread[T]
  # Builds a set, from one iterable if given.
  pub def (init) self iterable @ Iterable[T] = ...
    ...

  # Returns the number of members.
  #[getter]
  pub def len self -> Int
    ...

  # Adds `value` if it is not already present.
  #
  # ## Example
  #
  # ```
  # let s = Set [1, 2]
  # s.add 3
  # s.add 2
  # assert_eq [...s] [1, 2, 3]
  # ```
  pub def add
    self
    # the value to insert
    value @ T
  do
    ...

  # Removes all members.
  #
  # ```
  # let s = Set [1, 2]
  # s.clear()
  # assert_eq $s.len 0
  # ```
  pub def clear self
    ...

  # Tests whether the Set contains `value`.
  pub def contains
    self
    # the value to test
    value @ Value
  do -> Bool
    ...

  # Returns a shallow copy of the Set.
  #
  # Insertion order is preserved. Contained values are *not* recursively copied.
  pub def copy self -> Set[T]
    ...

  # Indicates whether a value was removed. Removes `value` if present.
  pub def delete
    self
    # the value to remove
    value @ Value
  do -> Bool
    ...

  # Returns a new Set containing members from the receiver that are not present in
  # `other`.
  pub def diff[U]
    self
    # other Set
    other @ Set[U]
  do -> Set[T]
    ...

  # Returns a new Set containing members that are present in both sets, in
  # the receiver's insertion order.
  pub def intersect[U]
    self
    # other Set
    other @ Set[U]
  do -> Set[T]
    ...

  # Returns `true` when every member of the receiver is present in `other`.
  pub def is_subset[U]
    self
    # other Set
    other @ Set[U]
  do -> Bool
    ...

  # Returns `true` when every member of `other` is present in the receiver.
  pub def is_superset[U]
    self
    # other Set
    other @ Set[U]
  do -> Bool
    ...

  # Returns a new Set containing members present in exactly one of the two
  # sets.
  pub def sym_diff[U]
    self
    # other Set
    other @ Set[U]
  do -> Set[Union[T, U]]
    ...

  # Returns a new Set containing all members from `self`, then first-seen members
  # from `other`.
  pub def union[U]
    self
    # other Set
    other @ Set[U]
  do -> Set[Union[T, U]]
    ...

  # Iterates values in insertion order:
  #
  # ```
  # let s = Set [3, 1, 2, 1]
  # assert_eq [...s] [3, 1, 2]
  # ```
  # Returns an iterator.
  pub def (iter) self -> Iter[T]
    ...

  # Spreads the values positionally, in insertion order.
  pub def (spread) self -> Spread[T]
    ...


# What [`setter`](std.setter) makes from a function of the object assigned and
# its new value.
#
# A class member holding one is a computed field: `obj.name = value` calls the
# function with `obj` and `value`. A decorator that wraps a setter's function
# returns this type by calling `setter` itself.
pub @class Setter[T, V]
  field func @Phantom[((T, V) -> nil)]


