# dolang: strict
# Base64 encoding and decoding (RFC 4648).

# A base64 alphabet.
pub @let Alphabet = $
  # Standard alphabet, using `+` and `/` (RFC 4648 section 4)
  | :STANDARD:
  # URL-safe alphabet, using `-` and `_` (section 5)
  | :URL:

# What is wrong with input to [`decode`](base64.decode); see
# [`DecodeError.kind`](base64.DecodeError.kind).
pub @let DecodeErrorKind = $
  # A character outside the alphabet, or padding before the end
  | :BYTE:
  # The last character has bits that decoding would discard
  | :LAST_SYMBOL:
  # The last group has a single character
  | :LENGTH:
  # Padding does not match `pad:`
  | :PADDING:

# Raised when [`decode`](base64.decode) is given invalid base64.
#
# ## Example
#
# ```
# try
#   decode "aGVs%G8="
# catch DecodeError: err
#   echo "bad base64 at offset $(err.offset)"
# ```
pub class DecodeError: std.DataError
  # What is wrong with the input.
  #[getter]
  pub def kind self -> DecodeErrorKind
    ...

  # Byte offset of the fault, counting from 0; `nil` for `:LENGTH:` and
  # `:PADDING:`.
  #[getter]
  pub def offset self -> (Int | nil)
    ...

# Decodes base64 text and returns the raw bytes.
#
# By default both alphabets and any amount of padding are accepted. Specifying
# `alphabet:` or `pad:` makes decoding strict in that respect.
#
# ## Errors
#
# [`DecodeError`](base64.DecodeError) if the input is not valid base64.
#
# ## Example
#
# ```
# assert_eq (decode "aGVsbG8=") b"hello"
# assert_eq (decode "aGVsbG8") b"hello"
# assert_eq (decode $ encode "hello") b"hello"
# assert_eq (decode "-_8" alphabet: :URL: pad: false) b"\xfb\xff"
# ```
pub def decode
  # Base64 text to decode.
  text @ (Str | Bin)
  # Alphabet, or `:AUTO:` to detect it; default `:AUTO:`.
  #
  # `:AUTO:` uses the alphabet of the first `-`, `_`, `+`, or `/` in the input;
  # a character of the other alphabet is then invalid. Input containing none of
  # them decodes identically under both.
  :alphabet @ (Alphabet | :AUTO:) = ...
  # Required padding; default none.
  #
  # When `pad:` is omitted, canonical padding and any lesser amount — including
  # none — are accepted. `pad: true` requires canonical padding; `pad: false`
  # requires that padding be absent.
  :pad @ Bool = ...
do -> Bin
  ...

# Encodes a string or binary value as base64 text.
#
# ## Example
#
# ```playground
# #> import base64:
# #>   - encode
# #> import test:
# #>   - assert_eq
# assert_eq (encode "") ""
# assert_eq (encode "hello") "aGVsbG8="
# assert_eq (encode b"hello") "aGVsbG8="
# assert_eq (encode b"\xfb\xff") "+/8="
# assert_eq (encode b"\xfb\xff" alphabet: :URL:) "-_8"
# assert_eq (encode "hello" pad: false) "aGVsbG8"
# ```
pub def encode
  # Data to encode.
  data @ (Str | Bin)
  # Alphabet; default `:STANDARD:`.
  :alphabet @ Alphabet = ...
  # Whether to emit padding; default depends on `alphabet:`.
  #
  # `pad:` defaults to `true` for `:STANDARD:` and `false` for `:URL:`, since
  # URL-safe base64 is conventionally unpadded (for example in JSON Web
  # Signatures, RFC 7515). Pass `pad:` explicitly to override.
  :pad @ Bool = ...
do -> Str
  ...
