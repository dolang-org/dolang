# dolang: strict
#
# Concurrency primitives.
#
# Every strand has a current input, which it reads values from, and a current
# output, which it writes values to. A new strand starts with its creator's.
# Functions here that read or write without being given a source or
# destination, such as [`next`](strand.next) and [`put`](strand.put), use
# them. [`pipeline`](strand.pipeline) connects each stage's output to the next
# stage's input, and [`redirect`](strand.redirect) replaces them for the
# duration of a call. In the shell, a program's input and output start as its
# standard input and output.

# The sending end of a pipe between strands, as a
# [`stream`](strand.stream) strand's output. In the shell, this is
# [`proc.PipeSender`](proc.PipeSender); otherwise it is a
# [`Sender`](strand.Sender).
pub @let PipeSender[I] = ...

# The receiving end of a pipe between strands, as a
# [`stream`](strand.stream) strand's input. In the shell, this is
# [`proc.PipeReceiver`](proc.PipeReceiver); otherwise it is a
# [`Receiver`](strand.Receiver).
pub @let PipeReceiver[I] = ...

# Stores a strand-local value.
pub class Key[T]
  # Creates a strand-local key. An initial value is returned in a strand until
  # that strand sets the key. Without one, the initial value is `nil`.
  #
  # ```
  # let key = strand.Key 0
  # ```
  @def (init)[U] self @ Key[U | nil]

  @def (init) self value @ T

  pub def (init)
    self
    # Value returned until this key is set in the current strand.
    value @ (T | nil) = nil
  do
    ...

  # Gets or sets the value associated with this key in the current strand.
  #
  # Returns the initial value when the key has not been set in the current
  # strand.
  #
  # ```playground
  # #> import test:
  # #>   - assert_eq
  # let key = strand.Key()
  # assert_eq $key.value nil
  #
  # key.value = "parent"
  # assert_eq $key.value "parent"
  #
  # let results = strand.fork
  #   do
  #     assert_eq $key.value "parent"
  #     key.value = "child"
  #     key.value
  #
  # assert_eq $results (Tuple(["child"]))
  # assert_eq $key.value "parent"
  # ```
  #[getter]
  pub def value self -> T
    ...

  #[setter]
  pub def value self value @ T
    ...

  # Runs `block` with a temporary value for this key in the calling strand.
  # Restores the previous binding when the block returns or raises. Child
  # strands created inside the block inherit the temporary value.
  #
  # ## Example
  #
  # ```
  # let depth = strand.Key 0
  # depth.with 1 do
  #   echo $depth.value
  # ```
  pub def with[R]
    self
    # Temporary value for this key.
    value @ T
    # Block to call with the temporary value.
    block @ (() -> R)
  do -> R
    ...

# Receives values from a channel. As an [`Iter`](std.Iter), it can be used
# with `for` or `next()`.
#
# Receivers are returned by [`channel`](strand.channel). Once the channel is
# closed and drained, `next()` raises `IterStop`; a sender error is re-raised after any
# buffered values are drained.
pub class Receiver[T]: std.Iter[T]
  # Closes the receiver. This prevents any more values from being sent and
  # wakes up any waiting senders.
  pub def close self
    ...

# Limits concurrent entry into application-defined scopes.
pub class Resource
  # Creates a resource with `count` concurrent reservations.
  #
  # Raises [`ValueError`](std.ValueError) if `count` is zero.
  pub def (init)
    self
    # Maximum number of concurrent reservations.
    count @ Int
  do
    ...

  # Runs `block` while holding one reservation.
  #
  # Entering the same resource again in the same strand is reentrant. Scoped child
  # strands inherit the reservation and share it with their parent. Background
  # strands created with `spawn` or `stream` do not inherit reservations.
  #
  # Acquiring multiple resources in inconsistent orders can deadlock. Programs
  # must use a consistent acquisition order.
  #
  # Resources limit admission only and must not be used to protect critical-section
  # invariants.
  #
  # ## Example
  #
  # ```
  # network.with do
  #   fetch_data()
  # ```
  pub def with[R]
    self
    # Work to run while holding the reservation.
    block @ (() -> R)
  do -> R
    ...

# Sends values into a channel. As a [`Sink`](std.Sink), it accepts `put`.
#
# Senders are returned by [`channel`](strand.channel).
pub class Sender[T]: std.Sink[T]
  # Sends a value, waiting while the channel's buffer is full.
  #
  # ## Errors
  #
  # | Exception                            | Condition                          |
  # | ------------------------------------ | ---------------------------------- |
  # | [`StateError`](std.StateError)       | The sender is closed               |
  # | [`SinkStop`](std.SinkStop)           | The receiver is closed             |
  pub def put
    self
    # Value to send.
    value @ T
  do
    ...

  # Closes the sender, signaling the end of values to the receiver.
  #
  # Later sends raise [`StateError`](std.StateError). The receiver stops after
  # it drains any buffered values; if `error` is given, it raises `error`
  # instead of stopping.
  #
  # ## Example
  #
  # ```
  # send.close()
  # send.close "boom"
  # ```
  pub def close
    self
    # Error for the receiver to raise.
    error @ Value = nil
    # Backtrace to report with `error`.
    :backtrace @ Backtrace = nil
  do
    ...

# Handles a background strand created by [`spawn`](strand.spawn).
pub class Strand[R]
  # Whether the strand has completed execution.
  #[getter]
  pub def done self -> Bool
    ...

  # Cancels the strand.
  #
  # The strand raises [`CanceledError`](std.CanceledError) at once if it is
  # suspended, and otherwise the next time it suspends. Cancellation is
  # permanent: each later attempt to suspend raises it again.
  pub def cancel self
    ...

  # Waits until the strand completes and returns its result.
  #
  # If the strand exited with an error, re-raises it.
  pub def join self -> R
    ...

  # Waits until the strand completes, without returning its result or
  # re-raising its error as [`join`](strand.Strand.join) does.
  pub def wait self
    ...

# A [`Strand`](strand.Strand) with channel-backed input and output, created by
# [`stream`](strand.stream).
#
# Its iterator re-raises a strand error after draining output; its sink reports
# ordinary shutdown after input closes.
pub class Stream[R, I, O]: Iterable[I] Sinkable[O]
  # Whether the strand has completed execution.
  #[getter]
  pub def done self -> Bool
    ...

  # Cancels the strand, as [`Strand.cancel`](strand.Strand.cancel) does.
  pub def cancel self
    ...

  # Closes both channels, then waits for the strand to complete and returns its
  # result.
  #
  # If the strand exited with an error, re-raises it. Closing the channels first
  # keeps the wait from deadlocking on a strand that is waiting for more input or
  # for its output to be read.
  pub def join self -> R
    ...

  # Waits for the strand to complete. Unlike [`join`](strand.Stream.join), this
  # does not close the channels, return the strand's result, or re-raise its
  # error.
  pub def wait self
    ...


# A snapshot of a strand's calls, innermost first.
#
# Obtained from [`backtrace`](strand.backtrace) or
# [`error_backtrace`](strand.error_backtrace). Iterating it gives a
# [`Frame`](strand.Frame) for each call.
pub class Backtrace: std.Iterable[Frame] @Spread[Frame]
  # Spreads the frames positionally.
  pub def (spread) self -> Spread[Frame]
    ...

  # The number of frames.
  #[getter]
  pub def len self -> Int
    ...

# One call in a [`Backtrace`](strand.Backtrace).
pub @class Frame
  # The module of the called code, or `<program>` for a script.
  #[getter]
  pub def module self -> Str

  # The name of the called Do function, or the receiver of a method call.
  #[getter]
  pub def receiver self -> Str

  # The method name, or `nil` otherwise.
  #[getter]
  pub def method self -> (Str | nil)

  # The source file of the called code, when it has one.
  #[getter]
  pub def source self -> (Str | nil)

  # The line being run in the source file, when there is one.
  #[getter]
  pub def line self -> (Int | nil)

# Captures the current strand's calls.
pub def backtrace() -> Backtrace
  ...

# Captures the calls of the exception being handled, followed by the current
# strand's calls.
#
# ## Errors
#
# `std.StateError` if no exception is being handled, in a `catch` or `finally`
# block.
pub def error_backtrace() -> Backtrace
  ...

# Creates a channel for communication between strands.
pub def channel[T]
  # Number of values the channel holds before a send waits; 1 when omitted.
  buffer @ Int = nil
do -> Tuple[Sender[T], Receiver[T]]
  ...

# Collects the strand-local input into a new array.
@def collect[I] < Iter[I] -> Array[I]

# Collects the strand-local input into a sink, returning the sink.
@def collect[I, S @ Sinkable[I]] target@S <Iter[I] -> S

pub def collect ...args @ Value -> Value
  ...

# Transforms each value of the strand-local input and writes the result to the
# strand-local output.
pub def each[I, O]
  # Function that transforms one value.
  func @ ((I, <Value, >Value) -> O)
  < Iter[I]
  > Sink[O]
do
  ...

# Runs blocks concurrently and returns their results in block order.
pub def fork[*Rs]
  # Functions to run concurrently.
  *blocks @ ...(() -> Rs)
do -> Tuple[...Rs]
  ...

# Writes the values of an iterable to the strand-local output.
pub def from[O]
  # Values to write.
  value @ Iterable[O]
  > Sink[O]
do
  ...

# Returns the strand-local input.
pub def input[I] <I -> I
  ...

# Applies a function concurrently to values from the strand-local input,
# writing results to the strand-local output.
# The function sees `std.null` as input and output.
@def map[I, O]
  # Number of worker strands.
  count @ Int
  # Function applied to each input value.
  func @ ((I, <Value, >Value) -> O)
  < Iter[I]
  > Sink[O]
do -> nil

# Applies a function concurrently to values pulled from an iterable, writing
# results to the strand-local output.
@def map[I, O]
  # Number of worker strands.
  count @ Int
  # Function applied to each input value.
  func @ ((I, >Value) -> O)
  # Values to process.
  :input @ Iterable[I]
  > Sink[O]
do -> nil

# Applies a function concurrently to values from the strand-local input,
# writing results to a sink.
@def map[I, O]
  # Number of worker strands.
  count @ Int
  # Function applied to each input value.
  func @ ((I, <Value) -> O)
  # Sink to write results to.
  :output @ Sinkable[O]
  < Iter[I]
do -> nil

# Applies a function concurrently to values pulled from an iterable, writing
# results to a sink.
@def map[I, O]
  # Number of worker strands.
  count @ Int
  # Function applied to each input value.
  func @ (I -> O)
  # Values to process.
  :input @ Iterable[I]
  # Sink to write results to.
  :output @ Sinkable[O]
do -> nil

pub def map count@Int func@Value ...options@Value -> nil
  ...

# Reads the next value of the strand-local input.
#
# ## Errors
#
# `std.IterStop` if the input is exhausted.
@def next[I] <Iter[I] -> I

# Reads the next value of the strand-local input, or returns `default` if the
# input is exhausted.
@def next[I, D] :default @ D <Iter[I] -> (I | D)

# Reads the next value of the strand-local input, or returns the result of
# calling `else` if the input is exhausted.
@def next[I, E] :else @ (() -> E) <Iter[I] -> (I | E)

pub def next ...args @ Value -> Value
  ...

# Returns the strand-local output.
pub def output[O] >O -> O
  ...

# Connects pipeline stages and runs them concurrently, returning the last
# stage's result.
@def pipeline[R]
  # Input for the first stage, in place of the strand-local input.
  :input @ Iterable[Value] = nil
  # Pipeline stages, each reading the previous stage's output.
  ...stages @ ((<Iter[std.Unknown], >Sink[std.Unknown]) -> Value)
  # Final stage.
  final @ ((<Iter[std.Unknown]) -> R)
do -> R

# Connects pipeline stages and runs them concurrently, writing the last stage's
# output to a sink and returning its result.
@def pipeline[R, O]
  # Input for the first stage, in place of the strand-local input.
  :input @ Iterable[Value] = nil
  # Output for the last stage, in place of the strand-local output.
  :output @ Sinkable[O]
  # Pipeline stages, each reading the previous stage's output.
  ...stages @ ((<Iter[std.Unknown], >Sink[std.Unknown]) -> Value)
  # Final stage.
  final @ ((<Iter[std.Unknown], >Sink[O]) -> R)
do -> R

pub def pipeline ...args @ Value -> Value
  ...

# Runs a function over the items of an iterable with a fixed number of scoped
# workers.
@def pool[T]
  # Number of worker strands.
  count @ Int
  # Items to process.
  input @ Iterable[T]
  # Function applied to each input value.
  func @ ((T) -> nil)
do -> nil

# Runs a function over the strand-local input with a fixed number of scoped workers.
@def pool[T]
  # Number of worker strands.
  count @ Int
  # Function applied to each input value.
  func @ ((T, <Value) -> nil)
  < Iter[T]
do -> nil

pub def pool count@Int ...args@Value -> nil
  ...

# Writes a value to the strand-local output.
pub def put[T] value@T >Sink[T]
  ...

# Calls a function with the strand-local input and output replaced, returning its
# result.
#
# The previous input and output are restored when `block` returns or raises.
#
# ## Example
#
# ```playground
# #> import test:
# #>   - assert_eq
# let doubled = []
# strand.redirect input: [1, 2, 3] output: $doubled do
#   strand.each do |x| (x * 2)
# assert_eq $doubled [2, 4, 6]
# ```
@def redirect[R, I, O]
  # Replacement for the strand-local input.
  :input @ Iterable[I]
  # Replacement for the strand-local output.
  :output @ Sinkable[O]
  # Function to call.
  block @ ((<Iter[I], >Sink[O]) -> R)
do -> R

# Calls a function with the strand-local input replaced, returning its result.
@def redirect[R, I]
  # Replacement for the strand-local input.
  :input @ Iterable[I]
  # Function to call.
  block @ ((<Iter[I]) -> R)
do -> R

# Calls a function with the strand-local output replaced, returning its result.
@def redirect[R, O]
  # Replacement for the strand-local output.
  :output @ Sinkable[O]
  # Function to call.
  block @ ((>Sink[O]) -> R)
do -> R

# Calls a function, returning its result.
@def redirect[R]
  # Function to call.
  block @ (() -> R)
do -> R

pub def redirect ...args @ Value -> Value
  ...

# Calls a function with the strand-local input and output set to the given
# values as they are.
#
# Unlike [`redirect`](strand.redirect), this does not convert the values with
# `(iter)` or `(sink)`, so it can restore an input or output saved with
# [`input`](strand.input) or [`output`](strand.output) exactly.
#
# The previous input and output are restored when `block` returns or raises.
# Omitted channels are unchanged.
#
# ## Example
#
# ```
# def with_saved_input block
#   let saved_input = input()
#   redirect input: ["ready"] do
#     next()
#     with_io input: $saved_input do block()
# ```
@def with_io[R, I, O]
  # Replacement for the strand-local input.
  :input @ I
  # Replacement for the strand-local output.
  :output @ O
  # Function to call.
  block @ ((<I, >O) -> R)
do -> R

# Calls a function with the strand-local input set to the given value as it is.
@def with_io[R, I]
  :input @ I
  block @ ((<I) -> R)
do -> R

# Calls a function with the strand-local output set to the given value as it is.
@def with_io[R, O]
  :output @ O
  block @ ((>O) -> R)
do -> R

# Calls a function, returning its result.
@def with_io[R] block @ (() -> R) -> R

pub def with_io ...args @ Value -> Value
  ...

# Runs a function in a background strand.
pub def spawn[R]
  # Function to run.
  func @ (() -> R)
do -> Strand[R]
  ...

# Runs a function in a background strand with channel-backed endpoints.
pub def stream[R, I = Value, O = Value]
  # Function to run.
  func @ ((<PipeReceiver[I], >PipeSender[O]) -> R)
do -> Stream[R, O, I]
  ...

# Raises a value as an exception.
pub def throw
  # Value to raise.
  value @ Value
  # Backtrace to report instead of the current strand's calls.
  :backtrace @ Backtrace = nil
do -> Never
  ...

# Writes the values of the strand-local input that satisfy a predicate to the
# strand-local output.
pub def where[T] predicate@((T, <Value, >Value) -> Bool) <Iter[T] >Sink[T]
  ...
