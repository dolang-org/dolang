# dolang: strict
#
# Source locations of running code: backtraces of a strand's calls, and where
# functions are defined.
#
# Locations come from the debug info that compiled code carries, so code
# without it has none.

# A span of source code in a file.
#
# Lines and columns are zero-based. Columns and lengths count Unicode scalar
# values, a tab counting as one, and a length includes the line breaks the
# span crosses. Locations are equal when their files and spans are.
#[final]
pub class Location
  # The source file.
  #[getter]
  pub def source self -> Str
    ...

  # The line the span starts on.
  #[getter]
  pub def line self -> Int
    ...

  # The column the span starts at.
  #[getter]
  pub def column self -> Int
    ...

  # The length of the span.
  #[getter]
  pub def len self -> Int
    ...

# A snapshot of a strand's calls, innermost first.
#
# Obtained from [`strand.backtrace`](strand.backtrace) or
# [`strand.error_backtrace`](strand.error_backtrace). Iterating it gives a
# [`Frame`](inspect.Frame) for each call.
#[final]
pub class Backtrace: std.Iterable[Frame] @Spread[Frame]
  # Spreads the frames positionally.
  pub def (spread) self -> Spread[Frame]
    ...

  # The number of frames.
  #[getter]
  pub def len self -> Int
    ...

# One call in a [`Backtrace`](inspect.Backtrace).
#[final]
pub class Frame
  # The module of the called code, or `<program>` for a script.
  #[getter]
  pub def module self -> Str
    ...

  # The name of the called Do function, or the receiver of a method call.
  #[getter]
  pub def receiver self -> Str
    ...

  # The method name, or `nil` otherwise.
  #[getter]
  pub def method self -> (Str | nil)
    ...

  # The code being run in the called function, when it has a location. While
  # the function is still unpacking its arguments, this is its definition.
  #[getter]
  pub def location self -> (Location | nil)
    ...

# Gives where a Do function is defined.
#
# For a named function or method, the location runs from `def` through the
# name. For a `do` block, it runs from `do` through the parameters and return
# type, leaving out the body. A bound method, such as
# `obj.method`, gives the location of the Do method it calls.
#
# Gives `nil` for anything else: a native function or method, an object
# callable through a `(call)` method, or a value that isn't callable.
pub def definition
  # Value to look up.
  func @ Value
do -> (Location | nil)
  ...
