# dolang: strict
# Streams TAR archives with optional gzip or zstd compression.

import
  fs:
    - @Path
  io:
    - Io
  fs.unix:
    @Path: UnixPath
  time:
    - @DateTime

# The type of a TAR entry.
pub @let EntryType = $
  # Regular file
  | :FILE:
  # Directory
  | :DIR:
  # Hard link
  | :HARDLINK:
  # Symbolic link
  | :SYMLINK:
  # Named pipe (FIFO)
  | :FIFO:
  # Character device
  | :CHAR_DEVICE:
  # Block device
  | :BLOCK_DEVICE:
  # Contiguous file
  | :CONTIGUOUS:
  # Any other type
  | :UNKNOWN:

# Metadata and streaming content for the current TAR entry.
#
# The handle remains valid only until its parent [`Reader`](tar.Reader)
# advances or leaves scope. Iterating an entry yields arbitrary-sized
# [`Bin`](std.Bin) chunks until the content is exhausted.
#
# A function that accepts an [`Io`](io.Io), such as
# [`compress.decompress`](compress.decompress), can read the content while the
# handle is valid.
#
# ## Example
#
# ```
# for chunk = entry
#   output.put $chunk
# ```
pub class Entry: Iter[Bin] Io
  # Whether the content can be read: whether the handle is still valid.
  #[getter]
  pub def readable self -> Bool
    ...

  # Device major number, or `nil` when absent.
  #[getter]
  pub def device_major self -> (Int | nil)
    ...

  # Device minor number, or `nil` when absent.
  #[getter]
  pub def device_minor self -> (Int | nil)
    ...

  # Numeric group ID.
  #[getter]
  pub def gid self -> Int
    ...

  # Group name, or `nil` when absent.
  #[getter]
  pub def group_name self -> (Str | nil)
    ...

  # Link target as an [`fs.unix.Path`](fs.unix.Path), or `nil` when
  # absent.
  #[getter]
  pub def link_name self -> (UnixPath | nil)
    ...

  # Unix permission bits.
  #[getter]
  pub def mode self -> Int
    ...

  # Modification time as [`DateTime`](time.DateTime).
  #[getter]
  pub def mtime self -> DateTime
    ...

  # Owner name, or `nil` when absent.
  #[getter]
  pub def owner_name self -> (Str | nil)
    ...

  # Entry path as an [`fs.unix.Path`](fs.unix.Path).
  #[getter]
  pub def path self -> UnixPath
    ...

  # Declared content size in bytes.
  #[getter]
  pub def size self -> Int
    ...

  # Entry type.
  #[getter]
  pub def type self -> EntryType
    ...

  # Numeric owner ID.
  #[getter]
  pub def uid self -> Int
    ...

  # Reads up to `size` bytes from the current content position.
  #
  # ## Example
  #
  # ```
  # let prefix = entry.read 512
  # ```
  pub def read
    self
    # Maximum bytes to read.
    size @ Int
  do -> Bin
    ...

  # Yields the next content chunk, ending iteration once the entry is
  # exhausted.
  pub def (next) self -> Bin
    ...

# Content stream for one scoped TAR entry.
#
# The writer is valid until the entry's scope ends. A function that accepts an
# [`Io`](io.Io), such as [`compress.compress`](compress.compress), can write
# the content during the scope.
#
# ## Errors
#
# | Exception | Condition |
# | --- | --- |
# | [`StateError`](std.StateError) | The entry's scope has ended |
# | [`ValueError`](std.ValueError) | A write would exceed the declared size; nothing of it is written |
#
# ## Example
#
# ```
# entry.put "first"
# entry.put b"second"
# ```
pub class EntryWriter: Io
  # Whether the writer is still valid.
  #[getter]
  pub def writable self -> Bool
    ...

  # Writes raw string or binary bytes, given in pieces.
  #
  # ## Returns
  #
  # The number of bytes written, which is all of them.
  #
  # ## Example
  #
  # ```
  # entry.write $header "\n"
  # entry.write b"\x00\x01"
  # ```
  pub def write
    self
    # Bytes to write.
    *data @ (Str | Bin)
  do -> Int
    ...

# Destructive iterator over the entries in an open TAR archive.
#
# Advancing the reader drains unread data from the current entry and
# invalidates its [`Entry`](tar.Entry) handle. Iteration yields entries in
# archive order.
#
# ## Example
#
# ```
# read "archive.tar" do |archive|
#   for entry = archive
#     echo $entry.path
# ```
pub class Reader: Iter[Entry]
  # Detected compression as `:NONE:`, `:GZIP:`, or `:ZSTD:`.
  #[getter]
  pub def compression self -> (:NONE: | :GZIP: | :ZSTD:)
    ...

  # Yields the next [`Entry`](tar.Entry), ending iteration at the end of the
  # archive.
  pub def (next) self -> Entry
    ...

# Sequential writer for a new TAR archive.
pub class Writer
  # Selected compression as `:NONE:`, `:GZIP:`, or `:ZSTD:`.
  #[getter]
  pub def compression self -> (:NONE: | :GZIP: | :ZSTD:)
    ...

  # Creates a directory entry.
  #
  # ## Example
  #
  # ```
  # archive.create_dir "subdir" mode: 0o755
  # ```
  pub def create_dir
    self
    # Entry
    # path.
    path @ (Str | Path)
    # Permission bits. Defaults to `0o755`.
    :mode @ Int = nil
    # Owner ID. Defaults to `0`.
    :uid @ Int = nil
    # Group ID. Defaults to `0`.
    :gid @ Int = nil
    # Modification time. Defaults to the
    # Unix epoch.
    :mtime @ DateTime = nil
    # Owner name.
    :owner_name @ Str = nil
    # Group name.
    :group_name @ Str = nil
  do
    ...

  # Adds one regular-file entry and calls `func` with a scoped
  # [`EntryWriter`](tar.EntryWriter).
  #
  # For directory, symlink, or hard-link entries, use
  # [`create_dir`](tar.Writer.create_dir), [`symlink`](tar.Writer.symlink), or
  # [`hard_link`](tar.Writer.hard_link) instead -- none of them carry content, so none of
  # them have any use for a write handle.
  #
  # ## Errors
  #
  # | Exception          | Condition                                                    |
  # | ------------------ | ------------------------------------------------------------ |
  # | `ConcurrencyError` | Another entry is created while an entry scope is active      |
  # | `ValueError`       | The number of bytes written differs from the declared `size` |
  #
  # ## Example
  #
  # ```
  # archive.entry data.bin size: 4 mode: 0o600 do |entry|
  #   entry.write b"\x00\x01\x02\x03"
  # ```
  pub def entry[R]
    self
    # Entry
    # path.
    path @ (Str | Path)
    # Exact content size.
    :size @ Int
    # Permission bits. Defaults to `0o644`.
    :mode @ Int = nil
    # Owner ID. Defaults to `0`.
    :uid @ Int = nil
    # Group ID. Defaults to `0`.
    :gid @ Int = nil
    # Modification time. Defaults to the
    # Unix epoch.
    :mtime @ DateTime = nil
    # Owner name.
    :owner_name @ Str = nil
    # Group name.
    :group_name @ Str = nil
    # Entry writer scope, called with an
    # [`EntryWriter`](tar.EntryWriter).
    func @ (EntryWriter -> R)
  do -> R
    ...

  # Creates a hard-link entry pointing to `target`.
  #
  # Argument order matches [`fs.hard_link`](fs.hard_link).
  #
  # ## Example
  #
  # ```
  # archive.hard_link "file.txt" "link.txt"
  # ```
  pub def hard_link
    self
    # Path the
    # hard link points to.
    target @ (Str | Path)
    # Entry
    # path.
    path @ (Str | Path)
    # Permission bits. Defaults to `0o644`.
    :mode @ Int = nil
    # Owner ID. Defaults to `0`.
    :uid @ Int = nil
    # Group ID. Defaults to `0`.
    :gid @ Int = nil
    # Modification time. Defaults to the
    # Unix epoch.
    :mtime @ DateTime = nil
    # Owner name.
    :owner_name @ Str = nil
    # Group name.
    :group_name @ Str = nil
  do
    ...

  # Creates a symbolic link entry pointing to `target`.
  #
  # Argument order matches
  # [`fs.symlink_file`](fs.symlink_file).
  #
  # ## Example
  #
  # ```
  # archive.symlink "target.txt" "link.txt"
  # ```
  pub def symlink
    self
    # Path the
    # symlink points to.
    target @ (Str | Path)
    # Entry
    # path.
    path @ (Str | Path)
    # Permission bits. Defaults to `0o777`.
    :mode @ Int = nil
    # Owner ID. Defaults to `0`.
    :uid @ Int = nil
    # Group ID. Defaults to `0`.
    :gid @ Int = nil
    # Modification time. Defaults to the
    # Unix epoch.
    :mtime @ DateTime = nil
    # Owner name.
    :owner_name @ Str = nil
    # Group name.
    :group_name @ Str = nil
  do
    ...

# Opens an archive and calls `func` with a [`Reader`](tar.Reader).
#
# A path is opened for reading. Any other source must be a readable
# [`Io`](io.Io), such as an open [`fs.File`](fs.File), which is read without
# being closed.
#
# Compression is detected from gzip or zstd magic bytes, so the source need
# not seek.
#
# ## Errors
#
# | Exception | Condition |
# | --- | --- |
# | [`TypeError`](std.TypeError) | `source` is not a path or an [`Io`](io.Io) |
# | [`ValueError`](std.ValueError) | `source` is not readable, and is left open |
#
# ## Example
#
# ```
# read "archive.tar.gz" do |archive|
#   for entry = archive
#     echo "$(entry.path): $(entry.size) bytes"
# ```
pub def read[R]
  # Archive input.
  source @ (Str | Path | Io)
  # Reader scope, called with a [`Reader`](tar.Reader).
  func @ (Reader -> R)
do -> R
  ...

# Creates an archive and calls `func` with a [`Writer`](tar.Writer).
#
# A path is created or truncated. Any other sink must be a writable
# [`Io`](io.Io), such as an open [`fs.File`](fs.File), which is written without
# being closed. The archive is finished when `func` returns, and a sink opened
# from a path is closed.
#
# ## Errors
#
# | Exception | Condition |
# | --- | --- |
# | [`TypeError`](std.TypeError) | `sink` is not a path or an [`Io`](io.Io) |
# | [`ValueError`](std.ValueError) | `sink` is not writable, and is left open |
#
# ## Example
#
# ```
# write "archive.tar.zst" do |archive|
#   archive.entry greeting.txt size: 5 do |entry|
#     entry.write hello
# ```
pub def write[R]
  # Archive output.
  sink @ (Str | Path | Io)
  # Compression.
  #
  # When omitted, `.gz` and `.tgz` select gzip, `.zst` and `.tzst` select
  # zstd, and other extensions select no compression. Extension matching is
  # case-insensitive. An explicit `compression` overrides the path. An
  # [`Io`](io.Io) sink has no extension, so it defaults to no compression.
  :compression @ (:NONE: | :GZIP: | :ZSTD:) = nil
  # Writer scope, called with a [`Writer`](tar.Writer).
  func @ (Writer -> R)
do -> R
  ...
