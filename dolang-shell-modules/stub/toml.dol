# dolang: strict
# TOML serialization and deserialization.

import std:
  - @BaseStruct

# What is wrong with TOML input; see
# [`DecodeError.kind`](toml.DecodeError.kind).
pub @let DecodeErrorKind = $
  # The text is not valid TOML
  | :SYNTAX:
  # The input has a datetime, date, or time value
  | :UNSUPPORTED:
  # An integer is too large for an `Int`, or a float for a `Float`
  | :RANGE:

# Raised when [`decode`](toml.decode) is given invalid TOML, or TOML that uses
# a feature it doesn't support.
#
# ## Example
#
# ```
# try
#   decode "a = [1,"
# catch DecodeError: err
#   echo "bad TOML at line $(err.line), column $(err.column)"
# ```
pub class DecodeError: std.DataError
  # What is wrong with the input.
  #[getter]
  pub def kind self -> DecodeErrorKind
    ...

  # Line of the fault, counting from 1.
  #[getter]
  pub def line self -> Int
    ...

  # Column of the fault, counting characters from 1.
  #[getter]
  pub def column self -> Int
    ...

# Why a value can't be written as TOML; see
# [`EncodeError.kind`](toml.EncodeError.kind).
pub @let EncodeErrorKind = $
  # The value contains itself
  | :CYCLE:
  # An `Int` is outside the signed 64-bit range
  | :RANGE:
  # Two keys of one table have the same name, such as `:a:` and `"a"`
  | :KEY:

# Raised when [`encode`](toml.encode) is given a value that can't be written as
# TOML as it stands.
#
# ## Example
#
# ```
# let items = []
# items.push $items
# try
#   encode {items: items}
# catch EncodeError: err
#   echo "can't encode $(err.path): $err"
# ```
pub class EncodeError: std.ValueError
  # Why the value can't be written.
  #[getter]
  pub def kind self -> EncodeErrorKind
    ...

  # Keys and indices that lead from the encoded value to the fault.
  #
  # For `:CYCLE:` the path leads to the repeated container, for `:RANGE:` to
  # the `Int`, and for `:KEY:` to the table holding the keys. Each key is the
  # one in the encoded value.
  #[getter]
  pub def path self -> Tuple[...(Int | Str | Sym)]
    ...

# A value decoded from TOML.
pub @let DecodeValue = $
  | Bool
  | Int
  | Float
  | Str
  | Array[DecodeValue]
  | Dict[Str, DecodeValue]

# A value that encodes as TOML.
pub @let EncodeValue = $
  | Bool
  | Int
  | Float
  | Str
  | Sym
  | BaseArray[EncodeValue]
  | Tuple[...EncodeValue]
  | BaseStruct[{**EncodeValue}]
  | BaseDict[Str | Sym, EncodeValue]

# Parses a TOML string into a Do value.
#
# | TOML Value | Do Type |
# | ---------- | ------- |
# | boolean    | `Bool`  |
# | integer    | `Int`   |
# | float      | `Float` |
# | string     | `Str`   |
# | array      | `Array` |
# | table      | `Dict`  |
#
# Full documents and bare TOML values such as numbers, arrays, and inline
# tables are accepted.
#
# ## Errors
#
# [`DecodeError`](toml.DecodeError) if the input is invalid TOML, contains a
# datetime, date, or time value, or has a number too large to represent. When the
# input is neither a valid document nor a valid bare value, the error is from
# whichever reading got further.
#
# ## Example
#
# ```playground
# #> import toml:
# #>   - decode
# #> import test:
# #>   - assert_eq
# assert_eq (decode "42") 42
# assert_eq (decode "[1, 2, 3]") [1, 2, 3]
#
# let Dict(doc) = decode |
#   title = "Example"
#   [server]
#   port = 8080
#
# assert_eq $doc["title"] "Example"
# let Dict(server) = doc["server"]
# assert_eq $server["port"] 8080
# ```
pub def decode
  # TOML input to parse.
  toml @ Str
do -> DecodeValue
  ...

# Serializes a Do value to a TOML string.
#
# | Do Type  | TOML Value |
# | -------- | ---------- |
# | `Bool`   | boolean    |
# | `Int`    | integer    |
# | `Float`  | float      |
# | `Str`    | string     |
# | `Sym`    | string     |
# | `Array`  | array      |
# | `Tuple`  | array      |
# | `Dict`   | table      |
# | `Struct` | table      |
#
# Top-level dicts and structs serialize as documents, while other values
# serialize as values. In a document, each table's plain keys come first. Nested
# tables follow as `[a.b]` sections, and non-empty arrays whose elements are all
# tables as `[[a.b]]` sections. Values inside arrays are written inline. The
# result has no trailing newline.
#
# ## Errors
#
# | Exception | Condition |
# | --- | --- |
# | [`TypeError`](std.TypeError) | A value has no TOML form, such as `nil`, a `Bin`, or a custom object, or a key is not a `Str` or `Sym`. |
# | [`EncodeError`](toml.EncodeError) | The value contains itself, an `Int` is outside the signed 64-bit range, or a table has two keys with the same name. |
#
# ## Example
#
# ```
# assert_eq (encode 42) "42"
# assert_eq (decode $ encode [1, 2, 3]) [1, 2, 3]
#
# let doc = encode {"enabled": true, "name": "alice"}
# assert_eq (decode doc) {"enabled": true, "name": "alice"}
# ```
pub def encode
  # The value to serialize.
  value @ EncodeValue
do -> Str
  ...
