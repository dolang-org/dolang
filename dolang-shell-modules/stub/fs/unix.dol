# dolang: strict
# Unix filesystem types.

import fs
import
  security.unix:
    - @Permission

# A symbol naming bits of a [`Mode`](fs.unix.Mode).
pub @let ModeBit = $
  # Owner may read
  | :OWNER_READ:
  # Owner may write
  | :OWNER_WRITE:
  # Owner may execute
  | :OWNER_EXECUTE:
  # Group may read
  | :GROUP_READ:
  # Group may write
  | :GROUP_WRITE:
  # Group may execute
  | :GROUP_EXECUTE:
  # Everyone may read
  | :OTHER_READ:
  # Everyone may write
  | :OTHER_WRITE:
  # Everyone may execute
  | :OTHER_EXECUTE:
  # Set user ID on execute
  | :SET_UID:
  # Set group ID on execute
  | :SET_GID:
  # Sticky bit
  | :STICKY:
  # Regular file
  | :IFREG:
  # Directory
  | :IFDIR:
  # Symbolic link
  | :IFLNK:
  # FIFO
  | :IFIFO:
  # Character device
  | :IFCHR:
  # Block device
  | :IFBLK:
  # Socket
  | :IFSOCK:

# Unix `st_mode` bits: permissions, the set-user-ID/set-group-ID/sticky bits,
# and the file type.
#
# ## Example
#
# Reading a file's mode and applying it elsewhere:
#
# ```
# let Metadata(info) = fs.metadata "template.sh"
# let mode = info.mode
# update_metadata "script.sh" mode: $mode
# ```
#
# ```
# let rw = Mode(:OWNER_READ:, :OWNER_WRITE:)
# ```
pub class Mode: Iterable[ModeBit]
  # Constructs a mode from a raw `st_mode` value, preserving unknown bits.
  #
  # ## Example
  #
  # ```
  # let mode = Mode.from_int 0o644
  # ```
  #[class]
  pub def from_int
    self
    # Raw mode bits.
    value @ Int
  do -> Mode
    ...

  # Owner
  # permissions.
  #[getter]
  pub def owner self -> Permission
    ...

  # Group
  # permissions.
  #[getter]
  pub def group self -> Permission
    ...

  # Permissions for everyone else.
  #[getter]
  pub def other self -> Permission
    ...

  # The raw `st_mode` value, including the file type
  # bits.
  #
  # Mask with `0o7777` for the permission bits alone.
  #
  # ```
  # let Metadata(info) = fs.metadata "script.sh"
  # let mode = info.mode
  # assert_eq (mode.int & 0o7777) 0o755
  # ```
  #[getter]
  pub def int self -> Int
    ...

  # Constructs a flag set from symbols.
  #[class]
  @def (call) cls ...flags@ModeBit -> Mode

  # Constructs a flag set from one iterable of symbols.
  #[class]
  @def (call) cls flags@Iterable[ModeBit] -> Mode

  #[class]
  pub def (call) cls ...flags @ (ModeBit | Iterable[ModeBit]) -> Mode
    ...

  pub def (init) self ...flags @ (ModeBit | Iterable[ModeBit])
    ...

  # Tests whether all flags named by `flag` are set.
  pub def contains self flag @ ModeBit -> Bool
    ...

  # Returns the flags set in either.
  pub def (bor)[S @ Mode] self@S other@S -> S
    ...

  # Returns the flags set in both.
  pub def (band)[S @ Mode] self@S other@S -> S
    ...

  # Returns the flags set in exactly one.
  pub def (bxor)[S @ Mode] self@S other@S -> S
    ...

  # Returns the flags of the type that are not set.
  pub def (bnot)[S @ Mode] self @ S -> S
    ...

# [`fs.Path`](fs.Path) using Unix path syntax.
#
# See [`fs.Path`](fs.Path) for fields, methods, and operators.
pub class Path: fs.Path
  # Converts a string or another path to a Unix path.
  #
  # Converting a Windows path is allowed only when it is relative and has no
  # root, prefix, or alternate data stream.
  pub def (init)
    self
    # Path value.
    path @ (Str | fs.Path)
  do
    ...

  pub def (div) self other @ (Str | fs.Path | fs.DirEntry) -> Path
    ...

  pub def (rdiv) self other @ Str -> Path
    ...

  #[class]
  pub def join self *components @ (Str | fs.Path) -> Path
    ...

  #[getter]
  pub def parent self -> (Path | nil)
    ...

  pub def add_ext self ext @ Str -> Path
    ...

  pub def with_ext self ext @ Str -> Path
    ...

  pub def without_ext self -> Path
    ...

  pub def with_name self name @ Str -> Path
    ...

  pub def with_stem self stem @ Str -> Path
    ...

  pub def absolute self -> Path
    ...

  pub def canonical self -> Path
    ...

  pub def normalize self -> Path
    ...

  pub def relative self base @ (Str | fs.Path) = nil -> Path
    ...

  pub def shorten self base @ (Str | fs.Path) = nil -> Path
    ...

  pub def read_link self -> Path
    ...

  pub def glob
    self
    pattern @ Str
    :max_depth @ Int = nil
    :resolve @ fs.Resolve = nil
  do -> UnpackIter[Path]
    ...

# Unix directory entries.
pub class DirEntry: fs.DirEntry
  # The inode number of the entry.
  #[getter]
  pub def ino self -> Int
    ...

# Unix filesystem metadata.
pub class FsMetadata: fs.FsMetadata
  # Total data blocks.
  #[getter]
  pub def blocks self -> Int
    ...

  # Free data blocks, including reserved blocks.
  #[getter]
  pub def blocks_free self -> Int
    ...

  # Free data blocks available to unprivileged users.
  #[getter]
  pub def blocks_available self -> Int
    ...

  # Total file nodes.
  #[getter]
  pub def files self -> Int
    ...

  # Free file nodes.
  #[getter]
  pub def files_free self -> Int
    ...

  # Free file nodes available to unprivileged users.
  #[getter]
  pub def files_available self -> Int
    ...

  # Filesystem fragment size in bytes.
  #[getter]
  pub def fragment_size self -> Int
    ...

  # Raw filesystem identifier when the platform
  # reports one.
  #[getter]
  pub def fsid self -> (Int | nil)
    ...

  # Maximum filename length.
  #[getter]
  pub def name_max self -> Int
    ...

  # Raw Linux filesystem mount attribute mask.
  #[getter]
  pub def linux_attrs self -> (Int | nil)
    ...

  # Raw FreeBSD filesystem mount attribute mask.
  #[getter]
  pub def freebsd_attrs self -> (Int | nil)
    ...

  # Raw macOS filesystem mount attribute mask.
  #[getter]
  pub def macos_attrs self -> (Int | nil)
    ...

  # Whether setuid execution is disabled.
  #[getter]
  pub def no_suid self -> Bool
    ...

  # Whether execution is disabled.
  #[getter]
  pub def no_exec self -> (Bool | nil)
    ...

  # Whether writes are synchronous.
  #[getter]
  pub def synchronous self -> (Bool | nil)
    ...

  # Whether device files are disabled.
  #[getter]
  pub def no_dev self -> (Bool | nil)
    ...

  # Whether access time updates are disabled.
  #[getter]
  pub def no_atime self -> (Bool | nil)
    ...

  # Whether directory access time updates are
  # disabled.
  #[getter]
  pub def no_dir_atime self -> (Bool | nil)
    ...

  # Whether relative-atime updates are enabled.
  #[getter]
  pub def relatime self -> (Bool | nil)
    ...

# Unix file metadata.
#
# Attribute getters return `nil` when unavailable or inapplicable.
pub class Metadata: fs.Metadata
  # Permissions and file type.
  #[getter]
  pub def mode self -> Mode
    ...

  # Device ID.
  #[getter]
  pub def dev self -> Int
    ...

  # Inode number.
  #[getter]
  pub def ino self -> Int
    ...

  # Hard-link count.
  #[getter]
  pub def nlink self -> Int
    ...

  # Owner user ID.
  #[getter]
  pub def uid self -> Int
    ...

  # Owner group ID.
  #[getter]
  pub def gid self -> Int
    ...

  # Special-device ID.
  #[getter]
  pub def rdev self -> Int
    ...

  # Preferred block size for I/O.
  #[getter]
  pub def blksize self -> Int
    ...

  # Number of allocated 512-byte blocks.
  #[getter]
  pub def blocks self -> Int
    ...

  # Whether the platform hidden flag is set.
  #[getter]
  pub def hidden self -> (Bool | nil)
    ...

  # Whether the platform immutable flag is set.
  #[getter]
  pub def immutable self -> (Bool | nil)
    ...

  # Whether the platform append-only flag is set.
  #[getter]
  pub def append_only self -> (Bool | nil)
    ...

  # Whether the platform no-dump flag is set.
  #[getter]
  pub def no_dump self -> (Bool | nil)
    ...

  # Whether the readonly attribute is set.
  #[getter]
  pub def readonly self -> (Bool | nil)
    ...

  # Whether the system attribute is set.
  #[getter]
  pub def system self -> (Bool | nil)
    ...

  # Whether the archive attribute is set.
  #[getter]
  pub def archive self -> (Bool | nil)
    ...

  # Whether the reparse-point attribute is set.
  #[getter]
  pub def reparse_point self -> (Bool | nil)
    ...

  # Whether the offline attribute is set.
  #[getter]
  pub def offline self -> (Bool | nil)
    ...

  # Raw Linux attribute flags. Linux only.
  #[getter]
  pub def linux_attrs self -> (Int | nil)
    ...

  # Whether the no-atime flag is set. Linux only.
  #[getter]
  pub def no_atime self -> (Bool | nil)
    ...

  # Whether the no-copy-on-write flag is set. Linux
  #[getter]
  pub def no_copy_on_write self -> (Bool | nil)
    ...

  # Whether the synchronous-directory-updates flag
  # is set. Linux only.
  #[getter]
  pub def dir_sync self -> (Bool | nil)
    ...

  # Whether the case-insensitive-directory-lookups
  # flag is set. Linux only.
  #[getter]
  pub def casefold self -> (Bool | nil)
    ...

  # Whether the data-journaling flag is set. Linux
  #[getter]
  pub def data_journaling self -> (Bool | nil)
    ...

  # Whether the don't-compress flag is set. Linux
  #[getter]
  pub def no_compress self -> (Bool | nil)
    ...

  # Whether the project-hierarchy flag is set. Linux
  #[getter]
  pub def project_inherit self -> (Bool | nil)
    ...

  # Whether the secure-deletion flag is set. Linux
  #[getter]
  pub def secure_delete self -> (Bool | nil)
    ...

  # Whether the synchronous-updates flag is set.
  # Linux only.
  #[getter]
  pub def sync self -> (Bool | nil)
    ...

  # Whether the no-tail-merging flag is set. Linux
  #[getter]
  pub def no_tail_merge self -> (Bool | nil)
    ...

  # Whether the top-of-directory-hierarchy flag is
  # set. Linux only.
  #[getter]
  pub def top_dir self -> (Bool | nil)
    ...

  # Whether the undeletable flag is set. Linux only.
  #[getter]
  pub def undelete self -> (Bool | nil)
    ...

  # Whether the direct-access flag is set. Linux
  #[getter]
  pub def direct_access self -> (Bool | nil)
    ...

  # Whether the extent-format flag is set. Linux
  #[getter]
  pub def extent_format self -> (Bool | nil)
    ...

  # Raw macOS file flags. macOS only.
  #[getter]
  pub def macos_attrs self -> (Int | nil)
    ...

  # Whether the opaque flag is set on macOS or FreeBSD.
  #[getter]
  pub def opaque self -> (Bool | nil)
    ...

  # Raw FreeBSD file flags. FreeBSD only.
  #[getter]
  pub def freebsd_attrs self -> (Int | nil)
    ...

  # Owner: the uid as an [`Int`](std.Int) on Unix, or the owner
  # [`Sid`](security.windows.Sid) on Windows.
  #
  # This representation matches the `owner` argument accepted by
  # [`update_metadata`](fs.update_metadata).
  #[getter]
  pub def owner self -> Int
    ...

  # Owning group: the gid as an [`Int`](std.Int) on Unix, or the primary
  # group [`Sid`](security.windows.Sid) on Windows.
  #
  # This representation matches the `group` argument accepted by
  # [`update_metadata`](fs.update_metadata).
  #[getter]
  pub def group self -> Int
    ...
