# dolang: strict
# JSON serialization and deserialization.

import std:
  - @BaseStruct

# Raised when [`decode`](json.decode) is given invalid JSON.
#
# ## Example
#
# ```
# try
#   decode "[1,"
# catch DecodeError: err
#   echo "bad JSON at line $(err.line), column $(err.column)"
# ```
pub class DecodeError: std.DataError
  # What is wrong with the document.
  #
  # | Kind | Meaning |
  # | --- | --- |
  # | `:SYNTAX:` | A character is out of place, or text follows the value. |
  # | `:EOF:` | The document ends inside a value. |
  #[getter]
  pub def kind self -> (:SYNTAX: | :EOF:)
    ...

  # Line of the fault, counting from 1.
  #[getter]
  pub def line self -> Int
    ...

  # Column of the fault, counting from 1.
  #[getter]
  pub def column self -> Int
    ...

# Raised when [`encode`](json.encode) is given a value that can't be written as
# JSON as it stands.
#
# ## Example
#
# ```
# let items = []
# items.push $items
# try
#   encode {items: $items}
# catch EncodeError: err
#   echo "can't encode $(err.path): $err"
# ```
pub class EncodeError: std.ValueError
  # Why the value can't be written.
  #
  # | Kind | Meaning |
  # | --- | --- |
  # | `:CYCLE:` | The value contains itself. |
  # | `:RANGE:` | An `Int` is outside the signed 64-bit range. |
  # | `:KEY:` | A `Float` key is not finite. |
  #[getter]
  pub def kind self -> (:CYCLE: | :RANGE: | :KEY:)
    ...

  # Keys and indices that lead from the encoded value to the fault.
  #
  # For `:CYCLE:` the path leads to the repeated container, for `:RANGE:` to
  # the `Int`, or to the object holding it when it is a key, and for `:KEY:` to
  # the object holding the key. Each key is the one in the encoded value.
  #[getter]
  pub def path self -> Tuple[...(Int | Str | Sym | Float | Bool)]
    ...

# A value decoded from JSON.
pub @let DecodeValue = $
  | nil
  | Bool
  | Int
  | Float
  | Str
  | Array[DecodeValue]
  | Dict[Str, DecodeValue]

# A value that encodes as JSON. An object key may also be a number or boolean,
# which is written as its string form.
pub @let EncodeValue = $
  | nil
  | Bool
  | Int
  | Float
  | Str
  | Sym
  | BaseArray[EncodeValue]
  | Tuple[...EncodeValue]
  | Record[...{*EncodeValue, **EncodeValue}]
  | BaseStruct[{*EncodeValue, **EncodeValue}]
  | BaseDict[Str | Sym | Int | Float | Bool, EncodeValue]

# Deserializes a JSON string to a Do value.
#
# | JSON Type | Do Type |
# | --------- | ------- |
# | `null`    | `nil`   |
# | boolean   | `Bool`  |
# | integer   | `Int`   |
# | float     | `Float` |
# | string    | `Str`   |
# | array     | `Array` |
# | object    | `Dict`  |
#
# An integer that fits neither a signed nor an unsigned 64-bit integer decodes
# as a `Float`.
#
# ## Errors
#
# [`DecodeError`](json.DecodeError) if the JSON is invalid or text follows the
# value.
#
# ## Example
#
# ```playground
# #> import json:
# #>   - decode
# #> import test:
# #>   - assert_eq
# assert_eq (decode "null") nil
# assert_eq (decode "42") 42
# assert_eq (decode "[1, 2, 3]") [1, 2, 3]
#
# let Dict(obj) = decode "{\"name\": \"Alice\", \"age\": 30}"
# assert_eq $obj["name"] "Alice"
# assert_eq $obj["age"] 30
# ```
pub def decode
  # JSON string to parse.
  json @ Str
do -> DecodeValue
  ...

# Serializes a Do value to a JSON string.
#
# | Do Type  | JSON Type            |
# | -------- | -------------------- |
# | `nil`    | `null`               |
# | `Bool`   | boolean              |
# | `Int`    | number               |
# | `Float`  | number               |
# | `Str`    | string               |
# | `Sym`    | string (symbol name) |
# | `Array`  | array                |
# | `Tuple`  | array                |
# | `Dict`   | object               |
# | `Struct` | object               |
# | `Record` | object               |
#
# Object keys are written in the order the dict holds them. A non-finite
# `Float` is written as `null`.
#
# ## Errors
#
# | Exception | Condition |
# | --- | --- |
# | [`TypeError`](std.TypeError) | A value has no JSON form, such as a `Bin`, or a key is not a `Str`, `Sym`, `Int`, `Float`, or `Bool`. |
# | [`EncodeError`](json.EncodeError) | The value contains itself, an `Int` is outside the signed 64-bit range, or a `Float` key is not finite. |
# | [`ValueError`](std.ValueError) | `indent` is negative. |
#
# ## Example
#
# ```
# assert_eq (encode 42) "42"
# assert_eq (encode "hello") "\"hello\""
# assert_eq (encode nil) "null"
# assert_eq (encode [1, 2] indent: 2) "[\n  1,\n  2\n]"
# ```
pub def encode
  # The value to serialize.
  value @ EncodeValue
  # Spaces per level; one line when omitted.
  :indent @ Int = ...
do -> Str
  ...
