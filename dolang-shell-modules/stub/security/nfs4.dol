# dolang: strict
# NFSv4 access-control-list types.

# A symbol naming a bit of a [`Mask`](security.nfs4.Mask).
pub @let MaskBit = $
  # Read the file's data, or list a directory
  | :READ_DATA:
  # Write the file's data, or create a file in a directory
  | :WRITE_DATA:
  # Append to the file's data, or create a subdirectory
  | :APPEND_DATA:
  # Read named attributes
  | :READ_NAMED_ATTRS:
  # Write named attributes
  | :WRITE_NAMED_ATTRS:
  # Execute the file, or traverse a directory
  | :EXECUTE:
  # Delete a file or directory within a directory
  | :DELETE_CHILD:
  # Read basic attributes
  | :READ_ATTRIBUTES:
  # Write basic attributes
  | :WRITE_ATTRIBUTES:
  # Delete the file or directory
  | :DELETE:
  # Read the ACL
  | :READ_ACL:
  # Write the ACL
  | :WRITE_ACL:
  # Change owner and owning group
  | :WRITE_OWNER:
  # Use synchronous I/O
  | :SYNCHRONIZE:

# NFSv4 ACE permission bits.
#
# ## Example
#
# ```
# let rw = Mask :READ_DATA: :WRITE_DATA:
# ```
pub class Mask: Iterable[MaskBit]

  # Constructs a flag set from symbols.
  #[class]
  @def (call) cls ...flags@MaskBit -> Mask

  # Constructs a flag set from one iterable of symbols.
  #[class]
  @def (call) cls flags@Iterable[MaskBit] -> Mask

  #[class]
  pub def (call) cls ...flags @ (MaskBit | Iterable[MaskBit]) -> Mask
    ...

  pub def (init) self ...flags @ (MaskBit | Iterable[MaskBit])
    ...

  # Tests whether all flags named by `flag` are set.
  pub def contains self flag @ MaskBit -> Bool
    ...

  # Returns the flags set in either.
  pub def (bor)[S @ Mask] self@S other@S -> S
    ...

  # Returns the flags set in both.
  pub def (band)[S @ Mask] self@S other@S -> S
    ...

  # Returns the flags set in exactly one.
  pub def (bxor)[S @ Mask] self@S other@S -> S
    ...

  # Returns the flags of the type that are not set.
  pub def (bnot)[S @ Mask] self @ S -> S
    ...


# A symbol naming a flag of a [`Flags`](security.nfs4.Flags).
pub @let FlagBit = $
  # Files created within a directory inherit this entry
  | :FILE_INHERIT:
  # Subdirectories created within a directory inherit this entry
  | :DIRECTORY_INHERIT:
  # Stop propagating this entry after one level of inheritance
  | :NO_PROPAGATE_INHERIT:
  # This entry is inherited but does not apply to the directory itself
  | :INHERIT_ONLY:
  # Generate an audit/alarm event on successful access (`:AUDIT:`/`:ALARM:`
  # entries)
  | :SUCCESSFUL_ACCESS:
  # Generate an audit/alarm event on failed access (`:AUDIT:`/`:ALARM:` entries)
  | :FAILED_ACCESS:
  # This entry was inherited from a parent directory
  | :INHERITED:

# NFSv4 ACE inheritance and audit flags.
#
# ## Example
#
# ```
# let inherit = Flags(:FILE_INHERIT:, :DIRECTORY_INHERIT:)
# ```
pub class Flags: Iterable[FlagBit]

  # Constructs a flag set from symbols.
  #[class]
  @def (call) cls ...flags@FlagBit -> Flags

  # Constructs a flag set from one iterable of symbols.
  #[class]
  @def (call) cls flags@Iterable[FlagBit] -> Flags

  #[class]
  pub def (call) cls ...flags @ (FlagBit | Iterable[FlagBit]) -> Flags
    ...

  pub def (init) self ...flags @ (FlagBit | Iterable[FlagBit])
    ...

  # Tests whether all flags named by `flag` are set.
  pub def contains self flag @ FlagBit -> Bool
    ...

  # Returns the flags set in either.
  pub def (bor)[S @ Flags] self@S other@S -> S
    ...

  # Returns the flags set in both.
  pub def (band)[S @ Flags] self@S other@S -> S
    ...

  # Returns the flags set in exactly one.
  pub def (bxor)[S @ Flags] self@S other@S -> S
    ...

  # Returns the flags of the type that are not set.
  pub def (bnot)[S @ Flags] self @ S -> S
    ...


# The type of an entry.
pub @let AceType = (:ALLOW: | :DENY: | :AUDIT: | :ALARM:)

# Immutable NFSv4 access-control entry.
#
# The class methods below require built [`Mask`](security.nfs4.Mask) and
# [`Flags`](security.nfs4.Flags) values; use [`ace`](security.nfs4.ace) for symbolic mask
# and flag coercion.
#
# ## Example
#
# ```
# let read = Mask(:READ_DATA:, :READ_ATTRIBUTES:)
# Ace.user 1000 type: :ALLOW: mask: $read flags: (Flags(:FILE_INHERIT:))
# ```
pub class Ace
  # Constructs the `OWNER@` entry.
  #[class]
  pub def owner
    self
    # Entry type.
    :type @ AceType
    # Permission mask.
    :mask @ Mask
    # Inheritance/audit flags. Defaults to empty.
    :flags @ Flags = ...
  do -> Ace
    ...

  # Constructs the `GROUP@` entry.
  #[class]
  pub def owning_group
    self
    # Entry type.
    :type @ AceType
    # Permission mask.
    :mask @ Mask
    # Inheritance/audit flags. Defaults to empty.
    :flags @ Flags = ...
  do -> Ace
    ...

  # Constructs the `EVERYONE@` entry.
  #[class]
  pub def everyone
    self
    # Entry type.
    :type @ AceType
    # Permission mask.
    :mask @ Mask
    # Inheritance/audit flags. Defaults to empty.
    :flags @ Flags = ...
  do -> Ace
    ...

  # Constructs a named-user entry.
  #[class]
  pub def user
    self
    # User ID.
    id @ Int
    # Entry type.
    :type @ AceType
    # Permission mask.
    :mask @ Mask
    # Inheritance/audit flags. Defaults to empty.
    :flags @ Flags = ...
  do -> Ace
    ...

  # Constructs a named-group entry.
  #[class]
  pub def group
    self
    # Group ID.
    id @ Int
    # Entry type.
    :type @ AceType
    # Permission mask.
    :mask @ Mask
    # Inheritance/audit flags. Defaults to empty.
    :flags @ Flags = ...
  do -> Ace
    ...

  # Entry type.
  #[getter]
  pub def type self -> AceType
    ...

  # Entry qualifier.
  #[getter]
  pub def principal self -> (:OWNER: | :OWNING_GROUP: | :EVERYONE: | :USER: | :GROUP:)
    ...

  # Numeric user or group ID.
  #
  # Returns `nil` unless
  # [`principal`](security.nfs4.Ace.principal) is `:USER:` or `:GROUP:`.
  #[getter]
  pub def id self -> (Int | nil)
    ...

  # The entry's permission mask.
  #[getter]
  pub def mask self -> Mask
    ...

  # The entry's inheritance/audit flags.
  #[getter]
  pub def flags self -> Flags
    ...

# Immutable NFSv4 access-control list.
#
# Unlike a POSIX.1e ACL, an NFSv4 ACL has no required entries or completeness
# invariant: an empty ACL and any combination of entries construct without
# error.
#
# The constructor accepts only built [`Ace`](security.nfs4.Ace) values; use
# [`acl`](security.nfs4.acl) to mix built entries with declarative dictionaries or
# to pass entries variadically.
pub class Acl
  # Constructs an ACL from an iterable of [`Ace`](security.nfs4.Ace) values, in
  # evaluation order.
  pub def (init)
    self
    # [`Ace`](security.nfs4.Ace) values.
    aces @ Iterable[Ace]
  do
    ...

  # Immutable view of [`Ace`](security.nfs4.Ace)
  # values, in evaluation order. Use `.len` for the entry count.
  #[getter]
  pub def aces self -> Seq[Ace]
    ...

# The principal of an entry: the file owner, owning group, everyone, or a
# user or group ID.
pub @let Principal = $
  | :OWNER:
  | :OWNING_GROUP:
  | :EVERYONE:
  | BaseDict $
      user: Int
  | BaseDict $
      group: Int

# A mask given as a [`Mask`](security.nfs4.Mask), one symbol, or an iterable
# of symbols.
pub @let MaskSpec = (Mask | MaskBit | Iterable[MaskBit])

# Flags given as [`Flags`](security.nfs4.Flags), one symbol, or an iterable of
# symbols.
pub @let FlagsSpec = (Flags | FlagBit | Iterable[FlagBit])

# An NFSv4 entry, built or declared as a dictionary. A dictionary has
# exactly one type key, with the same meaning as the keyword arguments of
# [`ace`](security.nfs4.ace).
pub @let AceSpec = $
  | Ace
  | BaseDict $
      allow: Principal
      mask: MaskSpec
      ?flags: FlagsSpec
  | BaseDict $
      deny: Principal
      mask: MaskSpec
      ?flags: FlagsSpec
  | BaseDict $
      audit: Principal
      mask: MaskSpec
      ?flags: FlagsSpec
  | BaseDict $
      alarm: Principal
      mask: MaskSpec
      ?flags: FlagsSpec

# An NFSv4 ACL, built or given as its entries.
pub @let AclSpec = (Acl | Iterable[AceSpec])

# Constructs an NFSv4 entry from declarative arguments.
#
# Pass exactly one type key. Masks and flags accept their built type, one
# symbol, or an iterable of symbols.
#
# ## Example
#
# ```
# ace allow: :OWNER: mask: [:READ_DATA:, :READ_ACL:]
# ace deny: {user: 1000} mask: :WRITE_DATA:
# ```
pub def ace
  # Principal for an `:ALLOW:` entry.
  :allow @ Principal = ...
  # Principal for a `:DENY:` entry.
  :deny @ Principal = ...
  # Principal for an `:AUDIT:` entry.
  :audit @ Principal = ...
  # Principal for an `:ALARM:` entry.
  :alarm @ Principal = ...
  # Permission mask.
  :mask @ MaskSpec
  # Inheritance/audit flags. Defaults to empty.
  :flags @ FlagsSpec = ...
do -> Ace
  ...

# Constructs an NFSv4 ACL from entries and declarative entry dictionaries.
#
# An empty ACL is valid.
pub def acl
  # Entries, spread with `...`
  # to pass a collection.
  *aces @ AceSpec
do -> Acl
  ...
