# dolang: strict
# Loads and executes Do bytecode and registers runtime import handlers.

# Decoded and verified Do bytecode, produced by [`load`](load.load).
#
# It runs at most once.
pub class Bytecode
  # Executes the bytecode, as [`run`](load.run) does.
  #
  # ## Returns
  #
  # The result of executing the bytecode.
  #
  # ## Errors
  #
  # [`StateError`](std.StateError) if the bytecode has already run.
  #
  # ## Example
  #
  # ```
  # let program = load $ (compile.compile "example.dol" "(1 + 1)").emit()
  # assert_eq $program.run() 2
  # ```
  pub def run
    self
    # Program-specific module importer, called with the requested module name.
    # Input ends immediately and output is discarded while the importer runs.
    :importer @ ((Str, <Value, >Value) -> Value) = ...
    <Iter[Value]
    >Sink[Value]
  do -> Value
    ...

# Raised when bytes are not valid Do bytecode.
#
# [`load`](load.load) and [`run`](load.run) raise it before any of the
# bytecode runs, so a caller can recompile and retry without repeating side
# effects. A program that loads other bytecode can also raise it while running.
#
# ## Example
#
# ```
# try
#   load b"not bytecode"
# catch BytecodeError: err
#   echo "invalid bytecode: $err"
# ```
pub class BytecodeError: std.RuntimeError

# A registered runtime import handler.
pub class ImportHandler
  # Removes this handler from the runtime import handler registry.
  #
  # Calling this more than once has no effect. A callback already running
  # when unregistered has its result discarded.
  #
  # ## Example
  #
  # ```
  # let handle = import_handler do |name|
  #   throw std.ImportError(name)
  # handle.unregister()
  # handle.unregister()
  # ```
  pub def unregister self
    ...

# Imports a module through the VM's ordinary global import resolution.
#
# Use this from a program-specific importer to fall back explicitly to native
# modules, cached modules, and registered import handlers.
#
# ## Returns
#
# The imported module value.
#
# ## Errors
#
# [`ImportError`](std.ImportError) if no global importer accepts `name`.
#
# ## Example
#
# ```
# import load:
#   import: global_import
#
# class Virtual
#   pub field answer = 42
#
# let importer = do |name|
#   if (name == "virtual")
#     Virtual()
#   else
#     global_import $name
#
# load.run $bytecode importer: $importer
# ```
pub def import
  # Module name to import.
  name @ Str
do -> Value
  ...

# Registers a module import handler.
#
# A resolution considers the handlers registered when it starts. Handlers
# registered during a callback participate in subsequent resolutions.
#
# Handlers run after native modules and cached Do modules. The first successful
# handler supplies the imported value. Raise [`ImportError`](std.ImportError)
# to decline a name; any other error aborts the import.
#
# ## Example
#
# ```
# class Demo
#   pub field answer = 42
#
# let handle = import_handler do |name|
#   if (name == "demo")
#     Demo()
#   else
#     throw std.ImportError(name)
#
# import demo
# assert_eq $demo.answer 42
# handle.unregister()
# ```
pub def import_handler
  # Called with the requested module name. Input ends immediately and output
  # is discarded while the handler runs.
  callback @ ((Str, <Value, >Value) -> Value)
do -> ImportHandler
  ...

# Decodes and verifies compiled Do bytecode without running it.
#
# ## Errors
#
# [`BytecodeError`](load.BytecodeError) if `bytecode` is not valid Do
# bytecode.
#
# ## Example
#
# ```
# let program = load $ (compile.compile "example.dol" "(1 + 1)").emit()
# assert_eq $program.run() 2
# ```
pub def load
  # Compiled Do bytecode.
  bytecode @ Bin
do -> Bytecode
  ...

# Executes compiled Do bytecode.
#
# The loaded program uses the caller's input and output. Imports run with input
# ended and output discarded, including code executed by their importers.
#
# The optional importer belongs to the loaded program and remains active for
# retained functions and modules. Imports call it directly, bypassing native
# modules, caching, and registered handlers. Results are not cached, and an
# `ImportError` does not trigger automatic fallback.
#
# ## Returns
#
# The result of executing the bytecode.
#
# ## Errors
#
# | Exception | Condition |
# | --- | --- |
# | [`BytecodeError`](load.BytecodeError) | `bytecode` is a [`Bin`](std.Bin) that is not valid Do bytecode |
# | [`StateError`](std.StateError) | `bytecode` is a [`Bytecode`](load.Bytecode) that has already run |
#
# ## Example
#
# ```
# let result = run $ (compile.compile "example.dol" "(1 + 1)").emit()
# assert_eq $result 2
# ```
pub def run
  # Compiled Do bytecode, or bytecode already decoded by [`load`](load.load).
  bytecode @ (Bin | Bytecode)
  # Program-specific module importer, called with the requested module name.
  # Input ends immediately and output is discarded while the importer runs.
  :importer @ ((Str, <Value, >Value) -> Value) = ...
  <Iter[Value]
  >Sink[Value]
do -> Value
  ...
