# dolang: strict
# Parses, edits, and serializes XML documents.

import std:
  - @IndexItem

# A child of an XML element.
pub @let Node = (Element | Comment | Str)

# An XML element: a name, attributes, and children.
#
# An element has no link to a parent, so the same element can appear in several
# trees.
#
# Attribute keys are local-name strings or `(namespace_uri, local_name)`
# tuples. Tuple namespaces are URIs, not prefixes. Serialization uses a prefix
# declared by [`namespaces`](xml.Element.namespaces) on the element or an ancestor,
# and otherwise makes an element's namespace the default or generates a prefix.
#
# Changes are checked as they are made, so any tree without a cycle can be
# serialized inside a document. Setting an invalid name, an empty namespace, or
# the `xmlns` namespace raises `ValueError`, as does adding text or an attribute
# value containing a character XML forbids.
pub class Element: @Index[{*(Str | (Str, Str)): Str, *Node}] @Assign[Str | (Str, Str), Str] @Spread[Node]
  # Creates an element, optionally with attributes and children.
  #
  # ## Errors
  #
  # [`ValueError`](std.ValueError) if a name, string, or namespace declaration
  # is invalid, or two attributes have the same expanded name.
  #
  # ## Example
  #
  # ```
  # let item = Element item namespace: "urn:inventory" namespaces: {inv: "urn:inventory"}
  # let disk = Element disk
  #   attrs:
  #     type: file
  #     device: disk
  #   - $ Element driver attrs: {name: "qemu", type: "qcow2"}
  # ```
  pub def (init)
    self
    # Local element name.
    tag @ Str
    # Namespace URI.
    :namespace @ Str = ...
    # Initial [`namespaces`](xml.Element.namespaces), with `Sym` or `Str` keys.
    :namespaces @ BaseDict[Sym | Str, Str] = ...
    # Attributes; bareword keys name unnamespaced attributes.
    :attrs @ BaseDict[Sym | Str | (Str, Str), Str] = ...
    # Children in document order.
    *items @ Node
  do
    ...

  # Mutable map of attribute values by expanded name, in document order.
  #
  # Keys are local-name strings or `(namespace_uri, local_name)` tuples.
  # Setting an existing attribute keeps its position.
  #
  # ## Example
  #
  # ```
  # node.attrs[("urn:inventory", "id")] = "123"
  # let id = node.attrs.get ("urn:inventory", "id")
  # ```
  #[getter]
  pub def attrs self -> MutMap[Str | (Str, Str), Str]
    ...

  # Mutable array-like view of child values in document order.
  #
  # Iterating a node iterates this view directly.
  #[getter]
  pub def children self -> MutSeq[Node]
    ...

  # Mutable namespace URI, or `nil` for no namespace.
  pub field namespace @ (Str | nil) = ...

  # Mutable map of the namespace declarations this element makes itself.
  #
  # Keys are prefix strings; `""` is the default namespace. Serialization
  # declares these, uses them to spell names in this element's subtree, and
  # adds whatever else those names need. Declarations choose prefixes, and are
  # required for prefixes used in content, such as attribute values naming a
  # qualified type. A parsed element holds the declarations written on it, not
  # those it inherits.
  #
  # Declaring a binding XML forbids, such as a prefix for an empty URI or
  # another prefix for the XML namespace, raises `ValueError`.
  #[getter]
  pub def namespaces self -> MutMap[Str, Str]
    ...

  # Mutable local element name.
  pub field tag @ Str = ...

  # Appends a child.
  pub def push
    self
    # Child value.
    child @ Node
  do
    ...

  # Returns a depth-first, parent-first iterator over this node and descendants.
  pub def traverse self -> Iter[Node]
    ...

  # Reads an attribute by string or namespace/name tuple, or a child by integer index.
  #
  # Negative integer indexes count from the end.
  @def (index)[K] self key@K -> IndexItem[{*(Str | (Str, Str)): Str, *Node}, K]
  @def (index) self range@Range[Int] -> Array[Node]
  pub def (index)[K] self key@K -> IndexItem[{*(Str | (Str, Str)): Str, *Node}, K]
    ...

  # Sets an attribute by string or namespace/name tuple, adding it if missing.
  pub def (assign) self key@(Str | (Str, Str)) value@Str
    ...

  # Iterates the children.
  pub def (iter) self -> Iter[Node]
    ...

  # Spreads the children positionally.
  pub def (spread) self -> Spread[Node]
    ...

# Holds an XML comment body without markup delimiters.
#
# String coercion returns the body. Debug coercion identifies the comment.
# Invalid XML characters, embedded `--`, and a final `-` raise `ValueError`.
pub class Comment
  pub def (init) self text @ Str
    ...

  # Mutable comment body, checked before assignment.
  pub field text @ Str = ...

# Holds a complete XML document with exactly one root element.
#
# Children may be elements, comments, or XML whitespace strings. Exactly one
# child must be an element. Invalid child types raise `TypeError`; invalid
# text or a root count other than one raises `ValueError`.
pub class Document
  pub def (init) self *children @ Node
    ...

  # Mutable view of the document's children in order.
  #
  # Removing the root or clearing the view raises `StateError`. Replacement
  # and insertion must preserve exactly one root or raise `ValueError`.
  # Failed operations leave the children unchanged.
  #[getter]
  pub def children self -> MutSeq[Node]
    ...

  # The root element. Assignment replaces it in place.
  pub field root @ Element = ...

# Parses a complete XML document, preserving comments and whitespace.
#
# Predefined entities and numeric character references are expanded. Custom
# DTD entities are not resolved. Invalid documents raise `ValueError`.
pub def decode xml @ Str -> Document
  ...

# Serializes a complete XML document.
#
# Namespace spelling may differ while preserving expanded names.
# Cycles raise `ValueError`.
#
# ## Example
#
# ```
# let doc = Document (Element "greeting" "hello")
# assert_eq (encode doc) "<greeting>hello</greeting>"
# ```
pub def encode document @ Document -> Str
  ...
