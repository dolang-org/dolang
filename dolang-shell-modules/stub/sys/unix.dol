# dolang: strict
# The `sys.unix` module exposes Unix-specific system types.
import sys

# A Unix operating system.
pub @let Os = $
  # Linux
  | :LINUX:
  # macOS
  | :MACOS:
  # FreeBSD
  | :FREEBSD:

# [`sys.ErrorCode`](sys.ErrorCode) originating from a Unix system.
pub class Errno: sys.ErrorCode
  # The originating operating system.
  #[getter]
  pub def os self -> Os
    ...
