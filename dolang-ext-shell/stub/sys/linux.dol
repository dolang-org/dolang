# The `sys.linux` module exposes Linux-specific system types.

import sys.unix

# [`sys.unix.Errno`](sys.unix.Errno) originating from Linux.
pub class Errno: sys.unix.Errno
  # Creates a Linux error number.
  #
  # Known codes are available as class fields such as `Errno.ENOENT`.
  pub def (init)
    self
    # Raw error number.
    value @ Int
  do
    ...

  # The originating operating system, `:LINUX:`.
  #[getter]
  pub def os self
    ...
