# The `sys.freebsd` module exposes FreeBSD-specific system types.

import sys.unix

# [`sys.unix.Errno`](sys.unix.Errno) originating from FreeBSD.
pub class Errno: sys.unix.Errno
  # Creates a FreeBSD error number.
  #
  # Known codes are available as class fields such as `Errno.ENOENT`.
  pub def (init)
    self
    # Raw error number.
    value @ Int
  do
    ...

  # The originating operating system, `:FREEBSD:`.
  #[getter]
  pub def os self
    ...
