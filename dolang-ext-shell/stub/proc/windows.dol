# Encodes and decodes arguments for Windows native process launches.
#
# These functions follow the MSVC-compatible convention used by Rust process
# launching; they do not parse `cmd.exe` or PowerShell syntax.

# Encodes an iterable of arguments as one Windows process command line.
#
# ## Errors
#
# | Exception                            | Condition                            |
# | ------------------------------------ | ------------------------------------ |
# | [`ValueError`](std.ValueError) | A value contains a NUL character     |
#
# ## Example
#
# ```
# assert_eq (join ["program", "two words"]) r#"program "two words""#
# ```
pub def join
  # Values, each converted to a string as
  # [`std.verbatim`](std.verbatim) would.
  iterable @ Iterable[Value]
do -> Str
  ...

# Encodes one argument for a Windows process command line.
#
# ## Errors
#
# | Exception                             | Condition                          |
# | ------------------------------------- | ---------------------------------- |
# | [`ValueError`](std.ValueError) | The argument contains a NUL character |
#
# ## Example
#
# ```
# assert_eq (quote "two words") r#""two words""#
# ```
pub def quote
  # Value to quote, converted to a string as
  # [`std.verbatim`](std.verbatim) would.
  arg
do -> Str
  ...

# Decodes a Windows process command line into its arguments.
#
# ## Errors
#
# | Exception                           | Condition                                 |
# | ----------------------------------- | ----------------------------------------- |
# | [`TypeError`](std.TypeError) | `command_line` is not a `Str`             |
#
# ## Example
#
# ```
# assert_eq [...(split r#"program "two words""#)] ["program", "two words"]
# ```
pub def split
  # Command line to decode.
  command_line @ Str
do -> Iter[Str]
  ...
