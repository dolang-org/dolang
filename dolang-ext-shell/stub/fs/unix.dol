# Unix filesystem types.

import
  security.unix:
    - @Permission
  std:
    - @FlagSet

# A symbol naming bits of a [`Mode`](fs.unix.Mode).
#
# | Symbol            | Meaning                 |
# | ----------------- | ----------------------- |
# | `:OWNER_READ:`    | Owner may read          |
# | `:OWNER_WRITE:`   | Owner may write         |
# | `:OWNER_EXECUTE:` | Owner may execute       |
# | `:GROUP_READ:`    | Group may read          |
# | `:GROUP_WRITE:`   | Group may write         |
# | `:GROUP_EXECUTE:` | Group may execute       |
# | `:OTHER_READ:`    | Everyone may read       |
# | `:OTHER_WRITE:`   | Everyone may write      |
# | `:OTHER_EXECUTE:` | Everyone may execute    |
# | `:SET_UID:`       | Set user ID on execute  |
# | `:SET_GID:`       | Set group ID on execute |
# | `:STICKY:`        | Sticky bit              |
# | `:IFREG:`         | Regular file            |
# | `:IFDIR:`         | Directory               |
# | `:IFLNK:`         | Symbolic link           |
# | `:IFIFO:`         | FIFO                    |
# | `:IFCHR:`         | Character device        |
# | `:IFBLK:`         | Block device            |
# | `:IFSOCK:`        | Socket                  |
pub @let ModeBit = (
  | :OWNER_READ: | :OWNER_WRITE: | :OWNER_EXECUTE:
  | :GROUP_READ: | :GROUP_WRITE: | :GROUP_EXECUTE:
  | :OTHER_READ: | :OTHER_WRITE: | :OTHER_EXECUTE:
  | :SET_UID: | :SET_GID: | :STICKY:
  | :IFREG: | :IFDIR: | :IFLNK: | :IFIFO: | :IFCHR: | :IFBLK: | :IFSOCK:
)

# Unix `st_mode` bits: permissions, the set-user-ID/set-group-ID/sticky bits,
# and the file type.
#
# ## Example
#
# Reading a file's mode and applying it elsewhere:
#
# ```
# let mode = metadata("template.sh").mode
# update_metadata "script.sh" mode: $mode
# ```
#
# ```
# let rw = Mode(:OWNER_READ:, :OWNER_WRITE:)
# ```
pub class Mode: Iterable[ModeBit] @FlagSet[ModeBit]
  # Constructs a mode from a raw `st_mode` value, preserving unknown bits.
  #
  # ## Example
  #
  # ```
  # let mode = Mode.from_int 0o644
  # ```
  #[class]
  pub def from_int
    self
    # Raw mode bits.
    value @ Int
  do -> Mode
    ...

  # Owner
  # permissions.
  #[getter]
  pub def owner self -> Permission
    ...

  # Group
  # permissions.
  #[getter]
  pub def group self -> Permission
    ...

  # Permissions for everyone else.
  #[getter]
  pub def other self -> Permission
    ...

  # The raw `st_mode` value, including the file type
  # bits.
  #
  # Mask with `0o7777` for the permission bits alone.
  #
  # ```
  # let mode = metadata("script.sh").mode
  # assert_eq (mode.int & 0o7777) 0o755
  # ```
  #[getter]
  pub def int self -> Int
    ...

# [`fs.Path`](fs.Path) using Unix path syntax.
#
# See [`fs.Path`](fs.Path) for fields, methods, and operators.
pub class Path
  # Converts a string or another path to a Unix path.
  #
  # Converting a Windows path is allowed only when it is relative and has no
  # root, prefix, or alternate data stream.
  pub def (init)
    self
    # Path value.
    path @ (Str | Path)
  do
    ...
