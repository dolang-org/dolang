    ...

  # Native object entry flags.
  #[getter]
  pub def object_flags self -> Int
    ...

  # The object type, or `nil` when its object flag is clear.
  #[getter]
  pub def object_type self -> (Guid | nil)
    ...

  # Constructs a qualified entry from built components.
  #
  # Audit and alarm entries require at least one selected outcome.
  # Allow and deny entries reject outcome arguments.
  # Object layout is used even when neither GUID is supplied.
  pub def (init)
    self
    :qualifier @ AceQualifier
    :sid @ Sid
    :mask @ AccessMask
    :flags @ AceFlags = nil
    :callback @ Bool = nil
    :application_data @ Bin = nil
    :successful @ Bool = nil
    :failed @ Bool = nil
    :object_type @ Guid = nil
    :inherited_object_type @ Guid = nil
  do
    ...

