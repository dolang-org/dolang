# Constructs an [`Ace`](security.windows.Ace) from declarative arguments.
#
# Exactly one of `allow`, `deny`, or `audit` names the trustee.
#
# ## Errors
#
# `ValueError` if zero or several trustees are given, if an audit entry has no
# outcome, or if `successful` or `failed` is given for an allow or deny entry.
#
# ## Example
#
# ```
# let entry = ace
#   deny: :EVERYONE:
#   mask: :GENERIC_WRITE:
# ```
pub def ace
  # Trustee of an access-allowed entry.
  :allow @ SidSpec = nil
  # Trustee of an access-denied entry.
  :deny @ SidSpec = nil
  # Trustee of a system-audit entry.
  :audit @ SidSpec = nil
  # Access mask.
  :mask @ AccessMaskSpec
  # ACE header flags, other than the audit outcomes.
  :flags @ AceFlagsSpec = nil
  # Object type, making this an object entry.
  :object_type @ (Guid | Str | Bin) = nil
  # Inherited object type, making this an object entry.
  :inherited_object_type @ (Guid | Str | Bin) = nil
  # Build a callback entry.
  :callback @ Bool = nil
  # Trailing application data, zero-padded to 32-bit alignment.
  :application_data @ Bin = nil
  # Audit successful access.
  :successful @ Bool = nil
  # Audit failed access.
  :failed @ Bool = nil
do -> Ace
  ...

# Constructs an [`Acl`](security.windows.Acl) from entries and entry
# dictionaries.
#
# ## Example
#
# ```
# let dacl = acl
#   - allow: :LOCAL_SYSTEM:
#     mask: :GENERIC_ALL:
#   - allow: :BUILTIN_ADMINISTRATORS:
#     mask: :GENERIC_ALL:
# ```
pub def acl
  # Native ACL revision. Defaults to the lowest revision the entries allow.
  :revision @ (AclRevision | Int) = nil
  # Entries in packet order, spread with `...` to pass a collection.
  ...aces @ AceSpec
do -> Acl
  ...

# Constructs a [`SecDesc`](security.windows.SecDesc) from a descriptor,
# components, or both.
#
# Given both, the components amend `desc` the way
# [`SecDesc.with`](security.windows.SecDesc.with) does. The `update_sec_desc`
# functions of other modules take the same arguments.
#
# ## Errors
#
# `ValueError` if neither a descriptor nor any component is given.
#
# ## Example
#
# ```
# let descriptor = sec_desc
#   owner: :BUILTIN_ADMINISTRATORS:
#   dacl_protected: true
#   dacl:
#     - allow: :LOCAL_SYSTEM:
#       mask: :GENERIC_ALL:
#
# let unprotected = sec_desc $descriptor dacl_protected: false
# ```
pub def sec_desc
  # Descriptor to start from.
  desc @ SecDescSpec = nil
  # Owner, or `nil` for an absent owner.
  :owner @ (SidSpec | nil) = nil
  # Primary group, or `nil` for an absent group.
  :group @ (SidSpec | nil) = nil
  # Discretionary ACL, or `nil` for a present null ACL.
  :dacl @ (AclSpec | nil) = nil
  # System ACL, or `nil` for a present null ACL.
  :sacl @ (AclSpec | nil) = nil
  # Owner defaulted flag.
  :owner_defaulted @ Bool = nil
  # Group defaulted flag.
  :group_defaulted @ Bool = nil
  # DACL presence. `false` clears the DACL of `desc`.
  :dacl_present @ Bool = nil
  # DACL defaulted flag.
  :dacl_defaulted @ Bool = nil
  # DACL inheritance request.
  :dacl_auto_inherit_required @ Bool = nil
  # DACL inherited flag.
  :dacl_auto_inherited @ Bool = nil
  # DACL protection.
  :dacl_protected @ Bool = nil
  # SACL presence. `false` clears the SACL of `desc`.
  :sacl_present @ Bool = nil
  # SACL defaulted flag.
  :sacl_defaulted @ Bool = nil
  # SACL inheritance request.
  :sacl_auto_inherit_required @ Bool = nil
  # SACL inherited flag.
  :sacl_auto_inherited @ Bool = nil
  # SACL protection.
  :sacl_protected @ Bool = nil
  # Resource-manager control byte, or `nil` to clear it.
  :rm_control @ (Int | nil) = nil
do -> SecDesc
  ...

# Returns Windows token information captured for the active VFS context.
#
# ## Errors
#
# [`UnsupportedError`](std.UnsupportedError) if the active VFS target is Unix.
#
# ## Example
#
# ```
# if token_info().is_elevated
#   echo elevated
# ```
pub def token_info() -> TokenInfo
  ...
