# Windows security identifiers, access-control lists, and security
# descriptors.
#
# Security descriptors, ACLs, and ACEs each have a declarative form accepted in
# place of a built value: [`SecDescSpec`](security.windows.SecDescSpec),
# [`AclSpec`](security.windows.AclSpec), and
# [`AceSpec`](security.windows.AceSpec). The lowercase [`sec_desc`](security.windows.sec_desc),
# [`acl`](security.windows.acl), and [`ace`](security.windows.ace) functions
# build values from them, as do the `update_sec_desc` functions of other
# modules. The type constructors are strict and accept only built components.
#
# ```
# let descriptor = sec_desc
#   owner: :BUILTIN_ADMINISTRATORS:
#   dacl_protected: true
#   dacl:
#     - allow: :LOCAL_SYSTEM:
#       mask: :GENERIC_ALL:
#     - allow: :BUILTIN_USERS:
#       mask: :GENERIC_READ:
#       flags: [:OBJECT_INHERIT:, :CONTAINER_INHERIT:]
# ```

import uuid:
  - @Guid

# A SID that is the same on every Windows installation, so naming one takes no
# lookup.
#
# SIDs that are relative to a domain or a machine, such as `Domain Admins`
# (`S-1-5-21-<domain>-512`) or the local `Administrator` account, have no
# symbol: resolving one requires querying the system. The SDDL column is the
# two-letter alias the same SID has in an SDDL string, for readers porting one;
# those aliases are not accepted as symbols.
#
# | Symbol                                  | SID            | SDDL | Account or group                    |
# | --------------------------------------- | -------------- | ---- | ----------------------------------- |
# | `:NULL:`                                | `S-1-0-0`      |      | Null SID                            |
# | `:EVERYONE:`                            | `S-1-1-0`      | `WD` | Everyone                            |
# | `:LOCAL:`                               | `S-1-2-0`      |      | Local logon                         |
# | `:CONSOLE_LOGON:`                       | `S-1-2-1`      |      | Console logon                       |
# | `:CREATOR_OWNER:`                       | `S-1-3-0`      | `CO` | Creator owner                       |
# | `:CREATOR_GROUP:`                       | `S-1-3-1`      | `CG` | Creator group                       |
# | `:OWNER_RIGHTS:`                        | `S-1-3-4`      | `OW` | Owner rights                        |
# | `:DIALUP:`                              | `S-1-5-1`      |      | Dialup                              |
# | `:NETWORK:`                             | `S-1-5-2`      | `NU` | Network logon                       |
# | `:BATCH:`                               | `S-1-5-3`      | `BU` | Batch logon                         |
# | `:INTERACTIVE:`                         | `S-1-5-4`      | `IU` | Interactive logon                   |
# | `:SERVICE:`                             | `S-1-5-6`      | `SU` | Service logon                       |
# | `:ANONYMOUS:`                           | `S-1-5-7`      | `AN` | Anonymous logon                     |
# | `:PRINCIPAL_SELF:`                      | `S-1-5-10`     | `PS` | Principal self                      |
# | `:AUTHENTICATED_USERS:`                 | `S-1-5-11`     | `AU` | Authenticated users                 |
# | `:RESTRICTED_CODE:`                     | `S-1-5-12`     | `RC` | Restricted code                     |
# | `:REMOTE_INTERACTIVE_LOGON:`            | `S-1-5-14`     |      | Remote interactive logon            |
# | `:THIS_ORGANIZATION:`                   | `S-1-5-15`     |      | This organization                   |
# | `:LOCAL_SYSTEM:`                        | `S-1-5-18`     | `SY` | Local system                        |
# | `:LOCAL_SERVICE:`                       | `S-1-5-19`     | `LS` | Local service                       |
# | `:NETWORK_SERVICE:`                     | `S-1-5-20`     | `NS` | Network service                     |
# | `:LOCAL_ACCOUNT:`                       | `S-1-5-113`    |      | Any local account                   |
# | `:LOCAL_ACCOUNT_ADMINISTRATOR:`         | `S-1-5-114`    |      | Local account in Administrators     |
# | `:BUILTIN_ADMINISTRATORS:`              | `S-1-5-32-544` | `BA` | BUILTIN\\Administrators              |
# | `:BUILTIN_USERS:`                       | `S-1-5-32-545` | `BU` | BUILTIN\\Users                       |
# | `:BUILTIN_GUESTS:`                      | `S-1-5-32-546` | `BG` | BUILTIN\\Guests                      |
# | `:BUILTIN_POWER_USERS:`                 | `S-1-5-32-547` | `PU` | BUILTIN\\Power Users                 |
# | `:BUILTIN_BACKUP_OPERATORS:`            | `S-1-5-32-551` | `BO` | BUILTIN\\Backup Operators            |
# | `:BUILTIN_REMOTE_DESKTOP_USERS:`        | `S-1-5-32-555` | `RD` | BUILTIN\\Remote Desktop Users        |
# | `:BUILTIN_REMOTE_MANAGEMENT_USERS:`     | `S-1-5-32-580` | `RM` | BUILTIN\\Remote Management Users     |
# | `:ALL_APPLICATION_PACKAGES:`            | `S-1-15-2-1`   | `AC` | All application packages            |
# | `:ALL_RESTRICTED_APPLICATION_PACKAGES:` | `S-1-15-2-2`   |      | All restricted application packages |
# | `:UNTRUSTED_LABEL:`                     | `S-1-16-0`     |      | Untrusted integrity level           |
# | `:LOW_LABEL:`                           | `S-1-16-4096`  | `LW` | Low integrity level                 |
# | `:MEDIUM_LABEL:`                        | `S-1-16-8192`  | `ME` | Medium integrity level              |
# | `:MEDIUM_PLUS_LABEL:`                   | `S-1-16-8448`  | `MP` | Medium-plus integrity level         |
# | `:HIGH_LABEL:`                          | `S-1-16-12288` | `HI` | High integrity level                |
# | `:SYSTEM_LABEL:`                        | `S-1-16-16384` | `SI` | System integrity level              |
pub @let WellKnownSid = (
  | :NULL: | :EVERYONE: | :LOCAL: | :CONSOLE_LOGON: | :CREATOR_OWNER:
  | :CREATOR_GROUP: | :OWNER_RIGHTS: | :DIALUP: | :NETWORK: | :BATCH:
  | :INTERACTIVE: | :SERVICE: | :ANONYMOUS: | :PRINCIPAL_SELF:
  | :AUTHENTICATED_USERS: | :RESTRICTED_CODE: | :REMOTE_INTERACTIVE_LOGON:
  | :THIS_ORGANIZATION: | :LOCAL_SYSTEM: | :LOCAL_SERVICE: | :NETWORK_SERVICE:
  | :LOCAL_ACCOUNT: | :LOCAL_ACCOUNT_ADMINISTRATOR: | :BUILTIN_ADMINISTRATORS:
  | :BUILTIN_USERS: | :BUILTIN_GUESTS: | :BUILTIN_POWER_USERS:
  | :BUILTIN_BACKUP_OPERATORS: | :BUILTIN_REMOTE_DESKTOP_USERS:
  | :BUILTIN_REMOTE_MANAGEMENT_USERS: | :ALL_APPLICATION_PACKAGES:
  | :ALL_RESTRICTED_APPLICATION_PACKAGES: | :UNTRUSTED_LABEL: | :LOW_LABEL:
  | :MEDIUM_LABEL: | :MEDIUM_PLUS_LABEL: | :HIGH_LABEL: | :SYSTEM_LABEL:
)

# A SID, built or spelled as its canonical string, its native packet, or a
# well-known SID.
pub @let SidSpec = (Sid | Str | Bin | WellKnownSid)

# The identifier authority of a SID.
#
# | Symbol               | Authority           |
# | -------------------- | ------------------- |
# | `:NULL:`             | Null                |
# | `:WORLD:`            | World               |
# | `:LOCAL:`            | Local               |
# | `:CREATOR:`          | Creator             |
# | `:NON_UNIQUE:`       | Non-unique          |
# | `:NT:`               | NT                  |
# | `:RESOURCE_MANAGER:` | Resource manager    |
# | `:APP_PACKAGE:`      | Application package |
# | `:MANDATORY_LABEL:`  | Mandatory label     |
# | `:SCOPED_POLICY:`    | Scoped policy ID    |
# | `:AUTHENTICATION:`   | Authentication      |
# | `:PROCESS_TRUST:`    | Process trust       |
pub @let IdentifierAuthority = (
  | :NULL: | :WORLD: | :LOCAL: | :CREATOR: | :NON_UNIQUE: | :NT:
  | :RESOURCE_MANAGER: | :APP_PACKAGE: | :MANDATORY_LABEL: | :SCOPED_POLICY:
  | :AUTHENTICATION: | :PROCESS_TRUST:
)

# How Windows classifies a resolved SID.
#
# | Value                | Meaning                       |
# | -------------------- | ----------------------------- |
# | `:USER:`             | User SID                      |
# | `:GROUP:`            | Group SID                     |
# | `:DOMAIN:`           | Domain SID                    |
# | `:ALIAS:`            | Alias SID                     |
# | `:WELL_KNOWN_GROUP:` | Well-known group SID          |
# | `:DELETED_ACCOUNT:`  | Deleted account SID           |
# | `:INVALID:`          | Invalid SID                   |
# | `:UNKNOWN:`          | SID of an unknown type        |
# | `:COMPUTER:`         | Computer SID                  |
# | `:LABEL:`            | Mandatory integrity label SID |
# | `:LOGON_SESSION:`    | Logon session SID             |
pub @let SidNameUse = (
  | :USER: | :GROUP: | :DOMAIN: | :ALIAS: | :WELL_KNOWN_GROUP:
  | :DELETED_ACCOUNT: | :INVALID: | :UNKNOWN: | :COMPUTER: | :LABEL:
  | :LOGON_SESSION:
)

# A native ACE type, or `:UNKNOWN:` for an unrecognized type code.
#
# | Code | Symbol                             |
# | ---- | ---------------------------------- |
# | 0    | `:ACCESS_ALLOWED:`                 |
# | 1    | `:ACCESS_DENIED:`                  |
# | 2    | `:SYSTEM_AUDIT:`                   |
# | 3    | `:SYSTEM_ALARM:`                   |
# | 4    | `:ACCESS_ALLOWED_COMPOUND:`        |
# | 5    | `:ACCESS_ALLOWED_OBJECT:`          |
# | 6    | `:ACCESS_DENIED_OBJECT:`           |
# | 7    | `:SYSTEM_AUDIT_OBJECT:`            |
# | 8    | `:SYSTEM_ALARM_OBJECT:`            |
# | 9    | `:ACCESS_ALLOWED_CALLBACK:`        |
# | 10   | `:ACCESS_DENIED_CALLBACK:`         |
# | 11   | `:ACCESS_ALLOWED_CALLBACK_OBJECT:` |
# | 12   | `:ACCESS_DENIED_CALLBACK_OBJECT:`  |
# | 13   | `:SYSTEM_AUDIT_CALLBACK:`          |
# | 14   | `:SYSTEM_ALARM_CALLBACK:`          |
# | 15   | `:SYSTEM_AUDIT_CALLBACK_OBJECT:`   |
# | 16   | `:SYSTEM_ALARM_CALLBACK_OBJECT:`   |
# | 17   | `:SYSTEM_MANDATORY_LABEL:`         |
# | 18   | `:SYSTEM_RESOURCE_ATTRIBUTE:`      |
# | 19   | `:SYSTEM_SCOPED_POLICY_ID:`        |
# | 20   | `:SYSTEM_PROCESS_TRUST_LABEL:`     |
# | 21   | `:SYSTEM_ACCESS_FILTER:`           |
pub @let AceType = (
  | :ACCESS_ALLOWED: | :ACCESS_DENIED: | :SYSTEM_AUDIT: | :SYSTEM_ALARM:
  | :ACCESS_ALLOWED_COMPOUND: | :ACCESS_ALLOWED_OBJECT: | :ACCESS_DENIED_OBJECT:
  | :SYSTEM_AUDIT_OBJECT: | :SYSTEM_ALARM_OBJECT: | :ACCESS_ALLOWED_CALLBACK:
  | :ACCESS_DENIED_CALLBACK: | :ACCESS_ALLOWED_CALLBACK_OBJECT:
  | :ACCESS_DENIED_CALLBACK_OBJECT: | :SYSTEM_AUDIT_CALLBACK:
  | :SYSTEM_ALARM_CALLBACK: | :SYSTEM_AUDIT_CALLBACK_OBJECT:
  | :SYSTEM_ALARM_CALLBACK_OBJECT: | :SYSTEM_MANDATORY_LABEL:
  | :SYSTEM_RESOURCE_ATTRIBUTE: | :SYSTEM_SCOPED_POLICY_ID:
  | :SYSTEM_PROCESS_TRUST_LABEL: | :SYSTEM_ACCESS_FILTER: | :UNKNOWN:
)

# A named ACL revision. A native revision number is accepted wherever one of
# these is.
pub @let AclRevision = (:BASIC: | :DIRECTORY_SERVICE:)

# An access mask, built or given as right symbols or native bits. A subtype
# such as [`winreg.AccessMask`](winreg.AccessMask) is accepted too.
pub @let AccessMaskSpec = (AccessMask | Int | Sym | Iterable[Sym])

# ACE header flags, built or given as flag symbols or native bits.
pub @let AceFlagsSpec = (AceFlags | Int | Sym | Iterable[Sym])

# An ACE, built or given as a dictionary.
#
# A dictionary names its trustee under exactly one of `allow:`, `deny:`, or
# `audit:`, and takes the other arguments of [`ace`](security.windows.ace) as
# keys.
#
# ```
# $
#   allow: :BUILTIN_ADMINISTRATORS:
#   mask: :GENERIC_ALL:
#   flags: [:OBJECT_INHERIT:, :CONTAINER_INHERIT:]
# ```
pub @let AceSpec = (
  | Ace
  | Dict[{
    allow: SidSpec, mask: AccessMaskSpec, ?flags: AceFlagsSpec,
    ?object_type: (Guid | Str | Bin), ?inherited_object_type: (Guid | Str | Bin),
    ?callback: Bool, ?application_data: Bin,
  }]
  | Dict[{
    deny: SidSpec, mask: AccessMaskSpec, ?flags: AceFlagsSpec,
    ?object_type: (Guid | Str | Bin), ?inherited_object_type: (Guid | Str | Bin),
    ?callback: Bool, ?application_data: Bin,
  }]
  | Dict[{
    audit: SidSpec, mask: AccessMaskSpec, ?flags: AceFlagsSpec,
    ?object_type: (Guid | Str | Bin), ?inherited_object_type: (Guid | Str | Bin),
    ?callback: Bool, ?application_data: Bin, ?successful: Bool, ?failed: Bool,
  }]
)

# An ACL, built or given as its entries in packet order.
#
# A dictionary holds the entries positionally and may add a `revision:` key.
#
# ```
# $
#   revision: :DIRECTORY_SERVICE:
#   - allow: $group.sid
#     mask: :GENERIC_ALL:
#     object_type: $schema_guid
# ```
pub @let AclSpec = (
  | Acl
  | Iterable[AceSpec]
  | Dict[{...AceSpec, ?revision: (AclRevision | Int)}]
)

# A security descriptor, built, given as a self-relative packet, or given as a
# dictionary of the component arguments of
# [`sec_desc`](security.windows.sec_desc).
pub @let SecDescSpec = (
  | SecDesc
  | Bin
  | Dict[{
    ?owner: (SidSpec | nil), ?group: (SidSpec | nil),
    ?dacl: (AclSpec | nil), ?sacl: (AclSpec | nil),
    ?owner_defaulted: Bool, ?group_defaulted: Bool,
    ?dacl_present: Bool, ?dacl_defaulted: Bool,
    ?dacl_auto_inherit_required: Bool, ?dacl_auto_inherited: Bool,
    ?dacl_protected: Bool,
    ?sacl_present: Bool, ?sacl_defaulted: Bool,
    ?sacl_auto_inherit_required: Bool, ?sacl_auto_inherited: Bool,
    ?sacl_protected: Bool,
    ?rm_control: (Int | nil),
  }]
)

# Generic Windows object access rights.
#
# Domain-specific rights such as [`winreg.AccessMask`](winreg.AccessMask) are
# subtypes. This type names generically applicable rights only.
pub class AccessMask: Iterable[Sym]
  # Constructs a mask from symbols or one iterable of symbols.
  #
  # ## Supported symbols
  #
  # | Symbol                       | Meaning                                          |
  # | ---------------------------- | ------------------------------------------------ |
  # | `:DELETE:`                   | Delete the object                                |
  # | `:READ_CONTROL:`             | Read its security descriptor, except the SACL    |
  # | `:WRITE_DAC:`                | Change its discretionary access-control list     |
  # | `:WRITE_OWNER:`              | Change its owner                                 |
  # | `:SYNCHRONIZE:`              | Synchronize access to the object                 |
  # | `:STANDARD_RIGHTS_REQUIRED:` | The standard rights required by most objects     |
  # | `:STANDARD_RIGHTS_ALL:`      | All standard rights                              |
  # | `:ACCESS_SYSTEM_SECURITY:`   | Access its system access-control list            |
  # | `:MAXIMUM_ALLOWED:`          | Request the maximum rights allowed to the caller |
  # | `:GENERIC_READ:`             | Request object-specific read access              |
  # | `:GENERIC_WRITE:`            | Request object-specific write access             |
  # | `:GENERIC_EXECUTE:`          | Request object-specific execute access           |
  # | `:GENERIC_ALL:`              | Request all object-specific access               |
  pub def (init)
    self
    # Rights, or one iterable of them.
    ...rights @ Sym
  do
    ...

  # Constructs a mask from a native integer, preserving unknown bits.
  #[class]
  pub def from_int
    self
    # Native mask bits.
    value @ Int
  do -> AccessMask
    ...

  # The object-specific low 16 bits.
  #[getter]
  pub def specific_rights self -> Int
    ...

  # The standard-rights portion.
  #[getter]
  pub def standard_rights self -> AccessMask
    ...

  # The generic-rights portion.
  #[getter]
  pub def generic_rights self -> AccessMask
    ...

  # The native integer mask.
  #[getter]
  pub def int self -> Int
    ...

  # Tests whether all bits represented by a symbol are set.
  pub def contains
    self
    # Right to test for.
    right @ Sym
  do -> Bool
    ...

  # Union of two masks.
  pub def (bor)
    self
    other @ AccessMask
  do -> AccessMask
    ...

  # Intersection of two masks.
  pub def (band)
    self
    other @ AccessMask
  do -> AccessMask
    ...

  # Symmetric difference of two masks.
  pub def (bxor)
    self
    other @ AccessMask
  do -> AccessMask
    ...

  # Complement within the supported bit set.
  pub def (bnot) self -> AccessMask
    ...

  # Compares two masks.
  pub def (eq) self other
    ...

  # Yields the symbols represented by the mask.
  pub def (iter) self -> Iter[Sym]
    ...

# Flags stored in an ACE header.
pub class AceFlags: Iterable[Sym]
  # Constructs flags from symbols or one iterable of symbols.
  #
  # The trust-protected-filter flag occupies the same bit as
  # `:SUCCESSFUL_ACCESS:` and has no symbol of its own. Read it from an
  # access-filter entry's
  # [`trust_protected_filter`](security.windows.Ace.trust_protected_filter).
  #
  # [`ace`](security.windows.ace) and the [`Ace`](security.windows.Ace)
  # constructor set the outcome flags from their own `successful` and `failed`
  # arguments.
  #
  # ## Supported symbols
  #
  # | Symbol                   | Meaning                                                |
  # | ------------------------ | ------------------------------------------------------ |
  # | `:OBJECT_INHERIT:`       | Non-container child objects inherit the entry          |
  # | `:CONTAINER_INHERIT:`    | Container child objects inherit the entry              |
  # | `:NO_PROPAGATE_INHERIT:` | Inherited copies stop propagating after one generation |
  # | `:INHERIT_ONLY:`         | The entry applies only through inheritance             |
  # | `:INHERITED:`            | The entry was inherited                                |
  # | `:CRITICAL:`             | The entry is critical and cannot be removed            |
  # | `:SUCCESSFUL_ACCESS:`    | An audit or alarm entry selects successful access      |
  # | `:FAILED_ACCESS:`        | An audit or alarm entry selects failed access          |
  pub def (init)
    self
    # Flags, or one iterable of them.
    ...flags @ Sym
  do
    ...

  # Constructs flags from a native integer, preserving unknown bits.
  #[class]
  pub def from_int
    self
    # Native flag bits.
    value @ Int
  do -> AceFlags
    ...

  # The native integer flags.
  #[getter]
  pub def int self -> Int
    ...

  # Tests whether all bits represented by a symbol are set.
  pub def contains
    self
    # Flag to test for.
    flag @ Sym
  do -> Bool
    ...

  # Union of two flag sets.
  pub def (bor)
    self
    other @ AceFlags
  do -> AceFlags
    ...

  # Intersection of two flag sets.
  pub def (band)
    self
    other @ AceFlags
  do -> AceFlags
    ...

  # Symmetric difference of two flag sets.
  pub def (bxor)
    self
    other @ AceFlags
  do -> AceFlags
    ...

  # Complement within the supported bit set.
  pub def (bnot) self -> AceFlags
    ...

  # Compares two flag sets.
  pub def (eq) self other
    ...

  # Yields the symbols represented by the flags.
  pub def (iter) self -> Iter[Sym]
    ...

# Security descriptor control flags.
pub class SecDescControl: Iterable[Sym]
  # Constructs control flags from symbols or one iterable of symbols.
  #
  # ## Supported symbols
  #
  # | Symbol                         | Meaning                               |
  # | ------------------------------ | ------------------------------------- |
  # | `:OWNER_DEFAULTED:`            | Owner supplied by a default method    |
  # | `:GROUP_DEFAULTED:`            | Group supplied by a default method    |
  # | `:DACL_PRESENT:`               | DACL present                          |
  # | `:DACL_DEFAULTED:`             | DACL supplied by a default method     |
  # | `:SACL_PRESENT:`               | SACL present                          |
  # | `:SACL_DEFAULTED:`             | SACL supplied by a default method     |
  # | `:DACL_AUTO_INHERIT_REQUIRED:` | DACL requires inheritance processing  |
  # | `:SACL_AUTO_INHERIT_REQUIRED:` | SACL requires inheritance processing  |
  # | `:DACL_AUTO_INHERITED:`        | DACL was automatically inherited      |
  # | `:SACL_AUTO_INHERITED:`        | SACL was automatically inherited      |
  # | `:DACL_PROTECTED:`             | DACL blocks inheritable ACEs          |
  # | `:SACL_PROTECTED:`             | SACL blocks inheritable ACEs          |
  # | `:RM_CONTROL_VALID:`           | Resource-manager control byte valid   |
  # | `:SELF_RELATIVE:`              | Descriptor uses self-relative storage |
  pub def (init)
    self
    # Flags, or one iterable of them.
    ...flags @ Sym
  do
    ...

  # Tests whether all bits represented by a symbol are set.
  pub def contains
    self
    # Flag to test for.
    flag @ Sym
  do -> Bool
    ...

  # Union of two flag sets.
  pub def (bor)
    self
    other @ SecDescControl
  do -> SecDescControl
    ...

  # Intersection of two flag sets.
  pub def (band)
    self
    other @ SecDescControl
  do -> SecDescControl
    ...

  # Symmetric difference of two flag sets.
  pub def (bxor)
    self
    other @ SecDescControl
  do -> SecDescControl
    ...

  # Complement within the supported bit set.
  pub def (bnot) self -> SecDescControl
    ...

  # Compares two flag sets.
  pub def (eq) self other
    ...

  # Yields the symbols represented by the flags.
  pub def (iter) self -> Iter[Sym]
    ...

# Security descriptor components loaded by a query.
pub class SecInfo: Iterable[Sym]
  # Constructs a component set from symbols or one iterable of symbols.
  #
  # ## Supported symbols
  #
  # | Symbol    | Component                |
  # | --------- | ------------------------ |
  # | `:OWNER:` | Owner SID                |
  # | `:GROUP:` | Primary group SID        |
  # | `:DACL:`  | Discretionary ACL        |
  # | `:SACL:`  | System ACL               |
  # | `:ALL:`   | All supported components |
  pub def (init)
    self
    # Components, or one iterable of them.
    ...components @ Sym
  do
    ...

  # Tests whether a component is selected.
  pub def contains
    self
    # Component to test for.
    component @ Sym
  do -> Bool
    ...

  # Union of two component sets.
  pub def (bor)
    self
    other @ SecInfo
  do -> SecInfo
    ...

  # Intersection of two component sets.
  pub def (band)
    self
    other @ SecInfo
  do -> SecInfo
    ...

  # Symmetric difference of two component sets.
  pub def (bxor)
    self
    other @ SecInfo
  do -> SecInfo
    ...

  # Complement within the supported bit set.
  pub def (bnot) self -> SecInfo
    ...

  # Compares two component sets.
  pub def (eq) self other
    ...

  # Yields the selected component symbols.
  pub def (iter) self -> Iter[Sym]
    ...

# Windows access-token group attributes.
pub class TokenGroupAttributes: Iterable[Sym]
  # Constructs attributes from symbols or one iterable of symbols.
  #
  # ## Supported symbols
  #
  # | Symbol                 | Attribute                   |
  # | ---------------------- | --------------------------- |
  # | `:MANDATORY:`          | Mandatory group             |
  # | `:ENABLED_BY_DEFAULT:` | Enabled by default          |
  # | `:ENABLED:`            | Enabled                     |
  # | `:OWNER:`              | Eligible as an object owner |
  # | `:USE_FOR_DENY_ONLY:`  | Used only for deny checks   |
  # | `:INTEGRITY:`          | Integrity SID               |
  # | `:INTEGRITY_ENABLED:`  | Integrity SID enabled       |
  # | `:RESOURCE:`           | Resource group              |
  # | `:LOGON_ID:`           | Logon-session identifier    |
  pub def (init)
    self
    # Attributes, or one iterable of them.
    ...attributes @ Sym
  do
    ...

  # Tests whether an attribute is set.
  pub def contains
    self
    # Attribute to test for.
    attribute @ Sym
  do -> Bool
    ...

  # Union of two attribute sets.
  pub def (bor)
    self
    other @ TokenGroupAttributes
  do -> TokenGroupAttributes
    ...

  # Intersection of two attribute sets.
  pub def (band)
    self
    other @ TokenGroupAttributes
  do -> TokenGroupAttributes
    ...

  # Symmetric difference of two attribute sets.
  pub def (bxor)
    self
    other @ TokenGroupAttributes
  do -> TokenGroupAttributes
    ...

  # Complement within the supported bit set.
  pub def (bnot) self -> TokenGroupAttributes
    ...

  # Compares two attribute sets.
  pub def (eq) self other
    ...

  # Yields the attribute symbols that are set.
  pub def (iter) self -> Iter[Sym]
    ...

# Windows security identifier.
#
# ## Example
#
# ```
# let admins = Sid :BUILTIN_ADMINISTRATORS:
# echo $admins
# ```
pub class Sid
  # Constructs a SID from one of its spellings.
  #
  # ## Errors
  #
  # `ValueError` for a malformed representation.
  pub def (init)
    self
    # Canonical string, native packet, or well-known SID.
    value @ (Str | Bin | WellKnownSid)
  do
    ...

  # SID revision number.
  #[getter]
  pub def revision self -> Int
    ...

  # The identifier authority, or its 48-bit value when it has no symbol.
  #[getter]
  pub def identifier_authority self -> (IdentifierAuthority | Int)
    ...

  # The sub-authorities.
  #[getter]
  pub def sub_authorities self -> Tuple[...Int]
    ...

  # Number of sub-authorities.
  #[getter]
  pub def sub_authority_count self -> Int
    ...

  # Resolves the SID in the active Windows VFS target.
  #
  # ## Errors
  #
  # | Exception                                  | Condition                      |
  # | ------------------------------------------ | ------------------------------ |
  # | [`sys.NotFoundError`](sys.NotFoundError)   | The SID is unmapped            |
  # | [`UnsupportedError`](std.UnsupportedError) | The active VFS target is Unix  |
  pub def lookup self -> SidName
    ...

  # Returns the native Windows packet representation.
  #
  # ## Example
  #
  # ```
  # let sid = Sid S-1-5-32-544
  # echo $sid.identifier_authority
  # let encoded = sid.to_bin()
  # ```
  pub def to_bin self -> Bin
    ...

# Resolved Windows account identity.
pub class SidName
  # Resolves an account name or SID in the active VFS target.
  #
  # A [`Str`](std.Str) is always an account name, never a SID in its canonical
  # string form.
  #
  # ## Errors
  #
  # | Exception                                  | Condition                     |
  # | ------------------------------------------ | ----------------------------- |
  # | [`sys.NotFoundError`](sys.NotFoundError)   | The identity is unmapped      |
  # | [`UnsupportedError`](std.UnsupportedError) | The active VFS target is Unix |
  #[class]
  pub def lookup
    self
    # Account name, or a SID as a `Sid`, native packet, or well-known SID.
    value @ (Str | Sid | Bin | WellKnownSid)
  do -> SidName
    ...

  # Account domain returned by Windows.
  #[getter]
  pub def domain self -> Str
    ...

  # How Windows classifies the SID.
  #
  # ## Example
  #
  # ```
  # let account = SidName.lookup BUILTIN\Users
  # echo "$(account.qualified_name) ($(account.kind))"
  # ```
  #[getter]
  pub def kind self -> SidNameUse
    ...

  # Unqualified account name.
  #[getter]
  pub def name self -> Str
    ...

  # The `domain\name` form, or `name` when the domain is empty.
  #[getter]
  pub def qualified_name self -> Str
    ...

  # The resolved SID.
  #[getter]
  pub def sid self -> Sid
    ...

# Immutable view of a native Windows access-control entry.
#
# An entry can also be written as an [`AceSpec`](security.windows.AceSpec)
# wherever one is accepted.
pub class Ace
  # Constructs an access-allowed, access-denied, or system-audit entry.
  #
  # Exactly one of `allow`, `deny`, or `audit` names the trustee. The
  # constructor is strict; use [`ace`](security.windows.ace) to build an entry
  # from declarative values such as SID strings and symbolic flags.
  #
  # ## Errors
  #
  # `ValueError` if zero or several trustees are given, if an audit entry has
  # no outcome, or if `successful` or `failed` is given for an allow or deny
  # entry.
  #
  # ## Example
  #
  # ```
  # let entry = Ace
  #   allow: (Sid :EVERYONE:)
  #   mask: (AccessMask :GENERIC_READ:)
  # ```
  pub def (init)
    self
    # Trustee of an access-allowed entry.
    :allow @ Sid = nil
    # Trustee of an access-denied entry.
    :deny @ Sid = nil
    # Trustee of a system-audit entry.
    :audit @ Sid = nil
    # Access mask.
    :mask @ AccessMask
    # ACE header flags, other than the audit outcomes.
    :flags @ AceFlags = nil
    # Object type, making this an object entry.
    :object_type @ Guid = nil
    # Inherited object type, making this an object entry.
    :inherited_object_type @ Guid = nil
    # Build a callback entry.
    :callback @ Bool = nil
    # Trailing application data, zero-padded to 32-bit alignment.
    :application_data @ Bin = nil
    # Audit successful access.
    :successful @ Bool = nil
    # Audit failed access.
    :failed @ Bool = nil
  do
    ...

  # The exact bytes after the SID, which may be empty.
  #
  # Raises `FieldError` when the entry body is not interpreted.
  #[getter]
  pub def application_data self -> Bin
    ...

  # Whether container child objects inherit this entry.
  #[getter]
  pub def container_inherit self -> Bool
    ...

  # Whether the critical flag is set.
  #[getter]
  pub def critical self -> Bool
    ...

  # Whether an audit or alarm entry selects failed access.
  #
  # Raises `FieldError` for other entry types.
  #[getter]
  pub def failed_access self -> Bool
    ...

  # The ACE header flags.
  #[getter]
  pub def flags self -> AceFlags
    ...

  # Whether this entry applies only through inheritance.
  #[getter]
  pub def inherit_only self -> Bool
    ...

  # Whether this entry was inherited.
  #[getter]
  pub def inherited self -> Bool
    ...

  # The inherited object type, or `nil` when its object flag is clear.
  #
  # Raises `FieldError` for a non-object entry.
  #[getter]
  pub def inherited_object_type self -> (Guid | nil)
    ...

  # The access mask.
  #
  # Raises `FieldError` for an entry layout without a mask.
  #[getter]
  pub def mask self -> AccessMask
    ...

  # Whether inherited copies stop propagating after one generation.
  #[getter]
  pub def no_propagate_inherit self -> Bool
    ...

  # Native object entry flags.
  #
  # Raises `FieldError` for a non-object entry.
  #[getter]
  pub def object_flags self -> Int
    ...

  # Whether non-container child objects inherit this entry.
  #[getter]
  pub def object_inherit self -> Bool
    ...

  # The object type, or `nil` when its object flag is clear.
  #
  # Raises `FieldError` for a non-object entry.
  #[getter]
  pub def object_type self -> (Guid | nil)
    ...

  # The trustee.
  #
  # Raises `FieldError` for an entry layout without a SID.
  #[getter]
  pub def sid self -> Sid
    ...

  # Declared entry packet size.
  #[getter]
  pub def size self -> Int
    ...

  # Whether an audit or alarm entry selects successful access.
  #
  # Raises `FieldError` for other entry types.
  #[getter]
  pub def successful_access self -> Bool
    ...

  # Whether an access-filter entry has the trust-protected flag.
  #
  # Raises `FieldError` for other entry types.
  #[getter]
  pub def trust_protected_filter self -> Bool
    ...

  # The entry type.
  #[getter]
  pub def type self -> AceType
    ...

  # The native numeric entry type code.
  #[getter]
  pub def type_code self -> Int
    ...

  # Returns the exact native entry packet, including application or unknown
  # data.
  pub def to_bin self -> Bin
    ...

# Immutable view of a native Windows access-control list.
#
# A list can also be written as an [`AclSpec`](security.windows.AclSpec)
# wherever one is accepted.
pub class Acl
  # Constructs an ACL from built entries.
  #
  # Revision 4 is selected when an object entry is present; otherwise revision
  # 2 is selected.
  #
  # ## Errors
  #
  # `ValueError` if revision 2 is given with an object entry.
  pub def (init)
    self
    # Entries in packet order.
    aces @ Iterable[Ace]
    # Native ACL revision.
    :revision @ (AclRevision | Int) = nil
  do
    ...

  # Immutable array-like view of the entries.
  #[getter]
  pub def aces self
    ...

  # The revision, or its native number when it has no symbol.
  #[getter]
  pub def revision self -> (AclRevision | Int)
    ...

  # Declared ACL packet size.
  #[getter]
  pub def size self -> Int
    ...

  # Returns the exact native ACL packet.
  pub def to_bin self -> Bin
    ...

# Windows security descriptor.
#
# A descriptor can also be written as a
# [`SecDescSpec`](security.windows.SecDescSpec) wherever one is accepted.
#
# ACL-related fields raise `FieldError` when the corresponding ACL was not
# loaded.
pub class SecDesc
  # Parses a self-relative security descriptor packet.
  #
  # ## Errors
  #
  # `ValueError` if the packet is malformed or not self-relative.
  @def (init)
    self
    # Native self-relative packet.
    packet @ Bin
  do

  # Constructs a security descriptor from built components and control flags.
  #
  # A control flag given as `true` requires its component to be present or
  # given.
  @def (init)
    self
    # Owner, or `nil` for an absent owner.
    :owner @ (Sid | nil) = nil
    # Primary group, or `nil` for an absent group.
    :group @ (Sid | nil) = nil
    # Discretionary ACL, or `nil` for a present null ACL.
    :dacl @ (Acl | nil) = nil
    # System ACL, or `nil` for a present null ACL.
    :sacl @ (Acl | nil) = nil
    # Owner defaulted flag.
    :owner_defaulted @ Bool = nil
    # Group defaulted flag.
    :group_defaulted @ Bool = nil
    # DACL presence.
    :dacl_present @ Bool = nil
    # DACL defaulted flag.
    :dacl_defaulted @ Bool = nil
    # DACL inheritance request.
    :dacl_auto_inherit_required @ Bool = nil
    # DACL inherited flag.
    :dacl_auto_inherited @ Bool = nil
    # DACL protection.
    :dacl_protected @ Bool = nil
    # SACL presence.
    :sacl_present @ Bool = nil
    # SACL defaulted flag.
    :sacl_defaulted @ Bool = nil
    # SACL inheritance request.
    :sacl_auto_inherit_required @ Bool = nil
    # SACL inherited flag.
    :sacl_auto_inherited @ Bool = nil
    # SACL protection.
    :sacl_protected @ Bool = nil
    # Resource-manager control byte.
    :rm_control @ Int = nil
  do

  pub def (init) self ...args
    ...

  # The control flags, excluding the self-relative storage flag.
  #[getter]
  pub def control self -> SecDescControl
    ...

  # The discretionary ACL, or `nil` for a present null ACL.
  #
  # Raises `FieldError` when the DACL was not loaded or is not present.
  #[getter]
  pub def dacl self -> (Acl | nil)
    ...

  # Whether DACL inheritance computation was requested.
  #[getter]
  pub def dacl_auto_inherit_required self -> Bool
    ...

  # Whether the DACL was produced through inheritance.
  #[getter]
  pub def dacl_auto_inherited self -> Bool
    ...

  # Whether the DACL was supplied by a default mechanism.
  #[getter]
  pub def dacl_defaulted self -> Bool
    ...

  # Whether the DACL is present. A present ACL can be null.
  #[getter]
  pub def dacl_present self -> Bool
    ...

  # Whether the DACL is protected from inheritance.
  #[getter]
  pub def dacl_protected self -> Bool
    ...

  # The primary group.
  #
  # Raises `FieldError` when the group was not loaded or is absent.
  #[getter]
  pub def group self -> Sid
    ...

  # Whether the group was supplied by a default mechanism.
  #[getter]
  pub def group_defaulted self -> Bool
    ...

  # The components that are present.
  #
  # A descriptor parsed from a self-relative packet has all four components
  # marked, because the packet carries no separate mask. One read from an
  # object may have fewer, depending on what was queried.
  #[getter]
  pub def mask self -> SecInfo
    ...

  # The owner.
  #
  # Raises `FieldError` when the owner was not loaded or is absent.
  #[getter]
  pub def owner self -> Sid
    ...

  # Whether the owner was supplied by a default mechanism.
  #[getter]
  pub def owner_defaulted self -> Bool
    ...

  # Security descriptor revision.
  #[getter]
  pub def revision self -> Int
    ...

  # Resource-manager-defined control byte.
  #
  # Raises `FieldError` when `rm_control_valid` is false.
  #[getter]
  pub def rm_control self -> Int
    ...

  # Whether the resource-manager control byte is valid.
  #[getter]
  pub def rm_control_valid self -> Bool
    ...

  # The system ACL, or `nil` for a present null ACL.
  #
  # Raises `FieldError` when the SACL was not loaded or is not present.
  #[getter]
  pub def sacl self -> (Acl | nil)
    ...

  # Whether SACL inheritance computation was requested.
  #[getter]
  pub def sacl_auto_inherit_required self -> Bool
    ...

  # Whether the SACL was produced through inheritance.
  #[getter]
  pub def sacl_auto_inherited self -> Bool
    ...

  # Whether the SACL was supplied by a default mechanism.
  #[getter]
  pub def sacl_defaulted self -> Bool
    ...

  # Whether the SACL is present. A present ACL can be null.
  #[getter]
  pub def sacl_present self -> Bool
    ...

  # Whether the SACL is protected from inheritance.
  #[getter]
  pub def sacl_protected self -> Bool
    ...

  # Returns a canonical self-relative security descriptor packet.
  pub def to_bin self -> Bin
    ...

  # Returns a descriptor with the given components or control flags replaced.
  #
  # Components are strict, as for the constructor. An ACL presence flag given
  # as `false` clears that ACL.
  pub def with
    self
    # Owner, or `nil` for an absent owner.
    :owner @ (Sid | nil) = nil
    # Primary group, or `nil` for an absent group.
    :group @ (Sid | nil) = nil
    # Discretionary ACL, or `nil` for a present null ACL.
    :dacl @ (Acl | nil) = nil
    # System ACL, or `nil` for a present null ACL.
    :sacl @ (Acl | nil) = nil
    # Owner defaulted flag.
    :owner_defaulted @ Bool = nil
    # Group defaulted flag.
    :group_defaulted @ Bool = nil
    # DACL presence.
    :dacl_present @ Bool = nil
    # DACL defaulted flag.
    :dacl_defaulted @ Bool = nil
    # DACL inheritance request.
    :dacl_auto_inherit_required @ Bool = nil
    # DACL inherited flag.
    :dacl_auto_inherited @ Bool = nil
    # DACL protection.
    :dacl_protected @ Bool = nil
    # SACL presence.
    :sacl_present @ Bool = nil
    # SACL defaulted flag.
    :sacl_defaulted @ Bool = nil
    # SACL inheritance request.
    :sacl_auto_inherit_required @ Bool = nil
    # SACL inherited flag.
    :sacl_auto_inherited @ Bool = nil
    # SACL protection.
    :sacl_protected @ Bool = nil
    # Resource-manager control byte, or `nil` to clear it.
    :rm_control @ (Int | nil) = nil
  do -> SecDesc
    ...

# A group in a Windows access token.
pub class TokenGroup
  # The group's attributes.
  #[getter]
  pub def attributes self -> TokenGroupAttributes
    ...

  # Whether the group is enabled.
  #[getter]
  pub def enabled self -> Bool
    ...

  # Whether the group is enabled by default.
  #[getter]
  pub def enabled_by_default self -> Bool
    ...

  # Whether the SID is an integrity SID.
  #[getter]
  pub def integrity self -> Bool
    ...

  # Whether the integrity SID is enabled.
  #[getter]
  pub def integrity_enabled self -> Bool
    ...

  # Whether the group identifies the token's logon session.
  #[getter]
  pub def logon_id self -> Bool
    ...

  # Whether the group is mandatory.
  #[getter]
  pub def mandatory self -> Bool
    ...

  # Whether the group can be assigned as an object owner.
  #[getter]
  pub def owner self -> Bool
    ...

  # Whether the group is a resource group.
  #[getter]
  pub def resource self -> Bool
    ...

  # The group SID.
  #[getter]
  pub def sid self -> Sid
    ...

  # Whether the group is used only for deny access checks.
  #[getter]
  pub def use_for_deny_only self -> Bool
    ...

# Windows access token information.
pub class TokenInfo
  # Immutable array-like view of the token's
  # [`TokenGroup`](security.windows.TokenGroup)s.
  #[getter]
  pub def groups self
    ...

  # Whether the token is elevated.
  #[getter]
  pub def is_elevated self -> Bool
    ...

  # The group SID marked as the token's logon SID, or `nil` if there is none.
  #[getter]
  pub def logon_sid self -> (Sid | nil)
    ...

  # Default owner SID for objects created by the token.
  #[getter]
  pub def owner_sid self -> Sid
    ...

  # Primary group SID for objects created by the token.
  #[getter]
  pub def primary_group_sid self -> Sid
    ...

  # SID of the token's user.
  #[getter]
  pub def user_sid self -> Sid
    ...

# Constructs an [`Ace`](security.windows.Ace) from declarative arguments.
#
# Exactly one of `allow`, `deny`, or `audit` names the trustee.
#
# ## Errors
#
# `ValueError` if zero or several trustees are given, if an audit entry has no
# outcome, or if `successful` or `failed` is given for an allow or deny entry.
#
# ## Example
#
# ```
# let entry = ace
#   deny: :EVERYONE:
#   mask: :GENERIC_WRITE:
# ```
pub def ace
  # Trustee of an access-allowed entry.
  :allow @ SidSpec = nil
  # Trustee of an access-denied entry.
  :deny @ SidSpec = nil
  # Trustee of a system-audit entry.
  :audit @ SidSpec = nil
  # Access mask.
  :mask @ AccessMaskSpec
  # ACE header flags, other than the audit outcomes.
  :flags @ AceFlagsSpec = nil
  # Object type, making this an object entry.
  :object_type @ (Guid | Str | Bin) = nil
  # Inherited object type, making this an object entry.
  :inherited_object_type @ (Guid | Str | Bin) = nil
  # Build a callback entry.
  :callback @ Bool = nil
  # Trailing application data, zero-padded to 32-bit alignment.
  :application_data @ Bin = nil
  # Audit successful access.
  :successful @ Bool = nil
  # Audit failed access.
  :failed @ Bool = nil
do -> Ace
  ...

# Constructs an [`Acl`](security.windows.Acl) from entries and entry
# dictionaries.
#
# ## Example
#
# ```
# let dacl = acl
#   - allow: :LOCAL_SYSTEM:
#     mask: :GENERIC_ALL:
#   - allow: :BUILTIN_ADMINISTRATORS:
#     mask: :GENERIC_ALL:
# ```
pub def acl
  # Native ACL revision. Defaults to the lowest revision the entries allow.
  :revision @ (AclRevision | Int) = nil
  # Entries in packet order, spread with `...` to pass a collection.
  ...aces @ AceSpec
do -> Acl
  ...

# Constructs a [`SecDesc`](security.windows.SecDesc) from a descriptor,
# components, or both.
#
# Given both, the components amend `desc` the way
# [`SecDesc.with`](security.windows.SecDesc.with) does. The `update_sec_desc`
# functions of other modules take the same arguments.
#
# ## Errors
#
# `ValueError` if neither a descriptor nor any component is given.
#
# ## Example
#
# ```
# let descriptor = sec_desc
#   owner: :BUILTIN_ADMINISTRATORS:
#   dacl_protected: true
#   dacl:
#     - allow: :LOCAL_SYSTEM:
#       mask: :GENERIC_ALL:
#
# let unprotected = sec_desc $descriptor dacl_protected: false
# ```
pub def sec_desc
  # Descriptor to start from.
  desc @ SecDescSpec = nil
  # Owner, or `nil` for an absent owner.
  :owner @ (SidSpec | nil) = nil
  # Primary group, or `nil` for an absent group.
  :group @ (SidSpec | nil) = nil
  # Discretionary ACL, or `nil` for a present null ACL.
  :dacl @ (AclSpec | nil) = nil
  # System ACL, or `nil` for a present null ACL.
  :sacl @ (AclSpec | nil) = nil
  # Owner defaulted flag.
  :owner_defaulted @ Bool = nil
  # Group defaulted flag.
  :group_defaulted @ Bool = nil
  # DACL presence. `false` clears the DACL of `desc`.
  :dacl_present @ Bool = nil
  # DACL defaulted flag.
  :dacl_defaulted @ Bool = nil
  # DACL inheritance request.
  :dacl_auto_inherit_required @ Bool = nil
  # DACL inherited flag.
  :dacl_auto_inherited @ Bool = nil
  # DACL protection.
  :dacl_protected @ Bool = nil
  # SACL presence. `false` clears the SACL of `desc`.
  :sacl_present @ Bool = nil
  # SACL defaulted flag.
  :sacl_defaulted @ Bool = nil
  # SACL inheritance request.
  :sacl_auto_inherit_required @ Bool = nil
  # SACL inherited flag.
  :sacl_auto_inherited @ Bool = nil
  # SACL protection.
  :sacl_protected @ Bool = nil
  # Resource-manager control byte, or `nil` to clear it.
  :rm_control @ (Int | nil) = nil
do -> SecDesc
  ...

# Returns Windows token information captured for the active VFS context.
#
# ## Errors
#
# [`UnsupportedError`](std.UnsupportedError) if the active VFS target is Unix.
#
# ## Example
#
# ```
# if token_info().is_elevated
#   echo elevated
# ```
pub def token_info() -> TokenInfo
  ...
