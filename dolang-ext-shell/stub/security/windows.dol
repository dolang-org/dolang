pub class CustomAce: Ace

# Immutable view of a native Windows access-control list.
#
# A list can also be written as an [`AclSpec`](security.windows.AclSpec)
# wherever one is accepted.
pub class Acl
  # Constructs an ACL from built entries.
  #
  # Revision 4 is selected when an object entry is present; otherwise revision
  # 2 is selected.
  #
  # ## Errors
  #
  # `ValueError` if revision 2 is given with an object entry.
  pub def (init)
    self
    # Entries in packet order.
    aces @ Iterable[Ace]
    # Native ACL revision.
    :revision @ (AclRevision | Int) = nil
  do
    ...

  # Immutable array-like view of the entries.
  #[getter]
  pub def aces self -> Seq[Ace]
    ...

  # The revision, or its native number when it has no symbol.
  #[getter]
  pub def revision self -> (AclRevision | Int)
    ...

  # Declared ACL packet size.
  #[getter]
  pub def size self -> Int
    ...

  # Returns the exact native ACL packet.
  pub def to_bin self -> Bin
    ...

# Windows security descriptor.
#
# A descriptor can also be written as a
# [`SecDescSpec`](security.windows.SecDescSpec) wherever one is accepted.
#
# Component getters and their control flags raise `FieldError` when the
# component was not requested. Loaded but absent components return `nil`.
pub class SecDesc
  # Parses a self-relative security descriptor packet.
  #
  # ## Errors
  #
  # `ValueError` if the packet is malformed or not self-relative.
  @def (init)
    self
    # Native self-relative packet.
    packet @ Bin
  do

  # Constructs a security descriptor from built components and control flags.
  #
  # A control flag given as `true` requires its component to be present or
  # given.
  @def (init)
    self
    # Owner, or `nil` for an absent owner.
    :owner @ (Sid | nil) = nil
    # Primary group, or `nil` for an absent group.
    :group @ (Sid | nil) = nil
    # Discretionary ACL, or `nil` for a present null ACL.
    :dacl @ (Acl | nil) = nil
    # System ACL, or `nil` for a present null ACL.
    :sacl @ (Acl | nil) = nil
    # Owner defaulted flag.
    :owner_defaulted @ Bool = nil
    # Group defaulted flag.
    :group_defaulted @ Bool = nil
    # DACL presence.
    :dacl_present @ Bool = nil
    # DACL defaulted flag.
    :dacl_defaulted @ Bool = nil
    # DACL inheritance request.
    :dacl_auto_inherit_required @ Bool = nil
    # DACL inherited flag.
    :dacl_auto_inherited @ Bool = nil
    # DACL protection.
    :dacl_protected @ Bool = nil
    # SACL presence.
    :sacl_present @ Bool = nil
    # SACL defaulted flag.
    :sacl_defaulted @ Bool = nil
    # SACL inheritance request.
    :sacl_auto_inherit_required @ Bool = nil
    # SACL inherited flag.
    :sacl_auto_inherited @ Bool = nil
    # SACL protection.
    :sacl_protected @ Bool = nil
    # Resource-manager control byte.
    :rm_control @ Int = nil
  do

  pub def (init) self ...args @ Value
    ...

  # The control flags, excluding the self-relative storage flag.
  #[getter]
  pub def control self -> SecDescControl
    ...

  # The discretionary ACL, or `nil` when absent or present-null.
  #
  # Raises `FieldError` when the DACL was not loaded.
  #[getter]
  pub def dacl self -> (Acl | nil)
    ...

  # Whether DACL inheritance computation was requested.
  #[getter]
  pub def dacl_auto_inherit_required self -> Bool
    ...

  # Whether the DACL was produced through inheritance.
  #[getter]
  pub def dacl_auto_inherited self -> Bool
    ...

  # Whether the DACL was supplied by a default mechanism.
  #[getter]
  pub def dacl_defaulted self -> Bool
    ...

  # Whether the DACL is present. A present ACL can be null.
  #[getter]
  pub def dacl_present self -> Bool
    ...

  # Whether the DACL is protected from inheritance.
  #[getter]
  pub def dacl_protected self -> Bool
    ...

  # The primary group.
  #
  # Raises `FieldError` when the group was not loaded.
  #[getter]
  pub def group self -> (Sid | nil)
    ...

  # Whether the group was supplied by a default mechanism.
  #[getter]
  pub def group_defaulted self -> Bool
    ...

  # The components that are present.
  #
  # A descriptor parsed from a self-relative packet has all four components
  # marked, because the packet carries no separate mask. One read from an
  # object may have fewer, depending on what was queried.
  #[getter]
  pub def mask self -> SecInfo
    ...

  # The owner.
  #
  # Raises `FieldError` when the owner was not loaded.
  #[getter]
  pub def owner self -> (Sid | nil)
    ...

  # Whether the owner was supplied by a default mechanism.
  #[getter]
  pub def owner_defaulted self -> Bool
    ...

  # Security descriptor revision.
  #[getter]
  pub def revision self -> Int
    ...

  # Resource-manager-defined control byte.
  #
  # Returns `nil` when `rm_control_valid` is false.
  #[getter]
  pub def rm_control self -> (Int | nil)
    ...

  # Whether the resource-manager control byte is valid.
  #[getter]
  pub def rm_control_valid self -> Bool
    ...

  # The system ACL, or `nil` when absent or present-null.
  #
  # Raises `FieldError` when the SACL was not loaded.
  #[getter]
  pub def sacl self -> (Acl | nil)
    ...

  # Whether SACL inheritance computation was requested.
  #[getter]
  pub def sacl_auto_inherit_required self -> Bool
    ...

  # Whether the SACL was produced through inheritance.
  #[getter]
  pub def sacl_auto_inherited self -> Bool
    ...

  # Whether the SACL was supplied by a default mechanism.
  #[getter]
  pub def sacl_defaulted self -> Bool
    ...

  # Whether the SACL is present. A present ACL can be null.
  #[getter]
  pub def sacl_present self -> Bool
    ...

  # Whether the SACL is protected from inheritance.
  #[getter]
  pub def sacl_protected self -> Bool
    ...

  # Returns a canonical self-relative security descriptor packet.
  pub def to_bin self -> Bin
    ...

  # Returns a descriptor with the given components or control flags replaced.
  #
  # Components are strict, as for the constructor. An ACL presence flag given
  # as `false` clears that ACL.
  pub def with
    self
    # Owner, or `nil` for an absent owner.
    :owner @ (Sid | nil) = nil
    # Primary group, or `nil` for an absent group.
    :group @ (Sid | nil) = nil
    # Discretionary ACL, or `nil` for a present null ACL.
    :dacl @ (Acl | nil) = nil
    # System ACL, or `nil` for a present null ACL.
    :sacl @ (Acl | nil) = nil
    # Owner defaulted flag.
    :owner_defaulted @ Bool = nil
    # Group defaulted flag.
    :group_defaulted @ Bool = nil
    # DACL presence.
    :dacl_present @ Bool = nil
    # DACL defaulted flag.
    :dacl_defaulted @ Bool = nil
    # DACL inheritance request.
    :dacl_auto_inherit_required @ Bool = nil
    # DACL inherited flag.
    :dacl_auto_inherited @ Bool = nil
    # DACL protection.
    :dacl_protected @ Bool = nil
    # SACL presence.
    :sacl_present @ Bool = nil
    # SACL defaulted flag.
    :sacl_defaulted @ Bool = nil
    # SACL inheritance request.
    :sacl_auto_inherit_required @ Bool = nil
    # SACL inherited flag.
    :sacl_auto_inherited @ Bool = nil
    # SACL protection.
    :sacl_protected @ Bool = nil
    # Resource-manager control byte, or `nil` to clear it.
    :rm_control @ (Int | nil) = nil
  do -> SecDesc
    ...

