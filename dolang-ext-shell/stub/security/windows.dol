# #### Errors
#
# Raises `ValueError` when neither a descriptor nor any component option is
# given.
#
# #### Example
#
# ```
# let descriptor = sec_desc
#   owner: :BUILTIN_ADMINISTRATORS:
#   dacl_protected: true
#   dacl:
#     - allow: :LOCAL_SYSTEM:
#       mask: :GENERIC_ALL:
#
# let unprotected = sec_desc $descriptor dacl_protected: false
# ```
#
pub def sec_desc
  desc = nil
  ...options
do
  throw nil

