# Writes the entire contents of a file in one call, creating or truncating it.
#
# Binary values are written as raw bytes and strings as UTF-8 text.
#
# ## Returns
#
# [`Int`](std.Int), the number of bytes written.
#
# ## Example
#
# ```
# write "message.txt" "hello"
# write "data.bin" b"\x01\x02\x03"
# ```
pub def write
  # ([`Str`](std.Str)\|[`Path`](fs.Path)) Path to the file to write.
  path
  # ([`Str`](std.Str)\|[`Bin`](std.Bin)) Value to write.
  content
do
  throw nil

# Appends content to a file, creating it if needed.
#
# ## Returns
#
# [`Int`](std.Int), the number of bytes written.
#
# ## Example
#
# ```
# append "messages.txt" "another message\n"
# append "data.bin" b"\x04\x05"
# ```
pub def append
  # ([`Str`](std.Str)\|[`Path`](fs.Path)) Path to the file to append
  # to.
  path
  # ([`Str`](std.Str)\|[`Bin`](std.Bin)) Content to append.
  content
do
  throw nil

# Copies data from one open file to another.
#
# This attempts to copy data in the most efficient manner possible:
#
# - If both handles are from the same VFS domain, all copying occurs
#   target-side rather than being relayed.
# - Copy-on-write cloning of blocks/extents will be used by default if the
#   platform, filesystem, handle pair, and data size and alignment meet
#   relevant requirements.
# - Sparsity will be preserved if possible: blocks of all zero bytes which are
#   not physically allocated in the source will not be allocated in the
#   destination, so long as platform, filesystem, data size and alignment
#   requirements permit it.
#
# This operation is not remotely atomic. Concurrent modification of either
# source or destination in the relevant range will result in unspecified final
# state in terms of the destination's content in the affected range, and
# possibly file length if the range overlapped the prior end-of-file. A failed
# operation may also leave the destination in an unspecified intermediate
# state.
#
# Copying between disjoint regions of one file is allowed; overlapping ones are
# rejected if detected. Detection requires recognizing when two handles refer
# to the same file, which is not always possible, in which case an overlapping
# copy has an unspecified result.
#
# ## Returns
#
# [`Int`](std.Int), the number of bytes copied. This is the number of
# bytes requested unless source end-of-file was reached.
#
# ## Errors
#
# | Exception                                            | Condition                                           |
# | ---------------------------------------------------- | --------------------------------------------------- |
# | [`ValueError`](std.ValueError)                | `range:` and `size:` together, or a malformed range |
# | [`StateError`](std.StateError)                | `offset:` on a handle opened for appending          |
# | [`StateError`](std.StateError)                | either handle is closed                             |
# | [`StateError`](std.StateError)                | one handle used as both sides through its cursor    |
# | [`InvalidInputError`](sys.InvalidInputError) | the two regions overlap within one file             |
#
# ## Example
#
# ```
# open source.bin rb do |src|
#   open dest.bin wb do |dst|
#     # Splice a fixed region of the source onto wherever dst happens to be
#     copy_data $src $dst range: (0..4096)
#
#     # Copy the rest of src, advancing both cursors
#     let count = copy_data $src $dst
#     echo "copied $count bytes"
#
# open archive.bin r+b do |file|
#   # Both sides positional, so one handle can serve as both
#   copy_data $file $file range: (0..64) offset: 8192
# ```
pub def copy_data
  # ([`File`](fs.File)) Handle to read from.
  src
  # ([`File`](fs.File)) Handle to write to.
  dst
  # ([`Range`](std.Range)?) Absolute byte region of the source.
  #
  # ### Source Addressing
  #
  # | `range:` | `size:` | Source                                        |
  # | -------- | ------- | --------------------------------------------- |
  # | given    | —       | that absolute region                          |
  # | —        | given   | that many bytes from the cursor               |
  # | —        | —       | the cursor to the end of the file             |
  # | given    | given   | an error — a range already carries its length |
  #
  # `range:` follows the same conventions as
  # [`File.lock`](fs.File.lock): half-open, `..` is the whole file, an open
  # end means "to the end of the file", an omitted start is `0`, `step` must be
  # `1`, and endpoints counted from the end are rejected.
  #
  # Using cursor-based source addressing advances the cursor by the amount
  # copied on success.
  :range = nil
  # ([`Int`](std.Int)?) Number of bytes to take from the source cursor.
  :size = nil
  # ([`Int`](std.Int)?) Absolute byte offset in the destination.
  #
  # ### Destination Addressing
  #
  # `offset:` writes at an absolute position and leaves the destination cursor
  # where it was; without it the copy lands at the cursor, which advances. A
  # handle opened for appending does not support a specified offset.
  #
  # As expected, if the destination position would write past the current
  # end-of-file, the length of the file is extended.
  :offset = nil
  # ([`Sym`](std.Sym)?) How blocks should be shared between the source
  # and destination.
  #
  # ### Clone Behavior
  #
  # | Value       | Meaning                                                |
  # | ----------- | ------------------------------------------------------ |
  # | `:AUTO:`    | share blocks where possible, copy the data otherwise   |
  # | `:REQUIRE:` | fail rather than copy the data outright                |
  # | `:NEVER:`   | copy the data outright even where sharing is available |
  #
  # On Linux and FreeBSD, `:AUTO:` opportunistically performs copy-on-write
  # cloning for local filesystems and server-side copying for network mounts.
  # `:REQUIRE:` explicitly requests a copy-on-write clone and fails if not
  # possible. On Windows, `:AUTO:` opportunistically performs ReFS extent
  # duplication or SMB server-side copy when possible, while `:REQUIRE:` only
  # attempts the ReFS path (which may also work remotely). `:REQUIRE:` fails
  # with [`UnsupportedError`](sys.UnsupportedError) when the filesystem,
  # file pair, or range cannot be cloned. Append destinations cannot guarantee
  # cloning, so they also reject `:REQUIRE:`. macOS does not support range
  # clones, nor do copies between different VFS domains, and thus `:REQUIRE:`
  # always fails.
  #
  # ### Sparsity
  #
  # Positional copies on Linux, FreeBSD, Windows, and macOS targets preserve
  # source holes (unallocated data blocks containing only logical zero bytes)
  # when the filesystem exposes them, and replace existing destination data in
  # those holes with zeroes. Hole deallocation is best effort: when it is
  # unavailable the zeroes may consume physical storage. On Windows, a file
  # must be explicitly marked sparse to permit unallocated zero blocks; this
  # operation will not do so automatically.
  :clone = nil
do
  throw nil

# Truncates a file to the given byte length, creating it if needed.
#
# ## Example
#
# ```
# set_size "output.txt" 0
# set_size (Path "archive.bin") 1024
# ```
pub def set_size
  # ([`Str`](std.Str)\|[`Path`](fs.Path)) Path to the file.
  path
  # ([`Int`](std.Int)) New file length in bytes.
  size
do
  throw nil

# Flushes a file to durable storage, returning once the device reports it
# committed.
#
# The file must already exist — unlike [`set_size`](fs.set_size), this does not
# create it.
#
# Flushing the contents says nothing about the directory entry naming the file,
# which is a separate inode with its own flush. Nor is it a substitute for the
# guarantee on a filesystem with delayed allocation or write cancellation,
# where data written to a file that is removed before it is flushed may never
# be written at all.
#
# ## Example
#
# ```
# write scratch.bin $payload
# sync scratch.bin
# ```
pub def sync
  # ([`Str`](std.Str)\|[`Path`](fs.Path)) Path to the file.
  path
  # ([`Bool`](std.Bool)?) Flush data only, skipping unneeded metadata.
  #
  # A data-only flush (`fdatasync`) omits metadata a reader does not need to
  # find the contents — notably the modification time — and so can avoid a
  # second write to the inode. A size change is still flushed either way.
  # Defaults to `false`.
  :data = nil
do
  throw nil

# Checks whether a file or directory exists at the given path.
#
# ## Returns
#
# [`Bool`](std.Bool)
#
# ## Example
#
# ```
# if exists "temp.txt"
#   remove "temp.txt"
# ```
pub def exists
  # ([`Str`](std.Str)\|[`Path`](fs.Path)) Path to check.
  path
do
  throw nil

# Gets metadata for the given path.
#
# ## Returns
#
# [`Metadata`](fs.Metadata)
#
# ## Example
#
# ```
# let meta = metadata "data.txt"
# echo "Size: $(meta.size)"
#
# # Get symlink metadata without following
# let link_meta = metadata "link.txt" resolve: :LINK:
# echo "Link type: $(link_meta.type)"
# ```
pub def metadata
  # ([`Str`](std.Str)\|[`Path`](fs.Path)) Path to the file or
  # directory.
  path
  # (`:TARGET:`\|`:LINK:`?) [Resolution mode](fs.resolution-modes). Defaults to
  # `:TARGET:`.
  :resolve = nil
do
  throw nil

# Gets metadata for the filesystem containing the given path.
#
# ## Returns
#
# [`FsMetadata`](fs.FsMetadata)
#
# ## Errors
#
# | Exception                                          | Condition                           |
# | -------------------------------------------------- | ----------------------------------- |
# | [`sys.UnsupportedError`](sys.UnsupportedError) | On Linux, `resolve: :LINK:` is used |
#
# ## Example
#
# ```
# let meta = fs_metadata "data.txt"
# echo "Available: $(meta.available)"
# ```
pub def fs_metadata
  # ([`Str`](std.Str)\|[`Path`](fs.Path)) Path to resolve.
  path
  # (`:TARGET:`\|`:LINK:`?) [Resolution mode](fs.resolution-modes). Defaults to
  # `:TARGET:`.
  :resolve = nil
do
  throw nil

# Updates timestamps, permissions, ownership, and filesystem attributes.
#
# Unspecified metadata is left unchanged. Unix targets support `mode`, numeric
# or named `owner` and `group` values, and applicable filesystem attributes.
# Windows targets accept an account name or
# [`Sid`](security.windows.Sid) for `owner` and `group` and support
# applicable filesystem attributes. Unix supports `modified` and `accessed`
# timestamps; Windows also supports `created`.
#
# Paths are submitted from left to right and processing stops at the first
# error. Within each path, ownership, mode, attributes, and timestamps are
# applied in that order. Backends may use multiple system operations;
# atomicity and rollback behavior are unspecified.
#
# Clearing `sparse` on Windows may allocate storage for every hole. It can be
# expensive, may fail when the volume lacks space, and is not transactional.
#
# ## Errors
#
# | Exception                                             | Condition                                        |
# | ----------------------------------------------------- | ------------------------------------------------ |
# | [`sys.UnsupportedError`](sys.UnsupportedError) | The operation is used on an unsupported platform |
#
# ## Example
#
# ```
# update_metadata "script.sh" mode: 0o755 owner: "deploy" group: "deploy"
# update_metadata "one.txt" "two.txt" mode: 0o640
# update_metadata "data.txt" hidden: true
# update_metadata "link" group: "www-data" resolve: :LINK:
# update_metadata "artifact.tar" modified: $DateTime.from_unix(1700000000)
# ```
pub def update_metadata
  # (`:TARGET:`\|`:LINK:`?) [Resolution mode](fs.resolution-modes). Defaults to
  # `:TARGET:`.
  :resolve = nil
  # ([`Int`](std.Int)\|[`Mode`](fs.unix.Mode)?) Unix permission mode.
  :mode = nil
  # ([`Int`](std.Int)\|[`Str`](std.Str)\|[`Sid`](security.windows.Sid)?)
  # Owner ID, name, or SID.
  :owner = nil
  # ([`Int`](std.Int)\|[`Str`](std.Str)\|[`Sid`](security.windows.Sid)?)
  # Group ID, name, or SID.
  :group = nil
  # ([`DateTime`](time.DateTime)?) New modification time.
  :modified = nil
  # ([`DateTime`](time.DateTime)?) New access time.
  :accessed = nil
  # ([`DateTime`](time.DateTime)?) New creation time. Windows only.
  :created = nil
  # ([`Bool`](std.Bool)?) Readonly attribute. Windows.
  :readonly = nil
  # ([`Bool`](std.Bool)?) Hidden attribute or flag.
  :hidden = nil
  # ([`Bool`](std.Bool)?) System attribute. Windows.
  :system = nil
  # ([`Bool`](std.Bool)?) Archive attribute. Windows.
  :archive = nil
  # ([`Bool`](std.Bool)?) Compressed flag.
  :compressed = nil
  # ([`Bool`](std.Bool)?) Sparse attribute. Windows.
  :sparse = nil
  # ([`Bool`](std.Bool)?) Temporary attribute. Windows.
  :temporary = nil
  # ([`Bool`](std.Bool)?) Offline attribute. Windows.
  :offline = nil
  # ([`Bool`](std.Bool)?) Not-content-indexed attribute. Windows.
  :not_content_indexed = nil
  # ([`Bool`](std.Bool)?) Immutable flag.
  :immutable = nil
  # ([`Bool`](std.Bool)?) Append-only flag.
  :append_only = nil
  # ([`Bool`](std.Bool)?) No-dump flag.
  :no_dump = nil
  # ([`Bool`](std.Bool)?) No-atime flag. Linux.
  :no_atime = nil
  # ([`Bool`](std.Bool)?) No-copy-on-write flag. Linux.
  :no_copy_on_write = nil
  # ([`Bool`](std.Bool)?) Synchronous-directory-updates flag. Linux.
  :dir_sync = nil
  # ([`Bool`](std.Bool)?) Casefold flag. Linux.
  :casefold = nil
  # ([`Bool`](std.Bool)?) Data-journaling flag. Linux.
  :data_journaling = nil
  # ([`Bool`](std.Bool)?) Don't-compress flag. Linux.
  :no_compress = nil
  # ([`Bool`](std.Bool)?) Project-hierarchy flag. Linux.
  :project_inherit = nil
  # ([`Bool`](std.Bool)?) Secure-deletion flag. Linux.
  :secure_delete = nil
  # ([`Bool`](std.Bool)?) Synchronous-updates flag. Linux.
  :sync = nil
  # ([`Bool`](std.Bool)?) No-tail-merging flag. Linux.
  :no_tail_merge = nil
  # ([`Bool`](std.Bool)?) Top-of-directory-hierarchy flag. Linux.
  :top_dir = nil
  # ([`Bool`](std.Bool)?) Undeletable flag. Linux.
  :undelete = nil
  # ([`Bool`](std.Bool)?) Direct-access flag. Linux.
  :direct_access = nil
  # ([`Bool`](std.Bool)?) Extent-format flag. Linux.
  :extent_format = nil
  # ([`Bool`](std.Bool)?) Opaque flag. macOS.
  :opaque = nil
  # ([`Str`](std.Str)\|[`Path`](fs.Path)) Paths to update, in order.
  ...paths
do
  throw nil

# Gets the ACL stored on a path.
#
# POSIX ACLs (`kind: :POSIX:`, the default) are supported on Linux and FreeBSD.
# NFSv4 ACLs (`kind: :NFS4:`) are supported on FreeBSD only. macOS ACLs
# (`kind: :MACOS:`) are supported on macOS only.
#
# ## Returns
#
# [`security.unix.Acl`](security.unix.Acl),
# [`security.nfs4.Acl`](security.nfs4.Acl), or
# [`security.macos.Acl`](security.macos.Acl), depending on `kind`, or
# `nil` when no ACL metadata is stored.
#
# ## Errors
#
# | Exception                                             | Condition                                                    |
# | ----------------------------------------------------- | ------------------------------------------------------------ |
# | [`ValueError`](std.ValueError)                 | `kind: :NFS4:` or `:MACOS:` is combined with `default: true` |
# | [`sys.UnsupportedError`](sys.UnsupportedError) | The target and ACL format combination is unsupported         |
pub def acl
  # ([`Str`](std.Str)\|[`Path`](fs.Path)) Path to query.
  path
  # (`:POSIX:`\|`:NFS4:`\|`:MACOS:`?) ACL format to query. Defaults to
  # `:POSIX:`.
  :kind = nil
  # ([`Bool`](std.Bool)?) Query the directory's inheritable default ACL.
  :default = nil
  # (`:TARGET:`\|`:LINK:`?) [Resolution mode](fs.resolution-modes). Defaults to
  # `:TARGET:`.
  :resolve = nil
do
  throw nil

# Sets or removes an ACL.
#
# A built ACL supplies its format; an explicit `kind:` must match it. An
# untyped iterable of declarative ACE dictionaries requires an explicit `kind:`
# and is coerced by that ACL family. With `nil`, `kind:` selects the format to
# remove and defaults to `:POSIX:`.
#
# POSIX ACLs are supported on Linux and FreeBSD, NFSv4 ACLs on FreeBSD, and
# macOS ACLs on macOS. Other target and format combinations raise
# [`sys.UnsupportedError`](sys.UnsupportedError).
#
# ## Errors
#
# | Exception                                             | Condition                                                                                                       |
# | ----------------------------------------------------- | --------------------------------------------------------------------------------------------------------------- |
# | [`ValueError`](std.ValueError)                 | An NFSv4/macOS ACL is combined with `default: true`                                                             |
# | [`ValueError`](std.ValueError)                 | A built ACL conflicts with the explicit `kind:`                                                                 |
# | [`TypeError`](std.TypeError)                   | An untyped ACL specification is passed without `kind:`                                                          |
# | [`sys.UnsupportedError`](sys.UnsupportedError) | An NFSv4 ACL is removed with `kind: :NFS4:` and `acl: nil`; NFSv4 ACLs can be replaced but not cleared to "none" |
pub def set_acl
  # ([`Str`](std.Str)\|[`Path`](fs.Path)) Path to update.
  path
  # (built ACL\|iterable\|[`nil`](std.Nil)) ACL or declarative ACE
  # sequence.
  acl
  # (`:POSIX:`\|`:NFS4:`\|`:MACOS:`?) Required for an untyped ACL
  # specification.
  :kind = nil
  # ([`Bool`](std.Bool)?) Update the directory's inheritable default ACL.
  :default = nil
  # (`:TARGET:`\|`:LINK:`?) [Resolution mode](fs.resolution-modes). Defaults to
  # `:TARGET:`.
  :resolve = nil
do
  throw nil

