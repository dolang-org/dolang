# Returns the platform-native user cache directory.
#
# ## Example
#
# ```
# let cache = cache_dir app: blastinator8000
# echo "Cache: $cache"
# ```
pub def cache_dir
  # Application name to scope the result to.
  #
  # ### Platform behavior
  #
  # Without `app`, the base directories are:
  #
  # | Platform       | Result                                                                  |
  # | -------------- | ----------------------------------------------------------------------- |
  # | Non-macOS Unix | `$XDG_CACHE_HOME`, otherwise `~/.cache`                                 |
  # | macOS          | `(home_dir() / "Library" / "Caches")`                                   |
  # | Windows        | `FOLDERID_LocalAppData`, typically `(home_dir() / "AppData" / "Local")` |
  #
  # With `app: myapp`:
  #
  # | Platform       | Result                              |
  # | -------------- | ----------------------------------- |
  # | Non-macOS Unix | `(cache_dir() / "myapp")`           |
  # | macOS          | `(cache_dir() / "myapp")`           |
  # | Windows        | `(cache_dir() / "myapp" / "Cache")` |
  :app @ Str = nil
do -> Path
  ...

# Creates a temporary directory and returns its path.
#
# Unlike [`with_temp_dir`](fs.with_temp_dir), this does not remove the directory
# — the caller owns its lifetime.
#
# ## Example
#
# ```
# let dir = create_temp_dir()
# try
#   let file = (dir / "test.txt")
#   file.open w do |f|
#     f.write "Hello, World!"
# finally
#   remove_dir $dir all: true
# ```
pub def create_temp_dir
  # Parent directory. Defaults
  # to [`temp_dir()`](fs.temp_dir).
  :parent @ (Str | Path) = nil
do -> Path
  ...

# Creates a temporary directory, invokes a function with the directory path,
# then removes the directory recursively upon return or error.
#
# ## Example
#
# ```
# # Use the temporary directory in the default location
# with_temp_dir do |dir|
#   let file = (dir / "test.txt")
#   file.open w do |f|
#     f.write "Hello, World!"
#   echo "Wrote to: $file"
#
# # Use a custom parent directory
# with_temp_dir parent: my_temp do |dir|
#   echo $dir
# ```
pub def with_temp_dir[R]
  # Called with a [`Path`](fs.Path) to the
  # temporary directory.
  func @ (Path -> R)
  # Parent directory. Defaults
  # to [`temp_dir()`](fs.temp_dir).
  :parent @ (Str | Path) = nil
do -> R
  ...
