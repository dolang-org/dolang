# Opens a file.
#
# ## Returns
#
# [`File`](fs.File), or the block's result when `func` is given.
#
# ## Example
#
# ```
# # Read a file (auto-closed when the block finishes)
# open config.txt r do |file|
#   echo "Content: $(file.read())"
#
# # Manual file management
# let file = open data.txt w
# file.write "some data"
# file.close()
# ```
pub def open
  # ([`Str`](std.Str)\|[`Path`](fs.Path)) Path to the file to open.
  path
  # ([`Str`](std.Str)?) File access mode. Defaults to `"r"`.
  #
  # | Mode   | Description                              |
  # | ------ | ---------------------------------------- |
  # | `"r"`  | Read-only                                |
  # | `"w"`  | Write-only (truncates existing file)     |
  # | `"a"`  | Append to existing file                  |
  # | `"r+"` | Read and write                           |
  # | `"w+"` | Read and write (truncates existing file) |
  # | `"a+"` | Read and append                          |
  #
  # Add a `"b"` suffix for binary mode, as in `"rb"`, `"wb"`, or `"r+b"`.
  mode = nil
  # ([`Func`](std.Func)?) Block to run with the file; it is closed when
  # the block returns.
  func = nil
do
  throw nil

