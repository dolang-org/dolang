# ## Returns
#
# [`Path`](fs.Path)
#
# ## Example
#
# ```
# let abs = absolute "./config.txt"
# echo $abs  # /current/working/dir/config.txt
# ```
pub def absolute
  # ([`Str`](std.Str)\|[`Path`](fs.Path)) Path to make absolute.
  path
do
  throw nil

# Returns the canonical, absolute form of a path, with all intermediate
# components normalized and symbolic links resolved.
#
# ## Returns
#
# [`Path`](fs.Path)
#
# ## Example
#
# ```
# let abs = canonical "./foo/../bar"
# echo $abs  # /current/working/dir/bar (with symlinks resolved)
# ```
pub def canonical
  # ([`Str`](std.Str)\|[`Path`](fs.Path)) Path to canonicalize.
  path
do
  throw nil

# Returns a normalized path with `.` and `..` components resolved without
# accessing the filesystem.
#
# Unresolvable `..` components in relative paths are preserved.
#
# ## Returns
#
# [`Path`](fs.Path)
#
# ## Example
#
# ```
# let clean = normalize "./foo/../bar/./baz"
# echo $clean  # bar/baz
# ```
pub def normalize
  # ([`Str`](std.Str)\|[`Path`](fs.Path)) Path to normalize.
  path
do
  throw nil

# Returns a path relative to a base directory.
#
# ## Returns
#
# [`Path`](fs.Path), or the original path if it cannot be made relative.
#
# ## Example
#
# ```
# # Relative to the current directory
# let rel = relative "/home/user/docs/file.txt"
# echo $rel  # docs/file.txt (if cwd is /home/user)
#
# # Relative to a specific base
# let rel2 = relative "/a/b/c/d" "/a/b"
# echo $rel2  # c/d
# ```
pub def relative
  # ([`Str`](std.Str)\|[`Path`](fs.Path)) Path to make relative.
  path
  # ([`Str`](std.Str)\|[`Path`](fs.Path)?) Base directory. Defaults to
  # the current working directory.
  base = nil
do
  throw nil

# Returns the current user's home directory.
#
# | Platform | Result                                                          |
# | -------- | --------------------------------------------------------------- |
# | Unix     | `env["HOME"]`, or the home directory from the passwd database   |
# | Windows  | `FOLDERID_Profile`, typically `C:\Users\<user>`                 |
#
# ## Returns
#
# [`Path`](fs.Path)
pub def home_dir()
  throw nil

# Returns the platform-native directory for temporary files.
#
# | Platform | Result                                                      |
# | -------- | ----------------------------------------------------------- |
# | Unix     | `$TMPDIR`, otherwise `/tmp`                                 |
# | Windows  | `%TMP%`, otherwise `%TEMP%`, otherwise the platform default |
#
# ## Returns
#
# [`Path`](fs.Path)
pub def temp_dir()
  throw nil

# Returns the platform-native user cache directory.
#
# ## Returns
#
# [`Path`](fs.Path)
#
# ## Example
#
# ```
# let cache = cache_dir app: blastinator8000
# echo "Cache: $cache"
# ```
pub def cache_dir
  # ([`Str`](std.Str)?) Application name to scope the result to.
  #
  # ### Platform behavior
  #
  # Without `app`, the base directories are:
  #
  # | Platform       | Result                                                                  |
  # | -------------- | ----------------------------------------------------------------------- |
  # | Non-macOS Unix | `$XDG_CACHE_HOME`, otherwise `~/.cache`                                 |
  # | macOS          | `(home_dir() / "Library" / "Caches")`                                   |
  # | Windows        | `FOLDERID_LocalAppData`, typically `(home_dir() / "AppData" / "Local")` |
  #
  # With `app: myapp`:
  #
  # | Platform       | Result                              |
  # | -------------- | ----------------------------------- |
  # | Non-macOS Unix | `(cache_dir() / "myapp")`           |
  # | macOS          | `(cache_dir() / "myapp")`           |
  # | Windows        | `(cache_dir() / "myapp" / "Cache")` |
  :app = nil
do
  throw nil

# Creates a temporary directory and returns its path.
#
# Unlike [`with_temp_dir`](fs.with_temp_dir), this does not remove the directory
# — the caller owns its lifetime.
#
# ## Returns
#
# [`Path`](fs.Path)
#
# ## Example
#
# ```
# let dir = create_temp_dir()
# try
#   let file = (dir / "test.txt")
#   file.open w do |f|
#     f.write "Hello, World!"
# finally
#   remove_dir $dir all: true
# ```
pub def create_temp_dir
  # ([`Str`](std.Str)\|[`Path`](fs.Path)?) Parent directory. Defaults
  # to [`temp_dir()`](fs.temp_dir).
  :parent = nil
do
  throw nil

# Creates a temporary directory, invokes a function with the directory path,
# then removes the directory recursively upon return or error.
#
# ## Example
#
# ```
# # Use the temporary directory in the default location
# with_temp_dir do |dir|
#   let file = (dir / "test.txt")
#   file.open w do |f|
#     f.write "Hello, World!"
#   echo "Wrote to: $file"
#
# # Use a custom parent directory
# with_temp_dir parent: my_temp do |dir|
#   echo $dir
# ```
pub def with_temp_dir
  # ([`Func`](std.Func)) Called with a [`Path`](fs.Path) to the
  # temporary directory.
  func
  # ([`Str`](std.Str)\|[`Path`](fs.Path)?) Parent directory. Defaults
  # to [`temp_dir()`](fs.temp_dir).
  :parent = nil
do
  throw nil
