# Filesystem access: paths, files, directories, metadata, and permissions.
#
# Ordinary metadata such as size, timestamps, ownership, permissions, and file
# attributes are available through [`Metadata`](fs.Metadata) and
# [`update_metadata`](fs.update_metadata). Extended attributes use
# [`xattrs`](fs.xattrs) and related functions. POSIX and NFSv4 ACLs use
# [`acl`](fs.acl) and [`set_acl`](fs.set_acl). Windows security descriptors can
# also be fetched and manipulated with full fidelity; see
# [`fs.windows.sec_desc`](fs.windows.sec_desc) and the
# [Security Guide](../../shell/security.md). Windows alternate data streams
# are listed with [`streams`](fs.streams).
#
# ## Resolution modes {: #fs.resolution-modes }
#
# Many functions accept a `resolve:` parameter that controls how symbolic links
# and other recursive path resolution is handled. Two values are accepted:
#
# - **`:TARGET:`** — Resolve all links to their final target. This is the
#   default for most functions.
# - **`:LINK:`** — Resolve all links except the final component. For example,
#   given a symlink `link -> target`, `metadata link resolve: :LINK:` returns
#   the link's own metadata rather than the target's. This is the default for
#   `glob`.
#
# On Unix, `:LINK:` corresponds to `lstat`-style behavior. On Windows, it
# applies to both symbolic links and other reparse points such as directory
# junctions.

# An entry within a directory.
#
# Yielded by [`entries`](fs.entries) and
# [`Path.entries`](fs.Path.entries).
#
# ## Operators
#
# `path / entry` returns the derived [`Path`](fs.Path) for that directory
# entry:
#
# ```
# let dir = Path ./src
# for entry = dir.entries()
#   echo (dir / entry)
# ```
pub class DirEntry
  # ([`Str`](std.Str)) The final path component for the entry.
  #
  # ```
  # for entry = entries .
  #   echo "Name: $(entry.name)"
  # ```
  #[getter]
  pub def name self
    throw nil

  # ([`Sym`](std.Sym)) The file type.
  #
  # | Value            | Description                  |
  # | ---------------- | ---------------------------- |
  # | `:FILE:`         | Regular file                 |
  # | `:DIR:`          | Directory                    |
  # | `:SYMLINK:`      | Symbolic link                |
  # | `:FIFO:`         | Named pipe (FIFO)            |
  # | `:CHAR_DEVICE:`  | Character device             |
  # | `:BLOCK_DEVICE:` | Block device                 |
  # | `:SOCKET:`       | Unix domain socket           |
  # | `:UNKNOWN:`      | Type could not be determined |
  #
  # ```
  # for entry = entries .
  #   if (entry.type == :DIR:)
  #     echo "Directory: $(entry.name)"
  # ```
  #[getter]
  pub def type self
    throw nil

  # ([`Int`](std.Int)) The inode number of the entry.
  #
  # Unix only: reading it against a Windows target raises
  # [`FieldError`](std.FieldError).
  #[getter]
  pub def ino self
    throw nil

# An open file.
#
# Returned by [`open`](fs.open) and [`Path.open`](fs.Path.open).
# Every operation on a closed file raises
# [`StateError`](std.StateError).
#
# A file is both an iterator and a sink, so it can be used with `for`,
# `.next()`, `.put()`, and `strand.redirect`. The open mode fixes which for the
# file's lifetime: a text-mode file yields and accepts lines, a binary-mode one
# arbitrary chunks. In either mode the values read from a file concatenate back
# to exactly the file's bytes.
pub class File
  # Closes the file.
  #
  # This is required if [`open`](fs.open) was not given a block.
  # Closing a file that is already closed does nothing.
  #
  # Passing a file to a child process as `stdin:`, `stdout:`, or `stderr:` also
  # closes it: the child receives the file itself, and the seek position is
  # kept by this process rather than by the operating system, so two live
  # handles would each believe a cursor the other moves. Use the file after the
  # handoff and it raises the ordinary closed-file error.
  #
  # ## Example
  #
  # ```
  # let file = open data.txt r
  # let data = file.read()
  # file.close()
  # ```
  pub def close self
    throw nil

  # Acquires a byte-range lock while `func` runs.
  #
  # ## Returns
  #
  # The block's result.
  #
  # The lock is exclusive unless `shared` is true. It is released before the
  # method returns, including when the block raises an error or is canceled.
  # Release runs with interruption masked and may wait indefinitely.
  #
  # Locks are mandatory on Windows, where they prevent conflicting file access.
  # On Unix they are advisory and affect only programs that cooperate through
  # file locking.
  #
  # Native blocking acquisition cannot be canceled. Canceling the strand may
  # leave a blocking worker waiting for a conflicting lock and delay shutdown.
  # Use [`try_lock`](fs.File.try_lock) for bounded or cancellable waiting.
  #
  # Overlapping active lock ranges on the same file are unsupported, including
  # identical shared ranges.
  #
  # Finite zero-length ranges are invalid on Unix. On Windows they conflict
  # only with positive-length ranges that start before and end after their
  # offset. They do not conflict with another zero-length range or a range
  # starting at the same offset. The zero-length range `0..0` is invalid.
  #
  # ## Example
  #
  # ```
  # file.lock (0..128) do |lock|
  #   update_header()
  # ```
  pub def lock
    self
    # ([`Range`](std.Range)) Half-open byte range; `..` is the whole
    # file.
    range
    # ([`Func`](std.Func)) Block receiving a
    # [`FileLock`](fs.FileLock).
    func
    # ([`Bool`](std.Bool)?) Acquire a shared rather than exclusive lock.
    :shared = nil
  do
    throw nil

  # Attempts to acquire a byte-range lock without waiting.
  #
  # ## Returns
  #
  # The block's result.
  #
  # The block always runs. [`lock.held`](fs.FileLock.held) is false when
  # another handle holds a conflicting lock. Other acquisition failures raise
  # errors.
  #
  # ## Example
  #
  # ```
  # file.try_lock (..) do |lock|
  #   if lock.held
  #     update_index()
  # ```
  pub def try_lock
    self
    # ([`Range`](std.Range)) Half-open byte range; `..` is the whole
    # file.
    range
    # ([`Func`](std.Func)) Block receiving a
    # [`FileLock`](fs.FileLock).
    func
    # ([`Bool`](std.Bool)?) Acquire a shared rather than exclusive lock.
    :shared = nil
  do
    throw nil

  # Reads data from the file.
  #
  # ## Returns
  #
  # [`Str`](std.Str) in text mode, [`Bin`](std.Bin) in binary mode.
  #
  # ## Example
  #
  # ```
  # # Read entire file
  # open input.txt r do |file|
  #   let content = file.read()
  #   echo "File contents: $content"
  #
  # # Read a specific number of bytes
  # open data.bin rb do |file|
  #   let header = file.read 4
  #   let rest = file.read()
  #
  # # Read a record without moving the cursor
  # open data.bin rb do |file|
  #   let record = file.read 64 offset: (index * 64)
  # ```
  pub def read
    self
    # ([`Int`](std.Int)?) Number of bytes to read. Without it, reads to
    # the end of the file.
    #
    # `size` bytes are read however many transfers that takes; a shorter result
    # means the end of the file was reached, and reading entirely past the end
    # gives an empty result rather than an error.
    size = nil
    # ([`Int`](std.Int)?) Byte offset to read from. Without it, reads at
    # the cursor and advances it.
    #
    # A positional read leaves the cursor where it was, so it can be used
    # alongside streaming reads on the same handle, and several regions of a
    # file can be read without seeking between them.
    #
    # Because a positional read touches nothing shared, any number of them may
    # be in flight on one handle at once — several strands can read different
    # regions of the same open file concurrently. Streaming reads still take
    # the handle exclusively, since they move the cursor.
    #
    # In text mode the bytes read must be complete UTF-8. There is no cursor
    # for a positional read to carry a split character forward on, so unlike a
    # streaming read it cannot hold a partial character back for next time.
    :offset = nil
  do
    throw nil

  # Writes data to the file.
  #
  # All of `data` is written, however many transfers that takes.
  #
  # ## Returns
  #
  # [`Int`](std.Int), the number of bytes written.
  #
  # ## Errors
  #
  # | Exception                             | Condition                                |
  # | ------------------------------------- | ---------------------------------------- |
  # | [`StateError`](std.StateError) | `offset:` on a file opened for appending |
  #
  # An append handle writes at the end of the file no matter what offset the
  # platform is given, so an explicit one cannot be honored rather than merely
  # being unimplemented.
  #
  # ## Example
  #
  # ```
  # open output.txt w do |file|
  #   let bytes_written = file.write "Hello, World!"
  #   echo "Wrote $bytes_written bytes"
  #   file.write b"Hello"
  #
  # # Patch a record in place without disturbing the cursor
  # open data.bin r+b do |file|
  #   file.write $record offset: (index * 64)
  # ```
  pub def write
    self
    # ([`Str`](std.Str)\|[`Bin`](std.Bin)) Data to write. Strings
    # are written as UTF-8 text.
    data
    # ([`Int`](std.Int)?) Byte offset to write at. Without it, writes at
    # the cursor and advances it.
    #
    # A positional write leaves the cursor where it was, so it can be used
    # alongside streaming writes on the same handle, and several regions of a
    # file can be written without seeking between them. Writing past the end
    # extends the file, zero-filling the gap.
    #
    # As with [`read`](fs.File.read), any number of positional writes may be
    # in flight on one handle at once.
    :offset = nil
  do
    throw nil

  # The method form of [`fs.copy_data`](fs.copy_data).
  pub def copy_data
    self
    # ([`File`](fs.File)) Handle to write to.
    dst
    # ([`Range`](std.Range)?) Absolute byte region of the source.
    :range = nil
    # ([`Int`](std.Int)?) Number of bytes to take from the source cursor.
    :size = nil
    # ([`Int`](std.Int)?) Absolute byte offset in the destination.
    :offset = nil
    # ([`Sym`](std.Sym)?) `:AUTO:` (default), `:REQUIRE:`, or `:NEVER:`.
    :clone = nil
  do
    throw nil

  # Truncates the file to the given byte length.
  #
  # If the file has buffered unread data, the logical cursor position is
  # preserved after truncation.
  #
  # ## Example
  #
  # ```
  # open data.bin r+ do |file|
  #   file.set_size 8
  # ```
  pub def set_size
    self
    # ([`Int`](std.Int)) New file length in bytes.
    size
  do
    throw nil

  # Flushes the file to durable storage, returning once the device reports it
  # committed.
  #
  # ## Example
  #
  # ```
  # open journal.bin w do |file|
  #   file.write $entry
  #   file.sync()
  # ```
  pub def sync
    self
    # ([`Bool`](std.Bool)?) Flush data only, skipping unneeded metadata.
    # See [`fs.sync`](fs.sync) for what this selects and what a flush
    # does and does not guarantee.
    :data = nil
  do
    throw nil

  # Gets metadata for the open file.
  #
  # ## Returns
  #
  # [`Metadata`](fs.Metadata)
  #
  # ## Example
  #
  # ```
  # open data.txt r do |file|
  #   let meta = file.metadata()
  #   echo "Size: $(meta.size)"
  #   echo "Modified: $(meta.modified)"
  # ```
  pub def metadata self
    throw nil

  # Gets filesystem metadata for the filesystem backing the open file.
  #
  # ## Returns
  #
  # [`FsMetadata`](fs.FsMetadata)
  #
  # ## Example
  #
  # ```
  # open data.txt r do |file|
  #   let meta = file.fs_metadata()
  #   echo "Available: $(meta.available)"
  # ```
  pub def fs_metadata self
    throw nil

  # Gets selected parts of the Windows security descriptor through this file's
  # existing handle.
  #
  # ## Returns
  #
  # [`security.windows.SecDesc`](security.windows.SecDesc)
  #
  # The operation raises a permission error if the file was opened without the
  # necessary Windows access rights. Other platforms raise
  # [`sys.UnsupportedError`](sys.UnsupportedError).
  pub def sec_desc
    self
    # ([`Bool`](std.Bool)?) Load the owner SID. Defaults to `true`.
    :owner = nil
    # ([`Bool`](std.Bool)?) Load the primary group SID. Defaults to
    # `true`.
    :group = nil
    # ([`Bool`](std.Bool)?) Load the discretionary ACL. Defaults to
    # `true`.
    :dacl = nil
    # ([`Bool`](std.Bool)?) Load the system ACL. Defaults to `false`.
    :sacl = nil
  do
    throw nil

  # Applies the components selected by a security descriptor's `mask` through
  # this file's existing handle.
  #
  # The descriptor's
  # [component options](security.windows.SecDesc.(init)--component-options) may
  # be passed as keyword arguments instead of, or alongside, `desc`, exactly as
  # [`security.windows.sec_desc`](security.windows.sec_desc)
  # accepts them.
  #
  # The operation raises a permission error if the file was opened without the
  # necessary Windows access rights. Windows may normalize the resulting
  # descriptor. Other platforms raise
  # [`sys.UnsupportedError`](sys.UnsupportedError).
  pub def update_sec_desc
    self
    # ([`security.windows.SecDesc`](security.windows.SecDesc)\|[`Bin`](std.Bin)\|[`Dict`](std.Dict)?)
    # Descriptor, packet, or spec.
    desc = nil
  do
    throw nil

  # Gets the ACL stored on the open file.
  #
  # ## Returns
  #
  # The matching portable ACL type, depending on `kind`, or `nil` when no ACL
  # metadata is stored.
  pub def acl
    self
    # (`:POSIX:`\|`:NFS4:`\|`:MACOS:`?) ACL format to query. Defaults to
    # `:POSIX:`.
    :kind = nil
    # ([`Bool`](std.Bool)?) Query the directory's inheritable default
    # ACL.
    :default = nil
  do
    throw nil

  # Sets or removes an ACL on the open file.
  #
  # A built ACL supplies its format and must match an explicit `kind:`. An
  # untyped sequence of declarative ACE dictionaries requires `kind:`. With
  # `nil`, the omitted kind remains POSIX.
  pub def set_acl
    self
    # (built ACL\|iterable\|[`nil`](std.Nil)) ACL or declarative ACE
    # sequence.
    acl
    # (`:POSIX:`\|`:NFS4:`\|`:MACOS:`?) Required for an untyped ACL
    # specification.
    :kind = nil
    # ([`Bool`](std.Bool)?) Update the directory's inheritable default
    # ACL.
    :default = nil
  do
    throw nil

  # Lists extended attributes for this file.
  #
  # On Windows, this uses NTFS extended attributes. Returned names may differ
  # in case from the requested name.
  #
  # ## Returns
  #
  # [`Iter`](std.Iter) of [`XattrEntry`](fs.XattrEntry)
  #
  # ## Example
  #
  # ```
  # open data.txt r do |file|
  #   for attr = file.xattrs()
  #     echo $attr.name
  # ```
  pub def xattrs
    self
    # ([`Str`](std.Str)\|[`Sym`](std.Sym)?) Namespace to query;
    # `:USER:` and `:SYSTEM:` name well-known namespaces, and `:ANY:` lists all
    # namespaces.
    :namespace = nil
  do
    throw nil

  # Gets an extended attribute value.
  #
  # ## Returns
  #
  # [`Bin`](std.Bin)
  #
  # ## Example
  #
  # ```
  # open data.txt r do |file|
  #   let value = file.xattr "comment"
  # ```
  pub def xattr
    self
    # ([`Str`](std.Str)\|[`XattrEntry`](fs.XattrEntry)) Attribute name
    # or entry from [`xattrs`](fs.File.xattrs).
    name
    # ([`Str`](std.Str)\|[`Sym`](std.Sym)?) Namespace to query.
    :namespace = nil
  do
    throw nil

  # Sets an extended attribute value.
  #
  # On Windows, empty values are rejected. NTFS deletes the attribute instead
  # of storing an empty value.
  #
  # ## Example
  #
  # ```
  # open data.txt r+ do |file|
  #   file.set_xattr "comment" "ready"
  # ```
  pub def set_xattr
    self
    # ([`Str`](std.Str)\|[`XattrEntry`](fs.XattrEntry)) Attribute name
    # or entry from [`xattrs`](fs.File.xattrs).
    name
    # ([`Str`](std.Str)\|[`Bin`](std.Bin)) Attribute bytes; strings
    # use UTF-8.
    value
    # ([`Str`](std.Str)\|[`Sym`](std.Sym)?) Namespace to update.
    :namespace = nil
  do
    throw nil

  # Removes an extended attribute.
  #
  # ## Example
  #
  # ```
  # open data.txt r+ do |file|
  #   file.remove_xattr "comment"
  # ```
  pub def remove_xattr
    self
    # ([`Str`](std.Str)\|[`XattrEntry`](fs.XattrEntry)) Attribute name
    # or entry from [`xattrs`](fs.File.xattrs).
    name
    # ([`Str`](std.Str)\|[`Sym`](std.Sym)?) Namespace to update.
    :namespace = nil
  do
    throw nil

  # Lists alternate data streams for this file.
  #
  # Windows only.
  #
  # ## Returns
  #
  # [`Iter`](std.Iter) of
  # [`fs.windows.StreamEntry`](fs.windows.StreamEntry)
  #
  # ## Example
  #
  # ```
  # let path = Path data.txt
  # open $path r do |file|
  #   for stream = file.streams()
  #     echo (path / stream)
  # ```
  pub def streams self
    throw nil

  # Returns the current cursor position in bytes.
  #
  # ## Returns
  #
  # [`Int`](std.Int)
  #
  # ## Example
  #
  # ```
  # open data.txt r do |file|
  #   assert_eq (file.tell()) 0
  #   file.read 5
  #   assert_eq (file.tell()) 5
  # ```
  pub def tell self
    throw nil

  # Moves the file cursor.
  #
  # Buffered unread data is discarded before the seek so subsequent reads use
  # the new cursor position.
  #
  # ## Returns
  #
  # [`Int`](std.Int), the new absolute byte position.
  #
  # ## Example
  #
  # ```
  # open data.bin rb do |file|
  #   file.seek start: 10   # absolute
  #   file.seek 10          # relative to the cursor
  #   file.seek (0 - 4)     # backwards
  #   file.seek end: (0 - 1)  # relative to the end
  # ```
  pub def seek
    self
    # ([`Int`](std.Int)?) Byte offset relative to the current position.
    offset = nil
    # ([`Int`](std.Int)?) Absolute byte offset from the start of the
    # file.
    :start = nil
    # ([`Int`](std.Int)?) Byte offset relative to the end of the file.
    :end = nil
  do
    throw nil

  # Returns the file as its own iterator.
  pub def (iter) self
    throw nil

  # Fetches the next value from the file.
  #
  # In text mode this reads the next line as a [`Str`](std.Str),
  # **including its terminator**, so a `\r\n` file stays `\r\n` and a final
  # line without one yields a value without one. Use
  # [`chomp`](std.Iter.chomp) to strip them:
  #
  # ```
  # for line = file.chomp()
  #   echo $line
  # ```
  #
  # In binary mode it reads a chunk of data of arbitrary length.
  pub def (next) self
    throw nil

  # Returns the file as its own sink.
  pub def (sink) self
    throw nil

  # Writes a value to the file, verbatim.
  #
  # A [`Str`](std.Str) or [`Bin`](std.Bin) contributes its own
  # bytes and nothing else, and anything else is converted to a string first.
  # No line ending is appended in either mode, and none is translated.
  #
  # Use [`precrimp`](std.Sink.precrimp) to terminate written values, with
  # [`shell.line_ending()`](shell.line_ending) for the target's
  # native ending:
  #
  # ```
  # open $path w do |file|
  #   let lines = file.precrimp()
  #   lines.put "first"
  #   lines.put "second"
  # ```
  pub def (put)
    self
    # Value to write.
    value
  do
    throw nil

# The state of a scoped [`File`](fs.File) lock.
#
# Passed to the block given to [`File.lock`](fs.File.lock) and
# [`File.try_lock`](fs.File.try_lock).
pub class FileLock
  # ([`Bool`](std.Bool)) Whether the lock is currently held.
  #
  # The value is false when [`try_lock`](fs.File.try_lock) does not acquire
  # the lock, and after releasing it.
  #[getter]
  pub def held self
    throw nil

  # Releases the lock before the surrounding scope exits.
  #
  # Repeated calls have no effect. Release runs with interruption masked.
  pub def release self
    throw nil

# Metadata about a filesystem as a whole.
#
# Returned by [`fs_metadata`](fs.fs_metadata),
# [`Path.fs_metadata`](fs.Path.fs_metadata), and
# [`File.fs_metadata`](fs.File.fs_metadata). For metadata about a single file
# entry, use [`Metadata`](fs.Metadata).
#
# Accessing a field that does not apply to the target platform raises
# [`FieldError`](std.FieldError).
pub class FsMetadata
  # ([`Int`](std.Int)) Total filesystem capacity in bytes.
  #[getter]
  pub def capacity self
    throw nil

  # ([`Int`](std.Int)) Total free space in bytes, including space
  # reserved from unprivileged users.
  #[getter]
  pub def free self
    throw nil

  # ([`Int`](std.Int)) Free space available to the current process in
  # bytes.
  #[getter]
  pub def available self
    throw nil

  # ([`Int`](std.Int)?) Filesystem block size in bytes when available.
  #[getter]
  pub def block_size self
    throw nil

  # ([`Bool`](std.Bool)) Whether the filesystem is mounted read-only.
  #[getter]
  pub def read_only self
    throw nil

  # ([`Int`](std.Int)) Total data blocks. Unix only.
  #[getter]
  pub def blocks self
    throw nil

  # ([`Int`](std.Int)) Free data blocks, including reserved blocks. Unix
  # only.
  #[getter]
  pub def blocks_free self
    throw nil

  # ([`Int`](std.Int)) Free data blocks available to unprivileged users.
  # Unix only.
  #[getter]
  pub def blocks_available self
    throw nil

  # ([`Int`](std.Int)) Total file nodes. Unix only.
  #[getter]
  pub def files self
    throw nil

  # ([`Int`](std.Int)) Free file nodes. Unix only.
  #[getter]
  pub def files_free self
    throw nil

  # ([`Int`](std.Int)) Free file nodes available to unprivileged users.
  # Unix only.
  #[getter]
  pub def files_available self
    throw nil

  # ([`Int`](std.Int)) Filesystem fragment size in bytes. Unix only.
  #[getter]
  pub def fragment_size self
    throw nil

  # ([`Int`](std.Int)?) Raw filesystem identifier when the platform
  # reports one. Unix only.
  #[getter]
  pub def fsid self
    throw nil

  # ([`Int`](std.Int)) Maximum filename length. Unix only.
  #[getter]
  pub def name_max self
    throw nil

  # ([`Int`](std.Int)) Raw Linux filesystem mount attribute mask. Unix
  # only.
  #[getter]
  pub def linux_attrs self
    throw nil

  # ([`Int`](std.Int)) Raw FreeBSD filesystem mount attribute mask. Unix
  # only.
  #[getter]
  pub def freebsd_attrs self
    throw nil

  # ([`Int`](std.Int)) Raw macOS filesystem mount attribute mask. Unix
  # only.
  #[getter]
  pub def macos_attrs self
    throw nil

  # ([`Bool`](std.Bool)) Whether setuid execution is disabled. Unix only.
  #[getter]
  pub def no_suid self
    throw nil

  # ([`Bool`](std.Bool)) Whether execution is disabled. Unix only.
  #[getter]
  pub def no_exec self
    throw nil

  # ([`Bool`](std.Bool)) Whether writes are synchronous. Unix only.
  #[getter]
  pub def synchronous self
    throw nil

  # ([`Bool`](std.Bool)) Whether device files are disabled. Unix only.
  #[getter]
  pub def no_dev self
    throw nil

  # ([`Bool`](std.Bool)) Whether access time updates are disabled. Unix
  # only.
  #[getter]
  pub def no_atime self
    throw nil

  # ([`Bool`](std.Bool)) Whether directory access time updates are
  # disabled. Unix only.
  #[getter]
  pub def no_dir_atime self
    throw nil

  # ([`Bool`](std.Bool)) Whether relative-atime updates are enabled. Unix
  # only.
  #[getter]
  pub def relatime self
    throw nil

  # ([`Int`](std.Int)) Raw Windows volume flags. Windows only.
