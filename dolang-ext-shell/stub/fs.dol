  # `:USER:` and `:SYSTEM:` name well-known namespaces, and `:ANY:` lists all
  # namespaces.
  :namespace @ (Str | Sym) = nil
  # Resolution mode. Defaults to
  # `:TARGET:`.
  :resolve @ Resolve = nil
do -> Iter[XattrEntry]
  ...

