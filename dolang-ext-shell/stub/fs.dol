# A filesystem path.
#
# The supertype of [`fs.unix.Path`](fs.unix.Path) and
# [`fs.windows.Path`](fs.windows.Path); which of the two a constructed path
# is depends on the current VFS context.
pub class Path
  # Converts a string or another path to a path of the current VFS context's
  # type.
  #
  # ## Returns
  #
  # [`fs.unix.Path`](fs.unix.Path) or
  # [`fs.windows.Path`](fs.windows.Path).
  pub def (init)
    self
    # Path value.
    path @ (Str | Path)
  do -> Path
    ...

  # Joins path components into a single path.
  #
  # If any component is an absolute path, it replaces everything before it.
  #
  # ## Example
  #
  # ```
  # let path = Path.join home user docs file.txt
  # echo $path.name  # file.txt
  #
  # # An absolute path replaces everything before it
  # let abs = Path.join home /etc config.txt
  # echo $abs  # /etc/config.txt
  # ```
  #[class]
  pub def join
    self
    # Path components to join.
    *components @ (Str | Path)
  do -> Path
    ...

  # The final component of the path, or `nil` if the
  # path is empty.
  #
  # ```
  # let path = Path /home/user/file.txt
  # echo $path.name  # file.txt
  # ```
  #[getter]
  pub def name self -> (Str | nil)
    ...

  # The final component without its last extension,
  # or `nil` if the path is empty.
  #
  # ```
  # let path = Path "/home/user/archive.tar.gz"
  # echo $path.stem  # archive.tar
  # ```
  #[getter]
  pub def stem self -> (Str | nil)
    ...

  # The file extension without the leading dot, or
  # `nil` if the final component has no extension.
  #
  # ```
  # let path = Path "/home/user/file.txt"
  # echo $path.ext  # txt
  # ```
  #[getter]
  pub def ext self -> (Str | nil)
    ...

  # The parent directory, or `nil` if the path is empty
  # or contains only one component.
  #
  # ```
  # let path = Path /home/user/file.txt
  # echo $path.parent  # /home/user
  # ```
  #[getter]
  pub def parent self -> (Path | nil)
    ...

  # Whether the path is absolute, meaning it starts
  # from the filesystem root.
  #[getter]
  pub def is_absolute self -> Bool
    ...

  # Immutable array-like view of the lexical path components.
  #
  # ```
  # let path = Path "alpha/beta/gamma"
  # assert_eq [...path.components] ["alpha", "beta", "gamma"]
  # ```
  #
  # Windows paths carry the alternate data stream specified in the final path
  # component if present.
  #[getter]
  pub def components self -> Seq[Str]
    ...

  # Returns a new path with `ext` appended as an additional extension.
  #
  # ## Example
  #
  # ```
  # let path = Path "archive.tar"
  # echo (path.add_ext "gz")  # archive.tar.gz
  # ```
  pub def add_ext
    self
    # Extension to append.
    ext @ Str
  do -> Path
    ...

  # Returns a new path with the final extension replaced.
  #
  # ## Example
  #
  # ```
  # let path = Path "archive.tar.gz"
  # echo (path.with_ext "zip")  # archive.tar.zip
  # ```
  pub def with_ext
    self
    # Replacement extension.
    ext @ Str
  do -> Path
    ...

  # Returns a new path with the final extension removed.
  #
  # ## Example
  #
  # ```
  # let path = Path "archive.tar.gz"
  # echo (path.without_ext())  # archive.tar
  # ```
  pub def without_ext self -> Path
    ...

  # Returns a new path with the final component replaced.
  #
  # ## Example
  #
  # ```
  # let path = Path "src/main.rs"
  # echo (path.with_name "lib.rs")  # src/lib.rs
  # ```
  pub def with_name
    self
    # Replacement final component.
    name @ Str
  do -> Path
    ...

  # Returns a new path with the final stem replaced, preserving the final
  # extension when present.
  #
  # ## Example
  #
  # ```
  # let path = Path "archive.tar.gz"
  # echo (path.with_stem "bundle")  # bundle.gz
  # ```
  pub def with_stem
    self
    # Replacement stem.
    stem @ Str
  do -> Path
    ...

  # The method form of [`fs.absolute`](fs.absolute).
  pub def absolute self -> Path
    ...

  # The method form of [`fs.canonical`](fs.canonical).
  pub def canonical self -> Path
    ...

  # The method form of [`fs.normalize`](fs.normalize).
  pub def normalize self -> Path
    ...

  # The method form of [`fs.relative`](fs.relative).
  pub def relative
    self
    # Base directory. Defaults
    # to the current working directory.
    base @ (Str | Path) = nil
  do -> Path
    ...

  # The method form of [`fs.exists`](fs.exists).
  pub def exists self -> Bool
    ...

  # The method form of [`fs.open`](fs.open).
  @def open
    self
    # File access mode. Defaults to `"r"`.
    mode @ OpenMode = nil
  do -> File

  # The method form of [`fs.open`](fs.open) with a block.
  @def open[R]
    self
    # Block to run with the file; it is closed when the block returns.
    func @ (File -> R)
  do -> R

  # The method form of [`fs.open`](fs.open) with a mode and a block.
  @def open[R]
    self
    # File access mode.
    mode @ OpenMode
    # Block to run with the file; it is closed when the block returns.
    func @ (File -> R)
  do -> R

  pub def open self ...options
    ...

  # The method form of [`fs.read`](fs.read) for a text file.
  @def read self -> Str

  # The method form of [`fs.read`](fs.read) in binary mode.
  @def read
    self
