# Returns an iterator over paths matching a glob pattern.
#
# ## Returns
#
# [`Iter`](std.Iter) of [`Path`](fs.Path)
#
# ## Example
#
# ```
# # Find all text files
# for path = glob "*.txt"
#   echo "Found: $path"
#
# # Recursive search with a depth limit
# for path = glob "**/*.rs" max_depth: 3
#   echo "Source: $path"
#
# # Follow symlinks
# for path = glob "**/*" resolve: :TARGET:
#   echo "Entry: $path"
# ```
pub def glob
  # ([`Str`](std.Str)) Glob pattern, such as `"*.txt"` or `"**/*.rs"`.
  #
  # ### Glob pattern syntax
  #
  # - `*` — Match any sequence of characters except the path separator
  # - `?` — Match a single character
  # - `**` — Match any sequence of characters including path separators
  # - `[abc]` — Match any character in the set
  # - `{a,b,c}` — Match any of the comma-separated patterns
  pattern
  # ([`Int`](std.Int)?) Maximum directory depth to traverse. Defaults to
  # unlimited.
  :max_depth = nil
  # (`:TARGET:`\|`:LINK:`?) [Resolution mode](fs.resolution-modes). Defaults to
  # `:LINK:`.
  :resolve = nil
do
  throw nil

# Creates a directory.
#
# ## Example
#
# ```
# create_dir new_dir
# create_dir a/b/c all: true
# ```
pub def create_dir
  # ([`Str`](std.Str)\|[`Path`](fs.Path)) Path to the directory to
  # create.
  path
  # ([`Bool`](std.Bool)?) Create parent directories too.
  :all = nil
do
  throw nil

# Removes one or more paths from the filesystem.
#
# By default this removes a single file or symlink. With `all: true`, it also
# removes directories recursively, similar to `rm -r`. With `ignore: true`,
# missing paths are treated as success.
#
# ## Example
#
# ```
# remove "temp.txt"
# remove "missing.txt" ignore: true
# remove "build" all: true
# remove "a.txt" "b.txt"
# ```
pub def remove
  # ([`Bool`](std.Bool)?) Remove directories recursively.
  :all = nil
  # ([`Bool`](std.Bool)?) Treat a missing path as success.
  :ignore = nil
  # ([`Str`](std.Str)\|[`Path`](fs.Path)) One or more paths to remove.
  ...paths
do
  throw nil

# Removes one or more directories.
#
# By default this removes only empty directories. With `all: true`, it removes
# directories recursively, but only through subtrees that contain directories
# and no files or other non-directory entries. Use [`remove`](fs.remove) to
# delete directories that contain files.
#
# ## Example
#
# ```
# # Remove an empty directory
# remove_dir empty_dir
#
# # Remove an empty directory tree
# remove_dir dir_to_remove all: true
#
# # Prune only the empty branches and ignore file-blocked subtrees
# remove_dir cache tmp all: true ignore: true
# ```
pub def remove_dir
  # ([`Bool`](std.Bool)?) Recursively prune empty directory subtrees.
  :all = nil
  # ([`Bool`](std.Bool)?) Ignore missing directories and file-blocked
  # subtrees.
  :ignore = nil
  # ([`Str`](std.Str)\|[`Path`](fs.Path)) One or more directories to
  # remove.
  ...paths
do
  throw nil

# Copies a filesystem entry from one location to another.
#
# By default this copies a single file or symlink. With `all: true`, it also
# copies directories recursively.
#
# ## Example
#
# ```
# copy "source.txt" "backup.txt"
# copy "project" "project-backup" all: true
# ```
pub def copy
  # ([`Str`](std.Str)\|[`Path`](fs.Path)) Source path.
  from
  # ([`Str`](std.Str)\|[`Path`](fs.Path)) Destination path.
  to
  # ([`Bool`](std.Bool)?) Allow a recursive directory copy.
  :all = nil
do
  throw nil

# Moves a filesystem entry from one location to another.
#
# This first tries a plain rename. If that fails because the source and
# destination are on different filesystems, it falls back to copy-and-delete.
# By default this moves a single file or symlink. With `all: true`, it also
# moves directories recursively.
#
# ## Example
#
# ```
# move "source.txt" "dest.txt"
# move "project" "archive/project" all: true
# ```
pub def move
  # ([`Str`](std.Str)\|[`Path`](fs.Path)) Source path.
  from
  # ([`Str`](std.Str)\|[`Path`](fs.Path)) Destination path.
  to
  # ([`Bool`](std.Bool)?) Allow a recursive directory move.
  :all = nil
do
  throw nil

# Renames a file or directory.
#
# By default this replaces an existing destination. Set `replace` to `false` to
# fail atomically instead.
#
# !!! note
#     `replace: false` is not supported on FreeBSD.
#
# ## Example
#
# ```
# rename "old_name.txt" "new_name.txt"
# rename "file.txt" "subdir/file.txt"
#
# # Fail if the destination exists
# rename "draft.txt" "published.txt" replace: false
# ```
pub def rename
  # ([`Str`](std.Str)\|[`Path`](fs.Path)) Source path.
  from
  # ([`Str`](std.Str)\|[`Path`](fs.Path)) Destination path.
  to
  # ([`Bool`](std.Bool)?) Whether to replace an existing destination.
  :replace = nil
do
  throw nil

# Creates a hard link at `dst` pointing to the existing file at `src`.
#
# This uses the platform-native hard-link operation. The source must already
# exist, and the link must be created on the same filesystem or volume if the
# platform requires it.
#
# ## Example
#
# ```
# hard_link "data.txt" "data-copy.txt"
# ```
pub def hard_link
  # ([`Str`](std.Str)\|[`Path`](fs.Path)) Existing file to link to.
  src
  # ([`Str`](std.Str)\|[`Path`](fs.Path)) Path where the hard link is
  # created.
  dst
do
  throw nil

# Creates a symbolic link at `dst` pointing to `src`.
#
# On Unix this creates a standard symbolic link. On Windows it determines
# whether the target is a file or directory by reading its metadata, and fails
# if the target cannot be accessed; use [`symlink_file`](fs.symlink_file) or
# [`symlink_dir`](fs.symlink_dir) for explicit control.
#
# ## Errors
#
# | Exception                                          | Condition                                |
# | -------------------------------------------------- | ---------------------------------------- |
# | [`sys.NotFoundError`](sys.NotFoundError)   | The target cannot be accessed on Windows |
#
# ## Example
#
# ```
# symlink "/path/to/target" "link_name"
# ```
pub def symlink
  # ([`Str`](std.Str)\|[`Path`](fs.Path)) Target path the symlink
  # points to.
  src
  # ([`Str`](std.Str)\|[`Path`](fs.Path)) Path where the symlink is
  # created.
  dst
do
  throw nil

# Creates a file symbolic link at `dst` pointing to `src`.
#
# On Unix this is equivalent to [`symlink`](fs.symlink). On Windows it creates a
# file symlink, which may require appropriate permissions on some Windows
# versions.
#
# ## Example
#
# ```
# symlink_file "/path/to/file" "file_link"
# ```
pub def symlink_file
  # ([`Str`](std.Str)\|[`Path`](fs.Path)) Target file path.
  src
  # ([`Str`](std.Str)\|[`Path`](fs.Path)) Path where the symlink is
  # created.
  dst
do
  throw nil

# Creates a directory symbolic link at `dst` pointing to `src`.
#
# On Unix this is equivalent to [`symlink`](fs.symlink). On Windows it creates a
# directory symlink, which may require appropriate permissions on some Windows
# versions.
#
# ## Example
#
# ```
# symlink_dir "/path/to/dir" "dir_link"
# ```
pub def symlink_dir
  # ([`Str`](std.Str)\|[`Path`](fs.Path)) Target directory path.
  src
  # ([`Str`](std.Str)\|[`Path`](fs.Path)) Path where the symlink is
  # created.
  dst
do
  throw nil

# Reads the target of a symbolic link.
#
# ## Returns
#
# [`Path`](fs.Path), the path the symlink points to.
#
# ## Errors
#
# | Exception                                                       | Condition                                          |
# | --------------------------------------------------------------- | -------------------------------------------------- |
# | [`sys.NotFoundError`](sys.NotFoundError)                | The path does not exist                            |
# | [`sys.PermissionDeniedError`](sys.PermissionDeniedError) | Permission denied to read the symlink              |
# | [`sys.UnsupportedError`](sys.UnsupportedError)           | Reading symlinks is not supported on this platform |
#
# ## Example
#
# ```
# let link = read_link "./my_link"
# echo "Link points to: $link"
# ```
pub def read_link
  # ([`Str`](std.Str)\|[`Path`](fs.Path)) Path to the symlink.
  path
do
  throw nil

# Returns whether a path is absolute.
#
# ## Returns
#
# [`Bool`](std.Bool)
#
