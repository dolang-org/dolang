  # Attribute bytes; strings
  # use UTF-8.
  value @ (Str | Bin)
  # Namespace to update.
  :namespace @ (Str | Sym) = nil
  # Resolution mode. Defaults to
  # `:TARGET:`.
  :resolve @ Resolve = nil
do
  ...

