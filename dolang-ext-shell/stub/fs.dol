# An extended attribute of a filesystem entry.
#
# Yielded by [`xattrs`](fs.xattrs), and accepted in place of a name by
# the functions that read and write attribute values.
pub class XattrEntry
  # Attribute name.
  #
  # Windows may report the name with different casing than it was originally
  # set with.
  #
  # ```
  # for attr = xattrs "data.txt"
  #   echo $attr.name
  # ```
  #[getter]
  pub def name self -> Str
    ...

  # Extended attribute namespace, such as `user`.
  #
  # Linux and FreeBSD only.
  #
  # ```
  # for attr = xattrs "data.txt" namespace: :ANY:
  #   echo "$(attr.namespace):$(attr.name)"
  # ```
  #[getter]
  pub def namespace self -> Str
    ...

  # Attribute value size in bytes. Windows only.
  #[getter]
  pub def size self -> Int
    ...

  # Attribute flags. Windows only.
  #[getter]
  pub def flags self -> Int
    ...

# Opens a file.
#
# The file stays open until [`File.close`](fs.File.close) is called.
#
# ```
# let file = open data.txt w
# file.write "some data"
# file.close()
# ```
@def open
  # Path to the file to open.
  path @ (Str | Path)
  # File access mode. Defaults to `"r"`.
  mode @ OpenMode = nil
do -> File

# Opens a file for reading and runs a block with it. The file is closed when
# the block returns.
#
# ```
# open config.txt do |file|
#   echo "Content: $(file.read())"
# ```
@def open[R]
  # Path to the file to open.
  path @ (Str | Path)
  # Block to run with the file.
  func @ (File -> R)
do -> R

# Opens a file with a mode and runs a block with it. The file is closed when
# the block returns.
#
# ```
# open log.txt a do |file|
#   file.write "entry\n"
# ```
@def open[R]
  # Path to the file to open.
  path @ (Str | Path)
  # File access mode.
  mode @ OpenMode
  # Block to run with the file.
  func @ (File -> R)
do -> R

pub def open path ...options
  ...

