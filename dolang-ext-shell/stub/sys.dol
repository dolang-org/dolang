# The `sys` module exposes basic information and types associated with systems
# and platforms supported by Do.

# `Error` is raised for system and I/O failures.
#
# It can be subclassed for library-specific operational failures.
pub class Error: std.RuntimeError
  # Creates a system error.
  #
  # ## Example
  #
  # ```
  # let error = Error "operation failed" code: $sys.linux.Errno.EIO
  # ```
  #
  # ```
  # try
  #   fs.read "/definitely/missing"
  # catch Error: err
  #   echo $Str(err)
  # ```
  #
  # `str(err)` returns the underlying system error message and appends the native
  # symbolic code in parentheses when it is known.
  pub def (init)
    self
    # Error message.
    message @ Str
    # Underlying platform code.
    :code @ ErrorCode = nil
  do
    ...

  # The underlying native system error code, or `nil` when one does not exist.
  #
  # The value is [`sys.linux.Errno`](sys.linux.Errno),
  # [`sys.freebsd.Errno`](sys.freebsd.Errno),
  # [`sys.macos.Errno`](sys.macos.Errno), or
  # [`sys.windows.WinError`](sys.windows.WinError), according to the system
  # where the error originated.
  #[getter]
  pub def code self -> (ErrorCode | nil)
    ...

# Native system error code.
#
# This base type is not directly constructible. Use a platform-specific code
# type.
#
# `str(code)` returns the native symbolic name when known and the decimal value
# otherwise.
pub class ErrorCode
  # The raw integer value.
  #[getter]
  pub def value self -> Int
    ...

# CPU information for the active VFS target, returned by
# [`cpu_info`](sys.cpu_info).
pub class CpuInfo
  # Target architecture.
  #[getter]
  pub def arch self -> (:X86_64: | :AARCH64:)
    ...

  # Logical CPU count captured when the VFS context is established.
  #[getter]
  pub def logical_count self -> Int
    ...

# Operating system information for the active VFS target, returned by
# [`os_info`](sys.os_info).
pub class OsInfo
  # Operating system family derived from the target OS.
  #[getter]
  pub def family self -> (:UNIX: | :WINDOWS:)
    ...

  # Whether the process is running under Wine.
  #
  # This field is only available for Windows targets.
  #[getter]
  pub def is_wine self -> Bool
    ...

  # Specific operating system.
  #[getter]
  pub def os self -> (:LINUX: | :MACOS: | :FREEBSD: | :WINDOWS:)
    ...

# Returns CPU information for the current VFS target.
#
# ## Example
#
# ```
# let info = sys.cpu_info()
# echo "running on $(info.arch) with $(info.logical_count) logical CPUs"
# ```
pub def cpu_info() -> CpuInfo
  ...

# Returns operating system information for the current VFS target.
#
# ## Example
#
# ```
# if (sys.os_info().family == :WINDOWS:)
#   echo "running on Windows"
# ```
pub def os_info() -> OsInfo
  ...

