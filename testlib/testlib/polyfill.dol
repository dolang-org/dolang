import sys
  shell:
    - exe

pub let echo = nil
pub let grep = nil
pub let cat = nil

if (sys.os_info().family == :WINDOWS:)
  # cmd.exe has no reliable byte-exact stdin/stdout utilities: `more` and
  # `findstr` are line-oriented, drop an unterminated final line, and behave
  # differently under Wine than on real Windows. Use our own helper instead.
  let helper = run[exe.parent / "dolang-private-polyfill.exe"]
  cat = do |...args| helper cat ...args
  echo = do |...args| helper echo ...args
  grep = do |...args| helper grep ...args
else
  cat = run["cat"]
  echo = run["echo"]
  grep = run["grep"]

# Unix socket relay; --silent keeps a connection open without sending a handshake.
pub def unix_connect ...args
  run (exe.parent / "dolang-private-polyfill") unix-connect ...args
