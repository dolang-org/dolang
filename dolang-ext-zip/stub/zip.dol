# Reads and writes ZIP archives.
#
# The API is VFS-transparent: archive paths use the active VFS context.

import fs:
  - @Path
import std:
  - @Seq

# An open ZIP archive.
#
# Returned by [`open`](zip.open). Only one file can be open at a time
# within an archive; opening a second one while another is open raises a
# concurrency error.
pub class Archive
  # Immutable array-like view of [`Entry`](zip.Entry) objects for every entry
  # in the archive.
  #
  # Available in read mode only; reading it on an archive opened in write mode
  # raises a runtime error. A view obtained before the archive is closed
  # reports an empty length afterward rather than erroring, since `len` cannot
  # itself raise an error.
  #
  # ## Example
  #
  # ```
  # open "archive.zip" do |archive|
  #   for entry = archive.entries
  #     echo "Found: $entry.name"
  #
  #   let entries = [...archive.entries]
  #   echo "Total files: $(entries.len)"
  # ```
  #[getter]
  pub def entries self -> Seq[Entry]
    ...

  # Closes the archive and releases resources.
  #
  # In read mode this simply closes the archive. In write mode it finalizes
  # the archive, writing the central directory, before closing.
  #
  # ## Example
  #
  # ```
  # let archive = open "data.zip"
  # # ... use archive ...
  # archive.close()
  # ```
  pub def close self
    ...

  # Creates a directory entry. Write mode only.
  #
  # ## Example
  #
  # ```
  # open "output.zip" "w" do |archive|
  #   archive.create_dir "subdir" mode: 0o755
  # ```
  pub def create_dir
    self
    # Name of the directory within the archive. A
    # trailing `/` is added if missing.
    name @ Str
    # Unix permission bits. Defaults to `0`.
    :mode @ Int = nil
  do
    ...

  # Opens a file within the archive.
  #
  # In read mode this opens an existing entry for reading. In write mode it
  # always creates a regular file entry -- use [`create_dir`](zip.Archive.create_dir) or
  # [`symlink`](zip.Archive.symlink) for directory or symlink entries, which carry no
  # content and so have no use for a write handle.
  #
  # `mode`, `size`, and `compression` apply to entries being created; passing
  # any of them in read mode is an error.
  #
  # ## Example
  #
  # ```
  # open "archive.zip" do |archive|
  #   archive.open "document.txt" do |file|
  #     let content = file.read 1024
  #     echo $content
  #
  # open "output.zip" "w" do |archive|
  #   archive.open "data.txt" mode: 0o644 do |file|
  #     file.write "Hello, World!"
  #
  # # Store an already-compressed payload without deflating it again
  # open "bundle.zip" "w" do |archive|
  #   let total = payload.metadata().size
  #   archive.open "disk.qcow2" compression: :STORED: size: $total do |file|
  #     payload.open rb do |source|
  #       for chunk = source
  #         file.write $chunk
  # ```
  @def open
    self
    # Name of the file within the archive.
    name @ Str
    # Unix permission bits in write mode. Defaults
    # to `0`.
    :mode @ Int = nil
    # Expected uncompressed size.
    #
    # The writer reserves space for an entry's ZIP64 size fields in its local
    # file header before any data is written, and patches the real sizes in
    # afterward. A field that was not reserved cannot appear later, so an
    # entry that turns out to exceed 4 GiB fails when it is closed unless
    # `size` announced it up front. Pass the uncompressed size whenever it is
    # known; it is a hint, and the actual sizes are what end up recorded.
    :size @ Int = nil
    # Compression method. Defaults to `:DEFLATE:`.
    :compression @ (:STORED: | :DEFLATE: | :ZSTD:) = nil
  do -> File

  # Opens a file within the archive and calls `func` with it. The file is
  # closed when `func` returns.
  #
  # The keywords are those of the form without `func`.
  @def open[R]
    self
    # Name of the file within the archive.
    name @ Str
    # Unix permission bits in write mode. Defaults
    # to `0`.
    :mode @ Int = nil
    # Expected uncompressed size.
    :size @ Int = nil
    # Compression method. Defaults to `:DEFLATE:`.
    :compression @ (:STORED: | :DEFLATE: | :ZSTD:) = nil
    # Called with the [`File`](zip.File).
    func @ (File -> R)
  do -> R

  pub def open self name ...options
    ...

  # Creates a symbolic link entry pointing to `target`. Write mode only.
  #
  # Argument order matches
  # [`fs.symlink_file`](fs.symlink_file).
  #
  # ## Example
  #
  # ```
  # open "output.zip" "w" do |archive|
  #   archive.symlink "target.txt" "link.txt" mode: 0o777
  # ```
  pub def symlink
    self
    # Path the symlink points to.
    target @ Str
    # Name of the symlink within the archive.
    name @ Str
    # Unix permission bits. Defaults to `0`.
    :mode @ Int = nil
  do
    ...

# A single archive entry's metadata, with a method to open it for reading.
#
# Entries are only available for archives opened in read mode, via
# [`Archive.entries`](zip.Archive.entries).
pub class Entry
  # Entry comment.
  #[getter]
  pub def comment self
    ...

  # Compressed size in bytes.
  #[getter]
  pub def compressed_size self
    ...

  # Compression method as `:STORED:`, `:DEFLATE:`, `:ZSTD:`, or `:UNKNOWN:`.
  #[getter]
  pub def compression self
    ...

  # CRC-32 checksum of the uncompressed data.
  #[getter]
  pub def crc32 self
    ...

  # Last modification time as [`DateTime`](time.DateTime), or `nil` when
  # the stored timestamp cannot be represented.
  #[getter]
  pub def last_modified self
    ...

  # Unix permission bits, or `nil` when the archive does not provide Unix
  # metadata.
  #[getter]
  pub def mode self
    ...

  # Entry name as an [`fs.unix.Path`](fs.unix.Path).
  #[getter]
  pub def name self
    ...

  # Uncompressed size in bytes.
  #[getter]
  pub def size self
    ...

  # Entry type as `:FILE:`, `:DIR:`, `:SYMLINK:`, `:FIFO:`, `:CHAR_DEVICE:`,
  # `:BLOCK_DEVICE:`, or `:UNKNOWN:`.
  #[getter]
  pub def type self
    ...

  # Opens the entry for reading.
  #
  # ## Errors
  #
  # Raises a concurrency error if another file is already open in the archive.
  @def open self -> File

  # Opens the entry for reading and calls `block` with it. The file is closed
  # when `block` returns.
  #
  # ## Errors
  #
  # Raises a concurrency error if another file is already open in the archive.
  #
  # ## Example
  #
  # ```
  # for entry = archive.entries
  #   entry.open do |file|
  #     echo (str (file.read entry.size))
  # ```
  @def open[R]
    self
    # Called with the [`File`](zip.File).
    block @ (File -> R)
  do -> R

  pub def open self ...block
    ...

# An open file within a ZIP archive.
#
# Returned by [`Archive.open`](zip.Archive.open) and
# [`Entry.open`](zip.Entry.open). Entry metadata such as size and Unix mode
# is available on [`Entry`](zip.Entry) rather than here.
pub class File
  # Closes the file.
  #
  # ## Example
  #
  # ```
  # open "archive.zip" do |archive|
  #   let file = archive.open "data.txt"
  #   let content = file.read 1024
  #   file.close()
  # ```
  pub def close self
    ...

  # Reads data from the file. Read mode only.
  #
  # ## Errors
  #
  # Raises a runtime error if called on a file opened in write mode.
  #
  # ## Example
  #
  # ```
  # open "archive.zip" do |archive|
  #   archive.open "document.txt" do |file|
  #     let data = file.read 4096
  #     echo "Read $(data.len) bytes"
  #     echo $ Str $data
  # ```
  pub def read
    self
    # Maximum number of bytes to read.
    size @ Int
  do -> Bin
    ...

  # Writes data to the file. Write mode only.
  #
  # ## Errors
  #
  # Raises a runtime error if called on a file opened in read mode.
  #
  # ## Example
  #
  # ```
  # open "output.zip" "w" do |archive|
  #   archive.open "data.bin" do |file|
  #     file.write "Hello, World!"
  #     file.write b"\x00\x01\x02\x03"
  # ```
  pub def write
    self
    # Data to write.
    data @ (Bin | Str)
  do
    ...

# Access mode accepted by [`open`](zip.open).
#
# | Mode  | Description                                                      |
# | ----- | ---------------------------------------------------------------- |
# | `"r"` | Read mode -- opens an existing archive for reading               |
# | `"w"` | Write mode -- creates a new archive, truncating any existing one |
pub @let OpenMode = ("r" | "w")

# Opens a ZIP archive.
#
# The archive stays open until [`Archive.close`](zip.Archive.close) is called.
@def open
  # Path to the ZIP archive
  # file.
  path @ (Str | Path)
  # Access mode. Defaults to `"r"`.
  mode @ OpenMode = nil
do -> Archive

# Opens a ZIP archive for reading and calls `func` with it. The archive is
# closed when `func` returns.
#
# ```
# open "archive.zip" do |archive|
#   for entry = archive.entries
#     echo "Entry: $entry.name"
# ```
@def open[R]
  # Path to the ZIP archive
  # file.
  path @ (Str | Path)
  # Called with the [`Archive`](zip.Archive).
  func @ (Archive -> R)
do -> R

# Opens a ZIP archive with a mode and calls `func` with it. The archive is
# closed when `func` returns.
#
# ```
# open "output.zip" "w" do |archive|
#   archive.open "file.txt" do |file|
#     file.write "Hello, World!"
# ```
@def open[R]
  # Path to the ZIP archive
  # file.
  path @ (Str | Path)
  # Access mode.
  mode @ OpenMode
  # Called with the [`Archive`](zip.Archive).
  func @ (Archive -> R)
do -> R

pub def open path ...options
  ...
