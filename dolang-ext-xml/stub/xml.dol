# dolang: strict
# Parses, edits, and serializes XML element trees.

import std:
  - @IndexItem

# A value accepted by [`encode`](xml.encode).
pub @let EncodeValue = (Node | Str)

# A value returned by [`decode`](xml.decode).
pub @let DecodeValue = Node

# A parentless XML element.
#
# Nodes can be shared or inserted into different trees. Serialization derives
# namespace declarations from each node rather than from parent pointers.
#
# Attributes are keyed by expanded name in Clark notation: `{namespace}local`,
# or `local` for an unnamespaced attribute. Names have no prefixes. For a
# namespaced name, serialization uses a prefix that
# [`namespaces`](xml.Node.namespaces) declares on the element or an ancestor,
# and otherwise makes an element's namespace the default or generates a prefix.
#
# Changes are checked as they are made, so any tree without a cycle can be
# serialized. Setting an invalid name, an empty namespace, or the `xmlns`
# namespace raises `ValueError`, as does adding text or an attribute value
# containing a character XML forbids. Adding a child other than a `Node` or
# `Str` raises `TypeError`.
pub class Node: @Index[{*(Str): Str, *(Node | Str)}] @Assign[Str, Str] @Spread[Node | Str]
  # Creates an element, optionally with attributes and children.
  #
  # ## Errors
  #
  # | Exception | Condition |
  # | --- | --- |
  # | `TypeError` | A dict has a key other than a `Str` or `Sym` or a value other than a `Str`, or a child is not a `Node` or `Str`. |
  # | `ValueError` | A name, string, or namespace declaration is invalid, or two attributes have the same expanded name. |
  #
  # ## Example
  #
  # ```
  # let item = Node item namespace: "urn:inventory" namespaces: {inv: "urn:inventory"}
  # let disk = Node disk
  #   $
  #     type: file
  #     device: disk
  #   - $ Node driver {name: "qemu", type: "qcow2"}
  # ```
  pub def (init)
    self
    # Local element name.
    tag @ Str
    # Namespace URI.
    :namespace @ Str = nil
    # Initial [`namespaces`](xml.Node.namespaces), with `Sym` or `Str` keys.
    :namespaces @ BaseDict[Sym | Str, Str] = nil
    # Children, and dicts of attributes keyed in Clark notation.
    #
    # Bareword dict keys are `Sym`s and name unnamespaced attributes.
    *items @ (Node | Str | BaseDict[Sym | Str, Str])
  do
    ...

  # Mutable map of attribute values by name in Clark notation, in document
  # order.
  #
  # Keys may also be `Sym`s for unnamespaced attributes; iteration yields `Str`
  # keys. Setting an existing attribute keeps its position.
  #
  # ## Example
  #
  # ```
  # node.attrs["{urn:inventory}id"] = "123"
  # let id = node.attrs.get "{urn:inventory}id"
  # ```
  #[getter]
  pub def attrs self -> MutMap[Str, Str]
    ...

  # Mutable array-like view of child `Node` and `Str` values in document order.
  #
  # Iterating a node iterates this view directly.
  #[getter]
  pub def children self -> MutSeq[Node | Str]
    ...

  # Mutable namespace URI, or `nil` for no namespace.
  pub field namespace @ (Str | nil) = ...

  # Mutable map of the namespace declarations this element makes itself.
  #
  # Keys are prefix strings; `""` is the default namespace. Serialization
  # declares these, uses them to spell names in this element's subtree, and
  # adds whatever else those names need. Declarations choose prefixes, and are
  # required for prefixes used in content, such as attribute values naming a
  # qualified type. A parsed element holds the declarations written on it, not
  # those it inherits.
  #
  # Declaring a binding XML forbids, such as a prefix for an empty URI or
  # another prefix for the XML namespace, raises `ValueError`.
  #[getter]
  pub def namespaces self -> MutMap[Str, Str]
    ...

  # Mutable local element name.
  pub field tag @ Str = ...

  # Appends a child.
  pub def push
    self
    # Child value.
    child @ (Node | Str)
  do
    ...

  # Returns a depth-first, parent-first iterator over this node and descendants.
  pub def traverse self -> Iter[Node | Str]
    ...

  # Reads an attribute by Clark-notation string or a child by integer index.
  #
  # Negative integer indexes count from the end.
  @def (index)[K] self key@K -> IndexItem[{*(Str): Str, *(Node | Str)}, K]
  @def (index) self range@Range[Int] -> Array[Node | Str]
  pub def (index)[K] self key@K -> IndexItem[{*(Str): Str, *(Node | Str)}, K]
    ...

  # Sets an attribute by Clark-notation string, adding it if it is missing.
  pub def (assign) self key@Str value@Str
    ...

  # Iterates the children.
  pub def (iter) self -> Iter[Node | Str]
    ...

  # Spreads the children positionally.
  pub def (spread) self -> Spread[Node | Str]
    ...

# Parses an XML document into a parentless element tree.
#
# Predefined entities and numeric character references are expanded. Custom
# DTD entities are not resolved.
#
# ## Returns
#
# The root element.
#
# ## Errors
#
# `ValueError` if the document is invalid, lacks a root, or uses an unsupported
# entity.
#
# ## Example
#
# ```
# let doc = decode "<root><child>text</child></root>"
# assert_eq $doc.tag "root"
# ```
pub def decode
  # XML document.
  xml @ Str
do -> DecodeValue
  ...

# Serializes an XML tree.
#
# Namespace declaration spelling and placement can differ from the input while
# preserving element and attribute namespace semantics.
#
# ## Errors
#
# `ValueError` if the tree contains a cycle, or a lone string contains a
# character XML forbids.
#
# ## Example
#
# ```
# let n = Node "greeting"
# n.push "hello"
# assert_eq (encode $n) "<greeting>hello</greeting>"
# ```
pub def encode
  # XML node or text.
  node @ EncodeValue
do -> Str
  ...
