# Floating-point mathematics and integer number theory.
#
# Except where noted, functions accept only [`Int`](std.Int) and
# [`Float`](std.Float) (or their subclasses) — not arbitrary types.

# The ratio of a circle's circumference to its diameter.
pub let PI @Float = nil

# One full turn in radians.
pub let TAU @Float = nil

# The base of the natural logarithm.
pub let E @Float = nil

# Computes the square root.
pub def sqrt x @ (Int | Float) -> Float
  ...

# Computes the cube root.
pub def cbrt x @ (Int | Float) -> Float
  ...

# Computes `e` raised to `x`.
pub def exp x @ (Int | Float) -> Float
  ...

# Computes `e` raised to `x`, minus one, accurately near zero.
pub def expm1 x @ (Int | Float) -> Float
  ...

# Computes two raised to `x`.
pub def exp2 x @ (Int | Float) -> Float
  ...

# Computes the logarithm in a required base.
pub def log
  # Logarithm base.
  :base @ (Int | Float)
  # Value whose logarithm is computed.
  x @ (Int | Float)
do -> Float
  ...

# Computes the natural logarithm.
pub def ln x @ (Int | Float) -> Float
  ...

# Computes the natural logarithm of `1 + x` accurately near zero.
pub def ln1p x @ (Int | Float) -> Float
  ...

# Computes the base-two logarithm.
pub def log2 x @ (Int | Float) -> Float
  ...

# Computes the base-ten logarithm.
pub def log10 x @ (Int | Float) -> Float
  ...

# Raises `base` to `exponent`.
#
# ## Returns
#
# An `Int` when both arguments are integers and `exponent` is non-negative;
# otherwise a `Float`.
#
# ## Errors
#
# `OverflowError` if an integer result does not fit in `Int`.
pub def pow
  # Base value.
  base @ (Int | Float)
  # Exponent value.
  exponent @ (Int | Float)
do -> (Int | Float)
  ...

# Computes the sine of an angle in radians.
pub def sin x @ (Int | Float) -> Float
  ...

# Computes the cosine of an angle in radians.
pub def cos x @ (Int | Float) -> Float
  ...

# Computes the tangent of an angle in radians.
pub def tan x @ (Int | Float) -> Float
  ...

# Computes the inverse sine in radians.
pub def asin x @ (Int | Float) -> Float
  ...

# Computes the inverse cosine in radians.
pub def acos x @ (Int | Float) -> Float
  ...

# Computes the inverse tangent in radians.
pub def atan x @ (Int | Float) -> Float
  ...

# Computes the inverse tangent of `y / x`, using both signs to select a quadrant.
pub def atan2
  # Vertical coordinate.
  y @ (Int | Float)
  # Horizontal coordinate.
  x @ (Int | Float)
do -> Float
  ...

# Computes the hyperbolic sine.
pub def sinh x @ (Int | Float) -> Float
  ...

# Computes the hyperbolic cosine.
pub def cosh x @ (Int | Float) -> Float
  ...

# Computes the hyperbolic tangent.
pub def tanh x @ (Int | Float) -> Float
  ...

# Computes the inverse hyperbolic sine.
pub def asinh x @ (Int | Float) -> Float
  ...

# Computes the inverse hyperbolic cosine.
pub def acosh x @ (Int | Float) -> Float
  ...

# Computes the inverse hyperbolic tangent.
pub def atanh x @ (Int | Float) -> Float
  ...

# Computes the Euclidean norm of two or more coordinates.
pub def hypot
  # First coordinate.
  first @ (Int | Float)
  # Second coordinate.
  second @ (Int | Float)
  # Additional coordinates.
  ...rest @ (Int | Float)
do -> Float
  ...

# Computes the greatest common divisor of one or more integers.
pub def gcd
  # First value.
  first @ Int
  # Additional values.
  ...rest @ Int
do -> Int
  ...

# Computes the least common multiple of one or more integers.
pub def lcm
  # First value.
  first @ Int
  # Additional values.
  ...rest @ Int
do -> Int
  ...

# Converts radians to degrees.
pub def degrees x @ (Int | Float) -> Float
  ...

# Converts degrees to radians.
pub def radians x @ (Int | Float) -> Float
  ...

# Returns the magnitude of `x` with the sign of `sign`.
pub def copysign
  # Value providing the magnitude.
  x @ (Int | Float)
  # Value providing the sign.
  sign @ (Int | Float)
do -> Float
  ...
