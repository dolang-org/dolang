    ...


#
# 128-bit signed integers.
#
# The rounding methods return the receiver unchanged.
#
pub class Int: Num
  # Smallest representable integer.
  #[static]
  pub field MIN = nil

  # Largest representable integer.
  #[static]
  pub field MAX = nil

  #
  # `Int` accepts an integer, a boolean, or an integral float. It rejects
  # fractional floats and interpretive conversions such as parsing strings.
  #
  # ```
  # assert_eq (Int true) 1
  # assert_eq (Int 3.0) 3
  # ```
  #
  # The lowercase `int` function performs coercion and parsing:
  #
  # ```
  # assert_eq (int "42") 42
  # assert_eq (int 3.14) 3
  # ```
  #
  pub def (init) self
    ...

  # Computes bitwise AND.
  pub def (band) self other
    ...

  # Computes bitwise OR.
  pub def (bor) self other
    ...

  # Computes bitwise XOR.
  pub def (bxor) self other
    ...

  # Computes bitwise NOT.
  pub def (bnot) self
    ...

  # Shifts left.
  pub def (shl) self other
    ...

  # Shifts right arithmetically, sign-extending negative values.
  pub def (shr) self other
    ...

# Error raised to signal that an iterator is exhausted. This is used
# internally by the iteration protocol and can be caught in `try`/`catch`
# statements.
pub class IterStop: Error
  #
  #
  # Builds the signal that an iterator is exhausted.
  pub def (init) self
    ...


#
# Abstract type for iterators, whose instances have the methods below. Built-in
# iterators are `Iter`; a class that only implements [`(next)`](std.BaseIter)
# is not.
#
# `Iter` is not constructible directly. See
# [Classes](../../language/classes.md) for defining custom iterators.
#
# ```
# assert_eq (type $ [1, 2, 3].iter()) $Iter
# ```
#
pub class Iter[T]: Iterable[T] @BaseIter[T] @Unpack[T]
  #
  #
  # Returns `true` if every yielded value is truthy.
  #
  # When `pred` is provided, it tests `pred(value)` instead.
  #
  # Empty iterators return `true`.
  #
  pub def all self pred @ (T -> Value) = nil -> Bool
    ...

  #
  # Returns `true` if any yielded value is truthy.
  #
  # When `pred` is provided, it tests `pred(value)` instead.
  #
  # Empty iterators return `false`.
  #
  pub def any self pred @ (T -> Value) = nil -> Bool
    ...

  #
  # Returns an iterator that yields this iterator followed by each additional
  # iterable in sequence.
  #
  pub def chain[...Us] self ...values @ ...Iterable[Us] -> Iter[Union[T, ...Us]]
    ...

  #
  # Creates a wrapper `Iter` which removes one trailing line terminator (`\r\n` or
  # `\n`) from each item, if present.
  #
  # ## Errors
  #
  # Getting an item raises [`TypeError`](std.TypeError) if the underlying
  # `Iter` yields neither a `Str` nor a `Bin`.
  #
  # ## Example
  #
  # ```
  # assert_eq [...["a\n", "b\r\n", "c"].chomp()] ["a", "b", "c"]
  #
  # for line = shell.stdin.chomp()
  #   echo "got $line"
  # ```
  #
  # Distinct from [`Str.trim_end`](std.Str), which is about whitespace generally
  # and takes an optional character set. `chomp` is about a line terminator
  # specifically and takes nothing.
  #
  pub def chomp[U @ (Str | Bin)] self @ Iter[U] -> Iter[U]
    ...

  #
  # Consumes the iterator and returns the number of yielded values.
  #
  pub def count self -> Int
    ...

  #
  # Creates a wrapper `Iter` which appends a line terminator to each item.
  #
  # The inverse of [`chomp`](#chomp), and the usual way to terminate values on
  # their way into a byte stream.
  #
  # The terminator is appended **unconditionally**: an item that already ends in
  # one gets a second.
  #
  # ## Errors
  #
  # Raises [`TypeError`](std.TypeError) for an item, or a terminator, that is
  # neither a `Str` nor a `Bin`, or if a `Bin` terminator would leave a `Str` item
  # invalid UTF-8.
  #
  # ## Example
  #
  # ```
  # assert_eq [...["a", "b"].crimp()] ["a\n", "b\n"]
  # assert_eq [...["a"].crimp("\r\n")] ["a\r\n"]
  #
  # run cmd stdin: (["one", "two"].crimp())
  # ```
  #
  pub def crimp[U @ (Str | Bin)] self@Iter[U] terminator@(Str | Bin) = nil -> Iter[U]
    ...

  #
  # Returns an iterator that yields `[index, value]` tuples.
  #
  # The first index is `0`.
  #
  pub def enumerate self -> Iter[Tuple[Int, T]]
    ...

  #
  # Creates a wrapper `Iter` which yields each `value` from the wrapper iterator
  # only if `pred(value)` is truthy.
  #
  pub def filter self pred @ (T -> Value) -> Iter[T]
    ...

  #
  # Consumes the iterator and returns the first value where `pred(value)` is truthy.
  #
  # ## Errors
  #
  # Raises [`RuntimeError`](std.RuntimeError) if no value matches and
  # no fallback is provided.
  #
  pub def find[D = T] self pred@(T -> Value) :default@D = nil :else@(() -> D) = nil -> (T | D)
    ...

  #
  # Consumes the iterator left-to-right, repeatedly applying `func(acc, value)`.
  #
  # Returns `init` unchanged if the iterator is empty.
  #
  pub def fold[A] self init@A func@((A, T) -> A) -> A
    ...

  #
  # Returns an iterator wrapper that preserves normal iteration, but opts into
  # key/value spreading.
  #
  # When spread in a keyed context such as a dict literal or argument spread, each
  # yielded item must unpack into exactly two values.
  #
  # ```
  # let entries = ["x=1", "y=2"].iter().map do |e| e.split "="
  #
  # assert_eq {...entries.kv()} {"x": "1", "y": "2"}
  # ```
  #
  pub def kv self -> Iter[T]
    ...

  #
  # Creates a wrapper `Iter` which yields `func(value)` for each `value` yielded by
  # the wrapper iterator.
  #
  pub def map[U] self func @ (T -> U) -> Iter[U]
    ...

  #
  # Consumes the iterator and returns the maximum yielded value.
  #
  # ## Errors
  #
  # Raises [`IterStop`](std.IterStop) if the iterator is empty and no
  # `default:` is provided.
  #
  pub def max[D = T] self :default @ D = nil -> (T | D)
    ...

  #
  # Consumes the iterator and returns the minimum yielded value.
  #
  # ## Errors
  #
  # Raises [`IterStop`](std.IterStop) if the iterator is empty and no
  # `default:` is provided.
  #
  pub def min[D = T] self :default @ D = nil -> (T | D)
    ...

  #
  # Returns the next value from the iterator.
  #
  # ## Errors
  #
  # Raises [`IterStop`](std.IterStop) when exhausted and no fallback
  # is provided.
  #
  pub def next[D = T] self :default@D = nil :else@(() -> D) = nil -> (T | D)
    ...

  #
  # Returns an iterator that discards the first `n` values, then yields the rest.
  #
  # ## Errors
  #
  # | Exception                        | Condition           |
  # | -------------------------------- | ------------------- |
  # | [`TypeError`](std.TypeError)   | `n` is not an `Int` |
  # | [`ValueError`](std.ValueError) | `n` is negative     |
  #
  pub def skip self n @ Int -> Iter[T]
    ...

  #
  # Returns an iterator that yields at most `n` values.
  #
  # ## Errors
  #
  # | Exception                        | Condition           |
  # | -------------------------------- | ------------------- |
  # | [`TypeError`](std.TypeError)   | `n` is not an `Int` |
  # | [`ValueError`](std.ValueError) | `n` is negative     |
  #
  pub def take self n @ Int -> Iter[T]
    ...

  #
  # Returns an iterator that yields one tuple for each step across this iterator
  # and the additional iterables.
  # The zipped iterator stops as soon as any input is exhausted.
  pub def zip[...Us] self ...values @ ...Iterable[Us] -> Iter[Tuple[T, ...Us]]
    ...



#
# Raised when a required key argument is not provided.
#
pub class MissingKeyError: RuntimeError
  #
  #
  # Builds an error naming a missing key item.
  #
  pub def (init)
    self
    # the missing key
    key
  do
    ...


#
# Raised when a required positional argument is not provided.
#
pub class MissingPosError: RuntimeError
  #
  #
  # Builds an error naming a missing positional item.
  #
  pub def (init)
    self
    # zero-based position of the missing item
    index @ Int
  do
    ...


#
# The type object for the `nil` value.
#
# `Nil` is not constructible directly.
#
pub class Nil

#
# Acts as an empty iterator and a sink that discards every value.
#
# The [`std.null`](std.null) singleton is the only `Null` value. Use it to
# provide an empty input or discard output:
#
# ```
# run tool stdin: $null stdout: $null
# ```
#
pub class Null: Iter[Empty] Sink[Value]
  # Ends the iteration immediately without yielding a value.
  pub def (next) self
    ...

  # Discards the value.
  pub def (put) self value
    ...


#
# Raised on integer overflow.
#
pub class OverflowError: RuntimeError
  #
  #
  # Builds an error reporting numeric overflow.
  #
  pub def (init) self
    ...


#
# Describes a numeric interval for iteration and slicing.
pub class Range[T @ Num]: Iterable[T]
  #
  # ```
  # let bounded = (1..5)
  # let from_start = (..5)
  # let to_end = (1..)
  # let all = (..)
  # ```
  #
  # `a..b` is half-open: it includes `a` and excludes `b`.
  #
  # Open-ended forms keep the missing endpoint as `nil` internally.
  #
  pub def (init) self start@T = nil end@T = nil step@T = nil
    ...

  #
  # The ending value (exclusive), or `nil` for open-end ranges.
  #
  #[getter]
  pub def end self -> (T | nil)
    ...

  #
  # The starting value, or `nil` for open-start ranges.
  #
  #[getter]
  pub def start self -> (T | nil)
    ...

  #
  # The step size, or `nil` when unset.
  #
  #[getter]
  pub def step self -> (T | nil)
    ...

  #
  # Tests whether the given value is within the Range interval. For increasing
  # ranges (start < end), checks if value is in \[start, end). For decreasing
  # ranges (start > end), checks if value is in (end, start].
  #
  #
  # ## Example
  #
  # ```playground
  # #> import test:
  # #>   - assert
  # # Increasing Range [0, 5)
  # let r1 = Range 0 5
  # assert (r1.contains 0)
  # assert (r1.contains 4)
  # assert (!r1.contains 5)
  #
  # # Decreasing Range (0, 5]
  # let r2 = Range 5 0 -1
  # assert (r2.contains 5)
  # assert (r2.contains 1)
  # assert (!r2.contains 0)
  # ```
  pub def contains
    self
    # the value to check
    value @ T
  do -> Bool
    ...

  # Iterates the interval. Open-ended ranges require a concrete start.
  pub def (iter) self -> Iter[T]
    ...


#
# Stores an immutable sequence of positional items and symbol-keyed items.
#
# Records keep their items in order, and a key may repeat. A lookup finds the
# latest value for a key. Keys are read by indexing, not as fields:
#
# ```
# let r = record name: Alice age: 30
# assert_eq $r[:name:] Alice
# ```
#
# A variadic capture such as `...rest` binds a record of the remaining
# arguments. To produce a changed record, spread the old record into a new one:
#
# ```
# let updated = record ...old status: ready
# ```
pub class Record[...Ts]: Iterable[Tuple[Sym | Int, Value]] @Index[{...Ts}] @Spread[{...Ts}] @Unpack[{...Ts}]
  #
  #
  # Builds a record from one spreadable source of key-value pairs.
  #
  # ```
  # let r = Record {name: Alice, age: 30}
  # ```
  #
  # Integer keys counting up from `0` become positional items, as when
  # spreading a dict.
  #
  # The lowercase `record` factory instead builds a record from its arguments.
  #
  # ```
  # let r = record first second name: Alice
  # ```
  #
  # ## Errors
  #
  # Raises `TypeError` for any other key that is not a symbol.
  pub def (init) self source
    ...

  #
  # Gets the value for a symbol or position, with an optional default.
  #
  pub def get[D = nil] self key@(Int | Sym) :default@D = nil :else@(() -> D) = nil -> (Value | D)
    ...

  #
  # Number of items, counting each instance of a repeated key.
  #
  #[getter]
  pub def len self -> Int
    ...

  # Iterates record items as `[key, value]` pairs in order. A positional item's
  # key is its position.
  pub def (iter) self
    ...

  # Unpacks record items by position and symbol.
  pub def (unpack) self
    ...



#
# Sets are ordered, mutable collections with unique membership semantics.
#
# Iteration preserves insertion order. Reinserting an existing value is a no-op
# and does not move it to the end.
#
pub class Set[T]: Iterable[T]
  #
  #
  # Builds a set from one iterable.
  #
  pub def (init) self iterable @ Iterable[T]
    ...

  #
  # Returns the number of members.
  #
  #
  #[getter]
  pub def len self -> Int
    ...

  #
  # Adds `value` if it is not already present.
  #
  # ## Example
  #
  # ```
  # let s = Set [1, 2]
  # s.add 3
  # s.add 2
  # assert_eq [...s] [1, 2, 3]
  # ```
  #
  pub def add
    self
    # the value to insert
    value @ T
  do
    ...

  #
  # Removes all members.
  #
  # ```
  # let s = Set [1, 2]
  # s.clear()
  # assert_eq $s.len 0
  # ```
  #
  pub def clear self
    ...

  #
  # Tests whether the Set contains `value`.
  #
  #
  pub def contains
    self
    # the value to test
    value
  do -> Bool
    ...

  #
  # Returns a shallow copy of the Set.
  #
  # Insertion order is preserved. Contained values are *not* recursively copied.
  #
  #
  pub def copy self -> Set[T]
    ...

  #
  # Indicates whether a value was removed. Removes `value` if present.
  #
  #
  pub def delete
    self
    # the value to remove
    value
  do -> Bool
    ...

  #
  # Returns a new Set containing members from the receiver that are not present in
  # `other`.
  #
  #
  pub def diff[U]
    self
    # other Set
    other @ Set[U]
  do -> Set[T]
    ...

  #
  # Returns a new Set containing members that are present in both sets, in
  # the receiver's insertion order.
  #
  #
  pub def intersect[U]
    self
    # other Set
    other @ Set[U]
  do -> Set[T]
    ...

  #
  # Returns `true` when every member of the receiver is present in `other`.
  #
  #
  pub def is_subset[U]
    self
    # other Set
    other @ Set[U]
  do -> Bool
    ...

  #
  # Returns `true` when every member of `other` is present in the receiver.
  #
  #
  pub def is_superset[U]
    self
    # other Set
    other @ Set[U]
  do -> Bool
    ...

  #
  # Returns a new Set containing members present in exactly one of the two
  # sets.
  #
  #
  pub def sym_diff[U]
    self
    # other Set
    other @ Set[U]
  do -> Set[Union[T, U]]
    ...

  #
  # Returns a new Set containing all members from `self`, then first-seen members
  # from `other`.
  #
  #
  pub def union[U]
    self
    # other Set
    other @ Set[U]
  do -> Set[Union[T, U]]
    ...

  #
  # Iterates values in insertion order:
  #
  # ```
  # let s = Set [3, 1, 2, 1]
  # assert_eq [...s] [3, 1, 2]
  # ```
  # Returns an iterator.
  pub def (iter) self
    ...


#
# Abstract type for class-field setter objects.
#
# For a computed field assignment `obj.name = value`:
#
# - writing `obj.name = value` calls `setter.set(obj, value)`
#
pub class Setter[T, V]
  #
  #
  # Updates the field value for `obj`.
  #
  pub def set
    self
    # instance being assigned
    obj @ T
    # new field value
    value @ V
  do
    ...


#
# Error raised to signal that a sink has been closed.
#
pub class SinkStop: Error
  #
  #
  # Builds the signal that a sink has been closed.
  #
  # ## Example
  #
  # ```
  # throw SinkStop()
  # ```
  pub def (init) self
    ...




#
# Raised when an operation is invalid for the current object or runtime state,
# such as using a closed handle or stale reference.
#
pub class StateError: RuntimeError
  #
  #
  # Builds an error reporting an operation attempted in the wrong state.
  #
  pub def (init)
    self
    # description of the invalid state
    message @ Str
  do
    ...


#
# Decorator placing a class member in the type-object namespace without making it
# inheritable.
#
# Applies to a `def` or a `field` inside a class body. Because a static is not
# inherited, it shadows an inherited class member of the same name without
# propagating that shadowing to subclasses — which is what makes a static
# `(call)` usable as a factory that cannot recurse into itself:
#
# ```
# class Shape
#   pub field kind = ""
#
#   def (init) self kind
#     self.kind = kind
#
#   #[static]
#   pub def (call) cls kind
#     Type.(call) $cls $kind
#
# class Circle: Shape
#
# let c = Circle "arc"   # default instantiation: the factory is not inherited
# ```
#
# See [`class`](std.class) for the inherited counterpart, and
# [Class and Static Members](../../language/classes.md#class-and-static-members)
# for the full semantics.
pub let static = nil

#
# Strings are immutable sequences of UTF-8 bytes.
#
pub class Str: @Index[Range[Int], Str]
  #
  #
  # Accepts a string or decodes UTF-8 binary data. The lowercase `str` function
  # instead returns the general-purpose textual representation of any value.
  #
  # ```
  # assert_eq (Str b"hello") "hello"
  # assert_eq (str 42) "42"
  # ```
  #
  pub def (init) self value
    ...

  #
  # Returns the byte length of the string.
  #
  #
  # ## Example
  #
  # ```
  # assert_eq $"hello".len 5
  # assert_eq $"".len 0
  # ```
  #
  #[getter]
  pub def len self -> Int
    ...

  #
  # Returns an immutable view of the string's Unicode scalar values.
  #
  # The view supports `len`, positive and negative indexing, contiguous range
  # slicing, iteration, spreading, and positional destructuring. Elements and
  # slices are strings. Its operations do not change the byte-oriented behavior of
  # [`Str.len`](#len) or string indexing.
  #
  #
  # ## Example
  #
  # ```
  # let scalars = "Aé".scalars()
  # assert_eq $scalars.len 3
  # assert_eq [...scalars] ["A", "e", "́"]
  # assert_eq $scalars[-1] "́"
  # ```
  #
  pub def scalars self -> Iterable[Str]
    ...

  #
  # Returns the Unicode scalar value encoded by a single-scalar string.
  #
  #
  # ## Errors
  #
  # Raises [`ValueError`](std.ValueError) if the string contains zero or multiple
  # Unicode scalar values.
  #
  # ## Example
  #
  # ```
  # assert_eq ("A".scalar()) 65
  # assert_eq ("😀".scalar()) 128512
  # ```
  #
  pub def scalar self -> Int
    ...

  #
  # Removes one trailing line terminator.
  #
  # One complete terminator — `\r\n` or `\n`, never a lone `\r` — and nothing else.
  # A string without one is returned unchanged.
  #
  #
  # ## Example
  #
  # ```
  # assert_eq ("line\n".chomp()) "line"
  # assert_eq ("line\r\n".chomp()) "line"
  # assert_eq ("line".chomp()) "line"
  # ```
  #
  # Distinct from [`trim_end`](#trim_end-chars), which is about whitespace
  # generally and takes an optional character set:
  #
  # ```
  # assert_eq ("z  \n".chomp()) "z  "
  # assert_eq ("z  \n".trim_end()) "z"
  # ```
  #
  # [`Iter.chomp`](std.Iter.chomp) lifts this over an iterator — it is exactly
  # `.map do |x| x.chomp()`, with the mapping done inline.
  #
  pub def chomp self -> Str
    ...

  #
  # Tests whether the string contains the given substring.
  #
  #
  # ## Example
  #
  # ```
  # assert ("foobar".contains "foo")
  # assert ("foobar".contains "bar")
  # assert (!"foobar".contains "baz")
  # assert ("foobar".contains "")  # empty string is always contained
  # ```
  #
  pub def contains
    self
    # the substring to find
    needle @ Str
  do -> Bool
    ...

  #
  # Tests whether the string ends with the given suffix.
  #
  #
  # ## Example
  #
  # ```
  # assert ("foobar".ends_with "bar")
  # ```
  #
  pub def ends_with
    self
    # the suffix string
    suffix @ Str
  do -> Bool
    ...

  #
  # Returns an immutable view of the string's extended grapheme clusters.
  #
  # The view has the same indexing, slicing, iteration, spreading, and destructuring
  # operations as [`scalars`](#scalars). It keeps combining sequences and emoji
  # sequences together.
  #
  #
  # ## Example
  #
  # ```
  # let graphemes = "é👩‍💻".graphemes()
  # assert_eq $graphemes.len 2
  # assert_eq [...graphemes] ["é", "👩‍💻"]
  # ```
  #
  pub def graphemes self -> Iterable[Str]
    ...

  #
  # Joins values from an input source using this string as a separator.
  #
  #
  # ## Example
  #
  # ```
  # assert_eq (",".join ["a", "b", "c"]) "a,b,c"
  # ```
  #
  pub def join
    self
    # iterable to join; uses the default input when omitted
    iter @ Iterable[Value] = nil
  do -> Str
    ...

  #
  # Returns the string converted to lowercase.
  #
  #
  # ## Example
  #
  # ```
  # assert_eq ("HELLO".lower()) "hello"
  # assert_eq ("Hello World".lower()) "hello world"
  # ```
  #
  pub def lower self -> Str
    ...

  #
  # Returns the string repeated `count` times.
  #
  #
  # ## Example
  #
  # ```
  # assert_eq ("ab".repeat 3) "ababab"
  # assert_eq ("ab".repeat 0) ""
  # ```
  #
  pub def repeat
    self
    # non-negative repetition count
    count @ Int
  do -> Str
    ...

  #
  # Returns a new string with all non-overlapping occurrences of `from` replaced
  # with `to`.
  #
  #
  # ## Example
  #
  # ```
  # assert_eq ("foo bar foo".replace "foo" "baz") "baz bar baz"
  # assert_eq ("banana".replace "na" "") "ba"
  # assert_eq ("abc".replace "" "-") "-a-b-c-"
  # ```
  #
  pub def replace
    self
    # substring to replace
    from @ Str
    # replacement string
    to @ Str
  do -> Str
    ...

  #
  # Like `split`, but yields segments in **right-to-left** order (rightmost segment
  # first).
  #
  #
  # ## Example
  #
  # ```
  # assert_eq [..."a,b,c".rsplit ","] ["c", "b", "a"]
  # assert_eq [..."a,b,c".rsplit "," limit: 1] ["c", "a,b"]
  #
  # # Negative limit: split from the left, yield right-to-left
  # assert_eq [..."a,b,c".rsplit "," limit: -1] ["b,c", "a"]
  # ```
  #
  pub def rsplit
    self
    # the delimiter string
    delimiter @ Str
    # Maximum splits; negative values split from the left.
    #
    # - `limit: N` splits at most N times from the **right**; the last element
    #   yielded is the unsplit left remainder.
    # - `limit: -N` splits at most N times from the **left**, but still yields
    #   segments right-to-left.
    # - Omitted splits fully with no limit.
    limit @ Int = nil
  do -> Iter[Str]
    ...

  #
  # Splits the string by the delimiter, returning an iterator that yields segments
  # in **left-to-right** order.
  #
  #
  # ## Example
  #
  # ```playground
  # #> import test:
  # #>   - assert_eq
  # assert_eq [..."a,b,c".split ","] ["a", "b", "c"]
  # assert_eq [..."a,b,c".split "," limit: 1] ["a", "b,c"]
  #
  # # Negative limit: split from the right, yield left-to-right
  # let base ext = "archive.tar.gz".split "." limit: -1
  # assert_eq $base "archive.tar"
  # assert_eq $ext "gz"
  # ```
  #
  pub def split
    self
    # the delimiter string
    delimiter @ Str
    # Maximum splits; negative values split from the right.
    #
    # - `limit: N` (positive) splits at most N times from the **left**; the last
    #   element is the unsplit remainder.
    # - `limit: -N` (negative) splits at most N times from the **right**, but still
    #   yields segments left-to-right. This is useful for splitting off a known-length
    #   suffix such as a file extension.
    # - Omitted splits fully with no limit.
    limit @ Int = nil
  do -> Iter[Str]
    ...

  #
  # Tests whether the string starts with the given prefix.
  #
  #
  # ## Example
  #
  # ```
  # assert ("foobar".starts_with "foo")
  # assert (!("foobar".starts_with "bar"))
  # ```
  #
  pub def starts_with
    self
    # the prefix string
    prefix @ Str
  do -> Bool
    ...

  #
  # Removes whitespace (or specified characters) from both ends.
  #
  #
  # ## Example
  #
  # ```
  # assert_eq ("  hello  ".trim()) "hello"
  # assert_eq ("xxhelloxx".trim "x") "hello"
  # assert_eq ("xyhelloyx".trim ["x", "y"]) "hello"
  # ```
  #
  pub def trim
    self
    chars @ (Str | Iterable[Str]) = nil
  do -> Str
    ...

  #
  # Removes whitespace (or specified characters) from the end.
  #
  #
  # ## Example
  #
  # ```
  # assert_eq ("  hello  ".trim_end()) "  hello"
  # assert_eq ("xxhelloxx".trim_end "x") "xxhello"
  # ```
  #
  pub def trim_end
    self
    chars @ (Str | Iterable[Str]) = nil
  do -> Str
    ...

  #
  # Removes whitespace (or specified characters) from the start.
  #
  #
  # ## Example
  #
  # ```
  # assert_eq ("  hello  ".trim_start()) "hello  "
  # assert_eq ("xxhelloxx".trim_start "x") "helloxx"
  # ```
  #
  pub def trim_start
    self
    chars @ (Str | Iterable[Str]) = nil
  do -> Str
    ...

  #
  # Returns the string converted to uppercase.
  #
  #
  # ## Example
  #
  # ```
  # assert_eq ("hello".upper()) "HELLO"
  # assert_eq ("Hello World".upper()) "HELLO WORLD"
  # ```
  #
  pub def upper self -> Str
    ...

  #
  # Returns the string with the prefix removed if it matches, otherwise returns
  # the original string.
  #
  #
  # ## Example
  #
  # ```
  # assert_eq ("foobar".without_prefix "foo") "bar"
  # assert_eq ("foobar".without_prefix "baz") "foobar"
  # ```
  #
  pub def without_prefix
    self
    # the prefix to remove
    prefix @ Str
  do -> Str
    ...

  #
  # Returns the string with the suffix removed if it matches, otherwise returns
  # the original string.
  #
  #
  # ## Example
  #
  # ```
  # assert_eq ("foobar".without_suffix "bar") "foo"
  # ```
  #
  pub def without_suffix
    self
    # the suffix to remove
    suffix @ Str
  do -> Str
    ...

  #
  # Strings accept [`Range`](std.Range) values for slicing by byte position:
  #
  # ```
  # assert_eq $"abcd"[1..3] "bc"
  # assert_eq $"abcd"[..2] "ab"
  # assert_eq $"abcd"[2..] "cd"
  # assert_eq $"abcd"[..] "abcd"
  # assert_eq $"foobar"[-3..] "bar"
  # ```
  #
  # This returns a new string. Slice boundaries must still fall on valid UTF-8
  # boundaries. Omitted `start` means `0`, omitted `end` means the string length,
  # and negative endpoints count from the end.
  # Indexes the value.
  pub def (index) self index
    ...

  # Returns an iterator.
  pub def (iter) self
    ...


#
# Mutable UTF-8 string buffer; the mutable counterpart to [`Str`](std.Str).
#
pub class StrBuf: @Index[Range[Int], Str] @Assign[Range[Int], Str]
  #
  #
  # Builds a buffer, optionally seeded with the contents of an existing string.
  #
  # ## Example
  #
  # ```
  # let buf = StrBuf("hello")
  # assert_eq $buf.len 5
  # ```
  #
  pub def (init)
    self
    # initial contents
    initial @ Str = nil
  do
    ...

  #
  # Returns the byte length of the buffer's current contents.
  #
  #
  # ## Example
  #
  # ```
  # assert_eq (StrBuf("hello").len) 5
  # ```
  #
  #[getter]
  pub def len self -> Int
    ...

  #
  # Appends `value` to the buffer. `Str` input is copied byte-for-byte; anything
  # else is converted the same way [`str`](std.str) would convert
  # it, written directly into the buffer.
  #
  # ## Example
  #
  # ```
  # let buf = StrBuf()
  # buf.append "foo"
  # buf.append 42
  # assert_eq $buf.freeze() "foo42"
  # ```
  #
  pub def append
    self
    # value to append
    value
  do
    ...

  #
  # Empties the buffer, retaining its allocated capacity.
  #
  # ```
  # let buf = StrBuf("foobar")
  # buf.clear()
  # assert_eq $buf.len 0
  # buf.append "x"
  # assert_eq $buf.freeze() "x"
  # ```
  #
  pub def clear self
    ...

  #
  # Tests whether the buffer's contents contain the given substring.
  #
  #
  # ## Example
  #
  # ```
  # assert (StrBuf("foobar").contains "oob")
  # ```
  #
  pub def contains
    self
    # the substring to find
    needle @ Str
  do -> Bool
    ...

  #
  # Returns an iterator that removes and yields up to `size` bytes at a time
  # from the front of the buffer as it's consumed.
  #
  # Each chunk boundary is rounded down to the nearest UTF-8 code point
  # boundary, unless that would produce an empty chunk (`size` smaller than the
  # first remaining code point), in which case it rounds up instead so every
  # chunk yielded is non-empty.
  #
  #
  # ## Example
  #
  # ```
  # let buf = StrBuf("hello world")
  # assert_eq [...buf.drain(4)] ["hell", "o wo", "rld"]
  # assert_eq $buf.len 0
  # ```
  #
  # Draining never shifts the buffer's remaining contents proportionally to
  # their length: consumed bytes are dropped by advancing an internal cursor,
  # not by copying the tail down on every chunk. Other mutating methods (and
  # `freeze`) settle this cursor transparently before they run, so indices
  # passed to them are always relative to the buffer's current (undrained)
  # content. Multiple `drain` iterators created from the same buffer share this
  # cursor, so they interleave draining the same content rather than each
  # redraining it independently.
  #
  pub def drain
    self
    # maximum bytes per chunk (defaults to 512 KiB)
    size @ Int = nil
  do -> Iter[Str]
    ...

  #
  # Tests whether the buffer's contents end with the given suffix.
  #
  #
  # ## Example
  #
  # ```
  # assert (StrBuf("foobar").ends_with "bar")
  # ```
  #
  pub def ends_with
    self
    # the suffix string
    suffix @ Str
  do -> Bool
    ...

  #
  # Appends the raw bytes of `value`, which must be a [`Str`](std.Str).
  #
  # ## Example
  #
  # ```
  # let buf = StrBuf("foo")
  # buf.extend "bar"
  # assert_eq $buf.freeze() "foobar"
  # ```
  #
  pub def extend
    self
    # string to append
    value @ Str
  do
    ...

  #
  # Converts the buffer's current contents into an immutable [`Str`](std.Str)
  # in place, without copying, and empties the buffer. The buffer stays usable
  # afterward, and the returned string is unaffected by later mutation.
  #
  #
  # ## Example
  #
  # ```
  # let buf = StrBuf("abc")
  # let frozen = buf.freeze()
  # assert_eq $frozen "abc"
  # assert_eq $buf.len 0
  # buf.append "def"
  # assert_eq $frozen "abc"
  # ```
  #
  pub def freeze self -> Str
    ...

  #
  # Inserts `value` at the given byte index, shifting the rest of the buffer
  # right in place.
  #
  # ## Example
  #
  # ```
  # let buf = StrBuf("foobar")
  # buf.insert 3 "XYZ"
  # assert_eq $buf.freeze() "fooXYZbar"
  # ```
  #
  pub def insert
    self
    # insertion point; must fall on a UTF-8 boundary
    index @ Int
    # string to insert
    value @ Str
  do
    ...

  #
  # Removes and returns the substring covered by `range`, shifting the rest of
  # the buffer left in place.
  #
  #
  # ## Example
  #
  # ```
  # let buf = StrBuf("foobar")
  # assert_eq (buf.remove (1..3)) "oo"
  # assert_eq $buf.freeze() "fbar"
  # ```
  #
  # Unlike `insert`, `remove` only accepts a range — a scalar index would remove
  # a single UTF-8 code unit, which is rarely a useful result.
  #
  pub def remove
    self
    # byte range to remove; must fall on UTF-8 boundaries
    range @ Range[Int]
  do -> Str
    ...

  #
  # Tests whether the buffer's contents start with the given prefix.
  #
  #
  # ## Example
  #
  # ```
  # assert (StrBuf("foobar").starts_with "foo")
  # ```
  #
  pub def starts_with
    self
    # the prefix string
    prefix @ Str
  do -> Bool
    ...

  #
  # Shrinks the buffer to `len` bytes, discarding anything past that point.
  #
  # ## Example
  #
  # ```
  # let buf = StrBuf("foobar")
  # buf.truncate 3
  # assert_eq $buf.freeze() "foo"
  # ```
  #
  pub def truncate
    self
    # new length; must fall on a UTF-8 boundary
    len @ Int
  do
    ...

  #
  # `StrBuf` supports only range indexing and assignment, matching `Str` — a
  # single UTF-8 code unit is rarely a useful result on its own:
  #
  # ```
  # let buf = StrBuf("foobar")
  # assert_eq $buf[2..4] "ob"
  # buf[1..3] = "XYZ"
  # assert_eq $buf.freeze() "fXYZbar"
  # ```
  #
  # Range assignment may grow or shrink the buffer: the replacement doesn't need
  # to be the same length as the range it replaces. Both the range and the
  # assigned value's boundaries must land on UTF-8 code point boundaries.
  #
  pub def (index) self index
    ...

  # Assigns through an index.
  pub def (assign) self index value
    ...

  #
  # `StrBuf` is a [sink](std.Sink), so it can be the target of a pipeline, of
  # [`strand.put`](strand), or of a
  # [`run`](../../shell/external-programs.md#redirecting-io) redirect. `put` is
  # [`append`](#append-value): the value's string form goes in verbatim, with no
  # line terminator added.
  #
  # ```
  # let buf = StrBuf()
  # run uname -r stdout: $buf
  # ```
  #
  # Line termination is the caller's to choose, so a `StrBuf` can stand in for any
  # other sink without changing what gets written:
  #
  # ```
  # let buf = StrBuf()
  # let out = buf.precrimp()
  # out.put "first"
  # out.put "second"
  # assert_eq $buf.freeze() "first\nsecond\n"
  # ```
  pub def (sink) self
    ...


#
# Symbols are interned identifiers used for dictionary keys and enum-like
# values.
#
#
# ## Creating Symbols
#
# Literal syntax with surrounding colons:
#
# ```
# let s = :my_symbol:
# ```
#
# From a string with the lowercase `sym` coercion:
#
# ```
# let s = sym "my_symbol"
# assert_eq $s :my_symbol:
# ```
#
# Enum-like values:
#
# ```
# let status = :ok:
# let mode = :verbose:
# ```
#
# Dictionary keys:
#
# ```
# let d = {}
# d[:status:] = "active"
# ```
pub class Sym
  # Symbols are compared by identity.
  #
  # ```
  # assert_eq :foo: :foo:
  # assert (:foo: != :bar:)
  # ```
  pub def (eq) self other
    ...

  # Symbols compare lexicographically by name.
  #
  # ```
  # assert (:alpha: < :beta:)
  # ```
  pub def (lt) self other
    ...


#
# Raised when a strand times out. Timeout is cooperative and is observed at
# suspend or interrupt-check points.
#
pub class TimedOutError: RuntimeError
  #
  #
  # Builds an error reporting that a strand timed out.
  #
  pub def (init) self
    ...


#
# Tuples are immutable, ordered sequences of values. They are produced by
# certain operations such as iterating over key-value pairs. The `Tuple` type
# object is in the prelude, so `Tuple(iterable)` is available without an
# explicit import.
#
pub class Tuple[*Ts]: Iterable[Union[...Ts]] @Seq[Union[...Ts]]
  #
  #
  # Builds a tuple from an iterable.
  #
  # The lowercase `tuple` factory instead collects its positional arguments
  # verbatim.
  #
  # ## Example
  #
  # ```
  # let tup = Tuple([1, 2, 3])
  # assert_eq $tup[1] 2
  #
  # for k v = {name: "Alice", age: 30}
  #   # each pair is a tuple
  #   echo "$k: $v"
  # ```
  #
  pub def (init)
    self
    # values to collect
    iterable
  do
    ...

  #
  # Returns the number of elements.
  #
  #
  #[getter]
  pub def len self -> Int
    ...

  #
  # Tests whether the tuple contains the given element (by equality).
  #
  #
  pub def contains
    self
    # the value to check
    element
  do -> Bool
    ...

  #
  # Returns a shallow copy of the tuple. Because tuples are immutable, the
  # returned copy may be the same object.
  #
  #
  pub def copy self -> Tuple[...Ts]
    ...

  #
  # Retrieves the value at the given index. Returns `nil` if out of bounds and no
  # alternative is provided. Negative indexes count from the end.
  #
  #
  pub def get[D = nil]
    self
    # the index to access
    index @ Int
    :default @ D = nil
    :else @ (() -> D) = nil
  do -> (Union[...Ts] | D)
    ...

  #
  # Returns an iterator yielding `[index, value]` pairs.
  #
  #
  pub def pairs self -> Iter[Tuple[Int, Value]]
    ...

  @def (index) self index@Int -> Union[...Ts]
  @def (index) self range@Range[Int] -> Tuple[...Union[...Ts]]

  #
  # ```
  # let pair = {name: "Alice"}.pairs().next()
  # assert_eq $pair[0] :name:
  # assert_eq $pair[1] "Alice"
  # assert_eq $pair[-1] "Alice"
  # ```
  #
  # Tuples are immutable; indexed assignment is not supported.
  #
  # Tuples also accept [`Range`](std.Range) values for slicing:
  #
  # ```
  # let tup = Tuple [0, 1, 2, 3]
  # assert_eq $tup[1..3] (tuple 1 2)
  # assert_eq $tup[..2] (tuple 0 1)
  # assert_eq $tup[2..] (tuple 2 3)
  # assert_eq $tup[..] (tuple 0 1 2 3)
  # assert_eq $tup[Range 0 4 2] (tuple 0 2)
  # assert_eq $tup[Range nil nil -1] (tuple 3 2 1 0)
  # ```
  #
  # Slice indexing returns a new tuple. Omitted `start` means `0`, omitted `end`
  # means the tuple length, and negative endpoints count from the end. Negative
  # steps reverse the slice.
  pub def (index) self index
    ...

  # Unpacks tuple elements.
  #
  # ```
  # for k v = {name: "Alice", age: 30}
  #   echo "$k = $v"
  # ```
  pub def (unpack) self
    ...


#
# Raised when an operation receives a value of the wrong type.
#
pub class TypeError: RuntimeError
  #
  #
  # Builds an error reporting a value of the wrong type.
  #
  pub def (init)
    self
    # description of the mismatch
    message @ Str
  do
    ...


#
# The type of a class whose instances are `T`. `Type` is the type of all types
# and cannot be constructed directly.
pub class Type[T]
  field instance @ Phantom[T]

#
# Raised when an unexpected key argument is passed.
#
pub class UnexpectedKeyError: RuntimeError
  #
  #
  # Builds an error naming an unexpected key item.
  #
  pub def (init)
    self
    # the unexpected key
    key
  do
    ...


#
# Raised when an unexpected positional argument is passed.
#
pub class UnexpectedPosError: RuntimeError
  #
  #
  # Builds an error naming an unexpected positional item.
  #
  pub def (init)
    self
    # zero-based position of the unexpected item
    index @ Int
  do
    ...


#
# Raised when an unsupported operation is attempted.
#
pub class UnsupportedError: RuntimeError
  #
  #
  # Builds an error reporting that an operation is not supported.
  #
  pub def (init) self
    ...


#
# Raised when a value has an acceptable type but invalid contents, range, or
# meaning for the operation.
#
pub class ValueError: RuntimeError
  #
  #
  # Builds an error reporting a value of the right type but unusable contents.
  #
  pub def (init)
    self
    # description of the problem with the value
    message @ Str
  do
    ...


#
# `Value` is the abstract supertype of all values.
#
# `Value` is not constructible directly.
pub class Value

#
# Raised on integer division or modulo by zero.
#
pub class ZeroDivError: RuntimeError
  #
  #
  # Builds an error reporting division by an integer zero.
  #
  pub def (init) self
    ...
