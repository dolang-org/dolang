# Fixture module documentation.
#
# ## Overview
#
# See [`Point`](#fixture--Point).

import std:
  - Record

import std

# Re-exported for types only.
pub import std:
  - @Iterable: Seq

import std:
  - @Iter: Cursor

# A greeting.
#
# Spans several lines.
pub def greet name :greeting = "hello" ...rest
  echo $greeting $name ...rest

# Not exported, so it is omitted unless everything is asked for.
def internal x
  x

# The module's default name.
pub let default_name = "world"

# A private module-level binding.
let secret = "shhh"

# A named point.
pub class Point[T @ (Int | Str) = Int, :K, ...R]: Record
  # The horizontal coordinate.
  pub field x @Int = 0

  # How many points exist.
  #[class]
  pub field count = 0

  # A shared origin.
  #[static]
  pub field origin = nil

  # Build a point.
  pub def (init) self x
    self.x = x

  # Render it.
  pub def (str) self
    str $self.x

  # The coordinate, read as a field.
  #[getter]
  pub def horizontal self -> Int
    self.x

  # Move it.
  pub def shift[U] self by :clamp = false
    self.x = (self.x + by)

  # Label it, only for a string point.
  pub def label[S @ Str] self @ Point[S] -> S
    str $self.x

  # Not exported.
  def helper self
    nil

# Inherits through a module path rather than an imported item.
pub class Tagged: std.Record
  pub field tag = nil

# Place a point.
pub def place point @Point :limit @(Int | nil) = nil -> std.Dict[Str, Record]
  nil

# The first of some items.
pub def first[T] items @Array[T] :fallback @((Int, ?Str) -> T) = nil :options @Dict[{name: Str, ?port: Int, ...Str: Str}] = nil :mode @(:fast: | "slow" | 1 | true) = nil -> T
  items[0]

# Build something.
#
# The parameters are laid out vertically, so each can be documented on its own.
pub def build
  # Where the parts come from.
  :from
  # Whether to fetch them first.
  :pull = true
  # Everything else, passed along.
  ...args
do
  echo $from $pull ...args

# Something with an area.
pub @class Shaped
  # The area.
  pub def area self -> Int

  # The area, scaled.
  pub def area self scale @ Int -> Int

# A point with an area.
pub class Plot: Point @Shaped
  # The area of a point.
  @def area self -> Int
  pub def area _self
    0

# Grow a number.
@def grow x @ Int -> Int

# Grow a string.
@def grow x @ Str -> Str

pub def grow x
  (x + x)

# Collects callable arguments with corresponding result types.
pub def mapped[...Rs] ...thunks @ ...(() -> Rs) -> Tuple[...Rs]
  thunks

# A type with no definition in source.
pub @let Opaque[T] = ...

# A nested list of labels.
pub @let Outline = Array[(Label | Outline)]

# A leaf of an outline.
pub @let Label = Str
