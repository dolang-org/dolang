# dolang: strict
# Command-line options the boot entrypoint supplies to the entrypoints it runs.
@import compile: compiler

# Prelude from `--import` and `--import-item`: module names to their bindings.
pub let prelude @ BaseDict[Str | Sym, compiler.PreludeBinding] = ...

# The least severe diagnostic shown, from `--diagnose`.
pub let diagnose @ compiler.Severity = ...

# The least severe diagnostic that fails a run, from `--fail`.
pub let fail @ compiler.Severity = ...

# Whether REPL history is enabled.
pub let history @ Bool = ...

# Whether the bytecode cache is enabled.
pub let cache @ Bool = ...
