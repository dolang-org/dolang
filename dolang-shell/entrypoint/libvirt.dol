import _shell _script _boot_options args libvirt load shell
  fs:
    - Path

# Resolves the target to run remotely, returning a function that runs it and
# the program the target should see as its own invocation. A script is read
# and compiled now, before connecting.
def load_target main target
  if main
    let Bin(bytecode) = _shell.resource "dolang.entrypoint" $target
    else throw args.Error "unknown entrypoint: $target"
    [(do load.run(bytecode)), target]
  else
    let script = Path $target
    let program = _script.load $script
      prelude: $_boot_options.prelude
      strict: $_boot_options.strict
      cache: $_boot_options.cache
    [program, script]

def parse_env sets unsets
  let overrides = {}
  for spec = sets
    let name value = if spec.contains "="
      spec.split "=" limit: 1
    else
      [spec, :INHERIT:]
    if (name.len == 0)
      throw args.Error "--env expects a non-empty name"
    overrides[name] = value

  for name = unsets
    if (name.len == 0 || name.contains "=")
      throw args.Error "--unset-env expects a non-empty name without '='"
    overrides[name] = nil
  overrides

args.with
  help: Run a local Do script or bundled entrypoint through a libvirt domain VFS.
  - flag: main
    short: m
    help: Run a bundled main entrypoint instead of a local script
  - opt: connect-uri
    default: qemu:///session
    meta: URI
    help: Libvirt connection URI
  - opt: cd
    parse: $Path
    default: nil
    meta: PATH
    help: Initial remote working directory
  - opt: env
    collect: true
    meta: NAME[=VALUE]
    help: Set or inherit a remote environment variable; may be repeated
  - opt: unset-env
    collect: true
    meta: NAME
    help: Unset a remote environment variable; may be repeated
  - arg: domain
    help: Libvirt domain name
  - arg: script
    divider: true
    help: Local Do script, or bundled entrypoint name with --main
  - arg: script-args
    collect: true
    help: Arguments passed to the target script
  do |p|
    let remote_env = parse_env $p.env $p.unset_env
    let run_target program = load_target $p.main $p.script
    let domain = libvirt.attach $p.domain connect_uri: $p.connect_uri

    domain.with
      cd: $p.cd
      env: $remote_env
      do
        shell.with_override
          program: $program
          args: $p.script_args
          do run_target()
