# dolang: strict

# Project tooling: `dolang -m doze check` checks a project's sources,
# `dolang -m doze test` runs its tests, and `dolang -m doze bundle` packs its
# program into a bundle.

import _bundle _shell args compile json regex shell toml
  fs:
    - Path

let IDENTIFIER = regex.Regex r"^[A-Za-z_][A-Za-z0-9_]*$"

# The project's configuration file, at its root.
let CONFIG_FILE = "doze.toml"

# Raised for a project that isn't laid out as `doze` expects.
#[final]
class ProjectError: std.RuntimeError
  def (init) self message @ Str
    std.RuntimeError.(init) $self $message

# What compiling, and possibly checking, a project's sources found.
#[final]
class Report
  field diagnostics @ Array[compile.Diagnostic] = []
  # The path of the unit that reported each diagnostic, by its index in
  # `diagnostics`.
  field reporters @ Array[Str] = []
  # The path of each unit checked together, by unit index.
  field units @ Array[Str] = []
  field sources @ Int = 0
  field checked @ Bool = false
  field strict @ Bool = false

  def (init)
    self
    diagnostics @ Array[compile.Diagnostic]
    # The path of the unit that reported each diagnostic.
    reporters @ Array[Str]
    # The path of each unit checked together, by unit index.
    units @ Array[Str]
    # How many sources were compiled.
    sources @ Int
    # Whether the sources' types were checked.
    checked @ Bool
    # Whether warnings fail too.
    :strict @ Bool = false
  do
    self.#diagnostics = diagnostics
    self.#reporters = reporters
    self.#units = units
    self.#sources = sources
    self.#checked = checked
    self.#strict = strict

  #[getter]
  pub def diagnostics self -> Seq[compile.Diagnostic]
    self.#diagnostics

  # How many sources were compiled.
  #[getter]
  pub def sources self -> Int
    self.#sources

  # Whether the sources' types were checked.
  #[getter]
  pub def checked self -> Bool
    self.#checked

  #[getter]
  pub def errors self -> Int
    self.#diagnostics.filter(do |diag| diag.severity == :ERROR:).count()

  #[getter]
  pub def warnings self -> Int
    (self.#diagnostics.len - self.errors)

  # Whether the sources passed: no errors, and no warnings when strict.
  #[getter]
  pub def passed self -> Bool
    (self.errors == 0 && (!self.#strict || self.warnings == 0))

  # The report as data for `json.encode`: the summary, and each diagnostic with
  # its locations resolved to paths.
  pub def json self -> Dict[Sym, json.EncodeValue]
    let diagnostics = $
      for diag reporter = self.#diagnostics.zip(self.#reporters)
        - $self.#diagnostic_json(diag, reporter)
    $
      sources: $self.#sources
      checked: $self.#checked
      errors: $self.errors
      warnings: $self.warnings
      passed: $self.passed
      diagnostics: $diagnostics

  # A diagnostic as data for `json.encode`, given the path of the unit that
  # reported it.
  def diagnostic_json self diag@compile.Diagnostic reporter@Str -> Dict[Sym, json.EncodeValue]
    let annotations = $
      for annotation = diag.annotations
        - $self.#location_json(annotation.span, reporter, kind: lower(annotation.kind), message: annotation.message)
    let notes = $
      for note = diag.notes
        - {kind: lower(note.kind), message: note.message}
    let patches = $
      for patch = diag.patches
        - $self.#location_json(patch.span, reporter, message: patch.message, sub: patch.sub)
    $
      path: $self.#path(diag.span, reporter)
      severity: $lower(diag.severity)
      message: $diag.message
      span: $span_json(diag.span.span)
      annotations: $annotations
      notes: $notes
      patches: $patches

  # The fields `fields`, with the path and span of `location`.
  def location_json self location@compile.SourceSpan reporter@Str **fields@Str -> Dict[Sym, json.EncodeValue]
    let path = self.#path(location, reporter)
    {...fields, path: path, span: span_json(location.span)}

  # The path of the source `location` is in, given the path of the unit that
  # reported it.
  def path self location@compile.SourceSpan reporter@Str -> Str
    if let Int(unit) = location.unit
      self.#units[unit]
    else
      reporter

# A symbol's name, lowercased.
def lower value @ Sym -> Str
  str(value).lower()

# A span as data for `json.encode`, as `compile.Span` describes it.
def span_json span @ compile.Span -> Dict[Sym, json.EncodeValue]
  $
    start:
      line: $span.start.line
      column: $span.start.column
    len: $span.len

# Sources compiled together: modules by name, and scripts. Units are compiled
# as they are added; checking their types, when asked for, waits for the
# report.
class Compiler
  field check @ Bool = false
  field strict @ Bool = false
  # Each source's unit, by path.
  field units @ Dict[Path, compile.Unit] = {}
  # Each source's text, by path.
  field sources @ Dict[Path, Str] = {}

  def (init)
    self
    # Whether to check the sources' types.
    :check @ Bool = false
    # Whether warnings fail too.
    :strict @ Bool = false
  do
    self.#check = check
    self.#strict = strict

  # Adds the module `name`, whose source is at `path`.
  pub def add_module self name@Str path@Path
    self.#add $path $name

  # Adds the script at `path`.
  pub def add_script self path @ Path
    self.#add $path nil

  # The unit of the source at `path`, for emitting once the report passes.
  pub def unit self path @ Path -> compile.Unit
    self.#units[path]

  # The text of the source at `path`.
  pub def source self path @ Path -> Str
    self.#sources[path]

  # Checks for diagnostics on added sources, including type checking if requested
  pub def check self -> Report
    let diagnostics @ Array[compile.Diagnostic] = []
    let reporters @ Array[Str] = []
    # Each unit's path, by its index in a check
    let units @ Array[Str] = []
    for path unit = self.#units
      units.push "$path"
      for diag = unit.diagnostics()
        diagnostics.push $diag
        reporters.push "$path"
    let strict = self.#strict
    let count = self.#units.len
    if (!self.#check || diagnostics.any(do |diag| diag.severity == :ERROR:))
      return Report $diagnostics $reporters $units $count $self.#check :strict
    # With no errors, the check accepts every unit, so unit indices follow the
    # order they are added in
    let checker = compile.Check()
    for unit = self.#units.values()
      checker.add $unit
    add_bundled $checker $units
    for diag = checker.run().diagnostics
      let Int(unit) = diag.span.unit
      else throw std.RuntimeError "checker diagnostic without a unit: $(diag.message)"
      diagnostics.push $diag
      reporters.push $units[unit]
    Report $diagnostics $reporters $units $count true :strict

  def add self path@Path module@(Str | nil)
    let text = path.read_str()
    let check = self.#check
    self.#sources[path] = text
    self.#units[path] = compile.compile "$path" $text typecheck: $check
      if module
        :module

# Adds the bundled typelibs of the modules `checker` is missing, and of those
# they need in turn, appending each one's path to `paths`.
def add_bundled checker@compile.Check paths@Array[Str]
  let tried @ Set[Str] = Set []
  let more = true
  while more
    more = false
    for name = checker.missing()
      if tried.contains(name)
        continue
      tried.add $name
      more = true
      let resource = _shell.resource "dolang.typelib" $name
      # A module that isn't bundled either is left for the check to report
      if (resource == nil)
        continue
      let Bin(bytes) = resource
      else throw std.RuntimeError "broken dolang build: bundled typelib of $name isn't binary"
      let typelib = compile.Typelib $bytes
      checker.add $typelib
      paths.push $typelib.path

# A project: a directory laid out by convention. Its modules are the `.dol`
# files under `lib/`, its program is `main.dol`, and its tests are the `.dol`
# files under `test/`. Its build output goes under `build/`. An optional
# `doze.toml` gives its metadata.
class Project
  field root @ Path
  # The project's name: `doze.toml`'s, else its directory's.
  field name @ Str
  field version @ (Str | nil) = nil
  field authors @ Array[Str] = []
  field license @ (Str | nil) = nil
  field description @ (Str | nil) = nil
  # The program's source, if the project has one.
  field main @ (Path | nil) = nil
  # Each module's source, by module name.
  field modules @ Dict[Str, Path] = {}
  # The tests' sources.
  field tests @ Array[Path] = []

  # The project at `root`. Never searches its parents.
  def (init) self root @ Path
    if (!root.exists() || root.metadata().type != :DIR:)
      throw ProjectError "not a directory: $root"
    self.#root = root
    self.#name = (root.canonical().name || "project")
    self.#configure()
    self.#discover()

  # Checks the types of the project's sources, its tests included.
  pub def check self :strict @ Bool = false -> Report
    let compiler = self.#compile check: true :strict tests: true
    compiler.check()

  # Packs the program and every module into a bundle, after checking them
  # unless `check` is false. Nothing is written unless the report passes.
  pub def bundle
    self
    # File to write; by default, `build/<name>.dolz` in the project, named after
    # the project.
    :output @ (Path | nil) = nil
    # Whether to check the sources' types first. True by default.
    :check @ Bool = true
    # Whether warnings fail too.
    :strict @ Bool = false
    # Interpreter command for a `#!` line.
    :shebang @ (Str | nil) = nil
  do -> Report
    let Path(main) = self.#main
    else throw ProjectError "no main.dol in $(self.#root)"
    let compiler = self.#compile :check :strict tests: false
    let report = compiler.check()
    if !report.passed
      return report
    let program = (source: compiler.source(main), bytecode: compiler.unit(main).emit())
    let modules @ Dict[Str, _bundle.Program] = $
      for name path = self.#modules
        $name: (source: compiler.source(path), bytecode: compiler.unit(path).emit())
    let out = if let Path(output) = output
      output
    else
      let build = (self.#root / "build")
      build.create_dir all: true
      (build / "$(self.#name).dolz")
    _bundle.write $out $program $modules :shebang
    report

  # Runs the tests under `test/` with `dolang -m test`, with `lib/` on the
  # module path, passing `harness` to it. Runs from the project's directory, so
  # test IDs don't depend on how the project was named. Replaces the running
  # program.
  pub def test self harness @ Array[Str] -> Never
    if !self.#test_dir().exists()
      throw ProjectError "no test directory in $(self.#root)"
    let exe = shell.exe.absolute()
    shell.cd $self.#root do
      shell.exec $exe --module-path lib -m test test ...harness

  # Reads `doze.toml`, if the project has one.
  def configure self
    let file = (self.#root / CONFIG_FILE)
    if !file.exists()
      return
    let doc = try
      toml.decode $file.read_str()
    catch std.DataError: e
      throw ProjectError "invalid TOML in $file: $e"
    # A document is always a table
    let Dict(table) = doc
    else throw std.RuntimeError "TOML document isn't a table: $file"
    bind table
      "project": project = {}
      **rest
    unknown $file "" $rest
    let Dict(project) = project
    else throw ProjectError "$file: `project` must be a table"
    bind project
      "name": name = nil
      "version": version = nil
      "authors": authors = nil
      "license": license = nil
      "description": description = nil
      **rest
    unknown $file "project." $rest
    if let Str(name) = config_str(file, "project.name", name)
      if (name == "" || name == "." || name == ".." || name.contains("/") || name.contains("\\") || name.contains("\0"))
        throw ProjectError "$file: `project.name` can't name a file: `$name`"
      self.#name = name
    self.#version = config_str $file project.version $version
    self.#license = config_str $file project.license $license
    self.#description = config_str $file project.description $description
    if (authors != nil)
      let Array(items) = authors
      else throw ProjectError "$file: `project.authors` must be an array of strings"
      for item = items
        let Str(author) = item
        else throw ProjectError "$file: `project.authors` must be an array of strings"
        self.#authors.push $author

  # Finds the program and the modules.
  def discover self
    let main = (self.#root / "main.dol")
    if main.exists()
      self.#main = main
    let lib = self.#lib_dir()
    if lib.exists()
      for file = lib.glob "**/*.dol"
        let name = self.#module_name $file
        if let Path(other) = self.#modules.get(name)
          throw ProjectError "module $name given by both $other and $file"
        self.#modules[name] = file
    let tests = self.#test_dir()
    if tests.exists()
      for file = tests.glob "**/*.dol"
        self.#tests.push $file

  # The directory of the project's modules.
  def lib_dir self -> Path
    (self.#root / "lib")

  # The directory of the project's tests.
  def test_dir self -> Path
    (self.#root / "test")

  # The name of the module whose source is `file`: `lib/a/b.dol` or
  # `lib/a/b/mod.dol` is `a.b`.
  def module_name self file @ Path -> Str
    let named = if (file.name == "mod.dol")
      (file.parent !@ Path)
    else
      file.without_ext()
    let parts = [...named.relative(self.#lib_dir()).components]
    if (parts.len == 0 || parts.any(do |part| IDENTIFIER.match(part) == nil))
      throw ProjectError "invalid module path: $file"
    ".".join $parts

  # The project's sources, compiled together, with its tests if `tests` is true.
  def compile self :check@Bool :strict@Bool :tests@Bool -> Compiler
    let compiler = Compiler :check :strict
    let main = self.#main
    if let Path(main) = main
      compiler.add_script $main
    for name path = self.#modules
      compiler.add_module $name $path
    if tests
      for path = self.#tests
        compiler.add_script $path
    compiler

# A string read from `key` in the configuration `file`, or nil if absent.
def config_str file@Path key@Str value@(toml.DecodeValue | nil) -> (Str | nil)
  if (value == nil)
    return nil
  let Str(text) = value
  else throw ProjectError "$file: `$key` must be a string"
  text

# Rejects the keys left in `rest`, under `prefix`, in the configuration `file`.
def unknown file@Path prefix@Str rest@Iterable[(Str, toml.DecodeValue)]
  let keys = $
    for key _ = rest
      - "`$prefix$key`"
  if (keys.len > 0)
    throw ProjectError "$file: unknown keys: $(", ".join(keys))"

# Renders `report` and a summary, then exits with failure unless it passed.
def finish report @ Report
  for diag = report.diagnostics
    echo $diag.render()
  let verb = (report.checked && "checked" || "compiled")
  echo "$verb $(report.sources) sources: $(report.errors) errors, $(report.warnings) warnings"
  if !report.passed
    shell.exit 1

# Runs a command on the project at `path`, the current directory by default,
# reporting a `ProjectError` as its failure. The report is also written as JSON
# to `report`, if given, unless the project couldn't be read.
def with_project path@(Str | nil) report@(Str | nil) command@((Project) -> Report)
  try
    let result = command(Project(Path(path || ".")))
    if let Str(file) = report
      Path(file).write $json.encode(result.json(), indent: 2)
    finish $result
  catch ProjectError: e
    echo "error: $e"
    shell.exit 1

args.with
  help: Check, test and bundle a Do project.
  - opt: project
    default: nil
    help: The project directory; by default, the current directory
  - cmd: check
    help: Check the types of the project's modules under `lib/`, its `main.dol`, and its tests under `test/`.
    - flag: strict
      help: Fail on warnings too
    - opt: json
      default: nil
      help: File to also write the report to, as JSON
    do |p|
      let :strict :json ... = p.check
      with_project $p.project $json do |it| it.check(:strict)
  - cmd: test
    help: Run the project's tests under `test/` with `dolang -m test`, with `lib/` on the module path.
    divider: true
    - arg: harness
      collect: true
      help: Arguments to `dolang -m test`
    do |p|
      let :harness ... = p.test
      with_project $p.project nil do |it| it.test $harness
  - cmd: bundle
    help: Check the project, then pack `main.dol` and every module under `lib/` into a bundle.
    - flag: strict
      help: Fail the check on warnings too
    - flag: no-check
      help: Only compile the sources, without checking their types
    - opt: json
      default: nil
      help: File to also write the check's report to, as JSON
    - opt: output
      short: o
      default: nil
      help: File to write the bundle to; by default, `build/<name>.dolz` in the project, named after the project
    - opt: shebang
      default: nil
      help: "Interpreter command for a `#!` line, such as `/usr/bin/env dolang`; the bundle is then made executable where the platform allows"
    do |p|
      let :strict :no_check :output :shebang :json ... = p.bundle
      if (shebang != nil && shebang.contains("\n"))
        throw args.Error "--shebang must be a single line"
      let out = if (output != nil)
        Path $output
      else
        nil
      with_project $p.project $json do |it| it.bundle(output: out, check: !no_check, :strict, :shebang)
