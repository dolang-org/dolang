import args progress shell test
  fs:
    - Path
  glob:
    - Glob

def parse_jobs value
  let jobs = try
    int $value
  catch std.RuntimeError: _
    throw args.Error "--jobs expects an integer"
  if (jobs < 1)
    throw args.Error "--jobs must be at least 1"
  jobs

def parse_timeout value
  let secs = try
    float $value
  catch std.RuntimeError: _
    throw args.Error "--timeout expects a number"
  if !(secs >= 0)
    throw args.Error "--timeout must be non-negative"
  secs

def parse_filter value
  try
    Glob $value
  catch std.RuntimeError: _
    throw args.Error "invalid --filter glob: $value"
  value

def parse_tags value
  let group = []
  for alternative = value.split ","
    if (alternative == "" || alternative == "!")
      throw args.Error "invalid --tags expression: $value"
    if alternative.starts_with "!"
      group.push [true, alternative[1..]]
    else
      group.push [false, alternative]
  group

def tag_filter groups info
  for group = groups
    let matched = group.any do |alternative|
      let negated tag = alternative
      let present = info.tags.contains $tag
      (negated && !present || !negated && present)
    if !matched
      return false
  true

args.with args: $shell.args
  help: Run Do unit test modules.
  - opt: jobs
    short: j
    parse: $parse_jobs
    default: 8
    meta: N
    help: Max concurrent tests (among all modules)
  - opt: module-jobs
    parse: $parse_jobs
    default: 4
    meta: N
    help: Max concurrent modules
  - opt: filter
    parse: $parse_filter
    default: **
    help: Glob filter for test names in `stem/test` form
  - opt: tags
    parse: $parse_tags
    collect: true
    meta: TAGS
    help: Comma-separated tag alternatives; repeat for AND groups
  - opt: timeout
    parse: $parse_timeout
    default: 600
    meta: SECS
    help: Max seconds for each test and module load.
  - opt: id
    collect: true
    meta: ID
    help: Exact test ID to select; repeat for more
  - flag: no-capture
    help: Print module and test output as it is produced.
  - flag: list
    help: List tests without running them.
  - opt: format
    values: ["json", "jsonl"]
    default: nil
    meta: FMT
    help: "Machine-readable output on stdout: json for --list, jsonl for runs"
  - opt: output
    short: o
    parse: $Path
    default: nil
    meta: FILE
    help: Write --format output to FILE instead
  - arg: paths
    parse: $Path
    collect: true
    help: Test directories or files to run.
  do |p|
    let :filter :tags :id :jobs :module_jobs :timeout :no_capture :list :format :output :paths ... = p
    if (format == "json" && !list)
      throw args.Error "--format json requires --list"
    if (format == "jsonl" && list)
      throw args.Error "--format jsonl does not apply to --list"
    if (format == "jsonl" && no_capture)
      throw args.Error "--format jsonl does not allow --no-capture"
    if (output != nil && format == nil)
      throw args.Error "--output requires --format"
    let name_filter = Glob $filter
    let ids = {}
    for i = id
      ids[i] = true
    let filter = do |info|
      (name_filter.matches info.id && tag_filter tags info &&
        (ids.len == 0 || ids.contains info.id))
    if (format == "json")
      exit $ test.list :module_jobs :filter :timeout format: :JSON: :output ...paths
    if (format == "jsonl")
      exit $ test.run :jobs :module_jobs :filter :timeout format: :JSONL: :output ...paths
    let rc = progress.with do
      if list
        test.list :module_jobs :filter :timeout ...paths
      else
        test.run
          jobs: $jobs
          module_jobs: $module_jobs
          filter: $filter
          timeout: $timeout
          capture: $!no_capture
          ...paths
    exit $rc
