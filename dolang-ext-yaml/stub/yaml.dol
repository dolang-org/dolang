# YAML serialization and deserialization.

# A value decoded from YAML. A mapping key may be any YAML value.
pub @let Data = (nil | Bool | Int | Float | Str | Array[Data] | Dict[{...Data: Data}])

# A value that encodes as YAML.
pub @let Encodable = (
  | nil | Bool | Int | Float | Str | Sym
  | Array[Encodable] | Tuple[...Encodable] | Record[...{...Encodable, ...Sym: Encodable}]
  | Dict[{...Encodable: Encodable}]
)

# Parses a YAML string into a Do value.
#
# | YAML Value | Do Type |
# | ---------- | ------- |
# | `null`     | `nil`   |
# | boolean    | `Bool`  |
# | integer    | `Int`   |
# | float      | `Float` |
# | string     | `Str`   |
# | sequence   | `Array` |
# | mapping    | `Dict`  |
#
# ## Errors
#
# `ValueError` if the input is invalid, contains more than one document, or
# uses unsupported YAML features such as tags or aliases.
#
# ## Example
#
# ```playground
# #> import yaml:
# #>   - decode
# #> import test:
# #>   - assert_eq
# let doc = decode |
#   name: Alice
#   enabled: true
#   ports:
#     - 80
#     - 443
# assert_eq $doc["name"] "Alice"
# assert_eq $doc["enabled"] true
# assert_eq $doc["ports"] [80, 443]
# ```
pub def decode
  # YAML document to parse.
  yaml @ Str
do -> Data
  ...

# Serializes a Do value to a YAML string.
#
# | Do Type  | YAML Value |
# | -------- | ---------- |
# | `nil`    | `null`     |
# | `Bool`   | boolean    |
# | `Int`    | integer    |
# | `Float`  | float      |
# | `Str`    | string     |
# | `Sym`    | string     |
# | `Array`  | sequence   |
# | `Tuple`  | sequence   |
# | `Dict`   | mapping    |
# | `Record` | mapping    |
#
# ## Errors
#
# `TypeError` if a value is not YAML-representable, such as binary data or a
# custom object.
#
# ## Example
#
# ```
# assert_eq (encode nil) "~"
# assert_eq (encode [1, 2, 3]) "- 1\n- 2\n- 3"
# ```
pub def encode
  # The value to serialize.
  value @ Encodable
do -> Str
  ...
