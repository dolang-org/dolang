  throw nil

# Joins the machine to a domain.
#
# **Takes effect only after a restart** -- see [Domain
# join](winnet.domain-join).
#
# Supply either `account` and `password` or `machine_password`; the two are
# mutually exclusive, because joining with a pre-created computer account
# password leaves no room for a user account.
#
# ## Errors
#
# | Exception                                                        | Condition                                                  |
# | ---------------------------------------------------------------- | ---------------------------------------------------------- |
# | [`sys.AlreadyExistsError`](sys.AlreadyExistsError)       | Already joined and `join_if_joined` was not set            |
# | [`sys.InvalidInputError`](sys.InvalidInputError)         | Credentials are incomplete, or both credential forms given |
# | [`sys.PermissionDeniedError`](sys.PermissionDeniedError) | Caller may not join the machine to the domain              |
#
# ## Example
#
# ```
# winnet.join_domain corp.example.com
#   ou: "OU=Servers,DC=corp,DC=example,DC=com"
#   account: r"CORP\joiner"
#   password: $password
#   create_account: true
# echo "restart to complete the join"
# ```
pub def join_domain
  # ([`Str`](std.Str)) Domain to join.
  domain
  # ([`Str`](std.Str)) Organizational unit for the computer account.
  :ou = nil
  # ([`Str`](std.Str)) Domain account authorized to join, such as
  # `"CORP\\joiner"`. Must be given together with `password`; omit both to use
  # the caller's own credentials.
  :account = nil
  # ([`Str`](std.Str)) Password for `account`.
  :password = nil
  # ([`Str`](std.Str)) Password of a pre-created computer account, used
  # instead of `account` and `password`.
  :machine_password = nil
  # ([`Bool`](std.Bool)) Create the computer account as part of the
  # join.
  :create_account = nil
  # ([`Bool`](std.Bool)) Proceed even if already joined to a domain.
  :join_if_joined = nil
  # ([`Bool`](std.Bool)) Perform an unsecured join.
  :unsecure = nil
  # ([`Bool`](std.Bool)) Defer setting the service principal name until
  # a later rename.
  :defer_spn = nil
  # ([`Bool`](std.Bool)) Force the service principal name to be set.
  :force_spn = nil
  # ([`Bool`](std.Bool)) Join using a domain controller account.
  :dc_account = nil
  # ([`Bool`](std.Bool)) Join under a rename that has not taken effect
  # yet.
  :with_new_name = nil
  # ([`Bool`](std.Bool)) Join against a read-only domain controller.
  :readonly = nil
  # ([`Bool`](std.Bool)) Allow an ambiguous domain controller name.
  :ambiguous_dc = nil
  # ([`Bool`](std.Bool)) Do not write the netlogon cache.
  :no_netlogon_cache = nil
  # ([`Bool`](std.Bool)) Fail rather than reuse an existing computer
  # account.
  :no_account_reuse = nil
do
  throw nil

# Removes the machine from its domain.
