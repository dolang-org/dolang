# Obtains a handle to an existing local SMB share.
#
# ## Returns
#
# [`Share`](winnet.Share).
pub def share
  # Share name or a
  # prior snapshot.
  name_or_info @ (Str | ShareInfo)
do -> Share
  ...

# Lists every local SMB share, administrative and non-disk shares included.
#
# ## Returns
#
# An [`Iter`](std.Iter) yielding [`ShareInfo`](winnet.ShareInfo)s.
pub def shares() -> Iter[ShareInfo]
  ...

# Creates a local SMB share.
#
# ## Returns
#
# [`Share`](winnet.Share).
pub def create_share
  # Share name.
  name @ Str
  # Local path to share.
  :path @ Path
  # Resource kind: `:DISKTREE:` (the default),
  # `:PRINTQ:`, `:DEVICE:`, or `:IPC:`.
  :kind @ Sym = nil
  # Comment.
  :comment @ Str = nil
  # Connection limit. Defaults to unlimited.
  :max_uses @ Int = nil
  # Mark the share special.
  :special @ Bool = nil
  # Mark the share temporary.
  :temporary @ Bool = nil
  # Security descriptor, self-relative packet, or declarative descriptor.
  # Defaults to the one Windows supplies.
  :sec_desc @ (SecDesc | Bin | Dict) = nil
do -> Share
  ...

# Connects to a remote SMB resource, optionally redirecting a local device.
#
# With a trailing `func` the connection is scoped: it is disconnected when
# `func` returns, including when `func` throws, so a failure partway through
# does not leave a mapping behind. Without one the connection is returned and
# the caller decides when -- or whether -- to disconnect it.
#
# Connections belong to a logon session. One made under a given account is not
# visible to a process running as another.
#
# ## Returns
#
# [`Connection`](winnet.Connection) when no `func` is given, otherwise the result
# of calling `func`.
#
# ## Errors
#
# | Exception                                                        | Condition                              |
# | ---------------------------------------------------------------- | -------------------------------------- |
# | [`ValueError`](std.ValueError)                            | `persistent` requested without `local` |
# | [`sys.AlreadyExistsError`](sys.AlreadyExistsError)       | The local device is already redirected |
# | [`sys.PermissionDeniedError`](sys.PermissionDeniedError) | Credentials were rejected              |
# | [`sys.NotFoundError`](sys.NotFoundError)                 | The remote resource does not exist     |
#
# ## Example
#
# ```
# # Scoped: disconnected however the block exits
# connect \\build\artifacts local: Z: do |conn|
#   fs.copy $release $conn.path()
#
# # Unbound: the caller owns teardown
# let conn = connect r"\\build\artifacts"
# try
#   publish $conn.remote
# finally
#   conn.disconnect()
#
# # Persistent, surviving a reboot
# connect \\build\artifacts
#   local: Z:
#   user: r"CORP\ci"
#   password: $secret
#   persistent: true
# ```
pub def connect
  # Remote resource in UNC form, such as
  # `r"\\server\share"`.
  remote @ Str
  # Local device to redirect, such as `"Z:"`.
  :local @ Str = nil
  # Account to authenticate as.
  :user @ Str = nil
  # Password for `user`.
  :password @ Str = nil
  # Resource kind: `:DISK:`, `:PRINT:`, or `:ANY:`.
  :kind @ Sym = nil
  # Record the connection so it is restored at
  # logon.
  #
  # A persistent connection must redirect a local device: Windows only
  # remembers connections that redirect one. Asking for `persistent` without
  # `local` raises [`ValueError`](std.ValueError) rather than silently
  # producing a mapping that disappears at the next logon.
  :persistent @ Bool = nil
  # Override whether credentials are saved for the
  # server.
  #
  # Supplied credentials are saved for the target server by default when the
  # connection is persistent, because a restored connection has nothing to
  # authenticate with otherwise. `false` suppresses that; `true` saves them for
  # a non-persistent connection. Saving requires `user`.
  #
  # Saved credentials are per-account, the same way the connection itself is,
  # so a connection provisioned for a service account must be made under that
  # account to be restored for it.
  :save_credentials @ Bool = nil
  # Called with the [`Connection`](winnet.Connection), which is
  # disconnected when it returns. Omit to receive the handle instead.
  func @ Func = nil
do -> Value
  ...

# Obtains a handle to an existing connection.
#
# ## Returns
#
# [`Connection`](winnet.Connection).
pub def connection
  # Local
  # device, remote name, or a prior snapshot.
  name_or_info @ (Str | ConnectionInfo)
do -> Connection
  ...

# Lists every connection, including ones saved in the profile that are not
# currently connected.
#
# ## Returns
#
# An [`Iter`](std.Iter) yielding
# [`ConnectionInfo`](winnet.ConnectionInfo)s.
#
# ## Example
#
# ```
# for entry = connections()
#   echo $entry.local $entry.remote $entry.state
# ```
pub def connections() -> Iter[ConnectionInfo]
  ...

# Resolves a path on a redirected device to its UNC form.
#
# ## Example
#
# ```
# assert_eq (universal_name (Path r"Z:\release")) r"\\build\artifacts\release"
# ```
pub def universal_name
  # Path on a redirected device.
  path @ Path
do -> Str
  ...

# Reads the machine's current workgroup or domain membership.
#
# ## Returns
#
# [`JoinStatus`](winnet.JoinStatus).
pub def join_status() -> JoinStatus
  ...

# Reads the computer name, domain membership, OS level and server role.
#
# ## Returns
#
# [`MachineInfo`](winnet.MachineInfo).
pub def machine_info() -> MachineInfo
  ...

# Joins the machine to a domain.
#
# **Takes effect only after a restart** -- see [Domain
# join](winnet.domain-join).
#
# Supply either `account` and `password` or `machine_password`; the two are
# mutually exclusive, because joining with a pre-created computer account
# password leaves no room for a user account.
#
# ## Errors
#
# | Exception                                                        | Condition                                                  |
# | ---------------------------------------------------------------- | ---------------------------------------------------------- |
# | [`sys.AlreadyExistsError`](sys.AlreadyExistsError)       | Already joined and `join_if_joined` was not set            |
# | [`sys.InvalidInputError`](sys.InvalidInputError)         | Credentials are incomplete, or both credential forms given |
# | [`sys.PermissionDeniedError`](sys.PermissionDeniedError) | Caller may not join the machine to the domain              |
#
# ## Example
#
# ```
# winnet.join_domain corp.example.com
#   ou: "OU=Servers,DC=corp,DC=example,DC=com"
#   account: r"CORP\joiner"
#   password: $password
#   create_account: true
# echo "restart to complete the join"
# ```
pub def join_domain
  # Domain to join.
  domain @ Str
  # Organizational unit for the computer account.
  :ou @ Str = nil
  # Domain account authorized to join, such as
  # `"CORP\\joiner"`. Must be given together with `password`; omit both to use
  # the caller's own credentials.
  :account @ Str = nil
  # Password for `account`.
  :password @ Str = nil
  # Password of a pre-created computer account, used
  # instead of `account` and `password`.
  :machine_password @ Str = nil
  # Create the computer account as part of the
  # join.
  :create_account @ Bool = nil
  # Proceed even if already joined to a domain.
  :join_if_joined @ Bool = nil
  # Perform an unsecured join.
  :unsecure @ Bool = nil
  # Defer setting the service principal name until
  # a later rename.
  :defer_spn @ Bool = nil
  # Force the service principal name to be set.
  :force_spn @ Bool = nil
  # Join using a domain controller account.
  :dc_account @ Bool = nil
  # Join under a rename that has not taken effect
  # yet.
  :with_new_name @ Bool = nil
  # Join against a read-only domain controller.
  :readonly @ Bool = nil
  # Allow an ambiguous domain controller name.
  :ambiguous_dc @ Bool = nil
  # Do not write the netlogon cache.
  :no_netlogon_cache @ Bool = nil
  # Fail rather than reuse an existing computer
  # account.
  :no_account_reuse @ Bool = nil
do
  ...

# Removes the machine from its domain.
#
# **Takes effect only after a restart** -- see [Domain
# join](winnet.domain-join).
#
# ## Errors
#
# | Exception                                                        | Condition                             |
# | ---------------------------------------------------------------- | ------------------------------------- |
# | [`sys.NotFoundError`](sys.NotFoundError)                 | The machine is not joined to a domain |
# | [`sys.InvalidInputError`](sys.InvalidInputError)         | The machine is a domain controller    |
# | [`sys.PermissionDeniedError`](sys.PermissionDeniedError) | Caller may not unjoin the machine     |
pub def unjoin_domain
  # Domain account authorized to unjoin. Must be
  # given together with `password`; omit both to use the caller's own
  # credentials.
  :account @ Str = nil
  # Password for `account`.
  :password @ Str = nil
  # Disable the computer account in the domain.
  :delete_account @ Bool = nil
do
  ...

# Renames the machine within its domain.
#
# **Takes effect only after a restart** -- see [Domain
# join](winnet.domain-join).
pub def rename_machine
  # New computer name.
  name @ Str
  # Domain account authorized to rename. Must be
  # given together with `password`; omit both to use the caller's own
  # credentials.
  :account @ Str = nil
  # Password for `account`.
  :password @ Str = nil
  # Create the renamed computer account if it is
  # missing.
  :create_account @ Bool = nil
do
  ...

# Creates a computer account in the domain and returns the blob that joins a
# machine to it.
#
# Run this where a domain controller is reachable, then apply the blob with
# [`apply_offline_join`](winnet.apply_offline_join).
#
# The blob contains the computer account password. Treat it as a secret:
# anyone holding it can join a machine as that account.
#
# ## Example
#
# ```
# let blob = winnet.provision_computer corp.example.com
#   machine: WS01
#   ou: "OU=Workstations,DC=corp,DC=example,DC=com"
# fs.Path("ws01.blob").write $blob
# ```
pub def provision_computer
  # Domain to create the computer account in.
  domain @ Str
  # Computer name to provision.
  :machine @ Str
  # Organizational unit for the computer account.
  :ou @ Str = nil
  # Domain controller to provision against.
  :dc @ Str = nil
  # Reuse an existing computer account.
  :reuse @ Bool = nil
  # Use the default computer account password.
  :default_password @ Bool = nil
  # Skip searching for an existing account.
  :skip_account_search @ Bool = nil
  # Include root CA certificates in the blob.
  :root_ca_certs @ Bool = nil
  # Support provisioning by a down-level privileged
  # user.
  :downlevel_priv_support @ Bool = nil
do -> Bin
  ...

# Applies a provisioning blob to a Windows installation, joining it to the
# domain without contacting a domain controller.
#
# **Takes effect only after the target installation is started or restarted**
# -- see [Domain join](winnet.domain-join).
#
# ## Example
#
# ```
# let blob = fs.Path("ws01.blob").read "b"
# winnet.apply_offline_join $blob
#   windows_path: (fs.windows.Path r"D:\Windows")
# ```
pub def apply_offline_join
  # Blob from
  # [`provision_computer`](winnet.provision_computer).
  blob @ Bin
  # Windows directory of the
  # installation to modify -- the mounted image's `Windows` directory for an
  # offline image, or the running system's own when `online` is set.
  :windows_path @ Path
  # The target installation is the running system.
  :online @ Bool = nil
do
  ...
