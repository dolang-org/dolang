# dolang: strict
import
  io:
    - @Io
  json:
    @DecodeValue: JsonDecodeValue
    @EncodeValue: JsonEncodeValue
  std:
    - RuntimeError
  time:
    - @DateTime
  url:
    - @Url

# HTTP client.
#
# The module-level request functions -- [`get`](#get), [`post`](#post) and the
# rest -- each make one request through a fresh stateless client. Anything that
# has to persist across requests (cookies, a proxy, TLS material) belongs on a
# [`Client`](http.Client), whose methods take the same arguments.
#
# Every URL argument accepts either a plain [`Str`](std.Str) or a
# [`url.Url`](url.Url).
#
# ```
# let data = http.get https://api.example.com/users
#   query: {page: 1}
#   headers: {authorization: "Bearer $token"}
# ```
#
# ## Browser
#
# Browser builds, such as the playground, send requests through `fetch`:
#
# - Cross-origin requests succeed only against servers that send CORS headers,
#   and only CORS-exposed response headers are visible.
# - The browser controls forbidden headers such as `Cookie`, `Host` and
#   `User-Agent`, and cookies follow its credentials rules.
# - Request bodies are buffered, not streamed.
# - The [`Client`](http.Client) options `unix_socket`, `proxy`, `cookies`,
#   `ca_cert`, `identity`, `password` and `invalid_certs` raise
#   [`RuntimeError`](std.RuntimeError).

# A transport or protocol failure.
#
# A response that arrives but carries a non-2xx status is reported as
# [`Status`](http.Status) instead, which extends this type -- so `catch Error`
# catches both.
#
# ## Example
#
# ```
# try
#   get "http://127.0.0.1:1"
# catch Error: err
#   echo $Str(err)
# ```
pub class Error: RuntimeError
  # The URL the failure is attributed to, or
  # `nil` when the underlying error carries none.
  #
  # ## Example
  #
  # ```
  # try
  #   get "http://example.invalid"
  # catch Error: err
  #   if (err.url != nil)
  #     echo $err.url.host
  # ```
  #[getter]
  pub def url self -> (Url | nil)
    ...

# A response whose status is outside `200..=299`.
#
# Raised by a request that completes normally but reports a failure status,
# unless `status: :IGNORE:` was passed. The response metadata and the first
# 64 KiB of the body are kept on the error, so a failed request can be
# diagnosed without a second round trip.
#
# ## Example
#
# ```
# try
#   get "https://example.com/missing"
# catch Status: err
#   echo $err.status
#   echo $err.text()
# ```
pub class Status: Error
  # The HTTP status code.
  #[getter]
  pub def status self -> Int
    ...

  # The response URL, or `nil` when none was
  # attached.
  #[getter]
  pub def url self -> (Url | nil)
    ...

  # The response headers, as
  # [`Response.headers`](http.Response.headers) presents them.
  #[getter]
  pub def headers self -> Map[Str, Str | DateTime]
    ...

  # Whether the saved body excerpt was cut off,
  # either by the 64 KiB limit or by a read error while buffering it.
  #[getter]
  pub def truncated self -> Bool
    ...

  # The saved body excerpt.
  pub def body self -> Bin
    ...

  # The saved body excerpt as text.
  #
  # ## Errors
  #
  # | Exception                             | Condition                    |
  # | ------------------------------------- | ---------------------------- |
  # | [`ValueError`](std.ValueError) | The excerpt is not valid UTF-8 |
  pub def text self -> Str
    ...

  # The saved body excerpt, parsed as JSON.
  #
  # Available when the extension is built with its `json` feature.
  pub def json self -> JsonDecodeValue
    ...

# One item of a Server-Sent Events stream.
#
# Yielded by [`Response.events`](http.Response.events).
pub class Event
  # The event type. Defaults to `"message"` when the
  # stream omits `event:` or sends an empty one.
  #[getter]
  pub def type self -> Str
    ...

  # The payload text. Multiple `data:` lines are
  # joined with `\n`.
  #[getter]
  pub def data self -> Str
    ...

  # The event identifier, when the stream sends one.
  #[getter]
  pub def id self -> (Str | nil)
    ...

  # The reconnection delay the stream suggests, when
  # it sends one.
  #[getter]
  pub def retry self -> (Int | nil)
    ...

# An HTTP response.
#
# A response may hold an open connection while its body is still pending, so it
# owns a resource until it is closed. Every method that reads the body whole --
# [`body`](#body), [`text`](#text), [`json`](#json) -- consumes the response and
# closes it; the streaming methods hand ownership of the body to the iterator
# they return. Once closed, most methods raise.
#
# The reliable way to bound that lifetime is the trailing block a request
# accepts, which closes the response however the block exits:
#
# ```
# get https://api.example.com/users do |response|
#   echo $response.status
# ```
pub class Response
  # The HTTP status code.
  #[getter]
  pub def status self -> Int
    ...

  # The final URL, after any redirects.
  #[getter]
  pub def url self -> Url
    ...

  # The response headers.
  #
  # A value that parses as an HTTP-date is returned as a
  # [`time.DateTime`](time.DateTime); every other value is a
  # [`Str`](std.Str).
  #
  # ## Example
  #
  # ```
  # let response = get https://api.example.com/users
  # echo $response.headers["content-type"]
  # ```
  #[getter]
  pub def headers self -> Map[Str, Str | DateTime]
    ...

  # Reads the whole body as bytes.
  #
  # Reading the body consumes it: `body`, `text`, `json`, `io`, `chunks` and
  # `lines` each take it, and a second raises [`StateError`](std.StateError).
  # The status and headers stay readable until the response is closed.
  pub def body self -> Bin
    ...

  # Reads the whole body as text.
  #
  # ## Errors
  #
  # | Exception                         | Condition                             |
  # | --------------------------------- | ------------------------------------- |
  # | [`StateError`](std.StateError)    | The body was read or the response closed |
  # | [`Error`](http.Error)             | A transport or protocol failure       |
  # | [`ValueError`](std.ValueError) | The body is not valid UTF-8       |
  pub def text self -> Str
    ...

  # Reads the whole body and parses it as JSON.
  #
  # Available when the extension is built with its `json` feature.
  #
  # ## Errors
  #
  # | Exception                             | Condition                       |
  # | ------------------------------------- | ------------------------------- |
  # | [`StateError`](std.StateError)        | The body was read or the response closed |
  # | [`Error`](http.Error)                 | A transport or protocol failure |
  # | [`ValueError`](std.ValueError) | The body is not valid JSON      |
  #
  # ## Example
  #
  # ```
  # let response = get https://api.example.com/users
  # let data = response.json()
  # echo $data["users"][0]["name"]
  # ```
  pub def json self -> JsonDecodeValue
    ...

  # Returns the body as a byte stream.
  #
  # The stream can be passed to any function that accepts an [`io.Io`](io.Io),
  # such as [`compress.decompress`](compress.decompress). Closing the response
  # closes it.
  #
  # A failure reading the body raises from the stream's methods as an I/O
  # error, not an [`Error`](http.Error).
  #
  # ## Example
  #
  # ```
  # get https://example.com/data.gz do |response|
  #   compress.decompress $response.io() do |stream|
  #     echo (stream.read_all_str())
  # ```
  pub def io self -> Io
    ...

  # Streams the body as byte chunks of at most 64 KiB each, as
  # [`io().chunks()`](io.Io.chunks) does, so a large response need not be held
  # in memory whole.
  #
  # ## Example
  #
  # ```
  # get https://api.example.com/large-file do |response|
  #   let total = 0
  #   for chunk = response.chunks()
  #     total = (total + chunk.len)
  #   echo "Downloaded $total bytes"
  # ```
  pub def chunks self -> Iter[Bin]
    ...

  # Streams the body as lines, split on `\n` or `\r\n` with the line ending
  # stripped.
  #
  # The lines are read through an [`io.Buffered`](io.Buffered) over
  # [`io()`](http.Response.io).
  #
  # ## Example
  #
  # ```
  # get https://api.example.com/logs do |response|
  #   for line = response.lines()
  #     if (line.contains "ERROR")
  #       echo $line
  # ```
  pub def lines self -> Iter[Str]
    ...

  # Streams the body as a Server-Sent Events stream -- the shape LLM responses,
  # log tails and other `text/event-stream` feeds arrive in.
  #
  # ## Errors
  #
  # | Exception                             | Condition                            |
  # | ------------------------------------- | ------------------------------------ |
  # | [`StateError`](std.StateError)        | The body was read or the response closed |
  # | [`Error`](http.Error)                 | The underlying body read fails       |
  # | [`ValueError`](std.ValueError) | The stream contains invalid UTF-8    |
  #
  # ## Example
  #
  # ```
  # http.get https://api.example.com/stream do |response|
  #   for :type :data ... = response.events()
  #     echo "[$type] $data"
  # ```
  pub def events self -> Iter[Event]
    ...

  # Raises [`Status`](http.Status) when the status is outside `200..=299`, and
  # does nothing otherwise.
  #
  # This is what a request does for you unless `status: :IGNORE:` was passed,
  # so it is only needed on a response fetched with the check suppressed.
  pub def throw_for_status self
    ...

  # Closes the response, releasing the connection, and closes any stream
  # [`io`](http.Response.io), `chunks` or `lines` returned.
  #
  # Closing an already-closed response does nothing.
  pub def close self
    ...

# Options of a request, which every request function and [`Client`](http.Client)
# method takes.
pub @let RequestOptions = $
  # Request headers -- see [`headers`](http.Client.headers)
  ?headers: BaseDict[Value, Value]
  # Query parameters -- see [`query`](http.Client.query)
  ?query: BaseDict[Value, Value]
  # `:IGNORE:` to return a response whose status is outside `200..=299` instead
  # of raising [`Status`](http.Status)
  ?status: (:IGNORE: | "IGNORE")

# Options of a request with a body: those of
# [`RequestOptions`](http.RequestOptions), and at most one of these.
pub @let BodyOptions = $
  # Any of [`RequestOptions`](http.RequestOptions)
  ...RequestOptions
  # Request body -- see [`body`](http.Client.body)
  ?body: (Str | Bin | Io | Iterable[Value])
  # Request body, JSON-serialized -- see [`json`](http.Client.json)
  ?json: JsonEncodeValue
  # Request body streamed with a newline after each element -- see
  # [`lines`](http.Client.lines)
  ?lines: Iterable[Value]
  # Multipart form parts -- see [`multipart`](http.Client.multipart)
  ?multipart: Iterable[Dict[{name: Str, ...}]]

# An HTTP client.
#
# A client holds the configuration and any session state its requests share.
#
# A client's methods are named for HTTP verbs -- `get`, `head`, `post`, `put`,
# `patch`, `delete`, `options`, `trace`, `connect` -- and take the arguments
# documented on [`get`](#get) and [`post`](#post).
#
# ## Request options {: #http.Client.request-options }
#
# ### `body` {: #http.Client.body }
#
# Sends the request body as given. Mutually exclusive with `json`, `lines` and
# `multipart`.
#
# A [`Str`](std.Str) or [`Bin`](std.Bin) is sent as-is. An
# [`io.Io`](io.Io), such as an open file, streams its bytes and stays open. A
# stream that is also iterable, such as an [`io.Buffered`](io.Buffered), sends
# its bytes, not its lines. Any other iterable is streamed, its values written
# back to back with nothing between them, as [`io.Concat`](io.Concat) reads
# them.
#
# An exception from the stream or iterable fails the request, as it fails any
# function that accepts an [`io.Io`](io.Io). A stream that does not read raises
# [`ValueError`](std.ValueError).
#
# ```
# client.post https://api.example.com/data
#   body: "raw text data"
#   headers: {"content-type": "text/plain"}
#
# client.post https://api.example.com/stream
#   body: ["chunk1", "chunk2", "chunk3"]
#   headers: {"content-type": "application/octet-stream"}
#
# open report.bin do |file|
#   client.put https://api.example.com/upload body: $file
# ```
#
# ### `json` {: #http.Client.json }
#
# Serializes a Do value as the JSON request body. Mutually exclusive with
# `body`, `lines` and `multipart`.
#
# ```
# client.post https://api.example.com/users
#   json: {name: "Alice", email: "alice@example.com"}
# ```
#
# ### `lines` {: #http.Client.lines }
#
# Streams the body from an iterable, writing a newline after each element.
# Mutually exclusive with `body`, `json` and `multipart`. Unlike `body`, this
# requires an iterable.
#
# ```
# client.post https://api.example.com/data
#   lines:
#     - first line
#     - second line
# # Sends: "first line\nsecond line\n"
# ```
#
# ### `multipart` {: #http.Client.multipart }
#
# Builds a `multipart/form-data` body from an iterable of part specs. Mutually
# exclusive with `body`, `json` and `lines`.
#
# Each part needs `name` and either `body` or -- when the extension is built
# with its `json` feature -- `json`. `filename` and `content_type` are
# optional; a `json` part's `content_type` defaults to `application/json`.
#
# A part `body` accepts what [`body`](#http.Client.body) does.
#
# The `content-type` header, boundary included, is set automatically. Do not
# set it yourself on a multipart request.
#
# ```
# open report.bin do |file|
#   client.post https://api.example.com/upload
#     multipart:
#       - name: file
#         filename: report.bin
#         content_type: application/octet-stream
#         body: $file
#       - name: metadata
#         json:
#           kind: report
# ```
#
# ### `headers` {: #http.Client.headers }
#
# Request headers, as a dict. Repeating a key sends the header more than once.
#
# Values are stringified, except a [`time.DateTime`](time.DateTime),
# which is formatted as an HTTP-date (`IMF-fixdate`) -- what a header such as
# `if-modified-since` expects.
#
# ```
# client.get https://api.example.com/users
#   headers:
#     authorization: Bearer token123
#     "user-agent": MyApp/1.0
#     accept: application/json
#     accept: application/json+verbose
# ```
#
# ### `query` {: #http.Client.query }
#
# URL query parameters, as a dict. Repeating a key sends the parameter more
# than once.
#
# ```
# client.get https://api.example.com/users
#   query:
#     page: 1
#     sort: name
#     sort: age
# ```
pub class Client: Func
  # Builds a client.
  #
  # Browser builds accept only `func`; any other option raises
  # [`RuntimeError`](std.RuntimeError).
  #
  # ## Example
  #
  # ```
  # let client = Client()
  #
  # Client cookies: true do |session|
  #   session.post https://example.com/login
  #   session.get https://example.com/dashboard do |resp|
  #     echo $resp.status
  # ```
  #[class]
  @def (call)
    self
    # Path to a Unix domain socket to connect
    # through. Unix only.
    #
    # This is **not** container-transparent: it connects to a socket on the
    # host running the Do process, not through the shell agent's container
    # filesystem and network translation.
    :unix_socket @ Str = nil
    # Proxy for every
    # request made by this client.
    #
    # By default the client honors the system proxy environment
    # (`HTTP_PROXY`, `HTTPS_PROXY`, `NO_PROXY`). Passing `nil` explicitly
    # disables proxy detection entirely rather than selecting the default.
    :proxy @ (Str | (Url | nil)) = nil
    # Give the client a cookie jar, so cookies it
    # receives are replayed on later requests.
    #
    # Cookie state belongs to the one client and is shared with nothing else,
    # the module-level request functions included.
    :cookies @ Bool = nil
    # PEM-encoded CA
    # certificate to add to the trust store.
    :ca_cert @ (Str | Bin) = nil
    # PKCS#12/PFX client
    # certificate, for mutual TLS.
    :identity @ (Str | Bin) = nil
    # Password for `identity`. Defaults to empty.
    # Passing it without `identity` raises
    # [`ValueError`](std.ValueError).
    :password @ Str = nil
    # Pass `:DANGER_ACCEPT:` to disable TLS certificate validation. This is
    # dangerous -- it defeats the point of TLS, so reserve it for testing.
    :invalid_certs @ :DANGER_ACCEPT: = nil
  do -> Client

  # Builds a client and calls `func` with it. The client is closed when `func`
  # returns.
  #
  # Browser builds accept only `func`; any other option raises
  # [`RuntimeError`](std.RuntimeError).
  #[class]
  @def (call)[R]
    self
    # Path to a Unix domain socket to connect
    # through. Unix only.
    :unix_socket @ Str = nil
    # Proxy for every
    # request made by this client.
    :proxy @ (Str | (Url | nil)) = nil
    # Give the client a cookie jar, so cookies it
    # receives are replayed on later requests.
    :cookies @ Bool = nil
    # PEM-encoded CA
    # certificate to add to the trust store.
    :ca_cert @ (Str | Bin) = nil
    # PKCS#12/PFX client
    # certificate, for mutual TLS.
    :identity @ (Str | Bin) = nil
    # Password for `identity`. Defaults to empty.
    # Passing it without `identity` raises
    # [`ValueError`](std.ValueError).
    :password @ Str = nil
    # Pass `:DANGER_ACCEPT:` to disable TLS certificate validation. This is
    # dangerous -- it defeats the point of TLS, so reserve it for testing.
    :invalid_certs @ :DANGER_ACCEPT: = nil
    # Called with the `Client`. Omit to receive the client instead.
    func @ (Client -> R)
  do -> R

  #[class]
  pub def (call) self ...options @ Value -> Value
    ...

  pub def (init)
    self
    :unix_socket @ Str = nil
    :proxy @ (Str | (Url | nil)) = nil
    :cookies @ Bool = nil
    :ca_cert @ (Str | Bin) = nil
    :identity @ (Str | Bin) = nil
    :password @ Str = nil
    :invalid_certs @ :DANGER_ACCEPT: = nil
  do
    ...

  # Makes a request without a body.
  #
  # ## Errors
  #
  # | Exception               | Condition                                            |
  # | ----------------------- | ---------------------------------------------------- |
  # | [`Status`](http.Status) | The response is non-2xx and `status:` was not passed |
  # | [`Error`](http.Error)   | A transport or protocol failure                      |
  #
  # ## Example
  #
  # ```
  # let response = client.get https://api.example.com/users
  #   query: {page: 1, limit: 10}
  #   headers: {authorization: "Bearer token123"}
  # echo $response.status
  # ```
  @def get
    self
    # URL to request.
    url @ (Str | Url)
    # Request options.
    ...options @ RequestOptions
  do -> Response

  # Makes a request without a body and calls `block` with the response. The
  # response is closed when `block` returns.
  @def get[R]
    self
    # URL to request.
    url @ (Str | Url)
    # Request options.
    ...options @ RequestOptions
    # Called with the [`Response`](http.Response).
    block @ (Response -> R)
  do -> R

  pub def get self url @ (Str | Url) ...options @ Value -> Value
    ...

  # Makes a request with a body.
  #
  # ## Errors
  #
  # | Exception               | Condition                                            |
  # | ----------------------- | ---------------------------------------------------- |
  # | [`Status`](http.Status) | The response is non-2xx and `status:` was not passed |
  # | [`Error`](http.Error)   | A transport or protocol failure                      |
  #
  # ## Example
  #
  # ```
  # client.post https://api.example.com/users
  #   json:
  #     name: Alice
  #     age: 30
  # ```
  @def post
    self
    # URL to request.
    url @ (Str | Url)
    # Request options.
    ...options @ BodyOptions
  do -> Response

  # Makes a request with a body and calls `block` with the response. The
  # response is closed when `block` returns.
  @def post[R]
    self
    # URL to request.
    url @ (Str | Url)
    # Request options.
    ...options @ BodyOptions
    # Called with the [`Response`](http.Response).
    block @ (Response -> R)
  do -> R

  pub def post self url @ (Str | Url) ...options @ Value -> Value
    ...

  # Makes a `HEAD` request, as [`get`](http.Client.get) does.
  @def head
    self
    # URL to request.
    url @ (Str | Url)
    # Request options.
    ...options @ RequestOptions
  do -> Response

  # Makes a `HEAD` request and calls `block` with the response, as
  # [`get`](http.Client.get) does.
  @def head[R]
    self
    # URL to request.
    url @ (Str | Url)
    # Request options.
    ...options @ RequestOptions
    # Called with the [`Response`](http.Response).
    block @ (Response -> R)
  do -> R

  pub def head self url @ (Str | Url) ...options @ Value -> Value
    ...

  # Makes a `DELETE` request, as [`get`](http.Client.get) does.
  @def delete
    self
    # URL to request.
    url @ (Str | Url)
    # Request options.
    ...options @ RequestOptions
  do -> Response

  # Makes a `DELETE` request and calls `block` with the response, as
  # [`get`](http.Client.get) does.
  @def delete[R]
    self
    # URL to request.
    url @ (Str | Url)
    # Request options.
    ...options @ RequestOptions
    # Called with the [`Response`](http.Response).
    block @ (Response -> R)
  do -> R

  pub def delete self url @ (Str | Url) ...options @ Value -> Value
    ...

  # Makes an `OPTIONS` request, as [`get`](http.Client.get) does.
  @def options
    self
    # URL to request.
    url @ (Str | Url)
    # Request options.
    ...options @ RequestOptions
  do -> Response

  # Makes an `OPTIONS` request and calls `block` with the response, as
  # [`get`](http.Client.get) does.
  @def options[R]
    self
    # URL to request.
    url @ (Str | Url)
    # Request options.
    ...options @ RequestOptions
    # Called with the [`Response`](http.Response).
    block @ (Response -> R)
  do -> R

  pub def options self url @ (Str | Url) ...options @ Value -> Value
    ...

  # Makes a `TRACE` request, as [`get`](http.Client.get) does.
  @def trace
    self
    # URL to request.
    url @ (Str | Url)
    # Request options.
    ...options @ RequestOptions
  do -> Response

  # Makes a `TRACE` request and calls `block` with the response, as
  # [`get`](http.Client.get) does.
  @def trace[R]
    self
    # URL to request.
    url @ (Str | Url)
    # Request options.
    ...options @ RequestOptions
    # Called with the [`Response`](http.Response).
    block @ (Response -> R)
  do -> R

  pub def trace self url @ (Str | Url) ...options @ Value -> Value
    ...

  # Makes a `CONNECT` request, as [`get`](http.Client.get) does.
  @def connect
    self
    # URL to request.
    url @ (Str | Url)
    # Request options.
    ...options @ RequestOptions
  do -> Response

  # Makes a `CONNECT` request and calls `block` with the response, as
  # [`get`](http.Client.get) does.
  @def connect[R]
    self
    # URL to request.
    url @ (Str | Url)
    # Request options.
    ...options @ RequestOptions
    # Called with the [`Response`](http.Response).
    block @ (Response -> R)
  do -> R

  pub def connect self url @ (Str | Url) ...options @ Value -> Value
    ...

  # Makes a `PUT` request, as [`post`](http.Client.post) does.
  @def put
    self
    # URL to request.
    url @ (Str | Url)
    # Request options.
    ...options @ BodyOptions
  do -> Response

  # Makes a `PUT` request and calls `block` with the response, as
  # [`post`](http.Client.post) does.
  @def put[R]
    self
    # URL to request.
    url @ (Str | Url)
    # Request options.
    ...options @ BodyOptions
    # Called with the [`Response`](http.Response).
    block @ (Response -> R)
  do -> R

  pub def put self url @ (Str | Url) ...options @ Value -> Value
    ...

  # Makes a `PATCH` request, as [`post`](http.Client.post) does.
  @def patch
    self
    # URL to request.
    url @ (Str | Url)
    # Request options.
    ...options @ BodyOptions
  do -> Response

  # Makes a `PATCH` request and calls `block` with the response, as
  # [`post`](http.Client.post) does.
  @def patch[R]
    self
    # URL to request.
    url @ (Str | Url)
    # Request options.
    ...options @ BodyOptions
    # Called with the [`Response`](http.Response).
    block @ (Response -> R)
  do -> R

  pub def patch self url @ (Str | Url) ...options @ Value -> Value
    ...

  # Closes the client, releasing its connection pool.
  #
  # Closing an already-closed client does nothing.
  pub def close self
    ...

