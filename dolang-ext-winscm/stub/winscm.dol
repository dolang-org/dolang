# Manages Windows services.
#
# This API is VFS-aware: it operates through the VFS in scope for the current
# strand, so it works transparently under remote or elevated contexts. It is
# supported only on Windows targets; elsewhere every operation throws
# [`sys.UnsupportedError`](sys.UnsupportedError).

import
  fs:
    - @Path
  security.windows:
    - AccessMask
    - @AccessRight
    - @SecDesc
    - @SecDescSpec
  std:
    - @FlagSet

# A control request for [`Service.control`](winscm.Service.control).
#
# | Symbol          | Requests that the service         |
# | --------------- | --------------------------------- |
# | `:STOP:`        | Stop                              |
# | `:PAUSE:`       | Pause                             |
# | `:CONTINUE:`    | Resume from the paused state      |
# | `:INTERROGATE:` | Report its current status         |
pub @let ControlRequest = (:STOP: | :PAUSE: | :CONTINUE: | :INTERROGATE:)

# The state of a service.
#
# | Symbol               | Meaning                        |
# | -------------------- | ------------------------------ |
# | `:STOPPED:`          | Not running                    |
# | `:START_PENDING:`    | Starting                       |
# | `:STOP_PENDING:`     | Stopping                       |
# | `:RUNNING:`          | Running                        |
# | `:CONTINUE_PENDING:` | Resuming from the paused state |
# | `:PAUSE_PENDING:`    | Pausing                        |
# | `:PAUSED:`           | Paused                         |
pub @let ServiceState = (
  | :STOPPED: | :START_PENDING: | :STOP_PENDING: | :RUNNING: | :CONTINUE_PENDING:
  | :PAUSE_PENDING: | :PAUSED:
)

# When a service starts.
#
# | Symbol           | Meaning                                       |
# | ---------------- | --------------------------------------------- |
# | `:BOOT_START:`   | Starts during boot before the driver is ready |
# | `:SYSTEM_START:` | Starts during kernel initialization           |
# | `:AUTO_START:`   | Starts automatically during system startup    |
# | `:DEMAND_START:` | Starts when requested                         |
# | `:DISABLED:`     | Cannot be started                             |
pub @let StartType = (
  | :BOOT_START: | :SYSTEM_START: | :AUTO_START: | :DEMAND_START: | :DISABLED:
)

# What Windows does when a service fails to start.
#
# | Symbol       | Meaning                                                     |
# | ------------ | ----------------------------------------------------------- |
# | `:IGNORE:`   | Logs the error and continues startup                        |
# | `:NORMAL:`   | Logs the error, displays a message, and continues startup   |
# | `:SEVERE:`   | Restarts with the last known-good configuration if possible |
# | `:CRITICAL:` | Restarts with it; fails startup if that restart fails       |
pub @let ErrorControl = (:IGNORE: | :NORMAL: | :SEVERE: | :CRITICAL:)

# Which services
# [`ScManager.enumerate_services`](winscm.ScManager.enumerate_services)
# includes.
#
# | Symbol       | Includes                        |
# | ------------ | ------------------------------- |
# | `:ACTIVE:`   | Services that are not stopped   |
# | `:INACTIVE:` | Services that are stopped       |
# | `:ALL:`      | Both                            |
pub @let StateFilter = (:ACTIVE: | :INACTIVE: | :ALL:)

# A right of a [`ManagerAccessMask`](winscm.ManagerAccessMask): a
# manager-specific right, or a generic Windows
# [`AccessRight`](security.windows.AccessRight).
#
# | Symbol                            | Meaning                                     |
# | --------------------------------- | ------------------------------------------- |
# | `:SC_MANAGER_CONNECT:`            | Connects to the Service Control Manager     |
# | `:SC_MANAGER_CREATE_SERVICE:`     | Creates services                            |
# | `:SC_MANAGER_ENUMERATE_SERVICE:`  | Enumerates services                         |
# | `:SC_MANAGER_LOCK:`               | Locks the service database                  |
# | `:SC_MANAGER_QUERY_LOCK_STATUS:`  | Queries the service database lock status    |
# | `:SC_MANAGER_MODIFY_BOOT_CONFIG:` | Modifies boot configuration information     |
# | `:SC_MANAGER_ALL_ACCESS:`         | All Service Control Manager-specific rights |
pub @let ManagerAccessRight = (
  | :SC_MANAGER_CONNECT: | :SC_MANAGER_CREATE_SERVICE:
  | :SC_MANAGER_ENUMERATE_SERVICE: | :SC_MANAGER_LOCK:
  | :SC_MANAGER_QUERY_LOCK_STATUS: | :SC_MANAGER_MODIFY_BOOT_CONFIG:
  | :SC_MANAGER_ALL_ACCESS:
  | AccessRight
)

# Access rights for a [`ScManager`](winscm.ScManager) handle.
#
# A mask is built from symbols, and every API taking one also accepts a bare
# symbol or an iterable of symbols in its place, so an explicit
# `ManagerAccessMask` is only needed to combine or inspect rights.
#
# `winscm.ManagerAccessMask` is a
# [`security.windows.AccessMask`](security.windows.AccessMask), so it
# can be used wherever a Windows access mask is expected.
#
# ## Example
#
# ```
# let a = ManagerAccessMask :SC_MANAGER_CONNECT: :SC_MANAGER_LOCK:
# let b = ManagerAccessMask [:SC_MANAGER_CONNECT:, :SC_MANAGER_LOCK:]
# ```
pub class ManagerAccessMask: AccessMask @FlagSet[ManagerAccessRight]
  # Builds a mask from a native integer, preserving every bit including ones
  # this type does not name.
  pub def from_int
    self
    # Native Windows access mask.
    value @ Int
  do -> ManagerAccessMask
    ...

  # The complete native mask as an [`Int`](std.Int), including bits this
  # type does not name.
  #[getter]
  pub def int self -> Int
    ...

# A right of a [`ServiceAccessMask`](winscm.ServiceAccessMask): a
# service-specific right, or a generic Windows
# [`AccessRight`](security.windows.AccessRight).
#
# | Symbol                           | Meaning                                        |
# | -------------------------------- | ---------------------------------------------- |
# | `:SERVICE_QUERY_CONFIG:`         | Queries the service configuration              |
# | `:SERVICE_CHANGE_CONFIG:`        | Changes the service configuration              |
# | `:SERVICE_QUERY_STATUS:`         | Queries the current service status             |
# | `:SERVICE_ENUMERATE_DEPENDENTS:` | Enumerates dependent services                  |
# | `:SERVICE_START:`                | Starts the service                             |
# | `:SERVICE_STOP:`                 | Stops the service                              |
# | `:SERVICE_PAUSE_CONTINUE:`       | Pauses or resumes the service                  |
# | `:SERVICE_INTERROGATE:`          | Requests that the service report its status    |
# | `:SERVICE_USER_DEFINED_CONTROL:` | Sends user-defined control codes to the service |
# | `:SERVICE_ALL_ACCESS:`           | All service-specific rights                    |
pub @let ServiceAccessRight = (
  | :SERVICE_QUERY_CONFIG: | :SERVICE_CHANGE_CONFIG: | :SERVICE_QUERY_STATUS:
  | :SERVICE_ENUMERATE_DEPENDENTS: | :SERVICE_START: | :SERVICE_STOP:
  | :SERVICE_PAUSE_CONTINUE: | :SERVICE_INTERROGATE:
  | :SERVICE_USER_DEFINED_CONTROL: | :SERVICE_ALL_ACCESS:
  | AccessRight
)

# Access rights for a [`Service`](winscm.Service) handle.
#
# A mask is built from symbols, and every API taking one also accepts a bare
# symbol or an iterable of symbols in its place, so an explicit
# `ServiceAccessMask` is only needed to combine or inspect rights.
#
# `winscm.ServiceAccessMask` is a
# [`security.windows.AccessMask`](security.windows.AccessMask), so it
# can be used wherever a Windows access mask is expected.
#
# ## Example
#
# ```
# let a = ServiceAccessMask :SERVICE_START: :SERVICE_STOP:
# let b = ServiceAccessMask [:SERVICE_START:, :SERVICE_STOP:]
# ```
pub class ServiceAccessMask: AccessMask @FlagSet[ServiceAccessRight]
  # Builds a mask from a native integer, preserving every bit including ones
  # this type does not name.
  pub def from_int
    self
    # Native Windows access mask.
    value @ Int
  do -> ServiceAccessMask
    ...

  # The complete native mask as an [`Int`](std.Int), including bits this
  # type does not name.
  #[getter]
  pub def int self -> Int
    ...

# A flag of a [`ServiceType`](winscm.ServiceType).
#
# | Symbol                  | Meaning                                             |
# | ----------------------- | --------------------------------------------------- |
# | `:KERNEL_DRIVER:`       | Kernel-mode device driver                           |
# | `:FILE_SYSTEM_DRIVER:`  | File-system driver                                  |
# | `:WIN32_OWN_PROCESS:`   | Win32 service running in its own process            |
# | `:WIN32_SHARE_PROCESS:` | Win32 service sharing a process with other services |
# | `:INTERACTIVE_PROCESS:` | Service that can interact with the desktop          |
# | `:DRIVER:`              | Either kind of driver                               |
# | `:WIN32:`               | Either kind of Win32 service                        |
pub @let ServiceTypeFlag = (
  | :KERNEL_DRIVER: | :FILE_SYSTEM_DRIVER: | :WIN32_OWN_PROCESS:
  | :WIN32_SHARE_PROCESS: | :INTERACTIVE_PROCESS: | :DRIVER: | :WIN32:
)

# Windows service type flags.
#
# A value is built from symbols, and every API taking one also accepts a bare
# symbol or an iterable of symbols in its place.
#
# ## Example
#
# ```
# let types = ServiceType :WIN32_OWN_PROCESS: :INTERACTIVE_PROCESS:
# ```
pub class ServiceType: Iterable[ServiceTypeFlag] @FlagSet[ServiceTypeFlag]
  # Builds a value from a native integer, preserving every bit including ones
  # this type does not name.
  pub def from_int
    self
    # Native service type mask.
    value @ Int
  do -> ServiceType
    ...

  # The complete native value as an [`Int`](std.Int), including bits this
  # type does not name.
  #[getter]
  pub def int self -> Int
    ...

# A status change in a [`NotifyMask`](winscm.NotifyMask).
#
# | Symbol               | Observes a change to                   |
# | -------------------- | -------------------------------------- |
# | `:STOPPED:`          | The stopped state                      |
# | `:START_PENDING:`    | The start-pending state                |
# | `:STOP_PENDING:`     | The stop-pending state                 |
# | `:RUNNING:`          | The running state                      |
# | `:CONTINUE_PENDING:` | The continue-pending state             |
# | `:PAUSE_PENDING:`    | The pause-pending state                |
# | `:PAUSED:`           | The paused state                       |
# | `:CREATED:`          | Service creation                       |
# | `:DELETED:`          | Service deletion                       |
# | `:DELETE_PENDING:`   | A service becoming marked for deletion |
pub @let NotifyChange = (
  | :STOPPED: | :START_PENDING: | :STOP_PENDING: | :RUNNING:
  | :CONTINUE_PENDING: | :PAUSE_PENDING: | :PAUSED: | :CREATED: | :DELETED:
  | :DELETE_PENDING:
)

# Service status changes to observe.
#
# Passed to
# [`Service.wait_for_status_change`](winscm.Service.wait_for_status_change),
# which also accepts a bare symbol or an iterable of symbols in its place.
#
# ## Example
#
# ```
# let mask = NotifyMask :RUNNING: :STOPPED:
# ```
pub class NotifyMask: Iterable[NotifyChange] @FlagSet[NotifyChange]
  # Builds a mask from a native integer, preserving every bit including ones
  # this type does not name.
  pub def from_int
    self
    # Native notification mask.
    value @ Int
  do -> NotifyMask
    ...

  # The complete native mask as an [`Int`](std.Int), including bits this
  # type does not name.
  #[getter]
  pub def int self -> Int
    ...

# A control in a [`ServiceControlsAccepted`](winscm.ServiceControlsAccepted).
#
# | Symbol                    | Accepts control requests to                       |
# | ------------------------- | ------------------------------------------------- |
# | `:STOP:`                  | Stop the service                                  |
# | `:PAUSE_CONTINUE:`        | Pause or continue the service                     |
# | `:SHUTDOWN:`              | Prepare for system shutdown                       |
# | `:PARAMCHANGE:`           | Reload configuration parameters                   |
# | `:NETBINDCHANGE:`         | Handle a network binding change                   |
# | `:HARDWAREPROFILECHANGE:` | Handle a hardware-profile change                  |
# | `:POWEREVENT:`            | Handle a power event                              |
# | `:SESSIONCHANGE:`         | Handle a terminal-services session change         |
# | `:PRESHUTDOWN:`           | Prepare for system shutdown before other services |
# | `:TIMECHANGE:`            | Handle a system-time change                       |
# | `:TRIGGEREVENT:`          | Handle a service-trigger event                    |
pub @let AcceptedControl = (
  | :STOP: | :PAUSE_CONTINUE: | :SHUTDOWN: | :PARAMCHANGE: | :NETBINDCHANGE:
  | :HARDWAREPROFILECHANGE: | :POWEREVENT: | :SESSIONCHANGE: | :PRESHUTDOWN:
  | :TIMECHANGE: | :TRIGGEREVENT:
)

# Controls a running service accepts.
#
# Reported by
# [`Status.controls_accepted`](winscm.Status.controls_accepted); a service that
# does not accept a control ignores it.
#
# ## Example
#
# ```
# let status = service.query_status()
# if status.controls_accepted.contains(:STOP:)
#   service.control :STOP:
# ```
pub class ServiceControlsAccepted: Iterable[AcceptedControl] @FlagSet[AcceptedControl]
  # Builds a value from a native integer, preserving every bit including ones
  # this type does not name.
  pub def from_int
    self
    # Native controls-accepted mask.
    value @ Int
  do -> ServiceControlsAccepted
    ...

  # The complete native value as an [`Int`](std.Int), including bits this
  # type does not name.
  #[getter]
  pub def int self -> Int
    ...

# Manager rights, given as a [`ManagerAccessMask`](winscm.ManagerAccessMask),
# one right, or an iterable of rights.
pub @let ManagerAccessMaskSpec = (
  | ManagerAccessMask | ManagerAccessRight | Iterable[ManagerAccessRight]
)

# Service rights, given as a [`ServiceAccessMask`](winscm.ServiceAccessMask),
# one right, or an iterable of rights.
pub @let ServiceAccessMaskSpec = (
  | ServiceAccessMask | ServiceAccessRight | Iterable[ServiceAccessRight]
)

# Service types, given as a [`ServiceType`](winscm.ServiceType), one flag, or an
# iterable of flags.
pub @let ServiceTypeSpec = (
  | ServiceType | ServiceTypeFlag | Iterable[ServiceTypeFlag]
)

# Status changes, given as a [`NotifyMask`](winscm.NotifyMask), one change, or
# an iterable of changes.
pub @let NotifyMaskSpec = (NotifyMask | NotifyChange | Iterable[NotifyChange])

# An open handle to the Windows Service Control Manager.
#
# Returned by [`open`](winscm.open).
pub class ScManager
  # Closes the manager.
  #
  # Closing an already-closed manager does nothing.
  pub def close self
    ...

  # Opens an existing service.
  #
  # ## Errors
  #
  # | Exception                                        | Condition                    |
  # | ------------------------------------------------ | ---------------------------- |
  # | [`sys.NotFoundError`](sys.NotFoundError) | The service does not exist   |
  #
  # ## Example
  #
  # ```
  # manager.open_service Spooler access: :SERVICE_QUERY_STATUS: do |service|
  #   echo $service.query_status().current_state
  # ```
  @def open_service
    self
    # Service name.
    name @ Str
    # Rights the returned handle requests. Defaults to
    # `:SERVICE_QUERY_STATUS:`.
    :access @ ServiceAccessMaskSpec = nil
  do -> Service

  # Opens an existing service and calls `func` with it. The service handle is
  # closed when `func` returns.
  @def open_service[R]
    self
    # Service name.
    name @ Str
    # Rights the returned handle requests. Defaults to
    # `:SERVICE_QUERY_STATUS:`.
    :access @ ServiceAccessMaskSpec = nil
    # Called with the [`Service`](winscm.Service).
    func @ (Service -> R)
  do -> R

  pub def open_service self name ...options
    ...

  # Creates a service.
  #
  # ## Example
  #
  # ```
  # let service = manager.create_service my-service
  #   display_name: My Service
  #   binary_path: [r"C:\Program Files\My Service\service.exe"]
  #   access: :SERVICE_ALL_ACCESS:
  # ```
  @def create_service
    self
    # Service name.
    name @ Str
    # Display name. Omit to pass `NULL` to Windows.
    :display_name @ Str = nil
    # Service executable path or command line. Omit to pass `NULL` to Windows.
    #
    # A [`Str`](std.Str) is passed to Windows verbatim. An absolute
    # [`fs.windows.Path`](fs.windows.Path) is used as the executable path
    # and quoted when needed. An iterable supplies command arguments as
    # [`Str`](std.Str) values or absolute
    # [`fs.windows.Path`](fs.windows.Path) values; each element is quoted
    # with the Windows command-line rules.
    :binary_path @ (Str | Path) = nil
    # Service type. Defaults to `:WIN32_OWN_PROCESS:`.
    :service_type @ ServiceTypeSpec = nil
    # Start type. Defaults to `:DEMAND_START:`.
    :start_type @ StartType = nil
    # Error control level. Defaults to `:NORMAL:`.
    :error_control @ ErrorControl = nil
    # Rights the returned handle requests. Defaults to
    # `:SERVICE_QUERY_STATUS:`.
    :access @ ServiceAccessMaskSpec = nil
    # Load-order group.
    :load_order_group @ Str = nil
    # Service or load-order-group names this service depends on.
    :dependencies @ Iterable[Str] = nil
    # Account the service runs as.
    :service_start_name @ Str = nil
    # Password for `service_start_name`.
    :password @ Str = nil
  do -> Service

  # Creates a service and calls `func` with it. The service handle is closed
  # when `func` returns.
  @def create_service[R]
    self
    # Service name.
    name @ Str
    # Display name. Omit to pass `NULL` to Windows.
    :display_name @ Str = nil
    # Service executable path or command line. Omit to pass `NULL` to Windows.
    :binary_path @ (Str | Path) = nil
    # Service type. Defaults to `:WIN32_OWN_PROCESS:`.
    :service_type @ ServiceTypeSpec = nil
    # Start type. Defaults to `:DEMAND_START:`.
    :start_type @ StartType = nil
    # Error control level. Defaults to `:NORMAL:`.
    :error_control @ ErrorControl = nil
    # Rights the returned handle requests. Defaults to
    # `:SERVICE_QUERY_STATUS:`.
    :access @ ServiceAccessMaskSpec = nil
    # Load-order group.
    :load_order_group @ Str = nil
    # Service or load-order-group names this service depends on.
    :dependencies @ Iterable[Str] = nil
    # Account the service runs as.
    :service_start_name @ Str = nil
    # Password for `service_start_name`.
    :password @ Str = nil
    # Called with the [`Service`](winscm.Service).
    func @ (Service -> R)
  do -> R

  pub def create_service self name ...options
    ...

  # Opens a live forward enumeration of matching services. Entries are fetched
  # from Windows as iteration advances.
  #
  # ## Example
  #
  # ```
  # for info = manager.enumerate_services state_filter: :ACTIVE:
  #   echo $info.name
  # ```
  pub def enumerate_services
    self
    # Types to include. Defaults to `:WIN32:`.
    :service_type @ ServiceTypeSpec = nil
    # Which services to include. Defaults to `:ALL:`.
    :state_filter @ StateFilter = nil
  do -> Iter[ServiceInfo]
    ...

# An open Windows service handle.
#
# Returned by [`ScManager.open_service`](winscm.ScManager.open_service) and
# [`ScManager.create_service`](winscm.ScManager.create_service).
pub class Service
  # Closes the service handle.
  #
  # Closing an already-closed handle does nothing. This releases the handle; it
  # does not stop or delete the service.
  pub def close self
    ...

  # Starts the service.
  pub def start
    self
    # Arguments passed to the service's `main`.
    *args @ Str
  do
    ...

  # Sends a control request.
  #
  # ## Returns
  #
  # The status after the control is applied.
  #
  # ## Example
  #
  # ```
  # let status = service.control :STOP:
  # ```
  pub def control
    self
    # Control request.
    control @ ControlRequest
  do -> Status
    ...

  # Marks the service for deletion.
  #
  # Windows removes the service once no handle to it remains open and it is not
  # running.
  pub def delete self
    ...

  # Fetches the current service status.
  pub def query_status self -> Status
    ...

  # Waits until one of the requested status changes occurs.
  #
  # ## Returns
  #
  # The status observed after the change.
  pub def wait_for_status_change
    self
    # Changes to observe.
    mask @ NotifyMaskSpec
  do -> Status
    ...

  # Fetches the current service configuration.
  #
  # ## Returns
  #
  # An immutable snapshot.
  pub def config self -> ServiceConfig
    ...

  # Updates the supplied configuration fields. Omitted fields are left
  # unchanged.
  #
  # ## Example
  #
  # ```
  # service.update_config
  #   start_type: :AUTO_START:
  #   dependencies: (tuple "RpcSs" "EventLog")
  # ```
  pub def update_config
    self
    # Service type flags.
    :service_type @ ServiceTypeSpec = nil
    # Start type.
    :start_type @ StartType = nil
    # Error control level.
    :error_control @ ErrorControl = nil
    # Service command line, taking the forms
    # [`create_service`](winscm.ScManager.create_service) accepts.
    :binary_path @ (Str | Path) = nil
    # Load-order group.
    :load_order_group @ Str = nil
    # Service or load-order-group names this service depends on.
    :dependencies @ Iterable[Str] = nil
    # Account the service runs as.
    :service_start_name @ Str = nil
    # Password for `service_start_name`.
    :password @ Str = nil
    # Display name.
    :display_name @ Str = nil
  do
    ...

  # Gets selected parts of the service's Windows security descriptor.
  pub def sec_desc
    self
    # Load the owner SID. Defaults to `true`.
    :owner @ Bool = nil
    # Load the primary group SID. Defaults to
    # `true`.
    :group @ Bool = nil
    # Load the discretionary ACL. Defaults to
    # `true`.
    :dacl @ Bool = nil
    # Load the system ACL. Defaults to `false`.
    :sacl @ Bool = nil
  do -> SecDesc
    ...

  # Applies the components a Windows security descriptor's `mask` selects.
  pub def update_sec_desc
    self
    # Descriptor to apply.
    desc @ SecDescSpec = nil
    # Components, as [`sec_desc`](security.windows.sec_desc) takes them, instead
    # of or alongside `desc`.
    ...options
  do
    ...

# Immutable snapshot of a service's configuration.
#
# Returned by [`Service.config`](winscm.Service.config).
pub class ServiceConfig
  # Service type flags.
  #[getter]
  pub def service_type self -> ServiceType
    ...

  # Start type. A native value this module does not name is returned as an
  # [`Int`](std.Int).
  #[getter]
  pub def start_type self -> (StartType | Int)
    ...

  # Error control level. A native value this module does not name is returned
  # as an [`Int`](std.Int).
  #[getter]
  pub def error_control self -> (ErrorControl | Int)
    ...

  # Service command line.
  #[getter]
  pub def binary_path self -> Str
    ...

  # Load-order group.
  #[getter]
  pub def load_order_group self -> (Str | nil)
    ...

  # Load-order tag within `load_order_group`.
  #[getter]
  pub def tag_id self -> Int
    ...

  # Service and load-order-group names this
  # service depends on.
  #[getter]
  pub def dependencies self -> Tuple[...Str]
    ...

  # Account the service runs as.
  #[getter]
  pub def service_start_name self -> Str
    ...

  # Display name.
  #[getter]
  pub def display_name self -> Str
    ...

# Snapshot of a service's current status.
#
# Returned by [`Service.query_status`](winscm.Service.query_status) and
# [`Service.control`](winscm.Service.control).
pub class Status
  # Service type flags.
  #[getter]
  pub def service_type self -> ServiceType
    ...

  # Service state. A native value this module does not name is returned as an
  # [`Int`](std.Int).
  #[getter]
  pub def current_state self -> (ServiceState | Int)
    ...

  # Controls the
  # service accepts in its current state.
  #[getter]
  pub def controls_accepted self -> ServiceControlsAccepted
    ...

  # Windows error code from the service's last start
  # or stop.
  #[getter]
  pub def win32_exit_code self -> Int
    ...

  # Service-defined exit code.
  #[getter]
  pub def service_specific_exit_code self -> Int
    ...

  # Progress checkpoint the service increments during
  # a pending operation.
  #[getter]
  pub def check_point self -> Int
    ...

  # Milliseconds the service expects a pending
  # operation to take.
  #[getter]
  pub def wait_hint self -> Int
    ...

  # Identifier of the service's process.
  #[getter]
  pub def process_id self -> Int
    ...

# One entry in a service enumeration.
#
# Yielded by
# [`ScManager.enumerate_services`](winscm.ScManager.enumerate_services).
#
# ## Example
#
# ```
# for info = manager.enumerate_services()
#   let :name :status = info
#   echo "$name: $(status.current_state)"
# ```
pub class ServiceInfo
  # Service name.
  #[getter]
  pub def name self -> Str
    ...

  # Display name.
  #[getter]
  pub def display_name self -> (Str | nil)
    ...

  # Status captured during enumeration.
  #[getter]
  pub def status self -> Status
    ...

# Opens the local Service Control Manager.
#
# ## Example
#
# ```
# winscm.open access: :SC_MANAGER_ENUMERATE_SERVICE: do |manager|
#   for info = manager.enumerate_services()
#     echo $info.name
# ```
@def open
  # Rights the returned handle requests. Defaults to `:SC_MANAGER_CONNECT:`.
