# One entry in a service enumeration.
#
# Yielded by
# [`ScManager.enumerate_services`](winscm.ScManager.enumerate_services).
#
# ## Example
#
# ```
# for info = manager.enumerate_services()
#   let :name :status = info
#   echo "$name: $(status.current_state)"
# ```
pub class ServiceInfo
  # ([`Str`](std.Str)) Service name.
  #[getter]
  pub def name self
    throw nil

  # ([`Str`](std.Str)?) Display name.
  #[getter]
  pub def display_name self
    throw nil

  # ([`Status`](winscm.Status)) Status captured during enumeration.
  #[getter]
  pub def status self
    throw nil

# Opens the local Service Control Manager.
#
# ## Returns
#
# [`ScManager`](winscm.ScManager) when no `func` is given, otherwise the result
# of calling `func`.
#
# ## Example
#
# ```
# winscm.open access: :SC_MANAGER_ENUMERATE_SERVICE: do |manager|
#   for info = manager.enumerate_services()
#     echo $info.name
# ```
pub def open
  # ([`ManagerAccessMask`](winscm.ManagerAccessMask)|[`Sym`](std.Sym))
  # Rights the returned handle requests, as a mask, a symbol, or an iterable of
  # symbols. Defaults to `:SC_MANAGER_CONNECT:`.
  :access = nil
  # ([`Func`](std.Func)) Called with the [`ScManager`](winscm.ScManager), which is closed
  # when it returns. Omit to receive the handle instead.
  func = nil
do
  throw nil
