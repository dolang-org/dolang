  # Rights the returned handle requests. Defaults to `:SC_MANAGER_CONNECT:`.
  :access @ ManagerAccessMaskSpec = nil
  # Called with the [`ScManager`](winscm.ScManager).
  func @ (ScManager -> R)
do -> R

