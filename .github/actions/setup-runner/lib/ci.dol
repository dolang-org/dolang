# Runner provisioning for the setup-runner action.
#
# `setup` is the whole of it: it installs the `dolang-ci` wrapper and whatever
# build prerequisites the target needs, either on the runner itself or in a CI
# VM created for the job. Runner logs are not a terminal, so its progress
# indicators render as plain step lines.

import cache fs gold http libvirt proc progress sudo sys

# Libvirt domain name for the CI VM.
pub let VM_NAME = "dolang-ci"

# Runner directories jettisoned to make room for the VM image and its overlay,
# in the order they are taken.
#
# Ordered by bytes freed per file removed rather than by size. The removal
# bottoms out in one `unlink` per file, so what a tree costs is its file count,
# not its bytes — and `/usr/local/lib/android`, the largest single win on a
# runner, is also several hundred thousand files of it. That is most of why this
# step took two to three minutes when it was the first thing on the list; here it
# is last, so a run that reaches its target earlier never pays for it.
let RUNNER_BALLAST = $
  - /usr/share/swift
  - /opt/hostedtoolcache/CodeQL
  - /usr/share/dotnet
  - /usr/local/.ghcup
  - /opt/ghc
  - /usr/local/lib/android

# Free space to stop reclaiming at, for a run that brings the VM up from the
# gold bundle and one that has to mint it first.
#
# The minting figure is larger by roughly the base image: `create` decompresses
# it to its full virtual size, and it stays on disk for the rest of the job
# alongside the overlay the build then grows. Restoring from a bundle never
# fetches it at all, which is the case worth being cheap in — it is every run
# but the rare one.
#
# Both are estimates. Overshooting costs a directory removal that was not
# needed; undershooting costs a build that runs the disk out halfway through, so
# they are set high. An unreachable target just means the whole list goes, which
# is what this step did unconditionally before — the failure mode is the old
# behavior rather than a broken job. Tune against what `reclaim` reports.
let RESTORE_FREE = (40 * 1024 * 1024 * 1024)
let MINT_FREE = (64 * 1024 * 1024 * 1024)

let PROGRESS_STYLE = $
  message:
    width: 120

# Bytes free on the runner's root filesystem.
def free_space()
  fs.fs_metadata("/").available

# Removes runner ballast until `required` bytes are free, or until the list runs
# out.
#
# Elevates once around the whole loop rather than per directory: `sudo.with`
# spawns an agent, and the free-space probe between removals runs through the
# same one.
def reclaim required
  let before = free_space()
  sudo.with do
    for path = RUNNER_BALLAST
      if (free_space() >= required)
        break
      fs.remove all: true ignore: true $path
  let after = free_space()
  echo "reclaimed $((after - before) // 1048576) MiB; $(after // 1048576) MiB free"

# Exports `name=value` to subsequent steps of the job.
def export name value
  fs.append $env["GITHUB_ENV"] "$name=$value\n"

# Installs the `dolang-ci` wrapper, which runs `shell` (the workflow shell
# dispatcher next door) on each step script, and puts it on `PATH` for the
# rest of the job.
def install_wrapper shell
  let bin_dir = (fs.Path(env["RUNNER_TEMP"]) / "dolang-ci-bin")
  bin_dir.create_dir all: true

  if (sys.os_info().family == :WINDOWS:)
    fs.write (bin_dir / "dolang-ci.cmd") |
      @echo off
      dolang "$shell" %*
      exit /b %errorlevel%
  else
    let wrapper = (bin_dir / "dolang-ci")
    fs.write $wrapper |
      #!/bin/sh
      exec dolang "$shell" "\$@"
    fs.update_metadata mode: 0o755 $wrapper

  fs.append $env["GITHUB_PATH"] "$bin_dir\n"

# Trims debug info generation for every CI build.
#
# Full debug info costs compile time, link time, and disk on every runner, and
# nothing in CI keeps the artifacts for offline analysis — no core files are
# scraped off a runner before it is destroyed. `line-tables-only` is the least
# that still gives a panic or crash backtrace file and line numbers; symbol
# names come from the symbol table, so those survive regardless.
#
# The VM target needs these forwarded into the guest as well; `VM_ENV` in
# shell.dol next door lists them.
def configure_cargo()
  export CARGO_PROFILE_DEV_DEBUG line-tables-only
  export CARGO_PROFILE_TEST_DEBUG line-tables-only
  export CARGO_INCREMENTAL 0

# Allows rootless Podman to stop its pasta network helper on Ubuntu 26.04.
# https://bugs.launchpad.net/bugs/2154379
def configure_pasta_apparmor()
  let profile = fs.Path "/etc/apparmor.d/usr.bin.pasta"
  if !profile.exists()
    return
  let rule = "signal (receive) set=(term) peer=podman,"
  let contents = str(fs.read(profile))
  if contents.contains(rule)
    return
  let anchor = "  include <abstractions/pasta>\n"
  if !contents.contains(anchor)
    throw "unexpected pasta AppArmor profile: missing abstractions/pasta include"
  sudo.with do
    fs.write $profile $(contents.replace anchor "$anchor  $rule\n")
    run apparmor_parser -r $profile

# Installs the virtualization packages a session-mode libvirt domain needs.
#
# The last line is what a Windows guest needs beyond a cloud-init one: `ovmf`
# for the UEFI firmware and its secure-boot variable template, `swtpm-tools`
# for the vTPM 2.0 the installer refuses to run without, and `xorriso` for the
# provisioning disc (`cloud-localds` covers only the cloud-init path). None of
# it is optional for that test — the test *skips* when they are missing rather
# than failing, so leaving them out is how the whole thing quietly does
# nothing.
def install_virt()
  sudo.with do
    run apt-get update
    run apt-get install -y
      libvirt-daemon-system libvirt-clients qemu-system-x86 qemu-utils
      passt cloud-image-utils openssh-client apparmor-utils
      ovmf swtpm swtpm-tools xorriso

# Grants KVM access and unconfines user namespaces enough for session-mode
# libvirt to start a domain.
def unconfine()
  sudo.with do
    run usermod -aG kvm,libvirt $env["USER"]
    fs.update_metadata mode: 0o666 /dev/kvm
    run sysctl -w kernel.apparmor_restrict_unprivileged_userns=0
    run sysctl -w kernel.unprivileged_userns_clone=1
    run systemctl stop apparmor.service
    run systemctl disable apparmor.service
    try
      # Reports an I/O error per profile it could not unload — around a hundred
      # of them — and then exits non-zero even though enforcement did get
      # turned off. The catch is for that false failure, not for a real one:
      # `aa-teardown` going missing must stay fatal, because passt segfaults if
      # AppArmor is still enforcing.
      run aa-teardown stderr: $std.null
    catch proc.Error: _
      nil

# Brings the CI VM up from the gold bundle.
#
# No provisioning happens here at all: no seed, no cloud-init, no `pkg`, no
# payload install. Everything the guest needs was baked in by `gold.build`, and
# what is left is the domain sizing, which the job — not the image — decides.
def create_vm()
  libvirt.create
    bundle: (gold.path())
    name: $VM_NAME
    app: $gold.VM_APP
    memory: 12288
    vcpus: 4
    # The domain is destroyed with the runner at the end of the job, so there
    # is nothing to lose by dropping guest flushes — and a great deal of the
    # build's write traffic is temporaries that then never need to reach the
    # host's storage at all. Anything worth keeping is tarred out of the guest
    # while it is still running.
    #
    # Safe here in a way it is not for the minting pass, whose whole output is
    # a disk meant to outlive the run; see `gold.build`.
    cache: :UNSAFE:

# Installs the Rust toolchain into the guest.
#
# Separate from `create_vm` so that a restored build cache can skip it: the
# cache carries `.rustup` and `.cargo`, which is a working toolchain already,
# and rustup's download is a large share of what provisioning costs.
#
# `http.get` runs on the runner and its chunks are piped into the guest's
# `sh`, so the download uses the runner's network rather than the domain's
# comparatively slow user-mode networking.
# `--no-modify-path` because `gold.PROFILE` already puts the toolchain on
# `PATH`; letting rustup append its own line as well would leave two sources of
# truth for the same thing, only one of which survives into a cached run.
def install_rust vm
  vm.with do
    http.get https://sh.rustup.rs do |resp|
      run sh -s -- -y --no-modify-path --profile default stdin: $resp.chunks()

# Uploads a snapshot of the workspace into the VM's home directory.
def upload_workspace vm
  run tar -czf /tmp/dolang-src.tar.gz --exclude=.git --exclude=target .
  vm.upload /tmp/dolang-src.tar.gz /home/ci/dolang-src.tar.gz
  vm.with do
    run tar -xzf dolang-src.tar.gz
    run rm -f dolang-src.tar.gz

# Packs the CI VM's build caches back onto the runner, for `actions/cache` to
# save once the job ends.
#
# Lives here rather than in `cache` so that the progress presentation stays
# with `PROGRESS_STYLE` and the runner-specific plumbing — `cache` is imported
# by this module, so it cannot import back. Without the `progress.with`, the
# indicators inside `cache.save` have no renderer configured and the step
# produces no output at all.
#
# Runs as its own workflow step rather than at the end of `setup`, because it
# has to happen after the build steps have populated the caches.
pub def save_cache()
  let name = env.get "DOLANG_CI_VM"
  if name
    let vm = libvirt.attach $name
    progress.with style: $PROGRESS_STYLE do
      progress.show icon: 💾 message: "save build cache" do |_|
        cache.save $vm
  nil

# Sets up the runner to build `target`, which defaults to whatever the runner
# builds natively.
#
# `shell` is the path to the workflow shell dispatcher that the `dolang-ci`
# wrapper runs. `rust` may be turned off for jobs that only need Do, and
# `disk_size` sizes the CI VM for targets that use one.
pub def setup
  :shell
  :target = nil
  :rust = true
  :virt = false
do
  # Filled in by "create CI VM" below when `target` needs one.
  let vm = nil
  # Decided before any step runs, because it also sizes how much runner disk
  # the reclaim step has to free.
  let minting = (target == "x86_64-freebsd" && !gold.path().exists())

  progress.with style: $PROGRESS_STYLE do
    progress.steps message: "set up runner" icon: 🚀
      - name: "install dolang-ci wrapper"
        icon: 🔧
        do install_wrapper $shell
      if rust
        - name: "configure cargo"
          icon: 🦀
          do configure_cargo()
      if (sys.os_info().os == :LINUX:)
        - name: "configure pasta AppArmor signals"
          icon: 🔧
          do configure_pasta_apparmor()
      if (virt && sys.os_info().os == :LINUX: && sys.cpu_info().arch == :X86_64:)
        - name: "install virtualization packages"
          icon: 📦
          do install_virt()
        - name: "unconfine user namespaces"
          icon: 🔓
          do unconfine()
      if (target == "x86_64-freebsd")
        # The VM is left running: GitHub runners are ephemeral, so it dies
        # with the job. `setup` exports `DOLANG_CI_VM` below once these have
        # run, pointing the `dolang-ci` wrapper at it for the rest of the job.
        - name: "reclaim runner disk space"
          icon: 🧹
          do reclaim (minting && MINT_FREE || RESTORE_FREE)
        # Usually a no-op: the bundle arrives from the runner cache, and only a
        # change to the recipe in gold.dol (which is what keys that cache) sends
        # this down the minting path. Doing it here rather than in the workflow
        # keeps the decision next to the thing that answers it.
        - name: "mint gold image"
          icon: 🏗️
          do if minting
            gold.build()
        - name: "create CI VM"
          icon: 🖥️
          do 
            vm = create_vm()
            export DOLANG_CI_VM $VM_NAME
        - name: "upload workspace"
          icon: ⬆️
          do upload_workspace $vm
        - name: "restore build cache"
          icon: 📥
          do cache.restore $vm
        # A restored cache already supplies a toolchain, so this is usually a no-op
        - name: "ensure rust"
          icon: 🦀
          do if !cache.has_rust(vm)
            install_rust $vm
      if (rust && target.ends_with "-linux")
        - name: "install musl"
          icon: 📦
          do run sudo apt install musl-dev musl-tools
        - name: "add musl target"
          icon: 🦀
          do run rustup target add $(target.split("-").next())-unknown-linux-musl
