# ```
pub def sha1
  # ([`Str`](std.Str)\|[`Bin`](std.Bin)) Input to hash.
  data
do
  throw nil

# Computes the SHA-256 digest.
#
# ## Returns
#
# [`Bin`](std.Bin) holding the 32-byte digest.
#
# ## Example
#
# ```
# let digest = sha256 "abc"
# assert_eq "${digest:x}"
#   ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad
# ```
pub def sha256
  # ([`Str`](std.Str)\|[`Bin`](std.Bin)) Input to hash.
  data
do
  throw nil

# Computes the SHA-512 digest.
#
# ## Returns
#
# [`Bin`](std.Bin) holding the 64-byte digest.
#
# ## Example
#
# ```
# let digest = sha512 "abc"
# assert_eq ("${digest:x}"[..10])
#   ddaf35a193
# ```
pub def sha512
  # ([`Str`](std.Str)\|[`Bin`](std.Bin)) Input to hash.
  data
do
  throw nil
