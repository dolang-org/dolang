# UUID and Windows GUID generation, parsing, and field access.

# Parsed or generated UUID value.
pub class Uuid
  # The max `Uuid`, `ffffffff-ffff-ffff-ffff-ffffffffffff`.
  #[class]
  pub field MAX = nil

  # The nil `Uuid`, `00000000-0000-0000-0000-000000000000`.
  #[class]
  pub field NIL = nil

  # Parses UUID text or binary, or copies an existing `Uuid`.
  #
  # Text may be hyphenated, simple, braced, or URN form. Binary values must be
  # exactly 16 bytes.
  #
  # ## Errors
  #
  # `ValueError` if the text is invalid or bytes are not exactly 16 long.
  #
  # ## Example
  #
  # ```
  # let id = Uuid "67e55044-10b1-426f-9247-bb680e5fe0c8"
  # let copy = Uuid $id
  # ```
  pub def (init)
    self
    # UUID to parse or copy.
    value @ (Str | Bin | Uuid)
  do
    ...

  # Generates a random version 4 UUID.
  #
  # ## Example
  #
  # ```
  # let id = Uuid.generate()
  # assert_eq $id.version 4
  # assert_eq $id.variant :RFC4122:
  # ```
  #[class]
  pub def generate self -> Uuid
    ...

  # The raw 16-byte binary form.
  #[getter]
  pub def bytes self
    ...

  # The simple lowercase hexadecimal form without hyphens.
  #[getter]
  pub def hex self
    ...

  # The UUID variant: `:NCS:`, `:RFC4122:`, `:MICROSOFT:`, or `:FUTURE:`.
  #[getter]
  pub def variant self
    ...

  # The UUID version number, such as `4` for a randomly generated UUID.
  #[getter]
  pub def version self
    ...

  # Compares two UUID values.
  pub def (eq) self other
    ...

  # Returns the canonical hyphenated UUID text.
  pub def (str) self
    ...

# Windows globally unique identifier mirroring the native `GUID` fields.
pub class Guid
  # The nil `Guid`, `00000000-0000-0000-0000-000000000000`.
  #[class]
  pub field NIL = nil

  # Parses canonical GUID text or binary, or copies an existing `Guid`.
  #
  # Binary values use the 16-byte native Windows in-memory layout.
  #
  # ## Errors
  #
  # `ValueError` if the text is invalid or bytes are not exactly 16 long.
  #
  # ## Example
  #
  # ```
  # let id = Guid "00112233-4455-6677-8899-aabbccddeeff"
  # let copy = Guid $id
  # ```
  pub def (init)
    self
    # GUID text, native packet, or `Guid`.
    value @ (Str | Bin | Guid)
  do
    ...

  # Generates a random `Guid`.
  pub def generate self -> Guid
    ...

  # The raw 16-byte native Windows in-memory GUID packet.
  #[getter]
  pub def bytes self
    ...

  # The `Data1` field.
  #[getter]
  pub def data1 self
    ...

  # The `Data2` field.
  #[getter]
  pub def data2 self
    ...

  # The `Data3` field.
  #[getter]
  pub def data3 self
    ...

  # The 8-byte `Data4` field.
  #[getter]
  pub def data4 self
    ...

  # Compares two GUID values.
  pub def (eq) self other
    ...

  # Returns the canonical hyphenated GUID text.
  pub def (str) self
    ...
