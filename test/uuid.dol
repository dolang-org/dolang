import
  uuid
  std:
    - hash
    - TypeError
    - DataError
  test:
    - assert_eq
    - assert_ne
    - assert_throws
    - test

#[test]
def generate_round_trip()
  let id = uuid.Uuid.generate()
  assert_eq $id.version 4
  assert_eq $id.variant :RFC4122:

  let reparsed = uuid.Uuid (str id)
  assert_eq $reparsed $id

#[test]
def parse_text_forms()
  let hyphenated = uuid.Uuid "67e55044-10b1-426f-9247-bb680e5fe0c8"
  let simple = uuid.Uuid "67e5504410b1426f9247bb680e5fe0c8"
  let braced = uuid.Uuid "{67e55044-10b1-426f-9247-bb680e5fe0c8}"
  let urn = uuid.Uuid "urn:uuid:67e55044-10b1-426f-9247-bb680e5fe0c8"

  assert_eq $hyphenated $simple
  assert_eq $hyphenated $braced
  assert_eq $hyphenated $urn
  assert_eq (str hyphenated) "67e55044-10b1-426f-9247-bb680e5fe0c8"
  assert_eq $hyphenated.hex "67e5504410b1426f9247bb680e5fe0c8"

#[test]
def copy_constructor()
  let id = uuid.Uuid.generate()
  let copy = uuid.Uuid $id
  assert_eq $copy $id

#[test]
def bytes_round_trip()
  let id = uuid.Uuid.generate()
  let bytes = id.bytes
  assert_eq $bytes.len 16

  let reconstructed = uuid.Uuid $bytes
  assert_eq $reconstructed $id

#[test]
def bad_bytes_length()
  let err = assert_throws $DataError do
    uuid.Uuid b"\x01\x02\x03"
  assert_eq (str err) "data error: uuid binary form must be exactly 16 bytes"

#[test]
def bad_text()
  assert_throws $DataError do
    uuid.Uuid "not-a-uuid"

#[test]
def constants()
  assert_eq (str uuid.Uuid.NIL) "00000000-0000-0000-0000-000000000000"
  assert_eq $uuid.Uuid.NIL.version 0
  assert_eq (str uuid.Uuid.MAX) "ffffffff-ffff-ffff-ffff-ffffffffffff"
  assert_ne $uuid.Uuid.NIL $uuid.Uuid.MAX

#[test]
def eq_ord_hash()
  let id1 = uuid.Uuid.generate()
  let id2 = uuid.Uuid (str id1)
  let id3 = uuid.Uuid.generate()

  assert_eq $id1 $id2
  assert_ne $id1 $id3
  assert_eq (hash id1) (hash id2)

  let d = {}
  d[id1] = "value"
  assert_eq $d[id2] "value"

#[test]
def constructor_bad_type()
  let err = assert_throws $TypeError do
    uuid.Uuid 1
  assert_eq (str err) "type error: expected Uuid, Str, or Bin"

#[test]
def guid_generate_round_trip()
  let id = uuid.Guid.generate()
  let reparsed = uuid.Guid (str id)
  assert_eq $reparsed $id

#[test]
def guid_parse_text_and_fields()
  let id = uuid.Guid "00112233-4455-6677-8899-aabbccddeeff"

  assert_eq (str id) "00112233-4455-6677-8899-aabbccddeeff"
  assert_eq $id.data1 0x00112233
  assert_eq $id.data2 0x4455
  assert_eq $id.data3 0x6677
  assert_eq $id.data4 b"\x88\x99\xaa\xbb\xcc\xdd\xee\xff"

#[test]
def guid_bytes_round_trip()
  let id = uuid.Guid "00112233-4455-6677-8899-aabbccddeeff"
  let bytes = id.bytes
  assert_eq $bytes.len 16
  assert_eq $bytes b"\x33\x22\x11\x00\x55\x44\x77\x66\x88\x99\xaa\xbb\xcc\xdd\xee\xff"

  let reconstructed = uuid.Guid $bytes
  assert_eq $reconstructed $id

#[test]
def guid_bad_bytes_length()
  let err = assert_throws $DataError do
    uuid.Guid b"\x01\x02\x03"
  assert_eq (str err) "data error: guid binary form must be exactly 16 bytes"

#[test]
def guid_bad_text()
  assert_throws $DataError do
    uuid.Guid "not-a-guid"

#[test]
def guid_nil_constant()
  assert_eq (str uuid.Guid.NIL) "00000000-0000-0000-0000-000000000000"

#[test]
def guid_eq_ord_hash()
  let id1 = uuid.Guid.generate()
  let id2 = uuid.Guid (str id1)
  let id3 = uuid.Guid.generate()

  assert_eq $id1 $id2
  assert_ne $id1 $id3
  assert_eq (hash id1) (hash id2)

  let d = {}
  d[id1] = "value"
  assert_eq $d[id2] "value"

#[test]
def guid_constructor_bad_type()
  let err = assert_throws $TypeError do
    uuid.Guid 1
  assert_eq (str err) "type error: expected Guid, Str, or Bin"
