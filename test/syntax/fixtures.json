[
  {
    "name": "keywords and decayed names",
    "lines": [
      "class Widget",
      "  pub field value = nil",
      "try",
      "  re.match(\"x\")",
      "catch err",
      "  throw err",
      "finally",
      "  echo done",
      "let keys = {if: 1, match: 2, class: 3}",
      "match value",
      "  1 do true",
      "re.if()",
      "echo $obj.match()"
    ],
    "checks": [
      {
        "line": 1,
        "text": "class",
        "scopes": ["keyword.control.dol"],
        "vim": ["dolKeyword"]
      },
      {
        "line": 2,
        "text": "field",
        "scopes": ["keyword.control.dol"],
        "vim": ["dolKeyword"]
      },
      {
        "line": 3,
        "text": "try",
        "scopes": ["keyword.control.dol"],
        "vim": ["dolKeyword"]
      },
      {
        "line": 5,
        "text": "catch",
        "scopes": ["keyword.control.dol"],
        "vim": ["dolKeyword"]
      },
      {
        "line": 6,
        "text": "throw",
        "scopes": ["keyword.control.dol"],
        "vim": ["dolKeyword"]
      },
      {
        "line": 7,
        "text": "finally",
        "scopes": ["keyword.control.dol"],
        "vim": ["dolKeyword"]
      },
      {
        "line": 10,
        "text": "match",
        "scopes": ["keyword.control.conditional.dol"],
        "vim": ["dolConditional"]
      },
      {
        "line": 4,
        "text": "match",
        "notScopes": ["keyword.control"],
        "notVim": ["dolKeyword", "dolConditional"]
      },
      {
        "line": 9,
        "text": "if",
        "notScopes": ["keyword.control"],
        "notVim": ["dolKeyword", "dolConditional"]
      },
      {
        "line": 9,
        "text": "match",
        "notScopes": ["keyword.control"],
        "notVim": ["dolKeyword", "dolConditional"]
      },
      {
        "line": 9,
        "text": "class",
        "notScopes": ["keyword.control"],
        "notVim": ["dolKeyword", "dolConditional"]
      },
      {
        "line": 12,
        "text": "if",
        "notScopes": ["keyword.control"],
        "notVim": ["dolKeyword", "dolConditional"]
      },
      {
        "line": 13,
        "text": "match",
        "notScopes": ["keyword.control"],
        "notVim": ["dolKeyword", "dolConditional"]
      },
      {
        "line": 9,
        "text": "if",
        "scopes": ["meta.object-literal.key.dol"],
        "vim": ["dolKey"]
      },
      {
        "line": 9,
        "text": "match",
        "scopes": ["meta.object-literal.key.dol"],
        "vim": ["dolKey"]
      },
      {
        "line": 9,
        "text": "class",
        "scopes": ["meta.object-literal.key.dol"],
        "vim": ["dolKey"]
      }
    ]
