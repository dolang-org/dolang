  {
    "name": "quoted strings and escapes",
    "lines": [
      "let normal = \"name $name.field $(1 + 2) \\0 \\x7f \\u{1_f600} \\$ \\n\"",
      "let binary = b\"\\x00\\xff\"",
      "let formatted = t\"${value:8.2f} $#name ${#0:$(width)}\"",
      "let raw = r\"$name \\n # literal\"",
      "let hashes = r##\"quote \"# $name \\n # literal\"##",
      "echo true"
    ],
    "checks": [
      {
        "line": 1,
        "text": "name",
