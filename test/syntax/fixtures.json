        "vim": ["dolEscape"]
      },
      {
        "line": 1,
        "text": "\\x7f",
        "scopes": ["constant.character.escape.dol"],
        "vim": ["dolEscape"]
      },
      {
        "line": 1,
        "text": "\\u{1_f600}",
        "scopes": ["constant.character.escape.dol"],
        "vim": ["dolEscape"]
      },
      {
        "line": 1,
        "text": "\\$",
        "scopes": ["constant.character.escape.dol"],
        "vim": ["dolEscape"]
      },
      {
        "line": 1,
        "text": "\\n",
        "scopes": ["constant.character.escape.dol"],
        "vim": ["dolEscape"]
      },
      {
        "line": 2,
        "text": "\\x00",
        "scopes": ["constant.character.escape.dol"],
        "vim": ["dolEscape"]
      },
      {
        "line": 2,
        "text": "\\xff",
        "scopes": ["constant.character.escape.dol"],
        "vim": ["dolEscape"]
      },
      {
        "line": 3,
        "text": "8.2f",
        "scopes": ["constant.other.placeholder.dol"],
        "vim": ["dolFmtSpec"]
      },
      {
        "line": 3,
        "text": "width",
        "scopes": ["variable.other.dol"],
        "vim": ["dolIdentifier"]
      },
      {
        "line": 4,
        "text": "$name",
        "scopes": ["string.quoted.double.raw.dol"],
        "vim": ["dolRawString"],
        "notScopes": ["comment", "constant.character.escape", "variable"]
      },
      {
        "line": 4,
        "text": "\\n",
        "scopes": ["string.quoted.double.raw.dol"],
        "vim": ["dolRawString"],
        "notScopes": ["comment", "constant.character.escape", "variable"]
      },
      {
        "line": 4,
        "text": "# literal",
        "scopes": ["string.quoted.double.raw.dol"],
        "vim": ["dolRawString"],
        "notScopes": ["comment", "constant.character.escape", "variable"]
      },
      {
        "line": 5,
        "text": "$name",
        "scopes": ["string.quoted.double.raw.dol"],
        "vim": ["dolRawString"],
        "notScopes": ["comment", "constant.character.escape", "variable"]
      },
      {
        "line": 5,
        "text": "\\n",
        "scopes": ["string.quoted.double.raw.dol"],
        "vim": ["dolRawString"],
        "notScopes": ["comment", "constant.character.escape", "variable"]
      },
      {
        "line": 5,
        "text": "# literal",
        "scopes": ["string.quoted.double.raw.dol"],
        "vim": ["dolRawString"],
        "notScopes": ["comment", "constant.character.escape", "variable"]
