import http
import http.mock
import std:
  - RuntimeError
  - ValueError
import test:
  - assert
  - assert_eq
  - assert_throws
  - test

#[test]
def expect_satisfied()
  http.mock.Server do |server|
    server.mock
      - method: GET
        path: /counted
        expect: 2
        respond:
          status: 200
      do |_handle|
        http.get (server.url / "/counted")
        http.get (server.url / "/counted")

#[test]
def expect_satisfied_range()
  http.mock.Server do |server|
    server.mock
      - method: GET
        path: /counted
        expect: (1..3)
        respond:
          status: 200
      do |_handle|
        http.get (server.url / "/counted")
        http.get (server.url / "/counted")

#[test]
def expect_violated()
  http.mock.Server do |server|
    let caught = try
      server.mock
        - method: GET
          path: /counted
          expect: 2
          respond:
            status: 200
        do |_handle|
          http.get (server.url / "/counted")
      false
    catch err
      assert ((str err).contains "expected")
      true
    assert $caught

#[test]
def scoped_mock_unmounts_after_block()
  http.mock.Server do |server|
    server.mock
      - method: GET
        path: /scoped
        respond:
          status: 200
      do |_handle|
        let resp = http.get (server.url / "/scoped")
        assert_eq $resp.status 200

    let after = http.get (server.url / "/scoped") status: :IGNORE:
    assert_eq $after.status 404

#[test]
def persistent_mock_survives_and_unmounts()
  http.mock.Server do |server|
    let handle = server.mock
      - method: GET
        path: /persist
        respond:
          status: 200
          body: persisted

    let resp = http.get (server.url / "/persist")
    assert_eq (resp.text()) "persisted"

    handle.unmount()
    let after = http.get (server.url / "/persist") status: :IGNORE:
    assert_eq $after.status 404

#[test]
def received_reports_request_details()
  http.mock.Server do |server|
    server.mock
      - method: POST
        path: /echo
        respond:
          status: 200
      do |handle|
        http.post (server.url / "/echo") headers: {"x-trace": "abc"} body: hello

        let requests = handle.received()
        assert_eq $requests.len 1
        let req = requests[0]
        assert_eq $req.method "POST"
        assert ((str req.url).contains "/echo")
        assert_eq $req.headers["x-trace"] "abc"
        assert_eq (str req.body) hello

#[test]
def path_regex_matches()
  http.mock.Server do |server|
    server.mock
      - path_regex: r"^/users/\d+$"
        respond:
          status: 200
      do |_handle|
        let ok = http.get (server.url / "/users/42")
        assert_eq $ok.status 200
        let bad = http.get (server.url / "/users/abc") status: :IGNORE:
        assert_eq $bad.status 404

#[test]
def path_regex_invalid_pattern_is_catchable()
  http.mock.Server do |server|
    let caught = try
      server.mock
        - path_regex: "("
          respond:
            status: 200
      false
    catch _
      true
    assert $caught

#[test]
def default_matches_any_request()
  http.mock.Server do |server|
    server.mock
      - name: catch-all
        respond:
          status: 200
      do |_handle|
        let a = http.get (server.url / "/anything")
        assert_eq $a.status 200
        let b = http.post (server.url / "/whatever")
        assert_eq $b.status 200

#[test]
def respond_callback_builds_dynamic_response()
  http.mock.Server do |server|
    server.mock
      - method: POST
        path: /echo
        respond: do |req| $
          status: 200
          body: "echo:$(str req.body)"
      do |_handle|
        let resp = http.post (server.url / "/echo") body: hello
        assert_eq (resp.text()) "echo:hello"

#[test]
def match_callback_gates_on_request()
  http.mock.Server do |server|
    server.mock
      - match: do |req|
          (req.method == "GET")
        respond:
          status: 200
          body: matched
      do |_handle|
        let ok = http.get (server.url / "/gated")
        assert_eq (ok.text()) "matched"
        let bad = http.post (server.url / "/gated") status: :IGNORE:
        assert_eq $bad.status 404

#[test]
def match_and_respond_callbacks_see_request_details()
  http.mock.Server do |server|
    server.mock
      - match: do |req|
          (req.headers["x-trace"] == "abc")
        respond: do |req| $
          status: 200
          body: (str req.headers["x-trace"])
      do |_handle|
        let resp = http.get (server.url / "/anything") headers: {"x-trace": "abc"}
        assert_eq (resp.text()) "abc"
        let miss = http.get (server.url / "/anything") status: :IGNORE:
        assert_eq $miss.status 404

#[test]
def callback_mock_unmounts_with_scope()
  http.mock.Server do |server|
    server.mock
      - match: do |_req|
          true
        respond:
          status: 200
      do |_handle|
        let resp = http.get (server.url / "/anything")
        assert_eq $resp.status 200

    let after = http.get (server.url / "/anything") status: :IGNORE:
    assert_eq $after.status 404

#[test]
def persistent_callback_mock_survives_and_unmounts()
  http.mock.Server do |server|
    let handle = server.mock
      - respond: do |_req| $
          status: 200
          body: persisted

    let resp = http.get (server.url / "/persist")
    assert_eq (resp.text()) "persisted"

    handle.unmount()
    let after = http.get (server.url / "/persist") status: :IGNORE:
    assert_eq $after.status 404

#[test]
def url_composes_absolute_and_relative_paths()
  http.mock.Server do |server|
    server.mock
      - path: /root
        respond:
          status: 200
      do |_handle|
        # Absolute-path form (leading `/`) replaces the whole path.
        let absolute = http.get (server.url / "/root")
        assert_eq $absolute.status 200
        # Relative segment form appends onto the base path, which is
        # already `/` for a fresh mock server.
        let relative = http.get (server.url / "root")
        assert_eq $relative.status 200

#[test]
def invalid_matchers_raise()
  http.mock.Server do |server|
    for item = [{method: "G T"}, {path: "/a?b=1"}, {path: "http://host/x"}]
      assert_throws $ValueError do
        server.mock {...item, respond: {status: 200}}

#[test]
def reset_unmounts_persistent_mocks()
  http.mock.Server do |server|
    let handle = server.mock
      - path: /reset
        expect: 1
        respond:
          status: 200
    http.get (server.url / "/reset")

    server.reset()
    let after = http.get (server.url / "/reset") status: :IGNORE:
    assert_eq $after.status 404
    assert_eq $handle.received() []
    let err = assert_throws $RuntimeError do
      handle.verify()
    assert ((str err).contains "mock: unmounted")
    handle.unmount()

#[test]
def reset_inside_scoped_mock()
  http.mock.Server do |server|
    server.mock
      - path: /reset
        respond:
          status: 200
      do |handle|
        server.reset()
        assert_eq $handle.received() []

    let err = assert_throws $RuntimeError do
      server.mock
        - path: /reset
          expect: 0
          name: counted
          respond:
            status: 200
        do |_handle|
          server.reset()
    assert ((str err).contains "counted: unmounted")

#[test]
def unmount_inside_scoped_mock()
  http.mock.Server do |server|
    server.mock
      - path: /unmount
        respond:
          status: 200
      do |handle|
        handle.unmount()
        let after = http.get (server.url / "/unmount") status: :IGNORE:
        assert_eq $after.status 404

#[test]
def reset_cancels_callbacks()
  http.mock.Server do |server|
    let calls = [0]
    server.mock
      - respond: do |_req|
          calls[0] = (calls[0] + 1)
          {status: 200}
    let resp = http.get (server.url / "/cb")
    assert_eq $resp.status 200

    server.reset()
    let after = http.get (server.url / "/cb") status: :IGNORE:
    assert_eq $after.status 404
    assert_eq $calls [1]

#[test]
def unmatched_large_binary_body_gets_404()
  http.mock.Server do |server|
    let body = (b"".join((0..10001).map(do |_| b"\xff")))
    let resp = http.post (server.url / "/none") :body status: :IGNORE:
    assert_eq $resp.status 404
    assert_eq (resp.text()) ""

#[test]
def respond_callback_can_call_its_own_server()
  http.mock.Server do |server|
    server.mock
      - path: /inner
        respond:
          status: 200
          body: inner
      - path: /outer
        respond: do |_req|
          let inner = http.get (server.url / "/inner")
          {status: 200, body: "outer:$(inner.text())"}
      do |_handle|
        let resp = http.get (server.url / "/outer")
        assert_eq (resp.text()) "outer:inner"

#[test]
def requests_fail_after_close()
  let server = http.mock.Server()
  let url = server.url
  let before = http.get (url / "/x") status: :IGNORE:
  assert_eq $before.status 404
  server.close()
  assert_throws $http.Error do
    http.get (url / "/x")

#[test]
def received_is_in_arrival_order()
  http.mock.Server do |server|
    server.mock
      - path: /a
        respond:
          status: 200
      - path: /b
        respond:
          status: 200
      do |handle|
        http.get (server.url / "/b")
        http.get (server.url / "/a")
        let requests = handle.received()
        assert_eq $requests.len 2
        assert ((str requests[0].url).ends_with "/b")
        assert ((str requests[1].url).ends_with "/a")
