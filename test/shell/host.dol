import sys _vfs time
  testlib.vfs:
    - vfs
  strand:
    - stream
  test:
    - assert
    - assert_eq
    - assert_throws
    - ignore
    - parametrize
    - test
  shell:
    - Vfs
    - exe
    - with_host
    - vfs_exe
  fs:
    - Path
    - open
    - with_temp_dir
  std:
    - RuntimeError

let launch_cwd = cd()
let vfs_bin = _vfs.bin()
let stdio_launchers = [[vfs_bin, "--stdio"]]
if (sys.os_info().family == :WINDOWS:)
  stdio_launchers.push [exe, "--vfs", "--stdio"]

#[test]
#[vfs]
def resets_context_to_defaults()
  # Change directory, re-enter host context
  with_temp_dir do |dir| cd $dir do with_host do
    # Should be back to original directory
    assert_eq $cd() $launch_cwd

#[test]
def windows_admin_captures_current_cwd()
  if (sys.os_info().family != :WINDOWS:)
    ignore "requires Windows"

  with_temp_dir do |dir|
    env TEST_DOLANG_WINDOWS_INHERIT: inherited TEST_DOLANG_WINDOWS_UNSET: present do
      let vfs = Vfs.windows_admin
        elevate: false
        cd: $dir
        env:
          "TEST_DOLANG_WINDOWS_STRING": 42
          TEST_DOLANG_WINDOWS_UNSET: nil
          TEST_DOLANG_WINDOWS_INHERIT: :INHERIT:
      try
        vfs.with do
          assert_eq $cd() $dir
          assert_eq $env["TEST_DOLANG_WINDOWS_STRING"] "42"
          assert_eq $env["TEST_DOLANG_WINDOWS_INHERIT"] inherited
          assert_eq $env.get("TEST_DOLANG_WINDOWS_UNSET", default: nil) nil
      finally
        time.timeout 30 do vfs.stop()

#[test]
def stdio_vfs_runs_over_strand_stream()
  with_temp_dir do |dir| cd $dir do
    let marker = (dir / "marker")
    let expected_exe = (Path vfs_bin).canonical()
    assert_eq $vfs_exe() nil
    let vfs = Vfs do run $vfs_bin --stdio
    try
      let called = false
      let block = do |..._args|
        called = true
      assert_throws $std.UnexpectedPosError do vfs.with $block 42
      assert_throws $std.UnexpectedKeyError do vfs.with $block unused: 42
      assert_eq $called false
      vfs.with do
        assert_eq $vfs_exe() $expected_exe
        assert_eq $_vfs.bin() $expected_exe
        let background = stream do vfs_exe()
        assert_eq $background.join() $expected_exe
        with_host do assert_eq $vfs_exe() nil
        open $marker w do |file| file.write "remote"
    finally
      time.timeout 30 do vfs.stop()

    open $marker r do |file| assert_eq $file.read_str() "remote"

#[test]
#[parametrize command: stdio_launchers]
def stopping_stdio_vfs_joins_launcher :command
  with_temp_dir do |dir|
    let marker = (dir / "stopped")
    let vfs = Vfs do
      run ...command
      open $marker w do |file| file.write "stopped"
    time.timeout 30 do vfs.stop()
    assert $marker.exists()

#[test]
def stdio_vfs_reports_launcher_error()
  let err = assert_throws $RuntimeError do
    Vfs do throw RuntimeError "launcher failed"
  assert_eq $str(err) "launcher failed"

#[test]
def filesystem_imports_load_on_host_and_execute_in_active_vfs()
  with_temp_dir do |dir|
    let remote = (dir / "remote")
    (dir / "lib").create_dir()
    (remote / "lib").create_dir all: true
    (dir / "lib/boot_host_probe.dol").write r|
      import fs
      pub let source = "host"
      pub let cwd = cd()
      fs.write module-marker host
    (remote / "lib/boot_host_probe.dol").write r|
      pub let source = "remote"
      pub let cwd = cd()
    let script = (dir / "main.dol")
    script.write r|
      import shell fs time
        test:
          - assert_eq
      let remote = fs.Path $shell.args[1]
      let vfs = shell.Vfs do run $shell.args[0] --stdio
      try
        vfs.with do
          cd $remote do
            env XDG_CACHE_HOME: relative XDG_DATA_HOME: relative do
              import boot_host_probe
              assert_eq $boot_host_probe.source host
              assert_eq $boot_host_probe.cwd $remote
              assert_eq (fs.read "module-marker") host
      finally
        time.timeout 30 do vfs.stop()
      assert_eq $fs.Path("module-marker").exists() false
    cd $dir do
      run $exe --module-path lib $script $vfs_bin $remote
