import load
  _shell:
    - compile
  fs:
    - with_temp_dir
  shell:
    - exe
  test:
    - assert
    - assert_eq
    - assert_throws
    - assert_type
    - test

#[test]
def compiles_a_script_to_bytecode()
  with_temp_dir do |dir|
    let script = (dir / "script.dol")
    script.write "(40 + 2)\n"

    let bytecode = compile $script
    assert_type $Bin $bytecode
    assert_eq (load.run bytecode) 42

#[test]
def compile_entrypoint_precompiles_scripts_and_modules()
  with_temp_dir do |dir|
    let script = (dir / "script.dol")
    script.write "(40 + 2)\n"
    run $exe -m compile bytecode $script
    assert_eq (load.run((dir / "script.dolc").read())) 42
    let module = (dir / "module.dol")
    module.write "pub let answer = 42\n"
    let output = (dir / "out.bytes")
    run $exe -m compile bytecode --module example -o $output $module
    let result = load.run $output.read()
    assert_eq $result.answer 42

#[test]
def runs_a_precompiled_script()
  with_temp_dir do |dir|
    let script = (dir / "script.dol")
    let output = (dir / "output.txt")
    script.write r|
      import shell
        fs:
          - Path

      (Path $shell.args[0]).write "ran"

    let compiled = (dir / "script.dolc")
    compiled.write (compile script)

    run $exe $compiled $output
    assert_eq $output.read_str() "ran"

#[test]
def explicit_source_and_modes()
  let script = compile "<script>" "(40 + 2)"
  assert_eq (load.run script) 42
  let module = compile "<module>" "pub let answer = 42" mode: example
  let result = load.run $module
  assert_eq $result.answer 42
  let turn = compile "<repl>" "let answer = 42" mode: :REPL:
  let result = load.run $turn
  assert_eq $result.answer 42
  assert_throws $std.ValueError do compile "<repl>" mode: :REPL:
  assert_throws $std.TypeError do compile "<script>" "nil" mode: 42

#[test]
def supplied_source_is_compiled_each_time()
  assert_eq (load.run(compile("<same-path>", "41"))) 41
  assert_eq (load.run(compile("<same-path>", "42"))) 42

#[test]
def prelude_and_module_name_affect_compilation()
  let first = compile "<same-prelude-path>" "value"
    prelude: {std: {Int: "value"}}
  let second = compile "<same-prelude-path>" "value"
    prelude: {std: {Str: "value"}}
  assert_eq (load.run first) $Int
  assert_eq (load.run second) $Str

  let source = "pub def f()\n  42\n"
  let one = compile "<module>" $source mode: one
  let two = compile "<module>" $source mode: two
  assert (one != two)

#[test]
def strict_compilation_rejects_warnings()
  let source = "return nil\necho unreachable\n"
  let _ = compile "<warnings>" $source strict: false
  assert_throws $std.CompileError do
    compile "<warnings>" $source strict: true
