import shell
import term
import fs:
  - open
  - with_temp_dir
import test:
  - assert
  - assert_eq
  - assert_throws
  - test
import std:
  - StateError
  - TypeError

# Writes `source` into the temp dir and returns the script path, so tests can
# name it in a `run` invocation without the here string swallowing the
# arguments that follow it.
def script dir name source
  let path = (dir / name)
  path.write $source
  path

#[test]
def handle_identity()
  assert_eq (type shell.stdin) $shell.Stdin
  assert_eq (type shell.stdout) $shell.Stdout
  assert_eq (type shell.stderr) $shell.Stderr
  # `term.Console` is the interface; the host console is a subtype of it that
  # identifies itself as `shell.Console`.
  assert (type term.console term.Console)

  # The handles are stateless views on the process's streams, so any two of the
  # same kind are interchangeable.
  assert_eq $shell.stdout $shell.stdout
  assert (shell.stdout != shell.stderr)
  assert (shell.stderr != term.console)

#[test]
def write_rejects_non_byte_values()
  assert_throws $TypeError do shell.stdout.write 42
  assert_throws $TypeError do shell.stderr.write [1, 2]
  assert_throws $TypeError do term.console.write nil

#[test]
def stdin_handle_shares_the_buffered_reader()
  # The load-bearing property: `shell.stdin` and the strand's implicit input
  # read through one buffered reader. Two readers would let the first swallow
  # everything the second was supposed to see.
  with_temp_dir do |dir|
    let src = r|
      import shell
      import fs
      import strand:
        - next
      let first = next()
      let rest = str $shell.stdin.read()
      fs.write $shell.args[0] "$first|$rest"

    let path = script $dir read.dol $src
    let out = (dir / "out.txt")
    run $shell.exe --no-cache $path $out
      stdin: (["one", "two", "three"].crimp())

    # Values written to the child's stdin contribute their own bytes and
    # nothing else, so the terminators here are the ones `crimp` put in.
    assert_eq $out.read() "one\n|two\nthree\n"

# Neither `put` nor `write` invents bytes: the value edge and the byte edge
# agree, so what reaches the stream is exactly what the script supplied.
#[test]
def put_and_write_are_both_verbatim()
  with_temp_dir do |dir|
    let src = r|
      import shell
      import strand:
        - put
      put a
      shell.stdout.write b
      shell.stdout.write "c\n"

    let path = script $dir frame.dol $src
    let out = (dir / "out.txt")
    run $shell.exe --no-cache $path stdout: $out

    assert_eq $out.read() "abc\n"

# A terminator is something the script asks for by name, and `crimp` puts the
# same bytes on every platform unless told to use the target's ending.
#[test]
def put_terminates_only_through_crimp()
  with_temp_dir do |dir|
    let src = r|
      import shell
      let out = shell.stdout.precrimp()
      out.put a
      out.put b

    let path = script $dir crimp.dol $src
    let out = (dir / "out.txt")
    run $shell.exe --no-cache $path stdout: $out

    assert_eq $out.read() "a\nb\n"

# Reading a stream and writing it back reproduces it byte for byte, whichever
# framing the reader chose and whatever line endings the data carries.
#[test]
def the_value_edge_round_trips()
  with_temp_dir do |dir|
    let src = r|
      import shell
      for value = shell.stdin
        shell.stdout.put $value

    let path = script $dir echo.dol $src
    let mixed = "unix\nwindows\r\nbare"
    let input = (dir / "in.txt")
    input.write $mixed
    let out = (dir / "out.txt")
    open $input rb do |file|
      run $shell.exe --no-cache $path stdin: $file stdout: $out
    assert_eq $out.read() $mixed

    # Chunk framing cuts the stream somewhere else and reproduces it just the
    # same, which is what makes the two interchangeable.
    let chunked = script $dir chunks.dol r|
      import shell
      for value = shell.stdin.chunks()
        shell.stdout.put $value

    let out2 = (dir / "out2.txt")
    open $input rb do |file|
      run $shell.exe --no-cache $chunked stdin: $file stdout: $out2
    assert_eq $out2.read() $mixed

#[test]
def handing_a_file_to_a_child_steals_it()
  with_temp_dir do |dir|
    let src = r|
      import shell
      for value = shell.stdin
        shell.stdout.put $value

    let path = script $dir echo.dol $src
    let input = (dir / "in.txt")
    input.write "hello"
    let out = (dir / "out.txt")

    let file = open $input rb
    run $shell.exe --no-cache $path stdin: $file stdout: $out
    assert_eq $out.read() "hello"

    # The child was given the file itself, not a view onto it. The seek
    # position lives in this process now, so two live handles would each
    # believe a cursor the other moves; the handoff closes this one rather
    # than let it read from somewhere it cannot know.
    assert_throws $StateError do
      file.read 1
    # Closing a file the handoff already took is still fine.
    file.close()

#[test]
def write_reports_bytes_not_characters()
  with_temp_dir do |dir|
    let src = r|
      import shell
      import fs
      let written = shell.stdout.write "héllo"
      fs.write $shell.args[0] (str(written))

    let path = script $dir count.dol $src
    let out = (dir / "out.txt")
    let raw = (dir / "raw.txt")
    run $shell.exe --no-cache $path $out stdout: $raw

    assert_eq $out.read() "6"
    # The bytes themselves, not just the count — and redirecting keeps the
    # child's output off the test runner's terminal.
    open $raw rb do |f|
      assert_eq (f.read()) b"h\xc3\xa9llo"

#[test]
def write_passes_binary_through_verbatim()
  with_temp_dir do |dir|
    let src = r|
      import shell
      shell.stdout.write b"\x01\x02\xff"

    let path = script $dir binary.dol $src
    let out = (dir / "out.bin")
    run $shell.exe --no-cache $path stdout: $out

    open $out rb do |f|
      assert_eq (f.read()) b"\x01\x02\xff"

#[test]
def stdout_and_stderr_handles_do_not_cross()
  with_temp_dir do |dir|
    let src = r|
      import shell
      shell.stdout.write "on-stdout\n"
      shell.stderr.write "on-stderr\n"

    let path = script $dir split.dol $src
    let out = (dir / "out.txt")
    let err = (dir / "err.txt")
    run $shell.exe --no-cache $path stdout: $out stderr: $err

    assert_eq $out.read() "on-stdout\n"
    assert_eq $err.read() "on-stderr\n"

#[test]
def stderr_can_merge_into_stdout()
  with_temp_dir do |dir|
    let src = r|
      import shell
      shell.stdout.write "on-stdout\n"
      shell.stderr.write "on-stderr\n"

    let path = script $dir merge.dol $src
    let out = (dir / "out.txt")
    run $shell.exe --no-cache $path stdout: $out stderr: :STDOUT:

    let merged = out.read()
    assert $merged.contains("on-stdout\n")
    assert $merged.contains("on-stderr\n")

#[test]
def console_write_is_verbatim_but_echo_sanitizes()
  # Sanitization belongs to `echo`, not to the console. Run in a child so the
  # escape lands in a captured file rather than on the test runner's terminal.
  with_temp_dir do |dir|
    let src = r|
      import term
      let ESC = str b"\x1b"
      term.console.write "a$ESC[31mb\n"
      term.echo "a$ESC[31mb"

    let path = script $dir console.dol $src
    let err = (dir / "err.txt")
    run $shell.exe --no-cache $path stderr: $err

    let ESC = str b"\x1b"
    assert_eq $err.read() "a$ESC[31mb\nab\n"

#[test]
def console_write_takes_pieces()
  with_temp_dir do |dir|
    let src = r|
      import term
      import shell
      import fs
      let written = term.console.write "hé" b"llo" "\n"
      fs.write $shell.args[0] (str(written))

    let path = script $dir pieces.dol $src
    let out = (dir / "out.txt")
    let err = (dir / "err.txt")
    run $shell.exe --no-cache $path $out stderr: $err

    assert_eq $out.read() "7"
    assert_eq $err.read() "héllo\n"

#[test]
def naming_shell_stderr_inherits_the_stream()
  # A grandchild given `stderr: $shell.stderr` writes to the inherited stream
  # rather than being pumped through a sink.
  with_temp_dir do |dir|
    let inner_src = r|
      import shell
      shell.stderr.write "from-grandchild\n"

    let inner = script $dir inner.dol $inner_src

    let outer_src = r|
      import shell
      run $shell.exe --no-cache $shell.args[0] stderr: $shell.stderr

    let outer = script $dir outer.dol $outer_src
    let err = (dir / "err.txt")
    run $shell.exe --no-cache $outer $inner stderr: $err

    assert_eq $err.read() "from-grandchild\n"
