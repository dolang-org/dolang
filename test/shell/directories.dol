import sys shell
  fs:
    - with_temp_dir
  test:
    - assert
    - ignore
    - test

#[test]
def startup_uses_process_directories()
  if !(sys.os_info().family == :UNIX: && sys.os_info().os != :MACOS:)
    ignore "requires XDG directories"
  with_temp_dir do |dir|
    let data = (dir / "data")
    let cache = (dir / "cache")
    let site = (data / "dolang/site")
    site.create_dir all: true
    (site / "directory_probe.dol").write "pub let value = 42\n"
    let script = (dir / "probe.dol")
    script.write r|
      import directory_probe
        test:
          - assert_eq
      assert_eq $directory_probe.value 42
    env XDG_DATA_HOME: $data XDG_CACHE_HOME: $cache do
      run $shell.exe $script
    assert_eq_count $cache 2

def assert_eq_count cache count
  import test:
    - assert_eq
  assert_eq $[...cache.glob("dolang/bytecode/*.dolc")].len $count

#[test]
def boot_options_deliver_history_and_prelude()
  with_temp_dir do |dir|
    let script = (dir / "options.dol")
    script.write r|
      import _boot_options
        test:
          - assert_eq
      assert_eq $_boot_options.history (s.args[0] == "true")
      assert_eq $_boot_options.strict true
      assert_eq [..._boot_options.prelude.pairs()] [("shell", "s")]
    run $shell.exe --strict --import shell=s $script true
    run $shell.exe --strict --no-history --import shell=s $script false
    if (sys.os_info().family == :UNIX: && sys.os_info().os != :MACOS:)
      env XDG_STATE_HOME: relative do
        run $shell.exe --no-history --strict --import shell=s $script false

#[test]
def repl_directory_errors_are_sys_errors()
  if !(sys.os_info().family == :UNIX: && sys.os_info().os != :MACOS:)
    ignore "requires XDG directories"
  let error = BinBuf()
  import proc
    test:
      - assert_eq
      - assert_throws
  env XDG_STATE_HOME: relative do
    let failure = assert_throws $proc.Error do
      run $shell.exe --no-cache stdin: [] stderr: $error mode: :CHUNK:
    assert_eq $failure.rc 1
  assert (Str(error.freeze()).contains("XDG_STATE_HOME must be an absolute path"))

#[test]
def remote_repl_keeps_history_on_the_host()
  if !(sys.os_info().family == :UNIX: && sys.os_info().os != :MACOS:)
    ignore "requires XDG directories"
  import _vfs
    test:
      - assert_eq
  with_temp_dir do |dir|
    let state = (dir / "state")
    let script = (dir / "remote-repl.dol")
    script.write r|
      import _shell load shell time
      let bytecode = _shell.resource "dolang.entrypoint" repl
      let vfs = shell.Vfs do run $shell.args[0] --stdio
      try
        vfs.with do
          env XDG_STATE_HOME: relative XDG_DATA_HOME: relative do load.run $bytecode
      finally
        time.timeout 30 do vfs.stop()
    let output = BinBuf()
    env XDG_STATE_HOME: $state do
      run $shell.exe --no-cache $script $(_vfs.bin())
        stdin: ["echo remote-repl\n"]
        stdout: $output
        stderr: :STDOUT:
        mode: :CHUNK:
    assert_eq (Str(output.freeze())) "remote-repl\n"
    assert ((state / "dolang/history").read().contains("echo remote-repl"))
