import proc
  fs:
    - with_temp_dir
  shell:
    - exe
  test:
    - assert
    - assert_eq
    - assert_throws
    - test

# Run `dolang --check` on a script in `dir`, with `dir/lib` on the module path,
# returning what it printed. Throws `proc.Error` when the check fails.
def check dir script
  let out = BinBuf()
  cd $dir do
    run $exe --module-path lib --check $script stdout: $out stderr: :STDOUT: mode: :CHUNK:
  Str $out.freeze()

# Run a failing check, returning what it printed.
def check_fails dir script
  let out = BinBuf()
  let err = assert_throws $proc.Error do
    cd $dir do
      run $exe --module-path lib --check $script stdout: $out stderr: :STDOUT: mode: :CHUNK:
  assert_eq $err.rc 1
  Str $out.freeze()

#[test]
def a_sound_script_passes()
  with_temp_dir do |dir|
    (dir / "main.dol").write r|
      import json
      let text @ Str = json.encode [1]
      echo $text
    assert_eq (check dir "main.dol") ""

#[test]
def a_type_error_fails_where_it_is()
  with_temp_dir do |dir|
    (dir / "main.dol").write r|
      import json
      let count @ Int = json.encode [1]
      echo $count
    let text = check_fails $dir main.dol
    assert (text.contains "does not fit the annotation `std.Int`")
    assert (text.contains "main.dol:2:19")

#[test]
def modules_on_the_module_path_are_checked()
  with_temp_dir do |dir|
    (dir / "lib").create_dir()
    (dir / "lib/m.dol").write r|
      pub def f x @ Str
        let y @ Int = x
        y
    (dir / "main.dol").write r|
      import m
      m.f hello
    let text = check_fails $dir main.dol
    assert (text.contains "m.dol:2:17")

#[test]
def a_module_on_the_module_path_overrides_its_typelib()
  with_temp_dir do |dir|
    (dir / "lib").create_dir()
    (dir / "lib/json.dol").write r|
      pub def encode _value -> Int
        0
    (dir / "main.dol").write r|
      import json
      let count @ Int = json.encode [1]
      echo $count
    assert_eq (check dir "main.dol") ""

#[test]
def bundled_modules_are_checked_against()
  with_temp_dir do |dir|
    (dir / "main.dol").write r|
      import args
      let error @ Int = args.Error boom
      echo $error
    let text = check_fails $dir main.dol
    assert (text.contains "`args.Error` does not fit the annotation `std.Int`")
