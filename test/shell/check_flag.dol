import proc
  fs:
    - with_temp_dir
  shell:
    - exe
  test:
    - assert
    - assert_eq
    - assert_throws
    - test

# Run `dolang --check` on a script in `dir`, with `dir/lib` on the module path,
# returning what it printed. Throws `proc.Error` when the check fails.
def check dir script
  let out = BinBuf()
  cd $dir do
    run $exe --module-path lib --check $script stdout: $out stderr: :STDOUT: mode: :CHUNK:
  Str $out.freeze()

# Run a failing check, returning what it printed.
def check_fails dir script
  let out = BinBuf()
  let err = assert_throws $proc.Error do
    cd $dir do
      run $exe --module-path lib --check $script stdout: $out stderr: :STDOUT: mode: :CHUNK:
  assert_eq $err.rc 1
  Str $out.freeze()

#[test]
def a_sound_script_passes()
  with_temp_dir do |dir|
    (dir / "main.dol").write r|
      import json
      let text @ Str = json.encode [1]
      echo $text
    assert_eq (check dir "main.dol") ""

#[test]
def a_type_error_fails_where_it_is()
  with_temp_dir do |dir|
    (dir / "main.dol").write r|
      import json
      let count @ Int = json.encode [1]
      echo $count
    let text = check_fails $dir main.dol
    assert (text.contains "does not fit the annotation `std.Int`")
    assert (text.contains "main.dol:2:19")

#[test]
def modules_on_the_module_path_are_checked()
  with_temp_dir do |dir|
    (dir / "lib").create_dir()
    (dir / "lib/m.dol").write r|
      pub def f x @ Str
        let y @ Int = x
        y
    (dir / "main.dol").write r|
      import m
      m.f hello
    let text = check_fails $dir main.dol
    assert (text.contains "m.dol:2:17")

#[test]
def a_module_on_the_module_path_overrides_its_typelib()
  with_temp_dir do |dir|
    (dir / "lib").create_dir()
    (dir / "lib/json.dol").write r|
      pub def encode _value -> Int
        0
    (dir / "main.dol").write r|
      import json
      let count @ Int = json.encode [1]
      echo $count
    assert_eq (check dir "main.dol") ""

#[test]
def bundled_modules_are_checked_against()
  with_temp_dir do |dir|
    (dir / "main.dol").write r|
      import args
      let error @ Int = args.Error boom
      echo $error
    let text = check_fails $dir main.dol
    assert (text.contains "`args.Error` does not fit the annotation `std.Int`")

#[test]
def a_strict_script_is_warned_where_it_is_unverified()
  with_temp_dir do |dir|
    (dir / "main.dol").write r|
      # dolang: strict
      class Picker
        @def pick _self x@Int -> Int
        @def pick _self x@Str -> Str
        pub def pick _self x @ (Int | Str)
          x
      let pick = Picker().pick
      echo $pick(1)
    let text = check $dir main.dol
    assert (text.contains "the checker can't verify this")
    assert (text.contains "main.dol:7:12")
    assert (text.contains "an overloaded method as a value")

#[test]
def checking_does_not_execute_and_bytecode_is_a_noop()
  with_temp_dir do |dir|
    let script = (dir / "main.dol")
    script.write "throw std.RuntimeError must-not-execute\n"
    assert_eq (check dir "main.dol") ""
    let bytecode = (dir / "main.dolc")
    run $exe --compile $bytecode $script
    assert_eq (check dir "main.dolc") ""
    let disguised = (dir / "main.bytes")
    disguised.write $bytecode.read("b")
    assert_eq (check dir "main.bytes") ""

#[test]
def checker_wrappers_keep_distinct_output()
  with_temp_dir do |dir|
    let script = (dir / "main.dol")
    script.write r|
      # dolang: strict
      class Picker
        @def pick _self x@Int -> Int
        @def pick _self x@Str -> Str
        pub def pick _self x @ (Int | Str)
          x
      let pick = Picker().pick
      pick(1)
    let text = check $dir "main.dol"
    assert (text.contains "the checker can't verify this")
    assert (!text.contains("partial:"))
    let out = BinBuf()
    run $exe -m compile check $script stdout: $out stderr: :STDOUT: mode: :CHUNK:
    assert (Str(out.freeze()).contains("validated: 1 units, 1 diagnostics"))

#[test]
def strict_check_rejects_warnings_and_cli_prelude_is_checked()
  with_temp_dir do |dir|
    let script = (dir / "main.dol")
    script.write "let _x @ Int = stringify(1)\n"
    let out = BinBuf()
    let error = assert_throws $proc.Error do
      run $exe --import-item std.str=stringify --check $script stdout: $out stderr: :STDOUT: mode: :CHUNK:
    assert_eq $error.rc 1
    assert (Str(out.freeze()).contains("does not fit the annotation"))
    script.write "return nil\necho unreachable\n"
    let error = assert_throws $proc.Error do
      run $exe --strict --check $script stdout: (BinBuf()) stderr: :STDOUT: mode: :CHUNK:
    assert_eq $error.rc 1
