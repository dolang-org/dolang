import
  _shell
  compile
  strand
  term
  test:
    - assert
    - assert_eq
    - test

#[test]
def compile_diagnostic()
  let result = compile.compile "bad.dol" "let =\n"
  let diag = result.diagnostics().next()

  let rendered = diag.render()
  assert_eq (type rendered) $term.Text
  assert ((str rendered).contains "expected at least one item")
  assert ((str rendered).contains "bad.dol")
  assert (!(str(rendered).ends_with("\n")))

# The rendered line number has to be the line the diagnostic is actually on.
# A diagnostic on the first line renders correctly under any off-by-a-multiple
# error, so this puts one further down where a scaled number is visible.
#[test]
def compile_diagnostic_line_number()
  let source = |
    # one
    # two
    # three
    let =
  let result = compile.compile "bad.dol" $source
  let diag = result.diagnostics().next()
  # Zero-based, so the fourth line.
  assert_eq $diag.span.start.line 3

  # One-based in the rendered location, so one more than the span reports.
  assert (str(diag.render()).contains("bad.dol:4:5"))

#[test]
def error()
  let plain = try
    throw "boom"
  catch e
    _shell.render_error $e
  assert_eq (type plain) $term.Text
  assert ((str plain).contains "boom")
  assert (!(str(plain).ends_with("\n")))

#[test]
def error_explicit_backtrace()
  let color = try
    throw "boom"
  catch e
    _shell.render_error $e backtrace: (strand.error_backtrace())
  assert ((str color).contains "boom")

#[test]
def error_no_backtrace()
  let err = try
    _shell.render_error "boom"
  catch e
    e
  assert_eq (str err) "state error: no active handled exception"

#[test]
def error_bad_type()
  let type_err = try
    _shell.render_error "boom" backtrace: "bad"
  catch e
    e
  assert_eq (str type_err) "type error: expected strand.Backtrace"
