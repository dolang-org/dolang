import
  fs
  shell
  compile
  strand
  term
  test:
    - assert
    - assert_eq
    - test

#[test]
def compile_diagnostic()
  let result = compile.compile "bad.dol" "let =\n"
  let diag = result.diagnostics().next()

  let rendered = diag.render()
  assert_eq (type rendered) $term.Text
  assert ((str rendered).contains "expected at least one item")
  assert ((str rendered).contains "bad.dol")
  assert (!(str(rendered).ends_with("\n")))

# The rendered line number has to be the line the diagnostic is actually on.
# A diagnostic on the first line renders correctly under any off-by-a-multiple
# error, so this puts one further down where a scaled number is visible.
#[test]
def compile_diagnostic_line_number()
  let source = |
    # one
    # two
    # three
    let =
  let result = compile.compile "bad.dol" $source
  let diag = result.diagnostics().next()
  # Zero-based, so the fourth line.
  assert_eq $diag.span.span.start.line 3

  # One-based in the rendered location, so one more than the span reports.
  assert (str(diag.render()).contains("bad.dol:4:5"))

#[test]
def error()
  let plain = try
    throw "boom"
  catch e
    shell.render_error $e
  assert_eq (type plain) $term.Text
  assert ((str plain).contains "boom")
  assert (!(str(plain).ends_with("\n")))

#[test]
def error_explicit_backtrace()
  let color = try
    throw "boom"
  catch e
    shell.render_error $e backtrace: (strand.error_backtrace())
  assert ((str color).contains "boom")

#[test]
def error_no_backtrace()
  # Nothing is being handled, so there is no backtrace to show.
  assert_eq (str(shell.render_error("boom"))) "boom"
  let plain = try
    throw "boom"
  catch e
    shell.render_error $e backtrace: nil
  assert_eq (str plain) "boom"

#[test]
def error_bad_type()
  let type_err = try
    shell.render_error "boom" backtrace: "bad"
  catch e
    e
  assert_eq (str type_err) "type error: expected inspect.Backtrace"

#[test]
def backtrace_source_is_relative_and_unique()
  fs.with_temp_dir do |dir|
    # Match the physical cwd the child reports, including macOS temp aliases.
    let dir = dir.canonical()
    let path = (dir / "backtrace.dol")
    path.write r|
      import strand shell
      def fail n
        if (n > 0)
          fail (n - 1)
        else
          throw "boom"
      try
        fail 2
      catch err
        shell.stdout.write $(shell.render_error(err, backtrace: strand.error_backtrace()).encode())
    let output = []
    cd $dir do run $shell.exe --no-cache $path stdout: $output
    let encoded = "".join(output)
    let plain = str $term.preformat(encoded)
    assert (plain.contains "backtrace.dol:6")
    assert (!plain.contains(str(dir)))
    assert_eq (Array(plain.split("fail (n - 1)")).len - 1) 1
    assert (plain.contains "throw \"boom\"")
    assert (encoded.contains(str(b"\x1b")))
    assert_eq (str(term.text(encoded))) $plain

#[test]
def backtrace_shows_whole_span()
  fs.with_temp_dir do |dir|
    let path = (dir / "multiline.dol")
    path.write r|
      import shell
      def fail _x _y
        throw "boom"
      try
        fail
          - first
          - second
      catch err
        shell.stdout.write $(shell.render_error(err).encode())
    let output = []
    run $shell.exe --no-cache $path stdout: $output
    let plain = str $term.preformat("".join(output))
    assert (plain.contains "- first")
    assert (plain.contains "- second")

#[test]
def backtrace()
  let rendered = shell.render_backtrace $strand.backtrace()
  assert_eq (type rendered) $term.Text
  let plain = str $rendered
  assert (plain.contains "  0: ")
  assert (plain.contains "diagnostic.dol:")
  assert (plain.contains "strand.backtrace()")
  assert (!plain.ends_with("\n"))

#[test]
def backtrace_empty()
  # A strand that hasn't started has an empty backtrace.
  let pending = spawn do nil
  assert_eq (str(shell.render_backtrace(pending.backtrace()))) ""
  pending.join()

#[test]
def backtrace_bad_type()
  let type_err = try
    shell.render_backtrace "bad"
  catch e
    e
  assert_eq (str type_err) "type error: expected inspect.Backtrace"

#[test]
def backtrace_code_is_unique()
  fs.with_temp_dir do |dir|
    let path = (dir / "backtrace.dol")
    path.write r|
      import strand shell
      def rec n
        if (n > 0)
          rec (n - 1)
        else
          strand.backtrace()
      shell.stdout.write $(shell.render_backtrace(rec(2)).encode())
    let output = []
    run $shell.exe --no-cache $path stdout: $output
    let plain = str $term.preformat("".join(output))
    assert (plain.contains "backtrace.dol:4")
    assert_eq (Array(plain.split("rec (n - 1)")).len - 1) 1

#[test]
def frame()
  let first = strand.backtrace().iter().next()
  let rendered = shell.render_frame $first
  assert_eq (type rendered) $term.Text
  let plain = str $rendered
  assert (plain.contains "diagnostic.dol:")
  assert (plain.contains "strand.backtrace()")
  assert (!plain.ends_with("\n"))

  let line = str $shell.render_frame(first, code: false)
  assert (line.contains "diagnostic.dol:")
  assert (!line.contains("\n"))

#[test]
def frame_of_snapshot()
  let send recv = strand.channel()
  def waiter()
    recv.next()
  let task = spawn do waiter()
  # Let the task start and block
  let kick = spawn do nil
  kick.wait()
  let info = strand.snapshot().filter(do |info| info.strand == task).next()
  let line = str $shell.render_frame(info.backtrace.iter().next(), code: false)
  assert (line.contains "waiter")
  send.put nil
  task.join()

#[test]
def frame_bad_type()
  let type_err = try
    shell.render_frame $strand.backtrace()
  catch e
    e
  assert_eq (str type_err) "type error: expected inspect.Frame"
