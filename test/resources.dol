import _shell
  fs:
    - Path
    - with_temp_dir
  test:
    - assert_eq
    - assert_throws
    - assert_type
    - test

#[test]
def looks_up_module_bytecode()
  assert_type $Bin (_shell.resource "dolang.module" "test")

#[test]
def looks_up_typelibs()
  # A bundled library, the core stub, and an extension's stub.
  for name = ["test", "std", "json"]
    assert_type $Bin (_shell.resource "dolang.typelib" name)

#[test]
def looks_up_entrypoint_bytecode()
  assert_type $Bin (_shell.resource "dolang.entrypoint" "test")

#[test]
def guest_provisioning_source_is_complete_text()
  let source = _shell.resource dolang-shell-modules provision.dol
  assert_type $Str $source
  assert_eq $source $Path("dolang-shell-modules/resource/provision.dol").read_str()
  assert_eq (source.ends_with "\n") true
  # Provisioning writes this text directly onto the disc, preserving the
  # newline and all source bytes for the guest's released interpreter.
  with_temp_dir do |dir|
    let path = (dir / "provision.dol")
    path.write $source
    assert_eq (path.read()) (Bin source)

#[test]
def returns_nil_when_missing()
  assert_eq (_shell.resource "dolang.module" "no.such.module") nil
  assert_eq (_shell.resource "dolang.typelib" "no.such.module") nil
  assert_eq (_shell.resource "dolang.entrypoint" "no_such_entrypoint") nil
  assert_eq (_shell.resource "no.such.namespace" "test") nil

#[test]
def namespaces_select_distinct_payloads()
  let module = _shell.resource dolang.module test
  let typelib = _shell.resource dolang.typelib test
  let entrypoint = _shell.resource dolang.entrypoint test
  assert_eq (module == typelib) false
  assert_eq (module == entrypoint) false
  assert_eq (typelib == entrypoint) false

#[test]
def requires_string_keys()
  assert_throws $std.TypeError do _shell.resource 42 test
  assert_throws $std.TypeError do _shell.resource dolang.module 42

#[test]
def requires_two_positional_arguments()
  assert_throws $std.MissingPosError do _shell.resource dolang.module
  assert_throws $std.UnexpectedPosError do _shell.resource dolang.module test extra
  assert_throws $std.UnexpectedKeyError do _shell.resource dolang.module test unused: true
