import fs io proc sys zip
  _shell:
    - compile
  shell:
    - exe
  test:
    - assert
    - assert_eq
    - assert_throws
    - ignore
    - test

# Writes a bundle of `members`, a dict of member names to contents, after
# `prefix`.
def make_bundle path members :prefix = b""
  fs.open $path w+ do |file|
    file.write $prefix
    zip.open (io.Cursor(file, (prefix.len..))) w do |archive|
      for name data = members
        archive.open $name do |member| member.write $data

# The standard output and standard error of a run.
def capture program *args
  let out = BinBuf()
  let err = BinBuf()
  run $program ...args stdout: $out stderr: $err mode: :CHUNK:
  (Str(out.freeze()), Str(err.freeze()))

# The standard output of running the shell.
def run_bundle *args
  let out _err = capture $exe ...args
  out

# The combined output of a run expected to fail, and its exit code.
def fail_bundle *args
  let out = BinBuf()
  let error = assert_throws $proc.Error do
    run $exe ...args stdout: $out stderr: :STDOUT: mode: :CHUNK:
  (Str(out.freeze()), error.rc)

#[test]
def runs_main_with_or_without_a_shebang()
  fs.with_temp_dir do |dir|
    let members = {"main.dol": "put \"hello \$(shell.args[0])\\n\"\n"}
    let plain = (dir / "plain")
    make_bundle $plain $members
    assert_eq (run_bundle(plain, "world")) "hello world\n"
    let shebang = (dir / "shebang")
    make_bundle $shebang $members prefix: b"#!/usr/bin/env dolang\n"
    assert_eq (run_bundle(shebang, "world")) "hello world\n"

#[test]
def runs_directly_through_its_shebang()
  if (sys.os_info().family != :UNIX:)
    ignore "requires shebang execution"
  fs.with_temp_dir do |dir|
    let app = (dir / "app")
    make_bundle $app {"main.dol": "put \"direct\\n\"\n"} prefix: (Bin "#!$exe\n")
    app.update_metadata mode: 0o755
    let out _err = capture $app
    assert_eq $out "direct\n"

#[test]
def resolves_modules_inside_the_bundle_once()
  fs.with_temp_dir do |dir|
    let app = (dir / "app")
    make_bundle $app $
      "main.dol": "import a c\nput \"\$(a.value) \$(c.value)\\n\"\n"
      "lib/a.dol": "import b\npub let value = (b.value + 1)\n"
      "lib/c.dol": "import b\npub let value = (b.value + 2)\n"
      "lib/b/mod.dol": "echo loading b\npub let value = 40\n"
    let out err = capture $exe $app
    assert_eq $out "41 42\n"
    assert_eq $err "loading b\n"

#[test]
def bundled_modules_precede_global_ones()
  fs.with_temp_dir do |dir|
    let modules = (dir / "modules")
    modules.create_dir()
    (modules / "a.dol").write "pub let value = \"global\"\n"
    (modules / "other.dol").write "pub let value = \"other\"\n"
    let app = (dir / "app")
    make_bundle $app $
      "main.dol": "import a other\nput \"\$(a.value) \$(other.value)\\n\"\n"
      "lib/a.dol": "pub let value = \"bundled\"\n"
    assert_eq (run_bundle("--module-path", str(modules), app)) "bundled other\n"

#[test]
def import_cycles_are_errors()
  fs.with_temp_dir do |dir|
    let app = (dir / "app")
    make_bundle $app $
      "main.dol": "import a\n"
      "lib/a.dol": "import b\npub let value = 1\n"
      "lib/b.dol": "import a\npub let value = 2\n"
    let output _rc = fail_bundle $app
    assert $output.contains("cycle detected importing module: a")

#[test]
def bytecode_precedes_source()
  fs.with_temp_dir do |dir|
    let app = (dir / "app")
    make_bundle $app $
      "main.dol": "put \"source main\\n\"\n"
      "main.dolc": (compile "main.dol" "import a\nput \"bytecode main \$(a.value)\\n\"\n")
      "lib/a.dol": "pub let value = \"source\"\n"
      "lib/a.dolc": (compile "a.dol" "pub let value = \"bytecode\"\n" mode: "a")
    assert_eq (run_bundle app) "bytecode main bytecode\n"

#[test]
def invalid_bytecode_falls_back_to_source()
  fs.with_temp_dir do |dir|
    let app = (dir / "app")
    make_bundle $app $
      "main.dol": "import a\nput \"\$(a.value)\\n\"\n"
      "main.dolc": b"invalid bytecode"
      "lib/a.dol": "pub let value = \"recompiled\"\n"
      "lib/a.dolc": b"invalid bytecode"
    assert_eq (run_bundle app) "recompiled\n"
    let orphan = (dir / "orphan")
    make_bundle $orphan $
      "main.dol": "import a\n"
      "lib/a.dolc": b"invalid bytecode"
    let output _rc = fail_bundle $orphan
    assert $output.contains("invalid file header")

#[test]
def runtime_bytecode_errors_do_not_fall_back()
  fs.with_temp_dir do |dir|
    let app = (dir / "app")
    let main = r|
      import load
      put "from-bytecode\n"
      load.run b"invalid bytecode"
    make_bundle $app $
      "main.dol": r|
        put "from-source\n"
      "main.dolc": (compile "main.dol" main)
    let output _rc = fail_bundle $app
    assert $output.starts_with("from-bytecode\n")
    assert (!output.contains("from-source"))

#[test]
def missing_main_is_an_error()
  fs.with_temp_dir do |dir|
    let app = (dir / "app")
    make_bundle $app {"lib/a.dol": "pub let value = 1\n"}
    let output _rc = fail_bundle $app
    assert $output.contains("main.dol")

# Builds a bundle with the `compile bundle` entrypoint, returning its output
# and exit code.
def build *args
  let out = BinBuf()
  let rc = try
    run $exe -m compile bundle ...args stdout: $out stderr: :STDOUT: mode: :CHUNK:
    0
  catch proc.Error: error
    error.rc
  (Str(out.freeze()), rc)

# Writes the sources of a program whose main module imports `c`, which
# imports `a.b`, and returns the `--module` arguments naming the modules.
def write_sources dir
  (dir / "src/a").create_dir all: true
  (dir / "src/main.dol").write "import c\nput \"\$(c.value) \$(shell.args[0])\\n\"\n"
  (dir / "src/a/b.dol").write "pub let value = 40\n"
  (dir / "src/c.dol").write "import a.b: ab\npub let value = (ab.value + 2)\n"
  ["--module", "a.b=$(dir / "src/a/b.dol")", "--module", "c=$(dir / "src/c.dol")"]

#[test]
def builds_a_bundle_that_runs()
  fs.with_temp_dir do |dir|
    let modules = write_sources $dir
    let plain = (dir / "plain")
    let main = (dir / "src/main.dol")
    assert_eq (build(main, ...modules, "-o", plain)) ("", 0)
    assert_eq (run_bundle(plain, "world")) "42 world\n"
    let names = zip.open $plain do |archive|
      Set $ archive.entries.map do |entry| str $entry.name
    assert_eq $names (Set ["main.dol", "main.dolc", "lib/a/b.dol", "lib/a/b.dolc", "lib/c.dol", "lib/c.dolc"])

    let shebang = (dir / "shebang")
    assert_eq (build(main, ...modules, "-o", shebang, "--shebang", exe)) ("", 0)
    assert $shebang.read().starts_with(Bin("#!$exe\n"))
    assert_eq (run_bundle(shebang, "world")) "42 world\n"
    if (sys.os_info().family == :UNIX:)
      let out _err = capture $shebang world
      assert_eq $out "42 world\n"

#[test]
def compile_errors_fail_the_build()
  fs.with_temp_dir do |dir|
    let modules = write_sources $dir
    (dir / "src/c.dol").write "let = 1\n"
    let app = (dir / "app")
    let _output rc = build (dir / "src/main.dol") ...modules -o $app
    assert_eq $rc 1
    assert (!app.exists())

#[test]
def bad_module_mappings_fail_the_build()
  fs.with_temp_dir do |dir|
    let main = (dir / "main.dol")
    main.write "nil\n"
    let source = str $main
    let app = (dir / "app")
    let cases = $
      - (["--module", "a..b=$source"], "invalid module name: a..b")
      - (["--module", "1a=$source"], "invalid module name: 1a")
      - (["--module", source], "expects NAME=PATH")
      - (["--module", "a=$source", "--module", "a=$source"], "more than once: a")
    for case = cases
      let mapping expected = case
      let output rc = build $main ...mapping -o $app
      assert_eq $rc 1
      assert $output.contains(expected)
    assert (!app.exists())

#[test]
def cli_options_do_not_affect_recompiled_bundles()
  fs.with_temp_dir do |dir|
    # A source that runs only with the CLI prelude, and one with a warning.
    let prelude_source = "put \"\$(stringify(42))\\n\"\n"
    let warning_source = "def f unused\n  nil\nf 1\nput \"ran\\n\"\n"
    let script = (dir / "script.dol")
    script.write $prelude_source
    assert_eq (run_bundle("--import-item", "std.str=stringify", script)) "42\n"
    script.write $warning_source
    let _output rc = fail_bundle --strict $script
    assert_eq $rc 1

    let prelude_app = (dir / "prelude")
    make_bundle $prelude_app {"main.dol": prelude_source, "main.dolc": b"invalid bytecode"}
    let output _rc = fail_bundle --import-item std.str=stringify $prelude_app
    assert $output.contains("stringify")
    let warning_app = (dir / "warning")
    make_bundle $warning_app {"main.dol": warning_source, "main.dolc": b"invalid bytecode"}
    assert_eq (run_bundle("--strict", warning_app)) "ran\n"
