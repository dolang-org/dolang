import json shell
  fs:
    - Path
  test:
    - assert
    - assert_eq
    - test

# The fixture and its golden, relative to the workspace root the suite runs in.
let FIXTURE = (Path "dolang-shell/tests/doc")

# Describe the fixture, from the directory holding it.
#
# The source is named bare so the output records `fixture.dol` rather than where
# the checkout happens to live.
def describe ...flags
  let buf = BinBuf()
  cd $FIXTURE do
    run $shell.exe -m compile extract --doc --module fixture ...flags fixture.dol stdout: $buf mode: :CHUNK:
  Str $buf.freeze()

# The whole extractor output for a source file (raw nodes/tokens/diagnostics
# plus the cooked documentation projection under "doc"), held against a
# golden. Tokens are asked for so the golden covers them too.
#
# The "doc" part is consumed by the mkdocstrings handler and its templates,
# so a change there is a change to the rendered site; set
# `DOLANG_TEST_UPDATE=1` to rewrite the golden once the new shape is what was
# intended.
#[test]
def documents_a_source_file()
  let golden = (FIXTURE / "fixture.json")
  let actual = describe "--tokens"
  if (env.get("DOLANG_TEST_UPDATE") != nil)
    golden.write $actual
    return
  assert_eq $actual $golden.read()

# The names of the entities the fixture exports, in the order reported.
def names ...flags
  let out = describe ...flags
  let entities = json.decode(out)["doc"]["entities"]
  let names = []
  for entity = entities
    names.push $entity["name"]
  names

# Private declarations are documented only when asked for.
#[test]
def private_declarations_appear_only_with_all()
  assert !(names().contains("internal"))
  assert (names("--all").contains("internal"))
  assert (names("--all").contains("secret"))

# Only syntax highlighting consumes the source's tokens, and they dwarf the
# rest of the output, so they are written only when asked for.
#[test]
def tokens_are_written_only_when_asked_for()
  assert !(json.decode(describe()).contains("tokens"))
  assert (json.decode(describe("--tokens")).contains("tokens"))
