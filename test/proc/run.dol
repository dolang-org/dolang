import proc sys sys.unix sys.windows _vfs
  testlib.vfs:
    - vfs
  test:
    - assert
    - assert_eq
    - assert_type
    - assert_throws
    - ignore
    - test
  fs:
    - Path
    - open
    - with_temp_dir
  strand:
    - pipeline
    - each
    - collect
    - spawn
  testlib.polyfill:
    - echo
    - cat
    - grep
  shell:
    - Vfs
    - exe
  std:
    - FieldError
    - CanceledError
    - null
    - RuntimeError
    - TypeError
    - ValueError
  time:
    - sleep
  proc:
    - with_policy
import proc.windows: windows
import shlex

let is_windows = (sys.os_info().family == :WINDOWS:)
let vfs_bin = _vfs.bin()

class Rendered
  pub field value = "rendered"

  def (str) self
    self.value

def yield()
  sleep 0.01

#[test]
def windows_process_arguments()
  assert_eq (windows.quote "") "\"\""
  assert_eq (windows.quote "two words") r#""two words""#
  assert_eq (windows.quote r#"a\"b"#) r#""a\\\"b""#
  assert_eq (windows.quote "C:\\path with space\\") "\"C:\\path with space\\\\\""

  let arguments = ["", "plain", "two words", "two\twords", r#"a\"b"#, "trailing\\"]
  let command_line = windows.join $arguments
  assert_eq [...(windows.split command_line)] $arguments
  let nul = str b"\x00"
  assert_throws $ValueError do windows.quote $nul
  assert_throws $ValueError do windows.join [nul]

  # Shell utilities remain POSIX-shell utilities, even when Windows argument
  # handling is available.
  assert_eq (shlex.quote "two words") "'two words'"
  assert_eq [...(shlex.split "'two words'")] ["two words"]

#[test]
#[vfs]
def termination_policy_options()
  with_policy signal: :INT: grace: 0.01 force: false do
    assert true

  if is_windows
    with_policy signal: :INT: do run cmd /c exit 0
    assert_throws $ValueError do
      run cmd /c exit 0 policy: {signal: :TERM:}
  else
    run sh -c "exit 0" policy: {signal: :INT:, grace: 0.01, force: false}
    run sh -c "exit 0" policy: {signal: 15}

  assert_throws $ValueError do
    with_policy signal: :lower: do assert true
  assert_throws $ValueError do
    with_policy signal: 15 do assert true
  assert_throws $TypeError do
    with_policy grace: 1 do assert true

  if (sys.os_info().os == :LINUX:)
    assert_throws $ValueError do
      run sh -c "exit 0" policy: {signal: :THR:}
  else if (sys.os_info().os == :MACOS: || sys.os_info().os == :FREEBSD:)
    assert_throws $ValueError do
      run sh -c "exit 0" policy: {signal: :PWR:}

#[test]
#[vfs]
def background_strand_process_groups()
  if is_windows
    ignore "Unix process-group assertion"

  with_temp_dir do |dir|
    let pid_path = (dir / "descendant.pid")
    let script = r"sleep 60 & echo $! > '__PID__'; wait"
    script = script.replace("__PID__", str(pid_path))
    let worker = spawn do pipeline
      do run sh -c $script
      do collect()

    let attempts = 0
    while (!pid_path.exists() && attempts < 200)
      sleep 0.01
      attempts = (attempts + 1)
    assert $pid_path.exists()
    let pid = pid_path.read().trim()

    worker.cancel()
    assert_throws $CanceledError do worker.join()
    # Wait for process group to exit
    while true
      try
        run sh -c "kill -0 $pid" stderr: $null
      catch proc.Error: _
        break
      sleep 0.1

#[test]
#[vfs]
def echo_sub()
  let res = sub $echo hello world
  assert_eq $res "hello world"

#[test]
#[vfs]
def cat_file()
  let path = Path "fixture.txt"
  path.write "[package]\nname = fixture\n"
  let content = sub $cat $path
  assert (content.starts_with "[package]")

#[test]
#[vfs]
def grep_file()
  let path = Path "fixture.toml"
  path.write |
    [package]
    name = fixture
    [dependencies]
    [dependencies.tokio]
    [dependencies.dolang]
    [dependencies.dolang-vfs]
  let res = [...(sub grep "\\[depend" path).split("\n").map do |x| x.trim_end "\r"]
  assert_eq $res $
    - "[dependencies]"
    - "[dependencies.tokio]"
    - "[dependencies.dolang]"
    - "[dependencies.dolang-vfs]"

#[test]
#[vfs]
def pipeline_grep()
  let path = Path "fixture.toml"
  path.write |
    [package]
    name = fixture
    [dependencies]
    [dependencies.tokio]
    [dependencies.dolang]
    [dependencies.dolang-vfs]
  let res = pipeline
    do cat $path
    do grep "\\[dependencies"
    do each do |line| line.trim_end "\r\n"
    do collect()

  assert_eq $res $
    - "[dependencies]"
    - "[dependencies.tokio]"
    - "[dependencies.dolang]"
    - "[dependencies.dolang-vfs]"

#[test]
#[vfs]
def path_selector()
  let name = if is_windows
    "cmd.exe"
  else
    "echo"
  let path = run[name].which()
  let prog = run[path]
  strand.redirect output: $null do
    if is_windows
      prog /c echo ok
      run $path /c echo ok
    else
      prog ok
      run $path ok

#[test]
#[vfs]
def program_proxies()
  let :echo ... = run
  let "clang++": clang ... = run
  let ...rest_run = run
  let constructed = proc.Program :echo:

  assert_type $proc.Program $echo
  assert_type $proc.Program $clang
  assert_type $proc.Program $run[:echo:]
  assert_type $proc.Program $constructed
  assert_type $proc.Program $rest_run[:echo:]

#[test]
#[vfs]
def pipe_deferred_recv_transition()
  let res = sub do pipeline
    do echo "foo"
    do
      yield()
      cat()
  assert_eq $res foo

#[test]
#[vfs]
def pipe_receive_side_value_flush()
  let res = sub do pipeline
    do strand.put "foo"
    do
      yield()
      cat()
  assert_eq $res foo

# A value buffered on the send side is flushed into the pipe as its own bytes
# when the channel degrades, so it lands exactly as it was put -- no separator
# appears that the script did not write.
#[test]
#[vfs]
def pipe_send_side_value_flush()
  let res = sub do pipeline
    do
      strand.put "foo\n"
      echo "foo"
    do
      yield()
      cat()
  assert_eq $res "foo\nfoo"

#[test]
#[vfs]
def formatted_values_stream_to_capture_and_pipe()
  let res = sub do strand.put (Rendered())
  assert_eq $res rendered

  res = sub do pipeline
    do strand.put (Rendered())
    do cat()
  assert_eq $res rendered

# Framing is chosen per redirect and never changes content, so what a stage
# writes is what the next stage reads back -- whichever way either one frames.
#[test]
#[vfs]
def redirect_framing_is_lossless_in_both_modes()
  # Values are written verbatim, so unterminated ones run together and the
  # single line that results is what comes back.
  let out = []
  cat stdin: ["foo", "bar"] stdout: $out
  assert_eq $out ["foobar"]

  # `crimp` on the way in is what makes them separate lines, and the
  # terminators survive into the values read back.
  out = []
  cat stdin: (["foo", "bar"].crimp()) stdout: $out
  assert_eq $out ["foo\n", "bar\n"]

  # `chomp` on the way out takes them off again, which is the line-oriented
  # idiom now spelled explicitly.
  out = []
  cat stdin: (["foo", "bar"].crimp()) stdout: (out.sink().prechomp())
  assert_eq $out ["foo", "bar"]

  # Chunk framing cuts the same stream somewhere else and loses nothing.
  out = []
  cat stdin: ["foo", "bar"] stdout: $out mode: :CHUNK:
  assert_eq (b"".join out) b"foobar"

  # A pipeline stage's `put` reaches the next stage byte for byte, so the
  # reader's framing is the only thing that decides the shape.
  let res = pipeline
    do strand.put "foo\n"
    do cat()
    do collect()
  assert_eq $res ["foo\n"]

  res = pipeline
    do strand.put "foo"
    do cat()
    do collect()
  assert_eq $res ["foo"]

  # `echo`'s terminator goes into the byte stream, so it is there to be read
  # back under either framing.
  res = pipeline
    do echo foo
    do collect()
  assert_eq $res ["foo\n"]

  res = pipeline
    do echo foo
    do [...strand.input().chunks()]
  assert_eq $res [b"foo\n"]

# Framing across a process boundary is decided independently on each side and
# neither side's choice is visible in the bytes.
#[test]
#[vfs]
def stdio_adapters_frame_without_transforming()
  let script = Path "stdio-child.dol"
  script.write r|
    import shell
    import strand

    if (shell.args[0] == "raw")
      strand.put b"first\r\nsecond\n\n"
    else if (shell.args[0] == "write")
      strand.put "pipeline-echo-result: []"
      strand.put b"BIN"
    else
      let values = if (shell.args[1] == "line")
        strand.collect()
      else
        [...strand.input().chunks()]
      if (shell.args[1] == "line")
        strand.put ("|".join $ values.iter().chomp())
      else
        strand.put (b"".join values)

  # A `Bin` value is written the same way a `Str` is: its own bytes, nothing
  # appended. The old carve-out that skipped framing for `Bin` alone is gone.
  let output = []
  run $exe $script write stdout: $output mode: :CHUNK:
  assert_eq (b"".join output) b"pipeline-echo-result: []BIN"

  # The child sees line values with their terminators intact, whatever endings
  # the data actually carries, and chomps them itself.
  output = []
  run $exe $script read line stdin: [b"first\r\nsecond\n"] stdout: $output mode: :CHUNK:
  assert_eq (b"".join output) b"first|second"

  # Chunk framing carries bytes that are not valid UTF-8 and not line-shaped.
  output = []
  run $exe $script read chunk stdin: [b"\x00\xffraw"] stdout: $output mode: :CHUNK:
  assert_eq (b"".join output) b"\x00\xffraw"

  # `sub` chomps one terminator off the whole capture by default, and `chomp:
  # false` reports the bytes exactly.
  let captured = sub do run $exe $script raw
  assert_eq $captured "first\r\nsecond\n"
  captured = sub chomp: false do run $exe $script raw
  assert_eq $captured "first\r\nsecond\n\n"

#[test]
#[vfs]
def missing_program_yields_sys_error()
  let err = assert_throws $sys.NotFoundError do
    run __dolang_missing_program__
  assert_type $sys.Error $err
  let code = err.code
  assert_type $sys.ErrorCode $code
  if is_windows
    assert_type $sys.windows.WinError $code
    assert_eq (str code) ERROR_FILE_NOT_FOUND
  else
    assert_type $sys.unix.Errno $code
    assert_eq $code.value 2
    assert_eq $code.os $sys.os_info().os
    assert_eq (str code) ENOENT

#[test]
#[vfs]
def non_zero_exit_yields_proc_error()
  let err = if is_windows
    assert_throws $proc.Error do
      run cmd /c exit 42
  else
    assert_throws $proc.Error do
      run sh -c "exit 42"
  assert_eq $err.rc 42
  if is_windows
    assert_throws $FieldError do err.signal
  else
    assert_eq $err.signal nil
  let expected = if is_windows
    "cmd exited with status: 42"
  else
    "sh exited with status: 42"
  assert_eq (str err) $expected

#[test]
#[vfs]
def signaled_process_yields_proc_error()
  if is_windows
    ignore "requires Unix"
  let err = assert_throws $proc.Error do
    run sh -c r"kill -TERM $$"
  assert_eq $err.rc nil
  assert_eq $err.signal 15
  assert_eq (str err) "sh terminated by signal: 15"

#[test]
#[vfs]
def proc_error_is_caught_by_runtime_error()
  if is_windows
    assert_throws $RuntimeError do
      run cmd /c exit 7
  else
    assert_throws $RuntimeError do
      run sh -c "exit 7"

# The tests below exercise process stdio crossing VFS domains (host/direct
# vs. one or more independent remote VFS sessions). They manage domains
# explicitly with `Vfs`, so they cannot use `#[vfs]` (which parameterizes
# a single domain per run) and instead register directly with `#[test]`.

def with_remote_vfs block
  let vfs = Vfs do run $vfs_bin --stdio
  try
    vfs.with $block
  finally
    vfs.stop()

#[test]
def numeric_signal_crosses_vfs_boundary()
  if is_windows
    ignore "Windows does not accept per-launch signals"
  run sh -c "exit 0" policy: {signal: 15}
  with_remote_vfs do
    run sh -c "exit 0" policy: {signal: 15}

#[test]
def cross_domain_pipeline_relays_between_host_and_remote_vfs()
  let res = sub do pipeline
    do echo "foo"
    do with_remote_vfs do
      yield()
      cat()
  assert_eq $res foo

#[test]
def cross_domain_pipeline_relays_between_two_remote_vfs()
  # Each session is scoped to its own stage. Pipeline stages run
  # concurrently, and a stage that loses the pipe negotiation race attaches
  # its relay to the *other* stage's child, so it can still be reading or
  # writing through this session after "its own" stage has finished. Stopping
  # the session drains those endpoints rather than severing them.
  let res = sub do pipeline
    do with_remote_vfs do echo "foo"
    do with_remote_vfs do
      yield()
      cat()
  assert_eq $res foo

#[test]
def stopping_remote_vfs_after_abandoned_pipeline()
  # Throwing from a later stage cancels the pipe request that set the pipeline
  # up, so its response comes back with nobody left to claim the stdio
  # endpoints it carries. Those endpoints hold drain slots, so if nothing
  # releases them the `stop` in `with_remote_vfs` waits on the drain forever.
  assert_throws $RuntimeError do
    with_remote_vfs do pipeline
      do run echo hi
      do throw RuntimeError "abandoned"

#[test]
def cross_domain_redirects_host_file_into_remote_process_stdin()
  with_temp_dir do |dir|
    let path = (dir / "input.txt")
    open $path w do |file| file.write "remote-input\n"

    let input = open $path r
    let res = with_remote_vfs do sub $cat stdin: $input
    assert_eq $res "remote-input"

#[test]
def cross_domain_redirects_remote_process_stdout_into_host_file()
  with_temp_dir do |dir|
    let path = (dir / "output.txt")
    open $path w do |output|
      with_remote_vfs do echo "remote-stdout" stdout: $output
    open $path r do |file| assert_eq (file.read().trim_end "\r\n") "remote-stdout"

#[test]
def cross_domain_redirects_remote_file_into_host_process_stdin()
  with_temp_dir do |dir|
    let path = (dir / "input.txt")
    path.write "remote-input\n"
    with_remote_vfs do open $path r do |input| 
      shell.with_host do
        let res = sub $cat stdin: $input
        assert_eq $res "remote-input"

#[test]
def cross_domain_redirects_host_process_stdout_into_remote_file()
  with_temp_dir do |dir|
    let path = (dir / "output.txt")
    with_remote_vfs do open $path w do |output|
      echo "remote-stdout" stdout: $output
      output.close()
    assert_eq (path.read().trim_end "\r\n") "remote-stdout"
