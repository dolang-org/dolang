import agent proc sys sys.unix sys.windows _vfs
  test:
    - assert
    - assert_eq
    - assert_type
    - assert_throws
    - skip
    - test
  fs:
    - Path
    - open
    - with_temp_dir
  strand:
    - pipeline
    - each
    - collect
    - spawn
  polyfill:
    - echo
    - cat
    - grep
  shell:
    - Vfs
    - exe
    - with_io_mode
  std:
    - FieldError
    - CanceledError
    - NULLITER
    - RuntimeError
    - TypeError
    - ValueError
  time:
    - sleep
  proc:
    - with_policy

let is_windows = (sys.os_info().family == :WINDOWS:)
let vfs_bin = _vfs.bin()

class Rendered
  pub field value = "rendered"

  def (str) self
    self.value

def yield()
  sleep 0.01

#[agent.test]
def termination_policy_options()
  with_policy signal: :INT: grace: 0.01 force: false do
    assert true

  if is_windows
    with_policy signal: :INT: do run cmd /c exit 0
    assert_throws $ValueError do
      run cmd /c exit 0 policy: {signal: :TERM:}
  else
    run sh -c "exit 0" policy: {signal: :INT:, grace: 0.01, force: false}
    run sh -c "exit 0" policy: {signal: 15}

  assert_throws $ValueError do
    with_policy signal: :lower: do assert true
  assert_throws $ValueError do
    with_policy signal: 15 do assert true
  assert_throws $TypeError do
    with_policy grace: 1 do assert true

  if (sys.os_info().os == :LINUX:)
    assert_throws $ValueError do
      run sh -c "exit 0" policy: {signal: :THR:}
  else if (sys.os_info().os == :MACOS: || sys.os_info().os == :FREEBSD:)
    assert_throws $ValueError do
      run sh -c "exit 0" policy: {signal: :PWR:}

#[agent.test]
def background_strand_process_groups()
  if is_windows
    skip "Unix process-group assertion"

  with_temp_dir do |dir|
    let pid_path = (dir / "descendant.pid")
    let script = r"sleep 60 & echo $! > '__PID__'; wait"
    script = script.replace("__PID__", str(pid_path))
    let worker = spawn do pipeline
      do run sh -c $script
      do collect()

    let attempts = 0
    while (!pid_path.exists() && attempts < 200)
      sleep 0.01
      attempts = (attempts + 1)
    assert $pid_path.exists()
    let pid = pid_path.read().trim()

    worker.cancel()
    assert_throws $CanceledError do worker.join()
    assert_throws $proc.Error do
      run sh -c "kill -0 $pid" stderr: $NULLITER

#[agent.test]
def echo_sub()
  let res = sub $echo hello world
  assert_eq $res "hello world"

#[agent.test]
def cat_file()
  let path = Path "fixture.txt"
  path.write "[package]\nname = fixture\n"
  let content = sub $cat $path
  assert (content.starts_with "[package]")

#[agent.test]
def grep_file()
  let path = Path "fixture.toml"
  path.write |
    [package]
    name = fixture
    [dependencies]
    [dependencies.tokio]
    [dependencies.dolang]
    [dependencies.dolang-vfs]
  let res = [...(sub grep "\\[depend" path).split("\n").map do |x| x.trim_end "\r"]
  assert_eq $res $
    - "[dependencies]"
    - "[dependencies.tokio]"
    - "[dependencies.dolang]"
    - "[dependencies.dolang-vfs]"

#[agent.test]
def pipeline_grep()
  let path = Path "fixture.toml"
  path.write |
    [package]
    name = fixture
    [dependencies]
    [dependencies.tokio]
    [dependencies.dolang]
    [dependencies.dolang-vfs]
  let res = pipeline
    do cat $path
    do grep "\\[dependencies"
    do each do |line| line.trim_end "\r\n"
    do collect()

  assert_eq $res $
    - "[dependencies]"
    - "[dependencies.tokio]"
    - "[dependencies.dolang]"
    - "[dependencies.dolang-vfs]"

#[agent.test]
def path_selector()
  let name = if is_windows
    "cmd.exe"
  else
    "echo"
  let path = run[name].which()
  let prog = run[path]
  strand.redirect output: $NULLITER do
    if is_windows
      prog /c echo ok
      run $path /c echo ok
    else
      prog ok
      run $path ok

#[agent.test]
def pipe_deferred_recv_transition()
  let res = sub do pipeline
    do echo "foo"
    do
      yield()
      cat()
  assert_eq $res foo

#[agent.test]
def pipe_receive_side_value_flush()
  let res = sub do pipeline
    do strand.put "foo"
    do
      yield()
      cat()
  assert_eq $res foo

#[agent.test]
def pipe_send_side_value_flush()
  let res = sub do pipeline
    do
      strand.put "foo"
      echo "foo"
    do
      yield()
      cat()
  let expected = if is_windows
    "foo\r\nfoo"
  else
    "foo\nfoo"
  assert_eq $res $expected

#[agent.test]
def formatted_values_stream_to_capture_and_pipe()
  let res = sub do strand.put (Rendered())
  assert_eq $res rendered

  res = sub do pipeline
    do strand.put (Rendered())
    do cat()
  assert_eq $res rendered

#[agent.test]
def pipeline_and_with_io_mode_use_matching_encodings()
  let out = []
  with_io_mode :LINE: do cat stdin: ["foo", "bar"] stdout: $out
  assert_eq $out ["foo", "bar"]

  out = []
  sub do with_io_mode :CHUNK: do cat stdin: ["foo", "bar"] stdout: $out
  assert_eq (b"".join out) b"foobar"

  let res = pipeline
    do with_io_mode :LINE: do strand.put "foo"
    do cat()
    do with_io_mode :CHUNK: do collect()
  let expected = if is_windows
    [b"foo\r\n"]
  else
    [b"foo\n"]
  assert_eq $res $expected

  let res = pipeline
    do with_io_mode :CHUNK: do strand.put "foo"
    do cat()
    do with_io_mode :CHUNK: do collect()
  assert_eq $res [b"foo"]

  let res = pipeline
    do echo foo
    do with_io_mode :LINE: do collect()
  assert_eq $res ["foo"]

  let res = pipeline
    do echo foo
    do with_io_mode :CHUNK: do collect()
  assert_eq $res [b"foo\n"]

#[agent.test]
def stdio_adapters_honor_io_mode()
  let script = Path "stdio-child.dol"
  script.write r|
    import shell
    import strand

    if (shell.args[0] == "raw")
      shell.with_io_mode :CHUNK: do strand.put b"first\r\nsecond\n\n"
    else if (shell.args[0] == "write")
      if (shell.args[1] == "line")
        shell.with_io_mode :LINE: do
          strand.put "pipeline-echo-result: []"
          strand.put b"BIN"
      else
        shell.with_io_mode :CHUNK: do
          strand.put "pipeline-echo-result: []"
          strand.put b"BIN"
    else
      let values = if (shell.args[1] == "line")
        shell.with_io_mode :LINE: do strand.collect()
      else
        shell.with_io_mode :CHUNK: do strand.collect()
      shell.with_io_mode :CHUNK: do
        if (shell.args[1] == "line")
          strand.put ("|".join values)
        else
          strand.put (b"".join values)

  let output = []
  with_io_mode :CHUNK: do run $exe $script write line stdout: $output
  let expected = if is_windows
    b"pipeline-echo-result: []\r\nBIN"
  else
    b"pipeline-echo-result: []\nBIN"
  assert_eq (b"".join output) $expected

  output = []
  with_io_mode :CHUNK: do run $exe $script write chunk stdout: $output
  assert_eq (b"".join output) b"pipeline-echo-result: []BIN"

  output = []
  with_io_mode :CHUNK: do
    run $exe $script read line stdin: [b"first\r\nsecond\n"] stdout: $output
  assert_eq (b"".join output) b"first|second"

  output = []
  with_io_mode :CHUNK: do
    run $exe $script read chunk stdin: [b"\x00\xffraw"] stdout: $output
  assert_eq (b"".join output) b"\x00\xffraw"

  let captured = sub do run $exe $script raw
  assert_eq $captured "first\r\nsecond\n"
  captured = sub trim: false do run $exe $script raw
  assert_eq $captured "first\r\nsecond\n\n"

#[agent.test]
def missing_program_yields_sys_error()
  let err = assert_throws $sys.NotFoundError do
    run __dolang_missing_program__
  assert_type $sys.Error $err
  let code = err.code
  assert_type $sys.ErrorCode $code
  if is_windows
    assert_type $sys.windows.WinError $code
    assert_eq (str code) ERROR_FILE_NOT_FOUND
  else
    assert_type $sys.unix.Errno $code
    assert_eq $code.value 2
    assert_eq $code.os $sys.os_info().os
    assert_eq (str code) ENOENT

#[agent.test]
def non_zero_exit_yields_proc_error()
  let err = if is_windows
    assert_throws $proc.Error do
      run cmd /c exit 42
  else
    assert_throws $proc.Error do
      run sh -c "exit 42"
  assert_eq $err.rc 42
  if is_windows
    assert_throws $FieldError do err.signal
  else
    assert_eq $err.signal nil
  let expected = if is_windows
    "cmd exited with status: 42"
  else
    "sh exited with status: 42"
  assert_eq (str err) $expected

#[agent.test]
def signaled_process_yields_proc_error()
  if is_windows
    skip "requires Unix"
  let err = assert_throws $proc.Error do
    run sh -c r"kill -TERM $$"
  assert_eq $err.rc nil
  assert_eq $err.signal 15
  assert_eq (str err) "sh terminated by signal: 15"

#[agent.test]
def proc_error_is_caught_by_runtime_error()
  if is_windows
    assert_throws $RuntimeError do
      run cmd /c exit 7
  else
    assert_throws $RuntimeError do
      run sh -c "exit 7"

# The tests below exercise process stdio crossing VFS domains (host/direct
# vs. one or more independent remote VFS sessions). They manage domains
# explicitly with `Vfs`, so they cannot be `agent.test` (which parameterizes
# a single domain per run) and instead register directly with `test`.

def with_remote_vfs block
  let vfs = Vfs do run $vfs_bin --stdio
  try
    vfs.with $block
  finally
    vfs.stop()

#[test]
def numeric_signal_crosses_vfs_boundary()
  if is_windows
    skip "Windows does not accept per-launch signals"
  run sh -c "exit 0" policy: {signal: 15}
  with_remote_vfs do
    run sh -c "exit 0" policy: {signal: 15}

#[test]
def cross_domain_pipeline_relays_between_host_and_remote_vfs()
  let res = sub do pipeline
    do echo "foo"
    do with_remote_vfs do
      yield()
      cat()
  assert_eq $res foo

#[test]
def cross_domain_pipeline_relays_between_two_remote_vfs()
  # Each session is scoped to its own stage. Pipeline stages run
  # concurrently, and a stage that loses the pipe negotiation race attaches
  # its relay to the *other* stage's child, so it can still be reading or
  # writing through this session after "its own" stage has finished. Stopping
  # the session drains those endpoints rather than severing them.
  let res = sub do pipeline
    do with_remote_vfs do echo "foo"
    do with_remote_vfs do
      yield()
      cat()
  assert_eq $res foo

#[test]
def cross_domain_redirects_host_file_into_remote_process_stdin()
  with_temp_dir do |dir|
    let path = (dir / "input.txt")
    open $path w do |file| file.write "remote-input\n"

    let input = open $path r
    let res = with_remote_vfs do sub $cat stdin: $input
    assert_eq $res "remote-input"

#[test]
def cross_domain_redirects_remote_process_stdout_into_host_file()
  with_temp_dir do |dir|
    let path = (dir / "output.txt")
    open $path w do |output|
      with_remote_vfs do echo "remote-stdout" stdout: $output
    open $path r do |file| assert_eq (file.read().trim_end "\r\n") "remote-stdout"

#[test]
def cross_domain_redirects_remote_file_into_host_process_stdin()
  with_temp_dir do |dir|
    let path = (dir / "input.txt")
    path.write "remote-input\n"
    with_remote_vfs do open $path r do |input| 
      shell.with_host do
        let res = sub $cat stdin: $input
        assert_eq $res "remote-input"

#[test]
def cross_domain_redirects_host_process_stdout_into_remote_file()
  with_temp_dir do |dir|
    let path = (dir / "output.txt")
    with_remote_vfs do open $path w do |output|
      echo "remote-stdout" stdout: $output
      output.close()
    assert_eq (path.read().trim_end "\r\n") "remote-stdout"
