import zip
  testlib.vfs:
    - vfs
  test:
    - assert_eq
    - assert_throws
    - assert_type
    - test
  std:
    - ConcurrencyError
    - TypeError
    - ValueError

#[test]
#[vfs]
def write_read()
  zip.open "test.zip" "w" do |archive|
    assert_type $zip.Archive $archive
    archive.open "hello.txt" mode: 0o640 do |file|
      assert_type $zip.File $file
      file.write "Hello, World!"

    archive.open "test.txt" do |file|
      file.write "Test content"

    archive.create_dir "subdir" mode: 0o750
    archive.symlink "hello.txt" "link.txt" mode: 0o777

  zip.open "test.zip" do |archive|
    let entries = [...archive.entries]
    assert_eq $entries.len 4
    assert_eq (str entries[0].name) "hello.txt"
    assert_eq (str entries[1].name) "test.txt"
    assert_eq (str entries[2].name) "subdir/"
    assert_eq (str entries[3].name) "link.txt"

    let hello = entries[0]
    assert_type $zip.Entry $hello
    assert_eq $hello.size 13
    assert_eq $hello.mode 0o100640
    assert_eq $hello.type :FILE:
    hello.open do |file|
      let data = file.read 1024
      assert_eq (str data) "Hello, World!"

    archive.open "test.txt" do |file|
      let data = file.read 1024
      assert_eq (str data) "Test content"

    let subdir = entries[2]
    assert_eq $subdir.mode 0o040750
    assert_eq $subdir.type :DIR:
    assert_eq $subdir.size 0

    let link = entries[3]
    assert_eq $link.mode 0o120777
    assert_eq $link.type :SYMLINK:
    link.open do |file|
      let target = file.read 1024
      assert_eq (str target) "hello.txt"

#[test]
#[vfs]
def nested_file_is_rejected()
  zip.open "nested.zip" "w" do |archive|
    archive.open "first.txt" do |_|
      assert_throws $ConcurrencyError do
        archive.open "second.txt" do |_| nil
      assert_throws $ConcurrencyError do archive.close()

    let stale = archive.open "stale.txt"
    stale.close()
    let current = archive.open "current.txt"
    stale.close()
    assert_throws $ConcurrencyError do
      archive.open "third.txt" do |_| nil
    current.close()

  zip.open "nested.zip" do |archive|
    let entries = [...archive.entries]
    entries[0].open do |_|
      assert_throws $ConcurrencyError do
        entries[1].open do |_| nil
      assert_throws $ConcurrencyError do
        archive.open (str entries[1].name) do |_| nil

#[test]
#[vfs]
def stored_compression()
  zip.open "stored.zip" "w" do |archive|
    archive.open "stored.txt" compression: :STORED: do |file|
      file.write "Hello, World!"
    archive.open "deflated.txt" compression: :DEFLATE: do |file|
      file.write "Hello, World!"
    archive.open "default.txt" do |file|
      file.write "Hello, World!"

  zip.open "stored.zip" do |archive|
    let entries = [...archive.entries]
    assert_eq $entries[0].compression :STORED:
    assert_eq $entries[0].compressed_size 13
    assert_eq $entries[1].compression :DEFLATE:
    assert_eq $entries[2].compression :DEFLATE:
    for entry = entries
      entry.open do |file|
        assert_eq (str (file.read 1024)) "Hello, World!"

#[test]
#[vfs]
def read_transfers_the_whole_count()
  let data = ("abcdefghij".repeat 200000)
  zip.open "large.zip" "w" do |archive|
    archive.open "large.bin" do |file|
      file.write $data

  zip.open "large.zip" do |archive|
    archive.open "large.bin" do |file|
      let whole = file.read $data.len
      assert_eq $whole.len $data.len
      assert_eq (str whole) $data

#[test]
#[vfs]
def invalid_compression_is_rejected()
  zip.open "invalid.zip" "w" do |archive|
    assert_throws $ValueError do
      archive.open "bogus.txt" compression: :BOGUS: do |_| nil

# `size:` reserves the ZIP64 size fields in the local file header. Without the
# reservation an entry over 4 GiB cannot be written at all, since the seekable
# writer patches the header in place on close and cannot grow it. Passing a
# reserving hint for a tiny entry exercises that path — reserve, then patch
# back a size that fits — without writing 4 GiB.
#[test]
#[vfs]
def zip64_size_hint()
  let hint = (5 * 1024 * 1024 * 1024)
  zip.open "zip64.zip" "w" do |archive|
    archive.open "big.bin" compression: :STORED: size: $hint do |file|
      file.write "Hello, World!"

  zip.open "zip64.zip" do |archive|
    let entries = [...archive.entries]
    assert_eq $entries.len 1
    assert_eq $entries[0].size 13
    entries[0].open do |file|
      assert_eq (str (file.read 1024)) "Hello, World!"

#[test]
#[vfs]
def write_options_are_rejected_in_read_mode()
  zip.open "options.zip" "w" do |archive|
    archive.open "hello.txt" do |file|
      file.write "Hello, World!"

  zip.open "options.zip" do |archive|
    assert_throws $TypeError do
      archive.open "hello.txt" size: 13 do |_| nil
    assert_throws $TypeError do
      archive.open "hello.txt" compression: :STORED: do |_| nil
