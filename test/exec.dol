import compile exec fs shell strand std
  std:
    - TypeError
    - CompileError
  test:
    - assert
    - assert_eq
    - assert_throws
    - assert_type
    - test
  time:
    - DateTime

#[test]
def module_defaults_app_from_program_module_name()
  fs.with_temp_dir do |dir|
    let mod_path = (dir / "demo_mod.dol")
    mod_path.write "pub let answer = 42\npub def get()\n  return answer\n"
    let m = exec.module $mod_path
    assert_type $std.Module $m
    assert_eq $m.answer 42
    assert_eq $m.get() 42

#[test]
def run_injects_globals()
  fs.with_temp_dir do |dir|
    let script = (dir / "script.dol")
    script.write "answer\n"
    assert_eq (exec.run script inject: {answer: 41}) 41

#[test]
def module_injects_globals_during_init()
  fs.with_temp_dir do |dir|
    let mod_path = (dir / "demo_mod.dol")
    mod_path.write "pub let answer = answer\n"
    let m = exec.module $mod_path inject: {answer: 42}
    assert_eq $m.answer 42

#[test]
def run_injects_imports()
  fs.with_temp_dir do |dir|
    let script = (dir / "script.dol")
    script.write |
      import config
      config.answer
    assert_eq (exec.run script import: {"config": {answer: 42}}) 42

#[test]
def run_injects_import_items()
  fs.with_temp_dir do |dir|
    let script = (dir / "script.dol")
    script.write |
      import config:
        - answer
      answer
    assert_eq (exec.run script import: {config: {answer: 42}}) 42

#[test]
def run_merges_dict_prelude_with_inject()
  fs.with_temp_dir do |dir|
    let script = (dir / "script.dol")
    script.write r|
      assert_eq $answer 41
      answer
    assert_eq (
      exec.run script
        prelude: {test: [:assert_eq:]}
        inject: {answer: 41}
    ) 41

#[test]
def run_rejects_non_dict_inject()
  fs.with_temp_dir do |dir|
    let script = (dir / "script.dol")
    script.write "0\n"
    let ok = try
      exec.run $script inject: 1
      false
    catch TypeError: err
      assert_eq (str err) "type error: inject: expected `Dict`"
      true
    assert $ok

#[test]
def run_rejects_non_dict_import()
  fs.with_temp_dir do |dir|
    let script = (dir / "script.dol")
    script.write "0\n"
    let ok = try
      exec.run $script import: 1
      false
    catch TypeError: err
      assert_eq (str err) "type error: import: expected `Dict`"
      true
    assert $ok

#[test]
def run_rejects_non_symbol_inject_key()
  fs.with_temp_dir do |dir|
    let script = (dir / "script.dol")
    script.write "0\n"
    let ok = try
      exec.run $script inject: {"answer": 1}
      false
    catch TypeError: err
      assert_eq (str err) "type error: inject key: expected `Sym`"
      true
    assert $ok

#[test]
def run_overrides_invocation()
  fs.with_temp_dir do |dir|
    let script = (dir / "script.dol")
    script.write |
      import shell
      [[...shell.args], shell.program]
    let caller_args = [...shell.args]
    assert_eq (exec.run script args: ["-v", "x"] program: "tool") [["-v", "x"], "tool"]
    assert_eq (exec.run script args: []) [[], shell.program]
    assert_eq (exec.run script program: script) [caller_args, script]
    assert_eq [...shell.args] $caller_args

#[test]
def module_overrides_invocation_during_init()
  fs.with_temp_dir do |dir|
    let mod_path = (dir / "demo_mod.dol")
    mod_path.write |
      import shell
      pub let args = [...shell.args]
      pub let program = shell.program
    let m = exec.module $mod_path args: ["a"] program: demo
    assert_eq $m.args ["a"]
    assert_eq $m.program demo

#[test]
def run_keeps_caller_cache_scope()
  fs.with_temp_dir do |dir|
    let script = (dir / "script.dol")
    script.write "0\n"
    let probe = "exec-program-override-probe"
    exec.run $script program: $probe
    assert (!(fs.cache_dir() / probe).exists())

# A private cache scope, removed along with the temporary source files.
def with_channel_source block
  fs.with_temp_dir do |dir|
    let app = "exec-channels-$(dir.name)"
    let cache = (fs.cache_dir() / app)
    try
      block $dir $app (cache / "bytecode")
    finally
      if cache.exists()
        cache.remove all: true

# Invalid source with an old timestamp proves that the second run uses bytecode.
# Restoring the source and corrupting that bytecode exercises recompilation.
def channel_cache_phases path cache source run
  path.write $source
  path.update_metadata modified: $DateTime.from_unix(1)
  run()
  let files = [...cache.glob("*.dolc")]
  assert_eq $files.len 1
  path.write "let =\n"
  path.update_metadata modified: $DateTime.from_unix(1)
  run()
  path.write $source
  path.update_metadata modified: $DateTime.from_unix(1)
  files[0].write b"invalid bytecode"
  run()

def check_module_channels fail
  with_channel_source do |dir app cache|
    let path = (dir / "module.dol")
    let source = r|
      import strand std
      pub let seen = [...strand.input()]
      strand.put module_output
      pub def forward()
        strand.put $strand.input().next()
    if fail
      source = "$(source)throw std.TypeError(\"module failed\")\n"
    channel_cache_phases $path $cache $source do
      let output = []
      strand.pipeline input: [11, 12] output: $output
        do
          let input = strand.input()
          let sink = strand.output()
          if fail
            assert_throws $TypeError do exec.module $path :app
          else
            let module = exec.module $path :app
            assert_eq $module.seen []
            module.forward()
          assert_eq (strand.input()) $input
          assert_eq (strand.output()) $sink
          if fail
            strand.put $input.next()
          strand.put $input.next()
      assert_eq $output [11, 12]

#[test]
def module_isolates_channels()
  check_module_channels false

#[test]
def module_error_restores_channels()
  check_module_channels true

#[test]
def run_passes_channels_through()
  with_channel_source do |dir app cache|
    let path = (dir / "script.dol")
    let source = r|
      import strand
      strand.put $strand.input().next()
      import std
      strand.put $strand.input().next()
    channel_cache_phases $path $cache $source do
      let output = []
      strand.pipeline input: [1, 2] output: $output
        do exec.run $path :app
      assert_eq $output [1, 2]

#[test]
def module_rejects_top_level_return()
  with_channel_source do |dir app _cache|
    let path = (dir / "module.dol")
    path.write "return 42\n"
    assert_throws $CompileError do exec.module $path :app
    assert_eq (exec.run path :app) 42

#[test]
def module_checks_cached_result()
  with_channel_source do |dir app cache|
    let path = (dir / "module.dol")
    path.write "pub let answer = 42\n"
    path.update_metadata modified: $DateTime.from_unix(1)
    assert_type $std.Module (exec.module path :app)
    let files = [...cache.glob("*.dolc")]
    assert_eq $files.len 1
    let source = r|
      import shell strand
      if ([...shell.args] != ["guard"] || shell.program != "guard-program")
        throw "invocation overrides missing"
      if ([...strand.input()] != [])
        throw "module input not isolated"
      strand.put discarded
      return 42
    files[0].write $compile.compile("cached-script.dol", source).emit()
    # Force the cache path: recompiling this source would raise CompileError.
    path.write "let =\n"
    path.update_metadata modified: $DateTime.from_unix(1)
    let caller_args = [...shell.args]
    let caller_program = shell.program
    let output = []
    strand.pipeline input: [11, 12] output: $output
      do
        let input = strand.input()
        let sink = strand.output()
        let err = assert_throws $TypeError do
          exec.module $path :app args: ["guard"] program: guard-program
        assert_eq (str err) "type error: module result: expected `Module`"
        assert_eq (strand.input()) $input
        assert_eq (strand.output()) $sink
        assert_eq [...shell.args] $caller_args
        assert_eq $shell.program $caller_program
        strand.put $input.next()
        strand.put $input.next()
    assert_eq $output [11, 12]
