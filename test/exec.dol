import exec fs shell
  std:
    - TypeError
  test:
    - assert
    - assert_eq
    - test

#[test]
def module_defaults_app_from_program_module_name()
  fs.with_temp_dir do |dir|
    let mod_path = (dir / "demo_mod.dol")
    mod_path.write "pub let answer = 42\n"
    let m = exec.module $mod_path
    assert_eq $m.answer 42

#[test]
def run_injects_globals()
  fs.with_temp_dir do |dir|
    let script = (dir / "script.dol")
    script.write "answer\n"
    assert_eq (exec.run script inject: {answer: 41}) 41

#[test]
def module_injects_globals_during_init()
  fs.with_temp_dir do |dir|
    let mod_path = (dir / "demo_mod.dol")
    mod_path.write "pub let answer = answer\n"
    let m = exec.module $mod_path inject: {answer: 42}
    assert_eq $m.answer 42

#[test]
def run_injects_imports()
  fs.with_temp_dir do |dir|
    let script = (dir / "script.dol")
    script.write |
      import config
      config.answer
    assert_eq (exec.run script import: {"config": {answer: 42}}) 42

#[test]
def run_injects_import_items()
  fs.with_temp_dir do |dir|
    let script = (dir / "script.dol")
    script.write |
      import config:
        - answer
      answer
    assert_eq (exec.run script import: {config: {answer: 42}}) 42

#[test]
def run_merges_dict_prelude_with_inject()
  fs.with_temp_dir do |dir|
    let script = (dir / "script.dol")
    script.write r|
      assert_eq $answer 41
      answer
    assert_eq (
      exec.run script
        prelude: {test: [:assert_eq:]}
        inject: {answer: 41}
    ) 41

#[test]
def run_rejects_non_dict_inject()
  fs.with_temp_dir do |dir|
    let script = (dir / "script.dol")
    script.write "0\n"
    let ok = try
      exec.run $script inject: 1
      false
    catch TypeError: err
      assert_eq (str err) "type error: inject: expected `Dict`"
      true
    assert $ok

#[test]
def run_rejects_non_dict_import()
  fs.with_temp_dir do |dir|
    let script = (dir / "script.dol")
    script.write "0\n"
    let ok = try
      exec.run $script import: 1
      false
    catch TypeError: err
      assert_eq (str err) "type error: import: expected `Dict`"
      true
    assert $ok

#[test]
def run_rejects_non_symbol_inject_key()
  fs.with_temp_dir do |dir|
    let script = (dir / "script.dol")
    script.write "0\n"
    let ok = try
      exec.run $script inject: {"answer": 1}
      false
    catch TypeError: err
      assert_eq (str err) "type error: inject key: expected `Sym`"
      true
    assert $ok

#[test]
def run_overrides_invocation()
  fs.with_temp_dir do |dir|
    let script = (dir / "script.dol")
    script.write |
      import shell
      [[...shell.args], shell.program]
    let caller_args = [...shell.args]
    assert_eq (exec.run script args: ["-v", "x"] program: "tool") [["-v", "x"], "tool"]
    assert_eq (exec.run script args: []) [[], shell.program]
    assert_eq (exec.run script program: script) [caller_args, script]
    assert_eq [...shell.args] $caller_args

#[test]
def module_overrides_invocation_during_init()
  fs.with_temp_dir do |dir|
    let mod_path = (dir / "demo_mod.dol")
    mod_path.write |
      import shell
      pub let args = [...shell.args]
      pub let program = shell.program
    let m = exec.module $mod_path args: ["a"] program: demo
    assert_eq $m.args ["a"]
    assert_eq $m.program demo

#[test]
def run_keeps_caller_cache_scope()
  fs.with_temp_dir do |dir|
    let script = (dir / "script.dol")
    script.write "0\n"
    let probe = "exec-program-override-probe"
    exec.run $script program: $probe
    assert (!(fs.cache_dir() / probe).exists())
