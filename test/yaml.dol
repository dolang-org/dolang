import
  yaml:
    - DecodeError
    - EncodeError
    - decode
    - encode
  test:
    - assert
    - assert_eq
    - assert_throws
    - test
  std:
    - @BaseArray
    - DataError
    - TypeError
    - ValueError

#[test]
def parse_scalars()
  assert_eq (decode "null") nil
  assert_eq (decode "true") true
  assert_eq (decode "42") 42
  assert_eq (decode "3.14") 3.14
  assert_eq (decode "hello") "hello"
  assert_eq (decode "\"true\"") "true"

#[test]
def parse_sequences()
  assert_eq (decode "[]") []
  assert_eq (decode "- 1\n- 2\n- 3\n") [1, 2, 3]
  assert_eq (decode "[1, [2, 3], 4]") [1, [2, 3], 4]

#[test]
def parse_mappings()
  let mixed = decode "items:\n  - name: alice\n  - name: bob\ncount: 2\n"
  assert_eq $mixed["count"] 2
  assert_eq $mixed["items"][0]["name"] "alice"
  assert_eq $mixed["items"][1]["name"] "bob"

#[test]
def parse_arbitrary_keys()
  let seq_key = decode "? [1, 2]\n: sequence key\n"
  let seq_pair = seq_key.iter().next()
  assert_eq $seq_pair[0] [1, 2]
  assert_eq $seq_pair[1] "sequence key"

#[test]
def decode_error_kind_and_position()
  let empty = assert_throws $DecodeError do
    decode ""
  assert_eq $empty.kind :DOCUMENTS:
  assert_throws $DataError do
    decode ""

  let multi = assert_throws $DecodeError do
    decode |
      ---
      1
      ---
      2
  assert_eq $multi.kind :DOCUMENTS:
  assert_eq (multi.line, multi.column) (3, 1)

  let syntax = assert_throws $DecodeError do
    decode |
      a: 1
       b: 2
  assert_eq $syntax.kind :SYNTAX:
  assert_eq (syntax.line, syntax.column) (2, 3)

  let truncated = assert_throws $DecodeError do
    decode "[1,"
  assert_eq $truncated.kind :SYNTAX:

  let tag = assert_throws $DecodeError do
    decode r"!!str x"
  assert_eq $tag.kind :UNSUPPORTED:

  let alias = assert_throws $DecodeError do
    decode "[&a 1, *a]"
  assert_eq $alias.kind :UNSUPPORTED:
  assert_eq (alias.line, alias.column) (1, 8)

  let range = assert_throws $DecodeError do
    decode |
      a:
        - 999999999999999999999999999999999999999999
  assert_eq $range.kind :RANGE:
  assert_eq (range.line, range.column) (2, 5)

  assert_eq (decode "9223372036854775808") 9223372036854775808

#[test]
def round_trip_scalars()
  assert_eq (decode $ encode nil) nil
  assert_eq (decode $ encode true) true
  assert_eq (decode $ encode 42) 42
  assert_eq (decode $ encode 9223372036854775807) 9223372036854775807
  assert_eq (decode $ encode 3.14) 3.14
  assert_eq (decode $ encode "hello") "hello"

#[test]
def round_trip_special_strings()
  assert_eq (decode $ encode "true") "true"
  assert_eq (decode $ encode "42") "42"

#[test]
def round_trip_structures()
  assert_eq (decode $ encode []) []

  let nested = {"items": [1, 2], "meta": {"key": "val"}}
  let rt = decode $ encode $nested
  assert_eq $rt["items"] [1, 2]
  assert_eq $rt["meta"]["key"] "val"

#[test]
def encode_layout()
  assert_eq (encode "true") "\"true\""
  assert_eq (encode :sym:) "sym"
  assert_eq (encode {a: [1, 2], b: {c: "x y"}, d: {}}) "a:\n  - 1\n  - 2\nb:\n  c: x y\nd: {}"
  assert_eq (encode {k: :v:, "s": "a: b"}) "k: v\ns: \"a: b\""
  assert_eq (encode [{a: 1}, []]) "- a: 1\n- []"

#[test]
def structs_as_mappings()
  assert_eq (encode $ struct name: "alice" port: 22) "name: alice\nport: 22"
  let rt = decode $ encode $ struct inner: (struct a: 1)
  assert_eq $rt["inner"]["a"] 1

  let cyclic = struct()
  cyclic.self = cyclic
  let err = assert_throws $EncodeError do
    encode $cyclic
  assert_eq $err.kind :CYCLE:
  assert_eq $err.path (:self:,)

#[test]
def serialize_error_cases()
  let overflow_err = assert_throws $EncodeError do
    encode 9223372036854775808
  assert_eq $overflow_err.kind :RANGE:
  assert_eq $overflow_err.path ()

  assert_throws $TypeError do
    encode b"\x01\x02"

  assert_throws $TypeError do
    encode $ Range 10

#[test]
def encode_error_paths()
  let big = 9223372036854775808
  let items = []
  items.push 0 {name: items}
  let cycle = assert_throws $EncodeError do
    encode {"items": items}
  assert_eq $cycle.kind :CYCLE:
  assert_eq $cycle.path ("items", 1, :name:)
  assert_throws $ValueError do
    encode $items

  let index = assert_throws $EncodeError do
    encode [1, big]
  assert_eq $index.kind :RANGE:
  assert_eq $index.path (1,)

  let key = assert_throws $EncodeError do
    encode {a: {(big): 1}}
  assert_eq $key.kind :RANGE:
  assert_eq $key.path (:a:,)

  let composite_key = (1, :a:)
  let composite = assert_throws $EncodeError do
    encode {(composite_key): [0, big]}
  assert_eq $composite.path ((1, :a:), 1)
  # The path holds the caller's own key, not an equal copy.
  assert (Value.(eq) composite.path[0] composite_key)
  assert (!Value.(eq)(composite.path[0], (1, :a:)))

  let scalars = assert_throws $EncodeError do
    encode {(nil): {(true): {(1.5): [big]}}}
  assert_eq $scalars.path (nil, true, 1.5, 0)

#[test]
def encode_array_read_view()
  let values @ Array[Array[Int]] = [[1, 2], [3]]
  let view @ BaseArray[BaseArray[Int]] = values
  assert_eq (decode $ encode view) $values
