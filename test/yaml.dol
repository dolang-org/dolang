import
  yaml:
    - decode
    - encode
  test:
    - assert
    - assert_eq
    - assert_throws
    - test
  std:
    - @BaseArray
    - RuntimeError

#[test]
def parse_scalars()
  assert_eq (decode "null") nil
  assert_eq (decode "true") true
  assert_eq (decode "42") 42
  assert_eq (decode "3.14") 3.14
  assert_eq (decode "hello") "hello"
  assert_eq (decode "\"true\"") "true"

#[test]
def parse_sequences()
  assert_eq (decode "[]") []
  assert_eq (decode "- 1\n- 2\n- 3\n") [1, 2, 3]
  assert_eq (decode "[1, [2, 3], 4]") [1, [2, 3], 4]

#[test]
def parse_mappings()
  let mixed = decode "items:\n  - name: alice\n  - name: bob\ncount: 2\n"
  assert_eq $mixed["count"] 2
  assert_eq $mixed["items"][0]["name"] "alice"
  assert_eq $mixed["items"][1]["name"] "bob"

#[test]
def parse_arbitrary_keys()
  let seq_key = decode "? [1, 2]\n: sequence key\n"
  let seq_pair = seq_key.iter().next()
  assert_eq $seq_pair[0] [1, 2]
  assert_eq $seq_pair[1] "sequence key"

#[test]
def parse_error_cases()
  let empty_err = assert_throws $RuntimeError do
    decode ""
  assert ((str empty_err).contains "no YAML document")

  let multi_err = assert_throws $RuntimeError do
    decode "---\n1\n---\n2\n"
  assert ((str multi_err).contains "single document")

  assert_eq (decode "9223372036854775808") 9223372036854775808

#[test]
def round_trip_scalars()
  assert_eq (decode $ encode nil) nil
  assert_eq (decode $ encode true) true
  assert_eq (decode $ encode 42) 42
  assert_eq (decode $ encode 9223372036854775807) 9223372036854775807
  assert_eq (decode $ encode 3.14) 3.14
  assert_eq (decode $ encode "hello") "hello"

#[test]
def round_trip_special_strings()
  assert_eq (decode $ encode "true") "true"
  assert_eq (decode $ encode "42") "42"

#[test]
def round_trip_structures()
  assert_eq (decode $ encode []) []

  let nested = {"items": [1, 2], "meta": {"key": "val"}}
  let rt = decode $ encode $nested
  assert_eq $rt["items"] [1, 2]
  assert_eq $rt["meta"]["key"] "val"

#[test]
def serialize_error_cases()
  let overflow_err = assert_throws $RuntimeError do
    encode 9223372036854775808
  assert ((str overflow_err).contains "numeric overflow")

  let bin_err = assert_throws $RuntimeError do
    encode b"\x01\x02"
  assert ((str bin_err).contains "YAML-representable")

  let type_err = assert_throws $RuntimeError do
    encode $ Range 10
  assert ((str type_err).contains "unsupported YAML type")

#[test]
def encode_array_read_view()
  let values @ Array[Array[Int]] = [[1, 2], [3]]
  let view @ BaseArray[BaseArray[Int]] = values
  assert_eq (decode $ encode view) $values
