import
  toml:
    - decode
    - encode
    - DecodeError
    - EncodeError
  test:
    - assert
    - assert_eq
    - assert_throws
    - test
  std:
    - @BaseArray
    - DataError
    - ValueError
    - TypeError

#[test]
def parse_bare_values()
  assert_eq (decode "42") 42
  assert_eq (decode "3.14") 3.14
  assert_eq (decode "true") true
  assert_eq (decode "\"hello\"") "hello"
  assert_eq (decode "[1, 2, 3]") [1, 2, 3]
  assert_eq (decode "{ a = 1, b = \"two\" }") {"a": 1, "b": "two"}


#[test]
def parse_doc()
  let doc = decode "title = \"TOML\"\n[server]\nport = 8080\nenabled = true\n"
  assert_eq $doc["title"] "TOML"
  assert_eq $doc["server"]["port"] 8080
  assert_eq $doc["server"]["enabled"] true

#[test]
def parse_arrays_of_tables()
  let users = decode "[[users]]\nname = \"alice\"\n[[users]]\nname = \"bob\"\n"
  assert_eq $users["users"][0]["name"] "alice"
  assert_eq $users["users"][1]["name"] "bob"

#[test]
def round_trip_scalar_values()
  assert_eq (decode $ encode 42) 42
  assert_eq (decode $ encode 3.14) 3.14
  assert_eq (decode $ encode true) true
  assert_eq (decode $ encode "hello") "hello"

#[test]
def round_trip_arrays_and_tuples()
  assert_eq (decode $ encode [1, 2, 3]) [1, 2, 3]
  assert_eq (decode $ encode $ Tuple([1, 2, 3])) [1, 2, 3]

#[test]
def round_trip_dicts_and_records()
  let obj = {"name": "alice", "age": 30}
  let rt_obj = decode $ encode $obj
  assert_eq $rt_obj["name"] "alice"
  assert_eq $rt_obj["age"] 30

  let rec = record enabled: true port: 8080
  let rt_rec = decode $ encode $rec
  assert_eq $rt_rec["enabled"] true
  assert_eq $rt_rec["port"] 8080

#[test]
def round_trip_structs()
  let s = struct enabled: true server: (struct port: 8080)
  let rt = decode $ encode $s
  assert_eq $rt["enabled"] true
  assert_eq $rt["server"]["port"] 8080

  let cyclic = struct()
  cyclic.self = cyclic
  let err = assert_throws $EncodeError do
    encode $cyclic
  assert_eq $err.kind :CYCLE:
  assert_eq $err.path (:self:,)

#[test]
def symbol_keys_stringify()
  let sym_dict = {}
  sym_dict[:name:] = "alice"
  let rt_sym = decode $ encode $sym_dict
  assert_eq $rt_sym["name"] "alice"

#[test]
def round_trip_nested_structures()
  let nested = $
    service:
      host: localhost
      ports:
        - 80
        - 443

  let rt_nested = decode $ encode $nested
  assert_eq $rt_nested["service"]["host"] "localhost"
  assert_eq $rt_nested["service"]["ports"] [80, 443]

#[test]
def encode_unsupported()
  let nil_err = assert_throws $TypeError do
    encode nil
  assert ((str nil_err).contains "nil values are not TOML-representable")

  let nested_nil_err = assert_throws $TypeError do
    encode {a: nil}
  assert ((str nested_nil_err).contains "nil values are not TOML-representable")

  let key_err = assert_throws $TypeError do
    encode {1: "bad"}
  assert ((str key_err).contains "TOML table keys must be Str or Sym values")

  let bin_err = assert_throws $TypeError do
    encode b"\x01\x02"
  assert ((str bin_err).contains "binary values are not TOML-representable")

  let type_err = assert_throws $TypeError do
    encode $ Range 10
  assert ((str type_err).contains "unsupported TOML type")

  let int_err = assert_throws $EncodeError do
    encode {a: 99999999999999999999}
  assert_eq $int_err.kind :RANGE:
  assert_eq $int_err.path (:a:,)

#[test]
def decode_and_encode_errors()
  let arr = []
  arr.push $arr
  let cycle_err = assert_throws $ValueError do
    encode $arr
  assert ((type cycle_err) == EncodeError)
  assert_eq $cycle_err.kind :CYCLE:
  assert_eq $cycle_err.path (0,)

  let table = {}
  table["self"] = table
  let table_err = assert_throws $EncodeError do
    encode $table
  assert_eq $table_err.kind :CYCLE:
  assert_eq $table_err.path ("self",)

  let parse_err = assert_throws $DataError do
    decode "{ a = "
  assert ((type parse_err) == DecodeError)
  assert_eq $parse_err.kind :SYNTAX:

#[test]
def decode_error_kind_and_position()
  def check src kind line column
    let err = assert_throws $DecodeError do
      decode $src
    assert_eq (err.kind, err.line, err.column) (kind, line, column)

  check "a = 1\na = 2" :SYNTAX: 2 1
  # The bare-value attempt gets further than the document attempt.
  check "[1," :SYNTAX: 1 4
  check "{a = 1" :SYNTAX: 1 7
  check "x = 1\nb = 1979-05-27" :UNSUPPORTED: 2 5
  check "07:32:00" :UNSUPPORTED: 1 1
  check "a = 1e999" :RANGE: 1 5
  check "a = 999999999999999999999999999999999999999999" :RANGE: 1 5
  # Columns count characters, not bytes.
  check r#"a = "é" b"# :SYNTAX: 1 9

#[test]
def decode_large_ints()
  assert_eq (decode "a = 9223372036854775808") {"a": 9223372036854775808}
  assert_eq (decode "0xffffffffffffffff") 18446744073709551615

#[test]
def encode_error_paths()
  def check value kind path
    let err = assert_throws $EncodeError do
      encode $value
    assert_eq (err.kind, err.path) (kind, path)

  let items = [{n: 1}]
  items.push {n: items}
  check {a: items} :CYCLE: (:a:, 1, :n:, 1)
  check {a: [{n: 1}, {n: 99999999999999999999}]} :RANGE: (:a:, 1, :n:)
  check {x: {a: 1, "a": 2}} :KEY: (:x:,)
  check {a: 1, "a": {b: 2}} :KEY: ()
  check {a: [1, {b: 1, "b": 2}]} :KEY: (:a:, 1)

#[test]
def document_layout()
  # Plain keys come before sections, whatever their order in the table.
  assert_eq (encode {t: {x: 1}, a: 1, b: [1]}) "a = 1\nb = [1]\n\n[t]\nx = 1"
  assert_eq (encode {}) ""
  assert_eq (encode {a: {}}) "[a]"
  # A table with only sections has no header of its own.
  assert_eq (encode {a: {b: {c: 1}}}) "[a.b]\nc = 1"
  assert_eq (encode {"a b": 1, "c d": {"e.f": 2}}) "\"a b\" = 1\n\n[\"c d\"]\n\"e.f\" = 2"

#[test]
def arrays_of_tables()
  let doc = encode {u: [{n: 1}, {}, {n: 2, v: {w: 3}}]}
  assert_eq $doc "[[u]]\nn = 1\n\n[[u]]\n\n[[u]]\nn = 2\n\n[u.v]\nw = 3"
  assert_eq (encode {a: [{b: [{c: 1}]}]}) "[[a]]\n\n[[a.b]]\nc = 1"
  # Empty, mixed, and nested arrays stay inline.
  assert_eq (encode {a: []}) "a = []"
  assert_eq (encode {a: [{x: 1}, 2]}) "a = [{ x = 1 }, 2]"
  assert_eq (encode {a: [[{x: 1}]]}) "a = [[{ x = 1 }]]"

#[test]
def inline_values()
  assert_eq (encode [{a: 1}, {}, {b: {c: [1, 2]}}]) "[{ a = 1 }, {}, { b = { c = [1, 2] } }]"
  assert_eq (encode((1, :two:))) "[1, \"two\"]"
  assert_eq (encode {a: Float.NAN, b: Float.INF, c: 1.0}) "a = nan\nb = inf\nc = 1.0"

#[test]
def encode_array_read_view()
  let values @ Array[Array[Int]] = [[1, 2], [3]]
  let view @ BaseArray[BaseArray[Int]] = values
  assert_eq (decode $ encode view) $values
