import compress
  fs
  sys
  zip
  io:
    - Buffered
    - Io
  strand:
    - channel
    - spawn
  testlib.memio:
    - MemIo
  testlib.vfs:
    - vfs
  test:
    - assert
    - assert_eq
    - assert_throws
    - test
  std:
    - RuntimeError
    - StateError
    - TypeError
    - ValueError

#[test]
#[vfs]
def header_then_decompress()
  compress.compress body.gz :GZIP: do |stream| stream.write "compressed body"
  let body = fs.Path("body.gz").read()
  fs.open data w do |file|
    file.write "header line\n"
    file.write $body
  fs.open data buffer: false do |file|
    let buf = Buffered $file
    assert_eq $buf.read_line() "header line\n"
    compress.decompress $buf do |stream|
      assert_eq $stream.read() b"compressed body"
    assert_throws $StateError do buf.read()

#[test]
#[vfs]
def take_flushes_writes()
  let buf = Buffered $fs.open("data", "w", buffer: false)
  buf.write "plain "
  compress.compress $buf :GZIP: do |stream| stream.write compressed
  assert_throws $StateError do buf.write more
  let buf = Buffered $fs.open("data", buffer: false)
  assert_eq $buf.read(6) b"plain "
  compress.decompress $buf do |stream|
    assert_eq $stream.read() b"compressed"

#[test]
#[vfs]
def lines()
  fs.Path("lines.txt").write "one\r\ntwo\nthree"
  let buf = Buffered $fs.open("lines.txt", buffer: false)
  assert_eq $buf.read_line() "one\r\n"
  let rest = $
    for line = buf
      - $line
  assert_eq $rest ["two\n", "three"]
  assert_eq $buf.read_line() ""
  buf.close()

  let buf = Buffered $fs.open("lines.txt", buffer: false)
  assert_eq [...buf.lines().chomp()] ["one", "two", "three"]
  buf.close()

#[test]
#[vfs]
def read_str()
  # "é" is two bytes, and "€" three.
  fs.Path("text.txt").write "aé€b"
  let buf = Buffered $fs.open("text.txt", buffer: false)
  assert_eq $buf.read_str(2) "a"
  assert_eq $buf.read_str(1) "é"
  assert_eq $buf.read_str(4) "€b"
  assert_eq $buf.read_str(4) ""
  buf.close()

  let buf = Buffered $fs.open("text.txt", buffer: false)
  assert_eq $buf.read(1) b"a"
  assert_eq $buf.read_str() "é€b"
  buf.close()

#[test]
#[vfs]
def invalid_utf8()
  fs.Path("bad.txt").write b"ok\n\xff\xfe\n"
  let buf = Buffered $fs.open("bad.txt", buffer: false)
  assert_eq $buf.read_line() "ok\n"
  assert_throws $RuntimeError do buf.read_line()
  # The bytes stay unread.
  assert_eq $buf.read() b"\xff\xfe\n"
  buf.close()

  fs.Path("split.txt").write b"a\xc3"
  let buf = Buffered $fs.open("split.txt", buffer: false)
  # The split character could still be completed, so it waits.
  assert_eq $buf.read_str(2) "a"
  assert_throws $RuntimeError do buf.read_str(2)
  assert_throws $RuntimeError do buf.read_str()
  buf.close()

#[test]
#[vfs]
def tell_and_seek()
  fs.Path("seek.txt").write "0123456789"
  let buf = Buffered $fs.open("seek.txt", buffer: false)
  assert_eq $buf.read(2) b"01"
  assert_eq $buf.tell() 2
  assert_eq $buf.seek(3) 5
  assert_eq $buf.read(1) b"5"
  assert_eq $buf.seek(start: 1) 1
  assert_eq $buf.read(2) b"12"
  assert_eq $buf.seek(end: -2) 8
  assert_eq $buf.read() b"89"
  buf.close()

#[test]
#[vfs]
def read_write_switching()
  let buf = Buffered $fs.open("rw.txt", "w+", buffer: false)
  buf.write "hello world"
  assert_eq $buf.tell() 11
  buf.seek start: 0
  assert_eq $buf.read(6) b"hello "
  buf.write WORLD
  assert_eq $buf.tell() 11
  buf.seek start: 0
  assert_eq $buf.read() b"hello WORLD"
  buf.close()
  assert_eq $fs.Path("rw.txt").read() b"hello WORLD"

#[test]
#[vfs]
def large_transfers()
  let data = BinBuf()
  for i = (0..5000)
    data.extend "line $i\n"
  let data = data.freeze()
  let buf = Buffered $fs.open("large.txt", "w", buffer: false)
  buf.write "x"
  buf.write $data
  buf.close()
  let buf = Buffered $fs.open("large.txt", buffer: false)
  assert_eq $buf.read(1) b"x"
  assert_eq $buf.read() $data
  buf.close()

#[test]
#[vfs]
def put_and_flush()
  let file = fs.open out.txt w buffer: false
  let buf = Buffered $file
  buf.put "a"
  buf.put 1
  buf.put b"b"
  assert_eq $fs.Path("out.txt").read() b""
  buf.flush()
  assert_eq $fs.Path("out.txt").read() b"a1b"
  buf.close()
  buf.close()
  assert_throws $StateError do buf.write more

#[test]
#[vfs]
def wrong_direction()
  fs.Path("ro.txt").write "data"
  let buf = Buffered $fs.open("ro.txt", buffer: false)
  assert_throws $StateError do buf.write more
  buf.close()
  let buf = Buffered $fs.open("wo.txt", "w", buffer: false)
  assert_throws $StateError do buf.read()
  buf.close()
  let buf = Buffered $fs.open("ap.txt", "a", buffer: false)
  assert_throws $StateError do buf.tell()
  buf.close()
  assert_throws $TypeError do Buffered 1

#[test]
#[vfs]
def streams_are_io()
  fs.Path("plain.txt").write "plain"
  let buf = Buffered $fs.open("plain.txt", buffer: false)
  assert (type buf Io)
  assert_eq [buf.readable, buf.writable, buf.seekable] [true, false, true]
  buf.close()
  assert_eq [buf.readable, buf.writable, buf.seekable] [false, false, false]
  compress.compress data.gz :GZIP: do |stream|
    assert (type stream Io)
    assert_eq [stream.readable, stream.writable, stream.seekable] [false, true, false]
    assert_eq (stream.write "data") 4
  compress.decompress data.gz do |stream|
    assert (type stream Io)
    assert_eq [stream.readable, stream.writable, stream.seekable] [true, false, false]
    stream.close()
    assert_eq $stream.readable false

#[test]
#[vfs]
def helpers_on_native_streams()
  fs.Path("in.txt").write "héllo\nworld\n"
  let raw = fs.open in.txt buffer: false
  assert_eq (raw.read_all()) (Bin "héllo\nworld\n")
  raw.close()
  # A line-iterating file still has chunks
  let file = fs.open in.txt
  assert_eq [...file.chunks(4)] [b"h\xc3\xa9l", b"lo\nw", b"orld", b"\n"]
  file.close()
  let file = fs.open in.txt
  assert_eq (file.read_all_str()) "héllo\nworld\n"
  file.close()
  let buf = Buffered $fs.open("in.txt", buffer: false)
  assert_eq (buf.read_all_str()) "héllo\nworld\n"
  buf.close()
  fs.Path("bad.bin").write b"\xff"
  let bad = fs.open bad.bin
  assert_throws $RuntimeError do bad.read_all_str()
  bad.close()

#[test]
#[vfs]
def copy_between_native_streams()
  fs.Path("in.txt").write "data"
  let source = fs.open in.txt buffer: false
  let dest = fs.open out.txt w buffer: false
  assert_eq (source.copy_to dest) 4
  dest.write_all "!"
  source.close()
  dest.close()
  assert_eq (fs.Path("out.txt").read_str()) "data!"
  # A compressor inherits `Io`'s sink
  compress.compress data.gz :GZIP: do |stream|
    let source = fs.open in.txt
    assert_eq (source.copy_to stream) 4
    source.close()
    stream.(put) 42
    assert (type stream Sink)
    stream.precrimp().put "!"
  compress.decompress data.gz do |stream|
    assert_eq (stream.read_all_str()) "data42!\n"

#[test]
def zip_over_do_streams()
  let archive = MemIo()
  zip.open $archive "w" do |out|
    out.open "hello.txt" do |file| file.write "Hello, World!"
  assert $archive.closed
  assert_eq (archive.data[..2]) b"PK"
  zip.open (MemIo archive.data) do |source|
    source.open "hello.txt" do |file|
      assert_eq (str (file.read())) "Hello, World!"

#[test]
def compress_over_unseekable_do_streams()
  let sink = MemIo read: false seek: false
  compress.compress $sink :GZIP: do |stream| stream.write "squeezed"
  assert $sink.closed
  let source = MemIo $sink.data write: false seek: false
  compress.decompress $source do |stream|
    assert_eq $stream.format :GZIP:
    assert_eq (stream.read_all_str()) "squeezed"

#[test]
def unreadable_do_stream_is_refused()
  assert_throws $ValueError str: "value error: source must be readable" do
    compress.decompress (MemIo read: false) do |_| nil

class FailingRead: MemIo
  pub def read _self _size @ Int -> Bin
    throw StateError("read failed")

# Each consumer raises its own error, with the exception's message
#[test]
def do_stream_exception_fails_consumer()
  assert_throws $sys.Error str: "state error: read failed" do
    compress.decompress (FailingRead()) do |stream| stream.read()
  let buf = Buffered (FailingRead())
  assert_throws $RuntimeError str: "state error: read failed" do buf.read_line()

# A stream whose reads wait until told to go on, and which reports its close.
class Waiting: MemIo
  field started go closes

  def (init) self started go closes
    MemIo.(init) $self write: false seek: false
    self.#started = started
    self.#go = go
    self.#closes = closes

  pub def read self _size @ Int -> Bin
    self.#started.put true
    self.#go.next()

  pub def close self
    self.#closes.put true

#[test]
def cancelling_consumer_cancels_do_stream()
  let started_send started = channel()
  let _go_send go = channel()
  let closes_send closes = channel()
  let stream = Waiting $started_send $go $closes_send
  let consumer = spawn do
    compress.decompress $stream do |inner| inner.read()
  started.next()
  consumer.cancel()
  # The stream is closed once its server stops
  assert_eq (closes.next()) true
