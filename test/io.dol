import compress
  fs
  sys
  sys.linux
  zip
  io:
    - Buffered
    - Concat
    - Cursor
    - Io
  strand:
    - channel
    - spawn
  testlib.memio:
    - MemIo
  testlib.vfs:
    - vfs
  test:
    - assert
    - assert_eq
    - assert_throws
    - test
  std:
    - RuntimeError
    - StateError
    - TypeError
    - ValueError

#[test]
#[vfs]
def header_then_decompress()
  compress.compress body.gz :GZIP: do |stream| stream.write "compressed body"
  let body = fs.Path("body.gz").read()
  fs.open data w do |file|
    file.write "header line\n"
    file.write $body
  fs.open data buffer: false do |file|
    let buf = Buffered $file
    assert_eq $buf.read_line() "header line\n"
    compress.decompress $buf do |stream|
      assert_eq $stream.read() b"compressed body"
    # The buffer was lent, so it is still open.
    buf.seek start: 0
    assert_eq $buf.read_line() "header line\n"

#[test]
#[vfs]
def lending_keeps_write_order()
  let buf = Buffered $fs.open("data", "w", buffer: false)
  buf.write "plain "
  compress.compress $buf :GZIP: do |stream| stream.write compressed
  buf.write " more"
  buf.close()
  let data = fs.Path("data").read()
  assert (data.starts_with b"plain ")
  assert (data.ends_with b" more")
  let buf = Buffered $fs.open("data", buffer: false)
  assert_eq $buf.read(6) b"plain "
  compress.decompress $buf do |stream|
    assert_eq $stream.read(10) b"compressed"

#[test]
#[vfs]
def write_pieces()
  let buf = Buffered $fs.open("data", "w", buffer: false)
  assert_eq (buf.write "one" b"\n" "two") 7
  buf.write_all "\n" "three"
  buf.close()
  assert_eq (fs.Path("data").read_str()) "one\ntwo\nthree"

#[test]
#[vfs]
def lines()
  fs.Path("lines.txt").write "one\r\ntwo\nthree"
  let buf = Buffered $fs.open("lines.txt", buffer: false)
  assert_eq $buf.read_line() "one\r\n"
  let rest = $
    for line = buf
      - $line
  assert_eq $rest ["two\n", "three"]
  assert_eq $buf.read_line() ""
  buf.close()

  let buf = Buffered $fs.open("lines.txt", buffer: false)
  assert_eq [...buf.lines().chomp()] ["one", "two", "three"]
  buf.close()

#[test]
#[vfs]
def read_str()
  # "é" is two bytes, and "€" three.
  fs.Path("text.txt").write "aé€b"
  let buf = Buffered $fs.open("text.txt", buffer: false)
  assert_eq $buf.read_str(2) "a"
  assert_eq $buf.read_str(1) "é"
  assert_eq $buf.read_str(4) "€b"
  assert_eq $buf.read_str(4) ""
  buf.close()

  let buf = Buffered $fs.open("text.txt", buffer: false)
  assert_eq $buf.read(1) b"a"
  assert_eq $buf.read_str() "é€b"
  buf.close()

#[test]
#[vfs]
def invalid_utf8()
  fs.Path("bad.txt").write b"ok\n\xff\xfe\n"
  let buf = Buffered $fs.open("bad.txt", buffer: false)
  assert_eq $buf.read_line() "ok\n"
  assert_throws $RuntimeError do buf.read_line()
  # The bytes stay unread.
  assert_eq $buf.read() b"\xff\xfe\n"
  buf.close()

  fs.Path("split.txt").write b"a\xc3"
  let buf = Buffered $fs.open("split.txt", buffer: false)
  # The split character could still be completed, so it waits.
  assert_eq $buf.read_str(2) "a"
  assert_throws $RuntimeError do buf.read_str(2)
  assert_throws $RuntimeError do buf.read_str()
  buf.close()

#[test]
#[vfs]
def tell_and_seek()
  fs.Path("seek.txt").write "0123456789"
  let buf = Buffered $fs.open("seek.txt", buffer: false)
  assert_eq $buf.read(2) b"01"
  assert_eq $buf.tell() 2
  assert_eq $buf.seek(3) 5
  assert_eq $buf.read(1) b"5"
  assert_eq $buf.seek(start: 1) 1
  assert_eq $buf.read(2) b"12"
  assert_eq $buf.seek(end: -2) 8
  assert_eq $buf.read() b"89"
  buf.close()

#[test]
#[vfs]
def read_write_switching()
  let buf = Buffered $fs.open("rw.txt", "w+", buffer: false)
  buf.write "hello world"
  assert_eq $buf.tell() 11
  buf.seek start: 0
  assert_eq $buf.read(6) b"hello "
  buf.write WORLD
  assert_eq $buf.tell() 11
  buf.seek start: 0
  assert_eq $buf.read() b"hello WORLD"
  buf.close()
  assert_eq $fs.Path("rw.txt").read() b"hello WORLD"

#[test]
#[vfs]
def large_transfers()
  let data = BinBuf()
  for i = (0..5000)
    data.extend "line $i\n"
  let data = data.freeze()
  let buf = Buffered $fs.open("large.txt", "w", buffer: false)
  buf.write "x"
  buf.write $data
  buf.close()
  let buf = Buffered $fs.open("large.txt", buffer: false)
  assert_eq $buf.read(1) b"x"
  assert_eq $buf.read() $data
  buf.close()

#[test]
#[vfs]
def put_and_flush()
  let file = fs.open out.txt w buffer: false
  let buf = Buffered $file
  buf.put "a"
  buf.put 1
  buf.put b"b"
  assert_eq $fs.Path("out.txt").read() b""
  buf.flush()
  assert_eq $fs.Path("out.txt").read() b"a1b"
  buf.close()
  buf.close()
  assert_throws $StateError do buf.write more

#[test]
def closing_a_buffer_leaves_its_source_open()
  let source = MemIo()
  let buf = Buffered $source
  buf.write data
  buf.close()
  assert_eq $source.data b"data"
  assert_eq $source.closed false

#[test]
#[vfs]
def wrong_direction()
  fs.Path("ro.txt").write "data"
  let buf = Buffered $fs.open("ro.txt", buffer: false)
  assert_throws $StateError do buf.write more
  buf.close()
  let buf = Buffered $fs.open("wo.txt", "w", buffer: false)
  assert_throws $StateError do buf.read()
  buf.close()
  let buf = Buffered $fs.open("ap.txt", "a", buffer: false)
  assert_throws $StateError do buf.tell()
  buf.close()
  assert_throws $TypeError do Buffered 1

#[test]
#[vfs]
def streams_are_io()
  fs.Path("plain.txt").write "plain"
  let buf = Buffered $fs.open("plain.txt", buffer: false)
  assert (type buf Io)
  assert_eq [buf.readable, buf.writable, buf.seekable] [true, false, true]
  buf.close()
  assert_eq [buf.readable, buf.writable, buf.seekable] [false, false, false]
  compress.compress data.gz :GZIP: do |stream|
    assert (type stream Io)
    assert_eq [stream.readable, stream.writable, stream.seekable] [false, true, false]
    assert_eq (stream.write "data") 4
  compress.decompress data.gz do |stream|
    assert (type stream Io)
    assert_eq [stream.readable, stream.writable, stream.seekable] [true, false, false]
    stream.close()
    assert_eq $stream.readable false

#[test]
#[vfs]
def helpers_on_native_streams()
  fs.Path("in.txt").write "héllo\nworld\n"
  let raw = fs.open in.txt buffer: false
  assert_eq (raw.read_all()) (Bin "héllo\nworld\n")
  raw.close()
  # A line-iterating file still has chunks
  let file = fs.open in.txt
  assert_eq [...file.chunks(4)] [b"h\xc3\xa9l", b"lo\nw", b"orld", b"\n"]
  file.close()
  let file = fs.open in.txt
  assert_eq (file.read_all_str()) "héllo\nworld\n"
  file.close()
  let buf = Buffered $fs.open("in.txt", buffer: false)
  assert_eq (buf.read_all_str()) "héllo\nworld\n"
  buf.close()
  fs.Path("bad.bin").write b"\xff"
  let bad = fs.open bad.bin
  assert_throws $RuntimeError do bad.read_all_str()
  bad.close()

#[test]
#[vfs]
def copy_between_native_streams()
  fs.Path("in.txt").write "data"
  let source = fs.open in.txt buffer: false
  let dest = fs.open out.txt w buffer: false
  assert_eq (source.copy_to dest) 4
  dest.write_all "!"
  source.close()
  dest.close()
  assert_eq (fs.Path("out.txt").read_str()) "data!"
  # A compressor inherits `Io`'s sink
  compress.compress data.gz :GZIP: do |stream|
    let source = fs.open in.txt
    assert_eq (source.copy_to stream) 4
    source.close()
    stream.(put) 42
    assert (type stream Sink)
    stream.precrimp().put "!"
  compress.decompress data.gz do |stream|
    assert_eq (stream.read_all_str()) "data42!\n"

#[test]
def zip_over_do_streams()
  let archive = MemIo()
  zip.open $archive "w" do |out|
    out.open "hello.txt" do |file| file.write "Hello, World!"
  assert_eq $archive.closed false
  assert_eq (archive.data[..2]) b"PK"
  zip.open (MemIo archive.data) do |source|
    source.open "hello.txt" do |file|
      assert_eq (str (file.read())) "Hello, World!"

#[test]
def compress_over_unseekable_do_streams()
  let sink = MemIo read: false seek: false
  compress.compress $sink :GZIP: do |stream| stream.write "squeezed"
  assert_eq $sink.closed false
  let source = MemIo $sink.data write: false seek: false
  compress.decompress $source do |stream|
    assert_eq $stream.format :GZIP:
    assert_eq (stream.read_all_str()) "squeezed"

#[test]
def unreadable_do_stream_is_refused()
  assert_throws $ValueError str: "value error: source must be readable" do
    compress.decompress (MemIo read: false) do |_| nil

class FailingRead: MemIo
  pub def read _self _size @ Int -> Bin
    throw StateError("read failed")

# A core exception outside the table reaches each consumer as a `RuntimeError`
# with its message
#[test]
def do_stream_exception_fails_consumer()
  assert_throws $RuntimeError str: "state error: read failed" do
    compress.decompress (FailingRead()) do |stream| stream.read()
  let buf = Buffered (FailingRead())
  assert_throws $RuntimeError str: "state error: read failed" do buf.read_line()

class MissingRead: MemIo
  pub def read _self _size @ Int -> Bin
    throw sys.NotFoundError gone code: $sys.linux.Errno.ENOENT

# A system error keeps its class, code and message through each consumer
#[test]
def do_stream_system_error_keeps_identity()
  let consumers = $
    - do Buffered(MissingRead()).read()
    - do compress.decompress (MissingRead()) do |stream| stream.read()
    - do zip.open (MissingRead b"0123456789012345678901234567890123456789") do |_| nil
  for consume = consumers
    let err = assert_throws $sys.NotFoundError str: "gone (ENOENT)" do consume()
    assert_eq $err.code.value $sys.linux.Errno.ENOENT.value

class InvalidRead: MemIo
  pub def read _self _size @ Int -> Bin
    throw ValueError bad

# A `ValueError` keeps its class and message, even with system errors loaded
#[test]
def do_stream_value_error_keeps_class()
  let err = assert_throws $ValueError str: "value error: bad" do
    Buffered(InvalidRead()).read()
  assert (!type(err, sys.Error))

# A stream whose reads wait until told to go on, and which reports when a read
# ends.
class Waiting: MemIo
  field started go ends

  def (init) self started go ends
    MemIo.(init) $self write: false seek: false
    self.#started = started
    self.#go = go
    self.#ends = ends

  pub def read self _size @ Int -> Bin
    self.#started.put true
    try
      self.#go.next()
    finally
      self.#ends.put true

#[test]
def cancelling_consumer_cancels_do_stream()
  let started_send started = channel()
  let _go_send go = channel()
  let ends_send ends = channel()
  let stream = Waiting $started_send $go $ends_send
  let consumer = spawn do
    compress.decompress $stream do |inner| inner.read()
  started.next()
  consumer.cancel()
  # The server's read is interrupted, and the stream stays open.
  assert_eq (ends.next()) true
  assert_eq $stream.closed false

#[test]
def concat_converts_items()
  let stream = Concat ["a", b"b", 1, true]
  assert_eq $stream.readable true
  assert_eq $stream.writable false
  assert_eq (stream.read_all()) b"ab1true"

#[test]
def concat_appends_end()
  assert_eq (Concat(["x", "y"], end: "\n").read_all_str()) "x\ny\n"
  assert_eq (Concat([b"x"], end: b"\0").read_all()) b"x\0"
  assert_eq (Concat([]).read_all()) b""
  assert_throws $TypeError do Concat [] end: 1

def recording pulled items
  items.map do |item|
    pulled.push $item
    item

#[test]
def concat_reads_split_and_span_items()
  let pulled = []
  let stream = Concat (recording(pulled, ["abc", "defg"]))
  assert_eq $pulled.len 0
  assert_eq (stream.read(2)) b"ab"
  assert_eq $pulled.len 1
  assert_eq (stream.read(3)) b"cde"
  assert_eq (stream.read(10)) b"fg"
  assert_eq (stream.read(1)) b""

def failing_item item
  if (item == "boom")
    throw ValueError bad
  item

#[test]
def concat_iterator_exception()
  let stream = Concat (["a", "boom"].map(failing_item))
  assert_eq (stream.read(1)) b"a"
  assert_throws $ValueError str: "value error: bad" do stream.read(1)
  let failing = Concat (["boom"].map(failing_item))
  assert_throws $ValueError str: "value error: bad" do
    compress.decompress $failing do |inner| inner.read()

#[test]
def concat_feeds_native_consumer()
  let sink = MemIo()
  compress.compress $sink :GZIP: do |stream| stream.write "streamed in pieces"
  let data = sink.data
  let chunks = [data[..5], data[5..10], data[10..]]
  compress.decompress (Concat chunks) do |stream|
    assert_eq (stream.read_all_str()) "streamed in pieces"

#[test]
def concat_close()
  let stream = Concat ["abc"]
  assert_eq (stream.read(1)) b"a"
  stream.close()
  assert_eq $stream.readable false
  assert_throws $StateError do stream.read(1)
  stream.close()

#[test]
def zip_through_cursors()
  let buf = BinBuf()
  zip.open (Cursor buf) "w" do |out|
    out.open "hello.txt" do |file| file.write "Hello, World!"
  zip.open (Cursor (buf.freeze())) do |source|
    source.open "hello.txt" do |file|
      assert_eq (file.read_all_str()) "Hello, World!"

# A bounded window reads an archive stored partway through a file
#[test]
#[vfs]
def zip_embedded_in_file()
  let buf = BinBuf()
  zip.open (Cursor buf) "w" do |out|
    out.open "inner.txt" do |file| file.write "inside"
  let archive = buf.freeze()
  fs.open bundle.bin w do |file|
    file.write "header"
    file.write $archive
    file.write "trailer"
  fs.open bundle.bin do |file|
    zip.open (Cursor file (6..(6 + archive.len))) do |source|
      source.open "inner.txt" do |entry|
        assert_eq (entry.read_all_str()) "inside"

#[test]
#[vfs]
def cursor_writes_file_window()
  fs.open data.bin w do |file| file.write "0123456789"
  fs.open data.bin r+ do |file|
    let window = Cursor $file (3..6)
    assert_eq (window.write("abcdef")) 3
    window.seek start: 1
    assert_eq (window.read(10)) b"bc"
    window.close()
    assert $file.readable
    file.seek start: 0
    assert_eq (file.read_all()) b"012abc6789"

#[test]
def cursor_over_do_stream()
  let source = MemIo b"0123456789"
  let window = Cursor $source (2..5)
  assert_eq (window.read_all()) b"234"
  assert_eq (window.write("xy")) 0
  window.seek start: 0
  assert_eq (window.write("xy")) 2
  window.flush()
  assert_eq $source.data b"01xy456789"
  window.close()
  assert_eq $source.closed false
  assert_throws $ValueError do Cursor (MemIo seek: false)
