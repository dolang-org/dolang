import fs json proc zip
  shell:
    - cd
    - exe
  test:
    - assert
    - assert_eq
    - test

# Runs the `doze` entrypoint, returning its combined output and exit code.
def doze *args
  let out = BinBuf()
  let rc = try
    run $exe -m doze ...args stdout: $out stderr: :STDOUT: mode: :CHUNK:
    0
  catch proc.Error: error
    error.rc
  (Str(out.freeze()), rc)

# The standard output of running a bundle.
def run_bundle *args
  let out = BinBuf()
  run $exe ...args stdout: $out mode: :CHUNK:
  Str $out.freeze()

# Writes a project into `dir`: a program whose main module imports `c`, which
# imports `a.b`.
def write_project dir
  (dir / "lib/a").create_dir all: true
  (dir / "main.dol").write "import c\nput \"\$(c.value) \$(shell.args[0])\\n\"\n"
  (dir / "lib/a/b.dol").write "pub let value = 40\n"
  (dir / "lib/c.dol").write "import a.b: ab\npub let value = (ab.value + 2)\n"

# A source that compiles, but fails the type check.
let TYPE_ERROR = "pub def f() -> Int\n  \"x\"\n"

# A test of `write_project`'s modules that passes.
let PASSING_TEST = r|
  import c
    test:
      - test
      - assert_eq

  #[test]
  def value()
    assert_eq $c.value 42

# Writes `source` as the project's test in `dir`.
def write_test dir source
  (dir / "test").create_dir all: true
  (dir / "test/t.dol").write $source

# The JSON report in `file`.
def read_report file
  let Dict(report) = json.decode $file.read_str()
  report

# A span as a report gives it.
def span line column len
  {"start": {"line": line, "column": column}, "len": len}

#[test]
def checks_a_project()
  fs.with_temp_dir do |dir|
    write_project $dir
    let output rc = doze --project $dir check
    assert_eq $rc 0
    assert $output.contains("checked 3 sources: 0 errors, 0 warnings")
    # The current directory is the default project
    cd $dir do
      let _output rc = doze check
      assert_eq $rc 0

#[test]
def check_failures_fail()
  for file = [["lib", "c.dol"], ["main.dol"]]
    fs.with_temp_dir do |dir|
      write_project $dir
      let path = fs.Path.join(dir, ...file)
      path.write $TYPE_ERROR
      let output rc = doze --project $dir check
      assert_eq $rc 1
      assert $output.contains("$path") $output

#[test]
def warnings_fail_only_when_strict()
  fs.with_temp_dir do |dir|
    write_project $dir
    (dir / "lib/w.dol").write "pub def f()\n  let unused = 1\n  nil\n"
    let output rc = doze --project $dir check
    assert_eq $rc 0
    assert $output.contains("1 warnings")
    let _output rc = doze --project $dir check --strict
    assert_eq $rc 1

#[test]
def checks_a_library_without_main()
  fs.with_temp_dir do |dir|
    write_project $dir
    (dir / "main.dol").remove()
    let output rc = doze --project $dir check
    assert_eq $rc 0
    assert $output.contains("checked 2 sources")

#[test]
def checks_modules_importing_strand()
  # `strand`'s pipes are `proc`'s, which the check needs too
  fs.with_temp_dir do |dir|
    write_project $dir
    (dir / "lib/s.dol").write "import strand\npub def go() -> Int\n  strand.spawn(do 1).join()\n"
    let output rc = doze --project $dir check
    assert_eq $rc 0 $output

#[test]
def other_sources_are_ignored()
  fs.with_temp_dir do |dir|
    write_project $dir
    (dir / "build").create_dir()
    (dir / "build/x.dol").write "let = 1\n"
    let output rc = doze --project $dir check
    assert_eq $rc 0
    assert $output.contains("checked 3 sources")

#[test]
def checks_tests()
  fs.with_temp_dir do |dir|
    write_project $dir
    write_test $dir $PASSING_TEST
    let output rc = doze --project $dir check
    assert_eq $rc 0 $output
    assert $output.contains("checked 4 sources: 0 errors, 0 warnings") $output
    # Tests are found at any depth
    let nested = (dir / "test/sub/x.dol")
    nested.parent.create_dir()
    nested.write $TYPE_ERROR
    let output rc = doze --project $dir check
    assert_eq $rc 1
    assert $output.contains("$nested") $output

#[test]
def bundling_leaves_tests_out()
  fs.with_temp_dir do |dir|
    write_project $dir
    write_test $dir "let = 1\n"
    let output rc = doze --project $dir bundle
    assert_eq $rc 0 $output
    assert $output.contains("checked 3 sources") $output

#[test]
def runs_tests()
  fs.with_temp_dir do |dir|
    write_project $dir
    write_test $dir $PASSING_TEST
    let output rc = doze --project $dir test
    assert_eq $rc 0 $output
    write_test $dir $PASSING_TEST.replace("42", "41")
    let output rc = doze --project $dir test
    assert_eq $rc 1 $output

#[test]
def passes_arguments_to_tests()
  fs.with_temp_dir do |dir|
    write_project $dir
    write_test $dir $PASSING_TEST
    let file = (dir / "tests.json")
    let output rc = doze --project $dir test --list --format json --output $file
    assert_eq $rc 0 $output
    let Dict(listing) = json.decode $file.read_str()
    let ids = $
      for module = listing["modules"]
        for record = module["tests"]
          - $record["id"]
    assert_eq $ids ["test/t/value"]

#[test]
def testing_needs_a_test_dir()
  fs.with_temp_dir do |dir|
    write_project $dir
    let output rc = doze --project $dir test
    assert_eq $rc 1
    assert $output.contains("no test directory") $output

#[test]
def bad_module_paths_fail()
  let cases = $
    - (["lib", "x-y.dol"], "invalid module path")
    - (["lib", "mod.dol"], "invalid module path")
    - (["lib", "c", "mod.dol"], "module c given by both")
  for case = cases
    let file expected = case
    fs.with_temp_dir do |dir|
      write_project $dir
      let path = fs.Path.join(dir, ...file)
      path.parent.create_dir all: true
      path.write "nil\n"
      let output rc = doze --project $dir check
      assert_eq $rc 1
      assert $output.contains(expected) $output
      assert $output.contains("$path") $output

#[test]
def bundles_a_project()
  fs.with_temp_dir do |parent|
    let dir = (parent / "app")
    write_project $dir
    # Unimported modules and `mod.dol` modules are bundled too, laid out by
    # module name
    (dir / "lib/d").create_dir()
    (dir / "lib/d/mod.dol").write "pub let value = 1\n"
    let _output rc = doze --project $dir bundle
    assert_eq $rc 0
    let app = (dir / "build/app.dolz")
    assert_eq (run_bundle(app, "world")) "42 world\n"
    let names = zip.open $app do |archive|
      Set $ archive.entries.map do |entry| str $entry.name
    let expected = $
      for stem = ["main", "lib/a/b", "lib/c", "lib/d"]
        - "$stem.dol"
        - "$stem.dolc"
    assert_eq $names (Set(expected))

#[test]
def bundles_with_output_and_shebang()
  fs.with_temp_dir do |dir|
    write_project $dir
    let app = (dir / "app")
    let _output rc = doze --project $dir bundle -o $app --shebang $exe
    assert_eq $rc 0
    assert $app.read().starts_with(Bin("#!$exe\n"))
    assert_eq (run_bundle(app, "world")) "42 world\n"
    assert (!(dir / "build").exists())

#[test]
def bundling_needs_main()
  fs.with_temp_dir do |dir|
    write_project $dir
    (dir / "main.dol").remove()
    let output rc = doze --project $dir bundle
    assert_eq $rc 1
    assert $output.contains("no main.dol")
    assert (!(dir / "build").exists())

#[test]
def bundling_checks_unless_told_not_to()
  fs.with_temp_dir do |dir|
    write_project $dir
    (dir / "lib/e.dol").write $TYPE_ERROR
    let _output rc = doze --project $dir bundle
    assert_eq $rc 1
    assert (!(dir / "build").exists())
    let _output rc = doze --project $dir bundle --no-check
    assert_eq $rc 0
    let app = (dir / "build" / "$(dir.canonical().name).dolz")
    assert $app.exists()

#[test]
def compile_errors_fail_the_bundle()
  fs.with_temp_dir do |dir|
    write_project $dir
    let path = (dir / "lib" / "c.dol")
    path.write "let = 1\n"
    let output rc = doze --project $dir bundle --no-check
    assert_eq $rc 1
    assert $output.contains("$path") $output
    assert (!(dir / "build").exists())

#[test]
def reports_diagnostics_as_json()
  fs.with_temp_dir do |dir|
    write_project $dir
    let main = (dir / "main.dol")
    main.write $TYPE_ERROR
    # A warning with an annotation, in a unit after the first
    let warned = (dir / "lib/w.dol")
    warned.write |
      def boom() -> Never
        throw std.ValueError "x"
      pub def g() -> Int
        boom()
        1
    let file = (dir / "report.json")
    let output rc = doze --project $dir check --json $file
    assert_eq $rc 1 $output
    let report = read_report $file
    assert_eq $report["sources"] 4
    assert_eq $report["checked"] true
    assert_eq $report["errors"] 1
    assert_eq $report["warnings"] 1
    assert_eq $report["passed"] false
    let error warning = report["diagnostics"]
    assert_eq $error["path"] "$main"
    assert_eq $error["severity"] "error"
    assert_eq $error["span"] $span(1, 2, 3)
    assert_eq $warning["path"] "$warned"
    assert_eq $warning["severity"] "warning"
    assert_eq $warning["span"] $span(4, 2, 1)
    let annotation = $
      "kind": context
      "message": any code after this call is unreachable
      "path": "$warned"
      "span": $span(3, 2, 6)
    assert_eq $warning["annotations"] [annotation]
    assert_eq $warning["notes"] []
    assert_eq $warning["patches"] []

#[test]
def reports_compile_errors_as_json()
  fs.with_temp_dir do |dir|
    write_project $dir
    let path = (dir / "lib/c.dol")
    path.write "let = 1\n"
    let file = (dir / "report.json")
    let _output rc = doze --project $dir bundle --no-check --json $file
    assert_eq $rc 1
    let report = read_report $file
    assert_eq $report["checked"] false
    assert_eq $report["passed"] false
    let diagnostics = report["diagnostics"]
    assert (diagnostics.len > 0)
    for diag = diagnostics
      assert_eq $diag["path"] "$path"
      assert_eq $diag["severity"] "error"

#[test]
def reports_a_pass_as_json()
  for command = ["check", "bundle"]
    fs.with_temp_dir do |dir|
      write_project $dir
      let file = (dir / "report.json")
      let output rc = doze --project $dir $command --json $file
      assert_eq $rc 0 $output
      let expected = $
        "sources": 3
        "checked": true
        "errors": 0
        "warnings": 0
        "passed": true
        "diagnostics": []
      assert_eq (read_report(file)) $expected

#[test]
def project_errors_write_no_report()
  fs.with_temp_dir do |dir|
    write_project $dir
    (dir / "lib/x-y.dol").write "nil\n"
    let file = (dir / "report.json")
    let _output rc = doze --project $dir check --json $file
    assert_eq $rc 1
    assert (!file.exists())
  fs.with_temp_dir do |dir|
    write_project $dir
    (dir / "main.dol").remove()
    let file = (dir / "report.json")
    let _output rc = doze --project $dir bundle --json $file
    assert_eq $rc 1
    assert (!file.exists())

#[test]
def reads_the_configuration()
  fs.with_temp_dir do |dir|
    write_project $dir
    # An empty configuration is the convention
    (dir / "doze.toml").write ""
    let output rc = doze --project $dir check
    assert_eq $rc 0 $output
    (dir / "doze.toml").write r|
      [project]
      name = "app"
      version = "0.1.0"
      authors = ["A <a@example.com>"]
      license = "MIT"
      description = "An app."
    let output rc = doze --project $dir check
    assert_eq $rc 0 $output
    # The bundle is named after the project
    let output rc = doze --project $dir bundle
    assert_eq $rc 0 $output
    assert_eq (run_bundle(dir / "build/app.dolz", "x")) "42 x\n"

#[test]
def bad_configurations_fail()
  let cases = $
    - ("[project\n", "invalid TOML")
    - ("[tests]\n", "unknown keys: `tests`")
    - ("name = \"app\"\n", "unknown keys: `name`")
    - ("[project]\nnmae = \"app\"\n", "unknown keys: `project.nmae`")
    - ("project = 1\n", "`project` must be a table")
    - ("[project]\nname = 1\n", "`project.name` must be a string")
    - ("[project]\nauthors = \"A\"\n", "`project.authors` must be an array of strings")
    - ("[project]\nauthors = [1]\n", "`project.authors` must be an array of strings")
    - ("[project]\nname = \"a/b\"\n", "`project.name` can't name a file")
    - ("[project]\nname = \"..\"\n", "`project.name` can't name a file")
  for case = cases
    let text expected = case
    fs.with_temp_dir do |dir|
      write_project $dir
      (dir / "doze.toml").write $text
      let output rc = doze --project $dir check
      assert_eq $rc 1 $output
      assert $output.contains(expected) $output
