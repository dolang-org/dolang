import strand
  test:
    - assert
    - assert_eq
    - assert_type
    - assert_throws
    - test
  std:
    - CanceledError
    - RuntimeError
    - TimedOutError
  time:
    - Date
    - DateTime
    - Duration
    - Month
    - Weekday
    - sleep
    - timeout

#[test]
def datetime_conversions()
  let now = DateTime.now()
  assert_type $DateTime $now
  assert_type $Float $now.unix_secs
  assert_type $Int $now.unix_nanos

  assert $str(now).contains(":")
  assert_eq (str now) (now.rfc())

  let zero = (now - now)
  assert_type $Duration $zero
  assert_eq $zero.secs 0.0
  assert_eq $zero.nanos 0
  assert_eq (str zero) "0s"

  let parsed = DateTime.parse_rfc("2024-01-02T03:04:05.123456789Z")
  assert_type $DateTime $parsed
  assert_eq (parsed.rfc()) "2024-01-02T03:04:05.123456789Z"
  assert_eq $parsed.unix_nanos 1704164645123456789
  assert_eq (str parsed) (parsed.rfc())

  let offset = DateTime.parse_rfc("2024-01-02T03:04:05+02:30")
  assert_eq (offset.rfc()) "2024-01-02T00:34:05Z"

  let from_secs = DateTime.from_unix(1.25)
  assert_eq (from_secs.rfc()) "1970-01-01T00:00:01.25Z"
  assert_eq $from_secs.unix_nanos 1250000000

  let from_nanos = DateTime.from_unix(nanos: -1)
  assert_eq (from_nanos.rfc()) "1969-12-31T23:59:59.999999999Z"
  assert_eq $from_nanos.unix_nanos -1

  let combined = DateTime.from_unix(1, nanos: 250000000)
  assert_eq (combined.rfc()) "1970-01-01T00:00:01.25Z"
  assert_eq $combined.unix_nanos 1250000000

  assert_throws $RuntimeError do
    DateTime.parse_rfc("not-a-timestamp")
  assert_throws $RuntimeError do
    DateTime.parse_rfc("2024-01-02T03:04:05Z[UTC]")

#[test]
def dates_and_calendar_enums()
  let date = Date.from_ymd 2024 $Month.FEBRUARY 28
  assert_type $Date $date
  assert_eq $date.year 2024
  assert_eq $date.month $Month.FEBRUARY
  assert_eq $date.day 28
  assert_eq $date.weekday $Weekday.WEDNESDAY
  assert_eq (str date) "2024-02-28"
  assert_eq (date.rfc()) "2024-02-28"
  assert_eq (Date.parse_rfc "2024-02-28") $date
  assert_eq $(date.add_days 1).rfc() "2024-02-29"
  assert_eq $(date.add_days -1).rfc() "2024-02-27"
  assert_eq $(date.sub_days 1).rfc() "2024-02-27"
  let difference = (Date.from_ymd 2024 3 1 - date)
  assert_eq $difference.nanos 172800000000000
  assert_eq (date.datetime().date()) $date

  assert_eq $Month[1] $Month.JANUARY
  assert_eq $Month[12] $Month.DECEMBER
  assert_eq (Month.DECEMBER.next()) $Month.JANUARY
  assert_eq (Month.JANUARY.previous()) $Month.DECEMBER
  assert_eq (Weekday.SUNDAY.next()) $Weekday.MONDAY
  assert_eq (Weekday.MONDAY.previous()) $Weekday.SUNDAY
  assert_eq (str Month.JANUARY) "JANUARY"
  assert_eq (str Weekday.MONDAY) "MONDAY"

  assert_throws $RuntimeError do
    Date.from_ymd 2023 2 29
  assert_throws $RuntimeError do
    Date.parse_rfc("2024-02-30")
  assert_throws $RuntimeError do
    Date.parse_rfc("2024-02-28[UTC]")
  assert_throws $RuntimeError do
    Month[0]

#[test]
def sleep_accepts_zero_and_rejects_negative()
  sleep 0
  sleep 0.0
  sleep (DateTime.from_unix(1) - DateTime.from_unix(1))

  assert_throws $RuntimeError do
    sleep -1

#[test]
def timeout_handles_completion_and_cancellation()
  assert_eq (timeout 0 do :expected:) :expected:

  assert_throws $TimedOutError do
    timeout 0.01 do
      sleep 10000
      false

  let res = timeout 10 do
    sleep 0
    :expected:
  assert_eq $res :expected:

  let cleaned = false
  let inner = try
    timeout 10000 do
      let value = try
        timeout 0 do
          sleep 10000
          :unexpected:
      catch TimedOutError: _
        :expected:
      sleep 0
      value
  finally
    sleep 0
    cleaned = true
  assert_eq $inner :expected:
  assert $cleaned

  assert_throws $CanceledError do
    let worker = strand.spawn do
      timeout 1 do
        sleep 10
    worker.cancel()
    worker.join()

#[test]
def timeout_inside_interrupted_finally()
  let completed = false
  assert_throws $TimedOutError do
    timeout 0.01 do
      try
        sleep 10000
      finally
        timeout 1 do
          sleep 0
          completed = true
  assert $completed

  let caught_local_timeout = false
  assert_throws $TimedOutError do
    timeout 0.01 do
      try
        sleep 10000
      finally
        try
          timeout 0 do sleep 10000
        catch TimedOutError: _
          caught_local_timeout = true
  assert $caught_local_timeout

#[test]
def local_timeout_inside_canceled_finally_keeps_cancellation_masked()
  let entered_send entered_recv = strand.channel()
  let finished_send finished_recv = strand.channel()
  let worker = strand.spawn do
    try
      sleep 10000
    finally
      entered_send.put ok
      try
        timeout 0.01 do sleep 10000
      catch TimedOutError: _
        finished_send.put ok

  worker.cancel()
  entered_recv.next()
  finished_recv.next()
  assert_throws $CanceledError do worker.join()

#[test]
def canceled_resource_acquisition_retains_outer_resource()
  let outer = strand.Resource 1
  let blocked = strand.Resource 1
  let held_send held_recv = strand.channel()
  let release_send release_recv = strand.channel()
  let holder = strand.spawn do blocked.with do
    held_send.put ok
    release_recv.next()
  held_recv.next()

  let inside = false
  let contender = nil
  outer.with do
    try
      timeout 0 do blocked.with do nil
    catch TimedOutError: _
      nil
    inside = true
    contender = strand.spawn do outer.with do assert $!inside
    inside = false

  release_send.put ok
  holder.join()
  contender.join()
