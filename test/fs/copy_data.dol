import fs
  testlib.vfs:
    - vfs
    - with_vfs
  test:
    - assert
    - assert_eq
    - assert_throws
    - test
  fs:
    - copy_data
    - open
  std:
    - Range
    - StateError
    - TypeError
    - ValueError
  sys:
    - InvalidInputError
    - UnsupportedError

let CHUNK = "abcdefgh".repeat 393217

# Writes `content` to `path` and hands the path back, so a test can set up its
# source in one line.
def seeded path content
  open $path w do |f|
    f.write $content
  path

#[test]
#[vfs]
def copies_to_end_of_source()
  seeded "streaming-src.txt" "0123456789"
  open "streaming-src.txt" r do |src|
    open "streaming-dst.txt" w do |dst|
      let count = copy_data $src $dst
      assert_eq $count 10
      # Both sides were addressed through their cursors, so both advanced.
      assert_eq (src.tell()) 10
      assert_eq (dst.tell()) 10
  let content = fs.read "streaming-dst.txt"
  assert_eq $content "0123456789"

#[test]
#[vfs]
def copies_a_range_without_moving_either_cursor()
  seeded "ranged-src.txt" "0123456789"
  seeded "ranged-dst.txt" "XXXXXXXXXX"
  open "ranged-src.txt" r do |src|
    open "ranged-dst.txt" r+ do |dst|
      let count = copy_data $src $dst range: (2..5) offset: 3
      assert_eq $count 3
      assert_eq (src.tell()) 0
      assert_eq (dst.tell()) 0
  let content = fs.read "ranged-dst.txt"
  assert_eq $content "XXX234XXXX"

#[test]
#[vfs]
def copies_an_open_ended_range()
  seeded "open-end-src.txt" "0123456789"
  open "open-end-src.txt" r do |src|
    open "open-end-dst.txt" w do |dst|
      let count = copy_data $src $dst range: (6..)
      assert_eq $count 4
  let content = fs.read "open-end-dst.txt"
  assert_eq $content "6789"

#[test]
#[vfs]
def copies_a_range_with_an_implicit_start()
  seeded "implicit-start-src.txt" "0123456789"
  open "implicit-start-src.txt" r do |src|
    open "implicit-start-dst.txt" w do |dst|
      assert_eq (copy_data src dst range: (..4)) 4
      assert_eq (copy_data src dst range: (..)) 10
  let content = fs.read "implicit-start-dst.txt"
  assert_eq $content "01230123456789"

#[test]
#[vfs]
def copies_a_size_from_the_cursor()
  seeded "sized-src.txt" "0123456789"
  open "sized-src.txt" r do |src|
    src.seek 4
    open "sized-dst.txt" w do |dst|
      let count = copy_data $src $dst size: 3
      assert_eq $count 3
      assert_eq (src.tell()) 7
      assert_eq (dst.tell()) 3
  let content = fs.read "sized-dst.txt"
  assert_eq $content "456"

#[test]
#[vfs]
def comes_up_short_only_at_end_of_source()
  seeded "short-src.txt" "01234"
  open "short-src.txt" r do |src|
    open "short-dst.txt" w do |dst|
      let count = copy_data $src $dst size: 100
      assert_eq $count 5
      assert_eq (src.tell()) 5
  let content = fs.read "short-dst.txt"
  assert_eq $content "01234"

#[test]
#[vfs]
def copies_nothing_for_an_empty_range()
  seeded "empty-src.txt" "0123456789"
  seeded "empty-dst.txt" "ABC"
  open "empty-src.txt" r do |src|
    open "empty-dst.txt" r+ do |dst|
      assert_eq (copy_data src dst range: (5..5) offset: 1) 0
  let content = fs.read "empty-dst.txt"
  assert_eq $content "ABC"

#[test]
#[vfs]
def successive_copies_follow_the_destination_cursor()
  seeded "successive-src.txt" "0123456789"
  open "successive-src.txt" r do |src|
    open "successive-dst.txt" w do |dst|
      assert_eq (copy_data src dst range: (0..3)) 3
      assert_eq (dst.tell()) 3
      assert_eq (copy_data src dst range: (7..10)) 3
      assert_eq (dst.tell()) 6
  let content = fs.read "successive-dst.txt"
  assert_eq $content "012789"

#[test]
#[vfs]
def appends_to_an_append_handle()
  seeded "append-src.txt" "0123456789"
  seeded "append-dst.txt" "start:"
  open "append-src.txt" r do |src|
    open "append-dst.txt" a+ do |dst|
      assert_eq (copy_data src dst range: (0..2)) 2
      assert_eq (dst.tell()) 8
      assert_eq (copy_data src dst range: (8..10)) 2
      assert_eq (dst.tell()) 10
  let content = fs.read "append-dst.txt"
  assert_eq $content "start:0189"

#[test]
#[vfs]
def refuses_an_offset_on_an_append_handle()
  seeded "append-offset-src.txt" "0123456789"
  seeded "append-offset-dst.txt" "start:"
  open "append-offset-src.txt" r do |src|
    open "append-offset-dst.txt" a do |dst|
      assert_throws $StateError do
        copy_data $src $dst range: (0..2) offset: 0
      assert_throws $UnsupportedError do
        copy_data $src $dst range: (0..2) clone: :REQUIRE:

#[test]
#[vfs]
def the_method_form_matches_the_module_form()
  seeded "forms-src.txt" "0123456789"
  open "forms-src.txt" r do |src|
    open "forms-a.txt" w do |a|
      open "forms-b.txt" w do |b|
        assert_eq (src.copy_data a range: (1..5)) 4
        assert_eq (copy_data src b range: (1..5)) 4
  let a = fs.read "forms-a.txt"
  let b = fs.read "forms-b.txt"
  assert_eq $a $b

#[test]
#[vfs]
def rejects_a_range_together_with_a_size()
  seeded "both-src.txt" "0123456789"
  open "both-src.txt" r do |src|
    open "both-dst.txt" w do |dst|
      assert_throws $ValueError do
        copy_data $src $dst range: (0..2) size: 2

#[test]
#[vfs]
def rejects_a_malformed_range()
  seeded "bad-range-src.txt" "0123456789"
  open "bad-range-src.txt" r do |src|
    open "bad-range-dst.txt" w do |dst|
      assert_throws $ValueError do
        copy_data $src $dst range: (Range(0, 10, 2))
      assert_throws $ValueError do
        copy_data $src $dst range: (-1..5)
      assert_throws $ValueError do
        copy_data $src $dst range: (9..3)
      assert_throws $TypeError do
        copy_data $src $dst range: "0..5"

#[test]
#[vfs]
def rejects_a_non_file_argument()
  seeded "non-file-src.txt" "0123456789"
  open "non-file-src.txt" r do |src|
    assert_throws $TypeError do
      copy_data $src "not-a-handle"
    assert_throws $TypeError do
      src.copy_data "not-a-handle"

#[test]
#[vfs]
def rejects_a_closed_handle()
  seeded "closed-src.txt" "0123456789"
  let src = open "closed-src.txt" r
  open "closed-dst.txt" w do |dst|
    src.close()
    assert_throws $StateError do
      copy_data $src $dst range: (0..2)

#[test]
#[vfs]
def copies_between_disjoint_regions_of_one_handle()
  seeded "self-disjoint.txt" "0123456789"
  open "self-disjoint.txt" r+ do |f|
    assert_eq (f.copy_data f range: (0..3) offset: 6) 3
  let content = fs.read "self-disjoint.txt"
  assert_eq $content "0123450129"

#[test]
#[vfs]
def rejects_a_cursor_copy_from_a_handle_to_itself()
  seeded "self-cursor.txt" "0123456789"
  open "self-cursor.txt" r+ do |f|
    # A borrow conflict would name nothing the script wrote, so this has to be
    # caught before either side is borrowed.
    assert_throws $StateError do
      f.copy_data $f size: 4
    assert_throws $StateError do
      f.copy_data $f range: (0..4)

#[test]
#[vfs]
def rejects_overlapping_regions_of_one_file()
  seeded "overlap.txt" "0123456789"
  open "overlap.txt" r+ do |f|
    assert_throws $InvalidInputError do
      f.copy_data $f range: (0..8) offset: 4
  # Two separate handles on one file are caught the same way, which is the
  # case the identity check exists for.
  open "overlap.txt" r do |src|
    open "overlap.txt" r+ do |dst|
      assert_throws $InvalidInputError do
        copy_data $src $dst range: (0..8) offset: 4

#[test]
#[vfs]
def clone_modes_are_accepted_and_require_is_conditional()
  seeded "clone-src.txt" "0123456789"
  let cloned = 0
  open "clone-src.txt" r do |src|
    open "clone-auto.txt" w do |dst|
      assert_eq (copy_data src dst range: (0..4) clone: :AUTO:) 4
    open "clone-never.txt" w do |dst|
      assert_eq (copy_data src dst range: (0..4) clone: :NEVER:) 4
    cloned = open "clone-require.txt" w do |dst|
      try
        copy_data $src $dst range: (0..4) clone: :REQUIRE:
      catch UnsupportedError: _
        0
    open "clone-bad.txt" w do |dst|
      assert_throws $ValueError do
        copy_data $src $dst range: (0..4) clone: :SOMETIMES:
      assert_throws $TypeError do
        copy_data $src $dst range: (0..4) clone: "AUTO"
  let auto = fs.read "clone-auto.txt"
  let never = fs.read "clone-never.txt"
  assert_eq $auto $never
  if (cloned == 4)
    # A clone remains independent after a later source modification.
    seeded "clone-src.txt" "changed"
    assert_eq (fs.read "clone-require.txt") "0123"
  else
    assert_eq $cloned 0

#[test]
#[vfs]
def copies_more_than_one_chunk()
  # Larger than the 2 MiB VFS operation bound, so the Do binding must loop.
  seeded "large-src.bin" $CHUNK
  open "large-src.bin" rb do |src|
    open "large-dst.bin" wb do |dst|
      assert_eq (copy_data src dst) $CHUNK.len
      assert_eq (src.tell()) $CHUNK.len
      assert_eq (dst.tell()) $CHUNK.len
  let content = fs.read "large-dst.bin" b
  assert_eq $content.len $CHUNK.len
  # `assert` rather than `assert_eq`: a mismatch here would otherwise print
  # several megabytes of it.
  assert (str(content) == CHUNK) "large copy content differs"

#[test]
#[vfs]
def large_same_file_copies_validate_and_preserve_the_whole_request()
  let filler = "x".repeat $CHUNK.len
  seeded "large-self.bin" "$CHUNK$filler"
  open "large-self.bin" r+b do |file|
    # The first 2 MiB step would be disjoint at this offset, but the complete
    # requested regions overlap. Validation must happen before the VFS cap.
    assert_throws $InvalidInputError do
      copy_data $file $file range: (0..CHUNK.len) offset: (2 * 1024 * 1024 + 4096)
    assert_eq (copy_data file file range: (0..CHUNK.len) offset: CHUNK.len) $CHUNK.len
  let content = fs.read "large-self.bin"
  assert (content == "$CHUNK$CHUNK") "large same-file copy content differs"

#[test]
#[vfs]
def required_clone_loops_when_the_filesystem_supports_it()
  seeded "large-clone-src.bin" $CHUNK
  let cloned = 0
  open "large-clone-src.bin" rb do |src|
    open "large-clone-dst.bin" wb do |dst|
      cloned = try
        copy_data $src $dst clone: :REQUIRE:
      catch UnsupportedError: _
        0
  if (cloned == CHUNK.len)
    seeded "large-clone-src.bin" "changed"
    let content = fs.read "large-clone-dst.bin" b
    assert_eq $content.len $CHUNK.len
    assert (str(content) == CHUNK) "required clone content differs"
  else
    assert_eq $cloned 0

#[test]
#[vfs]
def append_copy_loops_and_tracks_the_actual_end()
  seeded "large-append-src.bin" $CHUNK
  seeded "large-append-dst.bin" "prefix"
  open "large-append-src.bin" rb do |src|
    open "large-append-dst.bin" a+b do |dst|
      assert_eq (copy_data src dst) $CHUNK.len
      assert_eq (dst.tell()) (CHUNK.len + 6)
  let content = fs.read "large-append-dst.bin" b
  assert_eq $content.len (CHUNK.len + 6)

#[test]
#[vfs]
def relays_between_two_sessions()
  seeded "cross-session-src.txt" $CHUNK
  open "cross-session-src.txt" r do |src|
    # A second connection, so the destination handle belongs to a different
    # session from the source. Nothing about the two is shareable, so this is
    # the route that pumps the bytes through this process.
    with_vfs true do
      open "cross-session-dst.txt" w do |dst|
        assert_eq (copy_data src dst) $CHUNK.len
  let content = fs.read "cross-session-dst.txt"
  assert_eq $content.len $CHUNK.len
  assert (content == CHUNK) "relay copy content differs"
