import test:
  - assert_eq
  - assert_throws
  - test

import fs:
  - open
  - remove
  - write

import io:
  - Window

import digest

import testlib.vfs:
  - vfs
import std:
  - StateError
  - UnsupportedError

# Distinct bytes at every offset, longer than a file buffer.
def numbered()
  "".join ((0..20000).map(do |i| "$i\n"))

#[test]
#[vfs]
def forked_windows_read_concurrently()
  let path = "test_fs_window_concurrent.bin"
  write $path $numbered()
  let data = open $path do |file| file.read_all()
  let chunk = (data.len // 4)
  for buffer = [true, false]
    open $path buffer: $buffer do |file|
      let strands = []
      for i = 0..4
        let start = (i * chunk)
        let w = Window $file.fork() (start..(start + chunk))
        let s = spawn do
          digest.sha256 $w
        strands.push $s
      # The windows' reads and the file's own interleave.
      assert_eq (file.read 6) $data[..6]
      assert_eq (file.seek start: 100) 100
      assert_eq (file.read 4) $data[100..104]
      for i s = strands.enumerate()
        let start = (i * chunk)
        assert_eq (s.join()) (digest.sha256 data[start..(start + chunk)])
      assert_eq (file.read 4) $data[104..108]
  remove $path

#[test]
#[vfs]
def forked_window_leaves_file_position()
  let path = "test_fs_window_position.bin"
  write $path b"abcdefgh"
  for buffer = [true, false]
    open $path buffer: $buffer do |file|
      assert_eq (file.read 2) b"ab"
      let w = Window $file.fork() (4..)
      assert_eq (w.read 2) b"ef"
      assert_eq (file.read 2) b"cd"
      assert_eq (w.read_all()) b"gh"
      assert_eq (file.tell()) 4
  remove $path

#[test]
#[vfs]
def forked_window_sees_pending_writes()
  let path = "test_fs_window_pending.bin"
  open $path "w+" do |file|
    file.write "hello"
    let w = Window $file.fork(0)
    assert_eq (w.read_all()) b"hello"
    assert_eq (file.tell()) 5
  remove $path

#[test]
#[vfs]
def window_writes_file()
  let path = "test_fs_window_write.bin"
  for buffer = [true, false]
    write $path b"abcdef"
    open $path "r+" buffer: $buffer do |file|
      let w = Window $file (2..4)
      assert_eq (w.write "XYZ") 2
      w.close()
      file.seek start: 0
      assert_eq (file.read_all()) b"abXYef"
  remove $path

#[test]
#[vfs]
def seekable_files_fork()
  let path = "test_fs_window_forkable.bin"
  write $path b"abc"
  for buffer = [true, false]
    for mode forkable = [("r", true), ("r+", true), ("w", true), ("a", false), ("a+", false)]
      let file = open $path $mode buffer: $buffer
      assert_eq $file.forkable $forkable
      if file.seekable
        let w = Window $file
        assert_eq $w.forkable false
      file.close()
      assert_eq $file.forkable false
  remove $path

#[test]
#[vfs]
def fork_has_its_own_position()
  let path = "test_fs_fork.bin"
  for buffer = [true, false]
    write $path b"abcdefgh"
    open $path "r+" buffer: $buffer do |file|
      assert_eq (file.read 2) b"ab"
      let here = file.fork()
      let there = file.fork 6
      assert_eq (there.read 2) b"gh"
      assert_eq (here.read 2) b"cd"
      assert_eq (file.read 2) b"cd"
      file.write "XY"
      let later = file.fork 4
      assert_eq (later.read 2) b"XY"
      later.close()
      here.close()
      there.close()
      assert_eq (file.read 2) b"gh"
  remove $path

#[test]
#[vfs]
def append_file_does_not_fork()
  let path = "test_fs_no_fork.bin"
  open $path "a" do |file|
    assert_throws $UnsupportedError do file.fork()
  open $path "r" do |file|
    file.close()
    assert_throws $StateError do file.fork()
  remove $path
