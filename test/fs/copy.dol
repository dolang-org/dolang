import
  testlib.vfs:
    - vfs
  test:
    - assert_eq
    - assert_throws
    - test
  std:
    - RuntimeError
  fs:
    - open
    - copy
    - create_dir
    - symlink
    - Path

#[test]
#[vfs]
def copy_file()
  let src = Path "source.txt"
  let dst = Path "dest.txt"

  open $src w do |f|
    f.write "hello world"

  copy $src $dst

  open $dst r do |f|
    let contents = f.read_str()
    assert_eq $contents "hello world"

#[test]
#[vfs]
def copy_over_existing_file()
  let src = Path "source.txt"
  let dst = Path "dest.txt"

  open $src w do |f|
    f.write "new content"

  open $dst w do |f|
    f.write "old content"

  copy $src $dst

  open $dst r do |f|
    let contents = f.read_str()
    assert_eq $contents "new content"

#[test]
#[vfs]
def copy_non_existent_file_fails()
  let src = Path "nonexistent.txt"
  let dst = Path "dest.txt"

  assert_throws $RuntimeError do
    copy $src $dst

#[test]
#[vfs]
def copy_directory_requires_all()
  let src = Path "src"
  create_dir $src

  let dst = Path "dst"

  assert_throws $RuntimeError do
    copy $src $dst

#[test]
#[vfs]
def copy_directory_with_all()
  let src = Path "src"
  let nested = (src / "nested")
  create_dir $nested all: true

  open (nested / "file.txt") w do |f|
    f.write "nested content"

  let dst = Path "dst"
  copy $src $dst all: true

  open (dst / "nested" / "file.txt") r do |f|
    let contents = f.read_str()
    assert_eq $contents "nested content"

#[test]
#[vfs]
def path_copy_method()
  let src = Path "source.txt"
  let dst = Path "dest.txt"

  open $src w do |f|
    f.write "copied with method"

  src.copy $dst

  open $dst r do |f|
    let contents = f.read_str()
    assert_eq $contents "copied with method"

#[test]
#[vfs]
def copy_preserves_symlink()
  let target = Path "target.txt"
  let link = Path "link.txt"
  let copied = Path "copied.txt"

  open $target w do |f|
    f.write "symlink target"

  symlink $target $link
  copy $link $copied

  let meta = copied.metadata resolve: :LINK:
  assert_eq $meta.type :SYMLINK:
  assert_eq $copied.read_link() $target

#[test]
#[vfs]
def copy_to_non_existent_directory_fails()
  let src = Path "source.txt"
  let dst = (Path "nonexistent" / "dest.txt")

  open $src w do |f|
    f.write "test"

  assert_throws $RuntimeError do
    copy $src $dst
