import strand sys sys.unix sys.freebsd sys.linux sys.macos sys.windows
  testlib.vfs:
    - vfs
  test:
    - assert
    - assert_eq
    - assert_type
    - assert_throws
    - test
  fs:
    - open
    - read
    - read_str
    - write
    - remove
    - Path
  std:
    - RuntimeError

let is_windows = (sys.os_info().family == :WINDOWS:)

#[test]
#[vfs]
def read_entire_file()
  let path = "test_fs_read_source.txt"
  write $path "[package]\nname = \"dolang-ext-shell\"\n"

  # Test reading entire file
  open $path "r" do |file|
    let contents = file.read_str()
    # Verify we got some string data
    assert (contents.len > 0)
    # Verify it's valid UTF-8 string content
    assert (contents.starts_with("[package]"))
    assert (contents.contains("dolang-ext-shell"))

#[test]
#[vfs]
def read_partial()
  let path = "test_fs_read_partial.txt"
  write $path "[package]\nname = \"dolang-ext-shell\"\n"

  # Test reading up to a specific number of bytes
  open $path "r" do |file|
    let first_10 = file.read_str(10)
    # read_str() returns up to n bytes, but may return fewer at EOF
    assert (first_10.len > 0)
    # Should be valid UTF-8 string
    assert (first_10.starts_with "[package]" )

#[test]
#[vfs]
def read_returns_bin()
  let path = "test_fs_read_binary.bin"
  write $path b"[package]\n"

  # Reads return bytes
  open $path do |file|
    let contents = file.read()
    # Verify we got some binary data
    assert $ type $contents $Bin
    assert (contents.len > 0)
    # The bytes match what was written
    assert (contents.contains "[" )

#[test]
#[vfs]
def read_binary_transfers_the_whole_count()
  let path = "test_fs_read_binary_large.bin"
  let data = ("abcdefghij".repeat 200000)
  write $path $data

  open $path do |file|
    let whole = file.read $data.len
    assert_eq $whole.len $data.len
    assert_eq (str whole) $data
  remove $path

#[test]
#[vfs]
def read_at_offset()
  let path = "test_fs_read_offset.txt"
  write $path "abcdefghij"

  open $path "r" do |file|
    # An explicit offset neither consults nor moves the cursor.
    assert_eq (file.read 4 offset: 4) b"efgh"
    assert_eq $file.tell() 0
    assert_eq (file.read 4) b"abcd"
    assert_eq $file.tell() 4
    assert_eq (file.read 2 offset: 0) b"ab"
    assert_eq $file.tell() 4

    # Without a size, an offset read runs to the end of the file.
    assert_eq (file.read offset: 6) b"ghij"
    # Asking for more than is there is the end of the file, not an error.
    assert_eq (file.read 100 offset: 8) b"ij"
    assert_eq (file.read 4 offset: 100) b""
  remove $path

#[test]
#[vfs]
def read_at_offset_binary()
  let path = "test_fs_read_offset.bin"
  write $path b"\x00\x01\x02\x03\xff"

  open $path do |file|
    let chunk = (file.read 2 offset: 1)
    assert_type $Bin $chunk
    assert_eq $chunk b"\x01\x02"
    assert_eq (file.read offset: 4) b"\xff"
  remove $path

#[test]
#[vfs]
def read_at_offset_transfers_the_whole_count()
  # A single positional read is allowed to come up short — over the remote VFS
  # every one is capped at 512 KiB — so `offset:` has to loop internally.
  # Without that this returns a prefix, and only on some backends.
  let path = "test_fs_read_offset_large.txt"
  let data = ("abcdefghij".repeat 200000)
  write $path $data

  open $path "r" do |file|
    let whole = (file.read data.len offset: 0)
    assert_eq $whole.len $data.len
    assert_eq $whole $Bin(data)
    # The cursor never moved, so a streaming read still starts at the front.
    assert_eq $file.tell() 0
  remove $path

#[test]
#[vfs]
def concurrent_offset_reads_share_the_handle()
  # Positional reads neither consult nor move the cursor, so several are
  # allowed to be in flight on one handle at once. Taking the handle
  # exclusively would make the second reader fail outright rather than
  # overlap the first.
  let path = "test_fs_read_offset_concurrent.txt"
  let data = ("abcdefghij".repeat 20000)
  write $path $data

  open $path "r" do |file|
    let workers = []
    for i = (0..4)
      let worker = strand.spawn do
        file.read 1000 offset: (i * 1000)
      workers.push $worker
    for worker = workers
      assert_eq $worker.join().len 1000
    # The cursor is untouched by all of them.
    assert_eq $file.tell() 0
  remove $path

#[test]
#[vfs]
def read_after_close_fails()
  let path = "test_fs_read_closed.txt"
  write $path "content"

  # Test that reading from a closed file fails
  let f = open $path "r"
  f.close()
  assert_throws $RuntimeError do
    f.read()
  remove $path

#[test]
#[vfs]
def fs_read_reads_entire_text_file()
  let test_path = "test_fs_read.txt"
  write $test_path "alpha\nbeta\n"
  let contents = read_str $test_path
  assert_eq $contents "alpha\nbeta\n"
  assert_eq (read_str (Path test_path)) "alpha\nbeta\n"
  remove $test_path

#[test]
#[vfs]
def fs_read_reads_entire_binary_file()
  let test_path = "test_fs_read.bin"
  let data = b"\x00\x01\x02\xff"
  write $test_path $data
  assert_eq (read test_path) $data
  assert_eq ((Path test_path).read()) $data
  remove $test_path

#[test]
#[vfs]
def fs_read_grows_for_large_full_reads()
  let test_path = "test_fs_read_large.txt"
  let data = ("abcdefghij".repeat 2000)
  write $test_path $data
  assert_eq (read_str test_path) $data
  assert_eq ((Path test_path).read_str()) $data
  remove $test_path

#[test]
#[vfs]
def fs_read_rejects_invalid_utf_8_data()
  let test_path = "test_fs_read_invalid.bin"
  write $test_path b"\xff\xfe"
  let err = assert_throws $RuntimeError do
    read_str $test_path
  assert_eq (str err) "invalid UTF-8 data"
  remove $test_path

#[test]
#[vfs]
def missing_file_yields_sys_error()
  let missing = Path "missing.txt"
  let err = assert_throws $sys.NotFoundError do
    missing.read_str()
  assert_type $sys.Error $err
  let code = err.code
  assert_type $sys.ErrorCode $code
  if is_windows
    assert_type $sys.windows.WinError $code
    assert_eq $code.value 2
    assert_eq (str code) ERROR_FILE_NOT_FOUND
    assert (str(err).ends_with("(ERROR_FILE_NOT_FOUND)"))
  else
    assert_type $sys.unix.Errno $code
    if (sys.os_info().os == :LINUX:)
      assert_type $sys.linux.Errno $code
    else if (sys.os_info().os == :FREEBSD:)
      assert_type $sys.freebsd.Errno $code
    else
      assert_type $sys.macos.Errno $code
    assert_eq $code.value 2
    assert_eq $code.os $sys.os_info().os
    assert_eq (str code) ENOENT
    assert (str(err).ends_with("(ENOENT)"))

#[test]
#[vfs]
def sys_error_is_caught_by_runtime_error()
  let missing = Path "missing.txt"
  assert_throws $RuntimeError do
    missing.read_str()
