import fs std
  testlib.vfs:
    - vfs
  std:
    - ValueError
  test:
    - assert
    - assert_throws
    - assert_eq
    - fixture
    - test
  fs:
    - glob
    - symlink_dir
    - Path

#[fixture]
def populate block ...rest
  Path("src").create_dir all: true
  Path("src/lib.rs").write ""
  Path("src/foo.rs").write ""
  Path("build.rs").write ""
  block(...rest)

#[test]
#[vfs]
#[populate]
def basic()
  assert_eq [...glob "*.rs"] [Path "build.rs"]

#[test]
#[vfs]
#[populate]
def max_depth()
  assert_eq [...glob "**/*.rs" max_depth: 1] [Path "build.rs"]

#[test]
#[vfs]
#[populate]
def path()
  assert_eq [...Path("src").glob("*.rs")] [Path "src/foo.rs", Path "src/lib.rs"]

# A pattern with no wildcards names one path, so it matches that path and
# nothing else.
#
# It is partitioned entirely into the walk prefix, leaving no glob behind, and
# that used to be walked as a tree: a literal directory reported its whole
# subtree, and a literal file came back with a trailing separator (the walk root
# reports itself with an empty root-relative path, and joining that appends
# one) — `build.rs/`, which every later `stat` rejects with ENOTDIR.
#[test]
#[vfs]
#[populate]
def literal_file()
  assert_eq [...glob "build.rs"] [Path "build.rs"]
  # The consequence, not just the spelling: the result has to be usable.
  fs.remove all: true ...glob("build.rs")
  assert (!Path("build.rs").exists())

#[test]
#[vfs]
#[populate]
def literal_dir()
  assert_eq [...glob "src"] [Path "src"]

#[test]
#[vfs]
#[populate]
def literal_missing()
  assert_eq [...glob "nonexistent.rs"] []

#[test]
#[vfs]
#[populate]
def unpack_readonly()
  let paths = glob "src/*.rs"
  let first ...rest = paths
  let again ...other = paths
  let _ ...stale = paths
  assert_eq $first $again
  assert_eq ([...rest]) [Path "src/lib.rs"]
  assert_eq ([...other]) [Path "src/lib.rs"]
  assert_eq ([...paths]) [Path "src/foo.rs", Path "src/lib.rs"]
  assert_throws $std.ConcurrencyError do
    [...stale]

# `src` holds a link back out to `outside`.
#[fixture]
def with_link block ...rest
  Path("outside").create_dir()
  Path("outside/out.rs").write ""
  symlink_dir $Path("outside").canonical() (Path "src/link")
  block(...rest)

#[test]
#[vfs]
#[populate]
#[with_link]
def stops_at_links_by_default()
  assert_eq [...glob "src/**/*.rs"] [Path "src/foo.rs", Path "src/lib.rs"]
  assert_eq [...glob "src/**/*.rs" stop: :CROSS:] [Path "src/foo.rs", Path "src/lib.rs"]
  # The link itself still matches
  assert_eq [...glob "src/l*"] [Path "src/lib.rs", Path "src/link"]

#[test]
#[vfs]
#[populate]
#[with_link]
def stop_never_follows_links()
  let found = [...glob "src/**/*.rs" stop: :NEVER:]
  assert_eq $found [Path "src/foo.rs", Path "src/lib.rs", Path "src/link/out.rs"]

#[test]
#[vfs]
#[populate]
#[with_link]
def base_link_is_followed()
  assert_eq [...glob "src/link/*"] [Path "src/link/out.rs"]
  assert_eq [...Path("src/link").glob("*")] [Path "src/link/out.rs"]

#[test]
#[vfs]
#[populate]
def rejects_bad_stop()
  assert_throws $ValueError do [...glob "*" stop: :TARGET:]
  assert_throws $std.Error do [...glob "*" resolve: :LINK:]
