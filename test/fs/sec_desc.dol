import sys std
  testlib.vfs:
    - vfs
  test:
    - assert_eq
    - assert_throws
    - assert_type
    - test
  fs:
    - Path
    - open
    - remove
  fs.windows:
    - sec_desc
    - update_sec_desc
  security.windows:
    - SecDesc
    - SecInfo

#[test]
#[vfs]
def query_security_descriptors()
  let path = Path test_sec_desc.txt
  open $path w do |file|
    file.write security

  if (sys.os_info().family == :WINDOWS:)
    let descriptor = path.sec_desc()
    assert_type $SecDesc $descriptor
    assert_eq $descriptor.mask (SecInfo :OWNER: :GROUP: :DACL:)
    let shallow = path.sec_desc owner: false group: false dacl: false
    assert_eq $shallow.mask (SecInfo())
    assert_throws $std.FieldError do shallow.owner
    assert_throws $std.FieldError do shallow.group
    assert_throws $std.FieldError do shallow.dacl
    # An unloaded component is still a declared key; its getter error propagates.
    assert_throws $std.FieldError do
      bind fields(shallow)
        owner: _owner = nil
        ..._
    assert_throws $std.FieldError do shallow.owner_defaulted
    assert_throws $std.FieldError do shallow.dacl_present
    assert_type $SecDesc (sec_desc "test_sec_desc.txt")
    update_sec_desc test_sec_desc.txt $shallow
    # A descriptor whose mask is empty never reaches Windows — the backend
    # returns early — so the call above proves nothing about writing one.
    # Replaying the file's own DACL is the smallest write that does, and it
    # needs READ_CONTROL as well as WRITE_DAC on the handle.
    update_sec_desc $path (SecDesc dacl: descriptor.dacl)
    let replayed = path.sec_desc()
    assert_eq $replayed.dacl.aces.len $descriptor.dacl.aces.len
    # The same write in declarative form, straight through the method's own
    # component options.
    path.update_sec_desc
      dacl:
        for entry = descriptor.dacl.aces
          - $entry
    assert_eq (path.sec_desc().dacl.aces.len) $descriptor.dacl.aces.len
    open $path r do |file|
      assert_type $SecDesc $file.sec_desc()
  else
    assert_throws $std.UnsupportedError do path.sec_desc()
    assert_throws $sys.UnsupportedError do path.sec_desc()
    assert_throws $sys.UnsupportedError do sec_desc test_sec_desc.txt
    let empty = SecDesc b"\x01\x00\x00\x80\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00"
    assert_throws $sys.UnsupportedError do update_sec_desc test_sec_desc.txt $empty
    assert_throws $sys.UnsupportedError do
      update_sec_desc test_sec_desc.txt
        dacl:
          - allow: :LOCAL_SYSTEM:
            mask: :GENERIC_ALL:
    open $path r do |file|
      assert_throws $std.UnsupportedError do file.sec_desc()
      assert_throws $sys.UnsupportedError do file.sec_desc()

  remove $path
