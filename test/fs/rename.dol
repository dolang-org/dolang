import sys
  testlib.vfs:
    - vfs
  test:
    - assert
    - assert_eq
    - assert_throws
    - test
  std:
    - RuntimeError
    - UnsupportedError
  fs:
    - open
    - rename
    - create_dir
    - Path

#[test]
#[vfs]
def rename_file()
  let old_path = Path "old_name.txt"
  let new_path = Path "new_name.txt"

  open $old_path w do |f|
    f.write "test content"

  rename $old_path $new_path

  assert $!old_path.exists()

  open $new_path r do |f|
    let contents = f.read()
    assert_eq $contents "test content"

#[test]
#[vfs]
def rename_to_different_directory()
  let subdir = Path "subdir"
  create_dir $subdir

  let old_path = Path "file.txt"
  let new_path = (subdir / "moved.txt")

  open $old_path w do |f|
    f.write "moved content"

  rename $old_path $new_path

  assert $!old_path.exists()
  open $new_path r do |f|
    let contents = f.read()
    assert_eq $contents "moved content"

#[test]
#[vfs]
def rename_over_existing_file()
  let path1 = Path "file1.txt"
  let path2 = Path "file2.txt"

  open $path1 w do |f|
    f.write "content1"

  open $path2 w do |f|
    f.write "content2"

  rename $path1 $path2

  assert $!path1.exists()
  open $path2 r do |f|
    let contents = f.read()
    assert_eq $contents "content1"

#[test]
#[vfs]
def rename_non_existent_file_fails()
  let src = Path "nonexistent.txt"
  let dst = Path "dest.txt"

  assert_throws $RuntimeError do
    rename $src $dst

#[test]
#[vfs]
def path_rename_method()
  let src = Path "source.txt"
  let dst = Path "dest.txt"

  open $src w do |f|
    f.write "rename method"

  src.rename $dst

  assert $!src.exists()
  open $dst r do |f|
    assert_eq (f.read()) "rename method"

#[test]
#[vfs]
def rename_without_replacing_existing_file()
  let src = Path "no_replace_source.txt"
  let dst = Path "no_replace_destination.txt"
  open $src w do |f| f.write source
  open $dst w do |f| f.write destination

  if (sys.os_info().os == :FREEBSD:)
    assert_throws $UnsupportedError do rename $src $dst replace: false
  else
    assert_throws $RuntimeError do rename $src $dst replace: false

  assert_eq (src.read()) source
  assert_eq (dst.read()) destination

#[test]
#[vfs]
def path_rename_without_replacement()
  let src = Path "path_no_replace_source.txt"
  let dst = Path "path_no_replace_destination.txt"
  open $src w do |f| f.write source

  if (sys.os_info().os == :FREEBSD:)
    assert_throws $UnsupportedError do src.rename $dst replace: false
    assert $src.exists()
  else
    src.rename $dst replace: false
    assert $!src.exists()
    assert_eq (dst.read()) source
