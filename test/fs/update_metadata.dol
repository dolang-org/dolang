import sys
  test:
    - ignore
    - assert_eq
    - assert_throws
    - test

if (sys.os_info().family == :WINDOWS:)
  ignore "requires Unix"

import
  testlib.vfs:
    - vfs
  fs:
    - Path
    - update_metadata
    - open
    - remove
    - symlink
  security.unix:
    - Permission
import std:
  - RuntimeError

let :id ... = run

#[test]
#[vfs]
def numeric_id()
  let test_path = "test_chown_ids.txt"

  open $test_path w do |f|
    f.write "ownership"

  let before = Path(test_path).metadata()
  update_metadata $test_path mode: 0o600 owner: $before.uid group: $before.gid
  let after = Path(test_path).metadata()
  assert_eq $after.uid $before.uid
  assert_eq $after.gid $before.gid
  assert_eq $after.mode.owner (Permission :READ: :WRITE:)
  assert_eq $after.mode.group (Permission())
  assert_eq $after.mode.other (Permission())

  remove $test_path

#[test]
#[vfs]
def multiple_paths()
  let first = "test_update_metadata_first.txt"
  let second = "test_update_metadata_second.txt"

  open $first w do |f|
    f.write "first"
  open $second w do |f|
    f.write "second"

  update_metadata $first $second mode: 0o600
  assert_eq $Path(first).metadata().mode.owner (Permission :READ: :WRITE:)
  assert_eq $Path(second).metadata().mode.owner (Permission :READ: :WRITE:)

  remove $first $second

#[test]
#[vfs]
def owner_and_group_name()
  let test_path = "test_chown_names.txt"

  open $test_path w do |f|
    f.write "ownership"

  let owner = sub $id -un
  let group = sub $id -gn
  let uid = int $ sub $id -u
  let gid = int $ sub $id -g
  Path(test_path).update_metadata owner: $owner group: $group
  let after = Path(test_path).metadata()
  assert_eq $after.uid $uid
  assert_eq $after.gid $gid

  remove $test_path

#[test]
#[vfs]
def group_only()
  let test_path = "test_chown_group.txt"

  open $test_path w do |f|
    f.write "ownership"

  let before = Path(test_path).metadata()
  update_metadata $test_path group: $before.gid
  let after = Path(test_path).metadata()
  assert_eq $after.uid $before.uid
  assert_eq $after.gid $before.gid

  remove $test_path

#[test]
#[vfs]
def empty_patch_is_noop()
  let test_path = "test_chown_missing.txt"

  open $test_path w do |f|
    f.write "ownership"

  update_metadata $test_path

  remove $test_path

#[test]
#[vfs]
def unknown_owner_fails()
  let test_path = "test_chown_unknown.txt"

  open $test_path w do |f|
    f.write "ownership"

  assert_throws $RuntimeError do
    update_metadata $test_path owner: "__dolang_missing_user__"

  remove $test_path

#[test]
#[vfs]
def follow_controls_symlink_handling()
  let link_path = "test_chown_link"
  let missing_target = "test_chown_missing_target"
  let group = sub $id -gn

  remove $link_path ignore: true

  symlink $missing_target $link_path

  update_metadata $link_path group: $group resolve: :LINK:

  assert_throws $sys.NotFoundError do
    update_metadata $link_path group: $group resolve: :TARGET:

  remove $link_path
