import
  testlib.vfs:
    - vfs
  test:
    - assert
    - assert_throws
    - assert_eq
    - test
  fs:
    - read_str
    - open
    - Path
    - BaseFile
    - File
    - RawFile
  std:
    - StateError
    - TypeError
    - ValueError
  sys:
    - AlreadyExistsError

#[test]
#[vfs]
def basic_open()
  let path = "open_basic.txt"
  open $path w do |file|
    file.write "hello"

  # Test basic open without block
  let f = open $path r
  let debug_str = dbg $f
  assert_eq $debug_str "<fs.File>"
  f.close()
  f.close()

#[test]
#[vfs]
def block_scope()
  let path = "open_block.txt"
  open $path w do |file|
    file.write "hello"

  # Test block scope syntax
  let result = open $path r do |file|
    let s = dbg $file
    assert_eq $s "<fs.File>"
    "success"
  assert_eq $result "success"


#[test]
#[vfs]
def buffer_chooses_types()
  for mode = ["r", "w", "a", "r+", "w+", "a+"]
    open modes.txt w do |file| file.write "hello\n"
    for path = ["modes.txt", Path("modes.txt")]
      let file = if (type path Path)
        path.open $mode
      else
        open $path $mode
      assert (type file File)
      assert (type file BaseFile)
      assert $!(type file RawFile)
      file.close()
      file.close()
      let raw = if (type path Path)
        path.open $mode buffer: false
      else
        open $path $mode buffer: false
      assert (type raw RawFile)
      assert (type raw BaseFile)
      assert $!(type raw File)
      assert_eq (dbg raw) "<fs.RawFile>"
      raw.close()
      if (type path Path)
        path.open $mode buffer: true do |file| assert (type file File)
        path.open $mode buffer: false do |file| assert (type file RawFile)
      else
        open $path $mode buffer: true do |file| assert (type file File)
        open $path $mode buffer: false do |file| assert (type file RawFile)

#[test]
#[vfs]
def b_modes_are_rejected()
  open modes.txt w do |file| file.write "hello"
  for mode = ["rb", "wb", "r+b", "a+b"]
    let err = assert_throws $ValueError do open modes.txt $mode
    assert ((str err).contains "buffer: false")
    assert_throws $ValueError do (Path "modes.txt").open $mode
  let err = assert_throws $ValueError do open modes.txt q
  assert $!((str err).contains "buffer")
  assert_throws $TypeError do open modes.txt buffer: 1
  assert_throws $TypeError do open modes.txt buffer: nil

#[test]
#[vfs]
def exclusive_modes_create_new_files()
  open fresh.txt x do |file| file.write "one"
  assert_eq (read_str "fresh.txt") "one"
  assert_throws $AlreadyExistsError do open fresh.txt x
  assert_throws $AlreadyExistsError do (Path "fresh.txt").open x+
  open fresh-rw.txt x+ do |file|
    file.write "two"
    file.seek start: 0
    assert_eq (file.read_str()) "two"

#[test]
#[vfs]
def default_modes_and_block_cleanup()
  open default.txt w do |file| file.write "hello"
  let path = Path default.txt
  let first = open default.txt
  let second = path.open()
  assert (type first File)
  assert (type second File)
  first.close()
  second.close()
  open default.txt do |file| assert (type file File)
  path.open do |file| assert (type file File)
  open default.txt buffer: false do |file| assert (type file RawFile)
  path.open buffer: false do |file| assert (type file RawFile)
  for buffer = [true, false]
    let held = nil
    open default.txt :buffer do |file|
      held = file
    assert_throws $StateError do held.read()
    assert_throws $ValueError do
      path.open :buffer do |file|
        held = file
        throw (ValueError "test error")
    assert_throws $StateError do held.read()

#[test]
#[vfs]
def block_form_flushes_buffered_writes()
  open flushed.txt w do |file|
    file.write "pending"
    assert_eq (read_str "flushed.txt") ""
  assert_eq (read_str "flushed.txt") "pending"

#[test]
#[vfs]
def reads_and_iteration_depend_on_buffering()
  open values.txt w do |file| file.write "one\ntwo\n"
  open values.txt do |file|
    assert_eq (file.read 4) b"one\n"
    assert_eq $file.next() "two\n"
    file.seek start: 0
    for line = file
      assert (type line Str)
  open values.txt buffer: false do |file|
    assert_eq (file.read 4) b"one\n"
    assert_eq $file.next() b"two\n"
    file.seek start: 0
    for chunk = file
      assert (type chunk Bin)

#[test]
#[vfs]
def kinds_can_be_matched()
  open match.txt w do |file| file.write "hello"
  for buffer = [true, false]
    open match.txt :buffer do |file|
      let label = match file
        File(_) do "buffered"
        RawFile(_) do "raw"
      assert_eq $label (buffer && "buffered" || "raw")
