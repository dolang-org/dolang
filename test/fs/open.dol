import
  io:
    - Io
  testlib.vfs:
    - vfs
  test:
    - assert
    - assert_throws
    - assert_eq
    - test
  fs:
    - metadata
    - create_dir
    - read_str
    - open
    - symlink_file
    - Path
    - BaseFile
    - File
    - RawFile
  std:
    - StateError
    - TypeError
    - ValueError
  sys:
    - AlreadyExistsError
    - Error
    - NotFoundError
    - os_info
    - UnsupportedError

#[test]
#[vfs]
def basic_open()
  let path = "open_basic.txt"
  open $path w do |file|
    file.write "hello"

  # Test basic open without block
  let f = open $path r
  let debug_str = dbg $f
  assert_eq $debug_str "<fs.File>"
  f.close()
  f.close()

#[test]
#[vfs]
def block_scope()
  let path = "open_block.txt"
  open $path w do |file|
    file.write "hello"

  # Test block scope syntax
  let result = open $path r do |file|
    let s = dbg $file
    assert_eq $s "<fs.File>"
    "success"
  assert_eq $result "success"


#[test]
#[vfs]
def buffer_chooses_types()
  for mode = ["r", "w", "a", "r+", "w+", "a+"]
    open modes.txt w do |file| file.write "hello\n"
    for path = ["modes.txt", Path("modes.txt")]
      let file = if (type path Path)
        path.open $mode
      else
        open $path $mode
      assert (type file File)
      assert (type file BaseFile)
      assert $!(type file RawFile)
      file.close()
      file.close()
      let raw = if (type path Path)
        path.open $mode buffer: false
      else
        open $path $mode buffer: false
      assert (type raw RawFile)
      assert (type raw BaseFile)
      assert $!(type raw File)
      assert_eq (dbg raw) "<fs.RawFile>"
      raw.close()
      if (type path Path)
        path.open $mode buffer: true do |file| assert (type file File)
        path.open $mode buffer: false do |file| assert (type file RawFile)
      else
        open $path $mode buffer: true do |file| assert (type file File)
        open $path $mode buffer: false do |file| assert (type file RawFile)

#[test]
#[vfs]
def b_modes_are_rejected()
  open modes.txt w do |file| file.write "hello"
  for mode = ["rb", "wb", "r+b", "a+b"]
    let err = assert_throws $ValueError do open modes.txt $mode
    assert ((str err).contains "buffer: false")
    assert_throws $ValueError do (Path "modes.txt").open $mode
  let err = assert_throws $ValueError do open modes.txt q
  assert $!((str err).contains "buffer")
  assert_throws $TypeError do open modes.txt buffer: 1
  assert_throws $TypeError do open modes.txt buffer: nil

#[test]
#[vfs]
def exclusive_modes_create_new_files()
  open fresh.txt x do |file| file.write "one"
  assert_eq (read_str "fresh.txt") "one"
  assert_throws $AlreadyExistsError do open fresh.txt x
  assert_throws $AlreadyExistsError do (Path "fresh.txt").open x+
  open fresh-rw.txt x+ do |file|
    file.write "two"
    file.seek start: 0
    assert_eq (file.read_str()) "two"

#[test]
#[vfs]
def default_modes_and_block_cleanup()
  open default.txt w do |file| file.write "hello"
  let path = Path default.txt
  let first = open default.txt
  let second = path.open()
  assert (type first File)
  assert (type second File)
  first.close()
  second.close()
  open default.txt do |file| assert (type file File)
  path.open do |file| assert (type file File)
  open default.txt buffer: false do |file| assert (type file RawFile)
  path.open buffer: false do |file| assert (type file RawFile)
  for buffer = [true, false]
    let held = nil
    open default.txt :buffer do |file|
      held = file
    assert_throws $StateError do held.read()
    assert_throws $ValueError do
      path.open :buffer do |file|
        held = file
        throw (ValueError "test error")
    assert_throws $StateError do held.read()

#[test]
#[vfs]
def block_form_flushes_buffered_writes()
  open flushed.txt w do |file|
    file.write "pending"
    assert_eq (read_str "flushed.txt") ""
  assert_eq (read_str "flushed.txt") "pending"

#[test]
#[vfs]
def reads_and_iteration_depend_on_buffering()
  open values.txt w do |file| file.write "one\ntwo\n"
  open values.txt do |file|
    assert_eq (file.read 4) b"one\n"
    assert_eq $file.next() "two\n"
    file.seek start: 0
    for line = file
      assert (type line Str)
  open values.txt buffer: false do |file|
    assert_eq (file.read 4) b"one\n"
    assert_eq $file.next() b"two\n"
    file.seek start: 0
    for chunk = file
      assert (type chunk Bin)

#[test]
#[vfs]
def kinds_can_be_matched()
  open match.txt w do |file| file.write "hello"
  for buffer = [true, false]
    open match.txt :buffer do |file|
      let label = match file
        File(_) do "buffered"
        RawFile(_) do "raw"
      assert_eq $label (buffer && "buffered" || "raw")

#[test]
#[vfs]
def files_are_io_streams()
  open io.txt w do |file| file.write "hello"
  for buffer = [true, false]
    open io.txt :buffer do |file|
      assert (type file BaseFile)
      assert (type file Io)

#[test]
#[vfs]
def capabilities_follow_the_mode()
  open caps.txt w do |file| file.write "hello"
  let cases = $
    - ("r", [true, false, true])
    - ("w", [false, true, true])
    - ("r+", [true, true, true])
    - ("a", [false, true, false])
  for buffer = [true, false]
    for mode caps = cases
      let file = open caps.txt $mode :buffer
      assert_eq [file.readable, file.writable, file.seekable] $caps
      file.close()
      assert_eq [file.readable, file.writable, file.seekable] [false, false, false]

#[test]
#[vfs]
def granular_access()
  open access.txt w do |file| file.write "hello"
  # No access keyword reads
  open access.txt do |file|
    assert_eq [file.readable, file.writable] [true, false]
  # Any access keyword grants only what it asks for
  open access.txt write: true do |file|
    assert_eq [file.readable, file.writable, file.seekable] [false, true, true]
    file.write "J"
  assert_eq (read_str "access.txt") "Jello"
  open access.txt read: true write: :APPEND: do |file|
    assert_eq [file.readable, file.writable, file.seekable] [true, true, false]
    file.write "!"
  assert_eq (read_str "access.txt") "Jello!"
  open access.txt write: :APPEND: buffer: false do |file|
    file.write "?"
  assert_eq (read_str "access.txt") "Jello!?"
  assert_throws $TypeError do open access.txt write: :TRUNCATE:

#[test]
#[vfs]
def granular_disposition()
  # Nothing is created or truncated unless asked for
  assert_throws $NotFoundError do open missing.txt write: true
  assert_throws $NotFoundError do open missing.txt write: true exists: :TRUNCATE:
  open created.txt write: true missing: :CREATE: do |file| file.write "abc"
  # Create or update in place
  open created.txt write: true missing: :CREATE: do |file| file.write "X"
  assert_eq (read_str "created.txt") "Xbc"
  open created.txt write: true exists: :TRUNCATE: do |file| file.write "new"
  assert_eq (read_str "created.txt") "new"
  # An exclusive create defaults to creating
  assert_throws $AlreadyExistsError do open created.txt write: true exists: :FAIL:
  open exclusive.txt write: true exists: :FAIL: do |file| file.write "x"
  assert_eq (read_str "exclusive.txt") "x"
  # Creating a file opened only for reading
  open readonly.txt missing: :CREATE: do |file|
    assert_eq (file.read_str()) ""
  assert_eq (read_str "readonly.txt") ""

#[test]
#[vfs]
def granular_conflicts()
  open conflicts.txt w do |file| file.write "x"
  assert_throws $ValueError do open conflicts.txt exists: :FAIL: missing: :FAIL:
  assert_throws $ValueError do open conflicts.txt write: :APPEND: exists: :TRUNCATE:
  assert_throws $ValueError do open conflicts.txt exists: :TRUNCATE:
  assert_throws $ValueError do open conflicts.txt exists: :OVERWRITE:
  # A mode string combines with none of the granular keywords
  for options = [(read: true), (exists: :OPEN:), (mode: 0o600), (backup: false)]
    assert_throws $ValueError do open conflicts.txt r ...options
    assert_throws $ValueError do (Path "conflicts.txt").open r ...options

#[test]
#[vfs]
def creation_mode()
  if (os_info().family != :UNIX:)
    assert_throws $UnsupportedError do open mode.txt write: true missing: :CREATE: mode: 0o600
    return nil
  open mode.txt write: true exists: :FAIL: mode: 0o600 do |_| nil
  assert_eq (metadata("mode.txt").mode.int & 0o777) 0o600
  # Only a created file gets it
  open mode.txt write: true missing: :CREATE: mode: 0o644 do |_| nil
  assert_eq (metadata("mode.txt").mode.int & 0o777) 0o600

#[test]
#[vfs]
def windows_only_options()
  if (os_info().family == :WINDOWS:)
    return nil
  open windows.txt w do |file| file.write "x"
  let cases = $
    - (share: :READ:)
    - (access: :READ_DATA:)
    - (backup: true)
    - (hidden: true)
    - (sec_desc: {})
  for options = cases
    assert_throws $UnsupportedError do open windows.txt ...options
  # Sharing everything is the default everywhere
  open windows.txt share: [:READ:, :WRITE:, :DELETE:] do |file|
    assert_eq (file.read_str()) "x"

#[test]
#[vfs]
def windows_options()
  if (os_info().family != :WINDOWS:)
    return nil
  open shared.txt w do |file| file.write "x"
  # A handle that shares nothing keeps every other open out
  open shared.txt share: [] do |_|
    assert_throws $Error do open shared.txt
  open shared.txt share: :READ: do |_|
    open shared.txt do |file| assert_eq (file.read_str()) "x"
    assert_throws $Error do open shared.txt write: true

  # Exact rights decide what the handle can do
  open shared.txt access: :READ_ATTRIBUTES: do |file|
    assert_eq [file.readable, file.writable] [false, false]
  open shared.txt access: [:READ_DATA:, :SYNCHRONIZE:] do |file|
    assert_eq [file.readable, file.writable] [true, false]
    assert_eq (file.read_str()) "x"
  open shared.txt access: :APPEND_DATA: do |file|
    assert_eq [file.readable, file.writable, file.seekable] [false, true, false]

  # Attributes apply only to a created file
  open hidden.txt write: true exists: :FAIL: hidden: true do |_| nil
  assert_eq (metadata("hidden.txt").hidden) true
  open shared.txt write: true missing: :CREATE: hidden: true do |_| nil
  assert_eq (metadata("shared.txt").hidden) false

  # The security descriptor is set as the file is created. Wine doesn't keep
  # descriptors faithfully, so only the open itself is checked there.
  let sd_path = (Path "created_sd.txt")
  let spec = $
    dacl:
      - allow: :EVERYONE:
        mask: :GENERIC_ALL:
    dacl_protected: true
  open $sd_path write: true exists: :FAIL: sec_desc: $spec do |file|
    file.write "x"
  if !os_info().is_wine
    let created = sd_path.sec_desc()
    assert_eq $created.dacl_protected true
    assert_eq $created.dacl.aces.len 1

  # Backup semantics open a directory
  create_dir dir_handle
  assert_throws $Error do open dir_handle read: false
  open dir_handle read: false backup: true do |file|
    assert_eq [file.readable, file.writable] [false, false]

#[test]
#[vfs]
def link_handles()
  if (os_info().os != :LINUX:)
    return nil
  open link_target.txt w do |file| file.write "x"
  symlink_file link_target.txt link.txt
  open link.txt read: false resolve: :LINK: do |file|
    assert_eq [file.readable, file.writable] [false, false]
