import test:
  - assert
  - assert_eq
  - assert_throws
  - test

import fs:
  - create_dir
  - open
  - read
  - write
  - append
  - remove
  - Path

import testlib.vfs:
  - vfs
import sys
import shell
import std:
  - RuntimeError
  - StateError
  - TypeError

#[test]
#[vfs]
def write_and_read_back_text()
    # Test writing text and reading it back
    let test_path = "test_write_text.txt"

    # Write text to file
    open $test_path w do |f|
      let written = f.write "Hello, World!"
      assert_eq $written 13

    # Read it back
    open $test_path r do |f|
      let contents = f.read()
      assert_eq $contents "Hello, World!"

    # Cleanup
    remove $test_path

#[test]
#[vfs]
def write_binary_data()
    # Test writing binary data using binary string literals
    let test_path = "test_write_binary.bin"
    let binary_data = b"Hello"

    # Write binary data
    open $test_path wb do |f|
      let written = f.write $binary_data
      assert (written > 0)

    # Read it back in binary mode
    open $test_path rb do |f|
      let contents = f.read()
      assert_eq $contents $binary_data

    # Cleanup
    remove $test_path

# `put` writes a value's own bytes and invents nothing -- no terminator, and
# no type-dependent carve-out for `Bin`. What goes in is what lands on disk.
#[test]
#[vfs]
def sink_put_is_verbatim_for_every_value_type()
    let test_path = "test_sink_put.txt"
    open $test_path w do |file|
      file.put "line"
      file.put b"BIN"
      file.put 42

    open $test_path rb do |file|
      assert_eq $file.read() b"lineBIN42"

# Terminators are opt-in, and come out identical on every platform unless the
# script asks for the target's own ending.
#[test]
#[vfs]
def sink_put_terminates_only_when_asked()
    let test_path = "test_sink_crimp.txt"
    open $test_path w do |file|
      let out = file.precrimp()
      out.put "one"
      out.put "two"

    open $test_path rb do |file|
      assert_eq $file.read() b"one\ntwo\n"

    open $test_path w do |file|
      let out = file.precrimp(shell.line_ending())
      out.put "one"

    let expected = if (sys.os_info().family == :WINDOWS:)
      b"one\r\n"
    else
      b"one\n"
    open $test_path rb do |file|
      assert_eq $file.read() $expected

#[test]
#[vfs]
def write_at_offset()
    let test_path = "test_write_offset.txt"
    write $test_path "abcdefghij"

    open $test_path "r+" do |f|
      # An explicit offset neither consults nor moves the cursor.
      assert_eq (f.write "XY" offset: 2) 2
      assert_eq $f.tell() 0
      assert_eq $f.read(4) "abXY"
      assert_eq $f.tell() 4

      # Writing past the end extends the file, zero-filling the gap.
      assert_eq (f.write "Z" offset: 11) 1

    assert_eq (read test_path) "abXYefghij\0Z"
    remove $test_path

#[test]
#[vfs]
def write_at_offset_transfers_the_whole_count()
    # One positional write may transfer less than asked, so `offset:` loops
    # internally; without that this leaves a truncated file on some backends.
    let test_path = "test_write_offset_large.txt"
    let data = ("abcdefghij".repeat 200000)

    open $test_path "w+" do |f|
      assert_eq (f.write data offset: 0) $data.len
    assert_eq (read test_path) $data
    remove $test_path

#[test]
#[vfs]
def write_at_offset_is_refused_in_append_mode()
    # Every write on an append handle lands at the end regardless of the
    # offset the platform is handed, so an offset cannot be honored at all.
    let test_path = "test_write_offset_append.txt"
    write $test_path "abc"

    open $test_path a do |f|
      assert_throws $StateError do
        f.write "X" offset: 0
      # The handle still works without one.
      assert_eq (f.write "d") 1

    assert_eq (read test_path) "abcd"
    remove $test_path

#[test]
#[vfs]
def write_to_file_opened_in_append_mode()
    # Test appending to a file
    let test_path = "test_append.txt"

    # Write initial content
    open $test_path w do |f|
      f.write "First line"

    # Append more content
    open $test_path a do |f|
      let written = f.write "\nSecond line"
      assert (written > 0)

    # Read all content
    open $test_path r do |f|
      let contents = f.read()
      assert (contents.contains "First line")
      assert (contents.contains "Second line")

    # Cleanup
    remove $test_path

#[test]
#[vfs]
def write_after_close_fails()
    # Test that writing to a closed file fails
    let test_path = "test_write_closed.txt"

    open $test_path w do |f|
      f.close()
      assert_throws $RuntimeError do
        f.write "should fail"

    # Cleanup
    remove $test_path

#[test]
#[vfs]
def remove_file()
    # Test removing a file
    let test_path = "test_remove.txt"

    # Create a file first
    open $test_path w do |f|
      f.write "delete me"

    # Remove the file
    remove $test_path

    # Verify file is gone by trying to read it (should fail)
    assert_throws $RuntimeError do
      open $test_path "r" do |_f|
        false  # Should not reach here

#[test]
#[vfs]
def remove_non_existent_file_fails()
    # Test that removing a non-existent file fails
    let test_path = "test_remove_nonexistent.txt"

    # Ensure file doesn't exist
    assert_throws $RuntimeError do
      remove $test_path

#[test]
#[vfs]
def remove_ignores_missing_path_when_requested()
    remove "test_remove_ignore.txt" ignore: true

#[test]
#[vfs]
def remove_free_function_is_variadic()
    write "test_remove_first.txt" "a"
    write "test_remove_second.txt" "b"
    remove "test_remove_first.txt" "test_remove_second.txt"
    assert (!(Path "test_remove_first.txt").exists())
    assert (!(Path "test_remove_second.txt").exists())

#[test]
#[vfs]
def remove_all_removes_directory_trees()
    create_dir "test_remove_all/subdir" all: true
    write "test_remove_all/subdir/file.txt" "hello"
    remove "test_remove_all" all: true
    assert (!(Path "test_remove_all").exists())

#[test]
#[vfs]
def fs_write_writes_and_truncates_text_file()
    let test_path = "test_fs_write_text.txt"
    assert_eq (write test_path "Hello from fs.write") 19
    assert_eq (read test_path) "Hello from fs.write"
    assert_eq (write (Path test_path) "short") 5
    assert_eq ((Path test_path).read()) "short"
    remove $test_path

#[test]
#[vfs]
def fs_write_writes_binary_data()
    let test_path = "test_fs_write_binary.bin"
    assert_eq (write test_path b"Hello") 5
    assert_eq ((Path test_path).read "b") b"Hello"
    remove $test_path

#[test]
#[vfs]
def fs_append_appends_and_creates_text_files()
    let test_path = "test_fs_append_text.txt"
    remove $test_path ignore: true
    assert_eq (append test_path "first") 5
    assert_eq (append test_path " second") 7
    assert_eq (read test_path) "first second"
    remove $test_path

#[test]
#[vfs]
def path_append_appends_binary_data()
    let test_path = Path "test_path_append_binary.bin"
    test_path.write b"one"
    assert_eq (test_path.append b"two") 3
    assert_eq (test_path.read "b") b"onetwo"
    test_path.remove()

#[test]
#[vfs]
def path_remove_supports_all_and_ignore()
    let dir = Path "test_path_remove"
    (dir / "nested").create_dir all: true
    write (dir / "nested" / "file.txt") "payload"
    dir.remove all: true
    assert (!dir.exists())
    dir.remove ignore: true


#[test]
#[vfs]
def text_write_rejects_binary_without_changing_file()
  open restricted.txt w+ do |file|
    file.write "unchanged"
    assert_throws $TypeError do file.write b"bad"
    assert_throws $TypeError do file.write b"bad" offset: 0
    assert_eq $file.tell() 9
    file.seek start: 0
    assert_eq $file.read() "unchanged"

#[test]
#[vfs]
def binary_write_accepts_utf8_strings()
  open utf8.bin w+b do |file|
    assert_eq (file.write "hé") 3
    assert_eq (file.write "é" offset: 0) 2
    assert_eq $file.tell() 3
    file.seek start: 0
    assert_eq $file.read() b"\xc3\xa9\xa9"
    file.put 42
    file.put "text"
    file.put b"bytes"
    file.seek start: 3
    assert_eq $file.read() b"42textbytes"
