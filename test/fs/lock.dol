import strand sys
  testlib.vfs:
    - vfs
  test:
    - assert
    - assert_eq
    - assert_throws
    - ignore
    - test
  fs:
    - open
  std:
    - CanceledError
    - RuntimeError
  time:
    - sleep

#[test]
#[vfs]
def scoped_file_locks()
  if (sys.os_info().os == :FREEBSD:)
    ignore "requires byte-range locks"
  let path = "file_lock.bin"
  open $path w+ do |first|
    open $path r+ do |second|
      let result = first.lock (0..10) do |_|
        second.try_lock (0..10) do |other|
          assert_eq $other nil
        second.try_lock (10..20) do |other|
          assert $other
        :LOCKED:
      assert_eq $result :LOCKED:

      second.try_lock (0..10) do |acquired|
        let guard = acquired
        else throw RuntimeError "lock was not acquired"
        guard.release()
        guard.release()
        first.try_lock (0..10) do |other|
          assert $other

#[test]
#[vfs]
def shared_file_locks()
  let path = "shared_file_lock.bin"
  open $path w+ do |first|
    open $path r+ do |second|
      open $path r+ do |third|
        first.lock (..) shared: true do |_|
          second.try_lock (..) shared: true do |second_guard|
            assert $second_guard
            third.try_lock (..) do |exclusive|
              assert_eq $exclusive nil

#[test]
#[vfs]
def finite_empty_range_behavior()
  let path = "empty_file_lock.bin"
  open $path w+ do |first|
    if (sys.os_info().family == :WINDOWS:)
      open $path r+ do |second|
        assert_throws $RuntimeError do
          first.lock (0..0) do |_|
            nil
        first.lock (4..4) do |_|
          second.try_lock (..) do |whole|
            assert_eq $whole nil
          second.try_lock (4..4) do |same|
            assert $same
          second.try_lock (4..8) do |starting_at_offset|
            assert $starting_at_offset
          second.try_lock (3..5) do |containing|
            assert_eq $containing nil
    else
      assert_throws $RuntimeError do
        first.lock (4..4) do |_|
          nil

#[test]
#[vfs]
def cancellation_awaits_unlock()
  let path = "canceled_file_lock.bin"
  open $path w+ do |first|
    open $path r+ do |second|
      let acquired_send acquired_recv = strand.channel()
      let worker = strand.spawn do
        first.lock (..) do |_|
          acquired_send.put true
          sleep 10000
      acquired_recv.next()
      worker.cancel()
      assert_throws $CanceledError do worker.join()
      second.try_lock (..) do |guard|
        assert $guard

#[test]
#[vfs]
def closing_file_releases_scoped_locks()
  let path = "closed_file_lock.bin"
  open $path w+ do |first|
    open $path r+ do |second|
      first.lock (..) do |guard|
        first.close()
        second.try_lock (..) do |other|
          assert $other
        guard.release()

#[test]
#[vfs]
def unscoped_lock_excludes_until_released()
  let path = "unscoped_file_lock.bin"
  open $path w+ do |first|
    open $path r+ do |second|
      let lock = first.lock (..)
      second.try_lock (..) do |other|
        assert_eq $other nil
      lock.release()
      lock.release()
      second.try_lock (..) do |other|
        assert $other

#[test]
#[vfs]
def unscoped_try_lock_returns_lock_or_nil()
  let path = "unscoped_try_file_lock.bin"
  open $path w+ do |first|
    open $path r+ do |second|
      open $path r+ do |third|
        first.lock (..) do |_|
          assert_eq (second.try_lock (..)) nil
        let first_shared = first.try_lock (..) shared: true
        else throw RuntimeError "first shared lock was not acquired"
        let second_shared = second.try_lock (..) shared: true
        else throw RuntimeError "second shared lock was not acquired"
        assert_eq (third.try_lock (..)) nil
        first_shared.release()
        second_shared.release()
        let acquired = third.try_lock (..)
        else throw RuntimeError "exclusive lock was not acquired"
        acquired.release()

#[test]
#[vfs]
def closing_file_releases_unscoped_locks()
  let path = "closed_unscoped_file_lock.bin"
  let first = open $path w+
  open $path r+ do |second|
    let lock = first.lock (..)
    first.close()
    second.try_lock (..) do |other|
      assert $other
    lock.release()
