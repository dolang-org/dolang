import compile load strand
  test:
    - assert_eq
    - assert_type
    - assert_throws
    - parametrize
    - test
  std:
    - ImportError
    - RuntimeError
    - StateError
    - TypeError
import load:
  import: global_import

# A module stand-in for import handlers to return.
class Answer
  pub field answer

  def (init) self answer
    self.answer = answer

#[test]
def synthetic_module()
  let handle = load.import_handler do |name|
    if (name == "synthetic_basic")
      Answer 42
    else
      throw ImportError(name)

  assert_type $load.ImportHandler $handle

  import synthetic_basic: synthetic

  assert_eq $synthetic.answer 42
  handle.unregister()

#[test]
def fallback_after_import_error()
  let seen = []

  let first = load.import_handler do |name|
    if (name == "synthetic_fallback")
      seen.push $name
    throw ImportError(name)

  let second = load.import_handler do |name|
    if (name == "synthetic_fallback")
      seen.push $name
      Answer 7
    else
      throw ImportError(name)

  import synthetic_fallback: synthetic

  assert_eq $synthetic.answer 7
  assert_eq $seen.len 2
  assert_eq $seen[0] "synthetic_fallback"
  assert_eq $seen[1] "synthetic_fallback"
  second.unregister()
  first.unregister()

#[test]
def non_import_error_aborts()
  let first = load.import_handler do |name|
    if (name == "existing_module")
      throw TypeError("boom")
    else
      throw ImportError(name)

  let second = load.import_handler do |name|
    if (name == "existing_module")
      Answer 99
    else
      throw ImportError(name)

  let err = assert_throws $TypeError do
    import existing_module:
      - answer
    answer
  assert_eq (str err) "type error: boom"

  second.unregister()
  first.unregister()

#[test]
def unregister()
  let handle = load.import_handler do |name|
    if (name == "synthetic_unregister")
      Answer 1
    else
      throw ImportError(name)

  handle.unregister()

  let err = assert_throws $ImportError do
    import synthetic_unregister: _
  assert_eq (str err) "module not found: synthetic_unregister"

#[test]
def execute()
  assert_eq 2 $ load.run $ (compile.compile "test.dol" "(1 + 1)").emit()

#[test]
def load_rejects_invalid_bytecode()
  let err = assert_throws $load.BytecodeError do load.load b"not bytecode"
  assert_type $RuntimeError $err
  assert_throws $load.BytecodeError do load.run b"not bytecode"

#[test]
def loaded_bytecode_runs_once()
  let program = load.load $ (compile.compile "test.dol" "(1 + 1)").emit()
  assert_type $load.Bytecode $program
  assert_eq $program.run() 2
  let err = assert_throws $StateError do program.run()
  assert_eq (str err) "state error: bytecode already run"

#[test]
def run_consumes_loaded_bytecode()
  let program = load.load $ (compile.compile "test.dol" "(1 + 1)").emit()
  assert_eq 2 $ load.run $program
  assert_throws $StateError do load.run $program

#[test]
def loaded_bytecode_program_importer()
  let importer = do |_name| Answer 5
  let source = |
    import virtual
    virtual.answer
  let program = load.load $ (compile.compile "test.dol" source).emit()
  assert_eq $program.run(importer: importer) 5

#[test]
def nested_bytecode_error_propagates_from_run()
  let source = |
    import load
    load.run b"not bytecode"
  let program = load.load $ (compile.compile "nested.dol" source).emit()
  assert_throws $load.BytecodeError do program.run()

#[test]
def program_importer()
  let seen = []
  let importer = do |name|
    seen.push $name
    Answer $seen.len
  let source = |
    import std: first
    import std: second
    [first.answer, second.answer]
  let bytecode = (compile.compile "test.dol" source).emit()

  let result = load.run $bytecode importer: $importer
  assert_eq $result [1, 2]
  assert_eq $seen ["std", "std"]

#[test]
def retained_function_uses_program_importer()
  let seen = []
  let importer = do |name|
    seen.push $name
    Answer 42
  let source = |
    pub def later()
      import retained_dependency: dependency
      dependency.answer
  let bytecode = (compile.compile "retained.dol" source module: "retained").emit()
  let module = load.run $bytecode importer: $importer

  assert_eq $module.later() 42
  assert_eq $seen ["retained_dependency"]

#[test]
def program_importer_explicit_fallback()
  let importer = do |name| global_import $name
  let source = |
    import std
    (type(std) == std.Module)
  let bytecode = (compile.compile "fallback.dol" source).emit()

  assert_eq true $ load.run $bytecode importer: $importer

# Compile without type checking so the VM must enforce channel isolation.
def channel_module name fail = false
  let source = r|
    import strand std
    pub let seen = [...strand.input()]
    strand.put module_output
  if fail
    source = "$(source)throw std.TypeError(\"module failed\")\n"
  (compile.compile "channels.dol" source module: name).emit()

def check_import_channels program_specific fail
  let name = "isolated_$(program_specific)_$(fail)"
  let module_code = channel_module $name $fail
  let importer = do |requested|
    if (requested == name)
      load.run $module_code
    else if program_specific
      global_import $requested
    else
      throw ImportError(requested)
  let handle = if !program_specific
    load.import_handler $importer
  let script = (compile.compile "caller.dol" "import $name: m\nm.seen\n").emit()
  let output = []
  try
    strand.pipeline input: [11, 12] output: $output
      do
        let input = strand.input()
        let sink = strand.output()
        let run = do
          if program_specific
            load.run $script importer: $importer
          else
            load.run $script
        if fail
          assert_throws $TypeError $run
        else
          assert_eq $run() []
          # Repeat to exercise the global cache or repeated program importer.
          assert_eq $run() []
        assert_eq (strand.input()) $input
        assert_eq (strand.output()) $sink
        strand.put $input.next()
        strand.put $input.next()
    assert_eq $output [11, 12]
  finally
    if !program_specific
      handle.unregister()

#[test]
def global_import_channels()
  check_import_channels false false

#[test]
def global_import_error_restores_channels()
  check_import_channels false true

#[test]
def program_import_channels()
  check_import_channels true false

#[test]
def program_import_error_restores_channels()
  check_import_channels true true

#[test]
def fallback_and_nested_import_channels()
  let seen = []
  let first = load.import_handler do |name|
    if (name == "isolated_outer" || name == "isolated_inner")
      seen.push [...strand.input()]
      strand.put declined_output
    throw ImportError(name)
  let second = load.import_handler do |name|
    if (name == "isolated_outer")
      let code = (compile.compile "outer.dol" "import isolated_inner: inner\ninner\n").emit()
      load.run $code
    else if (name == "isolated_inner")
      load.run $ channel_module $name
    else
      throw ImportError(name)
  let output = []
  try
    strand.redirect input: [42] output: $output do
      let module = global_import isolated_outer
      assert_eq $module.seen []
      assert_eq $seen [[], []]
      # Exhausted fallback also restores the caller's channels.
      assert_throws $ImportError do global_import isolated_missing
      strand.put $strand.input().next()
    assert_eq $output [42]
  finally
    second.unregister()
    first.unregister()

#[test]
def script_channels_survive_import()
  let source = r|
    import strand
    strand.put $strand.input().next()
    import std
    strand.put $strand.input().next()
  let code = (compile.compile "script.dol" source).emit()
  let output = []
  strand.redirect input: [1, 2] output: $output do
    load.run $code
  assert_eq $output [1, 2]

#[test]
def registration_during_import_applies_to_the_next_resolution()
  let added = []
  let first = load.import_handler do |name|
    if (name == "synthetic_append" && added.len == 0)
      let handle = load.import_handler do |requested|
        if (requested == "synthetic_append")
          Answer 42
        else
          throw ImportError(requested)
      added.push $handle
    throw ImportError(name)
  try
    assert_throws $ImportError do global_import synthetic_append
    assert_eq $global_import("synthetic_append").answer 42
  finally
    first.unregister()
    for handle = added
      handle.unregister()

#[test]
#[parametrize fail: [false, true]]
def unregistering_a_running_callback_discards_its_result :fail
  let entered_send entered = strand.channel()
  let release_send release = strand.channel()
  let handle = load.import_handler do |name|
    if (name == "synthetic_removed_running")
      entered_send.put true
      release.next()
      if fail
        throw TypeError "discard this error too"
      Answer 1
    else
      throw ImportError(name)
  let reader = strand.spawn do
    assert_throws $ImportError do global_import synthetic_removed_running
  entered.next()
  try
    handle.unregister()
    handle.unregister()
    release_send.put true
    reader.join()
    assert_throws $ImportError do global_import synthetic_removed_running
  finally
    release_send.close()
    reader.wait()
    handle.unregister()

#[test]
def callback_can_unregister_itself_and_fall_back()
  let own = []
  let first = load.import_handler do |name|
    if (name == "synthetic_self_removed")
      own[0].unregister()
      Answer 1
    else
      throw ImportError(name)
  own.push $first
  let second = load.import_handler do |name|
    if (name == "synthetic_self_removed")
      Answer 2
    else
      throw ImportError(name)
  try
    assert_eq $global_import("synthetic_self_removed").answer 2
    assert_eq $global_import("synthetic_self_removed").answer 2
  finally
    first.unregister()
    second.unregister()

#[test]
def removing_a_pending_handler_preserves_following_handlers()
  let own = []
  let first = load.import_handler do |name|
    if (name == "synthetic_gravestones")
      own[0].unregister()
    throw ImportError(name)
  let removed = load.import_handler do |name|
    if (name == "synthetic_gravestones")
      throw TypeError "removed handler was called"
    throw ImportError(name)
  own.push $removed
  let last = load.import_handler do |name|
    if (name == "synthetic_gravestones")
      Answer 42
    else
      throw ImportError(name)
  try
    assert_eq $global_import("synthetic_gravestones").answer 42
  finally
    first.unregister()
    removed.unregister()
    last.unregister()

#[test]
def canceled_imports_allow_later_registry_compaction()
  let entered_send entered = strand.channel()
  let release_send release = strand.channel()
  let handle = load.import_handler do |name|
    if (name == "synthetic_gravestone_cancel")
      entered_send.put true
      release.next()
      Answer 1
    else
      throw ImportError(name)
  let reader = strand.spawn do global_import synthetic_gravestone_cancel
  entered.next()
  handle.unregister()
  reader.cancel()
  reader.wait()
  release_send.close()
  # Registration after cancellation can reclaim gravestones and preserve order.
  let replacement = load.import_handler do |name|
    if (name == "synthetic_gravestone_cancel")
      Answer 2
    else
      throw ImportError(name)
  try
    assert_eq $global_import("synthetic_gravestone_cancel").answer 2
  finally
    replacement.unregister()

#[test]
def compaction_waits_for_the_last_executor()
  let entered_send entered = strand.channel 2
  let left_send left_release = strand.channel()
  let right_send right_release = strand.channel()
  let earlier = load.import_handler do |name| throw ImportError(name)
  let blocker = load.import_handler do |name|
    if (name == "synthetic_count_left" || name == "synthetic_count_right")
      entered_send.put $name
      if (name == "synthetic_count_left")
        left_release.next()
      else
        right_release.next()
    throw ImportError(name)
  let last = load.import_handler do |name|
    if (name == "synthetic_count_left" || name == "synthetic_count_right")
      Answer 42
    else
      throw ImportError(name)
  let left = strand.spawn do global_import synthetic_count_left
  let right = strand.spawn do global_import synthetic_count_right
  entered.next()
  entered.next()
  earlier.unregister()
  let added = []
  try
    left_send.put true
    assert_eq $left.join().answer 42
    # The other cursor is past `earlier`; compacting now would skip `last`.
    let late = load.import_handler do |name| throw ImportError(name)
    added.push $late
    right_send.put true
    assert_eq $right.join().answer 42
  finally
    left_send.close()
    right_send.close()
    left.wait()
    right.wait()
    earlier.unregister()
    blocker.unregister()
    last.unregister()
    for handle = added
      handle.unregister()
