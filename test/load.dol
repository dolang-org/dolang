import compile load strand
  test:
    - assert_eq
    - assert_type
    - assert_throws
    - test
  std:
    - ImportError
    - TypeError
import load:
  import: global_import

# A module stand-in for import handlers to return.
class Answer
  pub field answer

  def (init) self answer
    self.answer = answer

#[test]
def synthetic_module()
  let handle = load.import_handler do |name|
    if (name == "synthetic_basic")
      Answer 42
    else
      throw ImportError(name)

  assert_type $load.ImportHandler $handle

  import synthetic_basic: synthetic

  assert_eq $synthetic.answer 42
  handle.unregister()

#[test]
def fallback_after_import_error()
  let seen = []

  let first = load.import_handler do |name|
    seen.push $name
    throw ImportError(name)

  let second = load.import_handler do |name|
    seen.push $name
    if (name == "synthetic_fallback")
      Answer 7
    else
      throw ImportError(name)

  import synthetic_fallback: synthetic

  assert_eq $synthetic.answer 7
  assert_eq $seen.len 2
  assert_eq $seen[0] "synthetic_fallback"
  assert_eq $seen[1] "synthetic_fallback"
  second.unregister()
  first.unregister()

#[test]
def non_import_error_aborts()
  let first = load.import_handler do |name|
    if (name == "existing_module")
      throw TypeError("boom")
    else
      throw ImportError(name)

  let second = load.import_handler do |name|
    if (name == "existing_module")
      Answer 99
    else
      throw ImportError(name)

  let err = assert_throws $TypeError do
    import existing_module:
      - answer
    answer
  assert_eq (str err) "type error: boom"

  second.unregister()
  first.unregister()

#[test]
def unregister()
  let handle = load.import_handler do |name|
    if (name == "synthetic_unregister")
      Answer 1
    else
      throw ImportError(name)

  handle.unregister()

  let err = assert_throws $ImportError do
    import synthetic_unregister: _
  assert_eq (str err) "module not found: synthetic_unregister"

#[test]
def execute()
  assert_eq 2 $ load.run $ (compile.compile "test.dol" "(1 + 1)").emit()

#[test]
def program_importer()
  let seen = []
  let importer = do |name|
    seen.push $name
    Answer $seen.len
  let source = |
    import std: first
    import std: second
    [first.answer, second.answer]
  let bytecode = (compile.compile "test.dol" source).emit()

  let result = load.run $bytecode importer: $importer
  assert_eq $result [1, 2]
  assert_eq $seen ["std", "std"]

#[test]
def retained_function_uses_program_importer()
  let seen = []
  let importer = do |name|
    seen.push $name
    Answer 42
  let source = |
    pub def later()
      import retained_dependency: dependency
      dependency.answer
  let bytecode = (compile.compile "retained.dol" source module: "retained").emit()
  let module = load.run $bytecode importer: $importer

  assert_eq $module.later() 42
  assert_eq $seen ["retained_dependency"]

#[test]
def program_importer_explicit_fallback()
  let importer = do |name| global_import $name
  let source = |
    import std
    (type(std) == std.Module)
  let bytecode = (compile.compile "fallback.dol" source).emit()

  assert_eq true $ load.run $bytecode importer: $importer

# Compile without type checking so the VM must enforce channel isolation.
def channel_module name fail = false
  let source = r|
    import strand std
    pub let seen = [...strand.input()]
    strand.put module_output
  if fail
    source = "$(source)throw std.TypeError(\"module failed\")\n"
  (compile.compile "channels.dol" source module: name).emit()

def check_import_channels program_specific fail
  let name = "isolated_$(program_specific)_$(fail)"
  let module_code = channel_module $name $fail
  let importer = do |requested|
    if (requested == name)
      load.run $module_code
    else if program_specific
      global_import $requested
    else
      throw ImportError(requested)
  let handle = if !program_specific
    load.import_handler $importer
  let script = (compile.compile "caller.dol" "import $name: m\nm.seen\n").emit()
  let output = []
  try
    strand.pipeline input: [11, 12] output: $output
      do
        let input = strand.input()
        let sink = strand.output()
        let run = do
          if program_specific
            load.run $script importer: $importer
          else
            load.run $script
        if fail
          assert_throws $TypeError $run
        else
          assert_eq $run() []
          # Repeat to exercise the global cache or repeated program importer.
          assert_eq $run() []
        assert_eq (strand.input()) $input
        assert_eq (strand.output()) $sink
        strand.put $input.next()
        strand.put $input.next()
    assert_eq $output [11, 12]
  finally
    if !program_specific
      handle.unregister()

#[test]
def global_import_channels()
  check_import_channels false false

#[test]
def global_import_error_restores_channels()
  check_import_channels false true

#[test]
def program_import_channels()
  check_import_channels true false

#[test]
def program_import_error_restores_channels()
  check_import_channels true true

#[test]
def fallback_and_nested_import_channels()
  let seen = []
  let first = load.import_handler do |name|
    if (name == "isolated_outer" || name == "isolated_inner")
      seen.push [...strand.input()]
      strand.put declined_output
    throw ImportError(name)
  let second = load.import_handler do |name|
    if (name == "isolated_outer")
      let code = (compile.compile "outer.dol" "import isolated_inner: inner\ninner\n").emit()
      load.run $code
    else if (name == "isolated_inner")
      load.run $ channel_module $name
    else
      throw ImportError(name)
  let output = []
  try
    strand.redirect input: [42] output: $output do
      let module = global_import isolated_outer
      assert_eq $module.seen []
      assert_eq $seen [[], []]
      # Exhausted fallback also restores the caller's channels.
      assert_throws $ImportError do global_import isolated_missing
      strand.put $strand.input().next()
    assert_eq $output [42]
  finally
    second.unregister()
    first.unregister()

#[test]
def script_channels_survive_import()
  let source = r|
    import strand
    strand.put $strand.input().next()
    import std
    strand.put $strand.input().next()
  let code = (compile.compile "script.dol" source).emit()
  let output = []
  strand.redirect input: [1, 2] output: $output do
    load.run $code
  assert_eq $output [1, 2]
