import
  test:
    - assert
    - assert_eq
    - assert_throws
    - test
  std:
    - TypeError
    - ValueError
  xml:
    - decode
    - encode
    - Node

class MyNode: Node
  def (init) self tag
    Node.(init) $self $tag

class Element: Node
  def (init) self tag ...items
    Node.(init) $self $tag ...items

class NativeNode: Node
  def (init) self tag
    Node.(init) $self $tag

#[test]
def parse_basic_elements()
  let el = decode "<foo/>"
  assert_eq $el.tag "foo"

  let el = decode r#"<foo bar="baz" count="3"/>"#
  assert_eq $el.tag "foo"
  assert_eq $el["bar"] "baz"
  assert_eq $el["count"] "3"

#[test]
def parse_children_and_mixed_content()
  let el = decode "<greeting>hello</greeting>"
  assert_eq $el.tag "greeting"
  let cs = [...el.children]
  assert_eq $cs[0] "hello"

  let el = decode "<root><child/></root>"
  assert_eq $el.tag "root"
  let cs = [...el.children]
  assert_eq $cs[0].tag "child"

  let el = decode "<root>before<mid/>after</root>"
  assert_eq $el.tag "root"
  let cs = [...el.children]
  assert_eq $cs[0] "before"
  assert_eq $cs[1].tag "mid"
  assert_eq $cs[2] "after"
  assert_eq $el[0] "before"
  assert_eq $el[-1] "after"
  let iterated = [...el]
  assert_eq $iterated[1].tag "mid"

#[test]
def parse_nested_and_multiple_children()
  let el = decode "<a><b><c>deep</c></b></a>"
  assert_eq $el.tag "a"
  let l1 = [...el.children]
  assert_eq $l1[0].tag "b"
  let l2 = [...l1[0].children]
  assert_eq $l2[0].tag "c"
  let l3 = [...l2[0].children]
  assert_eq $l3[0] "deep"

  let el = decode r#"<items><item id="1">first</item><item id="2">second</item></items>"#
  assert_eq $el.tag "items"
  let items = [...el.children]
  assert_eq $items[0]["id"] "1"
  assert_eq $[...items[0].children][0] "first"
  assert_eq $items[1]["id"] "2"
  assert_eq $[...items[1].children][0] "second"

#[test]
def ignores_xml_declaration()
  let el = decode "<?xml version=\"1.0\"?><root/>"
  assert_eq $el.tag "root"

#[test]
def round_trip_nodes()
  let n = Node "foo"
  let s = encode $n
  let parsed = decode $s
  assert_eq $parsed.tag "foo"

  let n = Node "foo"
  n["bar"] = "baz"
  let s = encode $n
  let parsed = decode $s
  assert_eq $parsed.tag "foo"
  assert_eq $parsed["bar"] "baz"

  let n = Node "greeting"
  n.push "hello world"
  let s = encode $n
  let parsed = decode $s
  assert_eq $parsed.tag "greeting"
  assert_eq $[...parsed.children][0] "hello world"

#[test]
def round_trip_nested_and_escaped_content()
  let inner = Node "inner"
  inner.push "content"
  let outer = Node "outer"
  outer.push $inner
  let s = encode $outer
  let parsed = decode $s
  assert_eq $parsed.tag "outer"
  let parsed_children = [...parsed.children]
  assert_eq $parsed_children[0].tag "inner"
  assert_eq $[...parsed_children[0].children][0] "content"

  let n = Node "data"
  n.push "a < b & c > d"
  let s = encode $n
  let parsed = decode $s
  assert_eq $"".join(parsed.children) "a < b & c > d"

#[test]
def entity_references_are_expanded()
  let node = decode "<root>a&amp;b&#65;&#x42;<![CDATA[c]]>d</root>"
  assert_eq $node.children.len 1
  assert_eq $node[0] "a&bABcd"
  assert_eq $encode(node) "<root>a&amp;bABcd</root>"

  assert_throws $ValueError do
    decode "<!DOCTYPE root [<!ENTITY custom \"value\">]><root>&custom;</root>"

#[test]
def attribute_values_are_escaped_once()
  let n = Node "a" attrs: {v: "x&y\"z<w"}
  assert_eq $encode(n) r#"<a v="x&amp;y&quot;z&lt;w"></a>"#
  assert_eq $decode(encode(n))["v"] "x&y\"z<w"

  let n = Node "a" namespace: "urn:a?x=1&y=2"
  assert_eq $encode(n) r#"<a xmlns="urn:a?x=1&amp;y=2"></a>"#
  assert_eq $decode(encode(n)).namespace "urn:a?x=1&y=2"

#[test]
def adjacent_text_coalesces_around_elements()
  let node = decode "<r>a&amp;b<![CDATA[c]]><e/>d&#65;e</r>"
  assert_eq $node.children.len 3
  assert_eq $node[0] "a&bc"
  assert_eq $node[1].tag "e"
  assert_eq $node[2] "dAe"

#[test]
def children_are_mutable()
  let root = Node "root"
  let children = root.children
  let a = Node "a"
  let b = Node "b"
  let c = Node "c"
  let d = Node "d"

  children.push $a $d
  children.insert 1 $b $c
  assert_eq $children[0].tag "a"
  assert_eq $children[1].tag "b"
  assert_eq $children[2].tag "c"
  assert_eq $children[3].tag "d"

  let before_last = Node "before-last"
  children.insert -1 $before_last
  assert_eq $children[3].tag "before-last"
  assert_eq $children[4].tag "d"

  children[2] = "text"
  assert_eq $children[2] "text"
  assert_eq $children.pop(1).tag "b"
  assert_eq $children.pop().tag "d"
  assert (children.delete -1)
  assert (!(children.delete 99))
  assert_eq $encode(root) "<root><a></a>text</root>"

  children.clear()
  assert_eq $children.len 0
  assert_eq (children.pop default: "empty") "empty"
  assert_eq (children.pop else: do "computed") "computed"

#[test]
def attrs_and_tag_are_mutable()
  let el = decode r#"<foo x="1" y="2"/>"#
  assert_eq [...el.attrs.keys()] ["x", "y"]
  assert_eq [...el.attrs.values()] ["1", "2"]
  el.attrs["x"] = "changed"
  assert_eq $el["x"] "changed"
  el.attrs["z"] = "3"
  assert_eq $el["z"] "3"
  assert_eq [...el.attrs.keys()] ["x", "y", "z"]
  assert_eq (el.attrs.pop "z") "3"

  let n = Node "old"
  n.tag = "new"
  assert_eq $n.tag "new"

  n["x"] = "first"
  assert_eq $n["x"] "first"
  n.attrs["x"] = "second"
  assert_eq (n.attrs.get "x") "second"
  assert_eq (n.attrs.get "missing" default: "fallback") "fallback"
  assert_eq (n.attrs.get "missing" else: do "computed") "computed"
  assert (n.attrs.delete "x")
  assert (!(n.attrs.delete "x"))
  n.attrs["y"] = "1"
  n.attrs.clear()
  assert_eq $n.attrs.len 0

#[test]
def node_type_and_subclassing()
  let n = Node "foo"
  assert_eq (type n) $Node

  let el = decode "<foo/>"
  assert (type el Node)

  let node = MyNode foo
  assert_eq $node.tag foo
  assert_eq (type node) $MyNode

#[test]
def namespace_handling()
  let el = decode r#"<ns:elem xmlns:ns="http://example.com"/>"#
  assert_eq $el.tag "elem"
  assert_eq $el.namespace "http://example.com"
  assert_eq $el.namespaces["ns"] "http://example.com"
  assert_eq $el.namespaces.len 1

  # Declarations made in the source keep the prefixes it used.
  let src = r#"<soap:Envelope xmlns:soap="http://schemas.xmlsoap.org/soap/envelope/"><soap:Body><ns:Data xmlns:ns="http://example.com">value</ns:Data></soap:Body></soap:Envelope>"#
  let doc = decode $src
  assert_eq $doc.tag "Envelope"
  assert_eq $encode(doc) $src
  let doc2 = decode $encode(doc)
  assert_eq $doc2.namespaces["soap"] "http://schemas.xmlsoap.org/soap/envelope/"
  let body = [...doc2.children]
  assert_eq $body[0].tag "Body"
  let data = [...body[0].children][0]
  assert_eq $data.tag "Data"
  assert_eq $data.namespace "http://example.com"
  # `namespaces` holds only the element's own declarations.
  assert_eq $data.namespaces["ns"] "http://example.com"
  assert_eq $data.namespaces.len 1
  assert_eq $body[0].namespaces.len 0

#[test]
def namespaced_attributes()
  let el = decode r#"<root xmlns:a="urn:a" xmlns:b="urn:b" plain="p" a:id="one" b:id="two"/>"#
  assert_eq $el["plain"] "p"
  assert_eq $el[("urn:a", "id")] "one"
  assert_eq (el.attrs.get(("urn:b", "id"))) "two"
  assert_eq [...el.attrs.keys()] ["plain", ("urn:a", "id"), ("urn:b", "id")]

  el.attrs[("urn:a", "id")] = "changed"
  el[("urn:b", "new")] = "value"
  assert_eq $el[("urn:a", "id")] "changed"
  assert_eq $el[("urn:b", "new")] "value"
  assert (el.attrs.delete(("urn:b", "id")))
  assert_eq $encode(el) r#"<root xmlns:a="urn:a" xmlns:b="urn:b" plain="p" a:id="changed" b:new="value"></root>"#

  # Namespace URIs do not need string encoding.
  el[("urn:x{y}", "z")] = "1"
  assert_eq (el.attrs.get(("urn:x{y}", "z"))) "1"
  assert_throws $ValueError do el[("", "id")] = "1"
  assert_throws $ValueError do el[("urn:x", "a:b")] = "1"

  assert_throws $ValueError do
    decode r#"<root xmlns:a="urn:x" xmlns:b="urn:x" a:id="1" b:id="2"/>"#

#[test]
def default_namespace_semantics()
  let doc = decode r#"<root xmlns="urn:root" plain="x"><child xmlns=""><leaf/></child></root>"#
  assert_eq $doc.namespace "urn:root"
  assert_eq [...doc.attrs.keys()] ["plain"]
  let child = [...doc.children][0]
  assert_eq $child.namespace nil
  let reparsed = decode $encode(doc)
  let reparsed_child = [...reparsed.children][0]
  assert_eq $reparsed.namespace "urn:root"
  assert_eq $reparsed_child.namespace nil

#[test]
def namespace_fixup_and_detached_nodes()
  let child = Node "child" namespace: "urn:child" attrs: {("urn:attr", "id"): "1"}
  let root = Node "root" $child
  assert_eq $encode(root) r#"<root><child xmlns="urn:child" xmlns:ns0="urn:attr" ns0:id="1"></child></root>"#

  let parsed = decode $encode(root)
  let parsed_child = [...parsed.children][0]
  assert_eq $parsed_child.namespace "urn:child"
  assert_eq $parsed_child[("urn:attr", "id")] "1"

  let detached = decode r#"<outer xmlns="urn:default" xmlns:x="urn:x"><x:inner/></outer>"#
  let remixed = [...detached.children][0]
  let remixed_again = decode $encode(remixed)
  assert_eq $remixed_again.namespace "urn:x"
  assert_eq $remixed_again.tag "inner"

#[test]
def explicit_namespace_declarations()
  # Declarations survive even when no name uses them, e.g. for prefixes that
  # appear only in attribute values.
  let root = Node "root" attrs: {type: "x:thing"}
  root.namespaces["x"] = "urn:x"
  assert_eq $encode(root) r#"<root xmlns:x="urn:x" type="x:thing"></root>"#

  # A redundant declaration is not repeated in a child.
  let child = Node "child"
  child.namespaces["x"] = "urn:x"
  root.push $child
  assert_eq $encode(root) r#"<root xmlns:x="urn:x" type="x:thing"><child></child></root>"#

  # An inherited declaration is lost when a child is encoded on its own.
  let parsed = decode r#"<a xmlns:x="urn:x"><b type="x:thing"/></a>"#
  assert_eq $encode(parsed[0]) r#"<b type="x:thing"></b>"#

  # Names use a prefix declared on the element or an ancestor.
  let node = Node "item" namespace: "urn:x" namespaces: {x: "urn:x"} attrs: {("urn:x", "id"): "1"}
  node.push $ Node "sub" namespace: "urn:x"
  assert_eq $encode(node) r#"<x:item xmlns:x="urn:x" x:id="1"><x:sub></x:sub></x:item>"#

  # Without one, an element's namespace becomes the default, even where
  # another default is in scope, unless the element declares a default itself.
  let outer = Node "outer" namespace: "urn:a"
    $ Node "inner" namespace: "urn:b"
    $ Node "own" namespace: "urn:c" namespaces: {"": "urn:d"}
  assert_eq $encode(outer) $ "".join $
    - r#"<outer xmlns="urn:a"><inner xmlns="urn:b"></inner>"#
    - r#"<ns0:own xmlns="urn:d" xmlns:ns0="urn:c"></ns0:own></outer>"#

#[test]
def mutations_reject_malformed_trees()
  assert_throws $ValueError do Node "not a name"
  assert_throws $ValueError do Node "x:y"
  assert_throws $ValueError do Node "root" namespace: ""
  assert_throws $ValueError do Node "root" namespaces: {xmlns: "urn:x"}
  assert_throws $ValueError do Node "root" attrs: {"a b": "1"}
  assert_throws $ValueError do Node "root" attrs: {xmlns: "urn:x"}
  assert_throws $ValueError do Node "root" attrs: {id: "\u{1}"}

  let node = Node "root" attrs: {id: "1"}
  assert_throws $ValueError do node.tag = "1st"
  assert_throws $ValueError do node.namespace = ""
  assert_throws $ValueError do node["a b"] = "1"
  assert_throws $ValueError do node["id"] = "\u{1}"
  assert_throws $ValueError do node.attrs["id"] = "\u{1}"
  assert_throws $ValueError do node.attrs[("http://www.w3.org/2000/xmlns/", "a")] = "1"
  assert_throws $TypeError do node.attrs[1] = "1"
  assert_throws $TypeError do node.attrs["id"] = 1
  assert_eq $encode(node) r#"<root id="1"></root>"#

  assert_throws $TypeError do node.push 42
  assert_throws $TypeError do node.children.push 42
  assert_throws $TypeError do Node "root" 42
  assert_throws $ValueError do node.push "\u{1}"
  assert_throws $ValueError do node.children.insert 0 "ok" "\u{1}"
  assert_eq $node.children.len 0
  node.push "ok"
  assert_throws $TypeError do node.children[0] = 42
  assert_throws $ValueError do decode "<root>&#1;</root>"
  assert_throws $ValueError do encode "\u{1}"

  let cyclic = Node "root"
  cyclic.children.push $cyclic
  assert_throws $ValueError do encode $cyclic

  let shared = Node "shared"
  let dag = Node "root"
  dag.children.push $shared $shared
  assert_eq $encode(dag) "<root><shared></shared><shared></shared></root>"

#[test]
def namespaces_are_a_checked_view()
  let node = Node "root"
  assert_throws $TypeError do node.namespaces["x"] = 42
  assert_throws $ValueError do node.namespaces["xmlns"] = "urn:x"
  assert_throws $ValueError do node.namespaces["x"] = ""
  assert_throws $ValueError do node.namespaces["x"] = "http://www.w3.org/XML/1998/namespace"
  assert_eq $node.namespaces.len 0

  node.namespaces["a"] = "urn:a"
  node.namespaces["b"] = "urn:b"
  node.namespaces["a"] = "urn:a2"
  assert_eq [...node.namespaces.keys()] ["a", "b"]
  assert_eq $node.namespaces["a"] "urn:a2"
  assert_eq (node.namespaces.get "c") nil
  assert (node.namespaces.delete "a")
  assert (!(node.namespaces.delete "a"))
  assert_eq (node.namespaces.pop "b") "urn:b"
  node.namespaces["d"] = "urn:d"
  assert_eq $encode(node) r#"<root xmlns:d="urn:d"></root>"#
  node.namespaces.clear()
  assert_eq $node.namespaces.len 0

#[test]
def xml_namespace_uses_its_prefix()
  let node = Node "root" attrs: {("http://www.w3.org/XML/1998/namespace", "lang"): "en"}
  assert_eq $encode(node) r#"<root xml:lang="en"></root>"#
  let parsed = decode $encode(node)
  assert_eq $parsed[("http://www.w3.org/XML/1998/namespace", "lang")] "en"

#[test]
def traverse_is_depth_first_parent_first()
  let doc = decode "<a><b><c/></b><d/></a>"
  let nodes = [...doc.traverse()]
  assert_eq $nodes.len 4
  assert_eq $nodes[0].tag "a"
  assert_eq $nodes[1].tag "b"
  assert_eq $nodes[2].tag "c"
  assert_eq $nodes[3].tag "d"

#[test]
def construct_children_variadically()
  let n = Node "greeting" "hello"
  assert_eq $encode(n) "<greeting>hello</greeting>"

  let n = Node "root" (Node "a") "text" (Node "b")
  assert_eq $encode(n) "<root><a></a>text<b></b></root>"

  let nested = Node "outer" (Node "inner" "content")
  let parsed = decode $encode(nested)
  let children = [...parsed.children]
  assert_eq $children[0].tag "inner"
  assert_eq $[...children[0].children][0] "content"

#[test]
def construct_attrs_from_dict()
  let n = Node "disk" attrs: {type: "file", device: "disk"}
  assert_eq $encode(n) r#"<disk type="file" device="disk"></disk>"#
  assert_eq $n["type"] "file"

  # Bareword keys intern as Sym and quoted keys as Str; both name attributes.
  let n = Node "e" attrs: {plain: "1", "x-custom": "2", ("urn:a", "id"): "3"}
  assert_eq [...n.attrs.keys()] ["plain", "x-custom", ("urn:a", "id")]

  # Attributes keep their order independently of children.
  let n = Node "e" attrs: {first: "1", second: "2"} "text"
  assert_eq [...n.attrs.keys()] ["first", "second"]
  assert_eq $encode(n) r#"<e first="1" second="2">text</e>"#

#[test]
def construct_mixes_attrs_and_children()
  let n = Node "root"
    attrs: {id: "1"}
    (Node "child" "text")
  assert_eq $encode(n) r#"<root id="1"><child>text</child></root>"#

  let ns = Node "vm" namespace: "urn:vm" namespaces: {v: "urn:vm"}
    attrs: {managed: "true"}
    $Node("port", "22")
  assert_eq $encode(ns) r#"<v:vm xmlns:v="urn:vm" managed="true"><port>22</port></v:vm>"#
  let parsed = decode $encode(ns)
  assert_eq $parsed.namespace "urn:vm"
  assert_eq $parsed["managed"] "true"
  assert_eq $[...parsed.children][0].tag "port"

#[test]
def construct_vertical_layout()
  # A nested element is a parenthesized or `$`-compact call; a bare vertical
  # item is literal text to end of line, and a dash item likewise.
  # `attrs:` opens a vertical dict of attributes.
  let disk = Node disk
    attrs:
      type: file
      device: disk
    (Node "driver" attrs: {name: "qemu", type: "qcow2"})
    $Node("source", attrs: {file: "/tmp/disk.qcow2"})
  assert_eq $encode(disk) $ "".join $
    - r#"<disk type="file" device="disk">"#
    - r#"<driver name="qemu" type="qcow2"></driver>"#
    - r#"<source file="/tmp/disk.qcow2"></source></disk>"#

  # A bare item is an ordinary statement-level argument list, so these are two
  # separate string children; serialization concatenates adjacent text.
  let text = Node "note"
    plain literal words
  assert_eq $text.children.len 3
  assert_eq $encode(text) "<note>plainliteralwords</note>"

  # `- $ ` introduces a command-or-expression running to end of line.
  let dollar = Node disk
    - $ Node driver attrs: {name: "qemu"}
  assert_eq $encode(dollar) r#"<disk><driver name="qemu"></driver></disk>"#

  let nested = Node disk
    - $ Node source
        attrs:
          file: /tmp/disk.qcow2
  assert_eq $encode(nested) r#"<disk><source file="/tmp/disk.qcow2"></source></disk>"#

  # `- $ ` items nest arbitrarily deep, each opening its own vertical block.
  let domain = Node domain
    attrs:
      type: kvm
    - $ Node name dolang-ci
    - $ Node devices
        - $ Node interface
            attrs:
              type: user
            - $ Node portForward
                attrs:
                  proto: tcp
                - $ Node range attrs: {start: "20000", to: "22"}
  assert_eq $encode(domain) $ "".join $
    - r#"<domain type="kvm"><name>dolang-ci</name><devices>"#
    - r#"<interface type="user"><portForward proto="tcp">"#
    - r#"<range start="20000" to="22"></range>"#
    - r#"</portForward></interface></devices></domain>"#

#[test]
def construct_rejects_invalid_arguments()
  assert_throws $TypeError do Node "root" attrs: {x: 42}
  assert_throws $TypeError do Node "root" attrs: {1: "x"}
  assert_throws $TypeError do Node "root" namespaces: "nope"
  assert_throws $TypeError do Node "root" {x: "1"}

#[test]
def construct_variadically_through_subclass()
  let el = Element "root" attrs: {id: "1"} (Node "child")
  assert_eq (type el) $Element
  assert_eq $el["id"] "1"
  assert_eq $el.children[0].tag "child"

#[test]
def do_subclasses_are_accepted_as_native_values()
  # A Do subclass of a native type is a class instance holding the native in a
  # slot; casts look through it, so it serializes like the base type.
  let el = NativeNode "root"
  assert (type el Node)
  assert_eq $encode(el) "<root></root>"

  let with_child = Node "root"
  with_child.push (NativeNode "child")
  assert_eq $encode(with_child) "<root><child></child></root>"

  # Operators the subclass does not override reach the native type.
  el["id"] = "1"
  assert_eq $el["id"] "1"
  el.push "text"
  assert_eq $el[0] "text"
  assert_eq [...el] ["text"]
  let items = $
    for child = el
      - $child
  assert_eq $items ["text"]
  el.children.clear()

  # Nested both ways, and through the variadic constructor.
  let tree = NativeNode "outer"
  tree.push (Node "inner" (NativeNode "leaf"))
  assert_eq $encode(tree) "<outer><inner><leaf></leaf></inner></outer>"
  assert_eq $encode(Node "wrap" (NativeNode "sub")) "<wrap><sub></sub></wrap>"

  let parsed = decode $encode(tree)
  assert_eq $parsed.tag "outer"
  assert_eq $[...parsed.children][0].tag "inner"

  # A cast that looks through to the native delegate still refers to the whole
  # object, so values recovered from a tree keep their subclass identity.
  let nodes = [...tree.traverse()]
  assert_eq (type nodes[0]) $NativeNode
  assert_eq (type nodes[2]) $NativeNode

#[test]
def attrs_are_views_of_their_node()
  let node = Node "root" attrs: {id: "1"}
  let attrs = node.attrs
  attrs["id"] = "2"
  assert_eq $node["id"] "2"
  node["id"] = "3"
  assert_eq $attrs["id"] "3"

  # Iteration yields plain pairs.
  node[("urn:a", "x")] = "4"
  let pairs = $
    for k v = node.attrs
      - [k, v]
  assert_eq $pairs [["id", "3"], [("urn:a", "x"), "4"]]

#[test]
def duplicate_attrs_are_rejected()
  assert_throws $ValueError do Node "root" attrs: {("urn:x", "x"): "1", ("urn:x", "x"): "2"}
  assert_throws $ValueError do Node "root" attrs: {x: "1", "x": "2"}
  let node = Node "root" attrs: {x: "1", ("urn:x", "x"): "2"}
  assert_eq $node.attrs.len 2

#[test]
def attribute_keys_are_structured()
  let node = Node root attrs: {id: "plain", ("urn:a", "id"): "one", ("urn:b", "id"): "two"}
  assert_eq [...node.attrs.keys()] ["id", ("urn:a", "id"), ("urn:b", "id")]
  node.attrs[("urn:a", "id")] = "changed"
  assert_eq [...node.attrs.keys()] ["id", ("urn:a", "id"), ("urn:b", "id")]
  assert_eq (node.attrs.pop(("urn:b", "id"))) "two"
  assert (!(node.attrs.delete(("urn:b", "id"))))
  assert_eq (node.attrs.get :id:) nil
  assert (!(node.attrs.delete :id:))
  assert_throws $TypeError do node.attrs[:id:] = "bad"
  assert_throws $TypeError do node[:id:] = "bad"
  for key = [(), ("urn:a",), ("urn:a", "id", "extra"), (nil, "id"), ("urn:a", :id:), ["urn:a", "id"]]
    assert_eq (node.attrs.get key) nil
    assert (!(node.attrs.delete key))
    assert_throws $TypeError do node.attrs[key] = "bad"
    assert_throws $TypeError do Node root attrs: {(key): "bad"}
  assert_throws $ValueError do node.attrs["{urn:a}id"] = "bad"
  assert_throws $ValueError do Node root attrs: {"{urn:a}id": "bad"}
  assert_throws $ValueError do Node root attrs: {("", "id"): "bad"}
  assert_throws $TypeError do Node root attrs: nil
  assert_throws $TypeError do Node root attrs: "bad"
  assert_eq $Node("root").attrs.len 0
  assert_eq $Node("root", attrs: {}).attrs.len 0

#[test]
def attribute_identity_is_independent_of_prefixes()
  let node = decode r#"<root xmlns:a="urn:shared" a:id="one"/>"#
  node.namespaces.clear()
  node.namespaces["b"] = "urn:shared"
  assert_eq $node[("urn:shared", "id")] "one"
  let parsed = decode $encode(node)
  assert_eq [...parsed.attrs.keys()] [("urn:shared", "id")]
  assert_eq $parsed[("urn:shared", "id")] "one"
