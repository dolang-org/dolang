import regex
import regex:
  - Regex
import std
import std:
  - Iter
import test:
  - assert
  - assert_eq
  - assert_throws
  - assert_type
  - test

#[test]
def compile_match_and_find()
  let date_pattern = Regex r"(?<year>\d{4})-(?<month>\d{2})-(?<day>\d{2})"
  let caps = date_pattern.match "2024-03-15"

  assert_type $regex.Captures $caps
  assert_type $regex.Match $caps[0]
  assert_type $Iter (date_pattern.find "2024-03-15")

  assert_eq (str caps[0]) "2024-03-15"
  assert_eq (str caps["year"]) "2024"
  assert_eq (str caps["month"]) "03"
  assert_eq (str caps["day"]) "15"
  assert_throws $std.IndexError do caps[1]

  let no_match = date_pattern.match "not a date"
  assert_eq $no_match nil

  let optional = Regex r"(a)?(?<rest>b)(?<tail>c)?"
  let caps = optional.match "b"
  assert_throws $std.MissingPosError do caps[1]
  assert_throws $std.MissingKeyError do caps["tail"]
  assert_eq $caps.get(1) nil
  assert_eq $caps.get(:tail:) nil
  assert_eq (str caps["rest"]) "b"
  assert_eq (str caps[:rest:]) "b"
  let rest = caps.get "rest"
  assert_eq (str rest) "b"
  assert_throws $std.IndexError do caps[2]
  assert_throws $std.IndexError do caps["missing"]
  assert_throws $std.IndexError do caps.get(2)
  let found = [...optional.find "b"]
  assert_eq $found[0].get(1) nil
  assert_eq $found[0].get("tail") nil
  assert_eq (optional.replace "b" (do |c| str(c.get("tail") == nil))) "true"

  let text = "Dates: 2024-01-01, 2024-02-02, 2024-03-03"
  let matches = [...date_pattern.find text]
  assert_eq $matches.len 3
  assert_eq (str matches[0]) "2024-01-01"
  assert_eq (str matches[1]) "2024-02-02"
  assert_eq (str matches[2]) "2024-03-03"

#[test]
def named_groups_take_no_number()
  let date = Regex r"(?<y>\d{4})-(\d{2})-(\d{2})"
  let caps = date.match "2024-03-15"
  assert_eq (str caps[0]) "2024-03-15"
  assert_eq (str caps[1]) "03"
  assert_eq (str caps[2]) "15"
  assert_eq (str caps["y"]) "2024"
  assert_throws $std.IndexError do caps[3]
  assert_eq (date.replace "2024-03-15" t"$#1/$#2/$#y") "03/15/2024"

#[test]
def unpack_captures()
  let date = Regex r"(?<y>\d{4})-(\d{2})-(\d{2})"
  let caps = date.match "2024-03-15"
  let whole m d :y = caps
  assert_type $regex.Match $whole
  assert_eq (str whole) "2024-03-15"
  assert_eq (str m) "03"
  assert_eq (str d) "15"
  assert_eq (str y) "2024"

  # Unpacking leaves the captures unchanged
  let again ..._ = caps
  assert_eq (str again) "2024-03-15"

  assert_throws $std.UnexpectedPosError do
    let _ _ y: _ = caps
  assert_throws $std.UnexpectedKeyError do
    let _ _ _ = caps
  assert_throws $std.MissingPosError do
    let _ _ _ _ y: _ = caps
  assert_throws $std.MissingKeyError do
    let _ _ _ y: _ z: _ = caps

#[test]
def unpack_captures_holes()
  let optional = Regex r"(a)?(b)(?<c>c)?(d)?"

  # A missing group takes its default without shifting later items
  bind optional.match("b")
    - _
    - a = "none"
    - b = nil
    :c = "none"
  assert_eq $a "none"
  assert_eq (str b) "b"
  assert_eq $c "none"

  # A trailing hole is not a leftover item
  let _ a b = optional.match "ab"
  assert_eq (str a) "a"
  assert_eq (str b) "b"

  assert_throws $std.MissingPosError do
    let _ _a _b = optional.match "b"
  assert_throws $std.MissingKeyError do
    let _ _ _ c: _ = optional.match "ab"

#[test]
def unpack_captures_rests()
  let pattern = Regex r"(a)?(b)(?<c>c)?(?<e>e)(d)"
  let caps = pattern.match "bed"

  # A mixed rest keeps holes and fixed indices
  let whole ...rest = caps
  assert_eq (str whole) "bed"
  bind rest
    - a = "none"
    - b = nil
    - d = nil
    :c = "none"
    :e
  assert_eq $a "none"
  assert_eq (str b) "b"
  assert_eq (str d) "d"
  assert_eq $c "none"
  assert_eq (str e) "e"

  # A rest of a rest
  let _ ...outer = pattern.match "abed"
  let _ ...inner = outer
  let b2 d2 :e = inner
  assert_eq (str b2) "b"
  assert_eq (str d2) "d"
  assert_eq (str e) "e"

  # Unpacking a rest again gives the same items
  let _ b3 ..._ = outer
  assert_eq (str b3) "b"

  # A positional rest has no keys; a keyed rest has no positional items
  let full = pattern.match "abed"
  let _ *pos **keys = full
  let _ b4 d4 = pos
  assert_eq (str b4) "b"
  assert_eq (str d4) "d"
  assert_throws $std.MissingKeyError do
    let _ _ _ e: _ = pos
  let :e = keys
  assert_eq (str e) "e"
  assert_throws $std.MissingPosError do
    let _x ..._ = keys

  # Taken keys are left out of the rest
  let _ _ _ _ e: _ ...others = full
  assert_throws $std.MissingKeyError do
    let e: _ = others

  # A rest only unpacks
  assert_throws $std.UnsupportedError do
    pack ...rest

#[test]
def split_variants()
  let re = Regex r"[,\s]+"
  assert_eq ([...re.split "abc, def, ghi"]) ["abc", "def", "ghi"]
  assert_eq ([...re.split "abcdefghi"]) ["abcdefghi"]

  assert_eq ([...re.split "abc, def, ghi, jkl" limit: 1]) ["abc", "def, ghi, jkl"]
  assert_eq ([...re.split "abc, def, ghi, jkl" limit: 2]) ["abc", "def", "ghi, jkl"]

  assert_eq ([...re.split "abc, def, ghi, jkl" limit: -1]) ["abc, def, ghi", "jkl"]
  assert_eq ([...re.split "abc, def, ghi, jkl" limit: -2]) ["abc, def", "ghi", "jkl"]

  assert_eq ([...re.rsplit "abc, def, ghi"]) ["ghi", "def", "abc"]
  assert_eq ([...re.rsplit "abc, def, ghi, jkl" limit: 1]) ["jkl", "abc, def, ghi"]
  assert_eq ([...re.rsplit "abc, def, ghi, jkl" limit: 2]) ["jkl", "ghi", "abc, def"]
  assert_eq ([...re.rsplit "abc, def, ghi, jkl" limit: -1]) ["def, ghi, jkl", "abc"]
  assert_eq ([...re.rsplit "abc, def, ghi, jkl" limit: -2]) ["ghi, jkl", "def", "abc"]

#[test]
def split_delimiter_edges()
  let re = Regex r","
  assert_eq ([...re.split ""]) [""]
  assert_eq ([...re.split "a,,b"]) ["a", "", "b"]

#[test]
def split_iter_unpack()
  let re = Regex r"\s+"
  let collected = $
    for part = re.split "hello world foo"
      - $part
  assert_eq $collected ["hello", "world", "foo"]

  let first ...rest = re.split "a b c d"
  assert_eq $first "a"
  assert_eq ([...rest]) ["b", "c", "d"]

  let parts = re.split "x y"
  assert ((parts.buffer()) == parts)

  let a b c = re.split "x y z"
  assert_eq $a "x"
  assert_eq $b "y"
  assert_eq $c "z"

  let head *tail **keys = re.split "p q r"
  assert_eq $head "p"
  assert_eq ([...tail]) ["q", "r"]
  assert_eq {...keys} {}

#[test]
def split_unpack_atomic()
  let re = Regex r"\s+"

  let failed = try
    let _a _b = re.split "x y z"
    false
  catch _
    true
  assert_eq $failed true

  let iter = re.split "a b c d"
  failed = try
    let _x _y = iter
    false
  catch _
    true
  assert_eq $failed true
  assert_eq ([...iter]) ["a", "b", "c", "d"]

  failed = try
    let _a _b _c = re.split "x y"
    false
  catch _
    true
  assert_eq $failed true

#[test]
def split_unpack_readonly()
  let re = Regex r"\s+"
  let cases = [
    re.split("a b c d"),
    re.split("a b c d", limit: 2),
    re.split("a b c d", limit: -2),
    re.rsplit("a b c d"),
  ]
  let expected = [
    ["a", "b", "c", "d"],
    ["a", "b", "c d"],
    ["a b", "c", "d"],
    ["d", "c", "b", "a"],
  ]
  for i = std.Range $cases.len
    let parts = cases[i]
    let e0 e1 ...tail_items = expected[i]
    let e_tail = [...tail_items]
    let head ...rest = parts
    assert_eq $head $e0
    let again ...other = parts
    assert_eq $again $head
    assert_throws $std.MissingPosError do
      let _a _b _c _d _e = parts
    let second ...child = rest
    assert_eq $second $e1
    assert_eq [...child] [...e_tail]
    assert_eq [...rest] [e1, ...e_tail]
    assert_eq [...other] [e1, ...e_tail]
    assert_eq [...parts] $expected[i]

  let parts = re.split "a b c"
  assert_eq $parts.next() "a"
  let second ...tail = parts
  assert_eq $second "b"
  assert_eq $parts.next() "b"
  assert_eq [...tail] ["c"]
  assert_eq [...parts] ["c"]

#[test]
def iterator_spreads_are_positional()
  let re = Regex r"\s+"
  let parts = re.split "a b"
  assert_eq (pack ...parts) (pack "a" "b")
  let parts = re.split "a b"
  assert_eq (record ...parts) {"a", "b"}
  let words = Regex r"\w+"
  let matches = words.find "a b"
  let found = pack ...matches
  assert_eq $found.len 2
  assert_eq (str found[0]) "a"
  assert_eq (str found[1]) "b"
  assert_throws $std.ShapelessError do
    let _ _ = words.find "a"
  let matches = words.find "a b"
  assert_throws $std.ShapelessError do
    let ..._rest = matches
  let matched = matches.next()
  assert_eq (str matched) "a"

#[test]
def replace()
  let re = Regex r"\d+"
  assert_eq (re.replace "abc 123 def 456" "X") "abc X def X"
  assert_eq (re.replace "abc 123 def 456 ghi 789" "X" limit: 1) "abc X def 456 ghi 789"
  assert_eq (re.replace "abc 123 def 456 ghi 789" "X" limit: 2) "abc X def X ghi 789"
  assert_eq (re.replace "abc 123 def 456" "X" limit: 0) "abc 123 def 456"
  assert_eq (re.replace "abc def" "X") "abc def"

  let date_re = Regex r"(\d{4})-(\d{2})-(\d{2})"
  assert_eq (date_re.replace "date: 2024-03-15" t"$#2/$#3/$#1") "date: 03/15/2024"

  let named_re = Regex r"(?<first>\w+)\s+(?<last>\w+)"
  assert_eq (named_re.replace "John Smith" t"$#last, $#first") "Smith, John"

  assert_eq (date_re.replace "2024-03-15" r"$2/${month}/$$") r"$2/${month}/$$"
  assert_eq (re.replace "price: 42" t"\$$#0") r"price: $42"

  let separator = "/"
  assert_eq (date_re.replace "2024-03-15" t"$#2$separator$#3") "03/15"
  assert_eq (re.replace "42" t"[${#0:>5}]") "[   42]"

  let inner = t"$#word"
  let outer = t"<$inner>"
  let word_re = Regex r"(?<word>\w+)"
  assert_eq (word_re.replace "hello" outer) "<hello>"

  let optional = Regex r"(a)?b"
  assert_throws $std.MissingPosError do optional.replace "b" t"$#1"
  assert_throws $std.MissingKeyError do optional.replace "ab" t"$#missing"
  assert_eq (optional.replace "none" t"$#missing") "none"
  assert_eq (optional.replace "ab" t"$#missing" limit: 0) "ab"

  let result = re.replace "abc 123 def 456" do |caps|
    let n = int (str caps[0])
    str (n * 2)
  assert_eq $result "abc 246 def 912"

  result = re.replace "abc 123 def 456 ghi 789" (do |_| "X") limit: 2
  assert_eq $result "abc X def X ghi 789"
  assert_eq (re.replace "" "X") ""

#[test]
def invalid_patterns_raise_pattern_errors()
  let syntax = assert_throws $std.ValueError do Regex "("
  assert_type $regex.PatternError $syntax
  assert_eq $syntax.kind :SYNTAX:

  let too_big = assert_throws $regex.PatternError do Regex r"\w{1000}{1000}"
  assert_eq $too_big.kind :TOO_BIG:
