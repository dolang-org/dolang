import compile std
  test:
    - assert
    - assert_eq
    - assert_ne
    - assert_type
    - test
  std:
    - hash

def span_text source span
  source[span.start.byte_offset..span.end.byte_offset]

def declared_name source node
  let name = node.name
  if (type(name, compile.Span))
    span_text $source $name
  else
    name

def assert_no_errors unit
  let errors = [...unit.diagnostics().filter(do |d| (d.severity == :ERROR:))]
  assert_eq $errors.len 0

def assert_span_contract left right
  assert_type $compile.Span $left
  assert_type $compile.Span $right
  assert_eq $left $right
  assert_eq (hash left) (hash right)
  assert (left <= right)

  let left_start = left.start
  let right_start = right.start
  assert_type $compile.Pos $left_start
  assert_type $compile.Pos $right_start
  assert_eq $left_start $right_start
  assert_eq (hash left_start) (hash right_start)
  assert (left_start <= left.end)

#[test]
def success()
  let result = compile.compile "ok.dol" |-
    def foo()
      1
    foo()

  assert_type $compile.Unit $result
  assert_eq 0 $ result.diagnostics().count()
  assert_type $Bin $result.emit()

#[test]
def warning()
  let result = compile.compile "warn.dol" |-
    def foo unused
      nil
    foo 1

  let diagnostics = [...result.diagnostics()]
  assert_eq $diagnostics.len 1

  let diag = diagnostics[0]
  assert_type $compile.Diagnostic $diag
  assert_eq $diag.severity :WARNING:
  assert_type $compile.SourceSpan $diag.span
  assert_eq $diag.span.unit nil
  assert_eq $diag.span $diag.span
  assert_eq (hash diag.span) (hash diag.span)
  assert (diag.span <= diag.span)
  let span = diag.span.span
  let equal_span = diag.span.span
  assert_span_contract $span $equal_span
  assert_eq $diag.patches.len 0
  assert_eq $diag.notes.len 0

#[test]
def error()
  let result = compile.compile "bad.dol" "let =\n"
  let diagnostics = [...result.diagnostics()]
  assert (diagnostics.len > 0)

  let diag = diagnostics[0]
  assert_type $compile.Diagnostic $diag
  assert_eq $diag.severity :ERROR:
  let span = diag.span.span
  let equal_span = diag.span.span
  assert_span_contract $span $equal_span
  assert_type $Array $diag.annotations
  assert_type $Array $diag.notes
  assert_type $Array $diag.patches

#[test]
def nodes()
  let source = r|-
    pub def greet name :punctuation = "!" ...rest
      echo $name
      return name
  let unit = compile.compile "nodes.dol" $source document: true
  let seen = 0
  let preludes = 0
  let first_id = nil
  let first_node = nil
  for pair = unit.nodes()
    assert_type $Tuple $pair
    let id node = pair
    assert_type $compile.NodeId $id
    assert_type $compile.Node $node
    # A prelude binding has no source text to span
    if type(node, compile.PreludeItem)
      assert_eq $node.span nil
      preludes = (preludes + 1)
    else
      assert_type $compile.Span $node.span
    if (seen == 0)
      first_id = id
      first_node = node
    seen = (seen + 1)
  assert (seen > 0)
  assert_eq $preludes 1
  assert_type $compile.Root $first_node
  assert_eq $first_node.parent nil
  assert_eq $first_node.doc nil
  assert_eq $source[first_node.span.start.byte_offset..first_node.span.end.byte_offset] $source
  assert_type (type first_node) $unit.node(first_id)

  let bytecode = unit.emit()
  assert_type $Bin $bytecode
  let err = try
    first_node.span
  catch e
    e
  assert_type $std.StateError $err

#[test]
def document_option()
  # Naming a prelude item only in a type must not import it
  let source = "let answer @Str = 42\nanswer\n"
  let default = compile.compile "option.dol" $source
  let disabled = compile.compile "option.dol" $source document: false
  let enabled = compile.compile "option.dol" $source document: true
  assert_eq $default.nodes().count() 0
  assert_eq $disabled.nodes().count() 0
  assert (enabled.nodes().count() > 0)
  let bytecode = enabled.emit()
  assert_eq $default.emit() $bytecode
  assert_eq $disabled.emit() $bytecode

#[test]
def node_doc_comments()
  let source = |-
    let sentinel = nil

    # A greeting.
    #
    # Spans several lines.
    pub def greet name
      name
  let unit = compile.compile "doc.dol" $source document: true
  let seen = 0
  for _id node = unit.nodes()
    if (type(node, compile.Function))
      let doc = node.doc
      assert_type $compile.Span $doc
      assert_eq $source[doc.start.byte_offset..doc.end.byte_offset] |-
        # A greeting.
        #
        # Spans several lines.
      seen = (seen + 1)
    else if (type(node, compile.PositionalParam))
      # The block above the function documents it, not the parameters that
      # happen to be written on the same line.
      assert_eq $node.doc nil
  assert_eq $seen 1

#[test]
def root_doc_comments()
  let source = |-
    # Module summary.
    #
    # ## Details

    pub let answer = 42
  let unit = compile.compile "module-doc.dol" $source document: true
  let root = unit.nodes().find(do |pair| type(pair[1], compile.Root))[1]
  assert_eq $root.parent nil
  assert_eq $source[root.span.start.byte_offset..root.span.end.byte_offset] $source
  let doc = root.doc
  assert_eq $source[doc.start.byte_offset..doc.end.byte_offset] |-
    # Module summary.
    #
    # ## Details

#[test]
def emit_without_recovery_fails_after_diagnostics()
  let source = "let x = 1\nlet = 2\n"
  let result = compile.compile "bad.dol" $source
  let diagnostics = [...result.diagnostics()]
  assert (diagnostics.len > 0)
  let err = try
    result.emit()
  catch e
    e
  assert_type $std.CompileError $err

#[test]
def recover_option_keeps_describing_the_source_but_still_refuses_to_emit()
  let source = "let x = 1\nlet = 2\n"
  let result = compile.compile "bad.dol" $source recover: true document: true
  let diagnostics = [...result.diagnostics()]
  assert (diagnostics.len > 0)
  # Recovery keeps describing whatever the compiler could still read, despite
  # the error.
  let nodes = [...result.nodes()]
  assert (nodes.len > 0)
  let err = try
    result.emit()
  catch e
    e
  assert_type $std.CompileError $err

#[test]
def repeated_imports_stay_distinct_declarations()
  let source = "import std\nimport std\nstd\n"
  let unit = compile.compile "imports.dol" $source document: true
  assert_no_errors $unit
  let imports = [...unit.nodes().filter(do |pair| type(pair[1], compile.ImportModule))]
  assert_eq $imports.len 2
  assert_ne $imports[0][0] $imports[1][0]

#[test]
def pub_imports_are_documented_and_dotted_names_must_be_renamed()
  let source = "pub import std\npub import foo.bar: bar\npub import std:\n  Record: Rec\n"
  let unit = compile.compile "imports.dol" $source document: true
  assert_no_errors $unit
  let imports = [...unit.nodes().filter(do |pair|
    (type(pair[1], compile.ImportModule) || type(pair[1], compile.ImportItem)))]
  assert_eq $imports.len 3
  for pair = imports
    assert $pair[1].is_pub

  let invalid = compile.compile "imports.dol" "pub import foo.bar\n"
  let invalid_diags = [...invalid.diagnostics()]
  assert (invalid_diags.len > 0)
  let invalid_messages = [...invalid_diags.map(do |d| d.message)]
  assert (invalid_messages.contains(
    "public dotted module imports must be renamed"))

  let nested = compile.compile "imports.dol" "def load()\n  pub import std\n"
  let nested_diags = [...nested.diagnostics()]
  assert (nested_diags.len > 0)
  let nested_messages = [...nested_diags.map(do |d| d.message)]
  assert (nested_messages.contains "`pub` may only be used at the top level")

#[test]
def anonymous_rest_params_are_indexed()
  let source = "def f ...\n  1\n"
  let unit = compile.compile "params.dol" $source document: true
  assert_no_errors $unit
  let rest = unit.nodes().find(do |pair| type(pair[1], compile.RestParam))
  assert_eq $rest[1].name nil
  assert_eq $rest[1].type_ellipsis nil

#[test]
def nonlocal_jumps_target_the_construct_they_leave()
  let source = |-
    def invoke block
      block()
    def f ...
      while true
        invoke do continue
        invoke do break
      invoke do return 1
  let unit = compile.compile "jumps.dol" $source document: true
  assert_no_errors $unit

  let the_while = unit.nodes().find(do |pair| type(pair[1], compile.While))
  let the_function = unit.nodes().find(do |pair|
    (type(pair[1], compile.Function) && (declared_name(source, pair[1]) == "f")))

  let the_continue = unit.nodes().find(do |pair| type(pair[1], compile.Continue))
  assert_eq $the_continue[1].target $the_while[0]

  let the_break = unit.nodes().find(do |pair| type(pair[1], compile.Break))
  assert_eq $the_break[1].target $the_while[0]

  let the_return = unit.nodes().find(do |pair| type(pair[1], compile.Return))
  assert_eq $the_return[1].target $the_function[0]

  # A `do` block's own body reaching a jump crosses no loop or function, so a
  # non-local jump inside it still targets the enclosing construct rather than
  # the `do` itself.
  let lambdas = [...unit.nodes().filter(do |pair| type(pair[1], compile.Lambda))]
  assert_eq $lambdas.len 3
  for pair = lambdas
    assert_ne $pair[0] $the_while[0]
    assert_ne $pair[0] $the_function[0]

#[test]
def static_field_initializers_see_the_enclosing_scope_not_a_method_scope()
  let source = "let x = 1\nclass C\n  #[static]\n  pub field y = str(x)\nC\n"
  let unit = compile.compile "static.dol" $source document: true
  assert_no_errors $unit
  # A static initializer runs where it is written, not inside a synthesized
  # method, so it introduces no function/lambda/self scope of its own.
  let scopes = [...unit.nodes().filter(do |pair|
    (type(pair[1], compile.Function) || type(pair[1], compile.Lambda) ||
      type(pair[1], compile.SelfParam)))]
  assert_eq $scopes.len 0

#[test]
def declarations_parent_to_the_construct_that_encloses_them()
  let source = |-
    class Point
      pub field x = 0

      pub def (init) self x
        self.x = x

      def hidden self
        let local = 1
  let unit = compile.compile "declarations.dol" $source document: true
  assert_no_errors $unit
  let nodes = [...unit.nodes()]

  let point = nodes.find(do |pair| type(pair[1], compile.Class))
  let field_x = nodes.find(do |pair| type(pair[1], compile.Field))
  let init = nodes.find(do |pair| type(pair[1], compile.SpecialMethod))
  let hidden = nodes.find(do |pair| type(pair[1], compile.Method))
  let local = nodes.find(do |pair| type(pair[1], compile.Bind))
  let self_params = [...nodes.filter(do |pair| type(pair[1], compile.SelfParam))]

  assert_eq $field_x[1].parent $point[0]
  assert_eq $init[1].parent $point[0]
  assert_eq $hidden[1].parent $point[0]
  assert_eq $local[1].parent $hidden[0]
  # `self` appears once per method that declares it; each belongs to its own
  # method, not to the class.
  assert_eq $self_params.len 2
  for pair = self_params
    assert_ne $pair[1].parent $point[0]

#[test]
def doc_comments_attach_only_to_the_declaration_directly_below_them()
  let source = |-
    #!/usr/bin/env dolang

    # The greeting to use.
    pub let greeting = "hi"

    let counted = 1 # how many, so far

    # Fenced off by a blank line.

    def bare()
      1

    def deco f
      f

    # Makes a widget.
    #[deco]
    pub def widget
      # Where the parts come from.
      :from
      ...rest
    do
      1
  let unit = compile.compile "doc.dol" $source document: true
  assert_no_errors $unit
  let nodes = [...unit.nodes()]

  let doc_of = do |name ty|
    let found = nodes.find(do |pair|
      (type(pair[1], ty) && (declared_name(source, pair[1]) == name)))
    let doc = found[1].doc
    if (doc == nil)
      nil
    else
      span_text(source, doc)

  # The interpreter line addresses the shell, not the reader.
  assert_eq (doc_of("greeting", compile.Bind)) "# The greeting to use."
  assert_eq (doc_of("counted", compile.Bind)) nil
  assert_eq (doc_of("bare", compile.Function)) nil
  # A decorator sits between the block and the keyword without breaking the
  # association, and the first parameter does not steal it.
  assert_eq (doc_of("widget", compile.Function)) "# Makes a widget."
  assert_eq (doc_of("from", compile.KeyParam)) "# Where the parts come from."
  assert_eq (doc_of("rest", compile.RestParam)) nil

#[test]
def a_comment_block_runs_until_the_declaration_it_documents()
  let source = |-
    # Unrelated commentary.

    class Thing
      # What it is called.
      #
      # Blank comment lines continue the block.
      pub field name = nil
  let unit = compile.compile "doc2.dol" $source document: true
  assert_no_errors $unit
  let nodes = [...unit.nodes()]
  let thing = nodes.find(do |pair|
    (type(pair[1], compile.Class) && (declared_name(source, pair[1]) == "Thing")))
  assert_eq $thing[1].doc nil
  let name = nodes.find(do |pair| type(pair[1], compile.Field))
  assert_eq (span_text(source, name[1].doc)) |-
    # What it is called.
      #
      # Blank comment lines continue the block.

#[test]
def root_doc_only_attaches_when_nothing_earlier_claims_it()
  let empty = compile.compile "empty.dol" "" document: true
  let empty_root = empty.nodes().find(do |pair| type(pair[1], compile.Root))
  assert_eq $empty_root[1].parent nil
  assert_eq $empty_root[1].doc nil

  let source = "\n# The answer.\nlet answer = 42\n"
  let unit = compile.compile "answer.dol" $source document: true
  let root = unit.nodes().find(do |pair| type(pair[1], compile.Root))
  assert_eq $root[1].doc nil
  let answer = unit.nodes().find(do |pair|
    (type(pair[1], compile.Bind) && (declared_name(source, pair[1]) == "answer")))
  assert_eq (span_text(source, answer[1].doc)) "# The answer."

#[test]
def a_construct_spans_its_decorators_and_body_but_not_neighboring_lines()
  let source = |-
    def deco f
      f

    #[deco]
    pub def widget x
      let y = x
      y

    pub class Thing
      pub field tag = nil
  let unit = compile.compile "spans.dol" $source document: true
  assert_no_errors $unit
  let nodes = [...unit.nodes()]

  let widget = nodes.find(do |pair|
    (type(pair[1], compile.Function) && (declared_name(source, pair[1]) == "widget")))
  assert_eq (span_text(source, widget[1].span)) |-
    #[deco]
    pub def widget x
      let y = x
      y

  # A binding extends over the statement that declares it, not just the name
  # it binds.
  let y = nodes.find(do |pair|
    (type(pair[1], compile.Bind) && (declared_name(source, pair[1]) == "y")))
  assert_eq (span_text(source, y[1].span)) "let y = x"

  let thing = nodes.find(do |pair| type(pair[1], compile.Class))
  assert_eq (span_text(source, thing[1].span)) |-
    pub class Thing
      pub field tag = nil

#[test]
def methods_record_visibility_and_special_methods_name_their_protocol()
  let source = |-
    class Point
      pub def (init) self
        self

      def (str) self
        self

      pub def visible self
        self

      def hidden self
        self
  let unit = compile.compile "protocol.dol" $source document: true
  assert_no_errors $unit
  let nodes = [...unit.nodes()]

  let visible = nodes.find(do |pair|
    (type(pair[1], compile.Method) && (declared_name(source, pair[1]) == "visible")))
  assert $visible[1].is_pub
  let hidden = nodes.find(do |pair|
    (type(pair[1], compile.Method) && (declared_name(source, pair[1]) == "hidden")))
  assert $!hidden[1].is_pub

  let special = [...nodes.filter(do |pair| type(pair[1], compile.SpecialMethod))]
  assert_eq $special.len 2

#[test]
def parameters_record_form_and_whether_they_have_a_default()
  let source = "def connect host :port = 8080 ...rest\n  nil\n"
  let unit = compile.compile "params2.dol" $source document: true
  assert_no_errors $unit
  let nodes = [...unit.nodes()]

  let host = nodes.find(do |pair| type(pair[1], compile.PositionalParam))
  assert_eq $host[1].default nil

  let port = nodes.find(do |pair| type(pair[1], compile.KeyParam))
  assert_ne $port[1].default nil

  let rest = nodes.find(do |pair| type(pair[1], compile.RestParam))
  assert_eq (declared_name(source, rest[1])) "rest"

#[test]
def sibling_catch_handlers_binding_the_same_name_stay_distinct()
  let source = |-
    import std
    def risky x
      try
        x
      catch std.TypeError: err
        err
      catch err
        err
  let unit = compile.compile "catches.dol" $source document: true
  assert_no_errors $unit
  let nodes = [...unit.nodes()]

  let catches = [...nodes.filter(do |pair| type(pair[1], compile.Catch))]
  assert_eq $catches.len 2
  let catch_ids = [...catches.map(do |pair| pair[0])]

  let binds = [...nodes.filter(do |pair|
    ((type(pair[1], compile.PositionalParam) || type(pair[1], compile.KeyParam) ||
        type(pair[1], compile.RestParam)) &&
      catch_ids.contains(pair[1].parent)))]
  assert_eq $binds.len 2
  assert_ne $binds[0][1].parent $binds[1][1].parent

#[test]
def decorators_resolve_to_the_prelude_item_they_name()
  let source = "class Point\n  #[getter]\n  pub def x self\n    0\n"
  let unit = compile.compile "decorators.dol" $source document: true
    prelude:
      std:
        - getter
  assert_no_errors $unit
  let nodes = [...unit.nodes()]

  let getter = nodes.find(do |pair| type(pair[1], compile.PreludeItem))
  assert_eq $getter[1].item "getter"

  let decorator = nodes.find(do |pair| type(pair[1], compile.Decorator))
  assert_eq $decorator[1].target $getter[0]

  # The decorator hangs off the method it decorates, so a consumer needs no
  # source text to know which declaration carries it.
  let method = nodes.find(do |pair| type(pair[1], compile.Method))
  assert_eq $decorator[1].parent $method[0]

#[test]
def unused_prelude_items_are_not_surfaced_as_nodes()
  let source = "class Point\n  #[getter]\n  pub def x self\n    0\n"
  let unit = compile.compile "decorators2.dol" $source document: true
    prelude:
      std:
        - getter
        - static
  let items = [...unit.nodes().filter(do |pair| type(pair[1], compile.PreludeItem))]
  assert_eq $items.len 1
  assert_eq $items[0][1].item "getter"

# The node of the given type whose declared name is `name`, as an `[id, node]` pair.
def named_node source nodes kind name
  nodes.find(do |pair|
    (type(pair[1], kind) && (declared_name(source, pair[1]) == name)))

# The `[id, node]` pairs of the types describing the node `id`.
def types_of nodes id
  [...nodes.filter(do |pair| (type(pair[1], compile.Type) && (pair[1].parent == id)))]

#[test]
def type_only_declarations_are_exposed()
  let source = r|-
    pub @class Shape
      pub def area self -> Int
    @def grow x @ Int -> Int
    pub def grow x
      x
    pub class Square: @Shape
      @def (init) self
      def (init) _self
        nil
  let unit = compile.compile "type_only.dol" $source document: true
  assert_no_errors $unit
  let nodes = [...unit.nodes()]
  let shape = (named_node source nodes compile.Class "Shape")
  assert $shape[1].type_only
  let area = nodes.find(do |pair| (type(pair[1], compile.Method) && (pair[1].parent == shape[0])))
  assert $area[1].type_only
  let grows = [...nodes.filter(do |pair| type(pair[1], compile.Function))]
  assert_eq [...grows.map(do |pair| pair[1].type_only)] [true, false]
  # An overload is public with its implementation
  assert $grows[0][1].is_pub
  let square = (named_node source nodes compile.Class "Square")
  assert (!(square[1].type_only))
  assert_eq (types_of(nodes, square[0])[0][1].expr.target) $shape[0]
  let inits = [...nodes.filter(do |pair| type(pair[1], compile.SpecialMethod))]
  assert_eq [...inits.map(do |pair| pair[1].type_only)] [true, false]
  # Type-only declarations have nothing to emit
  unit.emit()

#[test]
def types_describe_what_they_annotate()
  let source = r|-
    import std:
      - @Record
    def lookup[T] key @Str table @std.Dict[Str, T] -> (T | nil)
      table.get $key default: nil
    class Box[T]
      pub field first second @T = nil
    let record @Record = nil
    let consts @(:a: | "b" | 1 | true | nil) = nil
    let schema @{name: Str, ?port: Int, *Dict[Str, Str]} = nil
    let func @((Int, ?Int) -> Int) = nil
    def spread[T, :K, ...R] value @T
      value
  let unit = compile.compile "types.dol" $source document: true
  assert_no_errors $unit
  let nodes = [...unit.nodes()]

  let lookup = (named_node source nodes compile.Function "lookup")
  let binder = nodes.find(do |pair| (type(pair[1], compile.Binder) && (pair[1].parent == lookup[0])))
  assert_eq (declared_name(source, binder[1])) "T"
  assert_type $compile.PosBinder $binder[1]

  # A binder's class says how it takes a type argument
  let spread = (named_node source nodes compile.Function "spread")
  let binders = [...nodes.filter(do |pair| (type(pair[1], compile.Binder) && (pair[1].parent == spread[0])))]
  assert_eq [...binders.map(do |pair| type pair[1])] [compile.PosBinder, compile.KeyBinder, compile.MixedRestBinder]

  # A return type describes its function
  let returns = (types_of nodes lookup[0])
  assert_eq $returns.len 1
  let union = returns[0][1].expr
  assert_type $compile.UnionType $union
  assert_eq (span_text(source, union.span)) "(T | nil)"
  assert_eq $union.members[0].target $binder[0]
  assert_type $compile.ConstType $union.members[1]

  # A dotted name resolves its head
  let table = (named_node source nodes compile.PositionalParam "table")
  let app = (types_of(nodes, table[0])[0][1].expr)
  assert_type $compile.AppType $app
  assert_eq (span_text(source, app.base.span)) "std.Dict"
  assert_eq (span_text(source, app.base.head)) "std"
  let std_module = nodes.find(do |pair| (type(pair[1], compile.PreludeModule) && (pair[1].name == "std")))
  assert_eq $app.base.target $std_module[0]
  assert_eq $app.args[1].ty.target $binder[0]

  # Each field a declaration names is described by its annotation
  let box = (named_node source nodes compile.Class "Box")
  let box_binder = nodes.find(do |pair| (type(pair[1], compile.Binder) && (pair[1].parent == box[0])))
  for name = ["first", "second"]
    let field = (named_node source nodes compile.Field name)
    let described = (types_of nodes field[0])
    assert_eq $described.len 1
    assert_eq $described[0][1].expr.target $box_binder[0]

  # A type-only import is a target like any other
  let item = nodes.find(do |pair| type(pair[1], compile.ImportItem))
  let record = (named_node source nodes compile.Bind "record")
  assert_eq (types_of(nodes, record[0])[0][1].expr.target) $item[0]

  let consts = (named_node source nodes compile.Bind "consts")
  let members = (types_of(nodes, consts[0])[0][1].expr.members)
  assert_eq [...members.map(do |m| m.value)] [:a:, "b", 1, true, nil]

  let schema = (named_node source nodes compile.Bind "schema")
  let schema_params = (types_of(nodes, schema[0])[0][1].expr.params)
  assert_eq [...schema_params.map(do |p| type p)] $
    - $compile.KeyTypeParam
    - $compile.KeyTypeParam
    - $compile.PosTypeParam
  assert_eq [...schema_params.map(do |p| type(p, compile.TypeParam))] [true, true, true]
  assert_eq [...schema_params.map(do |p| p.quant)] [nil, :OPT:, :STAR:]
  assert_eq (span_text(source, schema_params[0].key)) "name"
  assert_eq (span_text(source, schema_params[1].span)) "?port: Int"
  assert_type $compile.AppType $schema_params[2].ty

  let func = (named_node source nodes compile.Bind "func")
  let func_type = (types_of(nodes, func[0])[0][1].expr)
  assert_type $compile.FuncType $func_type
  let params = func_type.params
  assert_eq [...params.map(do |a| type a)] [compile.PosTypeParam, compile.PosTypeParam]
  assert_eq [...params.map(do |a| a.quant)] [nil, :OPT:]
  assert_type $compile.NameType $func_type.ret

#[test]
def superclasses_are_types_of_their_class()
  let source = |-
    import std
    import std:
      - Record

    class Named: Record
      pub field name = nil

    class Tagged: std.Record
      pub field tag = nil

    class Keyed[K]: Record[...{*(K): Int}]
      pub field key = nil
  let unit = compile.compile "supers.dol" $source document: true
  assert_no_errors $unit
  let nodes = [...unit.nodes()]

  let module = nodes.find(do |pair| type(pair[1], compile.ImportModule))
  let record = (named_node source nodes compile.ImportItem "Record")

  let named = (named_node source nodes compile.Class "Named")
  let named_supers = (types_of nodes named[0])
  assert_eq $named_supers.len 1
  assert_eq (span_text(source, named_supers[0][1].span)) "Record"
  assert_eq $named_supers[0][1].expr.target $record[0]

  # A dotted name resolves by its head
  let tagged = (named_node source nodes compile.Class "Tagged")
  let tagged_supers = (types_of nodes tagged[0])
  assert_eq $tagged_supers.len 1
  assert_eq (span_text(source, tagged_supers[0][1].span)) "std.Record"
  assert_eq $tagged_supers[0][1].expr.target $module[0]

  # Type arguments may name the class's binders
  let keyed = (named_node source nodes compile.Class "Keyed")
  let binder = nodes.find(do |pair| (type(pair[1], compile.Binder) && (pair[1].parent == keyed[0])))
  let app = (types_of(nodes, keyed[0])[0][1].expr)
  assert_type $compile.AppType $app
  assert_eq (span_text(source, app.span)) "Record[...{*(K): Int}]"
  assert_eq $app.base.target $record[0]
  let arg = app.args[0]
  assert_type $compile.ExpandTypeArg $arg
  assert_eq (span_text(source, arg.span)) "...{*(K): Int}"
  let entries = arg.ty.params[0]
  assert_type $compile.KeyTypeParam $entries
  assert_eq $entries.quant :STAR:
  assert_eq $entries.key_ty.target $binder[0]

  assert (!(record[1].type_only))

#[test]
def type_followups_are_exposed()
  let source = r|-
    import @not_loaded
    pub @let Entries[K @ Str = Sym] = Dict[{..., *(K): Int, *(Tuple[Int, Int]): Str, (K): Bool, "k": nil}]
    let value @Entries[Str] = nil
    @let Later[U @ Array[T], T] = U
  let unit = compile.compile "type_followups.dol" $source document: true
  assert_no_errors $unit
  let nodes = [...unit.nodes()]
  let module = nodes.find(do |pair| type(pair[1], compile.ImportModule))
  assert $module[1].type_only
  let alias = (named_node source nodes compile.Alias "Entries")
  assert $alias[1].is_pub
  let binder = nodes.find(do |pair| (type(pair[1], compile.Binder) && (pair[1].parent == alias[0])))
  assert_eq (span_text(source, binder[1].bound.span)) "Str"
  assert_eq (span_text(source, binder[1].default.span)) "Sym"
  let schema = (types_of(nodes, alias[0])[0][1].expr.args[0].ty)
  assert_type $compile.SchemaType $schema
  assert_eq [...schema.params.map(do |param| type param)] $
    - $compile.OpenTypeParam
    - $compile.KeyTypeParam
    - $compile.KeyTypeParam
    - $compile.KeyTypeParam
    - $compile.KeyTypeParam
  assert_eq [...schema.params.map(do |param| param.quant)] [nil, :STAR:, :STAR:, nil, nil]
  assert_eq (span_text(source, schema.params[0].span)) "..."
  assert_eq (span_text(source, schema.params[1].key_ty.span)) "(K)"
  assert_eq (span_text(source, schema.params[2].key_ty.span)) "(Tuple[Int, Int])"
  # A key other than a bareword is a type, and a name in it resolves
  assert_eq (span_text(source, schema.params[3].key)) "(K)"
  assert_eq $schema.params[3].key_ty.target $binder[0]
  assert_type $compile.ConstType $schema.params[4].key_ty
  assert_eq $schema.params[4].key_ty.value "k"
  # A binder's bound may name a later binder
  let later = (named_node source nodes compile.Alias "Later")
  let later_binders = [...nodes.filter(do |pair| (type(pair[1], compile.Binder) && (pair[1].parent == later[0])))]
  assert_eq $later_binders[0][1].bound.args[0].ty.target $later_binders[1][0]
  # Names in a binder's bound and default, and in the aliased type, resolve
  let prelude_item = do |item|
    nodes.find(do |pair| (type(pair[1], compile.PreludeItem) && (pair[1].item == item)))[0]
  assert_eq $binder[1].bound.target (prelude_item "Str")
  assert_eq $binder[1].default.target (prelude_item "Sym")
  assert_eq (types_of(nodes, alias[0])[0][1].expr.base.target) (prelude_item "Dict")
  assert_eq $schema.params[1].key_ty.target $binder[0]
  # Type-only declarations have no runtime imports or bindings to emit.
  unit.emit()

#[test]
def sibling_module_type_imports_resolve_separately()
  # Modules are not nested, so sibling imports bind the same head and only the
  # whole path says which module a dotted name comes from.
  let source = r|-
    import
      @not_loaded.one
      - @not_loaded.two
    pub @let First = not_loaded.one.Thing
    pub @let Second = not_loaded.two.Thing
  let unit = compile.compile "siblings.dol" $source document: true
  assert_no_errors $unit
  # Both imports are used, so neither is reported unused
  let diagnostics = [...unit.diagnostics()]
  assert_eq $diagnostics.len 0
  let nodes = [...unit.nodes()]
  let imports = [...nodes.filter(do |pair| type(pair[1], compile.ImportModule))]
  assert_eq $imports.len 2
  for pair = imports
    assert $pair[1].type_only
  let first = (named_node source nodes compile.Alias "First")
  let second = (named_node source nodes compile.Alias "Second")
  assert_eq (types_of(nodes, first[0])[0][1].expr.target) $imports[0][0]
  assert_eq (types_of(nodes, second[0])[0][1].expr.target) $imports[1][0]

#[test]
def unused_module_type_import_names_its_whole_path()
  let source = r|-
    import @not_loaded.one
    import @not_loaded.two
    pub @let First = not_loaded.one.Thing
  let unit = compile.compile "unused_sibling.dol" $source document: true
  assert_no_errors $unit
  let diagnostics = [...unit.diagnostics()]
  assert_eq $diagnostics.len 1
  assert_eq (span_text(source, diagnostics[0].span.span)) "not_loaded.two"

#[test]
def a_module_import_names_types_in_that_module_alone()
  # Importing the head of a path does not reach the modules under it, so the
  # whole module a type names must be imported.
  let source = r|-
    import @not_loaded
    import loaded
    pub @let Near = not_loaded.Thing
    pub @let Far = not_loaded.deeper.Thing
    pub @let Runtime = loaded.nested.Thing
  let unit = compile.compile "reach.dol" $source document: true
  assert_no_errors $unit
  let unbound = [...unit.diagnostics().filter(do |d| (d.message == "unbound type name"))]
  # The module is what is unbound, so each is reported over its whole path
  assert_eq [...unbound.map(do |d| span_text(source, d.span.span))] ["not_loaded.deeper", "loaded.nested"]

#[test]
def rest_annotation_expansion_is_indexed()
  let source = "def f[...Rs] ...args @ ...(() -> Rs) -> Tuple[...Rs]\n  args\n"
  let unit = compile.compile "rest.dol" $source document: true
  assert_no_errors $unit
  let rest = unit.nodes().find(do |pair| type(pair[1], compile.RestParam))[1]
  assert_eq (span_text source rest.type_ellipsis) "..."
  assert_eq $rest.type_ellipsis.start.byte_offset 23
  bind rest
    :type_ellipsis
    ...
  assert_eq $type_ellipsis.start.byte_offset $rest.type_ellipsis.start.byte_offset

#[test]
def type_arguments_are_positional_keyword_or_expansions()
  let source = "let r @ Record[Int, name: Str, ...{*Bool}] = nil\n"
  let unit = compile.compile "args.dol" $source document: true
  assert_no_errors $unit
  let nodes = [...unit.nodes()]
  let bind_node = (named_node source nodes compile.Bind "r")
  let args = (types_of(nodes, bind_node[0])[0][1].expr.args)
  assert_eq [...args.map(do |a| type a)] [compile.PosTypeArg, compile.KeyTypeArg, compile.ExpandTypeArg]
  assert $args.all(do |a| type(a, compile.TypeArg))
  assert_eq (span_text(source, args[1].name)) "name"
  assert_eq (span_text(source, args[1].span)) "name: Str"
  assert_eq (span_text(source, args[2].span)) "...{*Bool}"
  assert_type $compile.SchemaType $args[2].ty

#[test]
def invalid_rest_annotation_expansions()
  for source = [
    "def f x @ ...Int\n  x\n",
    "def f ...x @ ...\n  x\n",
    "def f ...x @ ......Int\n  x\n",
    "def f ...x -> ...Int\n  x\n",
    "def f ...x @ ... Int\n  x\n",
  ]
    let unit = compile.compile "bad-rest.dol" $source recover: true
    assert (unit.diagnostics().count() > 0)

#[test]
def statement_type_imports_keep_document_targets()
  let source = r|-
    pub @import missing.module: renamed
    pub @import
      missing.other: other
      missing.items:
        - Item
        Original: Alias
        - @Explicit
    pub @let First = renamed.Thing
    pub @let Second = other.Thing
    pub @let Third = Item
    pub @let Fourth = Alias
    pub @let Fifth = Explicit
  let unit = compile.compile "static_imports.dol" $source document: true
  assert_no_errors $unit
  assert_eq ([...unit.diagnostics()].len) 0
  let nodes = [...unit.nodes()]
  let imports = [...nodes.filter(do |pair|
    (type(pair[1], compile.ImportModule) || type(pair[1], compile.ImportItem)))]
  assert_eq $imports.len 5
  for pair = imports
    assert $pair[1].type_only
    assert $pair[1].is_pub
  for i name = ["First", "Second", "Third", "Fourth", "Fifth"].enumerate()
    let alias = (named_node source nodes compile.Alias name)
    assert_eq (types_of(nodes, alias[0])[0][1].expr.target) $imports[i][0]
  assert_eq (span_text source imports[0][1].module) "missing.module"
  assert_eq (span_text source imports[0][1].name) "renamed"
  unit.emit()

#[test]
def rest_kinds_are_exposed()
  let source = r|-
    def split[*Ps, **Ks] a *rest @Ps **kw @Ks -> Tuple[...Ps]
      [a, rest, kw]
    def mixed[...R] ...rest @R
      rest
    let schema @{*Int, **Str, *...{a: Bool}} = nil
  let unit = compile.compile "rest_kinds.dol" $source document: true
  assert_no_errors $unit
  let nodes = [...unit.nodes()]

  # A rest binder's type says which items it takes
  let kinds = do |name|
    let func = (named_node source nodes compile.Function name)
    let binders = nodes.filter(do |pair| (type(pair[1], compile.RestBinder) && (pair[1].parent == func[0])))
    [...binders.map(do |pair| type pair[1])]
  assert_eq (kinds "split") [compile.PosRestBinder, compile.KeyRestBinder]
  assert_eq (kinds "mixed") [compile.MixedRestBinder]

  # So does a rest parameter's
  let params = do |name|
    let func = (named_node source nodes compile.Function name)
    let rests = nodes.filter(do |pair| (type(pair[1], compile.RestParam) && (pair[1].parent == func[0])))
    [...rests.map(do |pair| type pair[1])]
  assert_eq (params "split") [compile.PosRestParam, compile.KeyRestParam]
  assert_eq (params "mixed") [compile.MixedRestParam]

  # And a rest item's
  let schema = (named_node source nodes compile.Bind "schema")
  let schema_params = (types_of(nodes, schema[0])[0][1].expr.params)
  assert_eq [...schema_params.map(do |p| type p)] $
    - $compile.PosTypeParam
    - $compile.PosTypeParam
    - $compile.IncludeTypeParam
  assert_eq [...schema_params.map(do |p| p.quant)] [:STAR:, :STAR_STAR:, :STAR:]
  assert $schema_params.all(do |p| type(p, compile.TypeParam))
  assert_eq (span_text(source, schema_params[1].span)) "**Str"
  unit.emit()

#[test]
def implicit_params_are_exposed()
  let source = r|-
    def reads a @Int <Iter[Int] >Sink[Str] -> nil
      nil
    def plain a
      a
    let func @((Int, <Iter[Int], >Sink[Str]) -> Int) = nil
  let unit = compile.compile "implicits.dol" $source document: true
  assert_no_errors $unit
  let nodes = [...unit.nodes()]

  # A declaration's implicits are parameter nodes that bind no name
  let implicits = do |name|
    let func = (named_node source nodes compile.Function name)
    let found = nodes.filter(do |pair| (type(pair[1], compile.ImplicitParam) && (pair[1].parent == func[0])))
    [...found.map(do |pair| type pair[1])]
  assert_eq (implicits "reads") [compile.InputParam, compile.OutputParam]
  assert_eq (implicits "plain") []

  let input = nodes.find(do |pair| type(pair[1], compile.InputParam))[1]
  assert $type(input, compile.Param)
  assert_eq $input.name nil
  assert_eq (span_text source input.span) "<Iter[Int]"

  # A function type carries them beside its parameters
  let func = (named_node source nodes compile.Bind "func")
  let func_type = (types_of(nodes, func[0])[0][1].expr)
  assert_type $compile.FuncType $func_type
  assert_eq [...func_type.params.map(do |p| type p)] [compile.PosTypeParam]
  assert_type $compile.AppType $func_type.input
  assert_type $compile.AppType $func_type.output
  assert_eq (span_text source func_type.input.span) "Iter[Int]"

  unit.emit()
