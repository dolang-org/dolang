import compile std
  test:
    - assert
    - assert_eq
    - assert_type
    - test
  std:
    - hash

def assert_span_contract left right
  assert_type $compile.Span $left
  assert_type $compile.Span $right
  assert_eq $left $right
  assert_eq (hash left) (hash right)
  assert (left <= right)

  let left_start = left.start
  let right_start = right.start
  assert_type $compile.Pos $left_start
  assert_type $compile.Pos $right_start
  assert_eq $left_start $right_start
  assert_eq (hash left_start) (hash right_start)
  assert (left_start <= left.end)

#[test]
def success()
  let result = compile.compile "ok.dol" |-
    def foo
      1
    foo()

  assert_type $compile.Unit $result
  assert_eq 0 $ result.diagnostics().count()
  assert_type $Bin $result.emit()

#[test]
def warning()
  let result = compile.compile "warn.dol" |-
    def foo unused
      nil
    foo 1

  let diagnostics = [...result.diagnostics()]
  assert_eq $diagnostics.len 1

  let diag = diagnostics[0]
  assert_type $compile.Diagnostic $diag
  assert_eq $diag.severity :WARNING:
  let span = diag.span
  let equal_span = diag.span
  assert_span_contract $span $equal_span
  assert_eq $diag.patches.len 0
  assert_eq $diag.notes.len 0

#[test]
def error()
  let result = compile.compile "bad.dol" "let =\n"
  let diagnostics = [...result.diagnostics()]
  assert (diagnostics.len > 0)

  let diag = diagnostics[0]
  assert_type $compile.Diagnostic $diag
  assert_eq $diag.severity :ERROR:
  let span = diag.span
  let equal_span = diag.span
  assert_span_contract $span $equal_span
  assert_type $Array $diag.annotations
  assert_type $Array $diag.notes
  assert_type $Array $diag.patches

#[test]
def nodes()
  let source = |-
    pub def greet name :punctuation = "!" ...rest
      return name
  let unit = compile.compile "nodes.dol" $source document: true
  let seen = 0
  let first_id = nil
  let first_node = nil
  for id node = unit.nodes()
    assert_type $compile.NodeId $id
    assert_type $compile.Node $node
    assert_type $compile.Span $node.span
    if (seen == 0)
      first_id = id
      first_node = node
    seen = (seen + 1)
  assert (seen > 0)
  assert_type $compile.Root $first_node
  assert_eq $first_node.parent nil
  assert_eq $first_node.doc nil
  assert_eq $source[first_node.span.start.byte_offset..first_node.span.end.byte_offset] $source
  assert_type (type first_node) $unit.node(first_id)

  let bytecode = unit.emit()
  assert_type $Bin $bytecode
  let err = try
    first_node.span
  catch e
    e
  assert_type $std.StateError $err

#[test]
def document_option()
  let source = "let answer = 42\nanswer\n"
  let default = compile.compile "option.dol" $source
  let disabled = compile.compile "option.dol" $source document: false
  let enabled = compile.compile "option.dol" $source document: true
  assert_eq $default.nodes().count() 0
  assert_eq $disabled.nodes().count() 0
  assert (enabled.nodes().count() > 0)
  let bytecode = enabled.emit()
  assert_eq $default.emit() $bytecode
  assert_eq $disabled.emit() $bytecode

#[test]
def node_doc_comments()
  let source = |-
    let sentinel = nil

    # A greeting.
    #
    # Spans several lines.
    pub def greet name
      name
  let unit = compile.compile "doc.dol" $source document: true
  let seen = 0
  for _id node = unit.nodes()
    if (type(node, compile.Function))
      let doc = node.doc
      assert_type $compile.Span $doc
      assert_eq $source[doc.start.byte_offset..doc.end.byte_offset] |-
        # A greeting.
        #
        # Spans several lines.
      seen = (seen + 1)
    else if (type(node, compile.PositionalParam))
      # The block above the function documents it, not the parameters that
      # happen to be written on the same line.
      assert_eq $node.doc nil
  assert_eq $seen 1

#[test]
def root_doc_comments()
  let source = |-
    # Module summary.
    #
    # ## Details

    pub let answer = 42
  let unit = compile.compile "module-doc.dol" $source document: true
  let root = unit.nodes().find(do |pair| type(pair[1], compile.Root))[1]
  assert_eq $root.parent nil
  assert_eq $source[root.span.start.byte_offset..root.span.end.byte_offset] $source
  let doc = root.doc
  assert_eq $source[doc.start.byte_offset..doc.end.byte_offset] |-
    # Module summary.
    #
    # ## Details

# A source exercising every concrete node kind at least once. The prelude
# bindings are referenced rather than merely configured: a prelude node is
# recorded where its binding resolves, so one nothing mentions never appears.
let HIERARCHY_SOURCE = r|-
  import std
  import std:
    - hash

  def mark f
    f

  pub class Base
    pub field size = 0

  #[mark]
  pub class Widget: Base
    def (init) self n
      self.size = n

    pub def scale self factor :mode = "up" ...rest
      let doubled = do |x| (x * 2)
      let squares = $
        for x = [1, 2]
          if (x > 0)
            - (x * x)
      for i = [1, 2]
        if (i > 1)
          continue
        else
          break
      while false
        break
      try
        echo $ hash $factor
        std.str $doubled
      catch _
        nil
      finally
        t.now()
      return squares

#[test]
def node_hierarchy()
  let unit = compile.compile "hierarchy.dol" $HIERARCHY_SOURCE document: true prelude: $
    sys:
      - echo
    time: t
  for diag = unit.diagnostics()
    assert_eq $diag.severity :WARNING:

  # Each supertype paired with every concrete kind documented as extending it.
  let groups = [
    [compile.Declaration, [compile.Class, compile.Function, compile.Method,
      compile.SpecialMethod, compile.Field, compile.Bind, compile.SelfParam,
      compile.ImportModule, compile.ImportItem, compile.PreludeModule,
      compile.PreludeItem]],
    [compile.Import, [compile.ImportModule, compile.ImportItem,
      compile.PreludeModule, compile.PreludeItem]],
    [compile.Param, [compile.PositionalParam, compile.KeyParam,
      compile.RestParam]],
    [compile.Block, [compile.Lambda, compile.If, compile.Else, compile.While,
      compile.For, compile.Try, compile.Catch, compile.Finally,
      compile.ForElem, compile.IfElem]],
    [compile.Reference, [compile.Decorator, compile.Break, compile.Continue,
      compile.Return]],
  ]

  let seen = []
  for _id node = unit.nodes()
    assert_type $compile.Node $node
    let ty = type $node
    if !seen.contains(ty)
      seen.push $ty
    for entry = groups
      let super members = entry
      if members.contains(ty)
        assert_type $super $node

  # Every kind the documentation lists is reachable, so a kind that stops being
  # produced cannot go unnoticed.
  for entry = groups
    let _super members = entry
    for member = members
      assert $seen.contains(member)
  assert $seen.contains(compile.Root)
  assert_eq $seen.len 29
