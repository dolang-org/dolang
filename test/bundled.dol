import _shell
  test:
    - assert
    - test

#[test]
def stock_bundles_are_present()
  for name = ["std", "strand", "math", "proc", "json", "args"]
    assert (_shell.resource("dolang.typelib", name) != nil)
  for name = ["test", "dodo", "ssh", "fs", "proc"]
    assert (_shell.resource("dolang.entrypoint", name) != nil)
  for name = ["dodo", "test", "docker", "transfer"]
    assert (_shell.resource("dolang.module", name) != nil)
