import sys sqlite systemd strand progress docker podman
  fs:
    - with_temp_dir
    - Path
  fs.unix: unix
  test:
    - ignore
    - skip
    - assert
    - assert_eq
    - fixture
    - parametrize
    - test
    - tags

if (sys.os_info().os != :LINUX:)
  ignore "not supported on this system"

tags
  - slow

let runtime_key = strand.Key()

def runtime()
  runtime_key.value

def backend_dispatch block :backend ...remainder
  if !run[backend].which()
    skip "$backend is not installed"
  runtime_key.value = if (backend == "docker")
    docker
  else
    podman
  block(...remainder)

# Runs the decorated test once per container backend (`docker`, `podman`),
# skipping a backend that isn't installed. Stack above `#[test]`.
def backend func = nil
  if (func == nil)
    return do |func| backend $func
  let with_backend_fixture = fixture $backend_dispatch
  let wrapped = with_backend_fixture $func
  parametrize $wrapped backend: ["docker", "podman"]

def remove_image tag
  try
    let img = runtime().image $tag
    img.remove force: true
  catch runtime().NoImageError: _
    nil

def remove_container name
  try
    let ctr = runtime().container $name
    ctr.remove force: true
  catch runtime().NoContainerError: _
    nil

def clean_image tag block
  try
    block()
  finally
    progress.show message: "removing image" icon: 🧹 do |_|
      remove_image $tag

def clean_container name block
  try
    block()
  finally
    progress.show message: "removing container" icon: 🧹 do |_|
      remove_container $name

#[test]
#[backend]
def read_ubuntu_release()
  let runtime = runtime()
  let overrides = $
    TEST_DOLANG_CONTAINER_SET: "value"
    TEST_DOLANG_CONTAINER_UNSET: nil
  let release = runtime.with ubuntu:24.04 cd: /tmp env: $overrides do
    assert_eq $cd() (unix.Path "/tmp")
    assert_eq $env["TEST_DOLANG_CONTAINER_SET"] value
    assert_eq $env.get("TEST_DOLANG_CONTAINER_UNSET", default: nil) nil
    systemd.os_release()
  bind release
    "NAME": name
    "VERSION_ID": ver
    ...
  assert_eq $name Ubuntu
  assert_eq $ver "24.04"

#[test]
#[backend]
def read_fedora_packages()
  let runtime = runtime()
  let pkgs = runtime.with fedora:43 do
    sqlite.open /var/lib/rpm/rpmdb.sqlite do |conn|
      conn.prepare t"SELECT key from Name" do |stmt|
        [...stmt.query().map do |row| row[0]]
  assert $ pkgs.contains bash
  assert $ pkgs.contains sudo

#[test]
#[backend]
def run_direct_command()
  let runtime = runtime()
  let overrides = $
    TEST_DOLANG_CONTAINER_SET: value
    TEST_DOLANG_CONTAINER_UNSET: nil
  let script = r#"printf "%s\n%s\n%s\n" "$PWD" "$TEST_DOLANG_CONTAINER_SET" "${TEST_DOLANG_CONTAINER_UNSET-unset}"; cat /etc/os-release"#
  let release = sub do runtime.run ubuntu:24.04 /bin/sh -c $script cd: /tmp env: $overrides
  assert $ release.starts_with "/tmp\nvalue\nunset\n"
  assert $ release.contains "NAME=\"Ubuntu\""
  assert $ release.contains "VERSION_ID=\"24.04\""

#[test]
#[backend]
def run_structured_options()
  let runtime = runtime()
  let name = "dolang-test-run-structured-options"
  remove_container $name
  let script = r#"printf "%s\n%s\n%s\n" "$PWD" "$TEST_DOLANG_CREATE" "$(id -u)"; test -r /mnt/host-release"#
  let output = sub do runtime.run ubuntu:24.04 -c $script
    name: $name
    entrypoint: /bin/sh
    cd: /tmp
    env: {TEST_DOLANG_CREATE: "value"}
    mounts:
      - type: :BIND:
        source: /etc/os-release
        target: /mnt/host-release
        readonly: true
    labels: {dolang_test: "structured-run"}
    ports:
      - container_port: 8080
        host_ip: "127.0.0.1"
        protocol: :TCP:
    networks:
      - bridge
    user: "65534:65534"
  assert_eq $output "/tmp\nvalue\n65534"

#[test]
#[backend]
def image_build_inspect_remove()
  let runtime = runtime()
  let image_tag = "dolang-test-image-inspect-remove:latest"
  let overrides = {TEST_DOLANG_CONTAINER_BUILD: "value"}
  let build_step = do
    assert_eq $cd() (unix.Path "/tmp")
    assert_eq $env["TEST_DOLANG_CONTAINER_BUILD"] value
    run touch /test-marker
  # Build a minimal image
  let built = runtime.build
    from: ubuntu:24.04
    cd: /tmp
    env: $overrides
    mounts:
      - type: :CACHE:
        target: /var/cache/apt
    run: $build_step
    tag: $image_tag

  # Inspect via image()
  let img = runtime.image $image_tag
  let tags = img.tags()
  assert_eq $built.id $img.id
  assert_eq $tags[0].repo dolang-test-image-inspect-remove
  assert_eq $tags[0].tag latest
  assert (img.id.starts_with "sha256:")
  assert_eq $img.os linux
  assert (img.layers.len > 0)

  # Verify it shows up in images()
  let found = [...runtime.images filter: "reference=$image_tag"]
  assert_eq $found.len 1
  assert_eq $found[0].id $img.id

  # Clean up
  img.remove()

  # Verify it's gone by catching NoImageError
  let gone = try
    runtime.image $image_tag
    false
  catch runtime.NoImageError: _
    true
  assert $gone

#[test]
#[backend]
def image_build_multi_tag()
  let runtime = runtime()
  let image_tag = "dolang-test-image-multi-tag:latest"
  let image_tag_alt = "dolang-test-image-multi-tag:alt"
  let img = runtime.build
    from: ubuntu:24.04
    run: do run touch /multi-tag-marker
    tag: $image_tag
    tag: $image_tag_alt

  let latest = runtime.image $image_tag
  let alt = runtime.image $image_tag_alt
  assert_eq $img.id $latest.id
  assert_eq $img.id $alt.id

  latest.remove force: true

#[test]
#[backend]
def image_build_patch_step()
  let runtime = runtime()
  let tag = "dolang-test-image-patch-step:latest"
  let path = Path /tmp/dolang-patch-test.txt

  clean_image $tag do
    runtime.build
      from: ubuntu:24.04
      add:
        target: $path
        content: |
          alpha
      patch:
        content: |
          --- $path
          +++ $path
          @@ -1 +1 @@
          -alpha
          +beta
      tag: $tag

    let contents = runtime.with $tag do path.read()
    assert_eq $contents "beta\n"

#[test]
#[backend]
def image_build_untagged()
  let runtime = runtime()
  let img = runtime.build
    from: ubuntu:24.04
    run: do run touch /untagged-marker
    commit: nil

  assert (img.id.starts_with "sha256:")
  let same = runtime.image $img.id
  assert_eq $same.id $img.id
  assert_eq $img.tags().len 0
  img.remove()

#[test]
#[backend]
def image_save_load()
  let runtime = runtime()
  let image_archive_tag = "dolang-test-image-save-load:latest"
  runtime.build
    from: ubuntu:24.04
    run: do run touch /archive-marker
    tag: $image_archive_tag

  let img = runtime.image $image_archive_tag

  with_temp_dir do |dir|
    let archive1 = (dir / "method.tar")
    let archive2 = (dir / "free.tar")

    img.save $archive1 format: :DOCKER_ARCHIVE:
    runtime.save $archive2 format: :DOCKER_ARCHIVE: $image_archive_tag

    img.remove()

    let loaded = runtime.load $archive2
    assert_eq $loaded.len 1

    let restored = runtime.image $image_archive_tag
    let tags = restored.tags()
    assert_eq $loaded[0].id $restored.id
    assert_eq $tags[0].repo dolang-test-image-save-load
    assert_eq $tags[0].tag latest

  let restored = runtime.image $image_archive_tag
  restored.remove()

#[test]
#[backend]
def push_missing_image()
  let runtime = runtime()
  let missing = try
    runtime.push "dolang-definitely-missing-image:latest"
    false
  catch runtime.NoImageError: _
    true
  assert $missing

#[test]
#[backend]
def container_inspect_lifecycle()
  let runtime = runtime()
  let name = "dolang-test-container-inspect-lifecycle"
  remove_container $name

  clean_container $name do
    let ctr = nil
    progress.steps
      - name: create and inspect
        do
          ctr = runtime.create ubuntu:24.04 sleep infinity name: $name
          ctr.start()
          let state = ctr.state()
          assert_eq $state.name $name
          # Podman fully qualifies the reference (`docker.io/library/ubuntu:24.04`)
          # when recording what a container was created from; Docker records it
          # exactly as given. Both are correct, so match on the suffix.
          assert $ctr.image.ends_with "ubuntu:24.04"
          assert_eq $state.state :RUNNING:
          assert_eq $state.status running
          assert $ctr.created
          assert_eq $state.ports []
      - name: list containers
        do
          let listed = [...runtime.containers filter: "name=$name"]
          assert_eq $listed.len 1
          assert_eq $listed[0].id $ctr.id
      - name: connect via vfs
        do
          let overrides = $
            TEST_DOLANG_CONTAINER_WITH_SET: value
            TEST_DOLANG_CONTAINER_WITH_UNSET: nil
          let result = ctr.with cd: /tmp env: $overrides do
            assert_eq $cd() (unix.Path "/tmp")
            assert_eq $env["TEST_DOLANG_CONTAINER_WITH_SET"] value
            assert_eq $env.get("TEST_DOLANG_CONTAINER_WITH_UNSET", default: nil) nil
            assert $Path("/etc/os-release").exists()
            for entry = Path("/tmp").entries()
              assert (!entry.name.starts_with("dolang-vfs-"))
            sub do run printf container-with
          assert_eq $result container-with
          assert_eq $ctr.state().state :RUNNING:
      - name: unwind and reenter vfs session
        do
          let unwound = try
            ctr.with do throw "container with unwind"
            false
          catch e
            assert_eq (str e) "container with unwind"
            true
          assert $unwound
          let reentered = ctr.with do sub do run printf reentered
          assert_eq $reentered reentered
      - name: stop and list stopped
        do
          ctr.stop()
          assert_eq $ctr.state().state :EXITED:
          let listed_all = [...runtime.containers all: true filter: "name=$name"]
          assert_eq $listed_all.len 1
          assert_eq $listed_all[0].id $ctr.id
      - name: start and restart
        do
          ctr.start()
          assert_eq $ctr.state().state :RUNNING:
          ctr.restart()
          assert_eq $ctr.state().state :RUNNING:
      - name: remove and verify gone
        do
          ctr.remove force: true
          let gone = try
            runtime.container $name
            false
          catch runtime.NoContainerError: _
            true
          assert $gone

#[test]
#[backend]
def container_create_structured_lifecycle()
  let runtime = runtime()
  let name = "dolang-test-container-create-structured"
  remove_container $name

  clean_container $name do
    let ctr = nil
    progress.steps
      - name: create with structured options
        do
          ctr = runtime.create ubuntu:24.04 -c "sleep infinity"
            :name
            entrypoint: /bin/sh
            cd: /tmp
            env: {TEST_DOLANG_CREATE: "value"}
            mounts:
              - type: :BIND:
                source: /etc/os-release
                target: /mnt/host-release
                readonly: true
            labels: {dolang_test: "structured-create"}
            ports:
              - container_port: 8080
                host_ip: "127.0.0.1"
                protocol: :TCP:
            networks:
              - bridge
            user: "65534:65534"
            restart:
              policy: :ON_FAILURE:
              max_retries: 3

          assert_eq $ctr.state().state :CREATED:
          assert_eq $ctr.labels["dolang_test"] structured-create
          assert_eq $ctr.entrypoint ["/bin/sh"]
          assert_eq $ctr.cmd ["-c", "sleep infinity"]
      - name: start and verify config via vfs
        do
          ctr.start()
          let configured = ctr.with do
            let uid = sub do run id -u
            record
              cd: $cd()
              env: $env["TEST_DOLANG_CREATE"]
              uid: $uid
              mounted: $Path("/mnt/host-release").exists()
          assert_eq $configured.cd (unix.Path "/tmp")
          assert_eq $configured.env value
          assert_eq $configured.uid "65534"
          assert $configured.mounted
      - name: inspect running state
        do
          let state = ctr.state()
          assert_eq $state.state :RUNNING:
          assert_eq $state.ports.len 1
          assert_eq $state.ports[0].container_port 8080
          assert_eq $state.ports[0].protocol :TCP:

#[test]
#[backend]
def container_wait_status()
  let runtime = runtime()
  let success_name = "dolang-test-container-wait-success"
  let failure_name = "dolang-test-container-wait-failure"
  remove_container $success_name
  remove_container $failure_name

  clean_container $success_name do
    let ctr = runtime.create ubuntu:24.04 /bin/sh -c "exit 0" name: $success_name
    ctr.start()
    assert_eq $ctr.wait() nil

  clean_container $failure_name do
    let ctr = runtime.create ubuntu:24.04 /bin/sh -c "exit 42" name: $failure_name
    ctr.start()
    let failed = try
      ctr.wait()
      false
    catch runtime.ContainerExitError: e
      assert_eq $e.rc 42
      true
    assert $failed

#[test]
#[backend]
def container_with_non_root_user()
  let runtime = runtime()
  let name = "dolang-test-container-with-non-root"
  remove_container $name

  clean_container $name do
    let ctr = runtime.create ubuntu:24.04 sleep infinity name: $name user: "65534:65534"
    ctr.start()
    let uid = ctr.with do sub do run id -u
    assert_eq $uid "65534"
    assert_eq $ctr.state().state :RUNNING:
