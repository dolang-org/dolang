import proc sys sqlite systemd
  fs:
    - with_temp_dir
    - Path
  test:
    - skip
    - assert
    - assert_eq
    - test

import fs.unix: unix_fs

if (sys.os_info().os != :LINUX:)
  skip "not supported on this system"

let runtime = if run.docker.which()
  import docker
  docker
else if run.podman.which()
  import podman
  podman
else
  skip "no container runtime available"

def remove_image tag
  try
    let img = runtime.image $tag
    img.remove force: true
  catch runtime.NoImageError: _
    nil

def remove_container name
  try
    let ctr = runtime.container $name
    ctr.remove force: true
  catch runtime.NoContainerError: _
    nil

def clean_image tag block
  try
    block()
  finally
    remove_image $tag

def clean_container name block
  try
    block()
  finally
    remove_container $name

#[test]
def read_ubuntu_release()
  let overrides = $
    TEST_DOLANG_CONTAINER_SET: "value"
    TEST_DOLANG_CONTAINER_UNSET: nil
  let release = runtime.with ubuntu:24.04 cd: /tmp env: $overrides do
    assert_eq $cd() (unix_fs.Path "/tmp")
    assert_eq $env["TEST_DOLANG_CONTAINER_SET"] value
    assert_eq $env.get("TEST_DOLANG_CONTAINER_UNSET", default: nil) nil
    systemd.os_release()
  bind release
    "NAME": name
    "VERSION_ID": ver
    ...
  assert_eq $name Ubuntu
  assert_eq $ver "24.04"

#[test]
def read_fedora_packages()
  let pkgs = runtime.with fedora:43 do
    sqlite.open /var/lib/rpm/rpmdb.sqlite do |conn|
      conn.prepare "SELECT key from Name" do |stmt|
        [...stmt.query().map do |row| row[0]]
  assert $ pkgs.contains bash
  assert $ pkgs.contains sudo

#[test]
def run_direct_command()
  let overrides = $
    TEST_DOLANG_CONTAINER_SET: value
    TEST_DOLANG_CONTAINER_UNSET: nil
  let script = r#"printf "%s\n%s\n%s\n" "$PWD" "$TEST_DOLANG_CONTAINER_SET" "${TEST_DOLANG_CONTAINER_UNSET-unset}"; cat /etc/os-release"#
  let release = sub do runtime.run ubuntu:24.04 /bin/sh -c $script cd: /tmp env: $overrides
  assert $ release.starts_with "/tmp\nvalue\nunset\n"
  assert $ release.contains "NAME=\"Ubuntu\""
  assert $ release.contains "VERSION_ID=\"24.04\""

let container_cli = if run.docker.which()
  run.docker
else
  run.podman

#[test]
def image_build_inspect_remove()
  let image_tag = "dolang-test-image-inspect-remove:latest"
  let overrides = {TEST_DOLANG_CONTAINER_BUILD: "value"}
  let build_step = do
    assert_eq $cd() (unix_fs.Path "/tmp")
    assert_eq $env["TEST_DOLANG_CONTAINER_BUILD"] value
    run touch /test-marker
  # Build a minimal image
  let built = runtime.build
    from: ubuntu:24.04
    cd: /tmp
    env: $overrides
    run: $build_step
    tag: $image_tag

  # Inspect via image()
  let img = runtime.image $image_tag
  let tags = img.tags()
  assert_eq $built.id $img.id
  assert_eq $tags[0].repo dolang-test-image-inspect-remove
  assert_eq $tags[0].tag latest
  assert (img.id.starts_with "sha256:")
  assert_eq $img.os linux
  assert (img.layers.len > 0)

  # Verify it shows up in images()
  let found = [...runtime.images filter: "reference=$image_tag"]
  assert_eq $found.len 1
  assert_eq $found[0].id $img.id

  # Clean up
  img.remove()

  # Verify it's gone by catching NoImageError
  let gone = try
    runtime.image $image_tag
    false
  catch runtime.NoImageError: _
    true
  assert $gone

#[test]
def image_build_multi_tag()
  let image_tag = "dolang-test-image-multi-tag:latest"
  let image_tag_alt = "dolang-test-image-multi-tag:alt"
  let img = runtime.build
    from: ubuntu:24.04
    run: do run touch /multi-tag-marker
    tag: $image_tag
    tag: $image_tag_alt

  let latest = runtime.image $image_tag
  let alt = runtime.image $image_tag_alt
  assert_eq $img.id $latest.id
  assert_eq $img.id $alt.id

  latest.remove force: true

#[test]
def image_build_patch_step()
  let tag = "dolang-test-image-patch-step:latest"
  let path = Path /tmp/dolang-patch-test.txt

  clean_image $tag do
    runtime.build
      from: ubuntu:24.04
      add:
        target: $path
        content: |
          alpha
      patch:
        content: |
          --- $path
          +++ $path
          @@ -1 +1 @@
          -alpha
          +beta
      tag: $tag

    let contents = runtime.with $tag do path.read()
    assert_eq $contents "beta\n"

#[test]
def image_build_untagged()
  let img = runtime.build
    from: ubuntu:24.04
    run: do run touch /untagged-marker

  assert (img.id.starts_with "sha256:")
  let same = runtime.image $img.id
  assert_eq $same.id $img.id
  assert_eq $img.tags().len 0
  img.remove()

#[test]
def image_save_load()
  let image_archive_tag = "dolang-test-image-save-load:latest"
  runtime.build
    from: ubuntu:24.04
    run: do run touch /archive-marker
    tag: $image_archive_tag

  let img = runtime.image $image_archive_tag

  with_temp_dir do |dir|
    let archive1 = (dir / "method.tar")
    let archive2 = (dir / "free.tar")

    img.save $archive1 format: :DOCKER_ARCHIVE:
    runtime.save $archive2 format: :DOCKER_ARCHIVE: $image_archive_tag

    img.remove()

    let loaded = runtime.load $archive2
    assert_eq $loaded.len 1

    let restored = runtime.image $image_archive_tag
    let tags = restored.tags()
    assert_eq $loaded[0].id $restored.id
    assert_eq $tags[0].repo dolang-test-image-save-load
    assert_eq $tags[0].tag latest

  let restored = runtime.image $image_archive_tag
  restored.remove()

#[test]
def push_missing_image()
  let missing = try
    runtime.push "dolang-definitely-missing-image:latest"
    false
  catch runtime.NoImageError: _
    true
  assert $missing

#[test]
def container_inspect_lifecycle()
  let name = "dolang-test-container-inspect-lifecycle"
  remove_container $name

  clean_container $name do
    # Deliberately bypasses the container module to make a container it did not
    # create. That means the runtime's own quieting doesn't apply: an inline
    # pull would spray "Unable to find image locally" plus layer progress over
    # the real stderr, so capture it and only surface it if the run fails.
    let lines = []
    try
      sub do container_cli run --init -d --name $name ubuntu:24.04 sleep infinity
        stderr: $lines
    catch proc.Error: e
      echo $"\n".join(lines)
      throw e

    let ctr = runtime.container $name
    let state = ctr.state()
    assert_eq $state.name $name
    assert_eq $ctr.image ubuntu:24.04
    assert_eq $state.state :RUNNING:
    assert_eq $state.status running
    assert $ctr.created
    assert_eq $state.ports []

    let listed = [...runtime.containers filter: "name=$name"]
    assert_eq $listed.len 1
    assert_eq $listed[0].id $ctr.id

    let overrides = $
      TEST_DOLANG_CONTAINER_WITH_SET: value
      TEST_DOLANG_CONTAINER_WITH_UNSET: nil
    let result = ctr.with cd: /tmp env: $overrides do
      assert_eq $cd() (unix_fs.Path "/tmp")
      assert_eq $env["TEST_DOLANG_CONTAINER_WITH_SET"] value
      assert_eq $env.get("TEST_DOLANG_CONTAINER_WITH_UNSET", default: nil) nil
      assert $Path("/etc/os-release").exists()
      for entry = Path("/tmp").entries()
        assert (!entry.name.starts_with("dolang-vfs-"))
      sub do run printf container-with
    assert_eq $result container-with
    assert_eq $ctr.state().state :RUNNING:

    let unwound = try
      ctr.with do throw "container with unwind"
      false
    catch e
      assert_eq (str e) "container with unwind"
      true
    assert $unwound
    let reentered = ctr.with do sub do run printf reentered
    assert_eq $reentered reentered

    ctr.stop()
    assert_eq $ctr.state().state :EXITED:

    let listed_all = [...runtime.containers all: true filter: "name=$name"]
    assert_eq $listed_all.len 1
    assert_eq $listed_all[0].id $ctr.id

    ctr.start()
    assert_eq $ctr.state().state :RUNNING:

    ctr.restart()
    assert_eq $ctr.state().state :RUNNING:

    ctr.remove force: true

    let gone = try
      runtime.container $name
      false
    catch runtime.NoContainerError: _
      true
    assert $gone

#[test]
def container_with_non_root_user()
  let name = "dolang-test-container-with-non-root"
  remove_container $name

  clean_container $name do
    let lines = []
    try
      sub do container_cli run -d --name $name --user 65534:65534
        "ubuntu:24.04" sleep infinity
        stderr: $lines
    catch proc.Error: e
      echo $"\n".join(lines)
      throw e

    let ctr = runtime.container $name
    let uid = ctr.with do sub do run id -u
    assert_eq $uid "65534"
    assert_eq $ctr.state().state :RUNNING:
