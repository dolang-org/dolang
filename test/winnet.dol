import winnet rand shell strand sys
  fs:
    - with_temp_dir
  testlib.vfs:
    - vfs
  fs.windows:
    - Path
  security.windows:
    - SecDesc
    - Sid
    - SidName
  std:
    - Bin
    - Bool
    - Int
    - Str
    - ValueError
  sys:
    - AlreadyExistsError
    - NotFoundError
    - PermissionDeniedError
    - UnsupportedError
  test:
    - assert
    - assert_eq
    - assert_throws
    - assert_type
    - fixture
    - ignore
    - skip
    - test
  time:
    - DateTime
    - Duration

let now_nanos = DateTime.now().unix_nanos
let expires = DateTime.from_unix
  nanos: (now_nanos - now_nanos % 1000000000 + 365 * 86400 * 1000000000)
let account_policy_resource = strand.Resource 1

#[fixture]
def scratch_user block ...rest
  if (sys.os_info().family != :WINDOWS:)
    ignore "requires Windows NetAPI"
  if sys.os_info().is_wine
    ignore "Wine does not implement NetUserGetInfo level 4 or NetUserSetInfo"

  # NetAPI user names are limited to 20 characters. A random suffix keeps
  # concurrent test variants from sharing an account.
  let name = "do-test-$(rand.string 10)"
  let password = "Do!$(rand.string 16)9"
  let user = try
    winnet.create_user $name
      password: $password
      full_name: "Do winnet test"
      comment: "created by test/winnet.dol"
      user_comment: scratch
      home_dir: (Path r"C:\Users\do-test")
      home_dir_drive: "Z:"
      profile: (Path r"C:\Users\do-test\profile")
      script_path: (Path "login.cmd")
      account_expires: $expires
      disabled: true
      password_never_expires: false
      password_cannot_change: false
  catch PermissionDeniedError: _
    skip "requires permission to manage local users"

  try
    block user: $user ...rest
  finally
    user.delete()

#[test]
#[vfs]
def unsupported_without_windows_backend()
  if (sys.os_info().family == :WINDOWS:)
    ignore "only exercises the non-Windows backend"
  assert_throws $UnsupportedError do
    [...winnet.users()]
  assert_throws $UnsupportedError do
    winnet.user "Administrator"
  assert_throws $UnsupportedError do
    [...winnet.groups()]
  assert_throws $UnsupportedError do
    winnet.group "Administrators"
  assert_throws $UnsupportedError do
    [...winnet.shares()]
  assert_throws $UnsupportedError do
    winnet.share r"C$"
  assert_throws $UnsupportedError do
    [...winnet.connections()]
  assert_throws $UnsupportedError do
    winnet.connection "Z:"
  assert_throws $UnsupportedError do
    winnet.connect r"\\srv\share"
  assert_throws $UnsupportedError do
    winnet.universal_name (Path r"Z:\build")
  assert_throws $UnsupportedError do
    winnet.join_status()
  assert_throws $UnsupportedError do
    winnet.machine_info()
  assert_throws $UnsupportedError do
    winnet.join_domain corp.example.com
  assert_throws $UnsupportedError do
    winnet.unjoin_domain()
  assert_throws $UnsupportedError do
    winnet.rename_machine WS01
  assert_throws $UnsupportedError do
    winnet.provision_computer corp.example.com machine: WS01
  assert_throws $UnsupportedError do
    winnet.apply_offline_join b"\x01\x02" windows_path: (Path r"C:\Windows")

# Credential shapes are rejected before the NetAPI call, so this runs
# everywhere rather than only on a domain-joined Windows machine.
#[test]
#[vfs]
def join_credentials_are_validated()
  assert_throws $ValueError do
    winnet.join_domain corp.example.com account: r"CORP\joiner"
  assert_throws $ValueError do
    winnet.join_domain corp.example.com password: secret
  assert_throws $ValueError do
    winnet.unjoin_domain account: r"CORP\joiner"
  assert_throws $ValueError do
    winnet.rename_machine WS01 password: secret

  # NETSETUP_MACHINE_PWD_PASSED requires a null account, so the two credential
  # forms cannot be combined.
  assert_throws $ValueError do
    winnet.join_domain corp.example.com
      account: r"CORP\joiner"
      password: secret
      machine_password: other

#[test]
#[vfs]
def domain_membership_is_readable()
  if (sys.os_info().family != :WINDOWS:)
    ignore "requires Windows NetAPI"
  if sys.os_info().is_wine
    ignore "Wine does not implement NetGetJoinInformation or NetWkstaGetInfo"
  let status = winnet.join_status()
  let named = [:DOMAIN:, :WORKGROUP:]
  assert_type $winnet.JoinStatus $status
  assert ([:UNJOINED:, :UNKNOWN:].contains(status.kind) || named.contains(status.kind))
  # The name is present exactly when the machine is named on a network.
  if named.contains(status.kind)
    assert_type $Str $status.name
  else
    assert_eq $status.name nil

  let machine = winnet.machine_info()
  assert_type $winnet.MachineInfo $machine
  assert_type $Str $machine.name
  assert_type $Str $machine.domain
  assert_type $Int $machine.version_major
  assert_type $Int $machine.version_minor
  assert_type $Bool $machine.server_started
  assert_type $winnet.ServerType $machine.server_type
  assert_type $Int $machine.server_type.int
  assert_type $Bool $machine.workstation
  assert_type $Bool $machine.domain_controller

  # A stopped server service costs only the server-side fields.
  if machine.server_started
    assert (machine.server_type.int != 0)
  else
    assert_eq $machine.server_type.int 0
    assert_eq $machine.comment nil

  # The workstation service and the join state agree that there is a name.
  if named.contains(status.kind)
    assert (machine.domain.len > 0)

# Joining, unjoining and renaming re-identify the machine on the network and
# require a reboot to take effect, so they cannot run unattended. Opt in with
# a domain that exists and a machine that can be thrown away afterwards.
#[fixture]
def domain_mutation block ...rest
  if (sys.os_info().family != :WINDOWS:)
    ignore "requires Windows NetAPI"
  if sys.os_info().is_wine
    ignore "Wine does not implement NetJoinDomain"
  if (shell.env.get("DOLANG_WINNET_JOIN_MUTATION_TEST") != "1")
    skip "set DOLANG_WINNET_JOIN_MUTATION_TEST=1 to re-identify this machine"
  let domain = shell.env.get "DOLANG_WINNET_TEST_DOMAIN"
  let account = shell.env.get "DOLANG_WINNET_TEST_ACCOUNT"
  let password = shell.env.get "DOLANG_WINNET_TEST_PASSWORD"
  if (domain == nil || account == nil || password == nil)
    skip "set DOLANG_WINNET_TEST_DOMAIN, _ACCOUNT and _PASSWORD"
  block domain: $domain account: $account password: $password ...rest

#[test]
#[vfs]
#[domain_mutation]
def domain_join_lifecycle :domain :account :password
  let before = winnet.join_status()
  if (before.kind == :DOMAIN:)
    skip "machine is already domain-joined; unjoin it first"
  try
    winnet.join_domain $domain
      account: $account
      password: $password
      create_account: true
  catch PermissionDeniedError: _
    skip "requires permission to join the machine to a domain"
  let after = winnet.join_status()
  assert_eq $after.kind :DOMAIN:
  assert_eq (after.name.lower()) (domain.lower())
  winnet.unjoin_domain account: $account password: $password delete_account: true
  # The join is recorded immediately even though it needs a reboot to work,
  # so the unjoin must be observable the same way.
  assert (winnet.join_status().kind != :DOMAIN:)

#[test]
#[vfs]
#[domain_mutation]
def offline_join_provisioning :domain ..._credentials
  # NetProvisionComputerAccount runs as the calling user, so the fixture's
  # credentials do not apply here.
  let machine = "DO-$(rand.string(8).upper())"
  let blob = try
    winnet.provision_computer $domain machine: $machine
  catch PermissionDeniedError: _
    skip "requires permission to create computer accounts"
  assert_type $Bin $blob
  assert (blob.len > 0)

#[fixture]
def scratch_share block ...rest
  if (sys.os_info().family != :WINDOWS:)
    ignore "requires Windows SMB server management"
  if sys.os_info().is_wine
    ignore "Wine does not implement a credible SMB server service"
  with_temp_dir do |dir|
    let name = "do-share-$(rand.string 8)"
    let share = try
      winnet.create_share $name
        path: $dir
        comment: "created by test/winnet.dol"
        max_uses: 3
        sec_desc:
          dacl:
            - allow: :EVERYONE:
              mask: :GENERIC_ALL:
    catch PermissionDeniedError: _
      skip "requires permission to manage local shares"
    try
      block share: $share ...rest
    finally
      share.delete()

#[fixture]
def scratch_connection block :share ...rest
  # Connecting to a share this machine publishes is a real SMB client
  # connection and needs no second machine.
  let connection = try
    winnet.connect \\localhost\$share.name
  catch PermissionDeniedError: _
    skip "requires permission to connect to local shares"
  try
    block connection: $connection :share ...rest
  finally
    connection.disconnect()

#[test]
#[vfs]
#[scratch_share]
#[scratch_connection]
def smb_connection_lifecycle :connection :share
  let initial = connection.info()
  assert_type $winnet.Connection $connection
  assert_type $winnet.ConnectionInfo $initial
  assert_eq $initial.remote \\localhost\$share.name
  assert_eq $initial.local nil
  assert_eq $initial.state :CONNECTED:
  assert_eq $initial.persistent false
  assert_type $Bool $connection.connected

  # A deviceless connection is addressed by its remote name.
  assert_eq $connection.name $initial.remote
  assert_eq $winnet.connection(initial.remote).info().remote $initial.remote
  assert_eq $winnet.connection(initial).info().remote $initial.remote
  assert $winnet.connections().any(do |entry| entry.remote == initial.remote)

#[test]
#[vfs]
#[scratch_share]
def smb_connection_disconnect :share
  # Connects on its own behalf rather than disconnecting the fixture's.
  let connection = try
    winnet.connect \\localhost\$share.name
  catch PermissionDeniedError: _
    skip "requires permission to connect to local shares"
  try
    connection.disconnect()
    assert_eq $connection.connected false
    # Disconnecting twice is a no-op, which is what lets a scoped connection be
    # disconnected early inside its own block.
    connection.disconnect()
    assert_throws $NotFoundError do
      winnet.connection \\localhost\$share.name
  finally
    connection.disconnect()

#[test]
#[vfs]
#[scratch_share]
def smb_connection_scope :share
  # The block's value is the result of the scoped form.
  let seen = try
    winnet.connect \\localhost\$share.name do |conn|
      assert_eq $conn.info().remote \\localhost\$share.name
      conn.name
  catch PermissionDeniedError: _
    skip "requires permission to connect to local shares"
  assert_eq $seen \\localhost\$share.name
  assert_throws $NotFoundError do
    winnet.connection \\localhost\$share.name

  # A throw from the block still disconnects.
  assert_throws $ValueError do
    winnet.connect \\localhost\$share.name do |_conn|
      throw ValueError "from the block"
  assert_throws $NotFoundError do
    winnet.connection \\localhost\$share.name

  # An explicit disconnect inside the block leaves nothing for scope exit.
  winnet.connect \\localhost\$share.name do |conn|
    conn.disconnect()
  assert_throws $NotFoundError do
    winnet.connection \\localhost\$share.name

#[test]
#[vfs]
#[scratch_share]
def smb_connection_persistence_requires_device :share
  # Windows only remembers connections that redirect a device, so this is
  # rejected rather than silently producing a mapping that vanishes at logon.
  assert_throws $ValueError do
    winnet.connect \\localhost\$share.name persistent: true

#[test]
#[vfs]
#[scratch_share]
def local_share_lifecycle :share
  let initial = share.info()
  let name = initial.name
  assert_type $winnet.Share $share
  assert_type $winnet.ShareInfo $initial
  assert_eq $initial.name $name
  assert_eq $initial.kind :DISKTREE:
  assert_eq $initial.special false
  assert_eq $initial.temporary false
  assert_eq $initial.comment "created by test/winnet.dol"
  assert_eq $initial.max_uses 3
  assert_type $Int $initial.current_uses
  assert_type $SecDesc $initial.sec_desc
  assert_eq $share.name $name
  assert_eq $winnet.share(name).info().name $name
  assert_eq $winnet.share(initial).info().name $name
  assert $winnet.shares().any(do |entry| entry.name == name)
  let updated = share.update
    comment: nil
    max_uses: nil
    sec_desc: $initial.sec_desc.to_bin()
  assert_eq $updated.comment nil
  assert_eq $updated.max_uses nil
  assert_type $SecDesc $updated.sec_desc

#[test]
#[vfs]
def local_share_delete()
  # Creates the share it deletes. A fixture's share belongs to the fixture, and
  # a failure to delete that one has to fail the test rather than be tolerated.
  if (sys.os_info().family != :WINDOWS:)
    ignore "requires Windows SMB server management"
  if sys.os_info().is_wine
    ignore "Wine does not implement a credible SMB server service"
  with_temp_dir do |dir|
    let name = "do-share-$(rand.string 8)"
    let share = try
      winnet.create_share $name path: $dir
    catch PermissionDeniedError: _
      skip "requires permission to manage local shares"
    assert_eq $share.info().path $dir
    share.delete()
    assert_throws $NotFoundError do
      winnet.share $name

#[test]
#[vfs]
#[scratch_user]
def local_user_lifecycle :user
  let initial = user.info()
  let name = initial.name
  let replacement_password = "Do!$(rand.string 16)8"

  assert_type $winnet.User $user
  assert_type $Sid $user.sid

  # Lookup by both name and stable SID identifies the same account.
  let by_name = winnet.user $name
  let by_sid = winnet.user $user.sid
  let by_info = winnet.user $initial
  assert_eq $by_name.info().name $name
  assert_eq (str by_name.sid) (str user.sid)
  assert_eq $by_sid.info().name $name
  assert_eq (str by_sid.sid) (str user.sid)
  assert_eq (str by_info.sid) (str user.sid)

  # Enumeration is a forward iterator and includes the scratch account.
  let user_infos = [...winnet.users()]
  assert $user_infos.all(do |entry| type(entry) == winnet.UserInfo)
  let found = user_infos.any(do |entry| (entry.name == name))
  assert $found "scratch user $name missing from users()"

  assert_type $winnet.UserInfo $initial
  assert_eq $initial.name $name
  assert_eq $initial.full_name "Do winnet test"
  assert_eq $initial.comment "created by test/winnet.dol"
  assert_eq $initial.user_comment scratch
  assert_type $Path $initial.home_dir
  assert_eq $initial.home_dir (Path r"C:\Users\do-test")
  assert_eq $initial.home_dir_drive "Z:"
  assert_type $Path $initial.profile
  assert_eq $initial.profile (Path r"C:\Users\do-test\profile")
  assert_type $Path $initial.script_path
  assert_eq $initial.script_path (Path "login.cmd")
  assert_eq $initial.account_expires $expires
  assert_eq $initial.disabled true
  assert_eq $initial.password_never_expires false
  assert_eq $initial.password_cannot_change false
  assert_type $winnet.UserFlags $initial.flags
  assert_type $Int $initial.flags.int
  assert_type $Duration $initial.password_age
  assert_type $Bool $initial.password_expired
  assert_type $Int $initial.bad_password_count
  assert_type $Int $initial.logon_count

  # Each flag patch preserves semantic flags which were not mentioned.
  let never_expires = user.update password_never_expires: true
  assert_eq $never_expires.disabled true
  assert_eq $never_expires.password_never_expires true
  let enabled = user.update disabled: false
  assert_eq $enabled.disabled false
  assert_eq $enabled.password_never_expires true
  let cannot_change = user.update password_cannot_change: true
  assert_eq $cannot_change.disabled false
  assert_eq $cannot_change.password_never_expires true
  assert_eq $cannot_change.password_cannot_change true

  # Omitted fields remain unchanged, while nil clears nullable fields.
  let updated = user.update
    password: $replacement_password
    full_name: "Updated Do user"
    comment: nil
    user_comment: nil
    home_dir: nil
    home_dir_drive: nil
    profile: nil
    script_path: nil
    account_expires: nil
  assert_eq $updated.full_name "Updated Do user"
  assert_eq $updated.comment nil
  assert_eq $updated.user_comment nil
  assert_eq $updated.home_dir nil
  assert_eq $updated.home_dir_drive nil
  assert_eq $updated.profile nil
  assert_eq $updated.script_path nil
  assert_eq $updated.account_expires nil
  assert_eq $updated.disabled false
  assert_eq $updated.password_never_expires true
  assert_eq $updated.password_cannot_change true

  # Earlier attributes remain applied when the final rename conflicts.
  let conflict_name = "do-hit-$(rand.string 10)"
  let conflict = winnet.create_user $conflict_name
    password: "Do!$(rand.string 16)7"
  try
    assert_throws $AlreadyExistsError do
      user.update full_name: "Applied before conflict" name: $conflict_name
  finally
    conflict.delete()
  assert_eq $user.info().name $name
  assert_eq $user.info().full_name "Applied before conflict"

  # Rename is applied last and refreshes both the snapshot and handle cache.
  let renamed = "do-test-$(rand.string 10)"
  let renamed_info = user.update
    full_name: "Renamed Do user"
    name: $renamed
  assert_eq $renamed_info.name $renamed
  assert_eq $user.info().name $renamed
  assert_eq $user.info().full_name "Renamed Do user"
  let renamed_lookup = winnet.user $renamed
  assert_eq (str renamed_lookup.sid) (str user.sid)

#[test]
#[vfs]
def local_user_delete()
  # Creates the account it deletes, for the same reason as `local_share_delete`.
  if (sys.os_info().family != :WINDOWS:)
    ignore "requires Windows NetAPI"
  if sys.os_info().is_wine
    ignore "Wine does not implement NetUserGetInfo level 4 or NetUserSetInfo"
  let name = "do-test-$(rand.string 10)"
  let user = try
    winnet.create_user $name password: "Do!$(rand.string 16)9"
  catch PermissionDeniedError: _
    skip "requires permission to manage local users"
  user.delete()
  assert_throws $NotFoundError do
    winnet.user $name

#[test]
#[vfs]
#[scratch_user]
def local_user_account_rights :user
  let right = "SeServiceLogonRight"
  try
    user.revoke_right $right
  catch PermissionDeniedError: _
    skip "requires permission to manage local security policy"
  assert_eq $user.rights().any(do |value| value == right) false
  try
    user.grant_right $right
    assert $user.rights().any(do |value| value == right)
  finally
    user.revoke_right $right
  assert_eq $user.rights().any(do |value| value == right) false

#[test]
#[vfs]
def local_account_policy()
  if (sys.os_info().family != :WINDOWS:)
    ignore "requires Windows account policy"
  if sys.os_info().is_wine
    ignore "Wine does not reliably implement NetUserModalsGet"
  let policy = winnet.account_policy()
  assert_type $winnet.AccountPolicy $policy
  assert_type $Int $policy.min_password_length
  assert_type $Duration $policy.min_password_age
  assert_type $Int $policy.password_history_length
  assert_type $Duration $policy.lockout_duration
  assert_type $Duration $policy.lockout_observation_window
  assert_type $Int $policy.lockout_threshold

#[test]
#[vfs]
def update_local_account_policy()
  if (sys.os_info().family != :WINDOWS:)
    ignore "requires Windows account policy"
  if sys.os_info().is_wine
    ignore "Wine does not reliably implement NetUserModalsSet"
  if (shell.env.get("DOLANG_WINNET_POLICY_MUTATION_TEST") != "1")
    skip "set DOLANG_WINNET_POLICY_MUTATION_TEST=1 to mutate machine policy"
  account_policy_resource.with do
    let original = winnet.account_policy()
    let changed_length = (original.min_password_length == 0 && 1 || 0)
    let changed = try
      winnet.update_account_policy min_password_length: $changed_length
    catch PermissionDeniedError: _
      skip "requires permission to modify machine policy"
    try
      assert_eq $changed.min_password_length $changed_length
    finally
      winnet.update_account_policy min_password_length: $original.min_password_length

#[fixture]
def scratch_group block ...rest
  if (sys.os_info().family != :WINDOWS:)
    ignore "requires Windows NetAPI"
  if sys.os_info().is_wine
    ignore "Wine does not implement local-group lifecycle operations"
  let name = "do-group-$(rand.string 8)"
  let group = try
    winnet.create_group $name comment: "created by test/winnet.dol"
  catch PermissionDeniedError: _
    skip "requires permission to manage local groups"
  try
    block group: $group ...rest
  finally
    group.delete()

#[test]
#[vfs]
#[scratch_user]
#[scratch_group]
def local_group_lifecycle :user :group
  let name = group.info().name
  let user_name = user.info().name
  assert_type $winnet.Group $group
  assert_type $Sid $group.sid
  assert_eq $group.info().comment "created by test/winnet.dol"
  let group_by_name = winnet.group $name
  let group_by_sid = winnet.group $group.sid
  let group_info = group.info()
  let group_by_info = winnet.group $group_info
  assert_eq (str group_by_name.sid) (str group.sid)
  assert_eq (str group_by_sid.sid) (str group.sid)
  assert_eq (str group_by_info.sid) (str group.sid)
  let group_infos = [...winnet.groups()]
  assert $group_infos.all(do |entry| type(entry) == winnet.GroupInfo)
  assert $group_infos.any(do |entry| (entry.name == name))

  assert_eq $group.update(comment: nil).comment nil
  group.add_member $user_name
  assert_throws $AlreadyExistsError do
    group.add_member $user.sid
  let members = [...group.members()]
  assert $members.any(do |member| (str member.sid) == (str user.sid))
  assert_type $SidName $members[0]
  group.remove_member $user.sid
  assert_throws $NotFoundError do
    group.remove_member $user_name
  group.add_member $user.sid
  group.remove_member $user_name

  let right = "SeServiceLogonRight"
  try
    group.revoke_right $right
  catch PermissionDeniedError: _
    skip "requires permission to manage local security policy"
  assert_eq $group.rights().any(do |value| value == right) false
  try
    group.grant_right $right
    assert $group.rights().any(do |value| value == right)
  finally
    group.revoke_right $right

  let conflict_name = "do-hit-$(rand.string 8)"
  let conflict = winnet.create_group $conflict_name
  try
    assert_throws $AlreadyExistsError do
      group.update comment: "applied before conflict" name: $conflict_name
  finally
    conflict.delete()
  assert_eq $group.info().name $name
  assert_eq $group.info().comment "applied before conflict"

  let renamed = "do-group-$(rand.string 8)"
  let info = group.update comment: "renamed" name: $renamed
  assert_eq $info.name $renamed
  assert_eq $group.info().name $renamed
  assert_eq $group.info().comment renamed
  let renamed_lookup = winnet.group $renamed
  assert_eq (str renamed_lookup.sid) (str group.sid)
