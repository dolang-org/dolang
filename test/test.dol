import json proc shell term
  fs:
    - with_temp_dir
  test:
    - TestInfo
    - assert
    - assert_eq
    - assert_not
    - assert_throws
    - assert_type
    - parametrize
    - tagged
    - test
    tags: register_tags
    run: run_tests
    list: list_tests

#[test]
def registration_requires_active_collection()
  assert_throws $std.StateError do register_tags "orphan"
  assert_throws $std.StateError do test do nil

#[test]
def ignored_tests_are_omitted_from_report()
  with_temp_dir do |dir|
    let path = (dir / "ignored.dol")
    path.write r|
      import test:
        - ignore
        - test

      #[test]
      def ignored()
        ignore "wrong platform"

      #[test]
      def passed()
        nil

    let output = BinBuf()
    let rc = term.capture $output do
      run_tests jobs: 1 module_jobs: 1 capture: true $path
    let report = output.freeze_str()
    assert_eq $rc 0
    assert $report.contains("passed: 1/1")
    assert_not $report.contains("wrong platform")

#[test]
def metadata_and_predicate_filtering()
  with_temp_dir do |dir|
    let path = (dir / "metadata.dol")
    path.write r|
      import test:
        - test

      #[test name: "raw/custom" tags: ["fast", "linux", "fast"]]
      def selected()
        nil

      #[test]
      def rejected()
        throw std.RuntimeError "predicate should exclude this test"

    let seen = []
    let filter = do |info|
      assert_type $TestInfo $info
      seen.push [info.module, info.name, info.tags]
      (info.name == "raw/custom")
    let rc = run_tests jobs: 1 module_jobs: 1 filter: $filter capture: true $path
    assert_eq $rc 0
    assert_eq $seen.len 2
    assert_eq $seen[0][0] $path
    assert_eq $seen[0][1] "raw/custom"
    assert_eq $seen[0][2] (Tuple ["fast", "linux", "fast"])
    assert_eq $seen[1][0] $path
    assert_eq $seen[1][1] "rejected"
    assert_eq $seen[1][2] (Tuple [])

#[test]
def module_tags_are_prepended_to_test_tags()
  with_temp_dir do |dir|
    let path = (dir / "module-tags.dol")
    path.write r|
      import test

      test.tags "suite" "linux" "suite"

      #[test.test name: "first" tags: ["fast", "linux"]]
      def first()
        nil

      test.tags "later"

      #[test.test]
      def second()
        nil

    let seen = []
    let filter = do |info|
      seen.push [info.name, info.tags]
      true
    assert_eq (run_tests jobs: 1 module_jobs: 1 filter: filter capture: true path) 0
    assert_eq $seen.len 2
    assert_eq $seen[0] ["first", Tuple(["suite", "linux", "suite", "fast", "linux"])]
    assert_eq $seen[1] ["second", Tuple(["suite", "linux", "suite", "later"])]

#[test]
def rejects_non_string_tags()
  with_temp_dir do |dir|
    let path = (dir / "bad-tags.dol")
    path.write r|
      import test:
        - test

      #[test tags: ["ok", 42]]
      def bad()
        nil

    assert_eq (run_tests jobs: 1 module_jobs: 1 capture: true path) 1

    path.write r|
      import test
      test.tags "ok" 42

    assert_eq (run_tests jobs: 1 module_jobs: 1 capture: true path) 1

#[test]
def parametrize_expands_cartesian_product()
  with_temp_dir do |dir|
    let path = (dir / "parametrize.dol")
    path.write r|
      import test:
        - assert
        - parametrize
        - test

      #[test]
      #[parametrize color: ["red", "blue"] size: [1, 2]]
      def combo :color :size
        assert (color == "red" || color == "blue")
        assert (size == 1 || size == 2)

      #[test]
      def plain()
        nil

    let seen = []
    let filter = do |info|
      seen.push $info.name
      true
    assert_eq (run_tests jobs: 1 module_jobs: 1 filter: filter capture: true path) 0
    assert_eq $seen $
      - "combo/color=red/size=1"
      - "combo/color=red/size=2"
      - "combo/color=blue/size=1"
      - "combo/color=blue/size=2"
      - "plain"

#[test]
def parametrize_sanitizes_slashes_in_case_names()
  with_temp_dir do |dir|
    let path = (dir / "parametrize_slash.dol")
    path.write r|
      import test:
        - assert_eq
        - parametrize
        - test

      #[test]
      #[parametrize path: ["a/b/c"]]
      def combo :path
        assert_eq $path "a/b/c"

    let seen = []
    let filter = do |info|
      seen.push $info.name
      true
    assert_eq (run_tests jobs: 1 module_jobs: 1 filter: filter capture: true path) 0
    assert_eq $seen ["combo/path=a_b_c"]

#[test]
def parametrize_composes_with_fixture()
  with_temp_dir do |dir|
    let path = (dir / "fixture_parametrize.dol")
    path.write r|
      import test:
        - assert
        - assert_eq
        - fixture
        - parametrize
        - test

      #[fixture]
      def inject block ...rest
        block(...rest, extra: "injected")

      #[test]
      #[inject]
      #[parametrize kind: ["a", "b"]]
      def combo :kind :extra
        assert_eq $extra "injected"
        assert (kind == "a" || kind == "b")

    let seen = []
    let filter = do |info|
      seen.push $info.name
      true
    assert_eq (run_tests jobs: 1 module_jobs: 1 filter: filter capture: true path) 0
    assert_eq $seen ["combo/kind=a", "combo/kind=b"]

#[test]
def a_fixture_sees_no_axes_from_below()
  with_temp_dir do |dir|
    let path = (dir / "fixture_below.dol")
    path.write r|
      import test:
        - assert_eq
        - fixture
        - parametrize
        - test

      #[fixture]
      def inject block :kind = nil ...rest
        assert_eq $kind nil
        block(...rest, extra: "injected")

      #[test]
      #[inject]
      #[parametrize kind: ["a"]]
      def combo :kind :extra
        assert_eq $kind "a"
        assert_eq $extra "injected"

    assert_eq (run_tests jobs: 1 module_jobs: 1 capture: true path) 0

#[test]
def a_decorated_test_runs_each_case_when_called()
  let calls = []
  let decorated = parametrize (do |:n| calls.push n) n: [1, 2]
  decorated()
  assert_eq $calls [1, 2]

#[test]
def a_tagged_value_cannot_be_tagged_again()
  assert_throws $std.TypeError do tagged (tagged 1 "a") "b"

#[test]
def tests_and_modules_read_no_input()
  with_temp_dir do |dir|
    let path = (dir / "reads.dol")
    path.write r|
      import strand
      import test:
        - assert_eq
        - test

      let at_load = [...strand.input()]

      #[test]
      def reads_nothing()
        assert_eq $at_load []
        assert_eq [...strand.input()] []

    let status = strand.redirect input: ["unexpected"] do
      run_tests jobs: 1 module_jobs: 1 capture: true $path
    assert_eq $status 0

#[test]
def parametrize_per_value_tags_are_honored()
  with_temp_dir do |dir|
    let path = (dir / "tagged_params.dol")
    path.write r|
      import test:
        - assert
        - parametrize
        - tagged
        - test

      #[test tags: ["base"]]
      #[parametrize backend: ["sqlite", tagged("postgres", "slow")]]
      def connects :backend
        assert (backend == "sqlite" || backend == "postgres")

    let seen = []
    let filter = do |info|
      seen.push [info.name, info.tags]
      true
    assert_eq (run_tests jobs: 1 module_jobs: 1 filter: filter capture: true path) 0
    assert_eq $seen.len 2
    assert_eq $seen[0] ["connects/backend=sqlite", Tuple(["base"])]
    assert_eq $seen[1] ["connects/backend=postgres", Tuple(["base", "slow"])]

def tagged_module dir
  let path = (dir / "tagged.dol")
  path.write r|
    import fs:
      - Path
    import test:
      - test

    let marker_dir = Path $env["DOLANG_TEST_MARKER_DIR"]

    #[test tags: ["fast", "linux"]]
    def alpha()
      (marker_dir / "alpha").write "yes"

    #[test tags: ["slow", "linux"]]
    def beta()
      (marker_dir / "beta").write "yes"

    #[test tags: ["fast", "windows"]]
    def gamma()
      (marker_dir / "gamma").write "yes"

    #[test]
    def plain()
      (marker_dir / "plain").write "yes"

  path

def run_cli dir path ...args
  for name = ["alpha", "beta", "gamma", "plain"]
    let marker = (dir / name)
    if marker.exists()
      marker.remove()
  env DOLANG_TEST_MARKER_DIR: $dir do
    run $shell.exe --no-cache -m test --no-capture ...args $path

def assert_markers dir expected
  for name = ["alpha", "beta", "gamma", "plain"]
    assert_eq $(dir / name).exists() $expected.contains(name) $name

#[test]
def cli_tag_selection()
  with_temp_dir do |dir|
    let path = tagged_module $dir

    run_cli $dir $path
    assert_markers $dir ["alpha", "beta", "gamma", "plain"]

    run_cli $dir $path --tags fast,slow
    assert_markers $dir ["alpha", "beta", "gamma"]

    run_cli $dir $path --tags fast,slow --tags linux
    assert_markers $dir ["alpha", "beta"]

    run_cli $dir $path --tags !windows
    assert_markers $dir ["alpha", "beta", "plain"]

    run_cli $dir $path --tags !windows,!macos
    assert_markers $dir ["alpha", "beta", "gamma", "plain"]

    run_cli $dir $path --tags !windows --tags !linux
    assert_markers $dir ["plain"]

    run_cli $dir $path --filter "**/alpha" --tags fast
    assert_markers $dir ["alpha"]

#[test]
def cli_rejects_malformed_tag_expressions()
  with_temp_dir do |dir|
    let path = tagged_module $dir
    for expression = ["", "!", "fast,", ",fast", "fast,,slow"]
      assert_throws $proc.Error do
        run $shell.exe --no-cache -m test --tags $expression $path

# The module part of a test ID: the path without its extension, separated by
# `/` on every platform.
def module_of path
  let name = str $path.without_ext()
  name.replace "\\" "/"

#[test]
def info_reports_id_base_and_params()
  with_temp_dir do |dir|
    let path = (dir / "ids.dol")
    path.write r|
      import test:
        - parametrize
        - test

      #[test]
      #[parametrize color: ["red", "a/b"] size: [1]]
      def combo :color :size
        [color, size]

      #[test name: "custom"]
      def plain()
        nil

    let module = module_of $path
    let seen = []
    let filter = do |info|
      seen.push [info.id, info.base, info.params]
      true
    assert_eq (list_tests filter: filter path) 0
    assert_eq $seen $
      - ["$module/combo/color=red/size=1", "combo", (("color", "red"), ("size", "1"))]
      - ["$module/combo/color=a_b/size=1", "combo", (("color", "a_b"), ("size", "1"))]
      - ["$module/custom", "custom", ()]

# The zero-based line of the `def` of `name` in `source`.
def def_line source name
  for i line = source.split("\n").enumerate()
    if line.starts_with "def $name"
      return i
  throw std.ValueError "no def $name"

#[test]
def info_reports_definition_locations()
  with_temp_dir do |dir|
    (dir / "helpers.dol").write r|
      import test

      pub def registered func
        test.test name: imported $func

    let path = (dir / "located.dol")
    let source = r|
      import helpers
      import test:
        - fixture
        - parametrize
        - test

      #[fixture]
      def inject block ...rest
        block(...rest, extra: 1)

      def wrapped func
        test name: wrapped $func

      #[test]
      def plain()
        nil

      #[test]
      #[inject]
      def fixtured :extra
        extra

      #[test]
      #[parametrize n: [1]]
      def param :n
        n

      #[wrapped]
      def via_wrapper()
        nil

      #[helpers.registered]
      def via_import()
        nil
    path.write $source

    let out = BinBuf()
    run $shell.exe --no-cache --module-path $dir -m test --list --format json $path stdout: $out mode: :CHUNK:
    let seen = {}
    for record = json.decode(out.freeze_str())["modules"][0]["tests"]
      seen[record["base"]] = record["location"]
    let expected = $
      "plain": plain
      "fixtured": fixtured
      "param": param
      "wrapped": via_wrapper
      "imported": via_import
    for base name = expected
      let loc = seen[base]
      assert (loc != nil) $base
      let expected = {"file": str(path), "line": def_line(source, name), "column": 0, "len": 4 + name.len}
      assert_eq $loc $expected $base

# Lists tests through the CLI, giving the exit status, standard output and
# standard error.
# Runs `dolang -m test`, giving its exit status and stdout.
def test_cli *args
  let out = BinBuf()
  let rc = try
    run $shell.exe --no-cache -m test ...args stdout: $out mode: :CHUNK:
    0
  catch proc.Error: e
    e.rc
  (rc, out.freeze_str())

def list_cli *args
  test_cli --list ...args

#[test]
def cli_lists_without_running()
  with_temp_dir do |dir|
    let path = tagged_module $dir
    let module = module_of $path
    env DOLANG_TEST_MARKER_DIR: $dir do
      let rc out = list_cli $path
      assert_eq $rc 0
      assert_eq $out ""
      assert_markers $dir []

      let rc out = list_cli --format json --tags fast --filter "**/a*" $path
      assert_eq $rc 0
      let doc = json.decode $out
      assert_eq $doc["version"] 1
      let tests = doc["modules"][0]["tests"]
      assert_eq [...tests.map(do |t| t["name"])] ["alpha"]
      assert_markers $dir []

      let rc out = list_cli --format json --id "$module/gamma" --id "$module/plain" $path
      assert_eq $rc 0
      let tests = json.decode(out)["modules"][0]["tests"]
      assert_eq [...tests.map(do |t| t["name"])] ["gamma", "plain"]

#[test]
def cli_json_records()
  with_temp_dir do |dir|
    let path = (dir / "records.dol")
    path.write r|
      import test:
        - parametrize
        - tagged
        - tags
        - test

      tags "suite"

      #[test]
      #[parametrize backend: ["sqlite", tagged("pg", "slow")]]
      def connects :backend
        backend
    let module = module_of $path
    let rc out = list_cli --format json $path
    assert_eq $rc 0
    let doc = json.decode $out
    let entry = doc["modules"][0]
    assert_eq [entry["path"], entry["module"], entry["status"]] [str(path), module, "loaded"]
    let test = entry["tests"][1]
    assert_eq $test["id"] "$module/connects/backend=pg"
    assert_eq $test["module"] $module
    assert_eq $test["name"] "connects/backend=pg"
    assert_eq $test["base"] "connects"
    assert_eq $test["params"] [["backend", "pg"]]
    assert_eq $test["tags"] ["suite", "slow"]
    assert_eq $test["location"] {"file": str(path), "line": 10, "column": 0, "len": 12}

#[test]
def cli_list_keeps_module_output_off_stdout()
  with_temp_dir do |dir|
    let path = (dir / "noisy.dol")
    path.write r|
      import strand test

      echo noisy-echo
      print "noisy-print\n"
      strand.put "noisy-put\n"

      #[test.test]
      def quiet()
        nil
    let rc out = list_cli $path
    assert_eq $rc 0
    assert_eq $out ""

    let rc out = list_cli --format json $path
    assert_eq $rc 0
    assert_not $out.contains("noisy-")
    assert_eq $json.decode(out)["modules"][0]["status"] "loaded"

#[test]
def cli_list_reports_module_failures()
  with_temp_dir do |dir|
    let broken = (dir / "a_broken.dol")
    broken.write "let x = (\n"
    let raising = (dir / "b_raising.dol")
    raising.write r|
      echo loading
      throw std.ValueError "boom"
    let skipping = (dir / "c_skipping.dol")
    skipping.write r|
      import test
      test.skip "not here"

    let rc out = list_cli $broken $raising $skipping
    assert_eq $rc 1
    assert_eq $out ""

    let rc out = list_cli --format json $dir
    assert_eq $rc 1
    let modules = json.decode(out)["modules"]
    assert_eq [...modules.map(do |m| m["status"])] ["failed", "failed", "skipped"]
    let compile_error = modules[0]["error"]
    assert_eq $compile_error["kind"] "compile"
    let diag = compile_error["diagnostics"][0]
    assert_eq $diag["severity"] "error"
    assert_eq $diag["location"]["file"] $(str broken)
    assert_eq $diag["location"]["line"] 0
    let load_error = modules[1]["error"]
    assert_eq $load_error["kind"] "load"
    assert_eq $load_error["message"] "value error: boom"
    assert $load_error["output"].contains("loading")
    assert_eq $modules[2]["message"] "not here"

    let rc _out = list_cli $skipping
    assert_eq $rc 0

#[test]
def cli_list_writes_json_to_output_file()
  with_temp_dir do |dir|
    let path = tagged_module $dir
    let target = (dir / "tests.json")
    let rc out = env DOLANG_TEST_MARKER_DIR: $dir do
      list_cli --format json --output $target $path
    assert_eq $rc 0
    assert_eq $out ""
    assert_eq $json.decode(target.read_str())["modules"][0]["tests"].len 4

#[test]
def cli_rejects_misplaced_list_options()
  with_temp_dir do |dir|
    let path = tagged_module $dir
    let invalid = $
      - ["--format", "json"]
      - ["--list", "--output", "x.json"]
      - ["--output", "x.json"]
      - ["--list", "--format", "text"]
      - ["--list", "--format", "jsonl"]
      - ["--format", "jsonl", "--no-capture"]
    for options = invalid
      assert_throws $proc.Error do
        run $shell.exe --no-cache -m test ...options $path

# The zero-based line of `source` containing `text`.
def line_of source text
  for i line = source.split("\n").enumerate()
    if line.contains $text
      return i
  throw std.ValueError "no line with $text"

# Decodes a JSONL stream, checking that every line is an event.
def decode_events text
  assert text.ends_with("\n")
  let events = []
  for line = text.trim_end("\n").split("\n")
    let event = json.decode $line
    assert_type $Dict $event
    assert event.contains("event")
    events.push $event
  events

let events_source = r|
  import shell
  import test:
    - assert_eq
    - fixture
    - ignore
    - skip
    - test

  echo loading

  def check value
    assert_eq $value 2

  #[fixture]
  def broken block ...rest
    assert_eq 1 3
    block(...rest)

  #[test]
  def passes()
    echo noisy-passed

  #[test]
  def fails()
    print noisy-failed
    run $shell.exe $env["DOLANG_TEST_CHILD"]
    assert_eq [1] [2]

  #[test]
  def via_helper()
    check 3

  #[test]
  #[broken]
  def via_fixture()
    nil

  #[test]
  def skips()
    skip "not now"

  #[test]
  def ignores()
    ignore()

#[test]
def cli_jsonl_reports_events()
  with_temp_dir do |dir|
    let path = (dir / "a_events.dol")
    path.write $events_source
    let broken = (dir / "b_broken.dol")
    broken.write "let x = (\n"
    let raising = (dir / "c_raising.dol")
    raising.write "throw std.ValueError boom\n"
    let module = module_of $path
    # Not a `.dol` file, so it isn't a test module.
    let child = (dir / "child.script")
    child.write "shell.stdout.write \"noisy-child\\n\"\n"

    let rc out = env DOLANG_TEST_CHILD: $child do test_cli --format jsonl $dir
    assert_eq $rc 1
    assert_not $out.contains("noisy-passed")
    let events = decode_events $out
    assert_eq $events[0] {"event": "run-start", "version": 1, "modules": 3}
    let last = events[events.len - 1]
    let summary = $
      "event": run-end
      "passed": 1
      "failed": 3
      "skipped": 1
      "ignored": 1
      "status": 1
    assert_eq $last $summary

    # Each module and test starts before it ends.
    let position = {}
    for i event = events.enumerate()
      let kind = event["event"]
      if kind.starts_with("module-")
        position[(kind, event["path"])] = i
      else if kind.starts_with("test-")
        position[(kind, event["id"])] = i
    for p = [path, broken, raising]
      assert (position[("module-start", str(p))] < position[("module-end", str(p))])
    let names = ["passes", "fails", "via_helper", "via_fixture", "skips", "ignores"]
    for name = names
      let id = "$module/$name"
      assert (position[("test-start", id)] < position[("test-end", id)])

    let modules = {}
    let starts = {}
    let ends = {}
    for event = events
      let kind = event["event"]
      if (kind == "module-end")
        modules[event["path"]] = event
      else if (kind == "test-start")
        starts[event["id"]] = event
      else if (kind == "test-end")
        ends[event["id"]] = event
    let loaded = modules[str(path)]
    assert_eq $loaded["status"] "loaded"
    assert_eq [...loaded["tests"].map(do |t| t["name"])] $names
    assert_eq $modules[str(broken)]["error"]["kind"] "compile"
    assert_eq $modules[str(broken)]["error"]["diagnostics"][0]["location"]["line"] 0
    assert_eq $modules[str(raising)]["error"]["kind"] "load"
    assert_eq $modules[str(raising)]["error"]["message"] "value error: boom"

    let start = starts["$module/fails"]
    assert_eq $start["base"] "fails"
    assert_eq $start["location"]["line"] $(def_line events_source "fails")

    let passed = ends["$module/passes"]
    assert_eq $passed["outcome"] "passed"
    assert (type passed["duration"] Float || type passed["duration"] Int)
    assert_not $passed.contains("message")

    let failed = ends["$module/fails"]
    assert_eq $failed["outcome"] "failed"
    assert_eq $failed["message"] "assertion failed: [1] == [2]"
    let error = failed["error"]
    assert_eq $error["type"] "test.Assert"
    assert_eq $error["expected"] "[2]"
    assert_eq $error["actual"] "[1]"
    assert $error["rendered"].contains("assertion failed")
    assert_not $error["rendered"].contains("\u{1b}")
    assert_eq $error["backtrace"][0]["receiver"] "assert_eq"
    assert $failed["output"].contains("noisy-failed")
    assert $failed["output"].contains("noisy-child")
    assert_eq $failed["failure_location"]["file"] $(str path)

    let expect_line = do |id text|
      assert_eq $ends["$module/$id"]["failure_location"]["line"] $(line_of events_source text)
    expect_line fails "assert_eq [1] [2]"
    expect_line via_helper r"assert_eq $value 2"
    expect_line via_fixture "assert_eq 1 3"

    let skipped = ends["$module/skips"]
    assert_eq $skipped["outcome"] "skipped"
    assert_eq $skipped["message"] "not now"
    assert_not $skipped.contains("error")
    let ignored = ends["$module/ignores"]
    assert_eq $ignored["outcome"] "ignored"
    assert_eq $ignored["message"] nil

#[test]
def cli_jsonl_writes_to_output_file()
  with_temp_dir do |dir|
    let path = (dir / "passing.dol")
    path.write r|
      import test:
        - test

      #[test]
      def passes()
        nil
    let target = (dir / "events.jsonl")
    let rc out = test_cli --format jsonl --output $target $path
    assert_eq $rc 0
    assert_eq $out ""
    let events = decode_events $target.read_str()
    let last = events[events.len - 1]
    assert_eq $last["event"] "run-end"
    assert_eq $last["passed"] 1
    assert_eq $last["status"] 0
