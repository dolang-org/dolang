import shell term strand
  fs:
    - with_temp_dir
  test:
    - assert
    - assert_eq
    - assert_throws
    - skip
    - test
  std:
    - FmtValue
    - MissingKeyError
    - TypeError
    - UnsupportedError
    - ValueError

let ESC = str b"\x1b"


#[test]
def console_geometry()
  # `term.console` is a name, so it pins to the host: `is_tty` is the
  # determinative "is there a real terminal" test.
  assert_eq (type term.console.can_style) $Bool
  assert_eq (type term.console.is_tty) $Bool

  # `geometry()` is only advisory, and never nil for the host console: each
  # dimension is independently nil when it cannot be determined, even when
  # `is_tty` is true, rather than the whole result being absent.
  let g = term.console.geometry()
  assert (type g term.Geometry)
  assert (g.rows == nil || type g.rows == Int)
  assert (g.cols == nil || type g.cols == Int)

#[test]
def text_string_coercion()
  let text = term.text("red", fg: :RED:, bold: true)
  assert_eq (type text) $term.Text

  # `str` is the content; the escapes are terminal instructions, and asking
  # for them is what `encode` is. `verbatim` reproduces a value as it would
  # have been written in source, and styled text has no source form, so it
  # falls through to the same content.
  assert_eq (str text) red
  assert_eq (text.encode()) "$ESC[1;31mred$ESC[0m"
  assert_eq (std.verbatim text) (str text)
  assert_eq (str $ term.text :VALUE:) VALUE

  # `preformat` takes the encoded form back, canonicalizing the SGR it emits
  # — so the content survives and re-encoding is then a fixed point.
  let round = term.preformat(text.encode())
  assert_eq (str round) red
  assert_eq (term.preformat(round.encode()).encode()) (round.encode())

  assert_eq (term.text("indexed", fg: 123).encode()) "$ESC[38;5;123mindexed$ESC[0m"
  assert_eq (term.text("rgb", fg: [1, 2, 3]).encode()) "$ESC[38;2;1;2;3mrgb$ESC[0m"
  assert_eq (
    term.text("rgb", bg: Tuple([4, 5, 6])).encode()
  ) "$ESC[48;2;4;5;6mrgb$ESC[0m"

  assert_throws $ValueError do term.text fg: 256 text
  assert_throws $ValueError do term.text fg: [1, 2] text
  assert_throws $TypeError do term.text fg: [1, "x", 3] text

#[test]
def reusable_styles()
  let warning = term.Style fg: :YELLOW: bold: true
  assert_eq (type warning) $term.Style
  assert_eq (warning("Warning").encode()) "$ESC[1;33mWarning$ESC[0m"

  let urgent = warning fg: :RED: underline: true
  assert_eq (type urgent) $term.Style
  assert_eq (urgent("Failure").encode()) "$ESC[1;4;31mFailure$ESC[0m"

  let ambient = urgent fg: :INHERIT: bold: :INHERIT:
  assert_eq (ambient("Notice").encode()) "$ESC[4mNotice$ESC[0m"

  let plain = ambient underline: :INHERIT:
  assert_eq (str $ plain("plain")) plain
  assert_eq (str $ term.text("text", fg: :INHERIT:)) text

  assert_throws $ValueError do warning bold: false

#[test]
def nested_styles()
  let inner = term.preformat("$ESC[31minner$ESC[0m after")
  let text = term.text("outer ", inner, " outer", bold: true)
  assert_eq (
    text.encode()
  ) "$ESC[1mouter $ESC[31minner$ESC[0m$ESC[1m after outer$ESC[0m"
  # Stripping leaves the content of every layer, in order.
  assert_eq (str text) "outer inner after outer"

  assert_throws $ValueError do term.text bold: false text
  assert_throws $TypeError do term.text fg: RED text

#[test]
def preformatted_text()
  let text = term.preformat("$ESC[38;5;123mindexed$ESC[0m plain")
  assert_eq (type text) $term.Text
  assert_eq (text.encode()) "$ESC[38;5;123mindexed$ESC[0m plain"
  assert_eq (str text) "indexed plain"

#[test]
def text_indent()
  let text = term.preformat("$ESC[31mred\nblue$ESC[0m\n")
  let indented = text.indent(2)
  assert_eq (type indented) $term.Text
  assert_eq (indented.encode()) "  $ESC[31mred\n  blue$ESC[0m\n"
  assert_eq (text.indent(0)) $text

  let blank = term.preformat("a\n\nb").indent(2)
  assert_eq (str blank) "  a\n  \n  b"

  assert_throws $ValueError do text.indent(-1)
  assert_throws $TypeError do text.indent("2")

#[test]
def text_join()
  let sep = term.text(" | ", fg: :YELLOW:)
  let red = term.text("a", fg: :RED:)

  # Values are taken the way `text` takes its own arguments: a `Text` keeps its
  # styling, anything else is converted, and the separator keeps its own.
  let joined = sep.join([red, "b", 3])
  assert_eq (type joined) $term.Text
  assert_eq (str joined) "a | b | 3"
  assert_eq (joined.encode()) (
    "$ESC[31ma$ESC[0m$ESC[33m | $ESC[0mb$ESC[33m | $ESC[0m3"
  )

  # Nothing to separate: no separator is written.
  assert_eq (str $ sep.join([])) ""
  assert_eq (sep.join([red]).encode()) (red.encode())

  # An ordinary value is sanitized, so a `Str` carrying escapes cannot smuggle
  # styling in through a join.
  assert_eq (str $ sep.join(["$ESC[31mx"])) x

  # Any iterable will do, and the separator need not be styled.
  assert_eq (str $ (term.text ", ").join(1..4)) "1, 2, 3"

  # Measured in cells, like everything else a `Text` reports.
  assert_eq ((term.text "|").join(["界", "a"]).width()) 4

  assert_throws $TypeError do sep.join(7)

#[test]
def text_width()
  assert_eq ((term.text "abc").width()) 3
  assert_eq ((term.text "é").width()) 1
  assert_eq ((term.text "👩‍💻").width()) 2
  assert_eq ((term.text "界").width()) 2
  assert_eq ((term.text "👩👩").width()) 4
  assert_eq ((term.text "ab\n界").width()) 4

  let nested = term.text(
    "outer ",
    term.text("👩‍💻", fg: :RED:),
    " end",
    bold: true,
  )
  assert_eq (nested.width()) 12

#[test]
def text_clip()
  let plain = term.text "abcdef"
  assert_eq (plain.clip(6, suffix: "ignored")) $plain
  assert_eq (str(plain.clip(2))) ab
  assert_eq (str(plain.clip(0))) ""
  assert_eq (str(term.text("界a").clip(1))) ""
  assert_eq (str(term.text("界a").clip(2))) 界
  assert_eq (str(term.text("́a").clip(0))) "́"
  assert_eq (str(plain.clip(4, suffix: "…"))) "abc…"
  assert_eq (str(plain.clip(2, suffix: "界x"))) 界
  assert_eq (str(plain.clip(1, suffix: "界x"))) a

  let red = term.text("a界b", fg: :RED:)
  assert_eq (red.clip(3).encode()) "$ESC[31ma界$ESC[0m"

  let blue_bang = term.text("!", fg: :BLUE:)
  assert_eq (plain.clip(4, suffix: blue_bang).encode()) "abc$ESC[34m!$ESC[0m"

  # Style transitions inside a grapheme do not make it a clipping boundary.
  let joined = term.preformat("$ESC[31m👩$ESC[34m‍💻$ESC[0mX")
  assert_eq (joined.width()) 3
  assert_eq (joined.clip(2).encode()) "$ESC[31m👩$ESC[34m‍💻$ESC[0m"

  # Multiline text retains the former accumulated-width behavior.
  assert_eq (str(term.text("ab\n界x").clip(4))) "ab\n界"

  assert_throws $ValueError do plain.clip(-1)
  assert_throws $TypeError do plain.clip(2, suffix: 1)

#[test]
def text_format_measures_cells()
  # Width, alignment and precision are terminal cells, not grapheme clusters:
  # "界a" is two clusters but three cells.
  let wide = term.text "界a"
  assert_eq (str $ FmtValue wide width: 5) "界a  "
  assert_eq (str $ FmtValue wide width: 5 align: :RIGHT:) "  界a"

  # SGR sequences do not consume the budget, and the fill is measured the
  # same way the content is.
  # Formatting a `Text` lays it out in cells and then drops the styling, the
  # same as any other `str` conversion of one.
  let red = term.text("界a", fg: :RED:)
  assert_eq (str $ FmtValue red width: 5) "界a  "
  assert_eq (std.verbatim $ FmtValue red width: 5) "界a  "
  assert_eq (str $ FmtValue wide fill: "界" width: 7 align: :RIGHT:) "界界界a"

  # Precision clips at a cluster boundary in cells and leaves the styling
  # terminated, as `clip` does.
  assert_eq (str $ FmtValue red precision: 2) 界
  assert_eq (str $ FmtValue red precision: 1) ""

  # Numeric options remain unsupported, as for any other text value.
  assert_throws $std.RuntimeError do str $ FmtValue red kind: :HEX:
  assert_throws $std.RuntimeError do str $ FmtValue red sign: :PLUS:
  assert_throws $std.RuntimeError do str $ FmtValue red fill: :ZERO: width: 5

#[test]
def console_formats_bound_text()
  # The console is where a `FmtValue` bound to a `Text` is terminal presentation
  # rather than a string: `echo`, `print` and `text` apply the layout to the
  # encoded form and keep the styling.
  let red = term.text("red", fg: :RED:)
  let padded = "$ESC[31mred$ESC[0m  "
  assert_eq (term.sub can_style: true do echo (FmtValue red width: 5)) $padded
  assert_eq (term.sub can_style: true do print (FmtValue red width: 5)) $padded
  assert_eq (term.text(FmtValue red width: 5).encode()) $padded

  # Applying a style is the same path, so it composes too: the inner styling
  # survives inside the outer one.
  let framed = term.Style bold: true
  assert_eq (
    framed(FmtValue red width: 5).encode()
  ) "$ESC[1m$ESC[31mred$ESC[0m$ESC[1m  $ESC[0m"

  # Unstyled output drops the escapes but keeps the layout.
  assert_eq (term.sub do echo (FmtValue red width: 5)) "red  "

  # A specification asking for a debug rendering is no longer a request for
  # terminal presentation, and takes the ordinary sanitized path.
  let debugged = (term.sub can_style: true do echo (FmtValue red kind: :DBG:))
  assert (debugged.contains "term.Text")
  assert (debugged.contains(ESC) == false)

  # A `Str` that merely contains escapes is still untrusted, however it was
  # produced — including by `encode` on the very same `Text`.
  assert_eq
    - (term.sub can_style: true do echo (FmtValue (red.encode()) width: 5))
    - red

#[test]
def console_walks_sequences()
  # A `t"..."` reaches the console with its interpolations still separate, so
  # the console can render each one for itself. That is what a `"..."` cannot
  # offer: it concatenated its interpolations when it was built, and a `Text`
  # among them had already been flattened to its content by then.
  let red = term.text("red", fg: :RED:)
  assert_eq
    - (term.sub can_style: true do echo t"s: ${red:>5}|")
    - "s:   $ESC[31mred$ESC[0m|"
  assert_eq
    - (term.sub can_style: true do echo "s: ${red:>5}|")
    - "s:   red|"

  # Expanding is the console's own decision, not a conversion: no conversion
  # expands a sequence.
  assert_throws $TypeError do str t"s: $red"

  # Every level lays out what the level inside it rendered to, and the
  # styling comes through all of them.
  let inner = t"[${red:^7}]"
  assert_eq
    - (term.sub can_style: true do echo t"<${inner:>12}>")
    - "<   [  $ESC[31mred$ESC[0m  ]>"

  # Unstyled output drops the escapes and keeps the layout, as it does for a
  # bound `Text` on its own.
  assert_eq (term.sub do echo t"<${inner:>12}>") "<   [  red  ]>"

  # Inside a `Text` the walk is the same one, so the sequence composes with
  # the style around it.
  let framed = term.Style bold: true
  assert_eq
    - $framed(t"x ${red:>5}").encode()
    - "$ESC[1mx   $ESC[31mred$ESC[0m$ESC[1m$ESC[0m"

  # A specification asking for a debug rendering is not a request for terminal
  # presentation, here as anywhere: it takes the ordinary sanitized path.
  let debugged = (term.sub can_style: true do echo t"${red:?}")
  assert (debugged.contains "term.Text")
  assert (debugged.contains(ESC) == false)

#[test]
def console_refuses_unbound_parameters()
  # A parameter on its own is just a name, and prints as the text it was
  # written as.
  let hole = std.FmtParam :user:
  assert_eq (term.sub do echo hole) r"${#user}"

  # Reaching the console inside a sequence is different: the template was
  # never finished, so the console refuses it exactly as `format` does rather
  # than printing a hole where a value was meant to go.
  let stmt = std.Fmt ["user: ", hole]
  assert_throws $MissingKeyError do stmt.format()
  assert_throws $MissingKeyError do term.sub do echo $stmt

# --- Terminal output capture ----------------------------------------------

# Writes `source` into the temp dir and returns the script path, so tests can
# name it in a `run` invocation without the here string swallowing the
# arguments that follow it.
def script dir name source
  let path = (dir / name)
  path.write $source
  path

#[test]
def capture_collects_echo_lines()
  let out = []
  term.capture $out do
    echo hello world
    echo second
  assert_eq $out ["hello world\n", "second\n"]

#[test]
def sub_returns_captured_text()
  assert_eq (term.sub do echo("hi")) hi
  assert_eq (term.sub chomp: false do echo("hi")) "hi\n"

  # A CRLF written straight into the byte stream trims the same way.
  assert_eq (term.sub do term.output().write "hi\r\n") hi

#[test]
def print_stays_unterminated()
  # `sub` reports the byte stream verbatim, so the I/O mode must not reach it:
  # `echo` still terminates and `print` still does not, in either mode.
  def mixed()
    print a
    print b
    echo c

  assert_eq (term.sub mixed) abc

# Framing decides where the console's byte stream is cut into values and
# nothing else, so the same bytes come out either way.
#[test]
def capture_into_sink_frames_without_transforming()
  # `echo`'s terminator went into the byte stream, so it is part of the value.
  let lines = []
  term.capture $lines do echo hello
  assert_eq $lines ["hello\n"]

  # `chomp` is how a caller asks for it back off, and composes with the sink
  # the same way it would anywhere else.
  let chomped = []
  term.capture (chomped.sink().prechomp()) do echo hello
  assert_eq $chomped ["hello"]

  # Chunk framing cuts the stream elsewhere and reproduces it just the same.
  let chunks = []
  term.capture $chunks mode: :CHUNK: do echo hello
  let joined = ""
  for chunk = chunks
    joined = "$joined$(str(chunk))"
  assert_eq $joined "hello\n"

#[test]
def capture_flushes_partial_line()
  # An unterminated `print` is only visible once the scope ends and flushes,
  # and it has no terminator to carry.
  let out = []
  term.capture $out do print hi
  assert_eq $out ["hi"]

#[test]
def capture_is_unstyled_by_default()
  # A capture is not a terminal, so styling is off inside one — otherwise this
  # would pass piped and fail on a developer's terminal.
  assert_eq (term.sub do echo (term.text "warn" fg: :YELLOW:)) warn
  # And the console says so, which is what `echo` consulted to decide.
  let out = []
  term.capture $out do
    assert_eq (term.output().can_style) false

#[test]
def capture_can_style_opt_in()
  # Styling is a property of the installed console, so a test that is
  # specifically *about* styled output can ask for it — something a global tty
  # check could never express.
  let styled = "$ESC[33mwarn$ESC[0m"
  assert_eq (term.sub can_style: true do echo (term.text "warn" fg: :YELLOW:)) $styled

  # The same opt-in on the sink adapter, which is the route `capture` takes.
  let out = []
  term.capture (term.SinkConsole(out, can_style: true)) do
    assert_eq (term.output().can_style) true
    echo (term.text "warn" fg: :YELLOW:)
  assert_eq $out ["$styled\n"]

#[test]
def capture_reports_no_geometry()
  # A sink is never a terminal and has no layout, and the pin still answers
  # for the real terminal — unaffected by the capture in progress.
  let host = term.console.geometry()
  let out = []
  term.capture $out do
    assert_eq (term.output().is_tty) false
    assert_eq (term.output().geometry()) nil
    let pinned = term.console.geometry()
    assert_eq $pinned.rows $host.rows
    assert_eq $pinned.cols $host.cols

#[test]
def nesting_composes()
  let outer = []
  let inner = []
  term.capture $outer do
    echo o1
    term.capture $inner do echo i1
    echo o2

  assert_eq $outer ["o1\n", "o2\n"]
  assert_eq $inner ["i1\n"]

#[test]
def spawn_inherits_capture()
  let out = []
  term.capture $out do
    let s = strand.spawn do echo from-spawn
    s.join()
  assert_eq $out ["from-spawn\n"]

#[test]
def console_pins_past_capture()
  # `term.console` is a name, so it pins to the host for `write` and `put`
  # alike; only the anonymous `term.output()` follows the capture. Run in a
  # child so the pinned bytes land in a file rather than on the test runner's
  # terminal.
  with_temp_dir do |dir|
    let src = r|
      import term
      import shell
      import strand
      import fs
      let out = []
      term.capture $out do
        term.console.write "pinned-write\n"
        strand.pipeline output: $term.console
          do strand.from ["pinned-put"]
        echo captured
      fs.write $shell.args[0] (str out)

    let path = script $dir pin.dol $src
    let seen = (dir / "seen.txt")
    let err = (dir / "err.txt")
    run $shell.exe --no-cache $path $seen stderr: $err

    assert_eq $seen.read() r#"["captured\n"]"#
    # Both `write` and `put` are verbatim, so the only LF here is the one in
    # the source.
    assert_eq $err.read() "pinned-write\npinned-put"

#[test]
def concurrent_lines_do_not_interleave()
  # `echo` writes its payload and its terminator to the host console under one
  # lock. Two locks would let another strand slip a line in between, which
  # surfaces as run-together output — most visibly plain-mode progress lines.
  # Run in a child so the concurrent writes land in a file.
  with_temp_dir do |dir|
    let src = r|
      import strand:
        - fork
      fork
        do
          for _ = (0..200)
            echo aaaaaaaaaa
        do
          for _ = (0..200)
            echo bbbbbbbbbb

    let path = script $dir race.dol $src
    let err = (dir / "err.txt")
    run $shell.exe --no-cache $path stderr: $err

    let lines = Array(err.read().split("\n"))
    # `split` on a trailing terminator leaves one empty tail element.
    assert_eq $lines[lines.len - 1] ""
    let body = lines[..(lines.len - 1)]
    # A lost lock shows up as two payloads run together plus a blank line, so
    # both the count and the contents catch it.
    assert_eq $body.len 400
    for line = body
      assert ((line == "aaaaaaaaaa") || (line == "bbbbbbbbbb"))

#[test]
def child_stderr_is_captured()
  # An undirected child stderr is console-bound, so a capture takes it. Child
  # stdout is the data stream and still goes to the implicit sink.
  with_temp_dir do |dir|
    let src = r|
      import shell
      shell.stderr.write "child-err\n"
      shell.stdout.write "child-out\n"

    let path = script $dir noisy.dol $src
    let out = []
    let human = term.sub do run $shell.exe --no-cache $path stdout: $out

    assert_eq $human child-err
    assert_eq $out ["child-out\n"]

#[test]
def child_stdout_is_captured()
  # An undirected child stdout is console-bound too, so a capture takes it —
  # regardless of whether the real stdout backing the process is a terminal.
  # `dodo shell-test` itself runs with stdout redirected to a file, so this
  # also stands as a regression test for that non-tty case.
  with_temp_dir do |dir|
    let src = r|
      import shell
      shell.stdout.write "child-out\n"
      shell.stderr.write "child-err\n"

    let path = script $dir noisy.dol $src
    let err = []
    let human = term.sub do run $shell.exe --no-cache $path stderr: $err

    assert_eq $human child-out
    assert_eq $err ["child-err\n"]

#[test]
def mute_silences_echo_and_child_stderr()
  # Same mechanism as `capture`, just wired to a sink that throws writes away
  # — so it composes with an enclosing capture rather than fighting it, and
  # a named `stdout:` is untouched.
  let out = []
  term.capture $out do
    term.mute do
      echo hidden
      print more
    echo visible
  assert_eq $out ["visible\n"]

  with_temp_dir do |dir|
    let src = r|
      import shell
      shell.stderr.write "should-not-appear\n"
      shell.stdout.write "child-out\n"

    let path = script $dir noisy.dol $src
    let child_out = []
    let human = term.sub do
      term.mute do run $shell.exe --no-cache $path stdout: $child_out

    assert_eq $human ""
    assert_eq $child_out ["child-out\n"]

#[test]
def mute_leaves_named_strand_output_alone()
  # Redirecting via `stdout: $out` pins the inner process's own implicit
  # output to `shell.stdout`, not `term.default` — `mute` only swaps that when
  # it is still the startup default, so an unnamed grandchild here still
  # reaches it. Only the console mechanism (`term.echo`) is silenced.
  with_temp_dir do |dir|
    let src = r|
      import term
      term.mute do
        strand.put visible
        echo hidden

    let path = script $dir quiet.dol $src
    let out = []
    run $shell.exe --no-cache $path stdout: $out
    assert_eq $out ["visible"]

#[test]
def progress_lines_use_context_capture()
  # The output active when `progress.with` starts remains the destination for
  # nested indicators, even when work installs another capture underneath it.
  if term.console.is_tty
    skip "requires no terminal (progress draws directly on one)"

  with_temp_dir do |dir|
    let src = r|
      import fs progress shell term
      let outer = []
      let inner = []
      term.capture $outer do
        progress.with do
          term.capture $inner do
            progress.show message: working do |_| nil
      (fs.Path shell.args[0]).write (str outer)

    let path = script $dir progress.dol $src
    let seen = (dir / "seen.txt")
    let err = (dir / "err.txt")
    run $shell.exe --no-cache $path $seen stderr: $err

    assert $seen.read().contains "working"
    assert_eq (err.read()) ""

#[test]
def do_subclass_console()
  # The interface is a real type, so Do code can implement a console.
  class Recorder: term.Console
    pub field lines

    def (init) self
      term.Console.(init) $self
      self.lines = []

    pub def write self ...data
      let pieces = [...data.pos_only()]
      self.lines.push $pieces
      let written = 0
      for piece = pieces
        written = (written + piece.len)
      written

    pub def flush _self
      nil

  let recorder = Recorder()
  term.capture $recorder do
    echo terminated
    print bare
  # `echo` passes payload and terminator to one `write`, so the subclass sees
  # a single call with the line and its terminator as separate pieces.
  assert_eq $recorder.lines [["terminated", "\n"], ["bare"]]

  # Supplying only the two write members is enough: the capability members
  # have safe defaults, which the subclass inherits from the base. That
  # includes `line_ending`, which is what `echo` above terminated with.
  assert_eq $recorder.can_style false
  assert_eq $recorder.is_tty false
  assert_eq (recorder.geometry()) nil

#[test]
def do_console_declares_capabilities()
  # A Do field shadows the base's getter, and a Do method its `geometry()`.
  class MyGeometry: term.Geometry
    pub field rows
    pub field cols

    def (init) self rows cols
      term.Geometry.(init) $self
      self.rows = rows
      self.cols = cols

  class Fancy: term.Console
    pub field lines
    pub field can_style = true

    def (init) self
      term.Console.(init) $self
      self.lines = []

    pub def write self ...data
      let line = ""
      for piece = [...data.pos_only()]
        line = "$line$piece"
      self.lines.push $line
      line.len

    pub def flush _self
      nil

    pub def geometry _self
      MyGeometry 24 80

  let fancy = Fancy()
  term.capture $fancy do echo (term.text "warn" fg: :YELLOW:)
  assert_eq $fancy.lines ["$ESC[33mwarn$ESC[0m\n"]

  let g = fancy.geometry()
  assert (type g term.Geometry)
  assert_eq $g.rows 24
  assert_eq $g.cols 80

#[test]
def do_console_chooses_its_terminator()
  # The console owns the terminator policy but does not apply it: `echo` reads
  # `line_ending` off the installed console, so a subclass that declares its
  # own gets it, still in a single write.
  class Crlf: term.Console
    pub field lines
    pub field line_ending = "\r\n"

    def (init) self
      term.Console.(init) $self
      self.lines = []

    pub def write self ...data
      let line = ""
      for piece = [...data.pos_only()]
        line = "$line$piece"
      self.lines.push $line
      line.len

    pub def flush _self
      nil

  let crlf = Crlf()
  term.capture $crlf do
    echo terminated
    print bare
  assert_eq $crlf.lines ["terminated\r\n", "bare"]

#[test]
def capture_reads_line_ending_once()
  # `line_ending` is read when the console is installed, not on every `echo`.
  class Shifty: term.Console
    pub field lines
    pub field line_ending = "\n"

    def (init) self
      term.Console.(init) $self
      self.lines = []

    pub def write self ...data
      self.lines.push [...data.pos_only()]
      nil

    pub def flush _self
      nil

  let shifty = Shifty()
  term.capture $shifty do
    echo one
    shifty.line_ending = "\r\n"
    echo two
  assert_eq $shifty.lines [["one", "\n"], ["two", "\n"]]

  class Bad: term.Console
    pub field line_ending = 42

    def (init) self
      term.Console.(init) $self

  assert_throws $TypeError do term.capture (Bad()) do nil

#[test]
def console_write_takes_pieces()
  let out = []
  let console = term.SinkConsole $out
  assert_eq (console.write "a" b"b" "\n") 3
  assert_eq $out ["ab\n"]
  assert_throws $TypeError do console.write "a" 1

  assert_eq (term.sub do term.output().write "a" "b") ab

#[test]
def bare_geometry_refuses()
  # `term.Geometry` is the interface, so an instance of it has no dimensions to
  # report — the same refusal `term.Console`'s write methods make.
  let base = term.Geometry()
  assert (type base term.Geometry)
  assert_throws $UnsupportedError do base.rows
  assert_throws $UnsupportedError do base.cols

#[test]
def reentrant_console_does_not_recurse()
  # A console whose own `write` echoes falls through to the host rather than
  # routing back into itself until the call-depth limit. Run in a child so the
  # fallen-through line lands in a file — where it can be asserted on — rather
  # than on the test runner's terminal.
  with_temp_dir do |dir|
    let src = r|
      import term
      import shell
      import fs

      class Loud: term.Console
        pub field seen

        def (init) self
          term.Console.(init) $self
          self.seen = []

        pub def write self ...data
          let line = ""
          for piece = [...data.pos_only()]
            line = "$line$piece"
          self.seen.push $line
          echo "loud: $line"
          line.len

        pub def flush _self
          nil

      let loud = Loud()
      let outer = []
      term.capture $outer do
        term.capture $loud do echo hello
      fs.write $shell.args[0] "$(str loud.seen) $(str outer)"

    let path = script $dir loud.dol $src
    let seen = (dir / "seen.txt")
    let err = (dir / "err.txt")
    run $shell.exe --no-cache $path $seen stderr: $err

    # The inner console saw the line, and the re-entrant `echo` skipped both
    # captures rather than landing in the enclosing one — which is what keeps
    # the guard simple.
    assert_eq $seen.read() r#"["hello\n"] []"#
    # It reached the host console, whose line ending is LF on every platform.
    # Two of them: the data the console was handed already carried `echo`'s
    # terminator, and the re-entrant `echo` adds its own.
    assert_eq $err.read() "loud: hello\n\n"
