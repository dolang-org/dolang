import sys admin dodo json toml
  fs:
    - Path
    - copy
    - create_dir
    - remove
    - with_temp_dir
    - symlink_file
    - glob

let MIRI_CRATES = $
  - dolang-bytecode
  - dolang-compile
  - dolang-runtime
  - dolang-private-util
  - dolang
  - dolang-private-regression

let COV_IGNORE = $
  - dolang-private-util/src/hashbrown
  - dolang-private-build
  - dolang-private-test
  - dolang-private-polyfill

# Module search directories for the `do` mkdocstrings handler. This is the
# sole source of truth for that list -- it used to also live in mkdocs.yml's
# handler options, but the handler no longer resolves .dol sources itself; it
# only reads the pre-extracted JSON cache `extract_docs` produces from this
# list (see with_mkdocs).
let MKDOCS_DOC_PATHS = $
  - dolang-shell-modules/lib
  ...(glob "*/stub")

let MKDOCS_API_DIR = Path "docs/api"

let DOC_CRATES = $
  - dolang
  - dolang-rpc
  - dolang-winterop
  - dolang-vfs

let PUBLISH_CRATES = $
  - dolang-rpc
  - dolang-private-build
  - dolang-private-util
  - dolang-winterop
  - dolang-vfs
  - dolang-vfs-winreg
  - dolang-vfs-winscm
  - dolang-vfs-winnet
  - dolang-shell-vfs
  - dolang-bytecode
  - dolang-runtime
  - dolang-compile
  - dolang-lsp
  - dolang
  - dolang-ext-yaml
  - dolang-ext-toml
  - dolang-ext-regex
  - dolang-ext-rand
  - dolang-ext-url
  - dolang-ext-json
  - dolang-ext-glob
  - dolang-ext-digest
  - dolang-ext-base64
  - dolang-ext-uuid
  - dolang-ext-time
  - dolang-ext-load
  - dolang-private-test
  - dolang-ext-compile
  - dolang-ext-xml
  - dolang-ext-shell
  - dolang-ext-winreg
  - dolang-ext-winscm
  - dolang-ext-winnet
  - dolang-ext-zip
  - dolang-ext-sqlite
  - dolang-ext-progress
  - dolang-ext-patch
  - dolang-ext-http
  - dolang-ext-http-mock
  - dolang-ext-tar
  - dolang-shell-main
  - dolang-private-bundle
  - dolang-shell-modules
  - dolang-shell

let TARGETS = $
  for arch = ["x86_64", "aarch64"]
    "$arch-linux":
      tuple: $arch-unknown-linux-gnu
    "$arch-windows":
      if (sys.os_info().family == :WINDOWS:)
        # Native target
        tuple: $arch-pc-windows-msvc
      else
        # Cross target
        tuple: $arch-pc-windows-gnullvm
      exe: true
  "x86_64-linux":
    tuple: x86_64-unknown-linux-gnu
  "x86_64-freebsd":
    tuple: x86_64-unknown-freebsd
  "aarch64-macos":
    tuple: aarch64-apple-darwin

def default_target()
  let target = "$(str(sys.cpu_info().arch).lower())-$(str(sys.os_info().os).lower())"
  if !(TARGETS.contains target)
    throw std.RuntimeError "unsupported host target: $target"
  target

def run_cargo ...args
  # IF YOU'RE READING THIS, TAKE A HINT
  env DODO: 1 do dodo.show cargo ...args

class Spec
  pub field target tuple profile channel target_dir
  field extra

  def (init)
    self args
    :profile = nil
    :variant = nil
    :tuple = nil
    :channel = nil
    :extra = []
  do
    self.target = TARGETS[args.target || default_target()]
    self.tuple = (tuple || self.target[:tuple:])
    self.profile = (profile || "debug")
    self.channel = channel
    self.#extra = extra
    self.target_dir = if variant
      (Path("target") / self.tuple / variant / self.profile)
    else
      (Path("target") / self.tuple / self.profile)

  pub def bin self name
    let exe = self.target.get :exe:
    let path = (self.target_dir / name).absolute()
    if exe
      path.add_ext exe
    else
      path

  pub def cargo self cmd ...rest
    run_cargo
      if self.channel
        +$self.channel
      $cmd --target $self.tuple
      if (self.profile == "release")
        --$self.profile
      else if (self.profile != "debug")
        --profile $self.profile
      ...self.#extra ...rest

  pub def cargo_vfs self ...rest
    self.cargo build --bin dolang-vfs --bin dolang-private-polyfill
    self.cargo ...rest

let native = Spec (record target: nil) profile: opt

def default_shell_tests slow release
  $
    test
    if !slow
      --tags !slow
    if !release
      --tags !release
    else
      --timeout 3600

def wasm_tool name
  # The CLI must exactly match the locked library version.
  let lock = toml.decode $Path("Cargo.lock").read()
  let package = lock["package"].find(do |package| package["name"] == "wasm-bindgen")
  let version = package["version"]
  let tools_dir = Path "target/wasm-bindgen/$version"
  run_cargo install wasm-bindgen-cli --version $version --locked --root $tools_dir
  let bin = (tools_dir / "bin" / name).absolute()
  if (sys.os_info().family == :WINDOWS:)
    bin = bin.add_ext exe
  bin

def wasm_build()
  let bindgen = wasm_tool wasm-bindgen
  run_cargo build -p dolang-wasm --target wasm32-unknown-unknown --release --locked
  dodo.show $bindgen
    --target web --out-dir playground/pkg
    target/wasm32-unknown-unknown/release/dolang_wasm.wasm

def wasm_test()
  let runner = wasm_tool wasm-bindgen-test-runner
  env CARGO_TARGET_WASM32_UNKNOWN_UNKNOWN_RUNNER: $runner do
    run_cargo test -p dolang-wasm --target wasm32-unknown-unknown --lib --locked

def playground_build()
  wasm_build()
  dodo.show npm --prefix playground ci
  dodo.show npm --prefix playground run build

def rustdoc_build()
  env RUSTDOCFLAGS: "--cfg docsrs" do
    run_cargo +nightly doc --no-deps
      for crate = DOC_CRATES
        -p $crate

# Module-name resolution for a .dol source under a search dir: `foo/bar.dol`
# is module `foo.bar`; `foo/mod.dol` is module `foo`. This is also how
# identifiers are keyed in the pre-extracted JSON cache the mkdocstrings
# handler (docs/mkdocstrings_handlers/do/__init__.py) reads.
def dol_module_name path base
  let rel = path.relative $base
  let parts = [...rel.parent.components]
  if (rel.name != "mod.dol")
    parts.push $rel.stem
  ".".join $parts

def collect_doc_jobs()
  stream do for search_dir = MKDOCS_DOC_PATHS
    let base = Path $search_dir
    for path = base.glob "**/*.dol"
      let name = dol_module_name $path $base
      put $ record :name :path

# The documented public classes a module declares or re-exports. Only
# documented ones receive pages because the handler hides undocumented
# entities by default.
def module_classes modules module entities chain = []
  let names = []
  for e = entities
    if ((e["kind"] == "class") && e["pub"] && e["doc"])
      names.push $e["name"]
    else if ((e["kind"] == "import_item") && e["pub"])
      let key = "$module.$(e["name"])"
      if chain.contains $key
        throw "cyclic public doc re-export: $(" -> ".join([...chain, key]))"
      let source = modules.get $e["module"] else: do
        throw "public doc re-export $key names missing module $(e["module"])"
      let target = source["entities"].find do |candidate|
        (candidate["name"] == e["item"])
      if (target == nil)
        throw "public doc re-export $key names missing item $(e["module"]).$(e["item"])"
      let resolved = module_classes $modules $e["module"] [target] [...chain, key]
      if resolved.len
        names.push $e["name"]
  names

def private_doc_module name
  name.split(".").any do |component| component.starts_with "_"

def write_doc_page path title identifier
  path.parent.create_dir all: true
  # The frontmatter `title` is for awesome-nav: with `use_index_title` on, it
  # reads this instead of falling back to a title-cased directory name (e.g.
  # `fs.unix` -> "Fs.unix"), which is wrong for names that are meant to stay
  # lowercase. The `{: #... }` attr_list anchor matches the identifier
  # mkdocstrings registers for this page's own root heading. Without it,
  # Python-Markdown's toc extension slugifies the plain title into its own
  # anchor id (e.g. "Args" -> "args"), which collides workspace-wide with any
  # unrelated heading that happens to slugify the same way (a module named
  # `args`, in this case). A matching id here just dedupes against that
  # registration instead of adding a second, colliding one.
  path.write |
    ---
    title: $(dbg title)
    ---

    # $title {: #$identifier }

    ::: $identifier

# Writes docs/api pages for one module: an index page plus one page per public
# class. Each module gets its own single directory named after its full
# dotted name (`fs.unix` -> api/fs.unix/, not api/fs/unix/) rather than one
# nested per dotted component -- otherwise a module like `security.windows`
# would show up nested under an unrelated `security` section in the nav
# instead of as its own entry. Private modules (leading `_`, e.g.
# `_container.dockman`) are implementation detail and get no page of their
# own. Any component beginning with `_` makes the module private. Re-exported
# classes are written under the public importing module instead.
def generate_doc_pages modules name entities
  if !private_doc_module(name)
    let dir = (MKDOCS_API_DIR / name)
    write_doc_page (dir / "index.md") $name $name
    for class_name = module_classes $modules $name $entities
      write_doc_page (dir / "$class_name.md") $class_name "$name.$class_name"

# Runs `dolang -m doc` once per module, in parallel, writing each result as
# `<out_dir>/<module name>.json`. This is the JSON-only half of extract_docs
# (see there for the full doc comment on why extraction is parallelized) --
# used by `install` to feed dolang-lsp's build-time static doc index (see
# dolang-lsp/build.rs) without also touching the docs/api page tree.
def extract_doc_json spec out_dir
  out_dir.remove all: true ignore: true
  out_dir.create_dir all: true
  let workers = sys.cpu_info().logical_count
  strand.pool $workers $collect_doc_jobs() do |job|
    let :name :path = job
    run (spec.bin "dolang") -m compile extract --doc --module $name $path stdout: (out_dir / "$name.json")

# Extracts the JSON cache and regenerates the docs/api page tree from it.
#
# `dolang -m compile extract --doc` nests the cooked documentation projection
# under "doc" alongside the raw nodes/tokens/diagnostics dump; only the
# former is relevant here, so it's unwrapped once when the cache is loaded.
def extract_docs out_dir
  extract_doc_json $native $out_dir
  MKDOCS_API_DIR.remove all: true ignore: true
  let modules = $
    for doc = out_dir.glob("*.json").map do |p| (json.decode(p.read())["doc"])
      $doc["module"]: $doc
  for name document = modules
    generate_doc_pages $modules $name $document["entities"]

def with_mkdocs func
  native.cargo build --bin dolang
  # The handler reads a pre-extracted JSON cache -- one file per module,
  # produced by extract_docs (see there for why) -- rather than running the
  # `dolang` extractor itself.
  let doc_cache = (native.target_dir / "mkdocs-doc")
  extract_docs $doc_cache
  env
    DOLANG_HIGHLIGHT: "$(native.bin "dolang") -m compile extract"
    DOLANG_DOC_CACHE: $doc_cache
    NO_MKDOCS_2_WARNING: 1
    $func

def cargo_test spec rest
  spec.cargo test ...rest

def shell_test spec args
  spec.cargo_vfs run --bin dolang -- --module-path testlib -m test
    ...(args.args || default_shell_tests args.slow args.release)

def both_test spec args
  cargo_test $spec []
  shell_test $spec $ record args: nil slow: $args.slow release: $args.release

def can_write_dir path
  try
    create_dir $path all: true
    with_temp_dir parent: $path do |_| true
  catch sys.PermissionDeniedError: _
    false

def install_bin spec bin_dir name
  let bin = spec.bin(name)
  let dst = (bin_dir / bin.name).absolute()
  let tmp = dst.add_ext tmp
  bin.copy $tmp
  tmp.rename $dst
  echo "installed: $dst"

# Checks that `install`'s `+crt-static` took effect: a statically linked binary
# imports neither the VC++ runtime nor the UCRT forwarders that reach it.
#
# A PE import directory stores DLL names as plain ASCII, so scanning the file
# for them needs no `dumpbin` and no Visual Studio environment on the runner.
let WINDOWS_FORBIDDEN_IMPORTS = $
  - "VCRUNTIME140.dll"
  - "api-ms-win-crt-"

def verify_windows_crt spec name
  let bin = spec.bin(name)
  let contents = bin.read "b"
  for needle = WINDOWS_FORBIDDEN_IMPORTS
    if contents.contains(Bin needle)
      throw std.RuntimeError "$bin imports $needle: crt-static did not take effect"
  echo "verified: $(bin.name) links the CRT statically"

def install_bin_symlink spec bin_dir from to
  bin_dir = bin_dir.absolute()
  let bin = spec.bin(from)
  let src = (bin_dir / bin.name)
  let dst = src.with_stem $to
  let tmp = dst.add_ext tmp
  symlink_file (src.relative bin_dir) $tmp
  tmp.rename $dst
  echo "link: $dst -> $src"

return $
  common:
    - opt: target
      help: target platform
      default: nil
      values: [...TARGETS.keys()]
  default: build

  "test-asan":
    help: run tests with AddressSanitizer
    - arg: args
      help: "arguments to nightly cargo build/test/run"
      collect: true
    do |args|
      let spec = Spec $args
        channel: nightly
        profile: opt
        extra:
          -Z build-std
      env RUSTFLAGS: "-Z sanitizer=address --cfg asan" do both_test $spec

  "test-miri":
    help: run tests with miri
    - arg: args
      help: arguments to `cargo +nightly miri test`
      collect: true
    do |args|
      env MIRIFLAGS: -Zmiri-disable-isolation do
        run_cargo +nightly miri test
          for crate = MIRI_CRATES
            -p $crate
          ...args.args

  build:
    help: build main artifacts
    - arg: args
      help: arguments to `cargo build`
      collect: true
    do |args|
      let spec = Spec $args
      spec.cargo build ...args.args

  run:
    help: run dolang
    - arg: args
      help: additional arguments to dolang
      collect: true
    do |args|
      let spec = Spec $args
      spec.cargo_vfs run --bin dolang -- ...args.args

  "cargo-test":
    help: run cargo tests
    - arg: args
      help: "arguments to `cargo test`"
      collect: true
    do |args|
      cargo_test (Spec args) $args.args

  "cargo-bench":
    help: run cargo benchmarks
    - arg: args
      help: "arguments to `cargo bench`"
      collect: true
    do |args|
      let spec = Spec $args profile: dist
      spec.cargo bench ...args.args

  "gen-system-error-codes":
    help: generate system error code lookup tables from public source documents
    - arg: args
      help: source arguments for tools/gen_system_error_codes.py
      collect: true
    do |args|
      dodo.show python3 tools/gen_system_error_codes.py
        --output dolang-ext-shell/src/error_code/generated.rs
        --windows-output dolang-winterop/src/win_error/generated.rs
        ...args.args

  "shell-test":
    help: run shell integration tests
    - arg: args
      help: arguments to `dolang -m test` (default: $(default_shell_tests false false))
      collect: true
    - flag: slow
      help: run slow tests (superseded by `args`)
    - flag: release
      help: run release tests (superseded by `args`)
    do |args|
      shell_test (Spec args) $args

  "test":
    help: run all tests
    - flag: slow
      help: run slow tests
    - flag: release
      help: run release tests
    do |args|
      both_test (Spec args) $args

  "gen-bytecode-fuzz-seeds":
    help: generate bytecode fuzz seeds
    do |_|
      run_cargo run -p dolang-fuzz --bin gen-bytecode-seeds

  "fuzz-bytecode":
    help: run the bytecode fuzzer
    - arg: args
      help: "arguments to `cargo +nightly fuzz run`"
      collect: true
    do |args|
      run_cargo run -p dolang-fuzz --bin gen-bytecode-seeds
      run_cargo +nightly fuzz run bytecode_deserialize
        target/fuzz-corpus/bytecode_deserialize
        -- ...args.args

  cov:
    help: run coverage collection
    do |args|
      let spec = Spec $args
        variant: llvm-cov-target
        extra:
          --all-features
      spec.cargo llvm-cov clean
      spec.cargo llvm-cov run --no-report --ignore-run-fail --bin dolang-vfs
      spec.cargo llvm-cov run --no-report --ignore-run-fail --bin dolang-private-polyfill
      env
        DOLANG_EXPORT_DOT: $Path("dot").absolute()
        VFS: (spec.bin "dolang-vfs")
        do
          spec.cargo llvm-cov test --no-report
          spec.cargo llvm-cov run --no-report --bin dolang --
            --module-path testlib -m test ...default_shell_tests true true

  "cov-dump":
    help: write coverage summaries to disk
    do |args|
      let spec = Spec $args
      let ignore = "($("|".join COV_IGNORE))"
      spec.cargo llvm-cov report --json --summary-only --output-path cov.json
        --ignore-filename-regex $ignore
      spec.cargo llvm-cov report --json --output-path cov.full.json
        --ignore-filename-regex $ignore
      spec.cargo llvm-cov report --text --output-path cov.full.txt
        --ignore-filename-regex $ignore

  "serve-cov":
    help: build and serve the HTML coverage report
    do |args|
      let spec = Spec $args
      let ignore = "($("|".join COV_IGNORE))"
      spec.cargo llvm-cov report --html --ignore-filename-regex $ignore
      dodo.show python3 -m http.server 8080 -d target/llvm-cov/html/ -b localhost

  rustdoc:
    help: build selected rustdoc packages
    do |_| rustdoc_build()

  "serve-rustdoc":
    help: build and serve rustdoc locally
    do |_|
      rustdoc_build()
      dodo.show python3 -m http.server 8080 -d target/doc -b localhost

  "serve-mkdocs":
    help: build and serve the MkDocs site
    do |_|
      with_mkdocs do dodo.show mkdocs serve

  mkdocs:
    help: build the MkDocs site
    do |_|
      with_mkdocs do dodo.show mkdocs build --strict

  "wasm-build":
    help: build browser Wasm adapter
    do |_|
      wasm_build()

  playground:
    help: build the static browser playground into target/playground
    do |_| playground_build()

  "serve-playground":
    help: build and serve the static browser playground
    do |_|
      playground_build()
      dodo.show python3 -m http.server 8080 -d target/playground/ -b localhost

  "wasm-test":
    help: run adapter tests as Wasm in Node
    do |_| wasm_test()

  "playground-test":
    help: build and test the browser playground (requires Playwright Chromium)
    do |_|
      playground_build()
      run_cargo clippy -p dolang-wasm --target wasm32-unknown-unknown --all-targets -- -D warnings
      dodo.show npm --prefix playground test

  pages:
    help: build the complete GitHub Pages site
    do |_|
      with_mkdocs do dodo.show mkdocs build --strict
      rustdoc_build()
      copy target/doc site/rustdoc all: true
      copy .github/rustdoc-index.html site/rustdoc/index.html
      playground_build()
      copy target/playground site/playground all: true

  fmt:
    help: format Rust
    do |_|
      run_cargo fmt

  "fmt-docs":
    help: format Markdown
    do |_| dodo.show rumdl fmt

  lint:
    help: check for coding/formatting errors
    do |args|
      let spec = Spec $args
      spec.cargo clippy --all-targets
      run_cargo fmt --check

  "lint-docs":
    help: check for Markdown errors in documentation
    do |_|
      dodo.show rumdl check

  clean:
    help: remove build artifacts and generated docs
    do |_|
      run_cargo clean
      remove site dot all: true ignore: true

  install:
    help: install dolang binaries
    - opt: prefix
      parse: $Path
      help: installation root
    do |args|
      let spec = Spec $args profile: dist
      let is_linux = spec.tuple.ends_with "-linux-gnu"
      let is_windows = spec.tuple.ends_with "-pc-windows-msvc"
      let vfs_spec = if is_linux
        Spec $args
          profile: dist
          tuple: $(spec.tuple.without_suffix "-gnu")-musl
      else
        spec

      # A shipped Windows binary must not depend on the Visual C++
      # redistributable: the default MSVC link imports `VCRUNTIME140.dll`,
      # which comes from the redistributable rather than from the OS. It is
      # often present incidentally on a desktop install, but a freshly
      # installed image is exactly where it is least likely to be -- and that
      # is where `libvirt` provisioning runs these binaries. Linking the CRT
      # statically absorbs the UCRT along with it, leaving imports on OS DLLs
      # only.
      env
        if is_linux
          ZSTD_SYS_USE_PKG_CONFIG: 1
        if is_windows
          RUSTFLAGS: "-C target-feature=+crt-static"
        do
          spec.cargo build --bin dolang
          vfs_spec.cargo build --bin dolang-vfs
          # dolang-lsp's build.rs bakes a static hover doc index out of the
          # same per-module JSON dump `dodo mkdocs` uses (see
          # extract_doc_json) -- generate it with the dolang binary just
          # built, then point the build at it via env var.
          let doc_json = (spec.target_dir / "lsp-doc-json").absolute()
          extract_doc_json $spec $doc_json
          env DOLANG_LSP_DOC_JSON_DIR: $doc_json do
            spec.cargo build --bin dolang-lsp

      if is_windows
        verify_windows_crt $spec dolang
        verify_windows_crt $spec dolang-lsp
        verify_windows_crt $vfs_spec dolang-vfs

      let bin_dir = (args.prefix / "bin")

      let context = if can_write_dir $bin_dir
        do |block| block()
      else
        admin.with

      context do
        create_dir $bin_dir all: true
        install_bin $spec $bin_dir dolang
        install_bin $spec $bin_dir dolang-lsp
        if (sys.os_info().family != :WINDOWS:)
          install_bin_symlink $spec $bin_dir dolang dodo
          install_bin_symlink $spec $bin_dir dolang dolang-test
        install_bin $vfs_spec $bin_dir dolang-vfs

  "verify-macos-interpose":
    help: check that the macOS posix_spawn interpose section survived linking
    - opt: bin
      help: path to the built dolang binary to inspect
      default: nil
    do |args|
      let bin = (args.bin || "release/bin/dolang")
      echo "checking $bin for __DATA,__interpose survival"
      let load_commands = sub do run otool -lv $bin
      if !(load_commands.contains "__interpose")
        throw std.RuntimeError "__DATA,__interpose section missing from $bin -- posix_spawn guard was stripped"

  publish:
    help: publish workspace crates in dependency order
    - arg: args
      help: "arguments to `cargo publish`"
      collect: true
    do |args|
      dodo.show cargo publish
        for crate = PUBLISH_CRATES
          -p $crate
        ...args.args
