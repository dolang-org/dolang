{
    "name": "dolang",
    "displayName": "dolang",
    "description": "Do Language Support",
    "version": "0.1.0",
    "license": "Apache-2.0 OR MIT",
    "repository": {
        "type": "git",
        "url": "https://github.com/dolang-org/dolang.git"
    },
    "engines": {
        "vscode": "^1.75.0"
    },
    "categories": [
        "Programming Languages"
    ],
    "configuration": {
        "title": "Do Language",
        "properties": {
            "dolang.runInTerminal": {
                "type": "boolean",
                "default": true,
                "description": "Run Do scripts in integrated terminal (recommended for interactive scripts and user input)"
            },
            "dolang.autoSaveBeforeRun": {
                "type": "boolean",
                "default": true,
                "description": "Automatically save Do script files before running them"
            },
            "dolang.keepTerminalOpen": {
                "type": "boolean",
                "default": true,
                "description": "Keep terminal open after script execution to view output"
            },
            "dolang.path": {
                "type": "string",
                "default": "",
                "description": "Absolute path to the `dolang` executable. When unset, the extension tries PATH and then downloads a GitHub release bundle."
            },
            "dolang.lsp.path": {
                "type": "string",
                "default": "",
                "description": "Absolute path to the `dolang-lsp` executable. When unset, the extension tries PATH and then downloads a GitHub release bundle."
            }
        }
    },
    "main": "./dist/extension.js",
    "activationEvents": [
        "onLanguage:dolang",
        "onCommand:dolang.runScript",
        "onCommand:dolang.runScriptFile",
        "onCommand:dolang.openInteractiveShell"
    ],
    "contributes": {
        "languages": [
            {
                "id": "dolang",
                "aliases": [
                    "Do",
                    "dolang"
                ],
                "extensions": [
                    ".dol"
                ],
                "configuration": "./language-configuration.json"
            }
        ],
        "grammars": [
            {
                "language": "dolang",
                "scopeName": "source.dol",
                "path": "./syntaxes/dolang.tmLanguage.json"
            }
        ],
        "commands": [
            {
                "command": "dolang.runScript",
                "title": "Run Do Script",
                "icon": "$(play)"
            },
            {
                "command": "dolang.runScriptFile",
                "title": "Run Do Script",
                "icon": "$(play)"
            },
            {
                "command": "dolang.openInteractiveShell",
                "title": "Open Do Interactive Shell",
                "icon": "$(terminal)"
            }
        ],
        "menus": {
            "editor/title": [
                {
                    "command": "dolang.runScript",
                    "when": "resourceLangId == dolang",
                    "group": "navigation"
                }
            ],
            "editor/context": [
                {
                    "command": "dolang.runScriptFile",
                    "when": "resourceLangId == dolang",
                    "group": "navigation"
                }
            ],
            "explorer/context": [
                {
                    "command": "dolang.runScriptFile",
                    "when": "resourceLangId == dolang",
                    "group": "navigation"
                }
            ],
            "commandPalette": [
                {
                    "command": "dolang.runScript",
                    "when": "resourceLangId == dolang"
                },
                {
                    "command": "dolang.runScriptFile",
                    "when": "resourceLangId == dolang"
                }
            ]
        }
    },
    "scripts": {
        "vscode:prepublish": "npm run package",
        "compile": "npm run check-types && npm run lint && node esbuild.js",
        "watch": "npm-run-all -p watch:*",
        "watch:esbuild": "node esbuild.js --watch",
        "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
        "package": "npm run check-types && npm run lint && node esbuild.js --production",
        "compile-tests": "tsc -p tsconfig.test.json",
        "watch-tests": "tsc -p tsconfig.test.json -w",
        "pretest": "npm run compile-tests && npm run compile && npm run lint",
        "check-types": "tsc --noEmit",
        "lint": "eslint src",
        "format": "prettier --write .",
        "package:vsix": "vsce package",
        "test": "vscode-test --fail-zero",
        "test:syntax": "node --test test/syntax.test.mjs"
    },
    "dependencies": {
        "tar": "^7.5.21",
        "vscode-languageclient": "^10.1.0"
    },
    "devDependencies": {
        "@types/mocha": "^10.0.0",
        "@types/node": "20.x",
        "@types/vscode": "^1.75.0",
        "@typescript-eslint/eslint-plugin": "^8.65.0",
        "@typescript-eslint/parser": "^8.65.0",
        "@vscode/test-cli": "^0.0.11",
        "@vscode/test-electron": "^2.3.0",
        "@vscode/vsce": "^3.6.2",
        "esbuild": "^0.28.1",
        "eslint": "^10.8.0",
        "npm-run-all": "^1.1.3",
        "prettier": "^3.7.4",
        "typescript": "^5.3.0",
        "vscode-oniguruma": "^2.0.1",
        "vscode-textmate": "^9.3.2"
    },
    "allowScripts": {
        "esbuild@0.28.1": true,
        "keytar@7.9.0": true,
        "@vscode/vsce-sign@2.0.9": true
    }
}
