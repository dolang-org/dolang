{
    "name": "dolang",
    "displayName": "dolang",
    "description": "Do Language Support",
    "version": "0.1.0",
    "license": "Apache-2.0 OR MIT",
    "repository": {
        "type": "git",
        "url": "https://github.com/dolang-org/dolang.git"
    },
    "engines": {
        "vscode": "^1.75.0"
    },
    "categories": [
        "Programming Languages"
    ],
    "main": "./dist/extension.js",
    "activationEvents": [
        "onLanguage:dolang",
        "onCommand:dolang.runScript",
        "onCommand:dolang.runScriptFile",
        "onCommand:dolang.openInteractiveShell",
        "onCommand:dolang.runScriptWithArgs",
        "onCommand:dolang.sendSelectionToShell",
        "onTaskType:dolang"
    ],
    "contributes": {
        "configuration": {
            "title": "Do Language",
            "properties": {
                "dolang.autoSaveBeforeRun": {
                    "type": "boolean",
                    "default": true,
                    "description": "Save a modified Do script before running it"
                },
                "dolang.keepTerminalOpen": {
                    "type": "boolean",
                    "default": true,
                    "description": "Keep the script's terminal open after it exits, until a key is pressed"
                },
                "dolang.path": {
                    "type": "string",
                    "default": "",
                    "description": "Absolute path to the `dolang` executable. When unset, the extension tries PATH and then downloads a GitHub release bundle."
                },
                "dolang.lsp.path": {
                    "type": "string",
                    "default": "",
                    "description": "Absolute path to the `dolang-lsp` executable. When unset, the extension tries PATH and then downloads a GitHub release bundle."
                }
            }
        },
        "languages": [
            {
                "id": "dolang",
                "aliases": [
                    "Do",
                    "dolang"
                ],
                "extensions": [
                    ".dol"
                ],
                "configuration": "./language-configuration.json"
            }
        ],
        "grammars": [
            {
                "language": "dolang",
                "scopeName": "source.dol",
                "path": "./syntaxes/dolang.tmLanguage.json"
            }
        ],
        "commands": [
            {
                "command": "dolang.runScript",
                "title": "Run Do Script",
                "icon": "$(play)"
            },
            {
                "command": "dolang.runScriptFile",
                "title": "Run Do Script",
                "icon": "$(play)"
            },
            {
                "command": "dolang.runScriptWithArgs",
                "title": "Run Do Script with Arguments…"
            },
            {
                "command": "dolang.openInteractiveShell",
                "title": "Open Do Interactive Shell",
                "icon": "$(terminal)"
            },
            {
                "command": "dolang.sendSelectionToShell",
                "title": "Send Selection/Line to Do Shell"
            }
        ],
        "menus": {
            "editor/title": [
                {
                    "command": "dolang.runScript",
                    "when": "resourceLangId == dolang",
                    "group": "navigation"
                }
            ],
            "editor/context": [
                {
                    "command": "dolang.runScriptFile",
                    "when": "resourceLangId == dolang",
                    "group": "navigation"
                },
                {
                    "command": "dolang.runScriptWithArgs",
                    "when": "resourceLangId == dolang",
                    "group": "navigation"
                },
                {
                    "command": "dolang.sendSelectionToShell",
                    "when": "editorLangId == dolang",
                    "group": "navigation"
                }
            ],
            "explorer/context": [
                {
                    "command": "dolang.runScriptFile",
                    "when": "resourceLangId == dolang",
                    "group": "navigation"
                },
                {
                    "command": "dolang.runScriptWithArgs",
                    "when": "resourceLangId == dolang",
                    "group": "navigation"
                }
            ],
            "commandPalette": [
                {
                    "command": "dolang.runScript",
                    "when": "resourceLangId == dolang"
                },
                {
                    "command": "dolang.runScriptFile",
                    "when": "resourceLangId == dolang"
                },
                {
                    "command": "dolang.runScriptWithArgs",
                    "when": "resourceLangId == dolang"
                },
                {
                    "command": "dolang.sendSelectionToShell",
                    "when": "editorLangId == dolang"
                }
            ]
        },
        "taskDefinitions": [
            {
                "type": "dolang",
                "required": [
                    "script"
                ],
                "properties": {
                    "script": {
                        "type": "string",
                        "description": "Path of the Do script to run, relative to the workspace folder"
                    },
                    "args": {
                        "type": "array",
                        "items": {
                            "type": "string"
                        },
                        "description": "Arguments passed to the script, without any shell interpretation"
                    },
                    "cwd": {
                        "type": "string",
                        "description": "Working directory, relative to the workspace folder; defaults to the script's directory"
                    }
                }
            }
        ]
    },
    "scripts": {
        "vscode:prepublish": "npm run package",
        "compile": "npm run check-types && npm run lint && node esbuild.js",
        "watch": "npm-run-all -p watch:*",
        "watch:esbuild": "node esbuild.js --watch",
        "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
        "package": "npm run check-types && npm run lint && node esbuild.js --production",
        "compile-tests": "tsc -p tsconfig.test.json",
        "watch-tests": "tsc -p tsconfig.test.json -w",
        "pretest": "npm run compile-tests && npm run compile && npm run lint",
        "check-types": "tsc --noEmit",
        "lint": "eslint src",
        "format": "prettier --write .",
        "package:vsix": "npx --yes @vscode/vsce@3.9.2 package",
        "test": "vscode-test --fail-zero",
        "test:syntax": "node --test test/syntax.test.mjs",
        "test:language-config": "node --test test/language-configuration.test.mjs"
    },
    "dependencies": {
        "tar": "^7.5.21",
        "vscode-languageclient": "^10.1.0"
    },
    "devDependencies": {
        "@types/mocha": "^10.0.0",
        "@types/node": "20.x",
        "@types/vscode": "^1.75.0",
        "@typescript-eslint/eslint-plugin": "^8.65.0",
        "@typescript-eslint/parser": "^8.65.0",
        "@vscode/test-cli": "^0.0.11",
        "@vscode/test-electron": "^2.3.0",
        "esbuild": "^0.28.1",
        "eslint": "^10.8.0",
        "npm-run-all": "^1.1.3",
        "prettier": "^3.7.4",
        "typescript": "^5.3.0",
        "vscode-oniguruma": "^2.0.1",
        "vscode-textmate": "^9.3.2"
    },
    "allowScripts": {
        "esbuild@0.28.1": true
    },
    "overrides": {
        "@vscode/test-cli": {
            "mocha": "^12.0.3"
        }
    }
}
