{
    "comments": {
        "lineComment": "#"
    },
    "brackets": [
        ["{", "}"],
        ["[", "]"],
        ["(", ")"]
    ],
    "colorizedBracketPairs": [],
    "autoClosingPairs": [
        { "open": "{", "close": "}" },
        { "open": "[", "close": "]" },
        { "open": "(", "close": ")" },
        { "open": "\"", "close": "\"", "notIn": ["string", "comment"] }
    ],
    "surroundingPairs": [
        ["{", "}"],
        ["[", "]"],
        ["(", ")"],
        ["\"", "\""]
    ],
    "folding": {
        "offSide": true,
        "markers": {
            "start": "^\\s*#\\s*region\\b",
            "end": "^\\s*#\\s*endregion\\b"
        }
    },
    "indentationRules": {
        "increaseIndentPattern": "^(?!)",
        "decreaseIndentPattern": "^\\s*(?:catch|finally)\\b"
    },
    "onEnterRules": [
        {
            "beforeText": "^\\s*#",
            "action": { "indent": "none" }
        },
        {
            "beforeText": "^\\s*(?:pub\\s+)?(?:(?:def|class|@class|if|while|for|try|catch|finally|match|bind)\\b|else\\s*(?:#.*)?$|else\\s+if\\b)",
            "action": { "indent": "indent" }
        },
        {
            "beforeText": "^[^#]*[^=!<>]=\\s*(?:if|match|try)\\b",
            "action": { "indent": "indent" }
        },
        {
            "beforeText": "\\bdo(?:\\s*\\|.*\\|)?(?:\\s*->\\s*\\S+)?(?:\\s+#.*)?$",
            "action": { "indent": "indent" }
        },
        {
            "beforeText": "\\|-?(?:\\s+#.*)?$",
            "action": { "indent": "indent" }
        },
        {
            "beforeText": "(?:^|\\s)\\$(?:\\s+#.*)?$",
            "action": { "indent": "indent" }
        },
        {
            "beforeText": "(?<!(?:^|[^\\w:]):\\w+):(?:\\s+#.*)?$",
            "action": { "indent": "indent" }
        },
        {
            "beforeText": "^\\s*(?:return|throw|break|continue)\\b",
            "action": { "indent": "outdent" }
        }
    ]
}
